<Project Sdk="Microsoft.NET.Sdk.Web">
  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>c63dbdc3-b76e-4a41-9f26-417786143fa7</UserSecretsId>
    <NoWarn>$(NoWarn);MSB3568</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <InternalsVisibleTo Include="Spokes_Server.Tests" />
    <InternalsVisibleTo Include="DynamicProxyGenAssembly2" />
  </ItemGroup>
  <ItemGroup>
    <Content Remove="appsettings.json" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="AWSSDK.S3" Version="4.0.104.4" />
    <PackageReference Include="BCrypt.Net-Next" Version="4.2.0" />
    <PackageReference Include="AngleSharp" Version="1.7.2" />
    <PackageReference Include="HtmlSanitizer" Version="9.2.1039" />
    <PackageReference Include="Lib.Net.Http.WebPush" Version="3.3.1" />
    <PackageReference Include="Livekit.Server.Sdk.Dotnet" Version="1.2.3" />
    <PackageReference Include="Livekit.Rtc.Dotnet" Version="0.1.4" />
    <PackageReference Include="MailKit" Version="4.18.0" />
    <PackageReference Include="Markdig" Version="1.3.2" />
    <PackageReference Include="Markdown.ColorCode" Version="3.0.1" />
    <PackageReference Include="Microsoft.AspNetCore.Authentication.OpenIdConnect" Version="9.0.2" />
    <PackageReference Include="Microsoft.Data.Sqlite" Version="9.0.2" />
    <PackageReference Include="MimeKit" Version="4.18.0" />
    <PackageReference Include="MudBlazor" Version="9.10.0" />
    <PackageReference Include="PdfPig" Version="0.1.16" />
    <PackageReference Include="PuppeteerSharp" Version="25.10.0" />
    <PackageReference Include="SkiaSharp" Version="4.152.0" />
    <PackageReference Include="SkiaSharp.NativeAssets.Linux.NoDependencies" Version="4.152.0" />
    <PackageReference Include="SSH.NET" Version="2026.0.0" />
    <PackageReference Include="Yarp.ReverseProxy" Version="2.3.0" />
  </ItemGroup>

  <ItemGroup>
    <None Include="appsettings.json">
      <CopyToOutputDirectory>Never</CopyToOutputDirectory>
    </None>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="wwwroot\data\emoji.json" />
  </ItemGroup>
</Project>