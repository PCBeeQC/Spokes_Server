<?xml version="1.0" encoding="utf-8" ?>
<Obfuscator>
  <Var name="InPath" value="/app/publish" />
  <Var name="OutPath" value="/app/publish/Obfuscated" />
  
  <!-- VERY MINIMAL OBFUSCATION -->
  <!-- Keep all public classes, methods, and properties -->
  <Var name="KeepPublicApi" value="true" />
  
  <!-- DISABLE ALL RENAMING to guarantee no Blazor crashes -->
  <Var name="HidePrivateApi" value="false" />
  <Var name="UseUnicodeNames" value="false" />
  <Var name="ReuseNames" value="false" />
  <Var name="RenameProperties" value="false" />
  <Var name="RenameEvents" value="false" />
  <Var name="RenameParameters" value="false" />
  <Var name="RenameFields" value="false" />
  
  <!-- ONLY ENCRYPT STRINGS (Protects keys & passwords) -->
  <Var name="HideStrings" value="true" />
  
  <!-- Add anti-decompiler attribute -->
  <Var name="SuppressIldasm" value="true" />
  
  <Module file="$(InPath)/Spokes_Server.dll" />
</Obfuscator>
