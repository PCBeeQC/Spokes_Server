@using Spokes_Server.Core.Data.Repositories.HR
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Security
@inject EmployeeRepository EmployeeRepo
@inject UserService UserService
@inject IUserPrivacyService PrivacyService

<div class="d-flex flex-column gap-2 @Class" style="@Style">
    <EmployeeAutocomplete Label="@Label"
                          Placeholder="@Placeholder"
                          Employees="@Employees"
                          ExcludedIds="@EffectiveExcludedIds"
                          ExcludeCurrentUser="@ExcludeCurrentUser"
                          CurrentUserId="@CurrentUserId"
                          ValueChanged="@HandleUserSelected"
                          ResetOnSelect="true"
                          Variant="@Variant"
                          Margin="@Margin"
                          Disabled="@Disabled"
                          Clearable="@Clearable"
                          Dense="@Dense" />

    @if (SelectedUserIds != null && SelectedUserIds.Count > 0)
    {
        <div class="d-flex flex-wrap gap-1">
            @foreach (var userId in SelectedUserIds)
            {
                var user = GetEmployee(userId);
                if (user != null)
                {
                    <EmployeeChip Employee="@user"
                                  OnClose="@(() => RemoveUser(userId))"
                                  Disabled="@Disabled"
                                  Size="@Size"
                                  Color="@ChipColor"
                                  Variant="@ChipVariant" />
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Default"
                             Variant="Variant.Outlined"
                             Size="@Size"
                             Disabled="@Disabled"
                             OnClose="@(() => RemoveUser(userId))">
                        @Loc["Deleted User"]
                    </MudChip>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<string> SelectedUserIds { get; set; } = [];
    [Parameter] public EventCallback<List<string>> SelectedUserIdsChanged { get; set; }
    [Parameter] public IEnumerable<Employee>? Employees { get; set; }
    [Parameter] public IEnumerable<string>? ExcludedIds { get; set; }
    [Parameter] public bool ExcludeCurrentUser { get; set; } = true;
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public string Label { get; set; } = "Add User";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Color ChipColor { get; set; } = Color.Primary;
    [Parameter] public Variant ChipVariant { get; set; } = Variant.Outlined;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    [Parameter] public EventCallback<Employee> OnUserAdded { get; set; }
    [Parameter] public EventCallback<string> OnUserRemoved { get; set; }

    private IEnumerable<string> EffectiveExcludedIds
    {
        get
        {
            var set = new HashSet<string>(SelectedUserIds ?? [], StringComparer.OrdinalIgnoreCase);
            if (ExcludedIds != null)
            {
                foreach (var id in ExcludedIds)
                {
                    if (!string.IsNullOrEmpty(id))
                        set.Add(id);
                }
            }
            return set;
        }
    }

    private Employee? GetEmployee(string id) =>
        Employees?.FirstOrDefault(e => e.Id == id) ?? EmployeeRepo.GetById(id);

    private async Task HandleUserSelected(Employee? user)
    {
        if (user == null || Disabled) return;

        SelectedUserIds ??= [];
        if (!SelectedUserIds.Contains(user.Id, StringComparer.OrdinalIgnoreCase))
        {
            SelectedUserIds.Add(user.Id);
            await NotifySelectionChangedAsync();

            if (OnUserAdded.HasDelegate)
            {
                await OnUserAdded.InvokeAsync(user);
            }
        }
    }

    private async Task RemoveUser(string userId)
    {
        if (Disabled || SelectedUserIds == null) return;

        var removed = SelectedUserIds.RemoveAll(id => string.Equals(id, userId, StringComparison.OrdinalIgnoreCase)) > 0;
        if (removed)
        {
            await NotifySelectionChangedAsync();

            if (OnUserRemoved.HasDelegate)
            {
                await OnUserRemoved.InvokeAsync(userId);
            }
        }
    }

    private async Task NotifySelectionChangedAsync()
    {
        if (SelectedUserIdsChanged.HasDelegate)
        {
            await SelectedUserIdsChanged.InvokeAsync(SelectedUserIds);
        }
    }
}
