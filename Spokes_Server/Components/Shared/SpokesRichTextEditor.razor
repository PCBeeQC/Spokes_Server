@implements IAsyncDisposable
@inject IJSRuntime JS

<div class="@EditorRootClass">
    <div class="editor-container @(Borderless ? "" : "mud-input-outlined-border")">
        <div id="@_editorId" class="quill-editor"></div>
    </div>
</div>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string> ValueChanged { get; set; }
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public string Placeholder { get; set; } = "";
    [Parameter] public bool ShowToolbar { get; set; } = true;
    [Parameter] public bool Borderless { get; set; } = false;

    private string EditorRootClass =>
        $"spokes-rich-text-editor {(ShowToolbar ? "" : "spokes-rich-text-editor--hide-toolbar")} {(Borderless ? "spokes-rich-text-editor--borderless" : "")} {Class}".Trim();

    private readonly string _editorId = $"editor-{Guid.NewGuid():N}";
    private DotNetObjectReference<SpokesRichTextEditor>? _dotNetHelper;
    private bool _isInitialized;
    private string _currentValue = "";
    private string? _previousParameterValue;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            _dotNetHelper = DotNetObjectReference.Create(this);
            _previousParameterValue = Value;
            _currentValue = Value ?? "";

            await JS.InvokeVoidAsync("window.ensureRichTextScriptsLoaded");
            await JS.InvokeVoidAsync("window.spokesQuill.init",
                _editorId,
                _currentValue,
                _dotNetHelper,
                ReadOnly,
                Placeholder);

            _isInitialized = true;
        }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Value != _previousParameterValue)
        {
            _previousParameterValue = Value;
            if (_isInitialized && Value != _currentValue)
            {
                _currentValue = Value ?? "";
                await JS.InvokeVoidAsync("window.spokesQuill.setHtml", _editorId, _currentValue);
            }
        }
    }

    [JSInvokable]
    public async Task OnContentChanged(string html)
    {
        if (_currentValue != html)
        {
            _currentValue = html;
            if (ValueChanged.HasDelegate)
            {
                await ValueChanged.InvokeAsync(html);
            }
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_isInitialized)
        {
            try
            {
                await JS.InvokeVoidAsync("window.spokesQuill.destroy", _editorId);
            }
            catch (JSDisconnectedException)
            {
                // Ignored
            }
        }

        _dotNetHelper?.Dispose();
    }
}
