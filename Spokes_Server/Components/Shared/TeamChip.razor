@using Spokes_Server.Core.Data.Repositories.HR
@inject TeamRepository TeamRepo

@{
    var team = Team ?? (!string.IsNullOrEmpty(TeamId) ? TeamRepo.GetById(TeamId) : null);
    var displayName = team?.Name ?? TeamName ?? Loc["Unknown"].Value;
    var avatarSize = Size switch
    {
        Size.Large => Size.Medium,
        _ => Size.Small
    };
}

<MudChip T="string"
         Size="@Size"
         Color="@Color"
         Variant="@Variant"
         OnClose="@(OnClose.HasDelegate ? EventCallback.Factory.Create<MudChip<string>>(this, HandleClose) : default)"
         Disabled="@Disabled"
         Class="@Class"
         Style="@Style"
         Value="@(team?.Id ?? TeamId ?? displayName)">
    <AvatarContent>
        <TeamAvatar Team="@team"
                    TeamName="@TeamName"
                    Size="@avatarSize"
                    UseIcon="@UseIcon" />
    </AvatarContent>
    <ChildContent>
        @displayName
    </ChildContent>
</MudChip>

@code {
    [Parameter] public Team? Team { get; set; }
    [Parameter] public string? TeamId { get; set; }
    [Parameter] public string? TeamName { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public bool UseIcon { get; set; } = true;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    private Task HandleClose(MudChip<string> chip) => OnClose.HasDelegate ? OnClose.InvokeAsync() : Task.CompletedTask;
}
