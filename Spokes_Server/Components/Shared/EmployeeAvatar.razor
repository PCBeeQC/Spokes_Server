@implements IDisposable
@inject PresenceStateService PresenceState

@{
    bool showBadge = false;
    bool isMobileBadge = false;
    Color badgeColor = Color.Default;

    if (ShowPresence && Employee != null)
    {
        var hasConn = PresenceState.HasActiveConnection(Employee.Id);
        var isAway = PresenceState.IsGloballyAway(Employee.Id);
        var hasDesktopActive = PresenceState.HasActiveDesktopConnection(Employee.Id) && !PresenceState.IsUserAwayFromDesktop(Employee.Id);
        var hasCapacitorMobile = PresenceState.IsOnlineOnCapacitorMobile(Employee.Id);

        if (hasDesktopActive)
        {
            showBadge = true;
            badgeColor = Color.Success;
        }
        else if (hasCapacitorMobile)
        {
            showBadge = true;
            isMobileBadge = true;
            badgeColor = Color.Success;
        }
        else if (hasConn && !isAway)
        {
            showBadge = true;
            badgeColor = Color.Success;
        }
        else if (isAway)
        {
            showBadge = true;
            badgeColor = Color.Warning;
        }
    }
    
    string safeColor = string.IsNullOrEmpty(Employee?.ProfileColor) ? Colors.DeepPurple.Default : Employee.ProfileColor;
    string overflowStyle = ShowPresence ? "overflow: visible !important;" : "overflow: hidden;";
    string calculatedFontSize = !string.IsNullOrEmpty(FontSize)
        ? FontSize
        : (Size == Size.Small ? "0.8rem" : "inherit");
}

<MudAvatar Size="@Size" Class="@Class" Style="@($"{overflowStyle} position: relative; vertical-align: middle; font-size: {calculatedFontSize}; background-color: {safeColor}; color: {Colors.Shades.White}; {Style}")">
    @if (Employee != null)
    {
        @if (Employee.HasCustomAvatar)
        {
            <div style="width: 100%; height: 100%; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                <MudImage Src="@($"/spokesapi/Media/Avatar/{Employee.Id}?v={Employee.AvatarVersion}")" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%; display: block;" />
            </div>
        }
        else
        {
            <div style="width: 100%; height: 100%; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;">
                @(string.IsNullOrEmpty(Employee.Initials) ? $"{Employee.FirstName?.FirstOrDefault()}{Employee.LastName?.FirstOrDefault()}" : Employee.Initials)
            </div>
        }
    }
    @if (showBadge)
    {
        @if (isMobileBadge)
        {
            <div class="presence-mobile-badge" title="@Loc["Online on Mobile"]">
                <MudIcon Icon="@Icons.Material.Filled.Smartphone" Class="presence-mobile-icon" />
            </div>
        }
        else
        {
            var badgeHexColor = badgeColor == Color.Success ? "var(--mud-palette-success)" : "var(--mud-palette-warning)";
            <div class="presence-dot" style="background-color: @badgeHexColor;"></div>
        }
    }
</MudAvatar>

@code {
    [Parameter] public Employee? Employee { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public bool ShowPresence { get; set; } = true;
    [Parameter] public string? FontSize { get; set; }

    protected override void OnInitialized()
    {
        if (ShowPresence)
        {
            PresenceState.OnUserPresenceChanged += HandlePresenceChanged;
        }
    }

    private void HandlePresenceChanged(string userId)
    {
        if (Employee != null && userId == Employee.Id)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        if (ShowPresence)
        {
            PresenceState.OnUserPresenceChanged -= HandlePresenceChanged;
        }
    }
}
