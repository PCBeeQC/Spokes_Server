@implements IDisposable
@inject PresenceStateService PresenceState

@{
    var presenceBadge = ResolvePresenceBadge();
    var sizeClass = Size switch
    {
        Size.Small => "mud-avatar-small",
        Size.Large => "mud-avatar-large",
        _ => "mud-avatar-medium"
    };
    var safeColor = string.IsNullOrEmpty(Employee?.ProfileColor) ? Colors.DeepPurple.Default : Employee.ProfileColor;
    var avatarStyle = string.IsNullOrEmpty(Style)
        ? $"background-color: {safeColor}; color: #fff;"
        : $"background-color: {safeColor}; color: #fff; {Style}";
    var initials = Employee != null && !Employee.HasCustomAvatar
        ? (!string.IsNullOrWhiteSpace(Employee.Initials)
            ? Employee.Initials.Trim()
            : string.Concat(Employee.FirstName?.Trim().Take(1) ?? [], Employee.LastName?.Trim().Take(1) ?? []).ToUpperInvariant())
        : string.Empty;
}

<div class="mud-avatar mud-avatar-filled @sizeClass employee-avatar @(ShowPresence ? "has-presence" : "") @Class" style="@avatarStyle" title="@(string.IsNullOrEmpty(Title) ? null : Title)">
    @if (Employee != null)
    {
        <div class="spokes-avatar-inner employee-avatar-inner">
            @if (Employee.HasCustomAvatar)
            {
                <img src="@($"/spokesapi/Media/Avatar/{Employee.Id}?v={Employee.AvatarVersion}")" alt="" loading="lazy" decoding="async" class="mud-image object-cover employee-avatar-img" />
            }
            else
            {
                <span class="spokes-avatar-initials @(initials.Length == 1 ? "is-single-char" : "")">@initials</span>
            }
        </div>
    }
    @if (presenceBadge == UserPresenceBadge.OnlineMobile)
    {
        <div class="presence-mobile-badge" title="@Loc["Online on Mobile"]">
            <svg class="mud-icon-root mud-svg-icon presence-mobile-icon" focusable="false" viewBox="0 0 24 24" aria-hidden="true"><path d="M17 1.01L7 1c-1.1 0-2 .9-2 2v18c0 1.1.9 2 2 2h10c1.1 0 2-.9 2-2V3c0-1.1-.9-1.99-2-1.99zM17 19H7V5h10v14z" fill="currentColor" /></svg>
        </div>
    }
    else if (presenceBadge != UserPresenceBadge.Offline)
    {
        <div class="presence-dot @(presenceBadge == UserPresenceBadge.Away ? "presence-dot-away" : "presence-dot-online")"></div>
    }
</div>
@{
    _lastFingerprint = ComputeFingerprint(presenceBadge);
    _hasRenderedOnce = true;
}

@code {
    [Parameter] public Employee? Employee { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public bool ShowPresence { get; set; } = true;
    [Parameter] public string? Title { get; set; }

    private int _lastFingerprint;
    private bool _hasRenderedOnce;

    private UserPresenceBadge ResolvePresenceBadge() =>
        (ShowPresence && Employee != null)
            ? PresenceState.GetUserPresenceBadge(Employee.Id)
            : UserPresenceBadge.Offline;

    private int ComputeFingerprint(UserPresenceBadge badge)
    {
        var hash = new HashCode();
        hash.Add(Employee?.Id, StringComparer.Ordinal);
        hash.Add(Employee?.HasCustomAvatar ?? false);
        hash.Add(Employee?.AvatarVersion ?? 0);
        hash.Add(Employee?.Initials, StringComparer.Ordinal);
        hash.Add(Employee?.FirstName, StringComparer.Ordinal);
        hash.Add(Employee?.LastName, StringComparer.Ordinal);
        hash.Add(Employee?.ProfileColor, StringComparer.Ordinal);
        hash.Add(Size);
        hash.Add(Class, StringComparer.Ordinal);
        hash.Add(Style, StringComparer.Ordinal);
        hash.Add(ShowPresence);
        hash.Add(Title, StringComparer.Ordinal);
        hash.Add(badge);
        return hash.ToHashCode();
    }

    protected override bool ShouldRender()
    {
        if (!_hasRenderedOnce)
        {
            return true;
        }

        return ComputeFingerprint(ResolvePresenceBadge()) != _lastFingerprint;
    }

    protected override void OnInitialized()
    {
        if (ShowPresence)
        {
            PresenceState.OnUserPresenceChanged += HandlePresenceChanged;
        }
    }

    private void HandlePresenceChanged(string userId)
    {
        if (Employee != null && userId == Employee.Id)
        {
            InvokeAsync(StateHasChanged);
        }
    }

    public void Dispose()
    {
        if (ShowPresence)
        {
            PresenceState.OnUserPresenceChanged -= HandlePresenceChanged;
        }
    }
}
