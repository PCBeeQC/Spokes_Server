@using Spokes_Server.Core.Data.Repositories.HR
@inject TeamRepository TeamRepo

@{
    var team = Team ?? (!string.IsNullOrEmpty(TeamId) ? TeamRepo.GetById(TeamId) : null);
    string safeColor = string.IsNullOrEmpty(team?.Color) ? "#1E88E5" : team.Color;
    var name = team?.Name ?? TeamName;
    string teamInitial = !string.IsNullOrWhiteSpace(name)
        ? name.Trim()[..1].ToUpper()
        : "T";
}

<MudAvatar Size="@Size"
           Class="@($"team-avatar {Class}".Trim())"
           Style="@($"background-color: {safeColor}; color: {Colors.Shades.White}; {Style}")">
    <div class="spokes-avatar-inner">
        @if (UseIcon)
        {
            <MudIcon Icon="@Icons.Material.Filled.Groups" Class="spokes-avatar-icon" />
        }
        else
        {
            <span class="spokes-avatar-initials is-single-char">@teamInitial</span>
        }
    </div>
</MudAvatar>

@code {
    [Parameter] public Team? Team { get; set; }
    [Parameter] public string? TeamId { get; set; }
    [Parameter] public string? TeamName { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool UseIcon { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
}
