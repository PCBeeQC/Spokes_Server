@using Spokes_Server.Core.Models.HR
@using MudBlazor
@inject Spokes_Server.Aggregate.Database Db

@{
    var team = Team ?? (!string.IsNullOrEmpty(TeamId) ? Db.Teams.GetById(TeamId) : null);
    string safeColor = string.IsNullOrEmpty(team?.Color) ? "#1E88E5" : team.Color;
    var name = team?.Name ?? TeamName;
    string teamInitial = !string.IsNullOrWhiteSpace(name)
        ? name.Trim().Substring(0, 1).ToUpper()
        : "T";

    string calculatedFontSize = !string.IsNullOrEmpty(FontSize)
        ? FontSize
        : (Size == Size.Small ? "0.8rem" : (Size == Size.Large ? "1.5rem" : "inherit"));

    string iconFontSize = Size switch
    {
        Size.Small => "13px",
        Size.Medium => "18px",
        Size.Large => "28px",
        _ => "14px"
    };
}

<MudAvatar Size="@Size"
           Class="@Class"
           Style="@($"position: relative; font-size: {calculatedFontSize}; background-color: {safeColor}; color: {Colors.Shades.White}; overflow: hidden; {Style}")">
    @if (UseIcon)
    {
        <MudIcon Icon="@Icons.Material.Filled.Groups" Style="@($"font-size: {iconFontSize};")" />
    }
    else
    {
        <div style="width: 100%; height: 100%; border-radius: 50%; overflow: hidden; display: flex; align-items: center; justify-content: center;">
            @teamInitial
        </div>
    }
</MudAvatar>

@code {
    [Parameter] public Team? Team { get; set; }
    [Parameter] public string? TeamId { get; set; }
    [Parameter] public string? TeamName { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Medium;
    [Parameter] public bool UseIcon { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";
    [Parameter] public string? FontSize { get; set; }
}
