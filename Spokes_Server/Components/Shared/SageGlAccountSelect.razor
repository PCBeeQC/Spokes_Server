@using Spokes_Server.Aggregate
@using Spokes_Server.Core.Configuration
@inject Database Db

<MudAutocomplete T="string"
                 Value="@Value"
                 ValueChanged="@HandleValueChanged"
                 SearchFunc="@SearchAccounts"
                 ToStringFunc="@FormatAccountDisplay"
                 CoerceText="false"
                 CoerceValue="true"
                 ResetValueOnEmptyText="@Clearable"
                 Label="@Label"
                 Placeholder="@Placeholder"
                 HelperText="@HelperText"
                 Variant="@Variant"
                 Margin="@Margin"
                 Dense="@Dense"
                 Clearable="@Clearable"
                 ReadOnly="@ReadOnly"
                 Disabled="@Disabled"
                 Required="@Required"
                 Underline="@Underline"
                 MaxItems="100"
                 Class="@Class"
                 Style="@Style">
    <ItemTemplate Context="acctNumber">
        @{
            var acct = FindAccount(acctNumber);
        }
        <div class="d-flex align-center justify-space-between w-100 gap-2">
            <div>
                <MudText Typo="Typo.body2">
                    <b>@acctNumber</b>
                    @if (acct != null && !string.IsNullOrWhiteSpace(acct.AccountName))
                    {
                        <span> &mdash; @acct.AccountName</span>
                    }
                </MudText>
                @if (acct != null && !string.IsNullOrWhiteSpace(acct.AccountNameFr) &&
                     !string.Equals(acct.AccountNameFr, acct.AccountName, StringComparison.OrdinalIgnoreCase))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@acct.AccountNameFr</MudText>
                }
            </div>
            @if (acct != null && !string.IsNullOrWhiteSpace(acct.AccountClass))
            {
                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">@acct.AccountClass</MudChip>
            }
        </div>
    </ItemTemplate>
</MudAutocomplete>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public List<SageGlAccountRecord>? Accounts { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public string? HelperText { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public bool Clearable { get; set; } = false;
    [Parameter] public bool ReadOnly { get; set; } = false;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Required { get; set; } = false;
    [Parameter] public bool Underline { get; set; } = true;
    [Parameter] public string Class { get; set; } = string.Empty;
    [Parameter] public string Style { get; set; } = string.Empty;

    private List<SageGlAccountRecord>? _cachedAccounts;

    private List<SageGlAccountRecord> EffectiveAccounts =>
        Accounts ?? (_cachedAccounts ??= Db.CompanyProfile.GetAccounting().SageSettings?.ImportedAccounts ?? []);

    private SageGlAccountRecord? FindAccount(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return null;
        var clean = ExtractAccountCode(code);
        return EffectiveAccounts.FirstOrDefault(a =>
            string.Equals(a.AccountNumber.Trim(), clean, StringComparison.OrdinalIgnoreCase));
    }

    private string FormatAccountDisplay(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return string.Empty;
        var clean = ExtractAccountCode(code);
        var acct = FindAccount(clean);
        return acct != null ? acct.DisplayLabel : clean;
    }

    private static string ExtractAccountCode(string? input)
    {
        if (string.IsNullOrWhiteSpace(input)) return string.Empty;
        var trimmed = input.Trim();
        var dashIdx = trimmed.IndexOf(" - ", StringComparison.Ordinal);
        return dashIdx > 0 ? trimmed[..dashIdx].Trim() : trimmed;
    }

    private async Task HandleValueChanged(string? newValue)
    {
        var cleanCode = ExtractAccountCode(newValue);
        Value = string.IsNullOrEmpty(cleanCode) ? null : cleanCode;
        if (ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(Value);
        }
    }

    private Task<IEnumerable<string>> SearchAccounts(string? searchText, CancellationToken ct)
    {
        var list = EffectiveAccounts;
        if (list.Count == 0)
        {
            return Task.FromResult<IEnumerable<string>>(
                !string.IsNullOrWhiteSpace(searchText)
                    ? [ExtractAccountCode(searchText)]
                    : (!string.IsNullOrWhiteSpace(Value) ? [ExtractAccountCode(Value)] : []));
        }

        var currentFormatted = FormatAccountDisplay(Value);
        if (string.IsNullOrWhiteSpace(searchText) ||
            string.Equals(searchText.Trim(), currentFormatted, StringComparison.OrdinalIgnoreCase) ||
            string.Equals(searchText.Trim(), Value?.Trim(), StringComparison.OrdinalIgnoreCase))
        {
            return Task.FromResult(list.Select(a => a.AccountNumber));
        }

        var q = searchText.Trim();
        var matches = list
            .Where(a =>
                a.AccountNumber.Contains(q, StringComparison.OrdinalIgnoreCase) ||
                (a.AccountName?.Contains(q, StringComparison.OrdinalIgnoreCase) == true) ||
                (a.AccountNameFr?.Contains(q, StringComparison.OrdinalIgnoreCase) == true) ||
                (a.AccountClass?.Contains(q, StringComparison.OrdinalIgnoreCase) == true))
            .Select(a => a.AccountNumber)
            .ToList();

        if (matches.Count == 0 && !q.Contains(" - ", StringComparison.Ordinal))
        {
            matches.Add(q);
        }

        return Task.FromResult<IEnumerable<string>>(matches);
    }
}
