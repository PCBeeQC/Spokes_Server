@RenderSelectorLayout()

@code {
    [Parameter] public List<WorkType> WorkTypes { get; set; } = [];
    [Parameter] public Project? Project { get; set; }
    [Parameter] public string? ProjectId { get; set; }
    [Parameter] public List<Project>? Projects { get; set; }
    [Parameter] public bool RequireProject { get; set; }

    [Parameter] public string WorkTypeId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> WorkTypeIdChanged { get; set; }

    [Parameter] public string? SubTaskId { get; set; } = string.Empty;
    [Parameter] public EventCallback<string> SubTaskIdChanged { get; set; }

    [Parameter] public EventCallback<(string WorkTypeId, string SubTaskId)> OnSelectionChanged { get; set; }

    [Parameter] public WorkTypeSelectorLayout Layout { get; set; } = WorkTypeSelectorLayout.Grid;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public bool Underline { get; set; } = true;
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Required { get; set; }
    [Parameter] public bool UsePlaceholder { get; set; }
    [Parameter] public string TaskLabel { get; set; } = "Task";
    [Parameter] public string SubTaskLabel { get; set; } = "Sub-Task";
    [Parameter] public int GridSpacing { get; set; } = 1;
    [Parameter] public int StackSpacing { get; set; } = 3;

    private List<WorkType> _allowedWorkTypes = [];
    private List<WorkTypeSearchItem> _searchItems = [];

    protected override void OnParametersSet()
    {
        if (Project != null)
        {
            _allowedWorkTypes = TimesheetSearchHelper.GetAllowedWorkTypes(Project, WorkTypes);
        }
        else
        {
            _allowedWorkTypes = TimesheetSearchHelper.GetAllowedWorkTypes(ProjectId, Projects, WorkTypes, RequireProject);
        }

        _searchItems = TimesheetSearchHelper.BuildWorkTypeSearchItems(_allowedWorkTypes);
    }

    private RenderFragment RenderSelectorLayout() => __builder =>
    {
        switch (Layout)
        {
            case WorkTypeSelectorLayout.Grid:
                <MudGrid Spacing="@GridSpacing">
                    <MudItem xs="6">
                        @RenderTaskAutocomplete()
                    </MudItem>
                    <MudItem xs="6">
                        @RenderSubTaskAutocomplete()
                    </MudItem>
                </MudGrid>
                break;

            case WorkTypeSelectorLayout.TableCells:
                <MudTd>
                    @RenderTaskAutocomplete()
                </MudTd>
                <MudTd>
                    @RenderSubTaskAutocomplete()
                </MudTd>
                break;

            case WorkTypeSelectorLayout.Stack:
            default:
                <MudStack Spacing="@StackSpacing">
                    @RenderTaskAutocomplete()
                    @RenderSubTaskAutocomplete()
                </MudStack>
                break;
        }
    };

    private RenderFragment RenderTaskAutocomplete() => __builder =>
    {
        var isTaskDisabled = Disabled || (RequireProject && string.IsNullOrEmpty(ProjectId) && Project == null);
        <MudAutocomplete T="WorkTypeSearchItem"
                         Value="@GetCurrentTaskSearchItem()"
                         ValueChanged="OnTaskSearchItemChanged"
                         SearchFunc="SearchTaskItemsAsync"
                         ToStringFunc="@(item => item?.WorkTypeName ?? string.Empty)"
                         Dense="@Dense"
                         Margin="@Margin"
                         Variant="@Variant"
                         Underline="@Underline"
                         Label="@(UsePlaceholder ? null : TaskLabel)"
                         Placeholder="@(UsePlaceholder ? TaskLabel : null)"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         MaxItems="null"
                         Required="@Required"
                         Disabled="@isTaskDisabled">
            <ItemTemplate Context="item">
                <MudText Typo="Typo.body2">@item.DisplayText</MudText>
            </ItemTemplate>
        </MudAutocomplete>
    };

    private RenderFragment RenderSubTaskAutocomplete() => __builder =>
    {
        var isSubTaskDisabled = Disabled || string.IsNullOrEmpty(WorkTypeId);
        <MudAutocomplete T="string"
                         Value="@(SubTaskId ?? string.Empty)"
                         ValueChanged="OnSubTaskChanged"
                         SearchFunc="SearchSubTasksAsync"
                         ToStringFunc="GetSubTaskDisplayName"
                         Dense="@Dense"
                         Margin="@Margin"
                         Variant="@Variant"
                         Underline="@Underline"
                         Label="@(UsePlaceholder ? null : SubTaskLabel)"
                         Placeholder="@(UsePlaceholder ? SubTaskLabel : null)"
                         ResetValueOnEmptyText="true"
                         CoerceText="false"
                         MaxItems="null"
                         Disabled="@isSubTaskDisabled" />
    };

    private WorkTypeSearchItem? GetCurrentTaskSearchItem()
    {
        if (string.IsNullOrEmpty(WorkTypeId)) return null;

        return _searchItems.FirstOrDefault(x => x.WorkTypeId == WorkTypeId && string.IsNullOrEmpty(x.SubTaskId))
               ?? WorkTypes.Where(w => w.Id == WorkTypeId)
                   .Select(w => new WorkTypeSearchItem
                   {
                       WorkTypeId = w.Id,
                       WorkTypeName = w.Name,
                       DisplayText = w.Name
                   })
                   .FirstOrDefault();
    }

    private Task<IEnumerable<WorkTypeSearchItem>> SearchTaskItemsAsync(string value, CancellationToken token)
    {
        var results = TimesheetSearchHelper.SearchWorkTypeItems(value, WorkTypeId, _searchItems);
        return Task.FromResult(results);
    }

    private Task<IEnumerable<string>> SearchSubTasksAsync(string value, CancellationToken token)
    {
        var results = TimesheetSearchHelper.SearchSubTasks(value, WorkTypeId, _allowedWorkTypes, SubTaskId);
        return Task.FromResult(results);
    }

    private string GetSubTaskDisplayName(string? id)
    {
        return TimesheetSearchHelper.GetSubTaskName(id, WorkTypeId, WorkTypes);
    }

    private async Task OnTaskSearchItemChanged(WorkTypeSearchItem? item)
    {
        if (item == null)
        {
            WorkTypeId = string.Empty;
            SubTaskId = string.Empty;
            await WorkTypeIdChanged.InvokeAsync(string.Empty);
            await SubTaskIdChanged.InvokeAsync(string.Empty);
            await OnSelectionChanged.InvokeAsync((string.Empty, string.Empty));
            return;
        }

        var newWorkTypeId = item.WorkTypeId;
        string newSubTaskId;

        if (!string.IsNullOrEmpty(item.SubTaskId))
        {
            newSubTaskId = item.SubTaskId;
        }
        else
        {
            var task = _allowedWorkTypes.FirstOrDefault(t => t.Id == newWorkTypeId)
                       ?? WorkTypes.FirstOrDefault(t => t.Id == newWorkTypeId);
            newSubTaskId = TimesheetSearchHelper.GetDefaultSubTask(task)?.Id ?? string.Empty;
        }

        WorkTypeId = newWorkTypeId;
        SubTaskId = newSubTaskId;

        await WorkTypeIdChanged.InvokeAsync(newWorkTypeId);
        await SubTaskIdChanged.InvokeAsync(newSubTaskId);
        await OnSelectionChanged.InvokeAsync((newWorkTypeId, newSubTaskId));
    }

    private async Task OnSubTaskChanged(string? newSubTaskId)
    {
        var resolvedSubTaskId = newSubTaskId ?? string.Empty;
        SubTaskId = resolvedSubTaskId;
        await SubTaskIdChanged.InvokeAsync(resolvedSubTaskId);
        await OnSelectionChanged.InvokeAsync((WorkTypeId, resolvedSubTaskId));
    }
}
