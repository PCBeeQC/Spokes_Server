@using Spokes_Server.Core.Models.HR
@using MudBlazor
@inject Spokes_Server.Aggregate.Database Db

<MudAutocomplete @ref="_autocomplete"
                 T="Team"
                 Value="@Value"
                 ValueChanged="@HandleValueChanged"
                 SearchFunc="@InternalSearchFunc"
                 ToStringFunc="@(t => t?.Name ?? "")"
                 Label="@Label"
                 Placeholder="@Placeholder"
                 Variant="@Variant"
                 Margin="@Margin"
                 Clearable="@Clearable"
                 Disabled="@Disabled"
                 ShrinkLabel="@ShrinkLabel"
                 ShowProgressIndicator="@ShowProgressIndicator"
                 Class="@Class"
                 Style="@Style"
                 Dense="@Dense">
    <ItemTemplate Context="team">
        <div class="d-flex align-center gap-2">
            <TeamAvatar Team="@team" Size="Size.Small" UseIcon="true" Style="width: 24px; height: 24px;" />
            <div>
                <MudText Typo="Typo.body2">@team.Name</MudText>
            </div>
        </div>
    </ItemTemplate>
</MudAutocomplete>

@code {
    private MudAutocomplete<Team>? _autocomplete;

    [Parameter] public Team? Value { get; set; }
    [Parameter] public EventCallback<Team?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<Team>? Teams { get; set; }
    [Parameter] public IEnumerable<string>? ExcludedIds { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<Team>>>? SearchFunc { get; set; }
    [Parameter] public bool ResetOnSelect { get; set; } = false;
    [Parameter] public string Label { get; set; } = "Add Team";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool ShrinkLabel { get; set; } = false;
    [Parameter] public bool ShowProgressIndicator { get; set; } = false;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    public async Task ClearAsync()
    {
        if (_autocomplete != null)
        {
            await _autocomplete.ClearAsync();
        }
    }

    private async Task HandleValueChanged(Team? team)
    {
        if (team != null && ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(team);
        }

        if (ResetOnSelect && _autocomplete != null)
        {
            await _autocomplete.ClearAsync();
        }
        else
        {
            Value = team;
        }
    }

    private Task<IEnumerable<Team>> InternalSearchFunc(string value, CancellationToken ct)
    {
        if (SearchFunc != null)
        {
            return SearchFunc(value, ct);
        }

        var source = Teams ?? Db.Teams.GetAll();

        if (ExcludedIds != null && ExcludedIds.Any())
        {
            var excludedSet = ExcludedIds as HashSet<string> ?? new HashSet<string>(ExcludedIds);
            source = source.Where(t => !excludedSet.Contains(t.Id));
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(source.OrderBy(t => t.Name).Take(20).AsEnumerable());
        }

        var filtered = source.Where(t =>
            t.Name.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (!string.IsNullOrEmpty(t.Description) && t.Description.Contains(value, StringComparison.OrdinalIgnoreCase)))
            .OrderBy(t => t.Name)
            .Take(20);

        return Task.FromResult(filtered.AsEnumerable());
    }
}
