@using Spokes_Server.Core.Data.Repositories.HR
@using Spokes_Server.Core.Configuration
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Security
@inject EmployeeRepository EmployeeRepo
@inject UserService UserService
@inject IUserPrivacyService PrivacyService

<MudAutocomplete @ref="_autocomplete"
                 T="Employee"
                 Value="@Value"
                 ValueChanged="@HandleValueChanged"
                 SearchFunc="@InternalSearchFunc"
                 ToStringFunc="@(e => e?.FullName ?? "")"
                 Label="@Label"
                 Placeholder="@EffectivePlaceholder"
                 Variant="@Variant"
                 Margin="@Margin"
                 Clearable="@Clearable"
                 Disabled="@Disabled"
                 ShrinkLabel="@ShrinkLabel"
                 ShowProgressIndicator="@ShowProgressIndicator"
                 Class="@Class"
                 Style="@Style"
                 Dense="@Dense">
    <ItemTemplate Context="user">
        <div class="d-flex align-center gap-2">
            <EmployeeAvatar Employee="@user" Size="Size.Small" ShowPresence="false" />
            <div>
                <MudText Typo="Typo.body2">@user.FullName</MudText>
                @if (!string.IsNullOrWhiteSpace(user.Position))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@user.Position</MudText>
                }
            </div>
        </div>
    </ItemTemplate>
</MudAutocomplete>

@code {
    private MudAutocomplete<Employee>? _autocomplete;

    [Parameter] public Employee? Value { get; set; }
    [Parameter] public EventCallback<Employee?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<Employee>? Employees { get; set; }
    [Parameter] public IEnumerable<string>? ExcludedIds { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<Employee>>>? SearchFunc { get; set; }
    [Parameter] public bool IncludeInactive { get; set; } = false;
    [Parameter] public bool IncludeSystemUsers { get; set; } = false;
    [Parameter] public bool ResetOnSelect { get; set; } = false;
    [Parameter] public bool ExcludeCurrentUser { get; set; } = false;
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public string Label { get; set; } = "Add User";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool ShrinkLabel { get; set; } = false;
    [Parameter] public bool ShowProgressIndicator { get; set; } = false;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    private Employee? _currentUser;

    private string? EffectivePlaceholder =>
        !string.IsNullOrEmpty(Placeholder)
            ? Placeholder
            : (PrivacyService.GetPrivacyConfig().DiscoveryMethod switch
            {
                UserDiscoveryMethod.ExactEmailOnly => Loc["Enter full email address..."].Value,
                UserDiscoveryMethod.ExactEmailOrUsername => Loc["Enter email or full name..."].Value,
                _ => null
            });

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync();
    }

    public Task ClearAsync() => _autocomplete != null ? _autocomplete.ClearAsync() : Task.CompletedTask;

    private async Task HandleValueChanged(Employee? emp)
    {
        if (emp != null && ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(emp);
        }

        if (ResetOnSelect && _autocomplete != null)
        {
            await _autocomplete.ClearAsync();
        }
        else
        {
            Value = emp;
        }
    }

    private async Task<IEnumerable<Employee>> InternalSearchFunc(string value, CancellationToken ct)
    {
        if (SearchFunc != null)
        {
            return await SearchFunc(value, ct);
        }

        if (_currentUser == null)
        {
            _currentUser = await UserService.GetEmployeeAsync();
        }

        var source = Employees ?? (IncludeInactive ? EmployeeRepo.GetAll() : EmployeeRepo.GetActiveEmployees());

        if (ExcludedIds != null && ExcludedIds.Any())
        {
            var excludedSet = ExcludedIds as HashSet<string> ?? new HashSet<string>(ExcludedIds);
            source = source.Where(e => !excludedSet.Contains(e.Id));
        }

        if (ExcludeCurrentUser)
        {
            var effectiveCurrentUserId = !string.IsNullOrEmpty(CurrentUserId) ? CurrentUserId : _currentUser?.Id;
            if (!string.IsNullOrEmpty(effectiveCurrentUserId))
            {
                source = source.Where(e => e.Id != effectiveCurrentUserId);
            }
        }

        return await PrivacyService.SearchDiscoverableEmployeesAsync(_currentUser, value, source, 20);
    }
}
