@using Spokes_Server.Core.Models.HR
@using MudBlazor
@inject Spokes_Server.Aggregate.Database Db

<MudAutocomplete @ref="_autocomplete"
                 T="Employee"
                 Value="@Value"
                 ValueChanged="@HandleValueChanged"
                 SearchFunc="@InternalSearchFunc"
                 ToStringFunc="@(e => e?.FullName ?? "")"
                 Label="@Label"
                 Placeholder="@Placeholder"
                 Variant="@Variant"
                 Margin="@Margin"
                 Clearable="@Clearable"
                 Disabled="@Disabled"
                 ShrinkLabel="@ShrinkLabel"
                 ShowProgressIndicator="@ShowProgressIndicator"
                 Class="@Class"
                 Style="@Style"
                 Dense="@Dense">
    <ItemTemplate Context="user">
        <div class="d-flex align-center gap-2">
            <EmployeeAvatar Employee="@user" Size="Size.Small" ShowPresence="false" />
            <div>
                <MudText Typo="Typo.body2">@user.FullName</MudText>
                @if (!string.IsNullOrWhiteSpace(user.Position))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">@user.Position</MudText>
                }
            </div>
        </div>
    </ItemTemplate>
</MudAutocomplete>

@code {
    private MudAutocomplete<Employee>? _autocomplete;

    [Parameter] public Employee? Value { get; set; }
    [Parameter] public EventCallback<Employee?> ValueChanged { get; set; }
    [Parameter] public IEnumerable<Employee>? Employees { get; set; }
    [Parameter] public IEnumerable<string>? ExcludedIds { get; set; }
    [Parameter] public Func<string, CancellationToken, Task<IEnumerable<Employee>>>? SearchFunc { get; set; }
    [Parameter] public bool ResetOnSelect { get; set; } = false;
    [Parameter] public string Label { get; set; } = "Add User";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool ShrinkLabel { get; set; } = false;
    [Parameter] public bool ShowProgressIndicator { get; set; } = false;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    public async Task ClearAsync()
    {
        if (_autocomplete != null)
        {
            await _autocomplete.ClearAsync();
        }
    }

    private async Task HandleValueChanged(Employee? emp)
    {
        if (emp != null && ValueChanged.HasDelegate)
        {
            await ValueChanged.InvokeAsync(emp);
        }

        if (ResetOnSelect && _autocomplete != null)
        {
            await _autocomplete.ClearAsync();
        }
        else
        {
            Value = emp;
        }
    }

    private Task<IEnumerable<Employee>> InternalSearchFunc(string value, CancellationToken ct)
    {
        if (SearchFunc != null)
        {
            return SearchFunc(value, ct);
        }

        var source = Employees ?? Db.Employees.GetAll();

        if (ExcludedIds != null && ExcludedIds.Any())
        {
            var excludedSet = ExcludedIds as HashSet<string> ?? new HashSet<string>(ExcludedIds);
            source = source.Where(e => !excludedSet.Contains(e.Id));
        }

        if (string.IsNullOrWhiteSpace(value))
        {
            return Task.FromResult(source.OrderBy(e => e.FullName).Take(20).AsEnumerable());
        }

        var filtered = source.Where(e =>
            e.FullName.Contains(value, StringComparison.OrdinalIgnoreCase) ||
            (e.Position?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false) ||
            (e.Email?.Contains(value, StringComparison.OrdinalIgnoreCase) ?? false))
            .OrderBy(e => e.FullName)
            .Take(20);

        return Task.FromResult(filtered.AsEnumerable());
    }
}
