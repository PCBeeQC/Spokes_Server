@using Spokes_Server.Core.Data.Repositories.HR
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Security
@inject TeamRepository TeamRepo
@inject UserService UserService
@inject IUserPrivacyService PrivacyService

<div class="d-flex flex-column gap-2 @Class" style="@Style">
    <TeamAutocomplete Label="@Label"
                      Placeholder="@Placeholder"
                      Teams="@Teams"
                      ExcludedIds="@EffectiveExcludedIds"
                      ValueChanged="@HandleTeamSelected"
                      ResetOnSelect="true"
                      Variant="@Variant"
                      Margin="@Margin"
                      Disabled="@Disabled"
                      Clearable="@Clearable"
                      Dense="@Dense" />

    @if (SelectedTeamIds != null && SelectedTeamIds.Count > 0)
    {
        <div class="d-flex flex-wrap gap-1">
            @foreach (var teamId in SelectedTeamIds)
            {
                var team = GetTeam(teamId);
                if (team != null)
                {
                    <TeamChip Team="@team"
                              OnClose="@(() => RemoveTeam(teamId))"
                              Disabled="@Disabled"
                              Size="@Size"
                              Color="@ChipColor"
                              Variant="@ChipVariant" />
                }
                else
                {
                    <MudChip T="string"
                             Color="Color.Default"
                             Variant="Variant.Outlined"
                             Size="@Size"
                             Disabled="@Disabled"
                             OnClose="@(() => RemoveTeam(teamId))">
                        @Loc["Deleted Team"]
                    </MudChip>
                }
            }
        </div>
    }
</div>

@code {
    [Parameter] public List<string> SelectedTeamIds { get; set; } = [];
    [Parameter] public EventCallback<List<string>> SelectedTeamIdsChanged { get; set; }
    [Parameter] public IEnumerable<Team>? Teams { get; set; }
    [Parameter] public IEnumerable<string>? ExcludedIds { get; set; }
    [Parameter] public string Label { get; set; } = "Add Team";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Color ChipColor { get; set; } = Color.Secondary;
    [Parameter] public Variant ChipVariant { get; set; } = Variant.Filled;
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool Dense { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    [Parameter] public EventCallback<Team> OnTeamAdded { get; set; }
    [Parameter] public EventCallback<string> OnTeamRemoved { get; set; }

    private IEnumerable<string> EffectiveExcludedIds
    {
        get
        {
            var set = new HashSet<string>(SelectedTeamIds ?? [], StringComparer.OrdinalIgnoreCase);
            if (ExcludedIds != null)
            {
                foreach (var id in ExcludedIds)
                {
                    if (!string.IsNullOrEmpty(id))
                        set.Add(id);
                }
            }
            return set;
        }
    }

    private Team? GetTeam(string id) =>
        Teams?.FirstOrDefault(t => t.Id == id) ?? TeamRepo.GetById(id);

    private async Task HandleTeamSelected(Team? team)
    {
        if (team == null || Disabled) return;

        SelectedTeamIds ??= [];
        if (!SelectedTeamIds.Contains(team.Id, StringComparer.OrdinalIgnoreCase))
        {
            SelectedTeamIds.Add(team.Id);
            await NotifySelectionChangedAsync();

            if (OnTeamAdded.HasDelegate)
            {
                await OnTeamAdded.InvokeAsync(team);
            }
        }
    }

    private async Task RemoveTeam(string teamId)
    {
        if (Disabled || SelectedTeamIds == null) return;

        var removed = SelectedTeamIds.RemoveAll(id => string.Equals(id, teamId, StringComparison.OrdinalIgnoreCase)) > 0;
        if (removed)
        {
            await NotifySelectionChangedAsync();

            if (OnTeamRemoved.HasDelegate)
            {
                await OnTeamRemoved.InvokeAsync(teamId);
            }
        }
    }

    private async Task NotifySelectionChangedAsync()
    {
        if (SelectedTeamIdsChanged.HasDelegate)
        {
            await SelectedTeamIdsChanged.InvokeAsync(SelectedTeamIds);
        }
    }
}
