@inject UserService UserService

@if (IsAuthorized)
{
    @Authorized
}
else
{
    @NotAuthorized
}

@code {
    [Parameter] public string Required { get; set; } = string.Empty;
    [Parameter] public RenderFragment? Authorized { get; set; }
    [Parameter] public RenderFragment? NotAuthorized { get; set; }

    // Support simpler usage: <PermissionView Required="...">Content</PermissionView>
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private bool IsAuthorized;

    protected override async Task OnInitializedAsync()
    {
        IsAuthorized = string.IsNullOrEmpty(Required) || await UserService.HasPermissionAsync(Required);
    }

    protected override void OnParametersSet()
    {
        Authorized ??= ChildContent;
    }
}
