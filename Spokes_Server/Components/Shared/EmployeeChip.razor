@using Spokes_Server.Core.Data.Repositories.HR
@inject EmployeeRepository EmployeeRepo

@{
    var emp = Employee ?? (!string.IsNullOrEmpty(UserId) ? EmployeeRepo.GetById(UserId) : null);
    var displayName = emp?.FullName ?? Text ?? Loc["Unknown"].Value;
    var avatarSize = Size switch
    {
        Size.Large => Size.Medium,
        _ => Size.Small
    };
}

<MudChip T="string"
         Size="@Size"
         Color="@Color"
         Variant="@Variant"
         OnClose="@(OnClose.HasDelegate ? EventCallback.Factory.Create<MudChip<string>>(this, HandleClose) : default)"
         Disabled="@Disabled"
         Class="@Class"
         Style="@Style"
         Value="@(emp?.Id ?? UserId ?? displayName)">
    <AvatarContent>
        @if (emp != null)
        {
            <EmployeeAvatar Employee="@emp"
                            Size="@avatarSize"
                            ShowPresence="false" />
        }
    </AvatarContent>
    <ChildContent>
        @displayName
    </ChildContent>
</MudChip>

@code {
    [Parameter] public Employee? Employee { get; set; }
    [Parameter] public string? UserId { get; set; }
    [Parameter] public string? Text { get; set; }
    [Parameter] public Size Size { get; set; } = Size.Small;
    [Parameter] public Color Color { get; set; } = Color.Default;
    [Parameter] public Variant Variant { get; set; } = Variant.Filled;
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public bool Disabled { get; set; } = false;
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Style { get; set; } = "";

    private Task HandleClose(MudChip<string> chip) =>
        OnClose.HasDelegate ? OnClose.InvokeAsync() : Task.CompletedTask;
}
