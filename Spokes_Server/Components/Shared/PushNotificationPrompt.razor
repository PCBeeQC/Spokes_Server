@using Spokes_Server.Core.Services
@using Spokes_Server.Core.Data
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject Database Db
@inject AuthenticationStateProvider AuthStateProvider
@inject UserService UserService
@inject Microsoft.Extensions.Configuration.IConfiguration Config

@if (ShowPrompt && IsSupported && IsConfigured && !IsSubscribed && !IsSuspended)
{
    <MudAlert Severity="Severity.Info" Class="mb-4" Dense="true" ShowCloseIcon="true" CloseIconClicked="DismissPrompt">
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.NotificationsActive" />
            <MudText Typo="Typo.body2" Class="flex-grow-1">
                Get notified when you receive new messages, even when the browser is minimized.
            </MudText>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" Disabled="@IsLoading"
                OnClick="EnableNotifications">
                @if (IsLoading)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                }
                Enable Notifications
            </MudButton>
        </div>
    </MudAlert>
}

@code {
    [Parameter] public bool ShowAsPrompt { get; set; } = true;

    private bool ShowPrompt = true;
    private bool IsSupported = false;
    private bool IsConfigured = false;
    private bool IsSubscribed = false;
    private bool IsLoading = false;
    private bool IsSuspended = false;
    private string? CurrentUserId;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadStatus();
            StateHasChanged();
        }
    }

    private async Task LoadStatus()
    {
        if (Config.GetValue<bool>("Spokes_DemoMode"))
        {
            ShowPrompt = false;
            return;
        }

        try
        {
            // Get current user
            var employee = await UserService.GetEmployeeAsync();
            if (employee != null)
            {
                CurrentUserId = employee.Id;
                IsSuspended = employee.IsSuspended;
            }

            // Check browser support
            IsSupported = await JS.InvokeAsync<bool>("pushNotifications.isSupported");

            if (IsSupported)
            {
                // Check if VAPID is configured
                var profile = Db.CompanyProfile.Get();
                IsConfigured = !string.IsNullOrEmpty(profile?.VapidPublicKey);

                if (IsConfigured)
                {
                    // Check existing subscription
                    var existingSub = await JS.InvokeAsync<Dictionary<string, object>?>("pushNotifications.getExistingSubscription");
                    IsSubscribed = existingSub != null && existingSub.ContainsKey("endpoint");
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error loading push status: {ex.Message}");
        }
    }

    private async Task EnableNotifications()
    {
        if (IsLoading) return;
        if (IsSuspended)
        {
            Snackbar.Add("Suspended accounts cannot enable notifications for new devices.", Severity.Error);
            return;
        }
        IsLoading = true;
        StateHasChanged();

        try
        {
            // 1. Request permission - returns object with permission property
            var permResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.requestPermission");
            var permission = permResult?.GetValueOrDefault("permission")?.ToString() ?? "denied";

            if (permission != "granted")
            {
                Snackbar.Add("Notification permission was denied. Please enable notifications in your browser settings.",
                Severity.Warning);
                return;
            }

            // 2. Register service worker
            var swResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.registerServiceWorker");
            var swSuccess = swResult?.GetValueOrDefault("success")?.ToString() == "True";

            if (!swSuccess)
            {
                Snackbar.Add("Failed to register service worker. Please try again.", Severity.Error);
                return;
            }

            // 3. Get VAPID public key
            var profile = Db.CompanyProfile.Get();
            if (string.IsNullOrEmpty(profile?.VapidPublicKey))
            {
                Snackbar.Add("Push notifications are not configured. Please contact an administrator.", Severity.Error);
                return;
            }

            // 4. Subscribe to push
            var subscription = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.subscribe",
            profile.VapidPublicKey);

            if (subscription == null || !subscription.ContainsKey("endpoint"))
            {
                var error = subscription?.GetValueOrDefault("error")?.ToString() ?? "Unknown error";
                Snackbar.Add($"Failed to subscribe: {error}", Severity.Error);
                return;
            }

            // 5. Send subscription to server
            var result = await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer", subscription);
            if (result)
            {
                IsSubscribed = true;
                Snackbar.Add("Push notifications enabled! You'll receive alerts for new messages.", Severity.Success);
            }
            else
            {
                Snackbar.Add("Failed to save subscription. Please try again.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error enabling notifications: {ex.Message}");
            Snackbar.Add("An error occurred while enabling notifications.", Severity.Error);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    private void DismissPrompt()
    {
        ShowPrompt = false;
    }

    /// <summary>
    /// Public method to show the subscription dialog/prompt.
    /// Call this from parent components to trigger the subscription flow.
    /// </summary>
    public async Task ShowSubscriptionDialog()
    {
        if (IsSuspended)
        {
            Snackbar.Add("Suspended accounts cannot enable notifications for new devices.", Severity.Error);
            return;
        }

        if (!IsSupported)
        {
            Snackbar.Add("Your browser does not support push notifications.", Severity.Warning);
            return;
        }

        if (!IsConfigured)
        {
            Snackbar.Add("Push notifications are not configured. Please contact an administrator.", Severity.Warning);
            return;
        }

        if (IsSubscribed)
        {
            Snackbar.Add("Push notifications are already enabled.", Severity.Info);
            return;
        }

        await EnableNotifications();
    }
}
