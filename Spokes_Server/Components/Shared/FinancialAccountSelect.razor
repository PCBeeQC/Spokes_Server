@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Services.Accounting
@inject IFinancialAccountService FinancialAccounts
@inject UserService UserService

<MudSelect T="string"
           Value="@Value"
           ValueChanged="@OnValueChanged"
           Label="@Label"
           Placeholder="@Placeholder"
           Clearable="@Clearable"
           ReadOnly="@ReadOnly"
           Disabled="@(Disabled || !_canReadAccounting)"
           Dense="@Dense"
           Margin="@Margin"
           Variant="@Variant"
           Style="@Style"
           ToStringFunc="@FormatDisplay">
    @foreach (var account in _accounts)
    {
        <MudSelectItem T="string" Value="@account.LinkedGlAccountCode">
            <div class="d-flex align-center gap-2">
                <MudIcon Icon="@GetTypeIcon(account.AccountType)" Size="Size.Small" Color="@GetTypeColor(account.AccountType)" />
                <span>@account.DisplayLabel</span>
                @if (!account.IsActive)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary">(@BizLoc["Archived"])</MudText>
                }
            </div>
        </MudSelectItem>
    }
    @if (!string.IsNullOrWhiteSpace(Value) && !_accounts.Any(a => string.Equals(a.LinkedGlAccountCode, Value.Trim(), StringComparison.OrdinalIgnoreCase)))
    {
        <MudSelectItem T="string" Value="@Value">
            @FormatDisplay(Value)
        </MudSelectItem>
    }
</MudSelect>

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Clearable { get; set; }
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Dense { get; set; } = true;
    [Parameter] public Margin Margin { get; set; } = Margin.Dense;
    [Parameter] public Variant Variant { get; set; } = Variant.Outlined;
    [Parameter] public string? Style { get; set; }
    [Parameter] public string[]? AllowedTypes { get; set; }

    private List<FinancialAccount> _accounts = [];
    private bool _canReadAccounting;

    protected override async Task OnParametersSetAsync()
    {
        var emp = await UserService.GetEmployeeAsync(allowSuspended: true);
        _canReadAccounting = emp != null && emp.IsActive && !emp.IsBanned && !emp.IsSystem &&
            (emp.IsAdmin || emp.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: true));

        if (!_canReadAccounting)
        {
            _accounts = [];
            return;
        }

        _accounts = FinancialAccounts.GetActiveAccounts(AllowedTypes);

        // Preserve visibility of an archived account if it is currently selected on a historical record
        if (!string.IsNullOrWhiteSpace(Value) &&
            !_accounts.Any(a => string.Equals(a.LinkedGlAccountCode, Value.Trim(), StringComparison.OrdinalIgnoreCase)))
        {
            var archivedMatch = FinancialAccounts.GetByGlCode(Value);
            if (archivedMatch != null)
            {
                _accounts.Add(archivedMatch);
            }
        }
    }

    private string FormatDisplay(string? glCode)
    {
        if (string.IsNullOrWhiteSpace(glCode)) return string.Empty;
        var match = _accounts.FirstOrDefault(a => string.Equals(a.LinkedGlAccountCode, glCode.Trim(), StringComparison.OrdinalIgnoreCase));
        if (match != null) return match.DisplayLabel;
        return FinancialAccounts.GetDisplayLabelByGlCode(glCode);
    }

    private Task OnValueChanged(string? newValue)
    {
        Value = newValue;
        return ValueChanged.InvokeAsync(newValue);
    }

    public static string GetTypeIcon(string? accountType) => accountType switch
    {
        FinancialAccountType.Chequing => Icons.Material.Filled.AccountBalance,
        FinancialAccountType.Savings => Icons.Material.Filled.Savings,
        FinancialAccountType.CreditCard => Icons.Material.Filled.CreditCard,
        FinancialAccountType.LineOfCredit => Icons.Material.Filled.CreditScore,
        FinancialAccountType.PaymentProcessor => Icons.Material.Filled.PointOfSale,
        FinancialAccountType.Loan => Icons.Material.Filled.RequestQuote,
        FinancialAccountType.CashOnHand => Icons.Material.Filled.LocalAtm,
        _ => Icons.Material.Filled.AccountBalanceWallet
    };

    public static Color GetTypeColor(string? accountType) => accountType switch
    {
        FinancialAccountType.Chequing => Color.Primary,
        FinancialAccountType.Savings => Color.Success,
        FinancialAccountType.CreditCard => Color.Warning,
        FinancialAccountType.LineOfCredit => Color.Info,
        FinancialAccountType.PaymentProcessor => Color.Secondary,
        FinancialAccountType.Loan => Color.Error,
        FinancialAccountType.CashOnHand => Color.Default,
        _ => Color.Default
    };
}
