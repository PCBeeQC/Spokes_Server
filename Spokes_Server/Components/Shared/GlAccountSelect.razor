@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Services.Accounting
@inject Database Db
@inject IJurisdictionTemplateService JurisdictionService
@inject UserService UserService

<MudAutocomplete T="string"
                 Value="@Value"
                 ValueChanged="@OnValueChanged"
                 SearchFunc="@SearchAccounts"
                 ToStringFunc="@FormatAccountDisplay"
                 Label="@Label"
                 Placeholder="@Placeholder"
                 Clearable="@Clearable"
                 ReadOnly="@ReadOnly"
                 Disabled="@(Disabled || !_canReadAccounting)"
                 Dense="@Dense"
                 Underline="@Underline"
                 Margin="@Margin"
                 Variant="@Variant"
                 Style="@Style"
                 CoerceText="false"
                 CoerceValue="true"
                 MaxItems="100" />

@code {
    [Parameter] public string? Value { get; set; }
    [Parameter] public EventCallback<string?> ValueChanged { get; set; }
    [Parameter] public string? Label { get; set; }
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public bool Clearable { get; set; } = true;
    [Parameter] public bool ReadOnly { get; set; }
    [Parameter] public bool Disabled { get; set; }
    [Parameter] public bool Dense { get; set; }
    [Parameter] public bool Underline { get; set; } = true;
    [Parameter] public Margin Margin { get; set; } = Margin.None;
    [Parameter] public Variant Variant { get; set; } = Variant.Text;
    [Parameter] public string? Style { get; set; }
    [Parameter] public string? FilterType { get; set; }
    [Parameter] public string[]? FilterSubTypes { get; set; }
    [Parameter] public string[]? ExcludeSubTypes { get; set; }
    /// <summary>
    /// When false (default for day-to-day business owner UI), displays only the friendly localized category name
    /// without numeric GL codes. Set to true only on accountant/GL/migration screens.
    /// </summary>
    [Parameter] public bool ShowAccountCode { get; set; } = false;

    private List<GlAccount> _accounts = [];
    private bool _canReadAccounting;

    protected override async Task OnParametersSetAsync()
    {
        await RefreshCanReadAccountingAsync();
        LoadAccounts();
    }

    private async Task<bool> RefreshCanReadAccountingAsync()
    {
        var emp = await UserService.GetEmployeeAsync(allowSuspended: true);
        _canReadAccounting = emp != null && emp.IsActive && !emp.IsBanned && !emp.IsSystem &&
            (emp.IsAdmin || emp.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: true));
        return _canReadAccounting;
    }

    private void LoadAccounts()
    {
        if (!_canReadAccounting)
        {
            _accounts = [];
            return;
        }

        JurisdictionService.EnsureChartOfAccountsSeeded();
        IEnumerable<GlAccount> query = Db.GlAccounts?.GetActive() ?? [];
        if (!string.IsNullOrWhiteSpace(FilterType))
        {
            query = query.Where(a => string.Equals(a.Type, FilterType, StringComparison.OrdinalIgnoreCase));
        }

        if (FilterSubTypes is { Length: > 0 })
        {
            query = query.Where(a => FilterSubTypes.Any(st => string.Equals(a.SubType, st, StringComparison.OrdinalIgnoreCase)));
        }

        if (ExcludeSubTypes is { Length: > 0 })
        {
            query = query.Where(a => !ExcludeSubTypes.Any(st => string.Equals(a.SubType, st, StringComparison.OrdinalIgnoreCase)));
        }

        _accounts = query.OrderBy(a => a.Code, StringComparer.OrdinalIgnoreCase).ToList();
    }

    private async Task<IEnumerable<string>> SearchAccounts(string? search, CancellationToken token)
    {
        if (!await RefreshCanReadAccountingAsync())
        {
            _accounts = [];
            return [];
        }

        LoadAccounts();

        if (string.IsNullOrWhiteSpace(search))
        {
            return _accounts.Select(a => a.Code);
        }

        var term = search.Trim();
        var matches = _accounts
            .Where(a => a.Name.Contains(term, StringComparison.OrdinalIgnoreCase)
                        || (!string.IsNullOrWhiteSpace(a.NameFr) && a.NameFr.Contains(term, StringComparison.OrdinalIgnoreCase))
                        || a.GetLocalizedName().Contains(term, StringComparison.OrdinalIgnoreCase)
                        || (ShowAccountCode && (
                            a.Code.Contains(term, StringComparison.OrdinalIgnoreCase)
                            || a.SubType.Contains(term, StringComparison.OrdinalIgnoreCase)
                            || (!string.IsNullOrWhiteSpace(a.StandardTaxCode) && a.StandardTaxCode.Contains(term, StringComparison.OrdinalIgnoreCase)))))
            .Select(a => a.Code);

        return matches;
    }

    private string FormatAccountDisplay(string? code)
    {
        if (string.IsNullOrWhiteSpace(code)) return string.Empty;
        var match = _accounts.FirstOrDefault(a => string.Equals(a.Code, code.Trim(), StringComparison.OrdinalIgnoreCase));
        if (match == null) return code;
        if (!ShowAccountCode)
        {
            return match.GetLocalizedName();
        }
        return FilterSubTypes is { Length: > 1 }
            ? $"{match.Code} — {match.GetLocalizedName()} ({match.SubType})"
            : $"{match.Code} — {match.GetLocalizedName()}";
    }

    private Task OnValueChanged(string? newValue)
    {
        Value = newValue;
        return ValueChanged.InvokeAsync(newValue);
    }
}
