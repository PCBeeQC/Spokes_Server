<MudDialog>
    <DialogContent>
        <MudTextField @bind-Value="NewContent" Label="@Loc["Edit Message"]" Variant="Variant.Outlined" Lines="8" MaxLines="15"
            FullWidth="true" AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
            Disabled="@(string.IsNullOrWhiteSpace(NewContent))">
            @Loc["Save Changes"]
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string OriginalContent { get; set; } = "";

    private string NewContent { get; set; } = "";

    protected override void OnInitialized()
    {
        NewContent = OriginalContent;
    }

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(NewContent));
}

