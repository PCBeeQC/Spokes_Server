<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@(CustomIcon ?? (IsAttendeesMode ? Icons.Material.Filled.EventAvailable : (IsReadReceiptMode ? Icons.Material.Filled.DoneAll : Icons.Material.Filled.People)))" Size="Size.Small" />
            <MudText Typo="Typo.h6">@(CustomTitle ?? (IsAttendeesMode ? Loc["Event Attendees"].Value : (IsReadReceiptMode ? Loc["Read Receipts"].Value : Loc["Message Reactions"].Value)))</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 pb-2" style="max-height: 50vh; overflow-y: auto;">
            @if (_reactionGroups != null && _reactionGroups.Any())
            {
                foreach (var group in _reactionGroups)
                {
                    <MudCard Elevation="0" Class="pa-0" Style="border-radius: 12px; overflow: hidden; border: 1px solid var(--mud-palette-divider);">
                        <div class="d-flex align-center justify-space-between px-4 py-3" style="background-color: var(--mud-palette-background-grey);">
                            <div class="d-flex align-center gap-2">
                                @if (IsAttendeesMode)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Size="Size.Small" Color="Color.Success" />
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@GetLocalizedGroupName(group.Key)</MudText>
                                }
                                else if (IsReadReceiptMode)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Secondary" />
                                    <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@GetLocalizedGroupName(group.Key)</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.h5" Class="mr-2">@string.Format(Loc["{0} Reaction"].Value, group.Key)</MudText>
                                }
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @group.Value.Count @(group.Value.Count == 1 ? ((IsReadReceiptMode || IsAttendeesMode) ? Loc["person"].Value : Loc["reaction"].Value) : ((IsReadReceiptMode || IsAttendeesMode) ? Loc["people"].Value : Loc["reactions"].Value))
                            </MudChip>
                        </div>
                        <MudDivider />
                        @if (AnonymizeUsers)
                        {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center pa-3">
                                @Loc["User identities are hidden in this channel."]
                            </MudText>
                        }
                        else
                        {
                            <MudList T="string" Dense="true" Class="px-2 py-2">
                                @foreach (var emp in group.Value)
                                {
                                    <div class="d-flex align-center gap-3 py-2 px-2 rounded hover-bg">
                                        <EmployeeAvatar Employee="@emp" Size="Size.Medium" />
                                        <div class="d-flex flex-column">
                                            <MudText Typo="Typo.body1" Style="font-weight: 600;">@emp.FullName</MudText>
                                            @if (!string.IsNullOrWhiteSpace(emp.Position))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">@emp.Position</MudText>
                                            }
                                        </div>
                                    </div>
                                }
                            </MudList>
                        }
                    </MudCard>
                }
            }
            else
            {
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-center pa-4">
                    @(IsAttendeesMode ? Loc["No attendees found."].Value : (IsReadReceiptMode ? Loc["No read receipts found."].Value : Loc["No reactions found."].Value))
                </MudText>
            }
        </div>
    </DialogContent>
</MudDialog>

<style>
    .hover-bg {
        transition: background-color 0.2s;
    }
    .hover-bg:hover {
        background-color: var(--mud-palette-action-default-hover);
    }
</style>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ChatMessage Message { get; set; } = new();
    [Parameter] public List<Employee> Employees { get; set; } = [];
    [Parameter] public bool AnonymizeUsers { get; set; } = false;
    
    [Parameter] public bool IsReadReceiptMode { get; set; }
    [Parameter] public List<string> ReadReceiptUserIds { get; set; } = [];

    [Parameter] public bool IsAttendeesMode { get; set; }
    [Parameter] public List<string> AttendeeUserIds { get; set; } = [];
    [Parameter] public string? CustomTitle { get; set; }
    [Parameter] public string? CustomIcon { get; set; }
    [Parameter] public string? GroupNameOverride { get; set; }

    private Dictionary<string, List<Employee>> _reactionGroups = [];

    protected override void OnInitialized()
    {
        Dictionary<string, List<Employee>> groups = [];
        
        if (IsAttendeesMode)
        {
            List<Employee> attendees = [];
            foreach (var userId in AttendeeUserIds)
            {
                var emp = Employees.FirstOrDefault(e => e.Id == userId);
                if (emp != null)
                {
                    attendees.Add(emp);
                }
            }
            if (attendees.Any())
            {
                groups[GroupNameOverride ?? "Attending"] = attendees.OrderBy(e => e.FullName).ToList();
            }
        }
        else if (IsReadReceiptMode)
        {
            List<Employee> readers = [];
            foreach (var userId in ReadReceiptUserIds)
            {
                if (userId == Message.SenderId) continue; // Exclude the sender
                
                var emp = Employees.FirstOrDefault(e => e.Id == userId);
                if (emp != null)
                {
                    readers.Add(emp);
                }
            }
            if (readers.Any())
            {
                groups["Seen By"] = readers.OrderBy(e => e.FullName).ToList();
            }
        }
        else
        {
            foreach (var react in Message.Reactions)
            {
                var parts = react.Split(':');
                if (parts.Length == 2)
                {
                    var emoji = parts[0];
                    var userId = parts[1];
                    
                    var emp = Employees.FirstOrDefault(e => e.Id == userId);
                    if (emp != null)
                    {
                        if (!groups.TryGetValue(emoji, out var list))
                        {
                            groups[emoji] = list = [];
                        }
                        list.Add(emp);
                    }
                }
            }
        }
        
        // Sort by most reacted emojis first
        _reactionGroups = groups.OrderByDescending(g => g.Value.Count)
                                .ToDictionary(g => g.Key, g => g.Value.OrderBy(e => e.FullName).ToList());
    }

    private string GetLocalizedGroupName(string name)
    {
        if (name == "Attending") return Loc["Attending"].Value;
        if (name == "Seen By") return Loc["Seen By"].Value;
        return name;
    }
}
