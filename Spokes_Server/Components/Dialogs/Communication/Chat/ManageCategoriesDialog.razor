@using Spokes_Server.Core.Services.Security
@inject IChatService ChatService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ScopedKeystoreService ScopedKeystore

<MudDialog>
    <DialogContent>
        <div class="d-flex gap-2 align-center mb-4">
            <MudTextField @bind-Value="_newCategoryName" Immediate="true" Label="@Loc["New Category Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="AddCategory" Disabled="@string.IsNullOrWhiteSpace(_newCategoryName)">@Loc["Add"]</MudButton>
        </div>

        <MudList T="string" Dense="true" Class="overflow-auto" Style="max-height: 400px;">
            @for (int i = 0; i < Categories.Count; i++)
            {
                var cat = Categories[i];
                var isFirst = i == 0;
                var isLast = i == Categories.Count - 1;
                var canMoveUp = !isFirst && cat.Id != "sys_archive";
                var canMoveDown = !isLast && cat.Id != "sys_archive" && Categories[i + 1].Id != "sys_archive";
                <MudListItem T="string">
                    <div class="d-flex align-center justify-space-between w-100">
                        <MudText>@cat.Name</MudText>
                        <div class="d-flex gap-1">
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveUp(cat))" Disabled="@(!canMoveUp)" />
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveDown(cat))" Disabled="@(!canMoveDown)" />
                            @if (!cat.IsSystem)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => DeleteCategory(cat))" />
                            }
                            else
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Disabled="true" />
                            }
                        </div>
                    </div>
                </MudListItem>
            }
        </MudList>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" OnClick="Close">@Loc["Done"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? CurrentUserId { get; set; }

    private List<ChatCategory> Categories = [];
    private string _newCategoryName = "";

    protected override void OnInitialized() => LoadCategories();

    private void LoadCategories()
    {
        Categories = ChatService.GetCategories();
    }

    private void AddCategory()
    {
        if (string.IsNullOrWhiteSpace(_newCategoryName)) return;

        var result = ChatService.CreateCategory(_newCategoryName, CurrentUserId ?? string.Empty);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to create category."].Value, Severity.Error);
            return;
        }

        _newCategoryName = "";
        LoadCategories();
    }

    private void MoveUp(ChatCategory cat)
    {
        if (cat.Id == "sys_archive") return;
        var index = Categories.IndexOf(cat);
        if (index > 0)
        {
            var reordered = new List<ChatCategory>(Categories);
            (reordered[index - 1], reordered[index]) = (reordered[index], reordered[index - 1]);
            SaveCategoryOrders(reordered);
        }
    }

    private void MoveDown(ChatCategory cat)
    {
        if (cat.Id == "sys_archive") return;
        var index = Categories.IndexOf(cat);
        if (index >= 0 && index < Categories.Count - 1 && Categories[index + 1].Id != "sys_archive")
        {
            var reordered = new List<ChatCategory>(Categories);
            (reordered[index], reordered[index + 1]) = (reordered[index + 1], reordered[index]);
            SaveCategoryOrders(reordered);
        }
    }

    private void SaveCategoryOrders(List<ChatCategory> reordered)
    {
        var orders = new Dictionary<string, int>(StringComparer.Ordinal);
        for (int i = 0; i < reordered.Count; i++)
        {
            orders[reordered[i].Id] = reordered[i].Id == "sys_archive" ? 10000 : i;
        }

        var result = ChatService.UpdateCategoryOrders(orders, CurrentUserId ?? string.Empty);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to update category order."].Value, Severity.Error);
            return;
        }

        LoadCategories();
    }

    private async Task DeleteCategory(ChatCategory cat)
    {
        if (cat.IsSystem) return;

        int channelCount = ChatService.GetCategoryChannelCount(cat.Id, CurrentUserId ?? string.Empty);

        var options = new DialogOptions { CloseOnEscapeKey = true };
        bool? result = await DialogService.ShowMessageBoxAsync(
            Loc["Delete Category"].Value,
            string.Format(Loc["Are you sure you want to delete '{0}'?"].Value, cat.Name) + (channelCount > 0 ? $"\n\n" + string.Format(Loc["There are {0} channel(s) in this category. They will be returned to their default categories."].Value, channelCount) : ""),
            yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value, options: options);

        if (result == true)
        {
            var deleteResult = ChatService.DeleteCategory(cat.Id, CurrentUserId ?? string.Empty, ScopedKeystore.IsUnlocked);
            if (!deleteResult.IsSuccess)
            {
                Snackbar.Add(deleteResult.ErrorMessage ?? Loc["Failed to delete category."].Value, Severity.Error);
                return;
            }

            LoadCategories();
        }
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(true));
}
