@using Spokes_Server.Components.Shared
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.UI
@using Spokes_Server.Components.Pages.Email
@using Microsoft.AspNetCore.Components.Authorization
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Services.Communication.Email
@using System.Text.RegularExpressions
@inject IEmailMessageLifecycleService MessageLifecycleService
@inject IEmailDeliveryService EmailDeliveryService
@inject IEmailDraftService EmailDraftService
@inject IEmailCacheMaintenanceService EmailCacheMaintenanceService
@inject IEmailInboxService InboxService
@inject Database Db
@inject UserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IBrowserViewportService ViewportService
@inject ILogger<EmailComposer> Logger
@implements IDisposable

<MudDialog Class="email-composer-dialog" ContentClass="email-composer-dialog-content">
    <DialogContent>
        @if (_isLoading)
        {
            <div class="d-flex justify-center align-center flex-grow-1 h-100" style="min-height: 250px;">
                <MudProgressCircular Indeterminate="true" Color="Color.Primary" />
            </div>
        }
        else
        {
            <MudForm @ref="_form" @bind-IsValid="@_success" Class="email-composer-form">
                <div class="email-composer-header flex-shrink-0">
                    @if (_headerCollapsed && CanCollapseHeader)
                    {
                        <div class="email-composer-summary-row d-flex align-center gap-2 cursor-pointer"
                             role="button" tabindex="0"
                             @onclick="@(() => _headerCollapsed = false)">
                            <MudIcon Icon="@(!string.IsNullOrEmpty(Body) || !string.IsNullOrEmpty(InReplyTo) ? Icons.Material.Filled.Reply : Icons.Material.Outlined.Email)"
                                     Size="Size.Small" Color="Color.Secondary" Class="flex-shrink-0" />
                            <div class="d-flex align-center gap-1 flex-grow-1 min-w-0">
                                <MudText Typo="Typo.body2" Class="email-summary-recipient text-truncate">
                                    @PrimaryRecipientSummary
                                </MudText>
                                @if (TotalRecipientCount > 1)
                                {
                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Primary"
                                             Class="ma-0 px-1 flex-shrink-0 email-summary-count-chip">
                                        +@(TotalRecipientCount - 1)
                                    </MudChip>
                                }
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="flex-shrink-0">•</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="text-truncate flex-grow-1 min-w-0">
                                    @_subject
                                </MudText>
                            </div>
                            <MudTooltip Text="@BizLoc["Expand header"]">
                                <MudIcon Icon="@Icons.Material.Filled.ExpandMore" Size="Size.Small" Color="Color.Secondary" Class="flex-shrink-0" />
                            </MudTooltip>
                        </div>
                    }
                    else
                    {
                        <div class="email-composer-field-row d-flex align-center w-100">
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="email-composer-field-label flex-shrink-0">
                                @BizLoc["From"]
                            </MudText>
                            <div class="flex-grow-1 min-w-0">
                                @if (_permittedIdentities.Any())
                                {
                                    <MudSelect T="string" Value="@_selectedIdentityId" ValueChanged="OnSelectedIdentityChanged"
                                               Variant="Variant.Text" Underline="false" Margin="Margin.Dense" Dense="true"
                                               FullWidth="true" Class="ma-0 email-composer-flat-input"
                                               aria-label="@BizLoc["From"]">
                                        @foreach (var identity in _permittedIdentities)
                                        {
                                            <MudSelectItem T="string" Value="@identity.Id">@identity.FormattedFrom</MudSelectItem>
                                        }
                                    </MudSelect>
                                }
                                else
                                {
                                    <MudTextField T="string" Value="@_from" ReadOnly="true"
                                                  Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                                  FullWidth="true" Class="ma-0 email-composer-flat-input"
                                                  aria-label="@BizLoc["From"]" />
                                }
                            </div>
                            @if (CanCollapseHeader)
                            {
                                <div class="d-flex align-center flex-shrink-0 ml-1 email-composer-trailing-actions">
                                    <MudTooltip Text="@BizLoc["Collapse header"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.ExpandLess" Size="Size.Small" Color="Color.Default"
                                                       OnClick="@(() => _headerCollapsed = true)"
                                                       aria-label="@BizLoc["Collapse header"]" />
                                    </MudTooltip>
                                </div>
                            }
                        </div>

                        @if (!_permittedIdentities.Any() && !_isBillInboxContext)
                        {
                            <MudAlert Severity="Severity.Warning" Dense="true" Square="true" Class="ma-0">
                                @BizLoc["No sending identity is available. Configure a Sending Identity in Email Settings before sending."]
                            </MudAlert>
                        }

                        <EmailRecipientInput Label="@BizLoc["To"]" SelectedEmails="@_toList"
                                             SelectedEmailsChanged="@((List<string> val) => { _toList = val; OnFieldChanged(); })"
                                             OnAddressBookClick="@(() => OpenAddressBook("To"))">
                            <TrailingActions>
                                <MudTooltip Text="@(_showCcBcc ? BizLoc["Hide Cc/Bcc"] : BizLoc["Cc/Bcc"])">
                                    <MudIconButton Icon="@(_showCcBcc ? Icons.Material.Filled.ExpandLess : Icons.Material.Filled.ExpandMore)"
                                                   Size="Size.Small"
                                                   Color="@((_ccList.Any() || _bccList.Any()) && !_showCcBcc ? Color.Primary : Color.Default)"
                                                   OnClick="@(() => _showCcBcc = !_showCcBcc)"
                                                   aria-label="@(_showCcBcc ? BizLoc["Hide Cc/Bcc"] : BizLoc["Cc/Bcc"])" />
                                </MudTooltip>
                            </TrailingActions>
                        </EmailRecipientInput>

                        <MudCollapse Expanded="_showCcBcc">
                            <EmailRecipientInput Label="@BizLoc["Cc"]" SelectedEmails="@_ccList"
                                                 SelectedEmailsChanged="@((List<string> val) => { _ccList = val; OnFieldChanged(); })"
                                                 OnAddressBookClick="@(() => OpenAddressBook("Cc"))" />
                            <EmailRecipientInput Label="@BizLoc["Bcc"]" SelectedEmails="@_bccList"
                                                 SelectedEmailsChanged="@((List<string> val) => { _bccList = val; OnFieldChanged(); })"
                                                 OnAddressBookClick="@(() => OpenAddressBook("Bcc"))" />
                        </MudCollapse>

                        <div class="email-composer-field-row d-flex align-center w-100">
                            <MudTextField T="string" Value="@_subject"
                                          ValueChanged="@((string v) => { _subject = v; OnFieldChanged(); })"
                                          Placeholder="@BizLoc["Subject"]"
                                          Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                                          Immediate="true" FullWidth="true"
                                          Class="ma-0 email-composer-flat-input"
                                          aria-label="@BizLoc["Subject"]" />
                        </div>
                    }
                </div>

                <div class="email-composer-scroll-canvas" data-quill-scroll-container="true">
                    <SpokesRichTextEditor @ref="_editor" Value="@_body" ValueChanged="OnBodyChanged"
                                          ShowToolbar="@_showFormattingToolbar" Borderless="true"
                                          Class="email-composer-editor" />

                    @if (!string.IsNullOrEmpty(Body))
                    {
                        <div class="email-composer-quote-section">
                            <div class="email-composer-quote-toggle-row">
                                <MudTooltip Text="@(_showQuotedMessage ? BizLoc["Hide original message"] : BizLoc["Show original message"])">
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Default"
                                               Class="email-quote-pill-btn"
                                               OnClick="@(() => _showQuotedMessage = !_showQuotedMessage)"
                                               aria-label="@(_showQuotedMessage ? BizLoc["Hide original message"] : BizLoc["Show original message"])">
                                        <MudIcon Icon="@Icons.Material.Filled.MoreHoriz" Size="Size.Small" />
                                    </MudButton>
                                </MudTooltip>
                            </div>
                            <MudCollapse Expanded="_showQuotedMessage">
                                <div class="email-reply-chain-body border rounded pa-3 mt-2 mb-3 mud-theme-surface">
                                    <EmailContentRenderer HtmlContent="@Body" AllowRemoteImages="false" />
                                </div>
                            </MudCollapse>
                        </div>
                    }
                </div>

                @if (TotalAttachmentCount > 0)
                {
                    <div class="email-composer-attachments-bar flex-shrink-0">
                        <div class="d-flex flex-wrap align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Color="Color.Secondary" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mr-1">
                                @TotalAttachmentCount @BizLoc["file(s) attached"]
                            </MudText>
                            @foreach (var file in _attachments)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-0"
                                         OnClose="@(() => { _attachments.Remove(file); OnFieldChanged(); })">
                                    @file.Name (@(file.Size / 1024) KB)
                                </MudChip>
                            }
                            @foreach (var existing in _existingAttachments)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-0"
                                         OnClose="@(() => RemoveExistingAttachment(existing))">
                                    @existing.FileName (@(existing.Size / 1024) KB)
                                </MudChip>
                            }
                            @foreach (var docAtt in _documentAttachments)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-0"
                                         OnClose="@(() => { _documentAttachments.Remove(docAtt); OnFieldChanged(); })">
                                    @(string.IsNullOrWhiteSpace(docAtt.DisplayFileName) ? $"{docAtt.DocumentId}.pdf" : docAtt.DisplayFileName) (@BizLoc["Server File"])
                                </MudChip>
                            }
                            @foreach (var fwdAtt in _forwardedAttachments)
                            {
                                <MudChip T="string" Size="Size.Small" Class="ma-0"
                                         OnClose="@(() => { _forwardedAttachments.Remove(fwdAtt); OnFieldChanged(); })">
                                    @(string.IsNullOrWhiteSpace(fwdAtt.DisplayFileName) ? fwdAtt.AttachmentId : fwdAtt.DisplayFileName)
                                </MudChip>
                            }
                        </div>
                    </div>
                }
            </MudForm>
        }
    </DialogContent>
    <DialogActions>
        <MudFileUpload @ref="_fileUpload" T="IReadOnlyList<IBrowserFile>" FilesChanged="UploadFiles" Accept="*"
                       Hidden="true" Class="d-none" id="email-composer-upload" />

        <div class="d-flex align-center gap-1 flex-grow-1 min-w-0">
            <MudTooltip Text="@(_showFormattingToolbar ? BizLoc["Hide formatting options"] : BizLoc["Formatting options"])">
                <MudIconButton Icon="@Icons.Material.Filled.TextFormat"
                               Size="Size.Small"
                               Color="@(_showFormattingToolbar ? Color.Primary : Color.Default)"
                               Class="@(_showFormattingToolbar ? "email-toolbar-toggle-active" : "")"
                               OnClick="@(() => _showFormattingToolbar = !_showFormattingToolbar)"
                               aria-label="@(_showFormattingToolbar ? BizLoc["Hide formatting options"] : BizLoc["Formatting options"])" />
            </MudTooltip>

            @if (_canAttachDocuments)
            {
                <MudMenu AnchorOrigin="Origin.TopLeft" TransformOrigin="Origin.BottomLeft" Dense="true">
                    <ActivatorContent>
                        <MudTooltip Text="@BizLoc["Attach"]">
                            <MudBadge Content="@TotalAttachmentCount" Color="Color.Primary" Overlap="true"
                                      Visible="@(TotalAttachmentCount > 0)">
                                <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                               Size="Size.Small"
                                               Color="@(TotalAttachmentCount > 0 ? Color.Primary : Color.Default)"
                                               aria-label="@BizLoc["Attach"]" />
                            </MudBadge>
                        </MudTooltip>
                    </ActivatorContent>
                    <ChildContent>
                        <MudMenuItem Icon="@Icons.Material.Filled.AttachFile" OnClick="TriggerFilePickerAsync">
                            @BizLoc["Attach files"]
                        </MudMenuItem>
                        <MudMenuItem Icon="@Icons.Material.Filled.FindInPage" OnClick="OpenDocumentPicker">
                            @BizLoc["Attach Internal Document"]
                        </MudMenuItem>
                    </ChildContent>
                </MudMenu>
            }
            else
            {
                <MudTooltip Text="@BizLoc["Attach files"]">
                    <MudBadge Content="@TotalAttachmentCount" Color="Color.Primary" Overlap="true"
                              Visible="@(TotalAttachmentCount > 0)">
                        <MudIconButton Icon="@Icons.Material.Filled.AttachFile"
                                       Size="Size.Small"
                                       Color="@(TotalAttachmentCount > 0 ? Color.Primary : Color.Default)"
                                       OnClick="TriggerFilePickerAsync"
                                       aria-label="@BizLoc["Attach files"]" />
                    </MudBadge>
                </MudTooltip>
            }

            <div class="d-flex align-center ml-1 min-w-0 text-truncate">
                @if (_autoSaveState == AutoSaveStatus.Saving)
                {
                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1 flex-shrink-0" Color="Color.Warning"
                        Style="width:14px;height:14px;" />
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="text-truncate">@BizLoc["Saving draft…"]</MudText>
                }
                else if (_autoSaveState == AutoSaveStatus.Typing)
                {
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Warning" Class="mr-1 flex-shrink-0" />
                    <MudText Typo="Typo.caption" Color="Color.Warning" Class="d-none d-sm-inline text-truncate">@BizLoc["Typing…"]</MudText>
                }
                else if (_autoSaveState == AutoSaveStatus.Saved)
                {
                    <MudIcon Icon="@Icons.Material.Filled.CloudDone" Size="Size.Small" Color="Color.Success" Class="mr-1 flex-shrink-0" />
                    <MudText Typo="Typo.caption" Color="Color.Success" Class="d-none d-sm-inline text-truncate">
                        @BizLoc["Draft saved"]@(_lastSavedTime.HasValue ? $" ({_lastSavedTime.Value:h:mm tt})" : "")
                    </MudText>
                }
                else if (_autoSaveState == AutoSaveStatus.Error)
                {
                    <MudIcon Icon="@Icons.Material.Filled.ErrorOutline" Size="Size.Small" Color="Color.Error" Class="mr-1 flex-shrink-0" />
                    <MudText Typo="Typo.caption" Color="Color.Error" Class="text-truncate">@BizLoc["Save failed"]</MudText>
                }
            </div>
        </div>

        <MudButton Size="Size.Small" OnClick="Cancel">@BizLoc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" OnClick="SendAsync"
            Disabled="@(string.IsNullOrWhiteSpace(_subject) || !_toList.Any() || _isSending)">
            @if (_isSending)
            {
                <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true" />
                <MudText Typo="Typo.button" Class="ms-2">@BizLoc["Sending…"]</MudText>
            }
            else
            {
                @BizLoc["Send"]
            }
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    // ──────────────────── Parameters ────────────────────
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? To { get; set; }
    [Parameter] public string? Subject { get; set; }
    [Parameter] public string? Body { get; set; }
    [Parameter] public string? DraftId { get; set; }
    [Parameter] public List<OutboundDocumentAttachmentRef>? PreloadedDocumentAttachments { get; set; }
    [Parameter] public List<ForwardedEmailAttachmentRef>? PreloadedForwardedAttachments { get; set; }
    [Parameter] public bool IsTemplate { get; set; }
    [Parameter] public string? AccountId { get; set; }
    [Parameter] public string? InboxId { get; set; }
    [Parameter] public string? SendingIdentityId { get; set; }
    [Parameter] public string? InReplyTo { get; set; }
    [Parameter] public List<string>? References { get; set; }
    [Parameter] public List<string>? ReplyReceivingAddresses { get; set; }
    [Parameter] public string? SenderFrom { get; set; }

    private bool _isLoading = true;
    private bool _canAttachDocuments;

    // ──────────────────── Form & UI state ────────────────────
    private MudForm _form = default!;
    private SpokesRichTextEditor _editor = default!;
    private MudFileUpload<IReadOnlyList<IBrowserFile>>? _fileUpload;
    private bool _success;
    private bool _isSending;
    private bool _editorReady;
    private bool _headerCollapsed;
    private bool _showFormattingToolbar = true;
    private bool _showQuotedMessage;

    private string _effectiveAccountId = "";
    private List<EmailSendingIdentity> _permittedIdentities = [];
    private string? _selectedIdentityId;
    private string _from = "";
    private List<string> _toList = [];
    private List<string> _ccList = [];
    private List<string> _bccList = [];
    private bool _showCcBcc;
    private string _subject = "";
    private string _body = "";

    private List<IBrowserFile> _attachments = [];
    private List<EmailAttachmentMeta> _existingAttachments = [];
    private List<OutboundDocumentAttachmentRef> _documentAttachments = [];
    private List<ForwardedEmailAttachmentRef> _forwardedAttachments = [];

    private int TotalAttachmentCount => _attachments.Count + _existingAttachments.Count + _documentAttachments.Count + _forwardedAttachments.Count;
    private int TotalRecipientCount => _toList.Count + _ccList.Count + _bccList.Count;
    private bool CanCollapseHeader => _toList.Any() && !string.IsNullOrWhiteSpace(_subject);
    private string PrimaryRecipientSummary => _toList.FirstOrDefault() ?? _ccList.FirstOrDefault() ?? _bccList.FirstOrDefault() ?? "";

    private static readonly Regex SignatureBlockRegex = new(
        @"<!--\s*spokes-sig-start\s*-->.*?<!--\s*spokes-sig-end\s*-->",
        RegexOptions.Singleline | RegexOptions.IgnoreCase | RegexOptions.Compiled);

    // ──────────────────── Auto-save state ────────────────────
    private enum AutoSaveStatus { Idle, Typing, Saving, Saved, Error }
    private AutoSaveStatus _autoSaveState = AutoSaveStatus.Idle;
    private string? _currentDraftId;
    private CancellationTokenSource? _debounceCts;
    private bool _dirty;
    private bool _savingInProgress;
    private DateTime? _lastSavedTime;

    // ──────────────────── Lifecycle ────────────────────
    private Employee? _currentEmployee;
    private string _currentEmployeeId = "";
    private bool _isBillInboxContext;

    private bool IsDraftOwnedByCurrentUser(EmailMessage draft, string employeeId) =>
        string.Equals(draft.FolderPath, "LocalDrafts", StringComparison.OrdinalIgnoreCase) &&
        InboxService.CanEmployeeAccessLocalDraft(draft, employeeId);

    protected override async Task OnInitializedAsync()
    {
        if (Db.CompanyProfile.Get()?.Edition == "Family")
        {
            Snackbar.Add(Loc["Email is not available in Family edition."].Value, Severity.Error);
            MudDialog?.Cancel();
            return;
        }

        var employee = await UserService.GetEmployeeAsync();
        if (employee == null || !employee.IsActive || employee.IsBanned || employee.IsSuspended)
        {
            Snackbar.Add(Loc["You are not authorized to compose or send emails."].Value, Severity.Error);
            MudDialog?.Cancel();
            return;
        }

        _currentEmployee = employee;
        _currentEmployeeId = employee.Id;

        _canAttachDocuments = employee.IsAdmin ||
                              employee.HasPermission(AppPermissions.Projects.View) ||
                              employee.HasPermission(AppPermissions.Finance.AccessAccounting) ||
                              employee.HasPermission(AppPermissions.Finance.ApproveInvoices) ||
                              employee.HasPermission(AppPermissions.Purchases.ViewPOs) ||
                              employee.HasPermission(AppPermissions.Purchases.ManagePOs) ||
                              employee.HasPermission(AppPermissions.BusinessDocuments.View);

        _isBillInboxContext =
            string.Equals(AccountId, CompanyBillInboxConstants.SystemEmployeeId, StringComparison.OrdinalIgnoreCase);

        if (_isBillInboxContext)
        {
            if (!(employee.IsAdmin ||
                  employee.HasPermission(AppPermissions.Finance.AccessAccounting) ||
                  employee.HasPermission(AppPermissions.Purchases.ManageBills)))
            {
                Snackbar.Add(Loc["You do not have permission to send email from this inbox."].Value, Severity.Error);
                MudDialog?.Cancel();
                return;
            }

            _effectiveAccountId = CompanyBillInboxConstants.SystemEmployeeId;
            var billInbox = Db.CompanyProfile.GetAccounting().BillInbox;

            EmailSendingIdentity? resolvedIdentity = null;
            if (!string.IsNullOrWhiteSpace(billInbox.SendingIdentityId))
            {
                var configured = Db.EmailSendingIdentities.GetById(billInbox.SendingIdentityId.Trim());
                if (configured is { IsServerManaged: true })
                {
                    resolvedIdentity = configured;
                }
            }
            else if (!string.IsNullOrWhiteSpace(SendingIdentityId))
            {
                var candidate = Db.EmailSendingIdentities.GetById(SendingIdentityId.Trim());
                if (candidate is { IsServerManaged: true } &&
                    IsBillInboxCandidateIdentity(candidate, billInbox))
                {
                    resolvedIdentity = candidate;
                }
            }

            if (resolvedIdentity != null)
            {
                _permittedIdentities = [resolvedIdentity];
                _selectedIdentityId = resolvedIdentity.Id;
                _from = resolvedIdentity.FormattedFrom;
            }
            else if (!string.IsNullOrEmpty(SenderFrom))
            {
                _from = SenderFrom;
            }
            else
            {
                var boundAccount = !string.IsNullOrWhiteSpace(billInbox.AccountId)
                    ? Db.EmailAccounts.GetById(billInbox.AccountId)
                    : null;
                var serverAccount = boundAccount is { IsServerManaged: true } ? boundAccount : null;
                var fallbackAddress = !string.IsNullOrWhiteSpace(serverAccount?.EmailAddress)
                    ? serverAccount.EmailAddress
                    : billInbox.EmailAddress;
                var fallbackName = !string.IsNullOrWhiteSpace(billInbox.DisplayName)
                    ? billInbox.DisplayName
                    : serverAccount?.Name;
                _from = !string.IsNullOrWhiteSpace(fallbackName) && !string.IsNullOrWhiteSpace(fallbackAddress)
                    ? $"{fallbackName} <{fallbackAddress}>"
                    : (fallbackAddress ?? "");
            }
        }
        else
        {
            if (!employee.HasPermission(AppPermissions.Email.Use))
            {
                Snackbar.Add(Loc["You do not have permission to compose or send emails."].Value, Severity.Error);
                MudDialog?.Cancel();
                return;
            }

            EmailInbox? inbox = !string.IsNullOrEmpty(InboxId) ? Db.EmailInboxes.GetById(InboxId) : null;

            if (!string.IsNullOrEmpty(AccountId))
            {
                _effectiveAccountId = AccountId;
            }
            else if (inbox != null && !string.IsNullOrEmpty(inbox.AccountId))
            {
                _effectiveAccountId = inbox.AccountId;
            }
            else
            {
                var firstAccount = InboxService.GetAccessibleAccounts(employee).FirstOrDefault();
                _effectiveAccountId = firstAccount?.Id ?? employee.Id;
            }

            // Only resolve a scoped realInbox if an AccountId or InboxId was explicitly specified.
            // When composing globally (e.g. from All Inboxes), keep realInbox null so all accessible identities are returned.
            var realInbox = (!string.IsNullOrEmpty(AccountId) || inbox != null) && !string.IsNullOrEmpty(_effectiveAccountId)
                ? Db.EmailAccounts.GetById(_effectiveAccountId)
                : null;
            _permittedIdentities = InboxService.GetPermittedIdentities(employee, inbox, ReplyReceivingAddresses, realInbox);
            if (!string.IsNullOrEmpty(SendingIdentityId) && _permittedIdentities.Any(i => i.Id == SendingIdentityId))
            {
                _selectedIdentityId = SendingIdentityId;
            }
            else
            {
                var defaultIdentity = InboxService.SelectDefaultIdentity(employee, inbox, ReplyReceivingAddresses, realInbox);
                _selectedIdentityId = defaultIdentity?.Id ?? _permittedIdentities.FirstOrDefault()?.Id;
            }

            var selected = _permittedIdentities.FirstOrDefault(i => i.Id == _selectedIdentityId);
            _from = selected?.FormattedFrom ?? (SenderFrom ?? employee.Email ?? "");

            _effectiveAccountId = ResolveComposerEffectiveAccountId(employee, selected, _effectiveAccountId);
        }

        if (!string.IsNullOrEmpty(DraftId))
        {
            var draftLookupAccountId = !string.IsNullOrWhiteSpace(AccountId) ? AccountId : _effectiveAccountId;
            var draft = await MessageLifecycleService.GetMessageAsync(draftLookupAccountId, DraftId);
            if (draft == null || !IsDraftOwnedByCurrentUser(draft, _currentEmployeeId))
            {
                _currentDraftId = null;
                Snackbar.Add(Loc["You do not have permission to open this draft."].Value, Severity.Error);
                MudDialog?.Cancel();
                return;
            }

            _effectiveAccountId = draft.AccountId;
            _currentDraftId = DraftId;
            _toList = draft.ToAddresses.ToList();
            _ccList = draft.CcAddresses.ToList();
            if (_ccList.Any()) _showCcBcc = true;
            _bccList = draft.BccAddresses.ToList();
            if (_bccList.Any()) _showCcBcc = true;
            _subject = draft.Subject;
            _existingAttachments = draft.Attachments;
            if (!string.IsNullOrEmpty(draft.SendingIdentityId) && _permittedIdentities.Any(i => i.Id == draft.SendingIdentityId))
            {
                _selectedIdentityId = draft.SendingIdentityId;
                var selectedDraftIdentity = _permittedIdentities.First(i => i.Id == _selectedIdentityId);
                _from = selectedDraftIdentity.FormattedFrom;
            }
            if (!string.IsNullOrEmpty(draft.InReplyTo)) InReplyTo = draft.InReplyTo;
            if (draft.References.Any()) References = draft.References;

            var fullBody = await EmailCacheMaintenanceService.GetEmailBodyAsync(_effectiveAccountId, draft.Id);
            var separator = "<!-- spokes-reply-separator -->";
            var idx = fullBody.IndexOf(separator, StringComparison.Ordinal);
            if (idx >= 0)
            {
                _body = fullBody.Substring(0, idx);
                Body = fullBody.Substring(idx + separator.Length);
            }
            else
            {
                _body = fullBody;
            }
        }
        else
        {
            if (!string.IsNullOrEmpty(To))
            {
                _toList = To.Split(new[] { ',', ';' }, StringSplitOptions.RemoveEmptyEntries)
                    .Select(e => e.Trim())
                    .ToList();
            }
            if (!string.IsNullOrEmpty(Subject)) _subject = Subject;

            var signatureBlock = BuildSignatureBlock(_selectedIdentityId);

            if (IsTemplate && !string.IsNullOrEmpty(Body))
            {
                _body = Body;
                if (!string.IsNullOrEmpty(signatureBlock))
                {
                    _body += $"<br/>{signatureBlock}";
                }
                Body = null;
            }
            else
            {
                _body = "<p><br></p>";
                if (!string.IsNullOrEmpty(signatureBlock))
                {
                    _body += signatureBlock;
                }
            }
        }

        if (PreloadedDocumentAttachments != null)
        {
            _documentAttachments.AddRange(PreloadedDocumentAttachments);
        }

        if (PreloadedForwardedAttachments != null)
        {
            _forwardedAttachments.AddRange(PreloadedForwardedAttachments);
        }

        bool isMobile = false;
        try
        {
            var bp = await ViewportService.GetCurrentBreakpointAsync();
            isMobile = bp <= Breakpoint.Xs;
        }
        catch
        {
            // Fallback to desktop defaults if viewport JS query is unavailable
        }

        _showFormattingToolbar = !isMobile;
        _showQuotedMessage = false;
        _headerCollapsed = isMobile && !string.IsNullOrEmpty(Body) && CanCollapseHeader;

        _isLoading = false;
    }

    protected override void OnAfterRender(bool firstRender)
    {
        if (firstRender)
        {
            _editorReady = true;
        }
    }

    private async Task TriggerFilePickerAsync()
    {
        if (_fileUpload != null)
        {
            await _fileUpload.OpenFilePickerAsync();
        }
    }

    private string BuildSignatureBlock(string? identityId)
    {
        if (string.IsNullOrEmpty(identityId)) return "";
        var identity = _permittedIdentities.FirstOrDefault(i => i.Id == identityId);
        if (identity == null || string.IsNullOrWhiteSpace(identity.SignatureHtml)) return "";
        return $"<!-- spokes-sig-start --><div class=\"spokes-email-signature\">{identity.SignatureHtml}</div><!-- spokes-sig-end -->";
    }

    private static bool IsBillInboxCandidateIdentity(
        EmailSendingIdentity candidate,
        Spokes_Server.Core.Configuration.CompanyBillInboxSettings billInbox)
    {
        return (!string.IsNullOrWhiteSpace(billInbox.AccountId) &&
                string.Equals(candidate.SourceAccountId, billInbox.AccountId, StringComparison.OrdinalIgnoreCase)) ||
               (!string.IsNullOrWhiteSpace(billInbox.InboxId) &&
                string.Equals(candidate.SourceInboxId, billInbox.InboxId, StringComparison.OrdinalIgnoreCase)) ||
               (!string.IsNullOrWhiteSpace(billInbox.EmailAddress) &&
                string.Equals(candidate.EmailAddress, billInbox.EmailAddress, StringComparison.OrdinalIgnoreCase));
    }

    private string ResolveComposerEffectiveAccountId(
        Spokes_Server.Core.Models.HR.Employee? employee,
        EmailSendingIdentity? identity,
        string currentAccountId)
    {
        if (identity == null)
        {
            return currentAccountId;
        }

        bool isPrivateUnsharedPersonalOutgoing =
            identity.SourceType == EmailIdentitySourceType.OutgoingServer &&
            !identity.IsServerManaged &&
            (identity.AllowedUserIds == null || identity.AllowedUserIds.Count == 0) &&
            (identity.AllowedTeamIds == null || identity.AllowedTeamIds.Count == 0);

        if (!isPrivateUnsharedPersonalOutgoing)
        {
            if (!string.IsNullOrWhiteSpace(identity.SourceAccountId))
            {
                return identity.SourceAccountId;
            }

            if (!string.IsNullOrWhiteSpace(identity.SourceInboxId))
            {
                var sourceInbox = Db.EmailInboxes.GetById(identity.SourceInboxId);
                if (!string.IsNullOrWhiteSpace(sourceInbox?.AccountId))
                {
                    return sourceInbox.AccountId;
                }
            }

            var candidateAccountIds = new List<string>();
            foreach (var inbox in Db.EmailInboxes.GetAll())
            {
                bool isLinked = string.Equals(inbox.DefaultIdentityId, identity.Id, StringComparison.OrdinalIgnoreCase) ||
                                (inbox.LinkedIdentityIds != null && inbox.LinkedIdentityIds.Contains(identity.Id, StringComparer.OrdinalIgnoreCase));
                if (!isLinked || string.IsNullOrWhiteSpace(inbox.AccountId))
                    continue;

                var backingAccount = Db.EmailAccounts.GetById(inbox.AccountId);
                if (backingAccount is { IsArchived: true })
                    continue;

                bool mailboxIsServerManaged = inbox.IsServerManaged || (backingAccount?.IsServerManaged ?? false);
                var mailboxOwnerId = backingAccount != null ? backingAccount.OwnerEmployeeId : inbox.OwnerEmployeeId;
                if (!EmailInboxService.CanMailboxLinkIdentity(identity, mailboxIsServerManaged, mailboxOwnerId))
                    continue;

                if (!candidateAccountIds.Contains(inbox.AccountId, StringComparer.OrdinalIgnoreCase))
                {
                    candidateAccountIds.Add(inbox.AccountId);
                }
            }

            foreach (var acc in Db.EmailAccounts.GetAll())
            {
                if (acc.IsArchived)
                    continue;

                bool isLinked = string.Equals(acc.AutoCreatedIdentityId, identity.Id, StringComparison.OrdinalIgnoreCase) ||
                                string.Equals(acc.DefaultIdentityId, identity.Id, StringComparison.OrdinalIgnoreCase) ||
                                (acc.LinkedIdentityIds != null && acc.LinkedIdentityIds.Contains(identity.Id, StringComparer.OrdinalIgnoreCase));
                if (!isLinked)
                    continue;

                if (!EmailInboxService.CanMailboxLinkIdentity(identity, acc.IsServerManaged, acc.OwnerEmployeeId))
                    continue;

                if (!candidateAccountIds.Contains(acc.Id, StringComparer.OrdinalIgnoreCase))
                {
                    candidateAccountIds.Add(acc.Id);
                }
            }

            if (candidateAccountIds.Count > 0)
            {
                var activeContextAccountId = !string.IsNullOrWhiteSpace(AccountId)
                    ? AccountId
                    : (!string.IsNullOrWhiteSpace(InboxId) ? Db.EmailInboxes.GetById(InboxId)?.AccountId : currentAccountId);

                if (!string.IsNullOrWhiteSpace(activeContextAccountId) &&
                    candidateAccountIds.Contains(activeContextAccountId, StringComparer.OrdinalIgnoreCase))
                {
                    if (employee == null ||
                        InboxService.GetAccessibleAccounts(employee.Id).Any(a => string.Equals(a.Id, activeContextAccountId, StringComparison.OrdinalIgnoreCase)))
                    {
                        return activeContextAccountId;
                    }
                }

                return candidateAccountIds[0];
            }
        }

        if (employee != null)
        {
            var expectedOwnerId = isPrivateUnsharedPersonalOutgoing ? identity.OwnerEmployeeId : employee.Id;
            if (!identity.IsServerManaged && !string.IsNullOrWhiteSpace(currentAccountId))
            {
                var currentAccount = Db.EmailAccounts.GetById(currentAccountId);
                if (currentAccount is { IsServerManaged: false, IsArchived: false } &&
                    IsUnsharedPersonalMailbox(currentAccount) &&
                    !string.IsNullOrWhiteSpace(expectedOwnerId) &&
                    string.Equals(currentAccount.OwnerEmployeeId, expectedOwnerId, StringComparison.OrdinalIgnoreCase))
                {
                    return currentAccount.Id;
                }
            }

            if (!identity.IsServerManaged && !string.IsNullOrWhiteSpace(expectedOwnerId))
            {
                var personalAccount = Db.EmailAccounts.GetByOwner(expectedOwnerId)
                    .FirstOrDefault(a => !a.IsArchived && !a.IsServerManaged && IsUnsharedPersonalMailbox(a));
                if (personalAccount != null)
                {
                    return personalAccount.Id;
                }
            }

            return isPrivateUnsharedPersonalOutgoing ? "" : employee.Id;
        }

        return isPrivateUnsharedPersonalOutgoing ? "" : currentAccountId;
    }

    private static bool IsUnsharedPersonalMailbox(EmailAccount account) =>
        (account.AllowedUserIds == null || account.AllowedUserIds.Count == 0) &&
        (account.AllowedTeamIds == null || account.AllowedTeamIds.Count == 0);

    private void OnSelectedIdentityChanged(string newIdentityId)
    {
        _selectedIdentityId = newIdentityId;
        var identity = _permittedIdentities.FirstOrDefault(i => i.Id == newIdentityId);
        if (identity != null)
        {
            _from = identity.FormattedFrom;
            _effectiveAccountId = ResolveComposerEffectiveAccountId(_currentEmployee, identity, _effectiveAccountId);
        }

        var newSigBlock = BuildSignatureBlock(newIdentityId);
        if (SignatureBlockRegex.IsMatch(_body))
        {
            _body = SignatureBlockRegex.Replace(_body, newSigBlock);
        }
        else if (!string.IsNullOrEmpty(newSigBlock))
        {
            _body += $"<br/>{newSigBlock}";
        }

        OnFieldChanged();
    }

    // ──────────────────── Change detection ────────────────────

    private void OnFieldChanged()
    {
        ScheduleAutoSave();
    }

    private void OnBodyChanged(string newValue)
    {
        if (_isLoading || !_editorReady) return;

        if (!string.IsNullOrEmpty(_body) && string.IsNullOrEmpty(newValue))
        {
            return;
        }

        _body = newValue;
        ScheduleAutoSave();
    }

    private void ScheduleAutoSave()
    {
        if (_isSending) return;

        _dirty = true;

        if (_autoSaveState != AutoSaveStatus.Typing)
        {
            _autoSaveState = AutoSaveStatus.Typing;
            StateHasChanged();
        }

        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
        _debounceCts = new CancellationTokenSource();
        var token = _debounceCts.Token;

        _ = RunDebouncedSaveAsync(token);
    }

    private async Task RunDebouncedSaveAsync(CancellationToken token)
    {
        try
        {
            await Task.Delay(1500, token);
        }
        catch (TaskCanceledException)
        {
            return;
        }

        await InvokeAsync(ExecuteSaveAsync);
    }

    private async Task ExecuteSaveAsync()
    {
        if (_isSending || _savingInProgress || !_dirty) return;

        _savingInProgress = true;
        _dirty = false;
        _autoSaveState = AutoSaveStatus.Saving;
        StateHasChanged();

        try
        {
            if (string.IsNullOrEmpty(_effectiveAccountId))
            {
                if (string.IsNullOrEmpty(_selectedIdentityId))
                {
                    _autoSaveState = AutoSaveStatus.Error;
                }
                return;
            }

            string toStr = string.Join(", ", _toList);
            string ccStr = string.Join(", ", _ccList);
            string bccStr = string.Join(", ", _bccList);

            string finalBody = string.IsNullOrEmpty(Body) ? _body : $"{_body}\n<!-- spokes-reply-separator -->\n{Body}";

            var attachmentInputs = await _attachments.ToEmailAttachmentsAsync();

            var id = await EmailDraftService.SaveDraftAsync(new SaveDraftRequest
            {
                AccountId = _effectiveAccountId,
                EmployeeId = _currentEmployeeId,
                SendingIdentityId = _selectedIdentityId,
                To = toStr,
                Subject = _subject,
                Body = finalBody,
                Attachments = attachmentInputs,
                Cc = ccStr,
                Bcc = bccStr,
                InReplyTo = InReplyTo,
                References = References,
                ExistingDraftId = _currentDraftId
            });

            if (!string.IsNullOrEmpty(id))
            {
                _currentDraftId = id;
                _autoSaveState = AutoSaveStatus.Saved;
                _lastSavedTime = DateTime.Now;

                if (_attachments.Any())
                {
                    _attachments.Clear();
                    var updatedDraft = await MessageLifecycleService.GetMessageAsync(_effectiveAccountId, id);
                    if (updatedDraft != null)
                        _existingAttachments = updatedDraft.Attachments;
                }
            }
            else
            {
                _autoSaveState = AutoSaveStatus.Error;
            }
        }
        catch (Exception ex)
        {
            _autoSaveState = AutoSaveStatus.Error;
            Logger.LogError(ex, "Failed to auto-save email draft.");
        }
        finally
        {
            _savingInProgress = false;
            StateHasChanged();

            if (_dirty)
            {
                ScheduleAutoSave();
            }
        }
    }

    private void UploadFiles(IReadOnlyList<IBrowserFile>? files)
    {
        if (files == null || !files.Any()) return;

        foreach (var file in files)
        {
            if (file.Size > 10 * 1024 * 1024)
            {
                Snackbar.Add(string.Format(BizLoc["File {0} is too large (Max 10MB)"].Value, file.Name), Severity.Warning);
                continue;
            }
            _attachments.Add(file);
        }
        OnFieldChanged();
    }

    private async Task RemoveExistingAttachment(EmailAttachmentMeta attachment)
    {
        _existingAttachments.Remove(attachment);

        if (!string.IsNullOrEmpty(_effectiveAccountId) && !string.IsNullOrEmpty(_currentDraftId))
        {
            await EmailDraftService.RemoveDraftAttachmentAsync(_effectiveAccountId, _currentDraftId, attachment.Id, _currentEmployeeId);
        }

        OnFieldChanged();
    }

    // ──────────────────── Send ────────────────────
    private void Cancel() => MudDialog.Cancel();

    private async Task SendAsync()
    {
        if (!_toList.Any())
        {
            Snackbar.Add(BizLoc["Recipient (To) is required"], Severity.Error);
            return;
        }

        _isSending = true;
        _debounceCts?.Cancel();

        try
        {
            if (string.IsNullOrEmpty(_effectiveAccountId) && string.IsNullOrEmpty(_selectedIdentityId))
            {
                Snackbar.Add(BizLoc["No email account or identity configured"], Severity.Error);
                _isSending = false;
                return;
            }

            string toStr = string.Join(", ", _toList);
            string ccStr = string.Join(", ", _ccList);
            string bccStr = string.Join(", ", _bccList);

            string finalBody = string.IsNullOrEmpty(Body) ? _body : $"{_body}\n<br/><br/>\n<!-- spokes-reply-separator -->\n{Body}";

            var attachmentInputs = await _attachments.ToEmailAttachmentsAsync();

            await EmailDeliveryService.SendEmailAsync(new SendEmailRequest
            {
                AccountId = _effectiveAccountId,
                EmployeeId = _currentEmployeeId,
                SendingIdentityId = _selectedIdentityId,
                To = toStr,
                Subject = _subject,
                Body = finalBody,
                Attachments = attachmentInputs,
                Cc = ccStr,
                Bcc = bccStr,
                InReplyTo = InReplyTo,
                References = References,
                ExistingAttachments = _existingAttachments,
                DraftId = _currentDraftId,
                DocumentAttachments = _documentAttachments.Any() ? _documentAttachments : null,
                ForwardedEmailAttachments = _forwardedAttachments.Any() ? _forwardedAttachments : null
            });

            if (_currentDraftId != null)
            {
                var draftIdToDelete = _currentDraftId;
                var accountIdForDraft = _effectiveAccountId;
                var employeeIdForDraft = _currentEmployeeId;
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await EmailDraftService.DeleteDraftAsync(accountIdForDraft, draftIdToDelete, employeeIdForDraft);
                    }
                    catch
                    {
                        // Ignore background draft cleanup error
                    }
                });
            }

            Snackbar.Add(BizLoc["Email sent successfully"], Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{BizLoc["Failed to send"]}: {ex.Message}", Severity.Error);
            _isSending = false;
        }
    }

    // ──────────────────── Address Book ────────────────────
    private async Task OpenAddressBook(string target)
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<AddressBookPickerDialog>(BizLoc["Select Contacts"], options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: List<string> selectedEmails })
        {
            var targetList = target switch
            {
                "Cc" => _ccList,
                "Bcc" => _bccList,
                _ => _toList
            };

            foreach (var email in selectedEmails)
            {
                if (!targetList.Contains(email))
                    targetList.Add(email);
            }

            OnFieldChanged();
        }
    }

    private async Task OpenDocumentPicker()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<DocumentPickerDialog>(BizLoc["Attach Documents"], options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: List<OutboundDocumentAttachmentRef> selectedDocs })
        {
            foreach (var doc in selectedDocs)
            {
                if (!_documentAttachments.Any(d => d.Kind == doc.Kind &&
                                                   string.Equals(d.DocumentId, doc.DocumentId, StringComparison.OrdinalIgnoreCase)))
                {
                    _documentAttachments.Add(doc);
                }
            }
            OnFieldChanged();
        }
    }

    // ──────────────────── Cleanup ────────────────────
    public void Dispose()
    {
        _debounceCts?.Cancel();
        _debounceCts?.Dispose();
    }
}
