@using Spokes_Server.Components.Shared
@using Spokes_Server.Core.Configuration
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Services.Communication.Email
@implements IDisposable
@inject Database Db
@inject EmailSyncStateService SyncStateService
@inject IEmailSyncService EmailSyncService
@inject IEmailInboxService InboxService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS

<MudDialog>
    <DialogContent>
        <MudTabs Elevation="0" Outlined="true" Rounded="true" TabPanelsClass="pa-2" KeepPanelsAlive="true" @bind-ActivePanelIndex="_activeTab">
            <!-- Tab 1: Real Inboxes & Virtual Inboxes -->
            <MudTabPanel Text="@Loc["Inboxes & Mailboxes"]" Icon="@Icons.Material.Filled.Inbox">
                <MudStack Spacing="4">
                    <!-- Card 1: Real Inboxes (IMAP Mailboxes) -->
                    <SettingsCard Title="@Loc["Real Inboxes (IMAP Mailboxes)"]"
                                  Icon="@Icons.Material.Filled.Mail"
                                  Description="@Loc["Connect an existing IMAP mailbox to sync and read messages. Connecting a Real Inbox automatically creates its matching Sending Identity."]">
                        @if (CanConnectRealInboxes)
                        {
                            <div class="d-flex justify-end mb-3">
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.AddLink"
                                           OnClick="CreateAccountAsync">
                                    @Loc["Connect Real Inbox"]
                                </MudButton>
                            </div>
                        }

                        @if (_accounts.Count == 0)
                        {
                            <MudAlert Severity="Severity.Normal" Variant="Variant.Outlined" Dense="true">
                                @(CanConnectRealInboxes
                                    ? Loc["No Real Inboxes connected yet. Click 'Connect Real Inbox' to add an IMAP mailbox."]
                                    : Loc["No Real Inboxes have been shared with your account yet."])
                            </MudAlert>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var account in _accounts)
                                {
                                    var status = SyncStateService.GetState(account.Id);
                                    var (localCount, serverCount) = GetAccountCounts(account.Id);
                                    var canEditAccount = IsEmployeeEligible && !account.IsServerManaged && account.OwnerEmployeeId == Employee.Id;
                                    <MudPaper Outlined="true" Class="pa-3 rounded-lg">
                                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                            <div class="d-flex flex-column gap-1">
                                                <div class="d-flex align-center gap-2 flex-wrap">
                                                    <MudIcon Icon="@Icons.Material.Filled.Mail" Size="Size.Small" Color="Color.Primary" />
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@account.Name</MudText>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                        @account.EmailAddress
                                                    </MudChip>
                                                    @if (account.IsServerManaged)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                                            @Loc["Server Shared"]
                                                        </MudChip>
                                                    }
                                                    <MudChip T="string" Size="Size.Small"
                                                             Color="@(status.Contains("Error") ? Color.Error : (status == "Synced" ? Color.Success : Color.Info))"
                                                             Variant="Variant.Text">
                                                        @status
                                                    </MudChip>
                                                    @if (!string.IsNullOrWhiteSpace(account.AutoCreatedIdentityId))
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text" Icon="@Icons.Material.Filled.Send">
                                                            @Loc["Sending Identity Linked"]
                                                        </MudChip>
                                                    }
                                                </div>
                                                <div class="d-flex align-center gap-3 flex-wrap">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @Loc["Downloaded:"] @localCount / @Loc["Server:"] @serverCount
                                                        @if (account.LastSyncedAt.HasValue)
                                                        {
                                                            <span> • @Loc["Last synced:"] @account.LastSyncedAt.Value.ToLocalTime().ToString("g")</span>
                                                        }
                                                    </MudText>
                                                    @if (account.AllowedUserIds.Count > 0 || account.AllowedTeamIds.Count > 0)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Info">
                                                            • @string.Format(Loc["Shared ({0} users, {1} groups)"].Value, account.AllowedUserIds.Count, account.AllowedTeamIds.Count)
                                                        </MudText>
                                                    }
                                                    else if (!account.IsServerManaged)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            • @Loc["Private (Only You)"]
                                                        </MudText>
                                                    }
                                                </div>
                                            </div>
                                            <div class="d-flex align-center gap-1">
                                                @if (IsEmailFeatureAllowed)
                                                {
                                                    <MudTooltip Text="@Loc["Sync Mailbox Now"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Sync"
                                                                       Size="Size.Small"
                                                                       Color="Color.Primary"
                                                                       Disabled="@(_syncingAccountId == account.Id)"
                                                                       OnClick="@(() => SyncAccountNowAsync(account))" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="@Loc["Repair Cached Emails"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Build"
                                                                       Size="Size.Small"
                                                                       Color="Color.Secondary"
                                                                       Disabled="IsRepairing"
                                                                       OnClick="@(() => RepairAttachments(account.Id))" />
                                                    </MudTooltip>
                                                }
                                                @if (canEditAccount)
                                                {
                                                    <MudTooltip Text="@Loc["Edit Real Inbox"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                                       OnClick="@(() => EditAccountAsync(account))" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="@Loc["Archive Real Inbox"]">
                                                        <MudIconButton Icon="@Icons.Material.Outlined.Archive" Size="Size.Small" Color="Color.Warning"
                                                                       OnClick="@(() => ArchiveAccount(account))" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="@Loc["Delete Real Inbox"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                                       OnClick="@(() => DeleteAccountAsync(account))" />
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </div>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </SettingsCard>

                    @if (_archivedAccounts.Count > 0)
                    {
                        <!-- Card 1b: Archived Real Inboxes -->
                        <SettingsCard Title="@Loc["Archived Real Inboxes"]"
                                      Icon="@Icons.Material.Filled.Archive"
                                      Description="@Loc["Archived mailboxes remain stored on disk and never sync automatically. You can browse their emails, trigger a manual sync, restore them, or delete them permanently."]">
                            <MudStack Spacing="2">
                                @foreach (var account in _archivedAccounts)
                                {
                                    var status = SyncStateService.GetState(account.Id);
                                    var (localCount, serverCount) = GetAccountCounts(account.Id);
                                    var canEditAccount = IsEmployeeEligible && !account.IsServerManaged && account.OwnerEmployeeId == Employee.Id;
                                    <MudPaper Outlined="true" Class="pa-3 rounded-lg">
                                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                            <div class="d-flex flex-column gap-1">
                                                <div class="d-flex align-center gap-2 flex-wrap">
                                                    <MudIcon Icon="@Icons.Material.Filled.Archive" Size="Size.Small" Color="Color.Warning" />
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@account.Name</MudText>
                                                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default">
                                                        @account.EmailAddress
                                                    </MudChip>
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Text">
                                                        @Loc["Archived"]
                                                    </MudChip>
                                                    @if (status != "Idle")
                                                    {
                                                        <MudChip T="string" Size="Size.Small"
                                                                 Color="@(status.Contains("Error") ? Color.Error : Color.Info)"
                                                                 Variant="Variant.Text">
                                                            @status
                                                        </MudChip>
                                                    }
                                                </div>
                                                <div class="d-flex align-center gap-3 flex-wrap">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @Loc["Downloaded:"] @localCount / @Loc["Server:"] @serverCount
                                                        @if (account.LastSyncedAt.HasValue)
                                                        {
                                                            <span> • @Loc["Last synced:"] @account.LastSyncedAt.Value.ToLocalTime().ToString("g")</span>
                                                        }
                                                        @if (account.ArchivedAt.HasValue)
                                                        {
                                                            <span> • @Loc["Archived:"] @account.ArchivedAt.Value.ToLocalTime().ToString("d")</span>
                                                        }
                                                    </MudText>
                                                </div>
                                            </div>
                                            <div class="d-flex align-center gap-1">
                                                <MudButton Variant="Variant.Outlined"
                                                           Size="Size.Small"
                                                           Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.FolderOpen"
                                                           OnClick="@(() => BrowseArchivedAccount(account))">
                                                    @Loc["Browse Inbox"]
                                                </MudButton>
                                                @if (IsEmployeeEligible)
                                                {
                                                    <MudTooltip Text="@Loc["Sync Mailbox Now"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Sync"
                                                                       Size="Size.Small"
                                                                       Color="Color.Primary"
                                                                       Disabled="@(_syncingAccountId == account.Id)"
                                                                       OnClick="@(() => SyncAccountNowAsync(account))" />
                                                    </MudTooltip>
                                                }
                                                @if (canEditAccount)
                                                {
                                                    <MudTooltip Text="@Loc["Restore to Active Inboxes"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.Unarchive" Size="Size.Small" Color="Color.Success"
                                                                       OnClick="@(() => UnarchiveAccount(account))" />
                                                    </MudTooltip>
                                                    <MudTooltip Text="@Loc["Delete Real Inbox"]">
                                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                                       OnClick="@(() => DeleteAccountAsync(account))" />
                                                    </MudTooltip>
                                                }
                                            </div>
                                        </div>
                                    </MudPaper>
                                }
                            </MudStack>
                        </SettingsCard>
                    }

                    <!-- Card 2: Virtual Inboxes (Filtered Views) -->
                    <SettingsCard Title="@Loc["Virtual Inboxes (Filtered Views)"]"
                                  Icon="@Icons.Material.Filled.AlternateEmail"
                                  Description="@Loc["Create filtered inboxes from any Real Inbox by recipient address (e.g. support@, billing@) or @domain, link a Sending Identity, and share them with teammates."]">
                        @if (CanCreateVirtualInboxes)
                        {
                            <div class="d-flex justify-end mb-3">
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Add"
                                           Disabled="@(_accounts.Count == 0)"
                                           OnClick="CreateInboxAsync">
                                    @Loc["New Virtual Inbox"]
                                </MudButton>
                            </div>
                        }

                        @if (_inboxes.Count == 0)
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                                @(_accounts.Count == 0
                                    ? Loc["Connect a Real Inbox above first, then you can create optional Virtual Inboxes to filter specific addresses or domains."]
                                    : Loc["No Virtual Inboxes created yet. Real Inboxes already appear directly in your sidebar; create a Virtual Inbox when you want to filter specific addresses (like support@ or @domain)."])
                            </MudAlert>
                        }
                        else
                        {
                            <MudStack Spacing="2">
                                @foreach (var inbox in _inboxes)
                                {
                                    var account = _accounts.FirstOrDefault(a => a.Id == inbox.AccountId) ?? Db.EmailAccounts.GetById(inbox.AccountId);
                                    var canEditInbox = IsEmployeeEligible && !inbox.IsServerManaged && inbox.OwnerEmployeeId == Employee.Id;
                                    <MudPaper Outlined="true" Class="pa-3 rounded-lg">
                                        <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                            <div class="d-flex flex-column gap-1">
                                                <div class="d-flex align-center gap-2 flex-wrap">
                                                    <MudIcon Icon="@Icons.Material.Filled.AlternateEmail" Size="Size.Small" Color="Color.Primary" />
                                                    <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@inbox.Name</MudText>
                                                    @if (inbox.IsServerManaged)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                                            @Loc["Server Shared"]
                                                        </MudChip>
                                                    }
                                                    @if (account != null)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Default">
                                                            @account.EmailAddress
                                                        </MudChip>
                                                    }
                                                    @if (inbox.TargetAddresses.Count == 0)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                                                            @Loc["All Mailbox Messages"]
                                                        </MudChip>
                                                    }
                                                    else
                                                    {
                                                        @foreach (var addr in inbox.TargetAddresses)
                                                        {
                                                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                                @addr
                                                            </MudChip>
                                                        }
                                                    }
                                                </div>
                                                <div class="d-flex align-center gap-3 flex-wrap">
                                                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                        @string.Format(Loc["{0} linked identity(ies)"].Value, inbox.LinkedIdentityIds.Count)
                                                    </MudText>
                                                    @if (inbox.AllowedUserIds.Count > 0 || inbox.AllowedTeamIds.Count > 0)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Info">
                                                            • @string.Format(Loc["Shared ({0} users, {1} groups)"].Value, inbox.AllowedUserIds.Count, inbox.AllowedTeamIds.Count)
                                                        </MudText>
                                                    }
                                                    else if (!inbox.IsServerManaged)
                                                    {
                                                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                            • @Loc["Private (Only You)"]
                                                        </MudText>
                                                    }
                                                </div>
                                            </div>
                                            @if (canEditInbox)
                                            {
                                                <div class="d-flex align-center gap-1">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                                   OnClick="@(() => EditInboxAsync(inbox))" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                                   OnClick="@(() => DeleteInboxAsync(inbox))" />
                                                </div>
                                            }
                                        </div>
                                    </MudPaper>
                                }
                            </MudStack>
                        }
                    </SettingsCard>
                </MudStack>
            </MudTabPanel>

            <!-- Tab 2: Sending Identities -->
            <MudTabPanel Text="@Loc["Sending Identities"]" Icon="@Icons.Material.Filled.Badge">
                <SettingsCard Title="@Loc["Sending Identities"]"
                              Icon="@Icons.Material.Filled.Badge"
                              Description="@Loc["Manage outbound sender addresses, display names, and signatures. Sending Identities are created automatically from Real Inboxes, or from Virtual Inboxes and Outgoing Servers."]">
                    @if (CanCreateSendingIdentities)
                    {
                        <div class="d-flex justify-end mb-3">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="CreateIdentityAsync">
                                @Loc["New Sending Identity"]
                            </MudButton>
                        </div>
                    }

                    @if (_identities.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            @Loc["No Sending Identities available yet. Connect a Real Inbox or create a Sending Identity to send and reply to emails."]
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var identity in _identities)
                            {
                                var canEditIdentity = IsEmployeeEligible && !identity.IsServerManaged && identity.OwnerEmployeeId == Employee.Id;
                                <MudPaper Outlined="true" Class="pa-3 rounded-lg">
                                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                        <div class="d-flex flex-column gap-1">
                                            <div class="d-flex align-center gap-2 flex-wrap">
                                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@identity.DisplayName</MudText>
                                                <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                                    @identity.EmailAddress
                                                </MudChip>
                                                @if (identity.IsServerManaged)
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                                        @Loc["Server Shared"]
                                                    </MudChip>
                                                }
                                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary" Variant="Variant.Text">
                                                    @GetIdentitySourceLabel(identity.SourceType)
                                                </MudChip>
                                                @if (!string.IsNullOrWhiteSpace(identity.SignatureHtml))
                                                {
                                                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Text" Icon="@Icons.Material.Filled.Draw">
                                                        @Loc["Signature"]
                                                    </MudChip>
                                                }
                                            </div>
                                            @if (identity.AllowedUserIds.Count > 0 || identity.AllowedTeamIds.Count > 0)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Info">
                                                    @string.Format(Loc["Shared ({0} users, {1} groups)"].Value, identity.AllowedUserIds.Count, identity.AllowedTeamIds.Count)
                                                </MudText>
                                            }
                                            else if (!identity.IsServerManaged)
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                                    @Loc["Private (Only You)"]
                                                </MudText>
                                            }
                                        </div>
                                        @if (canEditIdentity)
                                        {
                                            <div class="d-flex align-center gap-1">
                                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary"
                                                               OnClick="@(() => EditIdentityAsync(identity))" />
                                                <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline" Size="Size.Small" Color="Color.Error"
                                                               OnClick="@(() => DeleteIdentityAsync(identity))" />
                                            </div>
                                        }
                                    </div>
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </SettingsCard>
            </MudTabPanel>

            <!-- Tab 3: Private Contacts -->
            <MudTabPanel Text="@Loc["Private Contacts"]" Icon="@Icons.Material.Filled.Contacts">
                <SettingsCard Title="@Loc["Private Contacts"]"
                              Icon="@Icons.Material.Filled.Contacts"
                              Description="@Loc["Manage your personal address book and import or export vCard (.vcf) files."]">
                    <div class="d-flex justify-end gap-2 mb-3">
                        @if (IsEmployeeEligible)
                        {
                            <MudFileUpload T="IBrowserFile" Accept=".vcf" FilesChanged="ImportContacts" Class="mt-0">
                                <CustomContent>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Upload" OnClick="@context.OpenFilePickerAsync">
                                        @Loc["Import"]
                                    </MudButton>
                                </CustomContent>
                                <SelectedTemplate></SelectedTemplate>
                            </MudFileUpload>
                        }
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Download" OnClick="ExportContacts">
                            @Loc["Export"]
                        </MudButton>
                        @if (IsEmployeeEligible)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="AddPrivateContact">@Loc["New Private Contact"]</MudButton>
                        }
                    </div>
                    <MudTable Items="@PrivateContacts" Dense="true" Hover="true" Striped="true" Outlined="true" Elevation="0" Filter="new Func<ContactPerson, bool>(FilterPrivateContacts)">
                        <ToolBarContent>
                            <MudTextField @bind-Value="searchStringPrivate" Placeholder="@Loc["Search..."]" Adornment="Adornment.Start"
                                          AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
                        </ToolBarContent>
                        <HeaderContent>
                            <MudTh>@Loc["Name"]</MudTh>
                            <MudTh>@Loc["Title"]</MudTh>
                            <MudTh>@Loc["Email"]</MudTh>
                            <MudTh>@Loc["Phone"]</MudTh>
                            <MudTh>@Loc["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@($"{context.Prefix} {context.Name}".Trim())</MudTd>
                            <MudTd DataLabel="Title">@context.Title</MudTd>
                            <MudTd DataLabel="Email">@context.Email</MudTd>
                            <MudTd DataLabel="Phone">@context.Phone</MudTd>
                            <MudTd DataLabel="Actions">
                                @if (IsEmployeeEligible)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                                                   OnClick="@(() => EditPrivateContact(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                   OnClick="@(() => DeletePrivateContact(context))" />
                                }
                            </MudTd>
                        </RowTemplate>
                        <PagerContent>
                            <MudTablePager />
                        </PagerContent>
                    </MudTable>
                </SettingsCard>
            </MudTabPanel>
        </MudTabs>
    </DialogContent>
    <DialogActions>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">@Loc["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Employee Employee { get; set; } = default!;
    [Parameter] public EventCallback<string> OnRepairAttachments { get; set; }
    [Parameter] public bool IsRepairing { get; set; }
    [Parameter] public int InitialTab { get; set; }

    private int _activeTab;
    private EmailServerSettings _emailSettings = new();
    private List<EmailAccount> _accounts = [];
    private List<EmailAccount> _archivedAccounts = [];
    private List<EmailInbox> _inboxes = [];
    private List<EmailSendingIdentity> _identities = [];
    private string? _syncingAccountId;

    private List<ContactPerson> PrivateContacts = [];
    private string searchStringPrivate = "";

    private Employee? LiveEmployee => !string.IsNullOrWhiteSpace(Employee?.Id) ? (Db.Employees.GetById(Employee.Id) ?? Employee) : Employee;
    private bool IsEmployeeEligible => LiveEmployee is { IsActive: true, IsBanned: false, IsSuspended: false };
    private bool IsAdminUser => LiveEmployee != null && (LiveEmployee.IsAdmin || LiveEmployee.HasPermission(AppPermissions.Admin.ManageSettings));
    private bool IsEmailFeatureAllowed => IsEmployeeEligible &&
                                          !string.Equals(Db.CompanyProfile.Get()?.Edition, "Family", StringComparison.OrdinalIgnoreCase) &&
                                          (LiveEmployee?.HasPermission(AppPermissions.Email.Use) ?? false);
    private bool CanConnectRealInboxes => IsEmployeeEligible && (IsAdminUser || _emailSettings.AllowUsersToConnectRealInboxes);
    private bool CanCreateVirtualInboxes => IsEmailFeatureAllowed && (IsAdminUser || _emailSettings.AllowUsersToCreateVirtualInboxes);
    private bool CanCreateSendingIdentities => IsEmployeeEligible && (IsAdminUser || _emailSettings.AllowUsersToCreateSendingIdentities);
    private bool CanShareEntities => IsEmployeeEligible && (IsAdminUser || _emailSettings.AllowUsersToShareEmailEntities);
    private bool CanManageServers => IsEmployeeEligible && (IsAdminUser || _emailSettings.AllowUsersToManageServers);

    protected override void OnInitialized()
    {
        _activeTab = InitialTab;
        RefreshData();
        RefreshPrivateContacts();
        SyncStateService.OnStateChanged += HandleStateChanged;
        SyncStateService.OnUnreadCountChanged += HandleCountChanged;
    }

    private void RefreshData()
    {
        if (Employee == null) return;
        _emailSettings = Db.CompanyProfile.Get()?.EmailSettings ?? new();
        _accounts = InboxService.GetAccessibleRealInboxes(Employee.Id);
        _archivedAccounts = InboxService.GetAccessibleArchivedRealInboxes(Employee.Id);
        _inboxes = InboxService.GetManageableInboxesForSettings(Employee.Id)
            .Concat(InboxService.GetAccessibleInboxes(Employee.Id))
            .DistinctBy(i => i.Id)
            .ToList();
        _identities = InboxService.GetPermittedIdentities(Employee.Id);
    }

    private string GetIdentitySourceLabel(EmailIdentitySourceType sourceType) => sourceType switch
    {
        EmailIdentitySourceType.RealInbox => Loc["Real Inbox"].Value,
        EmailIdentitySourceType.VirtualInbox => Loc["Virtual Inbox"].Value,
        _ => Loc["Outgoing Server"].Value
    };

    private (int LocalCount, int ServerCount) GetAccountCounts(string accountId)
    {
        var folders = Db.EmailFolders.GetByAccount(accountId);
        var local = folders.Sum(f => Db.EmailMessages.GetLocalMessageCount(accountId, f.Path));
        var server = folders.Sum(f => f.TotalCount);
        return (local, server);
    }

