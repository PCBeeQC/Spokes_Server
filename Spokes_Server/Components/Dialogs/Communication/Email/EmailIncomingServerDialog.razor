@using Spokes_Server.Core.Configuration
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Security
@inject Database Db
@inject EncryptionService EncryptionService
@inject UserService UserService
@inject AppLabelService AppLabels
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            @* 1. Provider Preset Selector *@
            <MudSelect T="string"
                       Value="@_selectedIncomingPresetId"
                       ValueChanged="OnIncomingPresetSelected"
                       Label="@Loc["Provider Preset"]"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense">
                <MudSelectItem Value="@EmailProviderPresets.CustomPresetId">
                    @Loc["Custom IMAP Server"]
                </MudSelectItem>
                @foreach (var preset in EmailProviderPresets.MailboxProviders)
                {
                    <MudSelectItem Value="@preset.Id">@preset.Name (@preset.ImapHost)</MudSelectItem>
                }
            </MudSelect>

            <EmailProviderInstructionsAlert Preset="@SelectedIncomingPreset" />

            <MudGrid Spacing="2">
                <MudItem xs="12" sm="6">
                    <MudTextField @bind-Value="Server.Name"
                                  Label="@Loc["Incoming Server Label"]"
                                  Placeholder="@string.Format(Loc["e.g. {0} IMAP or Gmail"].Value, AppLabels.Company)"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField Value="@Server.Domain"
                                  ValueChanged="@((string val) => OnServerDomainChanged(val))"
                                  Label="@Loc["Email Domain"]"
                                  Placeholder="@_domainPlaceholder"
                                  Adornment="Adornment.Start"
                                  AdornmentText="@("@")"
                                  Variant="Variant.Outlined"
                                  Margin="Margin.Dense"
                                  HelperText="@Loc["Links this Incoming Server and its paired Outgoing Server to this domain"]" />
                </MudItem>

                @if (_selectedIncomingPresetId == EmailProviderPresets.CustomPresetId)
                {
                    <MudItem xs="12" sm="6">
                        <MudTextField @bind-Value="Server.Host"
                                      Label="@Loc["IMAP Host"]"
                                      Placeholder="imap.example.com"
                                      Variant="Variant.Outlined"
                                      Margin="Margin.Dense"
                                      Required="true" />
                    </MudItem>
                    <MudItem xs="6" sm="3">
                        <MudNumericField @bind-Value="Server.Port"
                                         Label="@Loc["IMAP Port"]"
                                         Variant="Variant.Outlined"
                                         Margin="Margin.Dense" />
                    </MudItem>
                    <MudItem xs="6" sm="3" Class="d-flex align-center">
                        <MudSwitch @bind-Value="Server.UseSsl"
                                   Color="Color.Primary"
                                   Label="@Loc["SSL / TLS"]" />
                    </MudItem>
                }
            </MudGrid>

            <MudDivider />

            @* Paired Outgoing Server Selection or Inline Configuration *@
            <div>
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;" Class="mb-1">
                    @Loc["Paired Outgoing Server (SMTP)"]
                </MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2 d-block">
                    @Loc["Every Incoming Server is paired with an Outgoing Server for its domain so Real Inboxes automatically receive a working Sending Identity."]
                </MudText>

                <MudSelect T="string"
                           Value="@_selectedOutgoingOption"
                           ValueChanged="OnOutgoingOptionChanged"
                           Label="@Loc["Outgoing Server"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Required="true">
                    @foreach (var outServer in CompatibleOutgoingServers)
                    {
                        <MudSelectItem T="string" Value="@outServer.Id">
                            @outServer.Name @(!string.IsNullOrWhiteSpace(outServer.Domain) ? $"(@{outServer.Domain})" : $"({outServer.Host}:{outServer.Port})")
                        </MudSelectItem>
                    }
                    <MudSelectItem T="string" Value="@CreateNewOutgoingOption">
                        + @Loc["Configure New Outgoing Server..."]
                    </MudSelectItem>
                </MudSelect>

                @if (_selectedOutgoingOption == CreateNewOutgoingOption)
                {
                    <MudPaper Elevation="0" Outlined="true" Class="pa-4 mt-3 rounded-lg" Style="background-color: var(--mud-palette-background-grey);">
                        <EmailOutgoingServerFields Server="_inlineOutgoingServer"
                                                   @bind-SelectedPresetId="_selectedInlineOutgoingPresetId"
                                                   @bind-PlainSharedPassword="_inlineSharedPassword"
                                                   DomainPlaceholder="@_domainPlaceholder"
                                                   FallbackDomain="@Server.Domain"
                                                   SuppressInstructionsForPresetId="@SelectedIncomingPreset?.Id"
                                                   IsInline="true" />
                    </MudPaper>
                }
            </div>

            @if (AllowSharing)
            {
                <EmailServerSharingSection Server="Server"
                                           SwitchLabel="@Loc["Available to all users who are permitted to connect Real Inboxes"]"
                                           RestrictionCaption="@Loc["Restrict which users and groups can select this Incoming Server."]" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@Loc["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    private const string CreateNewOutgoingOption = "__create_new__";

    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public IncomingServerConfig Server { get; set; } = new();
    [Parameter] public bool AllowSharing { get; set; } = true;
    [Parameter] public bool IsNew { get; set; }

    private List<SendingServerConfig> _existingOutgoingServers = [];
    private string _selectedIncomingPresetId = EmailProviderPresets.CustomPresetId;
    private string _selectedOutgoingOption = CreateNewOutgoingOption;
    private string _selectedInlineOutgoingPresetId = EmailProviderPresets.CustomPresetId;
    private SendingServerConfig _inlineOutgoingServer = new() { Port = EmailServerConfigValidator.DefaultSmtpPort, UseSsl = true };
    private string _inlineSharedPassword = string.Empty;
    private string _domainPlaceholder = "example.com";

    private EmailProviderPreset? SelectedIncomingPreset =>
        EmailProviderPresets.GetById(_selectedIncomingPresetId);

    private EmailProviderPreset? SelectedInlineOutgoingPreset =>
        EmailProviderPresets.GetById(_selectedInlineOutgoingPresetId);

    private IEnumerable<SendingServerConfig> CompatibleOutgoingServers
    {
        get
        {
            var normalizedDomain = EmailServerConfigValidator.NormalizeDomain(Server.Domain);
            return _existingOutgoingServers.Where(s =>
            {
                if (!IsNew && !string.IsNullOrWhiteSpace(Server.DefaultOutgoingServerId) && s.Id == Server.DefaultOutgoingServerId)
                    return true;

                var sDomain = EmailServerConfigValidator.NormalizeDomain(s.Domain);
                if (!string.IsNullOrWhiteSpace(normalizedDomain))
                {
                    if (!string.IsNullOrWhiteSpace(sDomain))
                        return string.Equals(sDomain, normalizedDomain, StringComparison.OrdinalIgnoreCase);

                    return SelectedIncomingPreset == null ||
                           string.Equals(s.Host, SelectedIncomingPreset.SmtpHost, StringComparison.OrdinalIgnoreCase);
                }

                return string.IsNullOrWhiteSpace(sDomain);
            });
        }
    }

    protected override void OnInitialized()
    {
        var profile = Db.CompanyProfile.Get();
        _domainPlaceholder = profile.GetPrimaryDomainOrDefault("example.com");

        if (Server.Port <= 0)
        {
            Server.Port = EmailServerConfigValidator.DefaultImapPort;
        }

        _existingOutgoingServers = profile.EmailSettings?.SendingServers ?? [];

        var matchedPreset = EmailProviderPresets.DetectByImapHost(Server.Host);
        _selectedIncomingPresetId = matchedPreset?.Id ?? EmailProviderPresets.CustomPresetId;

        if (!string.IsNullOrWhiteSpace(Server.DefaultOutgoingServerId) &&
            _existingOutgoingServers.Any(s => s.Id == Server.DefaultOutgoingServerId))
        {
            _selectedOutgoingOption = Server.DefaultOutgoingServerId;
        }
        else
        {
            ResolveBestOutgoingOption();
        }
    }

    private void ResolveBestOutgoingOption()
    {
        var normalizedDomain = EmailServerConfigValidator.NormalizeDomain(Server.Domain);
        SendingServerConfig? matched = null;

        if (!string.IsNullOrWhiteSpace(normalizedDomain))
        {
            matched = _existingOutgoingServers.FirstOrDefault(s =>
                !string.IsNullOrWhiteSpace(s.Domain) &&
                string.Equals(EmailServerConfigValidator.NormalizeDomain(s.Domain), normalizedDomain, StringComparison.OrdinalIgnoreCase));
        }

        if (matched == null && SelectedIncomingPreset != null)
        {
            matched = _existingOutgoingServers.FirstOrDefault(s =>
                string.IsNullOrWhiteSpace(s.Domain) &&
                string.Equals(s.Host, SelectedIncomingPreset.SmtpHost, StringComparison.OrdinalIgnoreCase));
        }

        if (matched != null)
        {
            _selectedOutgoingOption = matched.Id;
        }
        else
        {
            _selectedOutgoingOption = CreateNewOutgoingOption;
            ApplyInlineOutgoingPreset(SelectedIncomingPreset?.Id ?? EmailProviderPresets.CustomPresetId);
        }
    }

    private void ApplyInlineOutgoingPreset(string presetId)
    {
        _selectedInlineOutgoingPresetId = EmailServerConfigValidator.ApplyOutgoingPreset(
            _inlineOutgoingServer,
            _selectedInlineOutgoingPresetId,
            presetId,
            isInline: true,
            fallbackDomain: Server.Domain);
    }

    private void OnIncomingPresetSelected(string presetId)
    {
        var previousPreset = SelectedIncomingPreset;
        _selectedIncomingPresetId = presetId ?? EmailProviderPresets.CustomPresetId;
        var preset = SelectedIncomingPreset;
        if (preset != null)
        {
            Server.Name = preset.Name;
            Server.Host = preset.ImapHost;
            Server.Port = preset.ImapPort;
            Server.UseSsl = preset.ImapSsl;
            if (string.IsNullOrWhiteSpace(Server.Domain) ||
                (previousPreset != null && string.Equals(Server.Domain, previousPreset.DefaultDomain, StringComparison.OrdinalIgnoreCase)))
            {
                Server.Domain = preset.DefaultDomain;
            }
        }
        else if (previousPreset != null)
        {
            if (string.Equals(Server.Name, previousPreset.Name, StringComparison.OrdinalIgnoreCase))
                Server.Name = string.Empty;
            if (string.Equals(Server.Host, previousPreset.ImapHost, StringComparison.OrdinalIgnoreCase))
                Server.Host = string.Empty;
            if (string.Equals(Server.Domain, previousPreset.DefaultDomain, StringComparison.OrdinalIgnoreCase))
                Server.Domain = string.Empty;
        }

        ResolveBestOutgoingOption();
    }

    private void OnServerDomainChanged(string domain)
    {
        Server.Domain = EmailServerConfigValidator.NormalizeDomain(domain);
        ResolveBestOutgoingOption();
        if (_selectedOutgoingOption == CreateNewOutgoingOption)
        {
            _inlineOutgoingServer.Domain = Server.Domain;
        }
    }

    private void OnOutgoingOptionChanged(string value)
    {
        _selectedOutgoingOption = value;
        if (_selectedOutgoingOption == CreateNewOutgoingOption)
        {
            _inlineOutgoingServer.Domain = Server.Domain;
            if (SelectedIncomingPreset != null && string.IsNullOrWhiteSpace(_inlineOutgoingServer.Host))
            {
                ApplyInlineOutgoingPreset(SelectedIncomingPreset.Id);
            }
        }
    }

    private async Task SaveAsync()
    {
        if (string.IsNullOrWhiteSpace(Server.Host))
        {
            Snackbar.Add(Loc["IMAP host is required."].Value, Severity.Warning);
            return;
        }

        var currentUser = await UserService.GetEmployeeAsync();
        var profile = Db.CompanyProfile.GetOrCreate();
        profile.EmailSettings ??= new EmailServerSettings();

        var (isAllowed, isAdmin) = EmailServerConfigValidator.AuthorizeServerManagement(currentUser, profile.EmailSettings);
        if (!isAllowed)
        {
            Snackbar.Add(Loc["You do not have permission to manage email servers."].Value, Severity.Error);
            return;
        }

        var incomingSecurityError = await EmailServerConfigValidator.ValidateTransportSecurityAsync(Server, isAdmin);
        if (incomingSecurityError != EmailServerValidationError.None)
        {
            Snackbar.Add(EmailServerConfigValidator.FormatValidationError(incomingSecurityError, Loc), Severity.Error);
            return;
        }

        EmailServerConfigValidator.NormalizeAndApplyDefaults(Server);

        if (_selectedOutgoingOption == CreateNewOutgoingOption)
        {
            if (string.IsNullOrWhiteSpace(_inlineOutgoingServer.Host))
            {
                Snackbar.Add(Loc["Outgoing SMTP host is required."].Value, Severity.Warning);
                return;
            }

            var outgoingSecurityError = await EmailServerConfigValidator.ValidateTransportSecurityAsync(_inlineOutgoingServer, isAdmin);
            if (outgoingSecurityError != EmailServerValidationError.None)
            {
                Snackbar.Add(EmailServerConfigValidator.FormatValidationError(outgoingSecurityError, Loc), Severity.Error);
                return;
            }

            EmailServerConfigValidator.NormalizeAndApplyDefaults(_inlineOutgoingServer, fallbackDomain: Server.Domain);

            var credError = EmailServerConfigValidator.ApplySharedCredentials(
                _inlineOutgoingServer,
                _inlineSharedPassword,
                SelectedInlineOutgoingPreset,
                EncryptionService);
            if (credError != EmailServerValidationError.None)
            {
                Snackbar.Add(EmailServerConfigValidator.FormatValidationError(credError, Loc, isInlineOutgoing: true), Severity.Warning);
                return;
            }

            _inlineOutgoingServer.OwnerEmployeeId = Server.OwnerEmployeeId;
            _inlineOutgoingServer.IsSharedWithAllUsers = Server.IsSharedWithAllUsers;
            _inlineOutgoingServer.AllowedUserIds = new List<string>(Server.AllowedUserIds ?? []);
            _inlineOutgoingServer.AllowedTeamIds = new List<string>(Server.AllowedTeamIds ?? []);

            // Persist the new Outgoing Server to CompanyProfile.EmailSettings if not already present
            profile.EmailSettings.SendingServers ??= [];
            var existingIdx = profile.EmailSettings.SendingServers.FindIndex(s => s.Id == _inlineOutgoingServer.Id);
            if (existingIdx >= 0)
            {
                profile.EmailSettings.SendingServers[existingIdx] = _inlineOutgoingServer;
            }
            else
            {
                profile.EmailSettings.SendingServers.Add(_inlineOutgoingServer);
            }
            Db.CompanyProfile.Save(profile);

            Server.DefaultOutgoingServerId = _inlineOutgoingServer.Id;
        }
        else
        {
            Server.DefaultOutgoingServerId = _selectedOutgoingOption;
        }

        if (string.IsNullOrWhiteSpace(Server.DefaultOutgoingServerId))
        {
            Snackbar.Add(Loc["Please select or configure a paired Outgoing Server."].Value, Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(Server));
    }

    private void Cancel() => MudDialog.Cancel();
}
