@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Projects
@inject ProjectNoteService ProjectNoteService
@inject ISnackbar Snackbar
@inject IEmailCacheMaintenanceService CacheMaintenance

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudGrid>
                <!-- Project Picker -->
                <MudItem xs="12">
                    <MudAutocomplete T="Project" Label="Project" @bind-Value="SelectedProject"
                        SearchFunc="SearchProjects" ToStringFunc="@(p => p?.DisplayName ?? "")"
                        Variant="Variant.Outlined" Required="true"
                        Placeholder="Search for a project..." />
                </MudItem>

                <!-- Title -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="NoteTitle" Label="Title" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <!-- Date -->
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="NoteDate" Label="Date" />
                </MudItem>

                <!-- Category (read-only) -->
                <MudItem xs="6" Class="d-flex align-end">
                    <MudChip T="string" Label="true" Color="Color.Info" Size="Size.Medium">EMAIL</MudChip>
                </MudItem>

                <!-- Notes / Context -->
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Notes (optional)</MudText>
                    <Spokes_Server.Components.Shared.MarkdownEditor @bind-Value="NoteContent" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Add to Timeline
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The email message to add to the timeline.</summary>
    [Parameter] public EmailMessage Email { get; set; } = default!;

    /// <summary>The employee ID of the current user (needed to locate the .eml file).</summary>
    [Parameter] public string EmployeeId { get; set; } = string.Empty;

    /// <summary>The display name of the current user (for CreatedBy).</summary>
    [Parameter] public string CurrentUser { get; set; } = string.Empty;

    private Project? SelectedProject;
    private string NoteTitle = string.Empty;
    private DateTime? NoteDate;
    private string NoteContent = string.Empty;
    private bool _isSaving = false;

    protected override void OnInitialized()
    {
        // Pre-fill from email
        NoteTitle = Email?.Subject ?? "Email";
        NoteDate = Email?.Date.DateTime ?? DateTime.Today;
    }

    private Task<IEnumerable<Project>> SearchProjects(string value, CancellationToken token)
    {
        return Task.FromResult<IEnumerable<Project>>(ProjectNoteService.SearchActiveProjects(value));
    }

    private async Task Submit()
    {
        if (SelectedProject == null)
        {
            Snackbar.Add("Please select a project", Severity.Warning);
            return;
        }

        if (Email == null)
        {
            Snackbar.Add("No email selected", Severity.Error);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var mimePath = CacheMaintenance.GetMimeFilePath(EmployeeId, Email.Id);
            if (string.IsNullOrEmpty(mimePath))
            {
                Snackbar.Add("Email file not found on disk", Severity.Error);
                _isSaving = false;
                return;
            }

            var request = AddEmailTimelineEntryRequest.FromEmailMessage(
                SelectedProject.Id,
                mimePath,
                Email,
                NoteTitle,
                NoteDate ?? DateTime.Today,
                NoteContent,
                CurrentUser);

            await ProjectNoteService.AddEmailToTimelineAsync(request);

            Snackbar.Add($"Email added to {SelectedProject.DisplayName} timeline", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void Close() => MudDialog.Cancel();
}
