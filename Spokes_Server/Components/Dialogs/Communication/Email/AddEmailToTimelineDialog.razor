@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Projects
@inject ProjectNoteService ProjectNoteService
@inject UserService UserService
@inject IEmailInboxService InboxService
@inject Database Db
@inject ISnackbar Snackbar
@inject IEmailCacheMaintenanceService CacheMaintenance

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudGrid>
                <!-- Project Picker -->
                <MudItem xs="12">
                    <MudAutocomplete T="Project" Label="Project" @bind-Value="SelectedProject"
                        SearchFunc="SearchProjects" ToStringFunc="@(p => p?.DisplayName ?? "")"
                        Variant="Variant.Outlined" Required="true"
                        Placeholder="Search for a project..." />
                </MudItem>

                <!-- Title -->
                <MudItem xs="12">
                    <MudTextField @bind-Value="NoteTitle" Label="Title" Required="true" Variant="Variant.Outlined" />
                </MudItem>

                <!-- Date -->
                <MudItem xs="6">
                    <MudDatePicker @bind-Date="NoteDate" Label="Date" />
                </MudItem>

                <!-- Category (read-only) -->
                <MudItem xs="6" Class="d-flex align-end">
                    <MudChip T="string" Label="true" Color="Color.Info" Size="Size.Medium">EMAIL</MudChip>
                </MudItem>

                <!-- Notes / Context -->
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">Notes (optional)</MudText>
                    <Spokes_Server.Components.Shared.MarkdownEditor @bind-Value="NoteContent" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit" Disabled="_isSaving">
            @if (_isSaving)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
            }
            Add to Timeline
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    /// <summary>The email message to add to the timeline.</summary>
    [Parameter] public EmailMessage Email { get; set; } = default!;

    /// <summary>The account ID where the email is stored.</summary>
    [Parameter] public string AccountId { get; set; } = string.Empty;

    private Project? SelectedProject;
    private string NoteTitle = string.Empty;
    private DateTime? NoteDate;
    private string NoteContent = string.Empty;
    private bool _isSaving = false;

    protected override void OnInitialized()
    {
        // Pre-fill from email
        NoteTitle = Email?.Subject ?? "Email";
        NoteDate = Email?.Date.DateTime ?? DateTime.Today;
    }

    private async Task<IEnumerable<Project>> SearchProjects(string value, CancellationToken token)
    {
        var actor = await UserService.GetEmployeeAsync(allowSuspended: false);
        if (actor == null ||
            !actor.HasPermission(AppPermissions.Email.Use) ||
            !actor.HasPermission(AppPermissions.Projects.Edit) ||
            string.Equals(Db.CompanyProfile.Get()?.Edition, "Family", StringComparison.OrdinalIgnoreCase))
        {
            return [];
        }

        return ProjectNoteService.SearchActiveProjects(value, actor);
    }

    private async Task Submit()
    {
        if (SelectedProject == null)
        {
            Snackbar.Add("Please select a project", Severity.Warning);
            return;
        }

        if (Email == null)
        {
            Snackbar.Add("No email selected", Severity.Error);
            return;
        }

        _isSaving = true;
        StateHasChanged();

        try
        {
            var actor = await UserService.GetEmployeeAsync(allowSuspended: false);
            if (actor == null ||
                !actor.HasPermission(AppPermissions.Email.Use) ||
                !actor.HasPermission(AppPermissions.Projects.Edit) ||
                string.Equals(Db.CompanyProfile.Get()?.Edition, "Family", StringComparison.OrdinalIgnoreCase))
            {
                Snackbar.Add("You do not have permission to add emails to project timelines.", Severity.Error);
                return;
            }

            var effectiveAccountId = !string.IsNullOrEmpty(AccountId)
                ? AccountId
                : (!string.IsNullOrEmpty(Email.AccountId) ? Email.AccountId : actor.Id);

            if (!InboxService.CanUserAccessEmailMessage(actor, effectiveAccountId, Email.Id))
            {
                Snackbar.Add("You do not have access to this email message.", Severity.Error);
                return;
            }

            var mimePath = CacheMaintenance.GetMimeFilePath(effectiveAccountId, Email.Id);
            if (string.IsNullOrEmpty(mimePath))
            {
                Snackbar.Add("Email file not found on disk", Severity.Error);
                _isSaving = false;
                return;
            }

            var request = AddEmailTimelineEntryRequest.FromEmailMessage(
                SelectedProject.Id,
                mimePath,
                Email,
                NoteTitle,
                NoteDate ?? DateTime.Today,
                NoteContent,
                actor.FullName);

            await ProjectNoteService.AddEmailToTimelineAsync(request, actor);

            Snackbar.Add($"Email added to {SelectedProject.DisplayName} timeline", Severity.Success);
            MudDialog.Close(DialogResult.Ok(true));
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private void Close() => MudDialog.Cancel();
}
