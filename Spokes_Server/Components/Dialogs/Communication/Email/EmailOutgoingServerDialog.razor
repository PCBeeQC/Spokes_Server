@using Spokes_Server.Core.Configuration
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Security
@inject Database Db
@inject UserService UserService
@inject EncryptionService EncryptionService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <EmailOutgoingServerFields Server="Server"
                                       @bind-SelectedPresetId="_selectedPresetId"
                                       @bind-PlainSharedPassword="_plainSharedPassword"
                                       DomainPlaceholder="@_domainPlaceholder" />

            @if (AllowSharing)
            {
                <EmailServerSharingSection Server="Server"
                                           SwitchLabel="@Loc["Available to all users who are permitted to create identities or inboxes"]"
                                           RestrictionCaption="@Loc["Restrict which users and groups can select this Outgoing Server."]" />
            }
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveAsync">@Loc["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public SendingServerConfig Server { get; set; } = new();
    [Parameter] public bool AllowSharing { get; set; } = true;
    [Parameter] public bool IsNew { get; set; }

    private string _selectedPresetId = EmailProviderPresets.CustomPresetId;
    private string _plainSharedPassword = string.Empty;
    private string _domainPlaceholder = "example.com";

    private EmailProviderPreset? SelectedPreset =>
        EmailProviderPresets.GetById(_selectedPresetId);

    protected override void OnInitialized()
    {
        _domainPlaceholder = Db.CompanyProfile.Get().GetPrimaryDomainOrDefault("example.com");

        if (!string.IsNullOrEmpty(Server.EncryptedSharedPassword) && !EncryptionService.CanDecrypt(Server.EncryptedSharedPassword))
        {
            Server.EncryptedSharedPassword = string.Empty;
        }

        if (Server.Port <= 0)
        {
            Server.Port = EmailServerConfigValidator.DefaultSmtpPort;
        }

        var matched = EmailProviderPresets.DetectBySmtpHost(Server.Host);
        _selectedPresetId = matched?.Id ?? EmailProviderPresets.CustomPresetId;
    }

    private async Task SaveAsync()
    {
        var currentUser = await UserService.GetEmployeeAsync();
        var profile = Db.CompanyProfile.GetOrCreate();
        profile.EmailSettings ??= new EmailServerSettings();

        var (isAllowed, isAdmin) = EmailServerConfigValidator.AuthorizeServerManagement(currentUser, profile.EmailSettings);
        if (!isAllowed)
        {
            Snackbar.Add(Loc["You do not have permission to manage email servers."].Value, Severity.Error);
            return;
        }

        if (string.IsNullOrWhiteSpace(Server.Host))
        {
            Snackbar.Add(Loc["SMTP host is required."].Value, Severity.Warning);
            return;
        }

        var securityError = await EmailServerConfigValidator.ValidateTransportSecurityAsync(Server, isAdmin);
        if (securityError != EmailServerValidationError.None)
        {
            Snackbar.Add(EmailServerConfigValidator.FormatValidationError(securityError, Loc), Severity.Error);
            return;
        }

        EmailServerConfigValidator.NormalizeAndApplyDefaults(Server);

        var credError = EmailServerConfigValidator.ApplySharedCredentials(Server, _plainSharedPassword, SelectedPreset, EncryptionService);
        if (credError != EmailServerValidationError.None)
        {
            Snackbar.Add(EmailServerConfigValidator.FormatValidationError(credError, Loc), Severity.Warning);
            return;
        }

        MudDialog.Close(DialogResult.Ok(Server));
    }

    private void Cancel() => MudDialog.Cancel();
}
