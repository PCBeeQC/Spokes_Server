    private bool CanEditSelectedPhysicalRoom() =>
        _selectedPhysicalRoom != null &&
        PhysicalRoomService.CanUserEditPhysicalRoom(_selectedPhysicalRoom, _currentUser?.Id);

    private void StartEditingPhysicalRoomName()
    {
        if (_selectedPhysicalRoom == null || !CanEditSelectedPhysicalRoom()) return;
        _editingPhysicalRoomName = _selectedPhysicalRoom.Name;
        _isEditingPhysicalRoomName = true;
    }

    private async Task SavePhysicalRoomNameAsync()
    {
        if (_selectedPhysicalRoom == null || _currentUser == null || string.IsNullOrWhiteSpace(_editingPhysicalRoomName) || !CanEditSelectedPhysicalRoom())
        {
            _isEditingPhysicalRoomName = false;
            return;
        }

        var trimmed = _editingPhysicalRoomName.Trim();
        if (string.Equals(trimmed, _selectedPhysicalRoom.Name, StringComparison.Ordinal))
        {
            _isEditingPhysicalRoomName = false;
            return;
        }

        var res = await PhysicalRoomService.RenameRoomAsync(_selectedPhysicalRoom.Id, trimmed, _currentUser.Id);
        if (!res.IsSuccess)
        {
            Snackbar.Add(res.ErrorMessage ?? Loc["Could not rename room."].Value, Severity.Warning);
            return;
        }

        _isEditingPhysicalRoomName = false;
        RefreshPhysicalRoomsState();
        await VoiceService.RefreshPhysicalRoomStateAsync();
        Snackbar.Add(Loc["Room name updated"].Value, Severity.Success);
        StateHasChanged();
    }

    private async Task AdminAssignParticipantRoomAsync(string targetEmployeeId, string targetRoomId)
    {
        if (_currentUser == null || string.IsNullOrEmpty(VoiceService.CurrentChannelId)) return;
        var pDevice = ChatState.GetVoiceParticipantDevice(VoiceService.CurrentChannelId, targetEmployeeId);
        var targetDeviceId = pDevice?.DeviceId ?? (targetEmployeeId == _currentUser.Id ? _currentDeviceId : $"active-{targetEmployeeId}");
        var targetDeviceName = pDevice?.DeviceName ?? "Active Call Device";

        await PhysicalRoomService.AdminAssignParticipantDeviceToRoomAsync(
            _currentUser.Id,
            targetEmployeeId,
            targetDeviceId,
            targetDeviceName,
            string.IsNullOrWhiteSpace(targetRoomId) ? null : targetRoomId);
        RefreshPhysicalRoomsState();
        await VoiceService.RefreshPhysicalRoomStateAsync();
        StateHasChanged();
    }

    private void RefreshSavedOverrides()
    {
        _savedOverrides = _voiceSettings.ParticipantVolumes
            .Where(kvp => Math.Abs(kvp.Value - 100) > 0.1)
            .ToDictionary(k => k.Key, v => v.Value);
    }

    private double GetParticipantVolume(string participantId)
    {
        if (_voiceSettings.ParticipantVolumes.TryGetValue(participantId, out var vol))
        {
            return vol;
        }
        return 100.0;
    }

    private async Task OnMasterVolumeChanged(double value)
    {
        _voiceSettings.MasterVolume = value;
        await VoiceService.SetMasterVolumeAsync(value);
        await PersistSettingsAsync();
    }

    private async Task ResetMasterVolume()
    {
        await OnMasterVolumeChanged(100.0);
    }

    private async Task OnParticipantVolumeChanged(string participantId, double value)
    {
        _voiceSettings.ParticipantVolumes[participantId] = value;
        RefreshSavedOverrides();
        await VoiceService.SetParticipantVolumeAsync(participantId, value);
        await PersistSettingsAsync();
    }

    private async Task OnRemoveSavedOverride(string participantId)
    {
        _voiceSettings.ParticipantVolumes.Remove(participantId);
        RefreshSavedOverrides();
        await VoiceService.SetParticipantVolumeAsync(participantId, 100.0);
        await PersistSettingsAsync();
    }

    private async Task StartMicTest()
    {
        _isTestingMic = true;
        _testAudioUrl = null;
        _testStartTime = DateTime.Now;
        _testDurationText = "0:00";

        _testTimer = new System.Timers.Timer(1000);
        _testTimer.Elapsed += (s, e) =>
        {
            var diff = DateTime.Now - _testStartTime;
            _testDurationText = $"{(int)diff.TotalMinutes}:{diff.Seconds:D2}";
            InvokeAsync(StateHasChanged);
        };
        _testTimer.Start();

        var micId = VoiceUiState.ActiveMicrophoneDeviceId;
        var started = await JS.InvokeAsync<bool>("spokesMicDiagnostic.start", "voice-test-soundwave", micId);
        if (!started)
        {
            await StopMicTest();
            Snackbar.Add(Loc["Could not access microphone for testing."].Value, Severity.Warning);
        }
    }

    private async Task StopMicTest()
    {
        _isTestingMic = false;
        if (_testTimer != null)
        {
            _testTimer.Stop();
            _testTimer.Dispose();
            _testTimer = null;
        }

        try
        {
            var url = await JS.InvokeAsync<string?>("spokesMicDiagnostic.stop");
            _testAudioUrl = url;
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[VoiceSettings] StopMicTest error");
        }

        StateHasChanged();
    }

