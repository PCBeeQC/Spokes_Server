@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Aggregate
@using Spokes_Server.Core.Data
@using Spokes_Server.Components.Layout
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Helpers

<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">Share to Spokes</MudText>
    </TitleContent>
    <DialogContent>
        <MudText Typo="Typo.subtitle2" Class="mb-1">Destination Channel</MudText>
        <div style="height: 450px; border: 1px solid var(--mud-palette-lines-default); border-radius: 4px; overflow: hidden; margin-bottom: 8px;">
            <Spokes_Server.Components.Pages.Chat.ChatSidebar 
                Channels="Channels" 
                SelectedChannelId="@SelectedChannelId" 
                OnChannelSelected="HandleChannelSelected" 
                CurrentUserId="@_currentUserId" 
                Employees="_employees" />
        </div>

        @if (!string.IsNullOrEmpty(SelectedChannelId))
        {
            var selectedChannel = Channels.FirstOrDefault(c => c.Id == SelectedChannelId);
            if (selectedChannel != null)
            {
                <div class="d-flex align-center gap-2 mb-4 pa-2" style="background: var(--mud-palette-background); border-radius: 4px; border: 1px solid var(--mud-palette-lines-default);">
                    <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                    <MudText Typo="Typo.body2">Sharing to: <strong>@GetChannelDisplayName(selectedChannel)</strong></MudText>
                </div>
            }
        }

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="ProceedToChannel" Disabled="@(string.IsNullOrEmpty(SelectedChannelId))">
            <span>Go to channel</span>
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    
    [Parameter] public string? SharedText { get; set; }
    [Parameter] public string? SharedUrl { get; set; }
    [Parameter] public string? SharedTitle { get; set; }
    [Parameter] public List<MainLayout.SharedFile> SharedFiles { get; set; } = new();

    [Parameter] public string? PreselectedChannelId { get; set; }

    [Inject] private Database Db { get; set; } = default!;
    [Inject] private Spokes_Server.Core.Services.Core.UserService UserService { get; set; } = default!;
    [Inject] private Spokes_Server.Core.Services.Communication.Chat.ChatService ChatService { get; set; } = default!;

    private string? SelectedChannelId { get; set; }
    private List<ChatChannel> Channels { get; set; } = new();
    private List<Employee> _employees = new();
    private string? _currentUserId;

    protected override async Task OnInitializedAsync()
    {
        _employees = Db.Employees.GetAll().Where(e => e.IsActive).ToList();
        
        var employee = await UserService.GetEmployeeAsync();
        _currentUserId = employee?.Id;
        
        if (!string.IsNullOrEmpty(_currentUserId))
        {
            Channels = ChatService.GetChannelsForUser(_currentUserId);
        }
        
        if (!string.IsNullOrEmpty(PreselectedChannelId))
        {
            SelectedChannelId = PreselectedChannelId;
        }
        else
        {
            // Auto-select general channel or first channel
            var general = Channels.FirstOrDefault(c => c.ChannelType == ChatChannelType.General && string.IsNullOrEmpty(c.CategoryId) && !c.AllowedTeamIds.Any() && !c.ParticipantIds.Any());
            if (general != null)
            {
                SelectedChannelId = general.Id;
            }
            else if (Channels.Any())
            {
                SelectedChannelId = Channels.First().Id;
            }
        }
    }

    private void HandleChannelSelected(string channelId)
    {
        SelectedChannelId = channelId;
    }

    private void Close() => MudDialog.Cancel();

    private void ProceedToChannel()
    {
        if (string.IsNullOrEmpty(SelectedChannelId)) return;
        MudDialog.Close(DialogResult.Ok(new ShareResult { ChannelId = SelectedChannelId }));
    }

    private string GetChannelDisplayName(ChatChannel channel)
    {
        return ChatChannelFormatter.GetDisplayName(channel, _currentUserId, _employees);
    }

    public class ShareResult
    {
        public string? ChannelId { get; set; }
    }
}
