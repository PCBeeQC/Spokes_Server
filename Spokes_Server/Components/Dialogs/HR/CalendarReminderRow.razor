@* Reusable reminder / duration row for calendar events and chat polls *@
<MudPaper Elevation="0" Outlined="true" Class="px-2 px-sm-3 py-2 rounded-lg w-100" Style="background-color: var(--mud-palette-background-grey);">
    <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="w-100" Justify="Justify.FlexStart" StretchItems="StretchItems.None"> 
        <MudIcon Icon="@Icon" Size="Size.Small" Color="@IconColor" Class="flex-shrink-0" />
        <MudNumericField Value="@Reminder.Value"
                         ValueChanged="@HandleValueChanged"
                         T="int"
                         Min="@MinValue"
                         Max="999"
                         HideSpinButtons="true"
                         Style="width: 68px; flex-shrink: 0;"
                         Margin="Margin.Dense"
                         Variant="Variant.Outlined"
                         Disabled="@Disabled"
                         aria-label="@Loc["Reminder amount"]" />
        <MudSelect T="CalendarReminderUnit"
                   Value="@Reminder.Unit"
                   ValueChanged="@HandleUnitChanged"
                   ToStringFunc="@FormatUnit"
                   Margin="Margin.Dense"
                   Variant="Variant.Outlined"
                   Dense="true"
                   Class="flex-grow-1 min-w-0"
                   Disabled="@Disabled"
                   aria-label="@Loc["Reminder timing"]">
            <MudSelectItem Value="CalendarReminderUnit.Minutes">@(IncludeBeforeSuffix ? Loc["Minutes before"].Value : Loc["Minutes"].Value)</MudSelectItem>
            <MudSelectItem Value="CalendarReminderUnit.Hours">@(IncludeBeforeSuffix ? Loc["Hours before"].Value : Loc["Hours"].Value)</MudSelectItem>
            <MudSelectItem Value="CalendarReminderUnit.Days">@(IncludeBeforeSuffix ? Loc["Days before"].Value : Loc["Days"].Value)</MudSelectItem>
            <MudSelectItem Value="CalendarReminderUnit.Weeks">@(IncludeBeforeSuffix ? Loc["Weeks before"].Value : Loc["Weeks"].Value)</MudSelectItem>
        </MudSelect>
        @if (OnRemove.HasDelegate)
        {
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           Color="Color.Default"
                           OnClick="@OnRemove"
                           Disabled="@Disabled"
                           Class="flex-shrink-0"
                           title="@(RemoveTooltip ?? Loc["Remove reminder"].Value)"
                           aria-label="@(RemoveTooltip ?? Loc["Remove reminder"].Value)" />
        }
    </MudStack>
</MudPaper>

@code {
    [Parameter, EditorRequired]
    public CalendarReminder Reminder { get; set; } = null!;

    [Parameter]
    public string Icon { get; set; } = Icons.Material.Filled.NotificationsActive;

    [Parameter]
    public Color IconColor { get; set; } = Color.Primary;

    [Parameter]
    public bool Disabled { get; set; }

    [Parameter]
    public bool IncludeBeforeSuffix { get; set; } = true;

    [Parameter]
    public int MinValue { get; set; } = 0;

    [Parameter]
    public string? RemoveTooltip { get; set; }

    [Parameter]
    public EventCallback OnRemove { get; set; }

    [Parameter]
    public EventCallback<CalendarReminder> ReminderChanged { get; set; }

    private string FormatUnit(CalendarReminderUnit unit)
    {
        var isSingular = (Reminder?.Value ?? 0) == 1;
        if (!IncludeBeforeSuffix)
        {
            return unit switch
            {
                CalendarReminderUnit.Minutes => isSingular ? Loc["Minute"].Value : Loc["Minutes"].Value,
                CalendarReminderUnit.Hours => isSingular ? Loc["Hour"].Value : Loc["Hours"].Value,
                CalendarReminderUnit.Days => isSingular ? Loc["Day"].Value : Loc["Days"].Value,
                CalendarReminderUnit.Weeks => isSingular ? Loc["Week"].Value : Loc["Weeks"].Value,
                _ => Loc["Minutes"].Value
            };
        }

        return unit switch
        {
            CalendarReminderUnit.Minutes => isSingular ? Loc["Minute before"].Value : Loc["Minutes before"].Value,
            CalendarReminderUnit.Hours => isSingular ? Loc["Hour before"].Value : Loc["Hours before"].Value,
            CalendarReminderUnit.Days => isSingular ? Loc["Day before"].Value : Loc["Days before"].Value,
            CalendarReminderUnit.Weeks => isSingular ? Loc["Week before"].Value : Loc["Weeks before"].Value,
            _ => Loc["Minutes before"].Value
        };
    }

    private async Task HandleValueChanged(int val)
    {
        Reminder.Value = Math.Max(MinValue, val);
        if (ReminderChanged.HasDelegate)
        {
            await ReminderChanged.InvokeAsync(Reminder);
        }
        StateHasChanged();
    }

    private async Task HandleUnitChanged(CalendarReminderUnit unit)
    {
        Reminder.Unit = unit;
        if (ReminderChanged.HasDelegate)
        {
            await ReminderChanged.InvokeAsync(Reminder);
        }
        StateHasChanged();
    }
}
