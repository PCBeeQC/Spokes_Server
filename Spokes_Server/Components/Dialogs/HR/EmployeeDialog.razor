@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Data.Repositories.Core
@inject UserService UserService
@inject EncryptionService EncryptionService
@inject CompanyProfileRepository CompanyProfile
@inject AppLabelService AppLabels

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudToggleGroup T="int" @bind-Value="activeTabIndex" Outlined="true" Delimiters="true" CheckMark="false" Class="mb-6 flex-wrap" >
                <MudToggleItem Value="0" Text="@Loc["Profile"]" />
                @if (!IsFriendEdition)
                {
                    <MudToggleItem Value="1" Text="@BizLoc["HR Details"]" />
                }
                <MudToggleItem Value="2" Text="@Loc["Access"]" />
                @if (CurrentUserIsAdmin)
                {
                    <MudToggleItem Value="3" Text="@Loc["Identity"]" />
                }
            </MudToggleGroup>

            <MudPaper Elevation="0" Outlined="true" Class="pa-4">
            @if (activeTabIndex == 0)
            {
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.FirstName" Label="@Loc["First Name"]" Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.LastName" Label="@Loc["Last Name"]" Required="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.Email" Label="@Loc["Email"]" Required="true" />
                        </MudItem>
                        @if (!IsFriendEdition)
                        {
                            
                            <MudItem xs="12">
                                @if (!string.IsNullOrEmpty(Employee.EncryptedEmailPassword))
                                {
                                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Value="@("********")" Label="Email Password" ReadOnly="true"
                                                  Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Lock" />
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" OnClick="@(() => _showPasswordInput = true)">
                                        Change Password
                                    </MudButton>
                                }

                                @if (string.IsNullOrEmpty(Employee.EncryptedEmailPassword) || _showPasswordInput)
                                {
                                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="_newPassword" Label="@(string.IsNullOrEmpty(Employee.EncryptedEmailPassword) ? BizLoc["Email Password"].Value : BizLoc["New Email Password"].Value)"
                                                  InputType="InputType.Password"
                                                  HelperText="@Loc["Password is encrypted before storage"]" />
                                }
                            </MudItem>
                            <MudItem xs="12">
                                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.Position" Label="@BizLoc["Position / Title"]" />
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" T="string" @bind-Value="Employee.TeamId" Label="@string.Format(Loc["Primary {0}"].Value, AppLabels.Team)" Clearable="true">
                                    @foreach (var t in AllTeams)
                                    {
                                        <MudSelectItem Value="@t.Id">@t.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.WeeklyHours" Label="@BizLoc["Weekly Capacity (Hours)"]" Min="0"
                                                 Max="168" Step="4" />
                            </MudItem>
                        }
                    </MudGrid>
            }
            else if (activeTabIndex == 1)
            {
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Date="dateOfBirth" Label="@BizLoc["Date of Birth"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Date="dateOfJoining" Label="@BizLoc["Hire Date"]" 
                                HelperText="@BizLoc["Used as hour bank start date"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudDatePicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Date="employmentEndDate" Label="@BizLoc["Termination Date"]" 
                                Clearable="true" HelperText="@BizLoc["Stops hour bank accumulation when set"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.PersonalEmail" Label="@BizLoc["Personal Email"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.PhoneNumber" Label="@BizLoc["Personal Phone"]" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.Address" Label="@Loc["Address"]" Lines="2" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.EmergencyContact" Label="@BizLoc["Emergency Contact Name"]" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Employee.EmergencyContactPhone" Label="@BizLoc["Emergency Contact Phone"]" />
                        </MudItem>
                        
                        <MudItem xs="12">
                            <MudDivider Class="my-4" />
                            <div class="d-flex justify-space-between align-center mb-2">
                                <div>
                                    <MudText Typo="Typo.subtitle2">@BizLoc["Work Schedules"]</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Tertiary">@BizLoc["Define historical expected hours. Leave End Date empty for the current ongoing schedule."]</MudText>
                                </div>
                                <MudButton Variant="Variant.Text" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="AddWorkSchedule">
                                    @BizLoc["Add Schedule"]
                                </MudButton>
                            </div>
                            <MudTable Items="@Employee.WorkSchedules" Dense="true" Hover="true" Elevation="0" Outlined="true">
                                <HeaderContent>
                                    <MudTh>@BizLoc["Start Date"]</MudTh>
                                    <MudTh>@BizLoc["End Date"]</MudTh>
                                    <MudTh>@BizLoc["Weekly Hours"]</MudTh>
                                    <MudTh>@BizLoc["Note"]</MudTh>
                                    <MudTh>@BizLoc["Actions"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="Start Date">
                                        <MudDatePicker Margin="Margin.Dense" 
                                            Date="@(context.StartDate.ToDateTime(TimeOnly.MinValue))" 
                                            DateChanged="@((DateTime? d) => { if(d.HasValue) context.StartDate = DateOnly.FromDateTime(d.Value); })" 
                                            DateFormat="yyyy-MM-dd" Variant="Variant.Text" />
                                    </MudTd>
                                    <MudTd DataLabel="End Date">
                                        <MudDatePicker Margin="Margin.Dense" 
                                            Date="@(context.EndDate?.ToDateTime(TimeOnly.MinValue))" 
                                            DateChanged="@((DateTime? d) => context.EndDate = d.HasValue ? DateOnly.FromDateTime(d.Value) : null)" 
                                            DateFormat="yyyy-MM-dd" Variant="Variant.Text" Clearable="true" />
                                    </MudTd>
                                    <MudTd DataLabel="Weekly Hours">
                                        <MudNumericField Margin="Margin.Dense" @bind-Value="context.WeeklyHours" Min="0" Max="168" Variant="Variant.Text" />
                                    </MudTd>
                                    <MudTd DataLabel="Note">
                                        <MudTextField Margin="Margin.Dense" @bind-Value="context.Note" Variant="Variant.Text" />
                                    </MudTd>
                                    <MudTd DataLabel="Actions">
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => RemoveWorkSchedule(context))" />
                                    </MudTd>
                                </RowTemplate>
                                <NoRecordsContent>
                                    <MudText Typo="Typo.body2" Color="Color.Tertiary" Class="py-4">@BizLoc["No schedules defined. System will use Weekly Capacity fallback."]</MudText>
                                </NoRecordsContent>
                            </MudTable>
                        </MudItem>
                    </MudGrid>
            }
            else if (activeTabIndex == 2)
            {
                    <MudGrid>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Employee.IsActive" Color="Color.Success" Label="@Loc["Active Account"]" />
                            <MudSwitch @bind-Value="Employee.IsAdmin" Color="Color.Error"
                                Label="@Loc["Global Administrator (Super User)"]" Disabled="!CurrentUserIsAdmin" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">@Loc["Granular Permissions"]</MudText>
                            <MudText Typo="Typo.caption" Class="mb-2 d-block">@Loc["Only applicable if not Admin."]</MudText>

                            <div class="mb-4">
                                <MudSelect T="string" Label="@Loc["Assigned Roles / Permission Groups"]" MultiSelection="true" 
                                           SelectedValues="_selectedRoleIds" SelectedValuesChanged="OnRolesChanged" 
                                           MultiSelectionTextFunc="@(values => FormatSelectedPermissionGroups(values))"
                                           ToStringFunc="@(id => (Profile?.PermissionGroups ?? new()).FirstOrDefault(g => g.Id == id)?.Name ?? id)"
                                           Variant="Variant.Outlined" Clearable="true" Placeholder="@Loc["None (Custom)"]"
                                           AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft">
                                    @foreach(var group in Profile?.PermissionGroups ?? new())
                                    {
                                        <MudSelectItem Value="@group.Id">@group.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                <MudText Typo="Typo.caption" Class="mt-1 d-block text-muted">@Loc["Select one or more roles to dynamically inherit permissions, or customize granular permissions below."]</MudText>
                            </div>

                            <MudGrid Class="mt-2">
                            @foreach (var category in AppPermissions.GetAll())
                            {
                                    if (IsFriendEdition && IsBusinessCategory(category.Key))
                                        continue;

                                    <MudItem xs="12" sm="6" md="4">
                                        <MudPaper Elevation="0" Outlined="true" Class="pa-3 h-100">
                                            <MudText Typo="Typo.subtitle2" Class="mb-3 text-primary">@category.Key</MudText>
                                            <div class="d-flex flex-column gap-1 align-start">
                                            @foreach (var perm in category.Value)
                                            {
                                                bool isAdminOnlyPerm = perm == AppPermissions.Admin.ManageUsers || perm == AppPermissions.Admin.ManageSettings;
                                                
                                                bool groupHasPerm = Profile?.PermissionGroups
                                                    .Where(g => Employee.PermissionGroupIds.Contains(g.Id))
                                                    .Any(g => g.Permissions.Contains(perm)) ?? false;
                                                
                                                bool hasIt = groupHasPerm || HasPerm(perm);
                                                bool disabled = Employee.IsAdmin || (isAdminOnlyPerm && !CurrentUserIsAdmin) || groupHasPerm;

                                                <MudTooltip Text="@AppPermissions.GetDescription(perm)" Delay="300" Placement="Placement.Top">
                                                    <MudCheckBox T="bool" Value="@hasIt"
                                                                 ValueChanged="@((v) => TogglePerm(perm, v))" Label="@GetShortPermName(category.Key, perm)" Dense="true"
                                                                 Color="Color.Primary"
                                                                 Disabled="@disabled" />
                                                </MudTooltip>
                                            }
                                            </div>
                                        </MudPaper>
                                    </MudItem>
                            }
                            </MudGrid>
                        </MudItem>
                    </MudGrid>
            }
            else if (activeTabIndex == 3 && CurrentUserIsAdmin)
            {
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["Linked OpenID Accounts"]</MudText>
                            <MudText Typo="Typo.caption" Class="mb-3 d-block">
                                @string.Format(Loc["Multiple OpenID accounts can be linked to this {0} for authentication."].Value, AppLabels.Employee.ToLowerInvariant())
                            </MudText>

                            @if (LinkedOpenIdAccounts.Any())
                            {
                                    <MudTable Items="@LinkedOpenIdAccounts" Dense="true" Hover="true" Striped="true"
                                        Class="mb-4">
                                        <HeaderContent>
                                            <MudTh>@Loc["Name"]</MudTh>
                                            <MudTh>@Loc["Email"]</MudTh>
                                            <MudTh>@Loc["Last Login"]</MudTh>
                                            <MudTh>@Loc["Actions"]</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="@Loc["Name"]">@context.Name</MudTd>
                                            <MudTd DataLabel="@Loc["Email"]">@context.Email</MudTd>
                                            <MudTd DataLabel="@Loc["Last Login"]">@context.LastLoginAt.ToString("g")</MudTd>
                                            <MudTd DataLabel="@Loc["Actions"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.LinkOff" Size="Size.Small"
                                                    Color="Color.Error" title="@Loc["Unlink this account"]"
                                                    OnClick="@(() => UnlinkOpenIdAccount(context))" />
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                            }
                            else
                            {
                                    <MudAlert Severity="Severity.Info" Class="mb-4">
                                        @string.Format(Loc["No OpenID accounts are linked to this {0}."].Value, AppLabels.Employee.ToLowerInvariant())
                                    </MudAlert>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["Link New OpenID Account"]</MudText>

                            @if (UnlinkedOpenIdAccounts.Any())
                            {
                                    <MudTable Items="@UnlinkedOpenIdAccounts" Dense="true" Hover="true" Class="mb-2">
                                        <HeaderContent>
                                            <MudTh>@Loc["Name"]</MudTh>
                                            <MudTh>@Loc["Email"]</MudTh>
                                            <MudTh>@Loc["First Seen"]</MudTh>
                                            <MudTh>@Loc["Link"]</MudTh>
                                        </HeaderContent>
                                        <RowTemplate>
                                            <MudTd DataLabel="@Loc["Name"]">@context.Name</MudTd>
                                            <MudTd DataLabel="@Loc["Email"]">@context.Email</MudTd>
                                            <MudTd DataLabel="@Loc["First Seen"]">@context.FirstSeenAt.ToString("d")</MudTd>
                                            <MudTd DataLabel="@Loc["Link"]">
                                                <MudIconButton Icon="@Icons.Material.Filled.Link" Size="Size.Small"
                                                    Color="Color.Primary" title="@string.Format(Loc["Link to this {0}"].Value, AppLabels.Employee.ToLowerInvariant())"
                                                    OnClick="@(() => LinkOpenIdAccount(context))" />
                                            </MudTd>
                                        </RowTemplate>
                                    </MudTable>
                            }
                            else
                            {
                                    <MudText Typo="Typo.body2" Color="Color.Tertiary">
                                        @Loc["No unlinked OpenID accounts available. New accounts appear here when users log in."]
                                    </MudText>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["All OpenID Accounts"]</MudText>
                            <MudText Typo="Typo.caption" Class="mb-3 d-block text-muted">
                                @Loc["Complete list of all OpenID accounts in the system."]
                            </MudText>

                            <MudTable Items="@AllOpenIdAccounts" Dense="true" Hover="true" Striped="true">
                                <HeaderContent>
                                    <MudTh>@Loc["Name"]</MudTh>
                                    <MudTh>@Loc["Email"]</MudTh>
                                    <MudTh>@Loc["Linked To"]</MudTh>
                                    <MudTh>@Loc["Last Login"]</MudTh>
                                </HeaderContent>
                                <RowTemplate>
                                    <MudTd DataLabel="@Loc["Name"]">@context.Name</MudTd>
                                    <MudTd DataLabel="@Loc["Email"]">@context.Email</MudTd>
                                    <MudTd DataLabel="@Loc["Linked To"]">
                                        @if (!string.IsNullOrEmpty(context.LinkedEmployeeId))
                                        {
                                            var linkedEmp = AllEmployees.FirstOrDefault(e => e.Id ==
                                            context.LinkedEmployeeId);
                                                <MudChip T="string" Size="Size.Small" Color="Color.Success">
                                                @(linkedEmp?.FullName ?? Loc["Unknown"].Value)</MudChip>
                                        }
                                        else
                                        {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@Loc["Unlinked"]</MudChip>
                                        }
                                    </MudTd>
                                    <MudTd DataLabel="@Loc["Last Login"]">@context.LastLoginAt.ToString("g")</MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                    </MudGrid>
            }
            </MudPaper>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">@Loc["Save Changes"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Employee Employee { get; set; } = default!;
    [Parameter] public List<Employee> AllEmployees { get; set; } = [];
    [Parameter] public List<Team> AllTeams { get; set; } = [];
    [Parameter] public List<OpenIdAccount> AllOpenIdAccounts { get; set; } = [];

    private MudForm form = default!;
    private bool success;
    private bool CurrentUserIsAdmin;
    private CompanyProfile Profile = default!;
    private int activeTabIndex;
    private bool IsFriendEdition => Profile?.Edition == "Family";

    // Email Password Handling
    private string _newPassword = "";
    private bool _showPasswordInput;

    protected override async Task OnInitializedAsync()
    {
        var currentEmp = await UserService.GetEmployeeAsync();
        CurrentUserIsAdmin = currentEmp?.IsAdmin ?? false;
        if (!CurrentUserIsAdmin && activeTabIndex == 3)
        {
            activeTabIndex = 0;
        }
        Profile = CompanyProfile.Get();
    }

    // OpenID Account Lists (computed from AllOpenIdAccounts)
    private List<OpenIdAccount> LinkedOpenIdAccounts =>
    AllOpenIdAccounts.Where(a => a.LinkedEmployeeId == Employee.Id).ToList();

    private List<OpenIdAccount> UnlinkedOpenIdAccounts =>
    AllOpenIdAccounts.Where(a => string.IsNullOrEmpty(a.LinkedEmployeeId)).ToList();

    // Helper properties for Nullable Date conversion (MudBlazor DatePicker uses DateTime?, Model uses DateOnly)
    private DateTime? dateOfBirth
    {
        get => Employee.DateOfBirth.ToDateTime(TimeOnly.MinValue);
        set => Employee.DateOfBirth = value.HasValue ? DateOnly.FromDateTime(value.Value) :
        DateOnly.FromDateTime(DateTime.UtcNow);
    }

    private DateTime? dateOfJoining
    {
        get => Employee.DateOfJoining.ToDateTime(TimeOnly.MinValue);
        set => Employee.DateOfJoining = value.HasValue ? DateOnly.FromDateTime(value.Value) :
        DateOnly.FromDateTime(DateTime.UtcNow);
    }

    private DateTime? employmentEndDate
    {
        get => Employee.EmploymentEndDate?.ToDateTime(TimeOnly.MinValue);
        set => Employee.EmploymentEndDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null;
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (success)
        {
            if (!string.IsNullOrWhiteSpace(_newPassword))
            {
                Employee.EncryptedEmailPassword = EncryptionService.Encrypt(_newPassword);
            }
            MudDialog.Close(DialogResult.Ok(Employee));
        }
    }

    // Permission Helpers
    private bool HasPerm(string p) => Employee.Permissions.Contains(p);

    private string GetShortPermName(string category, string perm) =>
        perm.StartsWith(category + ".") ? perm.Substring(category.Length + 1) : perm;

    private void TogglePerm(string p, bool hasIt)
    {
        if (hasIt && !Employee.Permissions.Contains(p))
            Employee.Permissions.Add(p);
        else if (!hasIt && Employee.Permissions.Contains(p))
            Employee.Permissions.Remove(p);
    }

    // OpenID Account Management
    private void LinkOpenIdAccount(OpenIdAccount account)
    {
        if (!CurrentUserIsAdmin) return;
        account.LinkedEmployeeId = Employee.Id;
        // Note: Actual save happens when dialog is closed successfully
    }

    private void UnlinkOpenIdAccount(OpenIdAccount account)
    {
        if (!CurrentUserIsAdmin) return;
        account.LinkedEmployeeId = string.Empty;
        // Note: Actual save happens when dialog is closed successfully
    }

    private IReadOnlyCollection<string> _selectedRoleIds
    {
        get => Employee.PermissionGroupIds;
        set => Employee.PermissionGroupIds = value?.ToList() ?? [];
    }

    private void OnRolesChanged(IReadOnlyCollection<string> roleIds)
    {
        Employee.PermissionGroupIds = roleIds?.ToList() ?? [];
    }

    private string FormatSelectedPermissionGroups(IReadOnlyList<string> selectedValues)
    {
        if (selectedValues == null || selectedValues.Count == 0) return string.Empty;
        var groups = Profile?.PermissionGroups ?? new();
        return string.Join(", ", selectedValues.Select(id => groups.FirstOrDefault(g => g.Id == id)?.Name ?? id));
    }

    private static readonly string[] BusinessCategories = [
        "Projects", "Email", "Address Book", "Finance", 
        "Purchases", "Timesheets", "Business Documents", "My Week" 
    ];

    private static bool IsBusinessCategory(string categoryKey) => BusinessCategories.Contains(categoryKey);

    private void AddWorkSchedule()
    {
        Employee.WorkSchedules ??= new();
        Employee.WorkSchedules.Add(new EmployeeWorkSchedule
        {
            StartDate = Employee.DateOfJoining,
            WeeklyHours = Employee.WeeklyHours
        });
    }

    private void RemoveWorkSchedule(EmployeeWorkSchedule schedule)
    {
        Employee.WorkSchedules?.Remove(schedule);
    }
}

