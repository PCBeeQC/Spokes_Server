@using Spokes_Server.Components.Shared
@inject AppLabelService AppLabels

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.PeopleAlt" Size="Size.Small" />
            <MudText Typo="Typo.h6">@Loc["Manage Contributors"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-3 pb-2">
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-1">
                @Loc["Contributors can upload their own media, delete their own media, and share this album to new channels."]
            </MudText>

            <UserGroupPicker Target="UserGroupPickerTarget.UsersOnly"
                             Style="UserGroupPickerStyle.Checklist"
                             AllowSelf="false"
                             @bind-SelectedUserIds="SelectedUserIds"
                             MaxChecklistHeightPx="360" />

            @if (IsEncrypted && HasSelectedUsersWithoutVault)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2" Icon="@Icons.Material.Filled.Info">
                    @Loc["Some selected contributors have not yet set up their Secure Vault. They will be prompted to set up their vault before they can view or contribute media."]
                </MudAlert>
            }
        </div>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Loc["Close"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@Loc["Save Changes"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<Employee>? Employees { get; set; }
    [Parameter] public HashSet<string> InitialSelectedUserIds { get; set; } = new();
    [Parameter] public bool IsEncrypted { get; set; } = true;

    private HashSet<string> SelectedUserIds { get; set; } = new();

    private bool HasSelectedUsersWithoutVault =>
        Employees?.Any(e => SelectedUserIds.Contains(e.Id) && string.IsNullOrEmpty(e.PublicKey)) == true;

    protected override void OnInitialized()
    {
        SelectedUserIds = new HashSet<string>(InitialSelectedUserIds);
    }

    private void Close() => MudDialog.Cancel();

    private void Save() => MudDialog.Close(DialogResult.Ok(SelectedUserIds.ToList()));
}
