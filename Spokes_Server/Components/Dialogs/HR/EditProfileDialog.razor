@using Spokes_Server.Core.Services.Security
@inject Database Db
@inject ISnackbar Snackbar
@inject AppLabelService AppLabels
@inject IDialogService DialogService
@inject IConfiguration Config
@inject IFileService FileService
@inject FileUrlSigner FileUrls

<MudDialog>
    <DialogContent>
        @if (_workingEmployee.IsSuspended)
        {
            <MudAlert Severity="Severity.Error" Class="ma-4">@Loc["Your account is suspended. You cannot edit your profile."]</MudAlert>
        }
        else
        {
        <MudGrid>
            <!-- Preview -->
            <MudItem xs="12" Class="d-flex justify-center my-4">
                @if (!string.IsNullOrEmpty(_avatarBase64))
                {
                        <MudAvatar Style="height:100px; width:100px;">
                            <MudImage Src="@_avatarBase64" ObjectFit="ObjectFit.Cover" />
                        </MudAvatar>
                }
                else
                {
                        <MudAvatar
                            Style="@($"height:100px; width:100px; background-color: {(_profileColor ?? Colors.DeepPurple.Default)}; color: {Colors.Shades.White}; font-size: 2rem;")">
                        @_workingEmployee.FirstName.FirstOrDefault()@_workingEmployee.LastName.FirstOrDefault()
                        </MudAvatar>
                }
            </MudItem>

            <!-- Upload -->
            <MudItem xs="12" Class="d-flex justify-center align-center gap-2">
                <ApiFileUpload Category="avatars" ContextId="@_workingEmployee.Id" MaximumFileCount="1"
                               Accept="image/*"
                               OnUploadCompleted="HandleAvatarApiUploaded"
                               OnUploadError='(e) => Snackbar.Add(string.Format(Loc["Error: {0}"].Value, e), Severity.Error)'>
                    <CustomContent>
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload" Disabled="@(Config.GetValue<bool>("Spokes_DemoMode"))">
                            @Loc["UploadAvatar"]
                        </MudButton>
                    </CustomContent>
                </ApiFileUpload>
                @if (!string.IsNullOrEmpty(_avatarBase64))
                {
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" OnClick="RemoveAvatar" Disabled="@(Config.GetValue<bool>("Spokes_DemoMode"))">@Loc["Remove"]</MudButton>
                }
            </MudItem>

            @if (!IsFriendEdition)
            {
                <!-- Signature Upload -->
                <MudItem xs="12" Class="d-flex flex-column align-center my-4">
                    <MudText Typo="Typo.subtitle1" Class="mb-2">@BizLoc["Document Signature"]</MudText>
                    @if (!string.IsNullOrEmpty(_signatureBase64))
                    {
                            <MudPaper Elevation="0" Outlined="true" Class="pa-2 mb-2 d-flex justify-center" Style="background-color: #fafafa; width: 100%; max-width: 300px;">
                                <MudImage Src="@FileUrls.SignUrl(_signatureBase64)" Style="max-height: 80px; object-fit: contain;" />
                            </MudPaper>
                    }
                    else
                    {
                            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-2">@BizLoc["No signature uploaded. This is used for document blocks."]</MudText>
                    }
                    <div class="d-flex gap-2 mt-2">
                        <ApiFileUpload Category="signatures" ContextId="@_workingEmployee.Id" MaximumFileCount="1"
                                       Accept="image/*"
                                       OnUploadCompleted="HandleSignatureApiUploaded"
                                       OnUploadError='(e) => Snackbar.Add(string.Format(Loc["Error: {0}"].Value, e), Severity.Error)'>
                            <CustomContent>
                                <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Draw">
                                    @BizLoc["Upload Signature"]
                                </MudButton>
                            </CustomContent>
                        </ApiFileUpload>
                        @if (!string.IsNullOrEmpty(_signatureBase64))
                        {
                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" OnClick="RemoveSignature">@Loc["Remove"]</MudButton>
                        }
                    </div>
                </MudItem>
            }

            @if (string.IsNullOrEmpty(_avatarBase64))
            {
                <!-- Color Picker -->
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["ProfileColorUsedIfNoAvatar"]</MudText>
                    <MudColorPicker Variant="Variant.Outlined" @bind-Text="_profileColor" Style="@($"color: {_profileColor};")"
                                    Placeholder="@Loc["Select Color"]" ColorPickerMode="ColorPickerMode.HEX" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudDivider Class="mb-2" />
                <MudText Typo="Typo.h6">@(IsFriendEdition ? Loc["Personal Information"] : BizLoc["Professional Information"])</MudText>
            </MudItem>

            <MudItem xs="6" Class="mt-n5">
                <MudTextField ShrinkLabel @bind-Value="_workingEmployee.FirstName" Label="@Loc["FirstName"]" ReadOnly="@(!IsFriendEdition)" Variant="Variant.Outlined"
                    Margin="Margin.Dense" />
            </MudItem>
            <MudItem xs="6" Class="mt-n5">
                <MudTextField ShrinkLabel @bind-Value="_workingEmployee.LastName" Label="@Loc["LastName"]" ReadOnly="@(!IsFriendEdition)" Variant="Variant.Outlined"
                    Margin="Margin.Dense" />
            </MudItem>
            
            <MudItem xs="@(IsFriendEdition ? 12 : 6)" Class="mt-n4">
                <MudTextField ShrinkLabel @bind-Value="_workingEmployee.Email" Label="@AppLabels.Email" ReadOnly="@(!IsFriendEdition)" Variant="Variant.Outlined"
                    Margin="Margin.Dense" />
            </MudItem>

            <MudItem xs="12" Class="mt-n2 mb-2">
                <MudCheckBox @bind-Value="_workingEmployee.IsEmailPublic" Label="@Loc["MakeMyEmailVisibleToOtherUsers"]" Color="Color.Primary" Dense="true" />
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-8 d-block mt-n2">@Loc["If unchecked, your email will be hidden on your public profile card."]</MudText>
            </MudItem>

            @if (!IsFriendEdition)
            {
                <MudItem xs="6" Class="mt-n4">
                    <MudTextField ShrinkLabel Value="@_workingEmployee.Position" Label="@BizLoc["Position / Title"]" ReadOnly="true"
                        Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem Class="mt-n4" xs="4">
                    <MudTextField ShrinkLabel Value="@TeamName" Label="@string.Format(Loc["Primary {0}"].Value, AppLabels.Team)" ReadOnly="true" Variant="Variant.Outlined"
                                  Margin="Margin.Dense" />
                </MudItem>
            
                <MudItem Class="mt-n4" xs="4">
                    <MudTextField ShrinkLabel Value="@_workingEmployee.WeeklyHours.ToString("0.##")" Label="@BizLoc["Weekly Capacity (Hours)"]"
                        ReadOnly="true" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem Class="mt-n4" xs="4">
                    <MudTextField ShrinkLabel Value="@_workingEmployee.DateOfJoining.ToString("d")" Label="@BizLoc["Hire Date"]" ReadOnly="true"
                        Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>

                <MudItem Class="mt-n4" xs="12">
                    <MudDivider Class="my-4" />
                    <MudText Typo="Typo.h6">@Loc["Personal Information"]</MudText>
                </MudItem>
            }

            @if (!IsFriendEdition)
            {
                <MudItem Class="mt-n4" xs="6">
                    <MudTextField ShrinkLabel @bind-Value="_workingEmployee.PersonalEmail" Label="@BizLoc["Personal Email"]" Variant="Variant.Outlined"
                        Margin="Margin.Dense" />
                </MudItem>
            }
            <MudItem Class="mt-n4" xs="@(IsFriendEdition ? 12 : 6)">
                <MudTextField ShrinkLabel @bind-Value="_workingEmployee.PhoneNumber" Label="@(IsFriendEdition ? Loc["Phone Number"] : BizLoc["Personal Phone"])" Variant="Variant.Outlined"
                    Margin="Margin.Dense" />
            </MudItem>
            <MudItem Class="mt-n4" xs="12">
                <MudTextField ShrinkLabel @bind-Value="_workingEmployee.Address" Label="@Loc["Address"]" Lines="2" Variant="Variant.Outlined"
                    Margin="Margin.Dense" />
            </MudItem>

            @if (!IsFriendEdition)
            {
                <MudItem Class="mt-n4" xs="6">
                    <MudTextField ShrinkLabel @bind-Value="_workingEmployee.EmergencyContact" Label="@BizLoc["Emergency Contact Name"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem Class="mt-n4" xs="6">
                    <MudTextField ShrinkLabel @bind-Value="_workingEmployee.EmergencyContactPhone" Label="@BizLoc["Emergency Contact Phone"]"
                                  Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            }
            
        </MudGrid>
        }

    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Loc["Close"]</MudButton>
        @if (!_workingEmployee.IsSuspended)
        {
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@Loc["Save"]</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Employee Employee { get; set; } = default!;

    private Employee _workingEmployee = new();
    private string? _avatarBase64;
    private string? _signatureBase64;
    private string? _originalSignaturePath;
    private string? _profileColor;
    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";
    private string TeamName = "";

    protected override void OnInitialized()
    {
        _workingEmployee = Employee.DeepClone() ?? new Employee();
        TeamName = Loc["None"].Value;
        if (!string.IsNullOrEmpty(_workingEmployee.AvatarFile))
        {
            _avatarBase64 = $"/spokesapi/Media/Avatar/{_workingEmployee.Id}?v={_workingEmployee.AvatarVersion}";
        }
        else
        {
            _avatarBase64 = _workingEmployee.AvatarBase64;
        }

        _signatureBase64 = _workingEmployee.SignatureImageBase64;
        _originalSignaturePath = _workingEmployee.SignatureImageBase64;
        _profileColor = _workingEmployee.ProfileColor;

        if (!string.IsNullOrEmpty(_workingEmployee.TeamId))
        {
            var team = Db.Teams.GetById(_workingEmployee.TeamId);
            if (team != null)
            {
                TeamName = team.Name;
            }
        }
    }

    private async Task HandleAvatarApiUploaded(List<ApiFileUpload.UploadResult> results)
    {
        var result = results.FirstOrDefault();
        if (result == null) return;

        try
        {
            var parameters = new DialogParameters<ImageCropDialog>
            {
                { x => x.ImageBase64, FileUrls.SignUrl(result.FilePath) },
                { x => x.TargetWidth, 400 }
            };

            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
            var dialog = await DialogService.ShowAsync<ImageCropDialog>(Loc["Crop Avatar"].Value, parameters, options);
            var dialogResult = await dialog.Result;

            if (dialogResult is { Canceled: false, Data: string croppedBase64 })
            {
                _avatarBase64 = croppedBase64;
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Error processing image: {0}"].Value, ex.Message), Severity.Error);
        }
    }

    private void RemoveAvatar()
    {
        _avatarBase64 = null;
    }

    private async Task HandleSignatureApiUploaded(List<ApiFileUpload.UploadResult> results)
    {
        var result = results.FirstOrDefault();
        if (result == null) return;

        if (!string.IsNullOrWhiteSpace(_signatureBase64) &&
            !string.Equals(_signatureBase64, _originalSignaturePath, StringComparison.OrdinalIgnoreCase) &&
            !string.Equals(_signatureBase64, result.FilePath, StringComparison.OrdinalIgnoreCase) &&
            _signatureBase64.StartsWith("/spokesapi/files/", StringComparison.OrdinalIgnoreCase))
        {
            await FileService.DeleteAsync(_signatureBase64);
        }

        _signatureBase64 = result.FilePath;
        StateHasChanged();
    }

    private void RemoveSignature()
    {
        _signatureBase64 = null;
    }

    private async Task Submit()
    {
        var target = Db.Employees.GetById(_workingEmployee.Id) ?? Employee;

        if (!string.IsNullOrEmpty(_avatarBase64) && _avatarBase64.StartsWith("data:image"))
        {
            try
            {
                var base64Data = _avatarBase64.Substring(_avatarBase64.IndexOf(",") + 1);
                var bytes = Convert.FromBase64String(base64Data);
                var empPath = Path.Combine(Config["DataPath"] ?? "Data", "Employees", target.Id);
                if (!Directory.Exists(empPath)) Directory.CreateDirectory(empPath);
                var filePath = Path.Combine(empPath, "avatar.png");
                System.IO.File.WriteAllBytes(filePath, bytes);
                
                target.AvatarFile = "avatar.png";
                target.AvatarBase64 = null;
                target.AvatarVersion++;
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(Loc["Error saving avatar: {0}"].Value, ex.Message), Severity.Error);
            }
        }
        else if (string.IsNullOrEmpty(_avatarBase64))
        {
            target.AvatarFile = null;
            target.AvatarBase64 = null;
            target.AvatarVersion++;
            
            var filePath = Path.Combine(Config["DataPath"] ?? "Data", "Employees", target.Id, "avatar.png");
            if (System.IO.File.Exists(filePath)) System.IO.File.Delete(filePath);
        }

        if (!string.IsNullOrWhiteSpace(_originalSignaturePath) &&
            !string.Equals(_originalSignaturePath, _signatureBase64, StringComparison.OrdinalIgnoreCase) &&
            _originalSignaturePath.StartsWith("/spokesapi/files/", StringComparison.OrdinalIgnoreCase))
        {
            await FileService.DeleteAsync(_originalSignaturePath);
        }

        ApplyProfileChanges(target);
        target.SignatureImageBase64 = _signatureBase64;
        target.ProfileColor = _profileColor;

        Db.Employees.Save(target);

        if (!ReferenceEquals(target, Employee))
        {
            ApplyProfileChanges(Employee);
            Employee.AvatarFile = target.AvatarFile;
            Employee.AvatarBase64 = target.AvatarBase64;
            Employee.AvatarVersion = target.AvatarVersion;
            Employee.SignatureImageBase64 = target.SignatureImageBase64;
            Employee.ProfileColor = target.ProfileColor;
        }

        MudDialog.Close(DialogResult.Ok(target));
    }

    private void ApplyProfileChanges(Employee destination)
    {
        if (IsFriendEdition)
        {
            destination.FirstName = _workingEmployee.FirstName;
            destination.LastName = _workingEmployee.LastName;
            destination.Email = _workingEmployee.Email;
        }

        destination.IsEmailPublic = _workingEmployee.IsEmailPublic;
        destination.PersonalEmail = _workingEmployee.PersonalEmail;
        destination.PhoneNumber = _workingEmployee.PhoneNumber;
        destination.Address = _workingEmployee.Address;
        destination.EmergencyContact = _workingEmployee.EmergencyContact;
        destination.EmergencyContactPhone = _workingEmployee.EmergencyContactPhone;
    }

    private async Task Close()
    {
        if (!string.IsNullOrWhiteSpace(_signatureBase64) &&
            !string.Equals(_signatureBase64, _originalSignaturePath, StringComparison.OrdinalIgnoreCase) &&
            _signatureBase64.StartsWith("/spokesapi/files/", StringComparison.OrdinalIgnoreCase))
        {
            await FileService.DeleteAsync(_signatureBase64);
        }

        MudDialog.Cancel();
    }
}


