<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudGrid>
                <MudItem xs="12">
                    <MudText Typo="Typo.h6">@ProjectName</MudText>
                    <MudText Typo="Typo.subtitle1">@TaskName</MudText>
                </MudItem>

                <MudItem xs="12">
                    <MudSelect T="string" @bind-Value="selectedEmployeeId" Label="Assign To" Required="true">
                        @foreach (var emp in Members)
                        {
                            <MudSelectItem Value="@emp.Id">@emp.FullName</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>

                <MudItem xs="6">
                    <MudNumericField @bind-Value="hours" Label="Hours" Min="0.5M" Step="0.5M" Max="40M" />
                </MudItem>

                <MudItem xs="12">
                    <MudTextField @bind-Value="note" Label="Note (Specific instructions)" Lines="2" />
                </MudItem>
            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
            Disabled="@(string.IsNullOrEmpty(selectedEmployeeId) || hours <= 0)">Allocate</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] private IMudDialogInstance MudDialog { get; set; } = default!;

    [Parameter] public List<Employee> Members { get; set; } = [];
    [Parameter] public string ProjectName { get; set; } = "";
    [Parameter] public string TaskName { get; set; } = "";

    private MudForm form = default!;
    private bool success;

    private string selectedEmployeeId = "";
    private decimal hours = 4.0m;
    private string note = "";

    private void Cancel() => MudDialog.Cancel();

    private void Submit() =>
        MudDialog.Close(DialogResult.Ok(new AllocationResult
        {
            EmployeeId = selectedEmployeeId,
            Hours = hours,
            Note = note
        }));
}

