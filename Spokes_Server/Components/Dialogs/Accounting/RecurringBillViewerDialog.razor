@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Components.Dialogs.Common
@using Spokes_Server.Components.Shared
@inject Database Db
@inject IAccountingService AccountingService
@inject UserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject FileUrlSigner FileUrls
@inject IStringLocalizer<BusinessResources> BizLoc
@inject IStringLocalizer<AppResources> Loc

<MudDialog>
    <DialogContent>
        <MudGrid>
            <!-- Left Side: Bill Info & Payments -->
            <MudItem xs="12" md="@(string.IsNullOrEmpty(Record.AttachmentPath) ? 12 : 6)">
                <!-- Header card -->
                <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-3">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                        <div>
                            <MudText Typo="Typo.h6">@Expense.Name</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">
                                @(!string.IsNullOrWhiteSpace(Expense.Supplier) ? Expense.Supplier : BizLoc["No Supplier"].Value)
                            </MudText>
                        </div>
                        <div class="d-flex align-center gap-1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Tertiary">@Expense.Frequency</MudChip>
                            @if (Record.Status == BillStatus.WrittenOff)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@BizLoc["Written Off"]</MudChip>
                            }
                            else if (Record.IsPaid || Record.BalanceDue <= 0)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success">@BizLoc["Paid"]</MudChip>
                            }
                            else
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Warning">@BizLoc["Pending"]</MudChip>
                            }
                        </div>
                    </div>
                </MudPaper>

                <!-- Billing & Payment Details -->
                <MudGrid Spacing="2" Class="mb-3">
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Billing Date / Date Received"]</MudText>
                        <MudText Typo="Typo.body1"><b>@Record.Date.ToShortDateString()</b></MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Due Date"]</MudText>
                        <MudText Typo="Typo.body1"><b>@(Record.DueDate?.ToShortDateString() ?? "-")</b></MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Total Amount"]</MudText>
                        <MudText Typo="Typo.body1" Color="Color.Primary"><b>@Record.Amount.ToString("C2")</b></MudText>
                    </MudItem>
                    <MudItem xs="6">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Date Paid"]</MudText>
                        <MudText Typo="Typo.body1"><b>@(Record.DatePaid?.ToShortDateString() ?? "-")</b></MudText>
                    </MudItem>
                </MudGrid>

                <!-- Payments Recorded -->
                <MudDivider Class="my-3" />
                <div class="d-flex align-center justify-space-between flex-wrap gap-2 mb-2">
                    <MudText Typo="Typo.subtitle2">@BizLoc["Payments Recorded"] (@Record.AmountPaid.ToString("C2"))</MudText>
                    <div class="d-flex align-center gap-2">
                        @if (Record.BalanceDue > 0)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Warning">
                                <b>@BizLoc["Balance Due"]: @Record.BalanceDue.ToString("C2")</b>
                            </MudText>
                            @if (_canManageBills)
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning"
                                           StartIcon="@Icons.Material.Filled.Balance" OnClick="CloseRecurringBalance">
                                    @BizLoc["Close Balance"]
                                </MudButton>
                            }
                        }
                    </div>
                </div>

                @if (Record.Payments.Any())
                {
                    <MudTable Items="@Record.Payments" Dense="true" Elevation="0" Outlined="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>@BizLoc["Date"]</MudTh>
                            <MudTh>@BizLoc["Amount"]</MudTh>
                            <MudTh>@BizLoc["Method"]</MudTh>
                            <MudTh>@BizLoc["Reference"]</MudTh>
                        </HeaderContent>
                        <RowTemplate Context="p">
                            <MudTd>@p.Date.ToShortDateString()</MudTd>
                            <MudTd>@p.Amount.ToString("C2")</MudTd>
                            <MudTd>@(!string.IsNullOrEmpty(p.Method) ? p.Method : "-")</MudTd>
                            <MudTd>@(!string.IsNullOrEmpty(p.Reference) ? p.Reference : "-")</MudTd>
                        </RowTemplate>
                    </MudTable>
                }
                else if (Record.DatePaid.HasValue && !Record.HasWriteOffs)
                {
                    <MudText Typo="Typo.body2" Class="text-muted mb-3">
                        @string.Format(BizLoc["Marked as paid on {0} for {1}."].Value, Record.DatePaid.Value.ToShortDateString(), Record.Amount.ToString("C2"))
                    </MudText>
                }
                else
                {
                    <MudText Typo="Typo.caption" Class="text-muted mb-3 d-block">
                        @BizLoc["No payments recorded."]
                    </MudText>
                }

                @if (Record.WriteOffs.Any())
                {
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@BizLoc["Balance Write-Offs / Adjustments"] (@Record.AmountWrittenOff.ToString("C2"))</MudText>
                    <MudTable Items="@Record.WriteOffs" Dense="true" Elevation="0" Outlined="true" Class="mb-3">
                        <HeaderContent>
                            <MudTh>@BizLoc["Date"]</MudTh>
                            <MudTh>@BizLoc["Amount"]</MudTh>
                            <MudTh>@BizLoc["GL Account"]</MudTh>
                            <MudTh>@BizLoc["Reason"]</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate Context="wo">
                            <MudTd>@wo.Date.ToShortDateString()</MudTd>
                            <MudTd><span style="font-weight: 600; color: var(--mud-palette-warning);">@wo.Amount.ToString("C2")</span></MudTd>
                            <MudTd>@(string.IsNullOrWhiteSpace(wo.GlAccountCode) ? "5860" : wo.GlAccountCode)</MudTd>
                            <MudTd>@wo.Reason</MudTd>
                            <MudTd Style="text-align: right;">
                                @if (_canManageBills)
                                {
                                    <MudTooltip Text="@BizLoc["Reverse Write-Off"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Error" OnClick="@(() => ReverseRecurringWriteOff(wo))" />
                                    </MudTooltip>
                                }
                            </MudTd>
                        </RowTemplate>
                    </MudTable>
                }

                <!-- Attachment Details -->
                <MudDivider Class="my-3" />
                <MudText Typo="Typo.subtitle2" Class="mb-2">@BizLoc["Attached Invoice / Receipt"]</MudText>
                @if (!string.IsNullOrEmpty(Record.AttachmentPath))
                {
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudIcon Icon="@Icons.Material.Filled.AttachFile" Color="Color.Primary" />
                        <MudText Typo="Typo.body2">
                            @(!string.IsNullOrEmpty(Record.AttachmentName) ? Record.AttachmentName : BizLoc["Attached Invoice"].Value)
                        </MudText>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.OpenInNew"
                                   Href="@FileUrls.SignUrl(Record.AttachmentPath)" Target="_blank">
                            @BizLoc["Open in New Tab"]
                        </MudButton>
                    </div>
                }
                else
                {
                    <div class="d-flex align-center gap-2 flex-wrap">
                        <MudText Typo="Typo.caption" Class="text-muted">@BizLoc["No attachment uploaded."]</MudText>
                        <ApiFileUpload Category="recurringcosts" ContextId="@Expense.Id" MaximumFileCount="1"
                                       OnUploadCompleted="HandleUploadCompleted"
                                       OnUploadError='(e) => Snackbar.Add($"Upload failed: {e}", Severity.Error)'>
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    @BizLoc["Upload Attachment"]
                                </MudButton>
                            </CustomContent>
                        </ApiFileUpload>
                    </div>
                }

                <!-- Profile Notes -->
                @if (!string.IsNullOrWhiteSpace(Expense.Description))
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2">@BizLoc["Profile Notes"]</MudText>
                    <MudText Typo="Typo.body2" Class="text-muted">@Expense.Description</MudText>
                }
            </MudItem>

            <!-- Right Side: PDF Preview -->
            @if (!string.IsNullOrEmpty(Record.AttachmentPath))
            {
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2" Style="height: 100%; min-height: 500px;">
                        <iframe src="@FileUrls.SignUrl(Record.AttachmentPath)" style="width:100%; height:100%; min-height: 500px; border:none;"></iframe>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Settings"
                   OnClick="OpenProfileEditor">
            @BizLoc["Manage Recurring Profile"]
        </MudButton>
        <MudSpacer />
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Close">@Loc["Close"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public RecurringExpense Expense { get; set; } = default!;
    [Parameter] public RecurringBillRecord Record { get; set; } = default!;

    private bool _canManageBills;

    protected override async Task OnInitializedAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        _canManageBills = emp != null && emp.HasEffectivePermission(
            Expense.IsEstimate ? AppPermissions.Finance.AccessAccounting : AppPermissions.Purchases.ManageBills,
            allowSuspended: false);
    }

    private void Close() => MudDialog.Close(DialogResult.Ok(Expense));

    private async Task CloseRecurringBalance()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.HasEffectivePermission(
            Expense.IsEstimate ? AppPermissions.Finance.AccessAccounting : AppPermissions.Purchases.ManageBills,
            allowSuspended: false))
        {
            return;
        }

        var parameters = new DialogParameters<WriteOffBalanceDialog>
        {
            { x => x.DocumentTypeLabel, Expense.Frequency == RecurringExpenseFrequency.OneTime ? BizLoc["One-Time"].Value : BizLoc["Recurring"].Value },
            { x => x.DocumentNumber, Expense.Name },
            { x => x.PartyLabel, BizLoc["Supplier"].Value },
            { x => x.PartyName, string.IsNullOrWhiteSpace(Expense.Supplier) ? Expense.Name : Expense.Supplier },
            { x => x.TotalAmount, Record.Amount },
            { x => x.AmountPaid, Record.AmountPaid },
            { x => x.RemainingBalance, Record.BalanceDue },
            { x => x.IsReceivable, false }
        };

        var dialog = await DialogService.ShowAsync<WriteOffBalanceDialog>(
            BizLoc["Close / Write Off Balance"].Value,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BalanceWriteOff writeOff })
        {
            try
            {
                emp = await UserService.GetEmployeeAsync();
                if (emp == null) return;
                var userName = emp.FullName ?? emp.Email ?? "User";
                var liveExpense = Db.RecurringExpenses.GetById(Expense.Id) ?? Expense;
                var liveRecord = liveExpense.History.FirstOrDefault(h => h.Id == Record.Id) ?? Record;
                AccountingService.RecordRecurringBillWriteOff(liveExpense, liveRecord, writeOff, userName, emp);
                Expense = liveExpense.DeepClone() ?? liveExpense;
                Record = Expense.History.FirstOrDefault(h => h.Id == Record.Id) ?? liveRecord;
                Snackbar.Add(string.Format(BizLoc["Closed balance of {0} without creating a bank transaction."].Value, writeOff.Amount.ToString("C2")), Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
    }

    private async Task ReverseRecurringWriteOff(BalanceWriteOff writeOff)
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.HasEffectivePermission(
            Expense.IsEstimate ? AppPermissions.Finance.AccessAccounting : AppPermissions.Purchases.ManageBills,
            allowSuspended: false))
        {
            return;
        }

        var confirmParams = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(BizLoc["Are you sure you want to reverse the balance write-off of {0} recorded on {1}? This will reopen the balance and remove its write-off journal entry."].Value, writeOff.Amount.ToString("C2"), writeOff.Date.ToShortDateString()) },
            { x => x.ButtonText, BizLoc["Reverse Write-Off"].Value },
            { x => x.Color, Color.Error },
            { x => x.ShowReasonInput, true },
            { x => x.ReasonRequired, true },
            { x => x.ReasonLabel, BizLoc["Reason for reversing write-off"].Value },
            { x => x.ReasonPlaceholder, BizLoc["Explain why this balance write-off is being reversed..."].Value }
        };

        var confirmDialog = await DialogService.ShowAsync<ConfirmDialog>(BizLoc["Reverse Write-Off"].Value, confirmParams, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var confirmResult = await confirmDialog.Result;

        if (confirmResult is { Canceled: false } && !string.IsNullOrWhiteSpace(confirmResult.Data as string))
        {
            var reason = (confirmResult.Data as string)?.Trim();
            try
            {
                emp = await UserService.GetEmployeeAsync();
                if (emp == null) return;
                var userName = emp.FullName ?? emp.Email ?? "User";
                var liveExpense = Db.RecurringExpenses.GetById(Expense.Id) ?? Expense;
                var liveRecord = liveExpense.History.FirstOrDefault(h => h.Id == Record.Id) ?? Record;
                AccountingService.DeleteRecurringBillWriteOff(liveExpense, liveRecord, writeOff.Id, userName, reason, emp);
                Expense = liveExpense.DeepClone() ?? liveExpense;
                Record = Expense.History.FirstOrDefault(h => h.Id == Record.Id) ?? liveRecord;
                Snackbar.Add(BizLoc["Balance write-off reversed successfully."], Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
    }

    private async Task OpenProfileEditor()
    {
        var parameters = new DialogParameters<RecurringExpenseDialog>
        {
            { x => x.Expense, Expense },
            { x => x.IsNew, false },
            { x => x.ActiveTabIndex, 0 }
        };
        var dialog = await DialogService.ShowAsync<RecurringExpenseDialog>(
            $"{Expense.Name}", parameters, new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true
            });
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is RecurringExpense updated)
        {
            Db.RecurringExpenses.Save(updated);
            Expense = updated;
            var refreshedRecord = Expense.History.FirstOrDefault(h => h.Id == Record.Id);
            if (refreshedRecord != null)
            {
                Record = refreshedRecord;
            }
            StateHasChanged();
        }
    }

    private void HandleUploadCompleted(List<ApiFileUpload.UploadResult> results)
    {
        var res = results.FirstOrDefault();
        if (res == null) return;
        var filePath = res.FilePath.StartsWith("/spokesapi/files/") ? res.FilePath : $"/spokesapi/files/download/{res.FilePath}";
        Record.AttachmentPath = filePath;
        Record.AttachmentName = res.FileName;
        Db.RecurringExpenses.Save(Expense);
        Snackbar.Add(BizLoc["Attachment uploaded successfully"], Severity.Success);
        StateHasChanged();
    }
}
