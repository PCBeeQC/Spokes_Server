@using Spokes_Server.Aggregate
@using Spokes_Server.Components.Dialogs.Communication.Email
@using Spokes_Server.Core.Configuration
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Services.Accounting
@inject Database Db
@inject CompanyBillInboxService BillInboxService
@inject UserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject IStringLocalizer<BusinessResources> BizLoc
@inject IStringLocalizer<AppResources> Loc

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3 text-muted">
            @BizLoc["Configure the central company-wide billing mailbox by selecting an Email Account (Real Inbox) and optional Virtual Inbox filter. Incoming invoices sent to this mailbox are monitored and automatically extracted into draft bills."]
        </MudText>

        <MudForm @ref="_form">
            <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" Class="pt-3">
                <!-- Tab 1: Mailbox Binding -->
                <MudTabPanel Text="@BizLoc["Mailbox"]" Icon="@Icons.Material.Filled.Email">
                    <MudGrid>
                        <!-- Master Enable -->
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.Enabled" Color="Color.Primary" Label="@BizLoc["Enable Company Billing Inbox Automated Ingestion"]" />
                        </MudItem>

                        <!-- Real Inbox Selection -->
                        <MudItem xs="12">
                            <div class="d-flex align-center gap-2 flex-wrap">
                                <div class="flex-grow-1" style="min-width: 240px;">
                                    <MudSelect T="string"
                                               Value="Settings.AccountId"
                                               ValueChanged="OnAccountIdChanged"
                                               Label="@BizLoc["Real Inbox (Email Account)"]"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               HelperText="@BizLoc["Select the IMAP mailbox to monitor for incoming supplier bills"]">
                                        <MudSelectItem Value="@string.Empty">@BizLoc["-- Select Real Inbox --"]</MudSelectItem>
                                        @foreach (var acc in _accounts)
                                        {
                                            <MudSelectItem Value="@acc.Id">
                                                @(string.IsNullOrWhiteSpace(acc.Name) ? acc.EmailAddress : $"{acc.Name} ({acc.EmailAddress})")
                                            </MudSelectItem>
                                        }
                                    </MudSelect>
                                </div>
                                @if (_canManageServerMailboxes)
                                {
                                    <MudButton Variant="Variant.Outlined"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="CreateNewRealInboxAsync">
                                        @BizLoc["New Real Inbox"]
                                    </MudButton>
                                    @if (!string.IsNullOrWhiteSpace(Settings.AccountId))
                                    {
                                        <MudButton Variant="Variant.Outlined"
                                                   Color="Color.Default"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Edit"
                                                   OnClick="EditSelectedRealInboxAsync">
                                            @BizLoc["Edit Real Inbox"]
                                        </MudButton>
                                    }
                                }
                            </div>
                        </MudItem>

                        <!-- Virtual Inbox Filter (Optional) -->
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       Value="Settings.InboxId"
                                       ValueChanged="OnInboxIdChanged"
                                       Label="@BizLoc["Virtual Inbox Filter (Optional)"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Disabled="@string.IsNullOrWhiteSpace(Settings.AccountId)"
                                       HelperText="@BizLoc["Optionally restrict bill ingestion to a specific Virtual Inbox alias on this account"]">
                                <MudSelectItem Value="@string.Empty">@BizLoc["All messages in Real Inbox"]</MudSelectItem>
                                @foreach (var inbox in AvailableVirtualInboxes)
                                {
                                    <MudSelectItem Value="@inbox.Id">
                                        @inbox.Name @(!string.IsNullOrWhiteSpace(inbox.PrimaryAddress) ? $"({inbox.PrimaryAddress})" : "")
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <!-- Outbound Sending Identity -->
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       @bind-Value="Settings.SendingIdentityId"
                                       Label="@BizLoc["Outbound Sending Identity"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Disabled="@string.IsNullOrWhiteSpace(Settings.AccountId)"
                                       HelperText="@BizLoc["Identity used when composing or replying to suppliers from the Bill Inbox"]">
                                <MudSelectItem Value="@string.Empty">@BizLoc["Use Inbox Default Identity"]</MudSelectItem>
                                @foreach (var identity in _identities)
                                {
                                    <MudSelectItem Value="@identity.Id">
                                        @(!string.IsNullOrWhiteSpace(identity.DisplayName) ? $"{identity.DisplayName} <{identity.EmailAddress}>" : identity.EmailAddress)
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.FolderToMonitor" Label="@BizLoc["Folder to Monitor"]" Placeholder="INBOX" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Settings.CheckIntervalMinutes" Label="@BizLoc["Sync Interval (Minutes)"]" Min="2" Max="1440" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>

                        <!-- Status Info & Force Redownload -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mud-background-gray">
                                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                    <div>
                                        @if (Settings.LastCheckedAt.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>@BizLoc["Last Checked:"]</b> @Settings.LastCheckedAt.Value.ToLocalTime().ToString("g")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>@BizLoc["Status:"]</b> @(Settings.LastCheckStatus ?? "OK")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>@BizLoc["Last Batch Ingested:"]</b> @Settings.LastIngestedCount message(s)
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>@BizLoc["Status:"]</b> @BizLoc["Mailbox has not been synced yet."]
                                            </MudText>
                                        }
                                    </div>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.CloudDownload"
                                               Disabled="@(_isRedownloading || !Settings.Enabled || string.IsNullOrWhiteSpace(Settings.AccountId))"
                                               OnClick="ForceRedownload">
                                        @if (_isRedownloading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                            <span>@BizLoc["Redownloading..."]</span>
                                        }
                                        else
                                        {
                                            <span>@BizLoc["Force Redownload Mailbox"]</span>
                                        }
                                    </MudButton>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                                    @BizLoc["Re-fetches recent emails directly from IMAP to repair missing email bodies, cache raw MIME, and re-run bill extraction."]
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Tab 2: Ingestion & Matching Rules -->
                <MudTabPanel Text="Ingestion Rules" Icon="@Icons.Material.Filled.Tune">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="Settings.DefaultCurrency" Label="Default Fallback Currency" HelperText="Used when invoices do not declare a currency">
                                <MudSelectItem Value="@("CAD")">CAD ($ - Canadian Dollar)</MudSelectItem>
                                <MudSelectItem Value="@("USD")">USD ($ - US Dollar)</MudSelectItem>
                                <MudSelectItem Value="@("EUR")">EUR (€ - Euro)</MudSelectItem>
                                <MudSelectItem Value="@("GBP")">GBP (£ - British Pound)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Settings.DuplicateDateWindowDays" Label="Duplicate Date Window (Days)" Min="5" Max="180"
                                            HelperText="Bills separated by more days without matching invoice numbers are treated as separate bills (Default: 20)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Settings.PoMatchToleranceAmount" Label="PO Match Amount Tolerance ($)" Min="0m" Max="50m" Format="N2"
                                            HelperText="Acceptable dollar difference when matching open POs without exact PO numbers (e.g. freight or penny rounding)" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.AutoMatchRecurringExpenses" Color="Color.Primary" Label="Auto-Link to Recurring Expenses" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                Automatically matches incoming supplier bills (Bell, Hydro, Rent, AWS) to active recurring expense templates.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.AllowDraftWithoutPdfForRecurring" Color="Color.Primary" Label="Allow Drafting Recurring Bills from Email Text (No PDF attached)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                If a recurring vendor sends an email notification with a balance due without an attached PDF, creates a draft bill immediately so it can be paid or queued, allowing the PDF to be uploaded later.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.EnableDebugLog" Color="Color.Primary" Label="Enable Decision Tree & Extraction Debug Log" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                Displays a step-by-step diagnostic decision tree panel at the bottom of the bill inbox showing why an email was processed, matched, or rejected, and how every field was extracted.
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Tab 3: Mailbox Hygiene & Notifications -->
                <MudTabPanel Text="Hygiene & Alerts" Icon="@Icons.Material.Filled.FolderSpecial">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.ProcessedFolderName" Label="Processed Folder Name on Server"
                                          Placeholder="Processed_Bills" HelperText="Target IMAP folder when a reviewer clicks 'Move to Processed'" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.DeletedFolderName" Label="Deleted Folder Name on Server"
                                          Placeholder="SPOKES_DELETED" HelperText="Target IMAP folder when an email is deleted (auto-created if missing)" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.NotifyOnNewBills" Color="Color.Primary" Label="In-App Ingestion Notifications" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                Sends in-app notifications to accounting personnel when new draft bills or unhandled documents arrive.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_ignoredSenderDomainsText" Label="Ignored Sender Domains / Spammers (Comma-separated)" Lines="2"
                                          Placeholder="@("marketing@, newsletter@, surveys@")" HelperText="Emails from these domains will be automatically marked as Dismissed" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="TestConnection" Disabled="@(_isTesting || string.IsNullOrWhiteSpace(Settings.AccountId))">
            @if (_isTesting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>@Loc["Testing..."]</span>
            }
            else
            {
                <span>@Loc["Test Connection"]</span>
            }
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">@BizLoc["Save Settings"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private CompanyBillInboxSettings Settings = new();
    private List<EmailAccount> _accounts = [];
    private List<EmailInbox> _inboxes = [];
    private List<EmailSendingIdentity> _identities = [];
    private bool _isTesting = false;
    private bool _isRedownloading = false;
    private Employee? _currentEmployee;
    private bool _canManageServerMailboxes =>
        _currentEmployee is { IsActive: true, IsBanned: false, IsSuspended: false } &&
        (_currentEmployee.IsAdmin || _currentEmployee.HasEffectivePermission(AppPermissions.Admin.ManageSettings));

    private string _ignoredSenderDomainsText = "";

    private IEnumerable<EmailInbox> AvailableVirtualInboxes =>
        string.IsNullOrWhiteSpace(Settings.AccountId)
            ? []
            : _inboxes.Where(i => string.Equals(i.AccountId, Settings.AccountId, StringComparison.OrdinalIgnoreCase));

    protected override async Task OnInitializedAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.IsActive || emp.IsBanned || emp.IsSuspended || !emp.HasEffectivePermission(AppPermissions.Admin.ManageSettings))
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Error);
            MudDialog.Cancel();
            return;
        }

        _currentEmployee = emp;
        ReloadEmailEntities();

        var current = BillInboxService.GetSettings();
        Settings = new CompanyBillInboxSettings
        {
            Enabled = current.Enabled,
            AccountId = current.AccountId,
            InboxId = current.InboxId,
            SendingIdentityId = current.SendingIdentityId,
            EmailAddress = current.EmailAddress,
            DisplayName = current.DisplayName,
            FolderToMonitor = current.FolderToMonitor,
            CheckIntervalMinutes = current.CheckIntervalMinutes,
            DefaultCurrency = current.DefaultCurrency,
            DuplicateDateWindowDays = current.DuplicateDateWindowDays,
            PoMatchToleranceAmount = current.PoMatchToleranceAmount,
            AutoMatchRecurringExpenses = current.AutoMatchRecurringExpenses,
            AllowDraftWithoutPdfForRecurring = current.AllowDraftWithoutPdfForRecurring,
            EnableDebugLog = current.EnableDebugLog,
            StatementKeywords = [.. current.StatementKeywords],
            ReceiptKeywords = [.. current.ReceiptKeywords],
            CreditNoteKeywords = [.. current.CreditNoteKeywords],
            IgnoredSenderDomains = [.. current.IgnoredSenderDomains],
            ProcessedFolderName = current.ProcessedFolderName,
            DeletedFolderName = current.DeletedFolderName,
            NotifyOnNewBills = current.NotifyOnNewBills,
            LastCheckedAt = current.LastCheckedAt,
            LastCheckStatus = current.LastCheckStatus,
            LastIngestedCount = current.LastIngestedCount
        };

        _ignoredSenderDomainsText = string.Join(", ", Settings.IgnoredSenderDomains);
    }

    private void ReloadEmailEntities()
    {
        _accounts = Db.EmailAccounts.GetAll().Where(a => a.IsServerManaged && !a.IsArchived).OrderBy(a => a.Name).ToList();
        _inboxes = Db.EmailInboxes.GetAll().Where(i => i.IsServerManaged).OrderBy(i => i.SortOrder).ThenBy(i => i.Name).ToList();
        _identities = Db.EmailSendingIdentities.GetAll().Where(i => i.IsServerManaged).OrderBy(i => i.DisplayName).ThenBy(i => i.EmailAddress).ToList();
    }

    private void OnAccountIdChanged(string accountId)
    {
        Settings.AccountId = accountId ?? string.Empty;
        if (!string.IsNullOrWhiteSpace(Settings.InboxId))
        {
            var inbox = _inboxes.FirstOrDefault(i => i.Id == Settings.InboxId);
            if (inbox == null || !string.Equals(inbox.AccountId, Settings.AccountId, StringComparison.OrdinalIgnoreCase))
            {
                Settings.InboxId = string.Empty;
            }
        }
    }

    private void OnInboxIdChanged(string inboxId)
    {
        Settings.InboxId = inboxId ?? string.Empty;
    }

    private async Task CreateNewRealInboxAsync()
    {
        var actor = await UserService.GetEmployeeAsync();
        if (actor is not { IsActive: true, IsBanned: false, IsSuspended: false } ||
            !(actor.IsAdmin || actor.HasEffectivePermission(AppPermissions.Admin.ManageSettings)))
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Error);
            return;
        }

        var newAccount = new EmailAccount
        {
            OwnerEmployeeId = actor.Id,
            IsServerManaged = true,
            Name = "Company Billing Inbox"
        };

        var parameters = new DialogParameters<EmailAccountDialog>
        {
            { x => x.Account, newAccount },
            { x => x.IsNew, true },
            { x => x.AllowCustomServer, actor.IsAdmin },
            { x => x.CurrentUserId, actor.Id },
            { x => x.IsAdmin, actor.IsAdmin }
        };

        var dialog = await DialogService.ShowAsync<EmailAccountDialog>(BizLoc["Add Real Inbox"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: EmailAccount createdAccount })
        {
            if (!createdAccount.IsServerManaged)
            {
                createdAccount.IsServerManaged = true;
                Db.EmailAccounts.Save(createdAccount);
            }
            ReloadEmailEntities();
            Settings.AccountId = createdAccount.Id;
            Settings.InboxId = string.Empty;
            if (!string.IsNullOrWhiteSpace(createdAccount.DefaultIdentityId))
            {
                Settings.SendingIdentityId = createdAccount.DefaultIdentityId;
            }
            StateHasChanged();
        }
    }

    private async Task EditSelectedRealInboxAsync()
    {
        var actor = await UserService.GetEmployeeAsync();
        if (actor is not { IsActive: true, IsBanned: false, IsSuspended: false } ||
            !(actor.IsAdmin || actor.HasEffectivePermission(AppPermissions.Admin.ManageSettings)))
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Error);
            return;
        }

        var account = Db.EmailAccounts.GetById(Settings.AccountId);
        if (account == null || !account.IsServerManaged)
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Error);
            return;
        }

        var parameters = new DialogParameters<EmailAccountDialog>
        {
            { x => x.Account, account },
            { x => x.IsNew, false },
            { x => x.AllowCustomServer, actor.IsAdmin },
            { x => x.CurrentUserId, actor.Id },
            { x => x.IsAdmin, actor.IsAdmin }
        };

        var dialog = await DialogService.ShowAsync<EmailAccountDialog>(BizLoc["Edit Real Inbox"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        });

        var result = await dialog.Result;
        if (result is { Canceled: false })
        {
            ReloadEmailEntities();
            StateHasChanged();
        }
    }

    private bool ValidateServerManagedSelections()
    {
        if (!string.IsNullOrWhiteSpace(Settings.AccountId))
        {
            var account = Db.EmailAccounts.GetById(Settings.AccountId.Trim());
            if (account == null || !account.IsServerManaged)
            {
                Snackbar.Add(Loc["Company Bill Inbox can only bind to a server-managed Email Account."].Value, Severity.Error);
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(Settings.InboxId))
        {
            var inbox = Db.EmailInboxes.GetById(Settings.InboxId.Trim());
            if (inbox == null || !inbox.IsServerManaged ||
                (!string.IsNullOrWhiteSpace(Settings.AccountId) &&
                 !string.Equals(inbox.AccountId, Settings.AccountId.Trim(), StringComparison.OrdinalIgnoreCase)))
            {
                Snackbar.Add(Loc["Company Bill Inbox can only bind to a server-managed Virtual Inbox on the selected account."].Value, Severity.Error);
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(Settings.SendingIdentityId))
        {
            var identity = Db.EmailSendingIdentities.GetById(Settings.SendingIdentityId.Trim());
            if (identity == null || !identity.IsServerManaged)
            {
                Snackbar.Add(Loc["Company Bill Inbox can only use a server-managed Sending Identity."].Value, Severity.Error);
                return false;
            }
        }

        return true;
    }

    private async Task TestConnection()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.IsActive || emp.IsBanned || emp.IsSuspended || !emp.HasEffectivePermission(AppPermissions.Admin.ManageSettings))
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Error);
            return;
        }

        if (!ValidateServerManagedSelections())
        {
            return;
        }

        _isTesting = true;
        try
        {
            var result = await BillInboxService.TestConnectionAsync(Settings, emp);
            if (result.Success)
            {
                Snackbar.Add(result.Message, Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Test failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task ForceRedownload()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.IsActive || emp.IsBanned || emp.IsSuspended || !emp.HasEffectivePermission(AppPermissions.Admin.ManageSettings))
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Error);
            return;
        }

        if (!ValidateServerManagedSelections())
        {
            return;
        }

        _isRedownloading = true;
        try
        {
            Settings.IgnoredSenderDomains = ParseList(_ignoredSenderDomainsText);
            BillInboxService.SaveSettings(Settings, emp);

            var (refreshed, newlyAdded) = await BillInboxService.ForceRedownloadAsync(actor: emp);
            Snackbar.Add($"Mailbox redownload complete: {refreshed} existing email(s) repaired/refreshed, {newlyAdded} new email(s) ingested.", Severity.Success);

            var current = BillInboxService.GetSettings();
            Settings.LastCheckedAt = current.LastCheckedAt;
            Settings.LastCheckStatus = current.LastCheckStatus;
            Settings.LastIngestedCount = current.LastIngestedCount;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Force redownload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRedownloading = false;
        }
    }

    private async Task Save()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.IsActive || emp.IsBanned || emp.IsSuspended || !emp.HasEffectivePermission(AppPermissions.Admin.ManageSettings))
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Error);
            return;
        }

        if (Settings.Enabled && string.IsNullOrWhiteSpace(Settings.AccountId))
        {
            Snackbar.Add(BizLoc["Please select a Real Inbox (Email Account) when automated ingestion is enabled."].Value, Severity.Warning);
            return;
        }

        if (!ValidateServerManagedSelections())
        {
            return;
        }

        Settings.IgnoredSenderDomains = ParseList(_ignoredSenderDomainsText);

        BillInboxService.SaveSettings(Settings, emp);
        Snackbar.Add(BizLoc["Company billing inbox settings saved"].Value, Severity.Success);
        MudDialog.Close(DialogResult.Ok(Settings));
    }

    private static List<string> ParseList(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return [];
        return input.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim().ToLowerInvariant())
            .Where(s => !string.IsNullOrEmpty(s))
            .Distinct()
            .ToList();
    }

    private void Cancel() => MudDialog.Cancel();
}
