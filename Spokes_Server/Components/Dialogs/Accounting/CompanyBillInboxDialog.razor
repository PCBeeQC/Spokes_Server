@using Spokes_Server.Aggregate
@using Spokes_Server.Core.Configuration
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Security
@inject Database Db
@inject CompanyBillInboxService BillInboxService
@inject EncryptionService EncryptionService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudText Typo="Typo.body2" Class="mb-3 text-muted">
            Configure the central company-wide billing mailbox (e.g. <code>factures@poly-robotics.com</code>).
            Incoming emails and invoices sent to this address are monitored and automatically extracted into draft bills.
        </MudText>

        <MudForm @ref="_form">
            <MudTabs Elevation="0" Rounded="true" ApplyEffectsToContainer="true" Class="pt-3">
                <!-- Tab 1: Server Connection -->
                <MudTabPanel Text="Connection" Icon="@Icons.Material.Filled.Email">
                    <MudGrid>
                        <!-- Master Enable -->
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.Enabled" Color="Color.Primary" Label="Enable Company Billing Inbox Automated Ingestion" />
                        </MudItem>

                        <!-- Core Identity -->
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.EmailAddress" Label="Billing Email Address" Required="true"
                                          Placeholder="factures@yourcompany.com" HelperText="Central address where suppliers send bills" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.DisplayName" Label="Display Name" Required="true"
                                          Placeholder="Facturation Poly-Robotics" HelperText="Name shown when replying to suppliers" />
                        </MudItem>

                        <!-- IMAP Settings -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Incoming Mail (IMAP)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.ImapHost" Label="IMAP Host" Placeholder="mail.yourcompany.com or imap.gmail.com" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudNumericField @bind-Value="Settings.ImapPort" Label="IMAP Port" />
                        </MudItem>
                        <MudItem xs="6" sm="3" Class="d-flex align-center">
                            <MudSwitch @bind-Value="Settings.ImapSsl" Color="Color.Primary" Label="Use SSL" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.ImapUsername" Label="IMAP Username" HelperText="Leave empty if same as email" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_plainImapPassword" Label="IMAP Password" InputType="InputType.Password"
                                          HelperText="@(!string.IsNullOrEmpty(Settings.EncryptedImapPassword) ? "Password is saved. Enter new password to change." : "Password required to authenticate.")" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.FolderToMonitor" Label="Folder to Monitor" Placeholder="INBOX" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Settings.CheckIntervalMinutes" Label="Sync Interval (Minutes)" Min="2" Max="1440" />
                        </MudItem>

                        <!-- SMTP Settings -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">Outgoing Mail (SMTP - For Inquiries & Replies)</MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.SmtpHost" Label="SMTP Host" Placeholder="mail.yourcompany.com or smtp.gmail.com" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudNumericField @bind-Value="Settings.SmtpPort" Label="SMTP Port" />
                        </MudItem>
                        <MudItem xs="6" sm="3" Class="d-flex align-center">
                            <MudSwitch @bind-Value="Settings.SmtpSsl" Color="Color.Primary" Label="Use SSL" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.SmtpUsername" Label="SMTP Username" HelperText="Leave empty if same as IMAP/Email" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="_plainSmtpPassword" Label="SMTP Password" InputType="InputType.Password"
                                          HelperText="@(!string.IsNullOrEmpty(Settings.EncryptedSmtpPassword) ? "Password is saved. Enter new password to change." : "Leave empty if same as IMAP password.")" />
                        </MudItem>

                        <!-- Status Info & Force Redownload -->
                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudPaper Elevation="0" Outlined="true" Class="pa-3 mud-background-gray">
                                <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                    <div>
                                        @if (Settings.LastCheckedAt.HasValue)
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>Last Checked:</b> @Settings.LastCheckedAt.Value.ToLocalTime().ToString("g")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>Status:</b> @(Settings.LastCheckStatus ?? "OK")
                                            </MudText>
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>Last Batch Ingested:</b> @Settings.LastIngestedCount message(s)
                                            </MudText>
                                        }
                                        else
                                        {
                                            <MudText Typo="Typo.caption" Class="d-block">
                                                <b>Status:</b> Mailbox has not been synced yet.
                                            </MudText>
                                        }
                                    </div>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.CloudDownload"
                                               Disabled="@(_isRedownloading || !Settings.Enabled)"
                                               OnClick="ForceRedownload">
                                        @if (_isRedownloading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-1" />
                                            <span>Redownloading...</span>
                                        }
                                        else
                                        {
                                            <span>Force Redownload Mailbox</span>
                                        }
                                    </MudButton>
                                </div>
                                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                                    Re-fetches recent emails directly from IMAP to repair missing email bodies, cache raw MIME, and re-run bill extraction.
                                </MudText>
                            </MudPaper>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Tab 2: Ingestion & Matching Rules -->
                <MudTabPanel Text="Ingestion Rules" Icon="@Icons.Material.Filled.Tune">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect @bind-Value="Settings.DefaultCurrency" Label="Default Fallback Currency" HelperText="Used when invoices do not declare a currency">
                                <MudSelectItem Value="@("CAD")">CAD ($ - Canadian Dollar)</MudSelectItem>
                                <MudSelectItem Value="@("USD")">USD ($ - US Dollar)</MudSelectItem>
                                <MudSelectItem Value="@("EUR")">EUR (€ - Euro)</MudSelectItem>
                                <MudSelectItem Value="@("GBP")">GBP (£ - British Pound)</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Settings.DuplicateDateWindowDays" Label="Duplicate Date Window (Days)" Min="5" Max="180"
                                            HelperText="Bills separated by more days without matching invoice numbers are treated as separate bills (Default: 20)" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudNumericField @bind-Value="Settings.PoMatchToleranceAmount" Label="PO Match Amount Tolerance ($)" Min="0m" Max="50m" Format="N2"
                                            HelperText="Acceptable dollar difference when matching open POs without exact PO numbers (e.g. freight or penny rounding)" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.AutoMatchRecurringExpenses" Color="Color.Primary" Label="Auto-Link to Recurring Expenses" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                Automatically matches incoming supplier bills (Bell, Hydro, Rent, AWS) to active recurring expense templates.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.AllowDraftWithoutPdfForRecurring" Color="Color.Primary" Label="Allow Drafting Recurring Bills from Email Text (No PDF attached)" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                If a recurring vendor sends an email notification with a balance due without an attached PDF, creates a draft bill immediately so it can be paid or queued, allowing the PDF to be uploaded later.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.EnableDebugLog" Color="Color.Primary" Label="Enable Decision Tree & Extraction Debug Log" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                Displays a step-by-step diagnostic decision tree panel at the bottom of the bill inbox showing why an email was processed, matched, or rejected, and how every field was extracted.
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <!-- Tab 3: Mailbox Hygiene & Notifications -->
                <MudTabPanel Text="Hygiene & Alerts" Icon="@Icons.Material.Filled.FolderSpecial">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.ProcessedFolderName" Label="Processed Folder Name on Server"
                                          Placeholder="Processed_Bills" HelperText="Target IMAP folder when a reviewer clicks 'Move to Processed'" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField @bind-Value="Settings.DeletedFolderName" Label="Deleted Folder Name on Server"
                                          Placeholder="SPOKES_DELETED" HelperText="Target IMAP folder when an email is deleted (auto-created if missing)" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Settings.NotifyOnNewBills" Color="Color.Primary" Label="In-App Ingestion Notifications" />
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block ml-2">
                                Sends in-app notifications to accounting personnel when new draft bills or unhandled documents arrive.
                            </MudText>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="_ignoredSenderDomainsText" Label="Ignored Sender Domains / Spammers (Comma-separated)" Lines="2"
                                          Placeholder="@("marketing@, newsletter@, surveys@")" HelperText="Emails from these domains will be automatically marked as Dismissed" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="TestConnection" Disabled="_isTesting">
            @if (_isTesting)
            {
                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                <span>Testing...</span>
            }
            else
            {
                <span>Test Connection</span>
            }
        </MudButton>
        <MudSpacer />
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Save">Save Settings</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private MudForm _form = default!;
    private CompanyBillInboxSettings Settings = new();
    private string _plainImapPassword = "";
    private string _plainSmtpPassword = "";
    private bool _isTesting = false;
    private bool _isRedownloading = false;

    private string _ignoredSenderDomainsText = "";

    protected override void OnInitialized()
    {
        var current = BillInboxService.GetSettings();
        // Clone
        Settings = new CompanyBillInboxSettings
        {
            Enabled = current.Enabled,
            EmailAddress = current.EmailAddress,
            DisplayName = current.DisplayName,
            ImapHost = current.ImapHost,
            ImapPort = current.ImapPort,
            ImapSsl = current.ImapSsl,
            ImapUsername = current.ImapUsername,
            EncryptedImapPassword = current.EncryptedImapPassword,
            FolderToMonitor = current.FolderToMonitor,
            CheckIntervalMinutes = current.CheckIntervalMinutes,
            SmtpHost = current.SmtpHost,
            SmtpPort = current.SmtpPort,
            SmtpSsl = current.SmtpSsl,
            SmtpUsername = current.SmtpUsername,
            EncryptedSmtpPassword = current.EncryptedSmtpPassword,
            DefaultCurrency = current.DefaultCurrency,
            DuplicateDateWindowDays = current.DuplicateDateWindowDays,
            PoMatchToleranceAmount = current.PoMatchToleranceAmount,
            AutoMatchRecurringExpenses = current.AutoMatchRecurringExpenses,
            AllowDraftWithoutPdfForRecurring = current.AllowDraftWithoutPdfForRecurring,
            EnableDebugLog = current.EnableDebugLog,
            StatementKeywords = [.. current.StatementKeywords],
            ReceiptKeywords = [.. current.ReceiptKeywords],
            CreditNoteKeywords = [.. current.CreditNoteKeywords],
            IgnoredSenderDomains = [.. current.IgnoredSenderDomains],
            ProcessedFolderName = current.ProcessedFolderName,
            DeletedFolderName = current.DeletedFolderName,
            NotifyOnNewBills = current.NotifyOnNewBills,
            LastCheckedAt = current.LastCheckedAt,
            LastCheckStatus = current.LastCheckStatus,
            LastIngestedCount = current.LastIngestedCount
        };

        _ignoredSenderDomainsText = string.Join(", ", Settings.IgnoredSenderDomains);
    }

    private async Task TestConnection()
    {
        _isTesting = true;
        try
        {
            var result = await BillInboxService.TestConnectionAsync(Settings, string.IsNullOrEmpty(_plainImapPassword) ? null : _plainImapPassword);
            if (result.Success)
            {
                Snackbar.Add(result.Message, Severity.Success);
            }
            else
            {
                Snackbar.Add(result.Message, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Test failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isTesting = false;
        }
    }

    private async Task ForceRedownload()
    {
        _isRedownloading = true;
        try
        {
            if (!string.IsNullOrEmpty(_plainImapPassword))
            {
                Settings.EncryptedImapPassword = EncryptionService.Encrypt(_plainImapPassword);
            }
            if (!string.IsNullOrEmpty(_plainSmtpPassword))
            {
                Settings.EncryptedSmtpPassword = EncryptionService.Encrypt(_plainSmtpPassword);
            }

            Settings.IgnoredSenderDomains = ParseList(_ignoredSenderDomainsText);

            BillInboxService.SaveSettings(Settings);

            var (refreshed, newlyAdded) = await BillInboxService.ForceRedownloadAsync();
            Snackbar.Add($"Mailbox redownload complete: {refreshed} existing email(s) repaired/refreshed, {newlyAdded} new email(s) ingested.", Severity.Success);

            var current = BillInboxService.GetSettings();
            Settings.LastCheckedAt = current.LastCheckedAt;
            Settings.LastCheckStatus = current.LastCheckStatus;
            Settings.LastIngestedCount = current.LastIngestedCount;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Force redownload failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isRedownloading = false;
        }
    }

    private void Save()
    {
        if (!string.IsNullOrEmpty(_plainImapPassword))
        {
            Settings.EncryptedImapPassword = EncryptionService.Encrypt(_plainImapPassword);
        }
        if (!string.IsNullOrEmpty(_plainSmtpPassword))
        {
            Settings.EncryptedSmtpPassword = EncryptionService.Encrypt(_plainSmtpPassword);
        }

        Settings.IgnoredSenderDomains = ParseList(_ignoredSenderDomainsText);

        BillInboxService.SaveSettings(Settings);
        Snackbar.Add("Company billing inbox settings saved", Severity.Success);
        MudDialog.Close(DialogResult.Ok(Settings));
    }

    private static List<string> ParseList(string input)
    {
        if (string.IsNullOrWhiteSpace(input)) return [];
        return input.Split(',', StringSplitOptions.RemoveEmptyEntries)
            .Select(s => s.Trim().ToLowerInvariant())
            .Where(s => !string.IsNullOrEmpty(s))
            .Distinct()
            .ToList();
    }

    private void Cancel() => MudDialog.Cancel();
}
