@using Spokes_Server.Core.Constants
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject Database Db
@inject UserService UserService

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">

                <MudTabPanel Text="Business Info">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="Supplier.ContactInfo.BusinessName" Label="Business / Company Name"
                                Required="true" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mt-2">Address</MudText>
                        </MudItem>

                        <MudItem xs="4">
                            <MudTextField @bind-Value="Supplier.ContactInfo.BusinessAddressNumber" Label="Number" />
                        </MudItem>
                        <MudItem xs="8">
                            <MudTextField @bind-Value="Supplier.ContactInfo.BusinessAddressStreet" Label="Street" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Supplier.ContactInfo.BusinessAddressCity" Label="City" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Supplier.ContactInfo.BusinessAddressState" Label="State / Province" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Supplier.ContactInfo.BusinessAddressCountry" Label="Country" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Supplier.ContactInfo.BusinessAddressZip" Label="Zip / Postal Code" />
                        </MudItem>

                        @if (_canReadAccounting)
                        {
                            <MudItem xs="12">
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.subtitle2">@BizLoc["Accounting Defaults"]</MudText>
                            </MudItem>

                            <MudItem xs="12" sm="6">
                                <GlAccountSelect @bind-Value="Supplier.ContactInfo.DefaultGlAccountCode"
                                                 Label="@BizLoc["Default Expense Category"]"
                                                 Placeholder="@BizLoc["Inherit Company Default"]"
                                                 Clearable="true" />
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Contact Persons">
                    <MudMenu Label="Add Contact" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" Disabled="@(!_canManage)" Class="mb-3">
                        <MudMenuItem OnClick="AddContact" Icon="@Icons.Material.Filled.PersonAdd">Create New</MudMenuItem>
                        @if (_canManagePublicContacts)
                        {
                            <MudMenuItem OnClick="AddFromPublic" Icon="@Icons.Material.Filled.Public">Import from Public Contacts</MudMenuItem>
                        }
                    </MudMenu>
                    
                    <MudTable Items="@Supplier.Contacts" Dense="true" Hover="true" Striped="true" Elevation="0" Outlined="true">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Role</MudTh>
                            <MudTh>Email</MudTh>
                            <MudTh>Phone</MudTh>
                            <MudTh>Primary</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd DataLabel="Name">@context.Prefix @context.Name</MudTd>
                            <MudTd DataLabel="Role">@context.Title</MudTd>
                            <MudTd DataLabel="Email">@context.Email</MudTd>
                            <MudTd DataLabel="Phone">@context.Phone</MudTd>
                            <MudTd DataLabel="Primary">
                                @if (context.IsPrimary)
                                {
                                    <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" Size="Size.Small" />
                                }
                            </MudTd>
                            <MudTd DataLabel="Actions">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small" Disabled="@(!_canManage)" OnClick="@(() => EditContact(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" Disabled="@(!_canManage)" OnClick="@(() => DeleteContact(context))" />
                            </MudTd>
                        </RowTemplate>
                        <NoRecordsContent>
                            <MudText>No contacts found. Please add one.</MudText>
                        </NoRecordsContent>
                    </MudTable>
                </MudTabPanel>

            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" Disabled="@(!_canManage)" OnClick="Submit">Save Supplier</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Supplier Supplier { get; set; } = new();

    private MudForm form = default!;
    private bool success;
    private bool _canManage;
    private bool _canManagePublicContacts;
    private bool _canReadAccounting;
    private string _initialDefaultGlAccountCode = string.Empty;
    private readonly List<(string CloneContactId, string PublicContactId)> _pendingPublicContactImports = [];

    protected override async Task OnInitializedAsync()
    {
        _initialDefaultGlAccountCode = Supplier.ContactInfo.DefaultGlAccountCode ?? string.Empty;
        var emp = await UserService.GetEmployeeAsync();
        _canManage = emp?.HasEffectivePermission(AppPermissions.AddressBook.Manage, allowSuspended: false) == true;
        _canManagePublicContacts = _canManage && emp?.HasEffectivePermission(AppPermissions.AddressBook.View, allowSuspended: false) == true;
        _canReadAccounting = emp?.IsEffectiveAdmin == true || emp?.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false) == true;
        if (!_canManage)
        {
            MudDialog.Cancel();
        }
    }

    private async Task<bool> AuthorizeManageAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        _canManage = emp?.HasEffectivePermission(AppPermissions.AddressBook.Manage, allowSuspended: false) == true;
        _canManagePublicContacts = _canManage && emp?.HasEffectivePermission(AppPermissions.AddressBook.View, allowSuspended: false) == true;
        _canReadAccounting = emp?.IsEffectiveAdmin == true || emp?.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false) == true;
        if (_canManage) return true;
        Snackbar.Add("You do not have permission to manage address book contacts.", Severity.Warning);
        StateHasChanged();
        return false;
    }

    private async Task<bool> AuthorizePublicContactsAsync()
    {
        if (!await AuthorizeManageAsync()) return false;
        if (_canManagePublicContacts) return true;
        Snackbar.Add("AddressBook.View and AddressBook.Manage permissions are required to import public contacts.", Severity.Warning);
        StateHasChanged();
        return false;
    }

    private async Task AddContact()
    {
        if (!await AuthorizeManageAsync()) return;
        var newContact = new ContactPerson();
        var dialog = await DialogService.ShowAsync<ContactPersonDialog>("Add Contact", new DialogParameters { ["Contact"] = newContact });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ContactPerson contact })
        {
            if (!await AuthorizeManageAsync()) return;
            if (Supplier.Contacts.Count == 0) contact.IsPrimary = true;
            
            if (contact.IsPrimary)
            {
                 foreach(var c in Supplier.Contacts) c.IsPrimary = false;
            }

            Supplier.Contacts.Add(contact);
        }
    }

    private async Task AddFromPublic()
    {
        if (!await AuthorizePublicContactsAsync()) return;
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<PublicContactPickerDialog>("Select Public Contacts", options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: List<ContactPerson> selectedContacts })
        {
            if (!await AuthorizePublicContactsAsync()) return;
            int addedCount = 0;
            foreach (var publicContact in selectedContacts)
            {
                var newContact = new ContactPerson
                {
                    Id = Guid.NewGuid().ToString(),
                    Name = publicContact.Name,
                    Prefix = publicContact.Prefix,
                    Title = publicContact.Title,
                    Email = publicContact.Email,
                    Phone = publicContact.Phone
                };

                if (Supplier.Contacts.Count == 0 && addedCount == 0)
                {
                    newContact.IsPrimary = true;
                }

                Supplier.Contacts.Add(newContact);
                if (!string.IsNullOrEmpty(publicContact.Id))
                {
                    _pendingPublicContactImports.Add((newContact.Id, publicContact.Id));
                }
                addedCount++;
            }

            if (addedCount > 0)
            {
                Snackbar.Add($"Imported {addedCount} contact(s) from Public Contacts", Severity.Success);
            }
        }
    }

    private async Task EditContact(ContactPerson contact)
    {
        if (!await AuthorizeManageAsync()) return;
        var copy = contact.DeepClone();

        var dialog = await DialogService.ShowAsync<ContactPersonDialog>("Edit Contact", new DialogParameters { ["Contact"] = copy });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ContactPerson updated })
        {
            if (!await AuthorizeManageAsync()) return;
            var index = Supplier.Contacts.IndexOf(contact);
            if (index != -1)
            {
                Supplier.Contacts[index] = updated;
            }
            
            if (updated.IsPrimary)
            {
                foreach(var c in Supplier.Contacts)
                {
                    if (c != updated) c.IsPrimary = false;
                }
            }
        }
    }

    private async Task DeleteContact(ContactPerson contact)
    {
        if (!await AuthorizeManageAsync()) return;
        Supplier.Contacts.Remove(contact);
    }

    private void Close() => MudDialog.Cancel();

    private async Task Submit()
    {
        if (!await AuthorizeManageAsync()) return;
        if (!_canReadAccounting)
        {
            Supplier.ContactInfo.DefaultGlAccountCode = _initialDefaultGlAccountCode;
        }
        await form.ValidateAsync();
        if (success)
        {
            if (_canManagePublicContacts)
            {
                foreach (var publicContactId in _pendingPublicContactImports
                    .Where(item => Supplier.Contacts.Any(c => string.Equals(c.Id, item.CloneContactId, StringComparison.OrdinalIgnoreCase)))
                    .Select(item => item.PublicContactId)
                    .Distinct(StringComparer.OrdinalIgnoreCase))
                {
                    Db.PublicContacts.Delete(publicContactId);
                }
            }
            _pendingPublicContactImports.Clear();
            MudDialog.Close(DialogResult.Ok(Supplier));
        }
    }
}
