    private async Task HandleBillApiUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (Bill.Status == BillStatus.Void) return;
        var emp = await UserService.GetEmployeeAsync();
        CanManageBills = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false);
        if (!CanManageBills)
        {
            Snackbar.Add("Active Purchases.ManageBills permission is required.", Severity.Error);
            StateHasChanged();
            return;
        }

        var result = results.FirstOrDefault();
        if (result != null)
        {
            if (!string.IsNullOrEmpty(Bill.AttachmentPath) && Bill.AttachmentPath != result.FilePath)
            {
                await FileService.DeleteAsync(Bill.AttachmentPath);
            }
            Bill.AttachmentPath = result.FilePath;
            Bill.AttachmentName = result.FileName;
            Snackbar.Add("File Uploaded", Severity.Success);

            // Attempt automated extraction from the uploaded invoice
            try
            {
                var safeName = Path.GetFileName(result.FilePath);
                using var stream = FileService.OpenRead(result.Category, result.ContextId, safeName);
                if (stream != null)
                {
                    var extracted = PdfInspectionService.Inspect(stream, result.FileName);
                    if (extracted != null)
                    {
                        bool autoFilled = false;
                        if (extracted.TotalAmount > 0 && Bill.Amount == 0)
                        {
                            Bill.Amount = extracted.TotalAmount;
                            autoFilled = true;
                        }
                        if (!string.IsNullOrWhiteSpace(extracted.InvoiceNumber))
                        {
                            Bill.InvoiceNumber = extracted.InvoiceNumber;
                            if (string.IsNullOrWhiteSpace(Bill.Description))
                            {
                                Bill.Description = $"Invoice {extracted.InvoiceNumber}";
                            }
                            autoFilled = true;
                        }
                        if (extracted.InvoiceDate.HasValue && !Date.HasValue)
                        {
                            Date = extracted.InvoiceDate.Value;
                            autoFilled = true;
                        }
                        if (extracted.DueDate.HasValue)
                        {
                            DueDate = extracted.DueDate.Value;
                            autoFilled = true;
                        }
                        if (extracted.SubTotal > 0 && Bill.SubTotal == 0) Bill.SubTotal = extracted.SubTotal;
                        if (extracted.TaxAmount > 0 && Bill.TaxAmount == 0) Bill.TaxAmount = extracted.TaxAmount;
                        if (extracted.TpsAmount > 0 && Bill.TpsAmount == 0) Bill.TpsAmount = extracted.TpsAmount;
                        if (extracted.TvqAmount > 0 && Bill.TvqAmount == 0) Bill.TvqAmount = extracted.TvqAmount;

                        if (Bill.Amount > 0 && Bill.SubTotal == 0 && Bill.TpsAmount == 0 && Bill.TvqAmount == 0)
                        {
                            RecalculateFromTotal(Bill.Amount);
                        }

                        if (!string.IsNullOrWhiteSpace(extracted.SupplierName) && string.IsNullOrWhiteSpace(Bill.SupplierName))
                        {
                            Bill.SupplierName = extracted.SupplierName;
                            autoFilled = true;
                        }

                        // Auto-match PO if not selected yet and caller has PO access
                        if (SelectedPO == null && _canViewPOs && CanManageBills)
                        {
                            var poMatch = PoMatchingEngine.FindMatch(extracted, null, actor: _currentEmployee);
                            if (poMatch.MatchedPo != null && IsPoAccessible(poMatch.MatchedPo))
                            {
                                OnPoSelected(poMatch.MatchedPo);
                                autoFilled = true;
                                Snackbar.Add($"Matched PO {poMatch.MatchedPo.PoNumber} ({poMatch.Reason})", Severity.Info);
                            }
                        }

                        // Auto-fill line items if extracted
                        if (!Bill.LineItems.Any() && extracted.LineItems.Count > 0)
                        {
                            foreach (var li in extracted.LineItems)
                            {
                                Bill.LineItems.Add(new BillLineItem
                                {
                                    Description = li.Description,
                                    Quantity = li.Quantity,
                                    UnitPrice = li.UnitPrice
                                });
                            }
                            autoFilled = true;
                        }

                        if (autoFilled)
                        {
                            Snackbar.Add("Auto-extracted invoice details from document", Severity.Success);
                        }
                    }
                }
            }
            catch
            {
                // Silently ignore non-fatal extraction failures
            }

            StateHasChanged();
        }
    }

    private async Task RecordPayment()
    {
        var emp = await UserService.GetEmployeeAsync();
        bool canManage = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false);
        bool canApprove = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ApproveBills, allowSuspended: false);
        if (!canManage)
        {
            Snackbar.Add("Active Purchases.ManageBills permission is required.", Severity.Error);
            return;
        }
        if ((_initialStatus == BillStatus.AwaitingApproval || Bill.Status == BillStatus.AwaitingApproval) && !canApprove)
        {
            Snackbar.Add("Purchases.ApproveBills permission is required before recording payment on an unapproved bill.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<RecordPaymentDialog>
        {
            { x => x.Message, $"Record payment for {Bill.Description}" },
            { x => x.MaxAmount, Bill.BalanceDue },
            { x => x.ExistingPayments, Bill.Payments }
        };
        var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Payment", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PaymentRecord payment)
        {
            emp = await UserService.GetEmployeeAsync();
            canManage = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false);
            canApprove = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ApproveBills, allowSuspended: false);
            if (!canManage || ((_initialStatus == BillStatus.AwaitingApproval || Bill.Status == BillStatus.AwaitingApproval) && !canApprove))
            {
                Snackbar.Add("Permissions changed or account suspended; payment was not added.", Severity.Error);
                return;
            }

            Bill.Payments.Add(payment);
            if (Bill.BalanceDue <= 0)
            {
                Bill.Status = BillStatus.Paid;
                Bill.DatePaid = payment.Date;
            }
            StateHasChanged();
        }
    }

    private async Task CloseBillBalance()
    {
        var emp = await UserService.GetEmployeeAsync();
        bool canManage = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false);
        bool canApprove = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ApproveBills, allowSuspended: false);
        if (!canManage)
        {
            Snackbar.Add("Active Purchases.ManageBills permission is required.", Severity.Error);
            return;
        }
        if ((_initialStatus == BillStatus.AwaitingApproval || Bill.Status == BillStatus.AwaitingApproval) && !canApprove)
        {
            Snackbar.Add("Purchases.ApproveBills permission is required before closing balance on an unapproved bill.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<WriteOffBalanceDialog>
        {
            { x => x.DocumentTypeLabel, BizLoc["Bill"].Value },
            { x => x.DocumentNumber, string.IsNullOrWhiteSpace(Bill.InvoiceNumber) ? Bill.Description : Bill.InvoiceNumber! },
            { x => x.PartyLabel, BizLoc["Supplier"].Value },
            { x => x.PartyName, Bill.SupplierName },
            { x => x.TotalAmount, Bill.Amount },
            { x => x.AmountPaid, Bill.AmountPaid },
            { x => x.RemainingBalance, Bill.BalanceDue },
            { x => x.IsReceivable, false }
        };

        var dialog = await DialogService.ShowAsync<WriteOffBalanceDialog>(
            BizLoc["Close / Write Off Balance"].Value,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BalanceWriteOff writeOff })
        {
            try
            {
                emp = await UserService.GetEmployeeAsync();
                if (emp == null) return;
                var userName = emp.FullName ?? emp.Email ?? "User";
                var liveBill = Db.Bills.GetById(Bill.Id) ?? Bill;
                AccountingService.RecordBillWriteOff(liveBill, writeOff, userName, emp);
                Bill.WriteOffs = liveBill.WriteOffs.DeepClone();
                Bill.Status = liveBill.Status;
                Bill.DatePaid = liveBill.DatePaid;
                Bill.History = liveBill.History.DeepClone();
                Snackbar.Add(string.Format(BizLoc["Closed balance of {0} without creating a bank transaction."].Value, writeOff.Amount.ToString("C2")), Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
    }

    private async Task ReverseBillWriteOff(BalanceWriteOff writeOff)
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
        {
            Snackbar.Add("Active Purchases.ManageBills permission is required.", Severity.Error);
            return;
        }

        var confirmParams = new DialogParameters<ConfirmDialog>
        {
            { x => x.ContentText, string.Format(BizLoc["Are you sure you want to reverse the balance write-off of {0} recorded on {1}? This will reopen the balance and remove its write-off journal entry."].Value, writeOff.Amount.ToString("C2"), writeOff.Date.ToShortDateString()) },
            { x => x.ButtonText, BizLoc["Reverse Write-Off"].Value },
            { x => x.Color, Color.Error },
            { x => x.ShowReasonInput, true },
            { x => x.ReasonRequired, true },
            { x => x.ReasonLabel, BizLoc["Reason for reversing write-off"].Value },
            { x => x.ReasonPlaceholder, BizLoc["Explain why this balance write-off is being reversed..."].Value }
        };

        var confirmDialog = await DialogService.ShowAsync<ConfirmDialog>(BizLoc["Reverse Write-Off"].Value, confirmParams, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var confirmResult = await confirmDialog.Result;

        if (confirmResult is { Canceled: false } && !string.IsNullOrWhiteSpace(confirmResult.Data as string))
        {
            var reason = (confirmResult.Data as string)?.Trim();
            try
            {
                emp = await UserService.GetEmployeeAsync();
                if (emp == null) return;
                var userName = emp.FullName ?? emp.Email ?? "User";
                var liveBill = Db.Bills.GetById(Bill.Id) ?? Bill;
                AccountingService.DeleteBillWriteOff(liveBill, writeOff.Id, userName, reason, emp);
                Bill.WriteOffs = liveBill.WriteOffs.DeepClone();
                Bill.Status = liveBill.Status;
                Bill.DatePaid = liveBill.DatePaid;
                Bill.History = liveBill.History.DeepClone();
                Snackbar.Add(BizLoc["Balance write-off reversed successfully."], Severity.Success);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
    }

