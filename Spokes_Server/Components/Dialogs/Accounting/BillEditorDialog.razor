@using System.IO
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Accounting.InvoiceExtraction
@using Spokes_Server.Core.Services.Storage
@inject Database Db
@inject ISnackbar Snackbar
@inject AuthenticationStateProvider AuthStateProvider
@inject UserService UserService
@inject IDialogService DialogService
@inject PdfInvoiceInspectionService PdfInspectionService
@inject SmartPoMatchingEngine PoMatchingEngine
@inject IFileService FileService
@inject IAccountingService AccountingService

<MudDialog>
    <DialogContent>
        <MudGrid>
            <!-- Left Side: Form -->
            <MudItem xs="12" md="@(string.IsNullOrEmpty(Bill.AttachmentPath) ? 12 : 6)">
                <MudForm>
                    <MudGrid>
                        @if (Bill.Status == BillStatus.Void)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2" Icon="@Icons.Material.Filled.Block">
                                    <div>
                                        <strong>VOIDED BILL</strong> &mdash; Voided on @(Bill.VoidedAt?.ToLocalTime().ToString("g") ?? "unknown date") by @(Bill.VoidedBy ?? "unknown").
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Bill.VoidReason))
                                    {
                                        <div class="mt-1">
                                            <b>Reason:</b> @Bill.VoidReason
                                        </div>
                                    }
                                </MudAlert>
                            </MudItem>
                        }

                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="PurchaseOrder" Label="Link to Purchase Order (Optional)" 
                                Value="@SelectedPO" ValueChanged="@OnPoSelected"
                                SearchFunc="@SearchPOs" ToStringFunc="@(p => p==null ? "" : $"{p.PoNumber} - {p.Supplier.BusinessName}")"
                                Clearable="true" AdornmentIcon="@Icons.Material.Filled.Link"
                                Disabled="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="RecurringExpense" Label="Link to Recurring Bill Profile (Optional)" 
                                Value="@SelectedRecurringExpense" ValueChanged="@OnRecurringExpenseSelected"
                                SearchFunc="@SearchRecurringExpenses" ToStringFunc="@(r => r==null ? "" : $"{r.Name} ({r.Supplier})")"
                                Clearable="true" AdornmentIcon="@Icons.Material.Filled.Repeat"
                                Disabled="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Bill.SupplierName" Label="Supplier Name" Required="true" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Bill.InvoiceNumber" Label="Invoice #" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Bill.Description" Label="Description" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudDatePicker @bind-Date="Date" Label="Date" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudDatePicker @bind-Date="DueDate" Label="Due Date" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal" Value="Bill.SubTotal" ValueChanged="@OnSubTotalChanged" Label="Subtotal (Before Tax)" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudNumericField T="decimal" Value="Bill.TpsAmount" ValueChanged="@OnTpsChanged" Label="TPS (5%)" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void || Bill.IsTaxExempt)" />
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudNumericField T="decimal" Value="Bill.TvqAmount" ValueChanged="@OnTvqChanged" Label="TVQ (9.975%)" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void || Bill.IsTaxExempt)" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudNumericField T="decimal" Value="Bill.Amount" ValueChanged="@OnTotalAmountChanged" Label="Total Amount" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                            @if (Bill.AmountPaid > 0)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Amount Paid: @Bill.AmountPaid.ToString("C2")</MudText>
                                <br />
                                <MudText Typo="Typo.caption" Color="Color.Warning"><b>Balance Due: @Bill.BalanceDue.ToString("C2")</b></MudText>
                            }
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudSelect T="string" Value="Bill.Status" ValueChanged="OnStatusChanged" Label="Status" Disabled="@(Bill.Status == BillStatus.Void)">
                                <MudSelectItem Value="@(BillStatus.AwaitingApproval)">Awaiting Approval</MudSelectItem>
                                @if (CanApproveBills || Bill.Status == BillStatus.Approved)
                                {
                                    <MudSelectItem Value="@(BillStatus.Approved)">Approved</MudSelectItem>
                                }
                                <MudSelectItem Value="@(BillStatus.Unpaid)">Unpaid</MudSelectItem>
                                <MudSelectItem Value="@(BillStatus.Paid)">Paid</MudSelectItem>
                                <MudSelectItem Value="@(BillStatus.Void)">Void</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Bill.GlAccountCode" Label="GL Account (Sage 50)" Placeholder="e.g. 5200" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudCheckBox T="bool" Value="Bill.IsTaxExempt" ValueChanged="@OnTaxExemptChanged" Label="Tax Exempt (0% TPS/TVQ)" Color="Color.Primary" Disabled="@(Bill.Status == BillStatus.Void)" Dense="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudCheckBox T="bool" @bind-Value="Bill.IsCreditNote" Label="Credit Note / Refund" Color="Color.Warning" Disabled="@(Bill.Status == BillStatus.Void)" Dense="true" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <div class="d-flex align-center justify-space-between">
                                <MudText Typo="Typo.subtitle2">Payments Recorded (@Bill.AmountPaid.ToString("C2"))</MudText>
                                @if (Bill.BalanceDue > 0 && Bill.Status != BillStatus.Void)
                                {
                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" OnClick="RecordPayment">Record Payment</MudButton>
                                }
                            </div>
                            @if (Bill.Payments.Any())
                            {
                                <MudTable Items="@Bill.Payments" Dense="true" Elevation="0" Outlined="true" Class="mt-2">
                                    <HeaderContent>
                                        <MudTh>Date</MudTh>
                                        <MudTh>Amount</MudTh>
                                        <MudTh>Method</MudTh>
                                        <MudTh>Reference</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="payment">
                                        <MudTd>@payment.Date.ToShortDateString()</MudTd>
                                        <MudTd>@payment.Amount.ToString("C2")</MudTd>
                                        <MudTd>@payment.Method</MudTd>
                                        <MudTd>@payment.Reference</MudTd>
                                        <MudTd>
                                            @if (Bill.Status != BillStatus.Void)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Bill.Payments.Remove(payment))" />
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else if (Bill.DatePaid.HasValue)
                            {
                                <MudText Typo="Typo.body2" Class="mt-2 text-muted">Legacy payment recorded on @Bill.DatePaid.Value.ToShortDateString() for @Bill.Amount.ToString("C2").</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="text-muted">No payments recorded yet.</MudText>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            <div class="d-flex align-center justify-space-between mt-4">
                                <MudText Typo="Typo.subtitle2">Line Items</MudText>
                                @if (Bill.Status != BillStatus.Void)
                                {
                                    @if (SelectedPO != null && !Bill.LineItems.Any())
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="AutoFillLineItems">Auto-fill from PO</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLineItem">Add Item</MudButton>
                                    }
                                }
                            </div>
                            
                            @if (Bill.LineItems.Any())
                            {
                                <MudTable Items="@Bill.LineItems" Dense="true" Hover="true" Elevation="0" Class="mt-2" Outlined="true">
                                    <HeaderContent>
                                        <MudTh>Description</MudTh>
                                        <MudTh>Qty</MudTh>
                                        <MudTh>Price</MudTh>
                                        <MudTh>Total</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="lineItem">
                                        <MudTd><MudTextField @bind-Value="lineItem.Description" Margin="Margin.Dense" Underline="false" ReadOnly="@(Bill.Status == BillStatus.Void)" /></MudTd>
                                        <MudTd><MudNumericField @bind-Value="lineItem.Quantity" Margin="Margin.Dense" Underline="false" ReadOnly="@(Bill.Status == BillStatus.Void)" /></MudTd>
                                        <MudTd><MudNumericField @bind-Value="lineItem.UnitPrice" Margin="Margin.Dense" Underline="false" ReadOnly="@(Bill.Status == BillStatus.Void)" /></MudTd>
                                        <MudTd>@lineItem.Total.ToString("C")</MudTd>
                                        <MudTd>
                                            @if (Bill.Status != BillStatus.Void)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Bill.LineItems.Remove(lineItem))" />
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Attachment (Invoice PDF)</MudText>

                            @if (!string.IsNullOrEmpty(Bill.AttachmentPath))
                            {
                                <div class="d-flex align-center gap-2 my-2">
                                    <FileAttachmentChip FileName="@Bill.AttachmentName"
                                                        FilePath="@Bill.AttachmentPath"
                                                        ReadOnly="@(Bill.Status == BillStatus.Void)"
                                                        OnRemove="@(async _ => await RemoveBillAttachment())" />
                                </div>
                            }

                            @if (Bill.Status != BillStatus.Void)
                            {
                                <ApiFileUpload Category="bills" ContextId="@Bill.Id" MaximumFileCount="1"
                                               OnUploadCompleted="HandleBillApiUploaded"
                                               OnUploadError='(e) => Snackbar.Add($"Upload failed: {e}", Severity.Error)'>
                                    <CustomContent>
                                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload Invoice
                                        </MudButton>
                                    </CustomContent>
                                </ApiFileUpload>
                            }
                        </MudItem>

                    </MudGrid>
                </MudForm>
            </MudItem>

            <!-- Right Side: PDF Preview -->
            @if (!string.IsNullOrEmpty(Bill.AttachmentPath))
            {
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2" Style="height: 100%; min-height: 600px;">
                        <iframe src="@Bill.AttachmentPath" style="width:100%; height:100%; border:none;"></iframe>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (Bill.Status == BillStatus.Void)
        {
            <MudButton Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Restore" OnClick="Unvoid">Restore Bill</MudButton>
        }
        else if (Bill.Payments.Count == 0 && Bill.AmountPaid == 0)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Block" OnClick="PromptVoid">Void Bill</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="Close">Close</MudButton>
        @if (Bill.Status != BillStatus.Void)
        {
            @if (Bill.Status == BillStatus.AwaitingApproval && CanApproveBills)
            {
                <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAndClose">Approve Bill</MudButton>
            }
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save Bill</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Bill Bill { get; set; } = default!;

    private PurchaseOrder? SelectedPO;
    private bool CanApproveBills = false;

    // Nullable Wrappers
    private DateTime? Date 
    { 
        get => Bill.Date; 
        set 
        { 
            if (value.HasValue && Bill.Date != value.Value) 
            {
                Bill.Date = value.Value;
                Bill.DueDate = value.Value.AddMonths(1);
            } 
        } 
    }
    private DateTime? DueDate { get => Bill.DueDate; set { if (value.HasValue) Bill.DueDate = value.Value; } }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Bill.Id)) Bill.Id = Guid.NewGuid().ToString();

        CanApproveBills = await UserService.IsAdminAsync() || await UserService.HasPermissionAsync(AppPermissions.Purchases.ApproveBills);

        if (!string.IsNullOrEmpty(Bill.PurchaseOrderId))
        {
            SelectedPO = Db.PurchaseOrders.GetById(Bill.PurchaseOrderId);
        }

        if (!string.IsNullOrEmpty(Bill.LinkedRecurringExpenseId))
        {
            SelectedRecurringExpense = Db.RecurringExpenses.GetById(Bill.LinkedRecurringExpenseId);
        }

        if (Bill.Amount > 0 && Bill.SubTotal == 0 && Bill.TpsAmount == 0 && Bill.TvqAmount == 0)
        {
            RecalculateFromTotal(Bill.Amount);
        }
    }

    private void OnSubTotalChanged(decimal newSubTotal)
    {
        Bill.SubTotal = newSubTotal;
        var rate = Bill.IsTaxExempt ? 0m : FinancialCalculationEngine.QuebecCombinedTaxRate;
        var breakdown = FinancialCalculationEngine.CalculateFromSubTotal(newSubTotal, rate);
        Bill.TpsAmount = breakdown.TpsAmount;
        Bill.TvqAmount = breakdown.TvqAmount;
        Bill.TaxAmount = breakdown.TotalTax;
        Bill.Amount = breakdown.GrandTotal;
    }

    private void OnTpsChanged(decimal newTps)
    {
        Bill.TpsAmount = newTps;
        Bill.TaxAmount = Math.Round(Bill.TpsAmount + Bill.TvqAmount, 2, MidpointRounding.AwayFromZero);
        if (Bill.SubTotal > 0)
        {
            Bill.Amount = Math.Round(Bill.SubTotal + Bill.TaxAmount, 2, MidpointRounding.AwayFromZero);
        }
    }

    private void OnTvqChanged(decimal newTvq)
    {
        Bill.TvqAmount = newTvq;
        Bill.TaxAmount = Math.Round(Bill.TpsAmount + Bill.TvqAmount, 2, MidpointRounding.AwayFromZero);
        if (Bill.SubTotal > 0)
        {
            Bill.Amount = Math.Round(Bill.SubTotal + Bill.TaxAmount, 2, MidpointRounding.AwayFromZero);
        }
    }

    private void OnTotalAmountChanged(decimal newTotal)
    {
        Bill.Amount = newTotal;
        if (Bill.SubTotal == 0 || Math.Abs(Bill.SubTotal + Bill.TpsAmount + Bill.TvqAmount - newTotal) > 0.05m)
        {
            RecalculateFromTotal(newTotal);
        }
    }

    private void OnTaxExemptChanged(bool isExempt)
    {
        Bill.IsTaxExempt = isExempt;
        if (isExempt)
        {
            Bill.TpsAmount = 0m;
            Bill.TvqAmount = 0m;
            Bill.TaxAmount = 0m;
            Bill.SubTotal = Bill.Amount;
        }
        else if (Bill.Amount > 0)
        {
            RecalculateFromTotal(Bill.Amount);
        }
    }

    private void RecalculateFromTotal(decimal total)
    {
        var breakdown = FinancialCalculationEngine.CalculateFromGrandTotal(total, Bill.IsTaxExempt);
        Bill.SubTotal = breakdown.SubTotal;
        Bill.TpsAmount = breakdown.TpsAmount;
        Bill.TvqAmount = breakdown.TvqAmount;
        Bill.TaxAmount = breakdown.TaxAmount;
    }

    private RecurringExpense? SelectedRecurringExpense;

    private Task<IEnumerable<RecurringExpense>> SearchRecurringExpenses(string value, CancellationToken token)
    {
        var all = Db.RecurringExpenses.GetAll().Where(e => !e.IsEstimate);
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult(all.OrderBy(e => e.Name).Take(50));
        var filtered = all.Where(e =>
            (!string.IsNullOrEmpty(e.Name) && e.Name.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.Supplier) && e.Supplier.Contains(value, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(filtered.OrderBy(e => e.Name).AsEnumerable());
    }

    private void OnRecurringExpenseSelected(RecurringExpense? expense)
    {
        SelectedRecurringExpense = expense;
        Bill.LinkedRecurringExpenseId = expense?.Id;
        if (expense != null)
        {
            if (string.IsNullOrWhiteSpace(Bill.SupplierName) && !string.IsNullOrWhiteSpace(expense.Supplier))
                Bill.SupplierName = expense.Supplier;
            if (string.IsNullOrWhiteSpace(Bill.GlAccountCode) && !string.IsNullOrWhiteSpace(expense.GlAccountCode))
                Bill.GlAccountCode = expense.GlAccountCode;
            if (expense.IsTaxExempt)
                OnTaxExemptChanged(true);
        }
    }

    private Task<IEnumerable<PurchaseOrder>> SearchPOs(string value, CancellationToken token)
    {
        var allPos = Db.PurchaseOrders.GetAll();
        if (string.IsNullOrEmpty(value)) return Task.FromResult(allPos.OrderByDescending(p => p.PoNumber).Take(50));
        
        var filtered = allPos.Where(p => 
            p.PoNumber.Contains(value, StringComparison.OrdinalIgnoreCase) || 
            (p.Supplier?.BusinessName?.Contains(value, StringComparison.OrdinalIgnoreCase) == true)
        ).OrderByDescending(p => p.PoNumber);
        
        return Task.FromResult(filtered.AsEnumerable());
    }

    private void OnPoSelected(PurchaseOrder po)
    {
        SelectedPO = po;
        Bill.PurchaseOrderId = po?.Id;
        if (po != null)
        {
            var linkedBills = Db.Bills.GetByPo(po.Id);
            var totalBilled = linkedBills.Where(b => b.Id != Bill.Id && b.Status != BillStatus.Void).Sum(b => b.Amount);
            var remaining = po.GrandTotal - totalBilled;

            if (string.IsNullOrEmpty(Bill.SupplierName)) Bill.SupplierName = po.Supplier.BusinessName;
            if (Bill.Amount == 0 && remaining > 0)
            {
                if (totalBilled == 0 && po.SubTotal > 0)
                {
                    Bill.SubTotal = po.SubTotal;
                    var poTaxBreakdown = FinancialCalculationEngine.CalculateFromSubTotal(po.SubTotal, po.ApplyTax ? po.TaxRate : 0m);
                    Bill.TpsAmount = poTaxBreakdown.TpsAmount;
                    Bill.TvqAmount = poTaxBreakdown.TvqAmount;
                    Bill.TaxAmount = poTaxBreakdown.TaxAmount;
                    Bill.Amount = po.GrandTotal;
                }
                else
                {
                    OnTotalAmountChanged(remaining);
                }
            }
            if (string.IsNullOrEmpty(Bill.Description)) Bill.Description = $"Invoice for {po.PoNumber}";
        }
    }

    private void AddLineItem()
    {
        Bill.LineItems.Add(new BillLineItem());
    }

    private void AutoFillLineItems()
    {
        if (SelectedPO == null) return;
        
        var linkedBills = Db.Bills.GetByPo(SelectedPO.Id);
        var alreadyBilledPoItemIds = linkedBills
            .Where(b => b.Id != Bill.Id && b.Status != BillStatus.Void)
            .SelectMany(b => b.LineItems)
            .Select(li => li.PoItemId)
            .Where(id => !string.IsNullOrEmpty(id))
            .ToHashSet();

        Bill.LineItems.Clear();
        foreach (var item in SelectedPO.LineItems)
        {
            if (alreadyBilledPoItemIds.Contains(item.Id)) continue;

            Bill.LineItems.Add(new BillLineItem
            {
                PoItemId = item.Id,
                Description = item.Description,
                Quantity = item.Quantity,
                UnitPrice = item.UnitPrice
            });
        }

        if (Bill.LineItems.Count == 0)
        {
            Snackbar.Add("All items from this PO have already been billed.", Severity.Info);
        }
        else
        {
            var lineSum = Bill.LineItems.Sum(li => li.Total);
            if (lineSum > 0)
            {
                OnSubTotalChanged(lineSum);
            }
        }
    }

    private async Task RemoveBillAttachment()
    {
        if (!string.IsNullOrEmpty(Bill.AttachmentPath))
        {
            await FileService.DeleteAsync(Bill.AttachmentPath);
        }
        Bill.AttachmentPath = "";
        Bill.AttachmentName = "";
        StateHasChanged();
    }

    private async Task HandleBillApiUploaded(List<ApiFileUpload.UploadResult> results)
    {
        var result = results.FirstOrDefault();
        if (result != null)
        {
            if (!string.IsNullOrEmpty(Bill.AttachmentPath) && Bill.AttachmentPath != result.FilePath)
            {
                await FileService.DeleteAsync(Bill.AttachmentPath);
            }
            Bill.AttachmentPath = result.FilePath;
            Bill.AttachmentName = result.FileName;
            Snackbar.Add("File Uploaded", Severity.Success);

            // Attempt automated extraction from the uploaded invoice
            try
            {
                var safeName = Path.GetFileName(result.FilePath);
                using var stream = FileService.OpenRead(result.Category, result.ContextId, safeName);
                if (stream != null)
                {
                    var extracted = PdfInspectionService.Inspect(stream, result.FileName);
                    if (extracted != null)
                    {
                        bool autoFilled = false;
                        if (extracted.TotalAmount > 0 && Bill.Amount == 0)
                        {
                            Bill.Amount = extracted.TotalAmount;
                            autoFilled = true;
                        }
                        if (!string.IsNullOrWhiteSpace(extracted.InvoiceNumber))
                        {
                            Bill.InvoiceNumber = extracted.InvoiceNumber;
                            if (string.IsNullOrWhiteSpace(Bill.Description))
                            {
                                Bill.Description = $"Invoice {extracted.InvoiceNumber}";
                            }
                            autoFilled = true;
                        }
                        if (extracted.InvoiceDate.HasValue && !Date.HasValue)
                        {
                            Date = extracted.InvoiceDate.Value;
                            autoFilled = true;
                        }
                        if (extracted.DueDate.HasValue)
                        {
                            DueDate = extracted.DueDate.Value;
                            autoFilled = true;
                        }
                        if (extracted.SubTotal > 0 && Bill.SubTotal == 0) Bill.SubTotal = extracted.SubTotal;
                        if (extracted.TaxAmount > 0 && Bill.TaxAmount == 0) Bill.TaxAmount = extracted.TaxAmount;
                        if (extracted.TpsAmount > 0 && Bill.TpsAmount == 0) Bill.TpsAmount = extracted.TpsAmount;
                        if (extracted.TvqAmount > 0 && Bill.TvqAmount == 0) Bill.TvqAmount = extracted.TvqAmount;

                        if (Bill.Amount > 0 && Bill.SubTotal == 0 && Bill.TpsAmount == 0 && Bill.TvqAmount == 0)
                        {
                            RecalculateFromTotal(Bill.Amount);
                        }

                        if (!string.IsNullOrWhiteSpace(extracted.SupplierName) && string.IsNullOrWhiteSpace(Bill.SupplierName))
                        {
                            Bill.SupplierName = extracted.SupplierName;
                            autoFilled = true;
                        }

                        // Auto-match PO if not selected yet
                        if (SelectedPO == null)
                        {
                            var poMatch = PoMatchingEngine.FindMatch(extracted, null);
                            if (poMatch.MatchedPo != null)
                            {
                                OnPoSelected(poMatch.MatchedPo);
                                autoFilled = true;
                                Snackbar.Add($"Matched PO {poMatch.MatchedPo.PoNumber} ({poMatch.Reason})", Severity.Info);
                            }
                        }

                        // Auto-fill line items if extracted
                        if (!Bill.LineItems.Any() && extracted.LineItems.Count > 0)
                        {
                            foreach (var li in extracted.LineItems)
                            {
                                Bill.LineItems.Add(new BillLineItem
                                {
                                    Description = li.Description,
                                    Quantity = li.Quantity,
                                    UnitPrice = li.UnitPrice
                                });
                            }
                            autoFilled = true;
                        }

                        if (autoFilled)
                        {
                            Snackbar.Add("Auto-extracted invoice details from document", Severity.Success);
                        }
                    }
                }
            }
            catch
            {
                // Silently ignore non-fatal extraction failures
            }

            StateHasChanged();
        }
    }

    private async Task RecordPayment()
    {
        var parameters = new DialogParameters<RecordPaymentDialog>
        {
            { x => x.Message, $"Record payment for {Bill.Description}" },
            { x => x.MaxAmount, Bill.BalanceDue },
            { x => x.ExistingPayments, Bill.Payments }
        };
        var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Payment", parameters);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PaymentRecord payment)
        {
            Bill.Payments.Add(payment);
            if (Bill.BalanceDue <= 0)
            {
                Bill.Status = BillStatus.Paid;
                Bill.DatePaid = payment.Date;
            }
            StateHasChanged();
        }
    }

    private async Task OnStatusChanged(string newStatus)
    {
        if (newStatus == BillStatus.Void)
        {
            await PromptVoid();
        }
        else
        {
            Bill.Status = newStatus;
        }
    }

    private async Task PromptVoid()
    {
        var parameters = new DialogParameters<VoidBillDialog>
        {
            { x => x.Bill, Bill }
        };
        var dialog = await DialogService.ShowAsync<VoidBillDialog>("Void Bill", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string reason })
        {
            var auth = await AuthStateProvider.GetAuthenticationStateAsync();
            var userName = auth.User.Identity?.Name ?? "User";
            AccountingService.VoidBill(Bill, reason, userName);
            Snackbar.Add("Bill voided successfully", Severity.Normal);
            MudDialog.Close(DialogResult.Ok(Bill));
        }
    }

    private async Task Unvoid()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name ?? "User";
        AccountingService.UnvoidBill(Bill, userName);
        Snackbar.Add("Bill restored to unpaid status", Severity.Success);
        StateHasChanged();
    }

    private async Task ApproveAndClose()
    {
        var auth = await AuthStateProvider.GetAuthenticationStateAsync();
        var userName = auth.User.Identity?.Name ?? "User";
        AccountingService.ApproveBill(Bill, userName);
        Snackbar.Add("Bill approved successfully", Severity.Success);
        MudDialog.Close(DialogResult.Ok(Bill));
    }

    private void Close() => MudDialog.Cancel();
    
    private void Submit()
    {
        if (Bill.Status == BillStatus.Void)
        {
            MudDialog.Close(DialogResult.Ok(Bill));
            return;
        }

        if (Bill.BalanceDue <= 0 && Bill.Amount > 0 && Bill.Status != BillStatus.Paid)
        {
            Bill.Status = BillStatus.Paid;
            Bill.DatePaid = Bill.DatePaid ?? DateTime.Today;
        }
        else if (Bill.Status == BillStatus.Paid && Bill.BalanceDue > 0)
        {
            Bill.Status = BillStatus.Unpaid;
            if (!Bill.Payments.Any()) Bill.DatePaid = null;
        }
        MudDialog.Close(DialogResult.Ok(Bill));
    }
}
