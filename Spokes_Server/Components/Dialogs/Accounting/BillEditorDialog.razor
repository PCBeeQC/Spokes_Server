@using System.IO
@using Spokes_Server.Components.Dialogs.Common
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Accounting.InvoiceExtraction
@using Spokes_Server.Core.Services.Projects
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.Storage
@inject Database Db
@inject ISnackbar Snackbar
@inject UserService UserService
@inject IDialogService DialogService
@inject PdfInvoiceInspectionService PdfInspectionService
@inject SmartPoMatchingEngine PoMatchingEngine
@inject IFileService FileService
@inject IAccountingService AccountingService
@inject FileUrlSigner FileUrls

<MudDialog>
    <DialogContent>
        <MudGrid>
            <!-- Left Side: Form -->
            <MudItem xs="12" md="@(string.IsNullOrEmpty(Bill.AttachmentPath) ? 12 : 6)">
                <MudForm>
                    <MudGrid>
                        @if (Bill.Status == BillStatus.Void)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2" Icon="@Icons.Material.Filled.Block">
                                    <div>
                                        <strong>VOIDED BILL</strong> &mdash; Voided on @(Bill.VoidedAt?.ToLocalTime().ToString("g") ?? "unknown date") by @(Bill.VoidedBy ?? "unknown").
                                    </div>
                                    @if (!string.IsNullOrWhiteSpace(Bill.VoidReason))
                                    {
                                        <div class="mt-1">
                                            <b>Reason:</b> @Bill.VoidReason
                                        </div>
                                    }
                                </MudAlert>
                            </MudItem>
                        }

                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="PurchaseOrder" Label="Link to Purchase Order (Optional)" 
                                Value="@SelectedPO" ValueChanged="@OnPoSelected"
                                SearchFunc="@SearchPOs" ToStringFunc="@(p => p==null ? "" : $"{p.PoNumber} - {p.Supplier.BusinessName}")"
                                Clearable="true" AdornmentIcon="@Icons.Material.Filled.Link"
                                Disabled="@(Bill.Status == BillStatus.Void || !_canViewPOs || !CanManageBills)" />
                        </MudItem>

                        <MudItem xs="12" sm="6">
                            <MudAutocomplete T="RecurringExpense" Label="Link to Recurring Bill Profile (Optional)" 
                                Value="@SelectedRecurringExpense" ValueChanged="@OnRecurringExpenseSelected"
                                SearchFunc="@SearchRecurringExpenses" ToStringFunc="@(r => r==null ? "" : $"{r.Name} ({r.Supplier})")"
                                Clearable="true" AdornmentIcon="@Icons.Material.Filled.Repeat"
                                Disabled="@(Bill.Status == BillStatus.Void || !_canReadAccounting || !CanManageBills)" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudAutocomplete T="string"
                                             Value="@Bill.SupplierName"
                                             ValueChanged="@OnSupplierNameChanged"
                                             SearchFunc="@SearchSupplierNames"
                                             CoerceText="false"
                                             CoerceValue="true"
                                             Label="Supplier Name"
                                             Required="true"
                                             ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Bill.InvoiceNumber" Label="Invoice #" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField @bind-Value="Bill.Description" Label="Description" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudDatePicker @bind-Date="Date" Label="Date" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudDatePicker @bind-Date="DueDate" Label="Due Date" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>

                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal" Value="Bill.SubTotal" ValueChanged="@OnSubTotalChanged" Label="Subtotal (Before Tax)" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudNumericField T="decimal" Value="Bill.TpsAmount" ValueChanged="@OnTpsChanged" Label="TPS (5%)" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void || Bill.IsTaxExempt)" />
                        </MudItem>
                        <MudItem xs="6" sm="4">
                            <MudNumericField T="decimal" Value="Bill.TvqAmount" ValueChanged="@OnTvqChanged" Label="TVQ (9.975%)" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void || Bill.IsTaxExempt)" />
                        </MudItem>

                        <MudItem xs="6" sm="4">
                            <MudNumericField T="decimal" Value="Bill.Amount" ValueChanged="@OnTotalAmountChanged" Label="Total Amount" Format="N2" Adornment="Adornment.Start"
                                AdornmentIcon="@Icons.Material.Filled.AttachMoney" ReadOnly="@(Bill.Status == BillStatus.Void)" />
                            @if (Bill.AmountPaid > 0 || Bill.HasWriteOffs)
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Amount Paid"]: @Bill.AmountPaid.ToString("C2")</MudText>
                                @if (Bill.HasWriteOffs)
                                {
                                    <br />
                                    <MudText Typo="Typo.caption" Color="Color.Warning">@BizLoc["Written Off"]: @Bill.AmountWrittenOff.ToString("C2")</MudText>
                                }
                                <br />
                                <MudText Typo="Typo.caption" Color="@(Bill.BalanceDue > 0 ? Color.Warning : Color.Success)"><b>@BizLoc["Balance Due"]: @Bill.BalanceDue.ToString("C2")</b></MudText>
                            }
                        </MudItem>
                        @if (Bill.Status != BillStatus.Void && !Bill.IsTaxExempt && Bill.Amount > 0 && Bill.TaxAmount <= 0 && Bill.TpsAmount <= 0 && Bill.TvqAmount <= 0 && FinancialCalculationEngine.ActiveCombinedTaxRate > 0)
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" NoIcon="false">
                                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                        <MudText Typo="Typo.body2">@BizLoc["No sales tax breakdown recorded on this bill. Split taxes to claim input tax credits (ITC/ITR) or mark as tax-exempt."]</MudText>
                                        <div class="d-flex gap-2">
                                            <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" OnClick="ApplyTaxIncludedSplit">
                                                @BizLoc["Split Tax-Included Amount"]
                                            </MudButton>
                                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Default" OnClick="MarkBillTaxExempt">
                                                @BizLoc["Mark Tax-Exempt"]
                                            </MudButton>
                                        </div>
                                    </div>
                                </MudAlert>
                            </MudItem>
                        }
                        <MudItem xs="6" sm="4">
                            <MudSelect T="string" Value="Bill.Status" ValueChanged="OnStatusChanged" Label="Status" Disabled="@(Bill.Status == BillStatus.Void || !CanManageBills)">
                                <MudSelectItem Value="@(BillStatus.AwaitingApproval)">Awaiting Approval</MudSelectItem>
                                @if (CanApproveBills || Bill.Status == BillStatus.Approved)
                                {
                                    <MudSelectItem Value="@(BillStatus.Approved)">Approved</MudSelectItem>
                                }
                                @if (CanApproveBills || Bill.Status == BillStatus.Approved || Bill.Status == BillStatus.Unpaid || Bill.Status == BillStatus.Paid || Bill.Status == BillStatus.WrittenOff)
                                {
                                    <MudSelectItem Value="@(BillStatus.Unpaid)">Unpaid</MudSelectItem>
                                }
                                @if (CanApproveBills || Bill.Status == BillStatus.Paid)
                                {
                                    <MudSelectItem Value="@(BillStatus.Paid)">Paid</MudSelectItem>
                                }
                                @if (Bill.Status == BillStatus.WrittenOff)
                                {
                                    <MudSelectItem Value="@(BillStatus.WrittenOff)">@BizLoc["Written Off"]</MudSelectItem>
                                }
                                <MudSelectItem Value="@(BillStatus.Void)">Void</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        @if (_canReadAccounting)
                        {
                            <MudItem xs="12" sm="4">
                                <GlAccountSelect @bind-Value="Bill.GlAccountCode"
                                                 Label="@BizLoc["Category (Optional)"]"
                                                 Placeholder="@BizLoc["Auto-inherited from Supplier"]"
                                                 Clearable="true"
                                                 ReadOnly="@(Bill.Status == BillStatus.Void || !CanManageBills)" />
                            </MudItem>
                        }

                        <MudItem xs="6">
                            <MudCheckBox T="bool" Value="Bill.IsTaxExempt" ValueChanged="@OnTaxExemptChanged" Label="Tax Exempt (0% TPS/TVQ)" Color="Color.Primary" Disabled="@(Bill.Status == BillStatus.Void)" Dense="true" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudCheckBox T="bool" @bind-Value="Bill.IsCreditNote" Label="Credit Note / Refund" Color="Color.Warning" Disabled="@(Bill.Status == BillStatus.Void)" Dense="true" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudCheckBox T="bool" @bind-Value="Bill.IsBusinessOverhead" Label="Business Overhead Cost (Amortized over 12 months)" Color="Color.Info" Disabled="@(Bill.Status == BillStatus.Void || SelectedPO != null || SelectedRecurringExpense != null)" Dense="true" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                                <MudText Typo="Typo.subtitle2">Payments Recorded (@Bill.AmountPaid.ToString("C2"))</MudText>
                                @if (Bill.BalanceDue > 0 && Bill.Status != BillStatus.Void && CanManageBills && (Bill.Status != BillStatus.AwaitingApproval || CanApproveBills))
                                {
                                    <div class="d-flex align-center gap-2">
                                        @if (Db.Bills.GetById(Bill.Id) != null)
                                        {
                                            <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Balance" OnClick="CloseBillBalance">@BizLoc["Close Balance"]</MudButton>
                                        }
                                        <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Info" StartIcon="@Icons.Material.Filled.Add" OnClick="RecordPayment">Record Payment</MudButton>
                                    </div>
                                }
                            </div>
                            @if (Bill.Payments.Any())
                            {
                                <MudTable Items="@Bill.Payments" Dense="true" Elevation="0" Outlined="true" Class="mt-2">
                                    <HeaderContent>
                                        <MudTh>Date</MudTh>
                                        <MudTh>Amount</MudTh>
                                        <MudTh>Method</MudTh>
                                        <MudTh>Reference</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="payment">
                                        <MudTd>@payment.Date.ToShortDateString()</MudTd>
                                        <MudTd>@payment.Amount.ToString("C2")</MudTd>
                                        <MudTd>@payment.Method</MudTd>
                                        <MudTd>@payment.Reference</MudTd>
                                        <MudTd>
                                            @if (Bill.Status != BillStatus.Void && CanManageBills)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Bill.Payments.Remove(payment))" />
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                            else if (Bill.DatePaid.HasValue && !Bill.HasWriteOffs)
                            {
                                <MudText Typo="Typo.body2" Class="mt-2 text-muted">Legacy payment recorded on @Bill.DatePaid.Value.ToShortDateString() for @Bill.Amount.ToString("C2").</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Class="text-muted">No payments recorded yet.</MudText>
                            }

                            @if (Bill.WriteOffs.Any())
                            {
                                <MudText Typo="Typo.subtitle2" Class="mt-3">@BizLoc["Balance Write-Offs / Adjustments"] (@Bill.AmountWrittenOff.ToString("C2"))</MudText>
                                <MudTable Items="@Bill.WriteOffs" Dense="true" Elevation="0" Outlined="true" Class="mt-1">
                                    <HeaderContent>
                                        <MudTh>@BizLoc["Date"]</MudTh>
                                        <MudTh>@BizLoc["Amount"]</MudTh>
                                        <MudTh>@BizLoc["GL Account"]</MudTh>
                                        <MudTh>@BizLoc["Reason"]</MudTh>
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="wo">
                                        <MudTd>@wo.Date.ToShortDateString()</MudTd>
                                        <MudTd><span style="font-weight: 600; color: var(--mud-palette-warning);">@wo.Amount.ToString("C2")</span></MudTd>
                                        <MudTd>@(string.IsNullOrWhiteSpace(wo.GlAccountCode) ? "5860" : wo.GlAccountCode)</MudTd>
                                        <MudTd>@wo.Reason</MudTd>
                                        <MudTd Style="text-align: right;">
                                            @if (Bill.Status != BillStatus.Void && CanManageBills)
                                            {
                                                <MudTooltip Text="@BizLoc["Reverse Write-Off"]">
                                                    <MudIconButton Icon="@Icons.Material.Filled.Undo" Size="Size.Small" Color="Color.Error" OnClick="@(() => ReverseBillWriteOff(wo))" />
                                                </MudTooltip>
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            <div class="d-flex align-center justify-space-between mt-4">
                                <MudText Typo="Typo.subtitle2">Line Items</MudText>
                                @if (Bill.Status != BillStatus.Void && CanManageBills)
                                {
                                    @if (SelectedPO != null && !Bill.LineItems.Any() && _canViewPOs)
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="AutoFillLineItems">Auto-fill from PO</MudButton>
                                    }
                                    else
                                    {
                                        <MudButton Size="Size.Small" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Add" OnClick="AddLineItem">Add Item</MudButton>
                                    }
                                }
                            </div>
                            
                            @if (Bill.LineItems.Any())
                            {
                                <MudTable Items="@Bill.LineItems" Dense="true" Hover="true" Elevation="0" Class="mt-2" Outlined="true">
                                    <HeaderContent>
                                        <MudTh>Description</MudTh>
                                        <MudTh>Qty</MudTh>
                                        <MudTh>Price</MudTh>
                                        <MudTh>Total</MudTh>
                                        @if (_canReadAccounting)
                                        {
                                            <MudTh>GL Override</MudTh>
                                        }
                                        <MudTh></MudTh>
                                    </HeaderContent>
                                    <RowTemplate Context="lineItem">
                                        <MudTd><MudTextField @bind-Value="lineItem.Description" Margin="Margin.Dense" Underline="false" ReadOnly="@(Bill.Status == BillStatus.Void || !CanManageBills)" /></MudTd>
                                        <MudTd><MudNumericField @bind-Value="lineItem.Quantity" Margin="Margin.Dense" Underline="false" ReadOnly="@(Bill.Status == BillStatus.Void || !CanManageBills)" /></MudTd>
                                        <MudTd><MudNumericField @bind-Value="lineItem.UnitPrice" Margin="Margin.Dense" Underline="false" ReadOnly="@(Bill.Status == BillStatus.Void || !CanManageBills)" /></MudTd>
                                        <MudTd>@lineItem.Total.ToString("C")</MudTd>
                                        @if (_canReadAccounting)
                                        {
                                            <MudTd Style="min-width: 170px;">
                                                <GlAccountSelect @bind-Value="lineItem.GlAccountCode"
                                                                 Margin="Margin.Dense"
                                                                 Dense="true"
                                                                 Underline="false"
                                                                 Clearable="true"
                                                                 Placeholder="@(string.IsNullOrWhiteSpace(Bill.GlAccountCode) ? "Bill Default" : Bill.GlAccountCode)"
                                                                 ReadOnly="@(Bill.Status == BillStatus.Void || !CanManageBills)" />
                                            </MudTd>
                                        }
                                        <MudTd>
                                            @if (Bill.Status != BillStatus.Void && CanManageBills)
                                            {
                                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error" OnClick="@(() => Bill.LineItems.Remove(lineItem))" />
                                            }
                                        </MudTd>
                                    </RowTemplate>
                                </MudTable>
                            }
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Attachment (Invoice PDF)</MudText>

                            @if (!string.IsNullOrEmpty(Bill.AttachmentPath))
                            {
                                <div class="d-flex align-center gap-2 my-2">
                                    <FileAttachmentChip FileName="@Bill.AttachmentName"
                                                        FilePath="@Bill.AttachmentPath"
                                                        ReadOnly="@(Bill.Status == BillStatus.Void || !CanManageBills)"
                                                        OnRemove="@(async _ => await RemoveBillAttachment())" />
                                </div>
                            }

                            @if (Bill.Status != BillStatus.Void && CanManageBills)
                            {
                                <ApiFileUpload Category="bills" ContextId="@Bill.Id" MaximumFileCount="1"
                                               OnUploadCompleted="HandleBillApiUploaded"
                                               OnUploadError='(e) => Snackbar.Add($"Upload failed: {e}", Severity.Error)'>
                                    <CustomContent>
                                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload Invoice
                                        </MudButton>
                                    </CustomContent>
                                </ApiFileUpload>
                            }
                        </MudItem>

                    </MudGrid>
                </MudForm>
                @if (Bill.History != null && Bill.History.Count > 0)
                {
                    <MudDivider Class="my-3" />
                    <MudExpansionPanels Elevation="0" Outlined="true">
                        <MudExpansionPanel Text="@($"{BizLoc["Audit History"].Value} ({Bill.History.Count})")" Icon="@Icons.Material.Filled.History">
                            <DocumentHistoryTab Entries="@Bill.History" />
                        </MudExpansionPanel>
                    </MudExpansionPanels>
                }
            </MudItem>

            <!-- Right Side: PDF Preview -->
            @if (!string.IsNullOrEmpty(Bill.AttachmentPath))
            {
                <MudItem xs="12" md="6">
                    <MudPaper Elevation="0" Outlined="true" Class="pa-2" Style="height: 100%; min-height: 600px;">
                        <iframe src="@FileUrls.SignUrl(Bill.AttachmentPath)" style="width:100%; height:100%; border:none;"></iframe>
                    </MudPaper>
                </MudItem>
            }
        </MudGrid>
    </DialogContent>
    <DialogActions>
        @if (Bill.Status == BillStatus.Void)
        {
            @if (CanApproveBills)
            {
                <MudButton Color="Color.Warning" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Restore" OnClick="Unvoid">Restore Bill</MudButton>
            }
        }
        else if (Bill.Payments.Count == 0 && Bill.AmountPaid == 0 && CanManageBills)
        {
            <MudButton Color="Color.Error" Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.Block" OnClick="PromptVoid">Void Bill</MudButton>
        }
        <MudSpacer />
        <MudButton OnClick="Close">Close</MudButton>
        @if (Bill.Status != BillStatus.Void)
        {
            @if (Bill.Status == BillStatus.AwaitingApproval && CanApproveBills)
            {
                <MudButton Color="Color.Success" Variant="Variant.Filled" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="ApproveAndClose">Approve Bill</MudButton>
            }
            @if (CanManageBills)
            {
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">Save Bill</MudButton>
            }
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Bill Bill { get; set; } = default!;

    private PurchaseOrder? SelectedPO;
    private Employee? _currentEmployee;
    private string _initialStatus = string.Empty;
    private bool CanManageBills = false;
    private bool CanApproveBills = false;
    private bool _canViewPOs = false;
    private bool _canViewAddressBook = false;
    private bool _canReadAccounting = false;

    private bool IsPoAccessible(PurchaseOrder? po)
    {
        if (po == null || !_canViewPOs || _currentEmployee == null)
        {
            return false;
        }

        if (po.Status == PurchaseOrderStatus.Draft || po.Status == PurchaseOrderStatus.Void)
        {
            return false;
        }

        var projectIds = po.LineItems?
            .Where(l => !string.IsNullOrWhiteSpace(l.ProjectId))
            .Select(l => l.ProjectId!)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList() ?? new List<string>();

        return projectIds.All(pid => ProjectAccessHelper.HasAccess(Db.Projects, Db.Teams, _currentEmployee, pid));
    }

    // Nullable Wrappers
    private DateTime? Date 
    { 
        get => Bill.Date; 
        set 
        { 
            if (value.HasValue && Bill.Date != value.Value) 
            { 
                Bill.Date = value.Value;
                Bill.DueDate = value.Value.AddMonths(1);
            } 
        } 
    }
    private DateTime? DueDate { get => Bill.DueDate; set { if (value.HasValue) Bill.DueDate = value.Value; } }

    protected override async Task OnInitializedAsync()
    {
        if (string.IsNullOrEmpty(Bill.Id)) Bill.Id = Guid.NewGuid().ToString();

        _initialStatus = Bill.Status;
        _currentEmployee = await UserService.GetEmployeeAsync();
        CanManageBills = _currentEmployee != null && _currentEmployee.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false);
        CanApproveBills = _currentEmployee != null && _currentEmployee.HasEffectivePermission(AppPermissions.Purchases.ApproveBills, allowSuspended: false);
        _canViewPOs = _currentEmployee != null && (_currentEmployee.HasEffectivePermission(AppPermissions.Purchases.ViewPOs, allowSuspended: false)
            || _currentEmployee.HasEffectivePermission(AppPermissions.Purchases.ManagePOs, allowSuspended: false));
        _canViewAddressBook = _currentEmployee != null && (_currentEmployee.HasEffectivePermission(AppPermissions.AddressBook.View, allowSuspended: false)
            || _currentEmployee.HasEffectivePermission(AppPermissions.AddressBook.Manage, allowSuspended: false));
        _canReadAccounting = _currentEmployee != null && _currentEmployee.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false);

        if (_canViewPOs && !string.IsNullOrEmpty(Bill.PurchaseOrderId))
        {
            var candidatePo = Db.PurchaseOrders.GetById(Bill.PurchaseOrderId);
            if (IsPoAccessible(candidatePo))
            {
                SelectedPO = candidatePo;
            }
        }

        if (_canReadAccounting && !string.IsNullOrEmpty(Bill.LinkedRecurringExpenseId))
        {
            SelectedRecurringExpense = Db.RecurringExpenses.GetById(Bill.LinkedRecurringExpenseId);
        }

        if (Bill.Amount > 0 && Bill.SubTotal == 0 && Bill.TpsAmount == 0 && Bill.TvqAmount == 0)
        {
            RecalculateFromTotal(Bill.Amount);
        }
    }

    private void OnSubTotalChanged(decimal newSubTotal)
    {
        Bill.SubTotal = newSubTotal;
        var rate = Bill.IsTaxExempt ? 0m : FinancialCalculationEngine.ActiveCombinedTaxRate;
        var breakdown = FinancialCalculationEngine.CalculateFromSubTotal(newSubTotal, rate);
        Bill.TpsAmount = breakdown.TpsAmount;
        Bill.TvqAmount = breakdown.TvqAmount;
        Bill.TaxAmount = breakdown.TotalTax;
        Bill.Amount = breakdown.GrandTotal;
    }

    private void OnTpsChanged(decimal newTps)
    {
        Bill.TpsAmount = newTps;
        Bill.TaxAmount = Math.Round(Bill.TpsAmount + Bill.TvqAmount, 2, MidpointRounding.AwayFromZero);
        if (Bill.SubTotal > 0)
        {
            Bill.Amount = Math.Round(Bill.SubTotal + Bill.TaxAmount, 2, MidpointRounding.AwayFromZero);
        }
    }

    private void OnTvqChanged(decimal newTvq)
    {
        Bill.TvqAmount = newTvq;
        Bill.TaxAmount = Math.Round(Bill.TpsAmount + Bill.TvqAmount, 2, MidpointRounding.AwayFromZero);
        if (Bill.SubTotal > 0)
        {
            Bill.Amount = Math.Round(Bill.SubTotal + Bill.TaxAmount, 2, MidpointRounding.AwayFromZero);
        }
    }

    private void OnTotalAmountChanged(decimal newTotal)
    {
        Bill.Amount = newTotal;
        if (Bill.SubTotal == 0 || Math.Abs(Bill.SubTotal + Bill.TpsAmount + Bill.TvqAmount - newTotal) > 0.05m)
        {
            RecalculateFromTotal(newTotal);
        }
    }

    private void OnTaxExemptChanged(bool isExempt)
    {
        Bill.IsTaxExempt = isExempt;
        if (isExempt)
        {
            Bill.TpsAmount = 0m;
            Bill.TvqAmount = 0m;
            Bill.TaxAmount = 0m;
            Bill.SubTotal = Bill.Amount;
        }
        else if (Bill.Amount > 0)
        {
            RecalculateFromTotal(Bill.Amount);
        }
    }

    private void RecalculateFromTotal(decimal total)
    {
        var breakdown = FinancialCalculationEngine.CalculateFromGrandTotal(total, Bill.IsTaxExempt);
        Bill.SubTotal = breakdown.SubTotal;
        Bill.TpsAmount = breakdown.TpsAmount;
        Bill.TvqAmount = breakdown.TvqAmount;
        Bill.TaxAmount = breakdown.TaxAmount;
    }

    private RecurringExpense? SelectedRecurringExpense;

    private Task<IEnumerable<string>> SearchSupplierNames(string? value, CancellationToken token)
    {
        if (!_canViewAddressBook)
        {
            return Task.FromResult(Enumerable.Empty<string>());
        }

        var names = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
        foreach (var s in Db.Suppliers.GetAll())
        {
            if (!string.IsNullOrWhiteSpace(s.ContactInfo.BusinessName))
                names.Add(s.ContactInfo.BusinessName.Trim());
        }

        var ordered = names.OrderBy(n => n);
        if (string.IsNullOrWhiteSpace(value))
            return Task.FromResult<IEnumerable<string>>(ordered.Take(75));

        return Task.FromResult<IEnumerable<string>>(
            ordered.Where(n => n.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase)).Take(75));
    }

    private void OnSupplierNameChanged(string? newName)
    {
        Bill.SupplierName = newName?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(Bill.SupplierName))
        {
            Bill.SupplierId = string.Empty;
            return;
        }

        if (!_canViewAddressBook)
        {
            return;
        }

        var supplier = Db.Suppliers.GetAll().FirstOrDefault(s =>
            string.Equals(s.ContactInfo.BusinessName, Bill.SupplierName, StringComparison.OrdinalIgnoreCase));

        if (supplier != null)
        {
            Bill.SupplierId = supplier.Id;
            if (_canReadAccounting && string.IsNullOrWhiteSpace(Bill.GlAccountCode) && !string.IsNullOrWhiteSpace(supplier.ContactInfo.DefaultGlAccountCode))
            {
                Bill.GlAccountCode = supplier.ContactInfo.DefaultGlAccountCode;
            }
        }
    }

    private Task<IEnumerable<RecurringExpense>> SearchRecurringExpenses(string value, CancellationToken token)
    {
        if (!_canReadAccounting)
        {
            return Task.FromResult(Enumerable.Empty<RecurringExpense>());
        }

        var all = Db.RecurringExpenses.GetAll().Where(e => e.Frequency != RecurringExpenseFrequency.OneTime);
        if (string.IsNullOrWhiteSpace(value)) return Task.FromResult(all.OrderBy(e => e.Name).Take(50));
        var filtered = all.Where(e =>
            (!string.IsNullOrEmpty(e.Name) && e.Name.Contains(value, StringComparison.OrdinalIgnoreCase)) ||
            (!string.IsNullOrEmpty(e.Supplier) && e.Supplier.Contains(value, StringComparison.OrdinalIgnoreCase)));
        return Task.FromResult(filtered.OrderBy(e => e.Name).AsEnumerable());
    }

    private void OnRecurringExpenseSelected(RecurringExpense? expense)
    {
        if (!_canReadAccounting && expense != null) return;
        SelectedRecurringExpense = expense;
        Bill.LinkedRecurringExpenseId = expense?.Id;
        if (expense != null) Bill.IsBusinessOverhead = false;
        if (expense != null)
        {
            if (string.IsNullOrWhiteSpace(Bill.SupplierName) && !string.IsNullOrWhiteSpace(expense.Supplier))
                Bill.SupplierName = expense.Supplier;
            if (string.IsNullOrWhiteSpace(Bill.GlAccountCode) && !string.IsNullOrWhiteSpace(expense.GlAccountCode))
                Bill.GlAccountCode = expense.GlAccountCode;
            if (expense.IsTaxExempt)
                OnTaxExemptChanged(true);
        }
    }

    private Task<IEnumerable<PurchaseOrder>> SearchPOs(string value, CancellationToken token)
    {
        if (!_canViewPOs || !CanManageBills)
        {
            return Task.FromResult(Enumerable.Empty<PurchaseOrder>());
        }

        var allPos = Db.PurchaseOrders.GetAll().Where(IsPoAccessible);
        if (string.IsNullOrEmpty(value)) return Task.FromResult(allPos.OrderByDescending(p => p.PoNumber).Take(50));
        
        var filtered = allPos.Where(p => 
            p.PoNumber.Contains(value, StringComparison.OrdinalIgnoreCase) || 
            (p.Supplier?.BusinessName?.Contains(value, StringComparison.OrdinalIgnoreCase) == true)
        ).OrderByDescending(p => p.PoNumber);
        
        return Task.FromResult(filtered.AsEnumerable());
    }

    private void OnPoSelected(PurchaseOrder po)
    {
        if (po != null && (!CanManageBills || !IsPoAccessible(po)))
        {
            Snackbar.Add("You do not have permission to link this Purchase Order.", Severity.Error);
            return;
        }
        SelectedPO = po;
        Bill.PurchaseOrderId = po?.Id;
        if (po != null) Bill.IsBusinessOverhead = false;
        if (po != null)
        {
            var linkedBills = Db.Bills.GetByPo(po.Id);
            var totalBilled = linkedBills.Where(b => b.Id != Bill.Id && b.Status != BillStatus.Void).Sum(b => b.Amount);
            var remaining = po.GrandTotal - totalBilled;

            if (string.IsNullOrEmpty(Bill.SupplierName)) Bill.SupplierName = po.Supplier.BusinessName;
            if (Bill.Amount == 0 && remaining > 0)
            {
                if (totalBilled == 0 && po.SubTotal > 0)
                {
                    Bill.SubTotal = po.SubTotal;
                    var poTaxBreakdown = FinancialCalculationEngine.CalculateFromSubTotal(po.SubTotal, po.ApplyTax ? po.TaxRate : 0m);
                    Bill.TpsAmount = poTaxBreakdown.TpsAmount;
                    Bill.TvqAmount = poTaxBreakdown.TvqAmount;
                    Bill.TaxAmount = poTaxBreakdown.TaxAmount;
                    Bill.Amount = po.GrandTotal;
                }
                else
                {
                    OnTotalAmountChanged(remaining);
                }
            }
            if (string.IsNullOrEmpty(Bill.Description)) Bill.Description = $"Invoice for {po.PoNumber}";
        }
    }

    private void AddLineItem()
    {
        Bill.LineItems.Add(new BillLineItem());
    }

    private void AutoFillLineItems()
    {
        if (SelectedPO == null || !CanManageBills || !IsPoAccessible(SelectedPO)) return;
        
        var linkedBills = Db.Bills.GetByPo(SelectedPO.Id);
        var alreadyBilledPoItemIds = linkedBills
            .Where(b => b.Id != Bill.Id && b.Status != BillStatus.Void)
            .SelectMany(b => b.LineItems)
            .Select(li => li.PoItemId)
            .Where(id => !string.IsNullOrEmpty(id))
            .ToHashSet();

        Bill.LineItems.Clear();
        foreach (var item in SelectedPO.LineItems)
        {
            if (alreadyBilledPoItemIds.Contains(item.Id)) continue;

            Bill.LineItems.Add(new BillLineItem
            {
                PoItemId = item.Id,
                Description = item.Description,
                Quantity = item.Quantity,
                UnitPrice = item.UnitPrice
            });
        }

        if (Bill.LineItems.Count == 0)
        {
            Snackbar.Add("All items from this PO have already been billed.", Severity.Info);
        }
        else
        {
            var lineSum = Bill.LineItems.Sum(li => li.Total);
            if (lineSum > 0)
            {
                OnSubTotalChanged(lineSum);
            }
        }
    }

    private async Task RemoveBillAttachment()
