    private async Task Submit()
    {
        var emp = await UserService.GetEmployeeAsync();
        bool canManage = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false);
        bool canApprove = emp != null && emp.HasEffectivePermission(AppPermissions.Purchases.ApproveBills, allowSuspended: false);
        if (!canManage)
        {
            Snackbar.Add("Active Purchases.ManageBills permission is required.", Severity.Error);
            return;
        }

        if (Bill.Status == BillStatus.Void)
        {
            MudDialog.Close(DialogResult.Ok(Bill));
            return;
        }

        bool leavingApproval = (_initialStatus == BillStatus.AwaitingApproval && Bill.Status != BillStatus.AwaitingApproval)
            || Bill.Status == BillStatus.Approved;
        if (leavingApproval && !canApprove)
        {
            Snackbar.Add("Purchases.ApproveBills permission is required to approve this bill.", Severity.Error);
            return;
        }

        if (Bill.BalanceDue <= 0 && Bill.Amount > 0 && !BillStatus.IsSettled(Bill.Status))
        {
            if (_initialStatus == BillStatus.AwaitingApproval && !canApprove)
            {
                Bill.Status = BillStatus.AwaitingApproval;
            }
            else if (Bill.Status != BillStatus.AwaitingApproval || canApprove)
            {
                if (Bill.AmountPaid <= 0m && Bill.HasWriteOffs)
                {
                    Bill.Status = BillStatus.WrittenOff;
                    Bill.DatePaid = null;
                }
                else
                {
                    Bill.Status = BillStatus.Paid;
                    Bill.DatePaid = Bill.DatePaid ?? DateTime.Today;
                }
            }
        }
        else if (BillStatus.IsSettled(Bill.Status) && Bill.BalanceDue > 0)
        {
            Bill.Status = BillStatus.Unpaid;
            if (!Bill.Payments.Any()) Bill.DatePaid = null;
        }
        MudDialog.Close(DialogResult.Ok(Bill));
    }

    private void ApplyTaxIncludedSplit()
    {
        if (Bill.Amount <= 0m) return;
        var breakdown = FinancialCalculationEngine.CalculateFromGrandTotal(Bill.Amount, isTaxExempt: false);
        Bill.IsTaxExempt = false;
        Bill.SubTotal = breakdown.SubTotal;
        Bill.TpsAmount = breakdown.TpsAmount;
        Bill.TvqAmount = breakdown.TvqAmount;
        Bill.TaxAmount = breakdown.TaxAmount;
        Bill.TaxComponents = FinancialCalculationEngine.BuildTaxComponentsFromSubTotal(
            breakdown.SubTotal,
            FinancialCalculationEngine.ActiveTemplate?.SalesTaxes,
            isTaxExempt: false,
            forPurchases: true);
    }

    private void MarkBillTaxExempt()
    {
        Bill.IsTaxExempt = true;
        Bill.SubTotal = Bill.Amount;
        Bill.TpsAmount = 0m;
        Bill.TvqAmount = 0m;
        Bill.TaxAmount = 0m;
        Bill.TaxComponents = [];
    }
