    private async Task SubscribeDevice()
    {
        if (IsLoading) return;
        IsLoading = true;
        _debugLogs.Clear();
        AddSubscriptionLog("Starting subscription process...");
        StateHasChanged();

        try
        {
            // 1. Request permission
            AddSubscriptionLog("Requesting permission...");
            var permResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.requestPermission", _objRef);
            var permission = permResult?.GetValueOrDefault("permission")?.ToString() ?? "denied";

            if (permission != "granted")
            {
                AddSubscriptionLog($"Permission denied. Result: {permission}", true);
                Snackbar.Add("Notification permission was denied. Enable in browser settings.", Severity.Warning);
                return;
            }
            AddSubscriptionLog("Permission granted.");

            // 2. Register service worker
            AddSubscriptionLog("Registering service worker...");
            var swResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.registerServiceWorker");
            var swSuccess = swResult?.GetValueOrDefault("success")?.ToString() == "True";

            if (!swSuccess)
            {
                var swErr = swResult?.GetValueOrDefault("error")?.ToString();
                AddSubscriptionLog($"SW registration failed: {swErr}", true);
                Snackbar.Add("Failed to register service worker.", Severity.Error);
                return;
            }
            AddSubscriptionLog("Service worker registered.");

            // 3. Get VAPID public key
            var profile = Db.CompanyProfile.Get();
            if (string.IsNullOrEmpty(profile?.VapidPublicKey))
            {
                AddSubscriptionLog("VAPID public key not found.", true);
                Snackbar.Add("Push notifications not configured.", Severity.Error);
                return;
            }
            AddSubscriptionLog("VAPID public key retrieved.");

            // 4. Subscribe to push
            AddSubscriptionLog("Subscribing to push manager/native APNs...");
            var subscription = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.subscribe",
                profile.VapidPublicKey, _objRef);

            if (subscription == null || !subscription.ContainsKey("endpoint"))
            {
                var subErr = subscription?.GetValueOrDefault("error")?.ToString() ?? "Unknown error";
                AddSubscriptionLog($"Subscription failed: {subErr}", true);
                Snackbar.Add("Failed to subscribe to push notifications.", Severity.Error);
                return;
            }
            AddSubscriptionLog("Push subscription successful.");

            // 4.5 Request Idle Permission if Desktop
            bool isIdleEnabled = false;
            if (_newDeviceType == "Desktop")
            {
                AddSubscriptionLog("Requesting idle tracking permission...");
                isIdleEnabled = await JS.InvokeAsync<bool>("pushNotifications.requestIdlePermission");
                AddSubscriptionLog($"Idle permission: {isIdleEnabled}");
            }

            // 5. Send to server with device info
            AddSubscriptionLog("Sending subscription to server...");
            var result = await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer",
                subscription, _newDeviceType, _newDeviceName, isIdleEnabled);

            if (result)
            {
                AddSubscriptionLog("Subscription saved on server.");
                IsSubscribed = true;
                _currentEndpoint = subscription.GetValueOrDefault("endpoint")?.ToString();
                Snackbar.Add("Push notifications enabled!", Severity.Success);
                await LoadDevices();
                StateHasChanged();

                if (isIdleEnabled)
                {
                    try
                    {
                        await JS.InvokeAsync<bool>("pushNotifications.startIdleDetector");
                    }
                    catch { /* Ignore if browser does not support it */ }
                }
            }
            else
            {
                AddSubscriptionLog("Server failed to save subscription.", true);
                Snackbar.Add("Failed to save subscription.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            AddSubscriptionLog($"Exception: {ex.Message}", true);
            Console.WriteLine($"Error enabling notifications: {ex.Message}");
            Snackbar.Add("Error enabling notifications.", Severity.Error);
        }
        finally
        {
            AddSubscriptionLog("Finished.");
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task UnsubscribeDevice()
    {
        if (IsLoading) return;
        IsLoading = true;
        StateHasChanged();

        try
        {
            var result = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.unsubscribeAndNotifyServer");
            var success = result?.GetValueOrDefault("success")?.ToString() == "True";

            if (success)
            {
                IsSubscribed = false;
                _currentEndpoint = null;
                Snackbar.Add("Push notifications disabled on this device.", Severity.Success);
                await LoadDevices();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add("Failed to disable notifications.", Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error: {ex.Message}", Severity.Error);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

