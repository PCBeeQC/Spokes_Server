    private async Task ToggleDeviceEnabled(string deviceId, bool enabled)
    {
        try
        {
            var enabledStr = enabled ? "true" : "false";
            await JS.InvokeAsync<dynamic>("eval", $@"
                (async () => {{
                    var hdrs = await window.spokesAuth.getHeaders({{ 'Content-Type': 'application/json' }});
                    await fetch('/spokesapi/push/devices/{deviceId}', {{
                        method: 'PUT',
                        headers: hdrs,
                        body: JSON.stringify({{ isEnabled: {enabledStr} }})
                    }});
                }})()
            ");

            var device = _devices.FirstOrDefault(d => d.Id == deviceId);
            if (device != null) device.IsEnabled = enabled;
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating device: {ex.Message}", Severity.Error);
        }
    }

    private async Task ToggleDeviceIdleDetection(string deviceId, bool enabled)
    {
        try
        {
            var enabledStr = enabled ? "true" : "false";
            await JS.InvokeAsync<dynamic>("eval", $@"
                (async () => {{
                    var hdrs = await window.spokesAuth.getHeaders({{ 'Content-Type': 'application/json' }});
                    await fetch('/spokesapi/push/devices/{deviceId}', {{
                        method: 'PUT',
                        headers: hdrs,
                        body: JSON.stringify({{ isIdleDetectionEnabled: {enabledStr} }})
                    }});
                }})()
            ");

            var device = _devices.FirstOrDefault(d => d.Id == deviceId);
            if (device != null) device.IsIdleDetectionEnabled = enabled;

            if (device?.Endpoint == _currentEndpoint)
            {
                if (enabled)
                {
                    await JS.InvokeAsync<bool>("pushNotifications.startIdleDetector");
                }
                else
                {
                    await JS.InvokeVoidAsync("pushNotifications.stopIdleDetector");
                }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error updating device idle tracking: {ex.Message}", Severity.Error);
        }
    }

    private async Task DeleteDevice(string sessionId)
    {
        try
        {
            // Clear push fields from the DeviceSession (via API for auth)
            await JS.InvokeAsync<dynamic>("eval", $@"
                (async () => {{
                    var hdrs = await window.spokesAuth.getHeaders();
                    await fetch('/spokesapi/push/devices/{sessionId}', {{
                        method: 'DELETE',
                        headers: hdrs
                    }});
                }})()
            ");

            var device = _devices.FirstOrDefault(d => d.Id == sessionId);
            if (device != null)
            {
                device.HasPush = false;
                device.IsEnabled = false;
            }

            // If we deleted the current device's subscription
            if (sessionId == _currentSessionId)
            {
                // The server-side push data is cleared, but the browser push subscription may still exist.
                // Unsubscribe locally too.
                await JS.InvokeAsync<object>("pushNotifications.unsubscribe");
                IsSubscribed = false;
                _currentEndpoint = null;
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error deleting device: {ex.Message}", Severity.Error);
        }
    }

