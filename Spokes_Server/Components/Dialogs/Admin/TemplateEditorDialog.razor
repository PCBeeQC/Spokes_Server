                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_FinancialStatements" Label="Header: Financial Statements Title" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_FinancialStatementsSubtitle" Label="Header: Financial Statements Subtitle" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_IncomeStatementSection" Label="Section: Income Statement (P&L)" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_BalanceSheetSection" Label="Section: Balance Sheet" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_CashFlowSection" Label="Section: Cash Flow Statement" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_FinancialRatiosSection" Label="Section: Financial Ratios" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_ManagementNotesSection" Label="Section: Management Notes" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_BasisOfPresentationTitle" Label="Header: Notice to Reader / Basis" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="Template.Label_BasisOfPresentationDefault"
                                          Label="Default Notice to Reader / Basis of Presentation Disclaimer"
                                          Lines="2" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Content Defaults">
                    <MudText Typo="Typo.body2" Class="mb-4">Set the default text and presets that appear on new quotes and invoices.</MudText>

                    <MudGrid>
                        <MudItem xs="12" sm="8">
                            <MudSelect T="string" Label="Terms & Conditions Preset"
                                       @bind-Value="Template.DefaultTermsAndConditionsId"
                                       Variant="Variant.Outlined" Clearable="true"
                                       HelperText="Select which terms & conditions will be copied to new quotes.">
                                <MudSelectItem T="string" Value="@("")">None (No default terms)</MudSelectItem>
                                @foreach (var term in AvailableTerms)
                                {
                                    <MudSelectItem T="string" Value="@term.Id">
                                        @term.Name @(term.IsDefault ? "(Default)" : "")
                                    </MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="d-flex align-center">
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.Add"
                                       OnClick="CreateNewTermsQuick">
                                New Preset
                            </MudButton>
                        </MudItem>

                        @if (SelectedTerms != null)
                        {
                            <MudItem xs="12">
                                <MudPaper Class="pa-3" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                                    <div class="d-flex justify-space-between align-center mb-1">
                                        <MudText Typo="Typo.caption" Style="font-weight: 600;">PREVIEW: @SelectedTerms.Name</MudText>
                                    </div>
                                    <div class="markdown-preview" style="font-size: 0.85rem; max-height: 140px; overflow-y: auto; color: var(--mud-palette-text-primary);">
                                        @RenderMarkdown(SelectedTerms.Content)
                                    </div>
                                </MudPaper>
                            </MudItem>
                        }
                        else if (!string.IsNullOrWhiteSpace(Template.DefaultTermsAndConditions))
                        {
                            <MudItem xs="12">
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-2">
                                    This template has unlinked custom text in Default Terms & Conditions.
                                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="ConvertLegacyToPreset" Class="ml-2">
                                        Save as Preset
                                    </MudButton>
                                </MudAlert>
                            </MudItem>
                        }

                        <MudItem xs="12">
                            <MudCheckBox @bind-Value="Template.TermsStartOnNewPage" Label="Always start Terms & Conditions on a new page" Color="Color.Primary" Class="mt-2" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Template.DefaultPaymentTerms" Label="Default Payment Terms"
                                Lines="4" Variant="Variant.Outlined"
                                HelperText="This text will be copied to new invoices automatically." />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Template.DefaultCostPlusTerms" Label="Cost+ Billing Explanation"
                                HelperText="Displayed instead of Payment Schedule if no milestones are defined (Supports Markdown)."
                                Lines="4" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Save Template</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public DocumentTemplate Template { get; set; } = default!;
    
    private List<string> TaskLanguages = [];
    private List<TermsAndConditions> AvailableTerms = [];
    private List<(string Code, string DefaultLabel)> _taxRegistrationFields = [];

    private TermsAndConditions? SelectedTerms =>
        AvailableTerms.FirstOrDefault(t => t.Id == Template.DefaultTermsAndConditionsId);

    protected override void OnInitialized()
    {
        var profile = CompanyProfile.Get();
        TaskLanguages = profile?.TaskTranslationLanguages ?? [];
        AvailableTerms = Db.TermsAndConditions.GetAll().OrderBy(t => t.Name).ToList();
        BuildTaxRegistrationFields(profile);

        if (string.IsNullOrEmpty(Template.DefaultTermsAndConditionsId) && !string.IsNullOrEmpty(Template.DefaultTermsAndConditions))
        {
            var match = AvailableTerms.FirstOrDefault(t => t.Content.Trim() == Template.DefaultTermsAndConditions.Trim());
            if (match != null)
            {
                Template.DefaultTermsAndConditionsId = match.Id;
            }
        }
    }

    private void BuildTaxRegistrationFields(Spokes_Server.Core.Models.Core.CompanyProfile? profile)
    {
        _taxRegistrationFields.Clear();
        var seen = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

        var activeTemplate = JurisdictionService.GetActiveTemplate();
        if (activeTemplate.SalesTaxes != null)
        {
            foreach (var tax in activeTemplate.SalesTaxes)
            {
                if (string.IsNullOrWhiteSpace(tax.Code) || !seen.Add(tax.Code)) continue;
                var defaultLabel = !string.IsNullOrWhiteSpace(tax.RegistrationNumberLabel)
                    ? tax.RegistrationNumberLabel
                    : tax.Code;
                _taxRegistrationFields.Add((tax.Code, defaultLabel));
            }
        }

        if (profile?.Accounting?.TaxRegistrationNumbersByCode != null)
        {
            foreach (var code in profile.Accounting.TaxRegistrationNumbersByCode.Keys)
            {
                if (!string.IsNullOrWhiteSpace(code) && seen.Add(code))
                    _taxRegistrationFields.Add((code, code));
            }
        }

        if (Template.TaxRegistrationLabelsByCode != null)
        {
            foreach (var code in Template.TaxRegistrationLabelsByCode.Keys)
            {
                if (!string.IsNullOrWhiteSpace(code) && seen.Add(code))
                    _taxRegistrationFields.Add((code, code));
            }
        }
    }

    private string GetTaxRegistrationLabel(string code)
    {
        var labels = Template.TaxRegistrationLabelsByCode;
        if (labels == null || labels.Count == 0 || string.IsNullOrWhiteSpace(code))
            return string.Empty;

        if (labels.TryGetValue(code, out var exact))
            return exact ?? string.Empty;

        foreach (var kvp in labels)
        {
            if (string.Equals(kvp.Key, code, StringComparison.OrdinalIgnoreCase))
                return kvp.Value ?? string.Empty;
        }

        return string.Empty;
    }

    private void SetTaxRegistrationLabel(string code, string? value)
    {
        Template.TaxRegistrationLabelsByCode ??= new(StringComparer.OrdinalIgnoreCase);
        var staleKeys = Template.TaxRegistrationLabelsByCode.Keys
            .Where(k => string.Equals(k, code, StringComparison.OrdinalIgnoreCase) && !string.Equals(k, code, StringComparison.Ordinal))
            .ToList();
        foreach (var staleKey in staleKeys)
            Template.TaxRegistrationLabelsByCode.Remove(staleKey);

        if (string.IsNullOrWhiteSpace(value))
            Template.TaxRegistrationLabelsByCode.Remove(code);
        else
            Template.TaxRegistrationLabelsByCode[code] = value.Trim();
    }

    private async Task<bool> AuthorizeSettingsMutationAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp is not { IsActiveUnsuspended: true }
            || !emp.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Business.ManageSettings))
        {
            Snackbar.Add("Your account is read-only or lacks permission to modify templates.", Severity.Error);
            return false;
        }
        return true;
    }

    private Task CreateNewTermsQuick() =>
        OpenTermsPresetDialogAsync(
            "New Terms & Conditions",
            !string.IsNullOrWhiteSpace(Template.DefaultTermsAndConditions)
                ? Template.DefaultTermsAndConditions
                : "");

    private Task ConvertLegacyToPreset() =>
        OpenTermsPresetDialogAsync(
            "Save as Terms & Conditions Preset",
            Template.DefaultTermsAndConditions,
            "Converted to Terms & Conditions preset");

    private async Task OpenTermsPresetDialogAsync(string dialogTitle, string initialContent, string? successSnackbar = null)
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        var newTerms = new TermsAndConditions
        {
            Name = $"{Template.Name} Terms",
            Content = initialContent
        };
        var parameters = new DialogParameters { ["Item"] = newTerms, ["IsNew"] = true };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TermsAndConditionsDialog>(dialogTitle, parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is TermsAndConditions created)
        {
            AvailableTerms = Db.TermsAndConditions.GetAll().OrderBy(t => t.Name).ToList();
            Template.DefaultTermsAndConditionsId = created.Id;
            Template.DefaultTermsAndConditions = created.Content;
            if (!string.IsNullOrEmpty(successSnackbar))
            {
                Snackbar.Add(successSnackbar, Severity.Success);
            }
            StateHasChanged();
        }
    }

    private MarkupString RenderMarkdown(string? text)
    {
        if (string.IsNullOrWhiteSpace(text)) return new MarkupString("");
        try
        {
            var html = MarkdownSanitizer.RenderSanitizedHtml(text);
            return new MarkupString(html);
        }
        catch
        {
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text));
        }
    }

    private void Cancel() => MudDialog.Cancel();
    private async Task Submit()
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        if (SelectedTerms != null)
        {
            Template.DefaultTermsAndConditions = SelectedTerms.Content;
        }
        MudDialog.Close(DialogResult.Ok(Template));
    }
}
