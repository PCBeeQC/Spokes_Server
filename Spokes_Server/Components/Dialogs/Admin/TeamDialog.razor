@inject AppLabelService AppLabels

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudGrid>
                <MudItem xs="12" sm="6">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Team.Name" Label="@string.Format(Loc["{0} Name"].Value, AppLabels.Team)" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudColorPicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Label="@string.Format(Loc["{0} Color"].Value, AppLabels.Team)" @bind-Text="Team.Color" Style="@($"color: {Team.Color};")" />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Team.Description" Label="@Loc["Description"]" />
                </MudItem>
                <MudItem xs="12">
                    @if (LockLeader)
                    {
                        <MudTextField T="string" Value="@LockedLeaderLabel" Label="@string.Format(Loc["{0} Leader"].Value, AppLabels.Team)" Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Disabled="true" />
                    }
                    else
                    {
                        <MudSelect Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" T="string" @bind-Value="Team.LeaderId" Label="@string.Format(Loc["{0} Leader"].Value, AppLabels.Team)" Clearable="true">
                            @foreach (var emp in Employees)
                            {
                                <MudSelectItem Value="@emp.Id">@emp.FullName</MudSelectItem>
                            }
                        </MudSelect>
                    }
                </MudItem>

                <!-- Member Picker -->
                <MudItem xs="12">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@string.Format(Loc["{0} Members"].Value, AppLabels.Team)</MudText>
                    <EmployeeMultiPicker Employees="@Employees"
                                         @bind-SelectedUserIds="SelectedMemberIds"
                                         ExcludeCurrentUser="false"
                                         ChipColor="Color.Default"
                                         Label="@Loc["Add Member"]" />
                </MudItem>

            </MudGrid>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@Loc["Save"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Team Team { get; set; } = default!;
    [Parameter] public List<Employee> Employees { get; set; } = [];
    [Parameter] public bool LockLeader { get; set; }
    [Parameter] public string LockedLeaderLabel { get; set; } = string.Empty;

    private MudForm form = default!;
    private bool success;
    private List<string> SelectedMemberIds { get; set; } = [];

    protected override void OnInitialized()
    {
        // Initialize members who are currently in this team
        SelectedMemberIds = Employees.Where(e => e.TeamId == Team.Id).Select(e => e.Id).ToList();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (success)
        {
            MudDialog.Close(DialogResult.Ok(new TeamDialogResult 
            { 
                Team = Team, 
                MemberIds = SelectedMemberIds.ToList() 
            }));
        }
    }

    public class TeamDialogResult
    {
        public Team Team { get; set; } = new();
        public List<string> MemberIds { get; set; } = [];
    }
}

