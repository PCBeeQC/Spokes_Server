@inject AppLabelService AppLabels

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center">
            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Class="mr-3" />
            <MudText Typo="Typo.h6">@Loc["Change Identity Provider?"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-4">
            <b>@Loc["WARNING:"]</b> @Loc["Switching the Identity Provider will change the underlying user identifiers (OIDC Subject) for all users."]
        </MudAlert>
        <MudText Typo="Typo.body1" Class="mb-4">
            @string.Format(Loc["All current users will lose access until their new provider identities are manually re-linked to their {0} profiles."].Value, AppLabels.Employee.ToLower())
        </MudText>
        <MudText Typo="Typo.body1" Class="mb-4">
            @Loc["As an administrator, you may also be locked out and require database access or alternative methods to restore your own privileges."]
        </MudText>
        <MudText Typo="Typo.subtitle1" Color="Color.Error"><b>@Loc["Are you absolutely sure you want to proceed?"]</b></MudText>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Loc["Close"]</MudButton>
        <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="Confirm">@Loc["Change Provider"]</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    private void Close() => MudDialog.Cancel();
    private void Confirm() => MudDialog.Close(DialogResult.Ok(true));
}
