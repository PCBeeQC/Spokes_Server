@implements IBackDismissHandler
@implements IDisposable
@inject BackupService BackupSvc
@inject BackupRestoreUploadService BackupUploadSvc
@inject IJSRuntime JS
@inject ILogger<RestoreBackupDialog> Logger
@inject Spokes_Server.Core.Services.Identity.UserService UserService

<MudDialog>
    <DialogContent>
        <div class="d-flex flex-column align-center text-center px-4 py-6">
            @if (CurrentState == State.Confirming)
            {
                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Style="font-size: 64px;" Class="mb-4" />
                <MudText Typo="Typo.h5" GutterBottom="true">@Loc["Restore Backup?"]</MudText>
                <MudText Typo="Typo.body1" Class="mb-4">
                    @((MarkupString)string.Format(Loc["Are you sure you want to restore from <b>{0}</b>?"].Value, System.Net.WebUtility.HtmlEncode(EffectiveBackupName)))
                </MudText>
                @if (ExistingBackup != null)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                        @Loc["Size:"] @FileHelper.FormatBytes(ExistingBackup.SizeBytes) • @Loc["Created:"] @ExistingBackup.CreatedAt.ToString("g")
                    </MudText>
                }
                else if (PendingFileSizeBytes > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-3">
                        @Loc["Size:"] @FileHelper.FormatBytes(PendingFileSizeBytes)
                    </MudText>
                }
                <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2">
                    <b>@Loc["WARNING:"]</b> @Loc["All current data will be overwritten and lost. This action cannot be undone."]
                </MudAlert>
            }
            else if (CurrentState == State.Uploading)
            {
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Color="Color.Primary" Style="font-size: 64px;" Class="mb-4" />
                <MudText Typo="Typo.h5" GutterBottom="true">@Loc["Uploading Backup"]</MudText>
                <MudProgressLinear Color="Color.Primary" Value="@UploadProgress" Class="my-4" Size="Size.Large" />
                <MudText Typo="Typo.h6" Color="Color.Primary">@Math.Round(UploadProgress)%</MudText>
                @if (UploadTotalBytes > 0)
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">
                        @FileHelper.FormatBytes(UploadedBytes) / @FileHelper.FormatBytes(UploadTotalBytes)
                    </MudText>
                }
            }
            else if (CurrentState == State.Restoring)
            {
                <MudIcon Icon="@Icons.Material.Filled.SettingsBackupRestore" Color="Color.Primary" Style="font-size: 64px;" Class="mb-4" />
                <MudText Typo="Typo.h5" GutterBottom="true">@Loc["Restoring Database"]</MudText>
                <MudProgressLinear Color="Color.Primary" Value="@RestoreProgress" Class="my-4" Size="Size.Large" />
                <MudText Typo="Typo.h6" Color="Color.Primary">@RestoreStage (@RestoreProgress%)</MudText>
                @if (!string.IsNullOrEmpty(RestoreDetail))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1" Style="max-width: 320px; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;">
                        @RestoreDetail
                    </MudText>
                }
            }
            else if (CurrentState == State.Error)
            {
                <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Error" Style="font-size: 64px;" Class="mb-4" />
                <MudText Typo="Typo.h5" GutterBottom="true">@Loc["Restore Failed"]</MudText>
                <MudText Typo="Typo.body1" Color="Color.Error">@ErrorMessage</MudText>
            }
        </div>
    </DialogContent>
    <DialogActions>
        @if (CurrentState == State.Confirming)
        {
            <MudButton OnClick="Close" Variant="Variant.Text">@Loc["Close"]</MudButton>
            <MudButton Color="Color.Error" Variant="Variant.Filled" OnClick="StartRestore">@Loc["I Understand, Restore"]</MudButton>
        }
        else if (CurrentState == State.Uploading)
        {
            <MudButton OnClick="CancelUploadAsync" Color="Color.Default" Variant="Variant.Text">@Loc["Cancel Upload"]</MudButton>
        }
        else if (CurrentState == State.Error)
        {
            <MudButton OnClick="Close" Color="Color.Primary" Variant="Variant.Filled">@Loc["Close"]</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string? PendingFileToken { get; set; }
    [Parameter] public string? PendingFileName { get; set; }
    [Parameter] public long PendingFileSizeBytes { get; set; }
    [Parameter] public BackupFileInfo? ExistingBackup { get; set; }

    private enum State { Confirming, Uploading, Restoring, Error }
    private State CurrentState = State.Confirming;
    private double UploadProgress = 0;
    private long UploadedBytes = 0;
    private long UploadTotalBytes = 0;
    private int RestoreProgress = 0;
    private string RestoreStage = "Preparing...";
    private string? RestoreDetail;
    private string ErrorMessage = "";
    private string? _authorizedAdminId;
    private bool _isDisposed;
    private DotNetObjectReference<RestoreBackupDialog>? _dotNetRef;

    private string EffectiveBackupName =>
        !string.IsNullOrWhiteSpace(PendingFileName) ? PendingFileName! : ExistingBackup?.FileName ?? "backup";

    public Task<BackDismissAction> OnBackRequestedAsync() =>
        Task.FromResult(CurrentState is State.Uploading or State.Restoring
            ? BackDismissAction.Block
            : BackDismissAction.DefaultCancel);

    private async Task<bool> EnsureAuthorizedAdminAsync()
    {
        var caller = await UserService.GetEmployeeAsync();
        if (caller is { IsActiveUnsuspended: true } && caller.IsEffectiveAdmin)
        {
            _authorizedAdminId = caller.Id;
            return true;
        }

        ErrorMessage = Loc["Administrator access is required."].Value;
        CurrentState = State.Error;
        return false;
    }

    protected override async Task OnInitializedAsync()
    {
        _dotNetRef = DotNetObjectReference.Create(this);
        await EnsureAuthorizedAdminAsync();
    }

    private async Task Close()
    {
        await ReleasePendingFileAsync();
        MudDialog.Cancel();
    }

    private async Task ReleasePendingFileAsync()
    {
        if (!string.IsNullOrWhiteSpace(PendingFileToken))
        {
            var token = PendingFileToken;
            PendingFileToken = null;
            try { await JS.InvokeVoidAsync("window.spokesUpload.chunked.releaseFile", token); } catch { }
        }
    }

    private async Task CancelUploadAsync()
    {
        if (!string.IsNullOrWhiteSpace(PendingFileToken))
        {
            try { await JS.InvokeVoidAsync("window.spokesUpload.chunked.cancelUpload", PendingFileToken); } catch { }
        }
    }

    private async Task StartRestore()
    {
        if (!await EnsureAuthorizedAdminAsync())
        {
            StateHasChanged();
            return;
        }

        if (!string.IsNullOrWhiteSpace(PendingFileToken))
        {
            CurrentState = State.Uploading;
            UploadProgress = 0;
            UploadedBytes = 0;
            UploadTotalBytes = PendingFileSizeBytes;
            StateHasChanged();

            try
            {
                await JS.InvokeVoidAsync(
                    "window.spokesUpload.chunked.startUpload",
                    PendingFileToken,
                    "/spokesapi/backups/restore-upload",
                    _dotNetRef,
                    new { chunkSizeBytes = BackupRestoreUploadService.DefaultChunkSizeBytes });
            }
            catch (Exception ex)
            {
                ErrorMessage = ex.Message;
                CurrentState = State.Error;
                StateHasChanged();
            }
            return;
        }

        var targetFilePath = ExistingBackup?.FilePath;
        if (string.IsNullOrEmpty(targetFilePath) || !System.IO.File.Exists(targetFilePath))
        {
            ErrorMessage = Loc["Backup file not found."].Value;
            CurrentState = State.Error;
            StateHasChanged();
            return;
        }

        await ExecuteRestoreAsync(progress => BackupSvc.RestoreBackupAsync(targetFilePath, Logger, progress: progress));
    }

    [JSInvokable]
    public void OnChunkedUploadProgress(double percent, long uploadedBytes, long totalBytes)
    {
        if (_isDisposed || CurrentState != State.Uploading) return;
        UploadProgress = percent;
        UploadedBytes = uploadedBytes;
        UploadTotalBytes = totalBytes;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnChunkedUploadCompleted(string uploadId)
    {
        if (_isDisposed) return;
        PendingFileToken = null;

        if (!await EnsureAuthorizedAdminAsync())
        {
            StateHasChanged();
            return;
        }

        await ExecuteRestoreAsync(progress =>
            BackupUploadSvc.RestoreStagedUploadAsync(uploadId, BackupUploadScope.Admin, _authorizedAdminId, Logger, progress: progress));
    }

    [JSInvokable]
    public void OnChunkedUploadCancelled()
    {
        if (_isDisposed) return;
        PendingFileToken = null;
        MudDialog.Cancel();
    }

    [JSInvokable]
    public void OnChunkedUploadError(string errorMessage)
    {
        if (_isDisposed) return;
        PendingFileToken = null;
        ErrorMessage = string.IsNullOrWhiteSpace(errorMessage) ? Loc["Failed to restore backup."].Value : errorMessage;
        CurrentState = State.Error;
        StateHasChanged();
    }

    private async Task ExecuteRestoreAsync(Func<IProgress<BackupRestoreProgress>, Task<BackupRestoreResult>> restoreAction)
    {
        try
        {
            CurrentState = State.Restoring;
            RestoreStage = Loc["Initializing restore..."].Value;
            RestoreProgress = 0;
            RestoreDetail = null;
            StateHasChanged();

            var progress = new Progress<BackupRestoreProgress>(p =>
            {
                if (_isDisposed) return;
                RestoreStage = p.Stage;
                RestoreProgress = p.Percentage;
                RestoreDetail = p.Detail;
                _ = InvokeAsync(StateHasChanged);
            });

            var restoreResult = await restoreAction(progress);
            if (_isDisposed) return;

            if (restoreResult.Success)
            {
                MudDialog.Close(DialogResult.Ok(restoreResult.CasdoorRestarted));
            }
            else
            {
                ErrorMessage = restoreResult.ErrorMessage ?? Loc["Failed to restore backup."].Value;
                CurrentState = State.Error;
                StateHasChanged();
            }
        }
        catch (Exception ex)
        {
            if (_isDisposed) return;
            ErrorMessage = ex.Message;
            CurrentState = State.Error;
            StateHasChanged();
        }
    }

    public void Dispose()
    {
        _isDisposed = true;
        _dotNetRef?.Dispose();
    }
}
