@using System.Text.Json
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.UI
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Shared
@using MudBlazor
@inject Database Db
@inject ISnackbar Snackbar
@inject UserService UserService
@inject IUserPrivacyService PrivacyService
@inject AppLabelService AppLabels

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTabs Elevation="0" Outlined="true" Border="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">

                <MudTabPanel Text="Details">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="_draft.ProjectNumber" Label="Project Number / ID" Required="true" Variant="Variant.Outlined" 
                                          OnBlur="CheckDuplicateId" Error="@idExists" ErrorText="This Project ID is already in use." />
                        </MudItem>
                        <MudItem xs="8">
                            <MudTextField @bind-Value="_draft.Name" Label="Project Name" Required="true" Variant="Variant.Outlined" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="_draft.Description" Label="Scope / Description" Lines="3" Variant="Variant.Outlined" />
                        </MudItem>


                        <MudItem xs="12">
                            <MudSwitch @bind-Value="_draft.IsInternal" Label="Internal Project (No Client)" Color="Color.Primary" />
                            @if (_draft.IsInternal)
                            {
                                    <MudAlert Severity="Severity.Info" Dense="true" Class="mt-2">Internal projects are for tracking company costs (e.g. R&D, Time Off). No invoices created.</MudAlert>
                            }
                        </MudItem>

                        <MudItem xs="6">
                            <MudSelect T="string" Label="Billing Rate Card" @bind-Value="_draft.RateCardId" Clearable="true" HelperText="Leave empty for Standard Rates" Variant="Variant.Outlined">
                                @foreach (var card in Db.RateCards.GetAll().Where(r => r.IsActive))
                                {
                                        <MudSelectItem Value="@card.Id">@card.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="6">
                            <MudSelect T="string" Label="Document Template" @bind-Value="_draft.DefaultTemplateId" HelperText="Determines language, tax & banking info" Variant="Variant.Outlined">
                                @foreach (var t in Templates)
                                {
                                        <MudSelectItem Value="@t.Id">@t.Name @(t.IsDefault ? "(System Default)" : "")</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSelect T="string" Label="Status" @bind-Value="_draft.Status" Variant="Variant.Outlined">
                                @foreach (var status in AvailableStatuses)
                                {
                                    <MudSelectItem Value="@status.Name">@status.Name</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSelect T="string" Label="Project Manager" @bind-Value="_draft.ProjectManagerId" Clearable="true" Variant="Variant.Outlined">
                                @if (!string.IsNullOrEmpty(_draft.ProjectManagerId) && Employees.All(e => e.Id != _draft.ProjectManagerId))
                                {
                                    var hiddenOrInactivePm = Db.Employees.GetById(_draft.ProjectManagerId);
                                    if (hiddenOrInactivePm != null)
                                    {
                                        var pmLabel = _currentUser != null && PrivacyService.CanDiscoverUser(_currentUser, hiddenOrInactivePm)
                                            ? hiddenOrInactivePm.FullName
                                            : AppLabels.Employee;
                                        <MudSelectItem Value="@_draft.ProjectManagerId">@pmLabel</MudSelectItem>
                                    }
                                }
                                @foreach (var emp in Employees)
                                {
                                        <MudSelectItem Value="@emp.Id">@emp.FullName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Client Info" Disabled="@_draft.IsInternal">
                    <MudGrid>
                        <MudItem xs="12">
                            <CompanyContactSelector 
                                Label="Select Client"
                                ContactLabel="Select Contact Person"
                                Icon="@Icons.Material.Filled.Search"
                                HelperText="Search your address book..."
                                InitialCompanyName="@_draft.Client.BusinessName"
                                InitialContactName="@_draft.Client.ContactPersonName"
                                SelectedCompanyChanged="OnClientSelected"
                                SelectedContactChanged="OnContactSelected"
                                Required="true" />
                        </MudItem>

                        <MudItem xs="3">
                            <MudTextField @bind-Value="_draft.Client.ContactPersonPrefix" Label="Prefix" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="9">
                            <MudTextField @bind-Value="_draft.Client.ContactPersonName" Label="Contact Person" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="_draft.Client.ContactPersonEmail" Label="Email" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="_draft.Client.ContactPersonPhone" Label="Phone" ReadOnly="true" Variant="Variant.Filled" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField Value="@FullAddress" Label="Billing Address" ReadOnly="true" Variant="Variant.Filled" Lines="2" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Overrides" Icon="@Icons.Material.Filled.Discount">
                    <MudText Typo="Typo.body2" Class="mb-4">Project-specific rate overrides can be configured here. These rates will be used instead of the standard or rate card prices.</MudText>

                    <MudTable Elevation="0" Outlined="true" Items="@_draft.CustomRates.ToList()" Dense="true" Hover="true">
                        <HeaderContent>
                            <MudTh>Work Type</MudTh>
                            <MudTh>Override Rate ($/h)</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                @{
                                    var wt = WorkTypes.FirstOrDefault(w => w.Id == context.Key);
                                }
                                @(wt?.Name ?? "Unknown Task")
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal" Value="@context.Value" 
                                                 ValueChanged="@((v) => _draft.CustomRates[context.Key] = v)"
                                                 Format="N2" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                               OnClick="@(() => { _draft.CustomRates.Remove(context.Key); StateHasChanged(); })" />
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="3">
                                <div class="d-flex gap-2">
                                    <MudSelect T="string" @bind-Value="newOverrideWorkTypeId" Label="Add Override for..." Dense="true" Margin="Margin.Dense">
                                        @foreach (var wt in WorkTypes.Where(w => !_draft.CustomRates.ContainsKey(w.Id)))
                                        {
                                                <MudSelectItem Value="@wt.Id">@wt.Name</MudSelectItem>
                                        }
                                    </MudSelect>
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddOverride" Color="Color.Primary" Disabled="@(string.IsNullOrEmpty(newOverrideWorkTypeId))">Add</MudButton>
                                </div>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="Commissions">
                    <MudText Typo="Typo.body2" Class="mb-4">Configure who receives a commission when this project is completed and paid.</MudText>

                    <MudTable Items="@_draft.Commissions" Hover="true" Dense="true" Elevation="0" Outlined="true">
                        <HeaderContent>
                            <MudTh>Name</MudTh>
                            <MudTh>Type</MudTh>
                            <MudTh>Basis</MudTh>
                            <MudTh>Percentage</MudTh>
                            <MudTh>Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            @{
                                var isHiddenInternalRow = context.Type == "Internal" && IsUndiscoverableEmployee(context.EmployeeId);
                            }
                            <MudTd>
                                @if (isHiddenInternalRow)
                                {
                                    <MudTextField Value="@AppLabels.Employee" Label="Select Employee" ReadOnly="true" Disabled="true" Margin="Margin.Dense" />
                                }
                                else if (context.Type == "Internal")
                                {
                                        <MudSelect T="string" Value="@context.EmployeeId" 
                                                   ValueChanged="@((id) => OnInternalBeneficiarySelected(context, id))"
                                                   Label="Select Employee" Margin="Margin.Dense" Dense="true">
                                        @foreach (var emp in Employees)
                                        {
                                                    <MudSelectItem Value="@emp.Id">@emp.FullName</MudSelectItem>
                                        }
                                        </MudSelect>
                                }
                                else
                                {
                                        <MudTextField @bind-Value="context.Name" Label="Beneficiary Name" Margin="Margin.Dense" />
                                }
                            </MudTd>
                            <MudTd>
                                <MudSelect @bind-Value="context.Type" Label="Type" Margin="Margin.Dense" Dense="true" Disabled="@isHiddenInternalRow">
                                    <MudSelectItem Value="@("Internal")">Internal</MudSelectItem>
                                    <MudSelectItem Value="@("External")">External</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect @bind-Value="context.CommissionBasis" Label="Basis" Margin="Margin.Dense" Dense="true" Disabled="@isHiddenInternalRow">
                                    <MudSelectItem Value="@("Revenue")">Revenue</MudSelectItem>
                                    <MudSelectItem Value="@("Margin")">Gross Margin</MudSelectItem>
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudNumericField @bind-Value="context.Percentage" Label="%" Min="0" Max="100" Margin="Margin.Dense" Disabled="@isHiddenInternalRow" />
                            </MudTd>
                            <MudTd>
                                @if (!isHiddenInternalRow)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => _draft.Commissions.Remove(context))" />
                                }
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="5">
                                <div class="d-flex justify-space-between align-center">
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddCommission" Color="Color.Primary">Add Beneficiary</MudButton>

                                    <div class="d-flex align-center gap-2">
                                        <MudText Typo="Typo.caption">Total Internal: <b>@TotalInternalCommission.ToString("N2")%</b> / @DefaultInternalRate.ToString("N2")%</MudText>
                                        @if (Math.Abs(TotalInternalCommission - DefaultInternalRate) > 0.001m)
                                        {
                                                <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Warning" Size="Size.Small" />
                                        }
                                        else
                                        {
                                                <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        }
                                    </div>
                                </div>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                </MudTabPanel>





                <MudTabPanel Text="Approved Tasks" Icon="@Icons.Material.Filled.Checklist">
                     <MudText Typo="Typo.body2" Class="mb-4">Select which tasks are allowed to be used on this project. Only selected tasks will appear in the timesheet.</MudText>

                     <MudTable Elevation="0" Outlined="true" Items="@WorkTypes" Dense="true" Hover="true" Striped="true" FixedHeader="true" Height="300px">
                        <HeaderContent>
                            <MudTh>Approved</MudTh>
                            <MudTh>Task Name</MudTh>
                            <MudTh>Default Rate</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                             <MudTd>
                                 <MudCheckBox T="bool" Value="@_draft.ApprovedWorkTypeIds.Contains(context.Id)"
                                              ValueChanged="@((val) => ToggleTaskApproval(context.Id, val))"
                                              Color="Color.Primary" Dense="true" />
                            </MudTd>
                             <MudTd>@context.Name</MudTd>
                             <MudTd>@context.DefaultRate.ToString("C")</MudTd>
                        </RowTemplate>
                        <FooterContent>
                             <MudTd colspan="3">
                                 <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="SelectAllTasks">Select All</MudButton>
                                 <MudButton Variant="Variant.Outlined" Color="Color.Secondary" OnClick="DeselectAllTasks" Class="ml-2">Deselect All</MudButton>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                </MudTabPanel>

                <MudTabPanel Text="Access Control" Icon="@Icons.Material.Filled.Security">
                    <MudText Typo="Typo.body2" Class="mb-4">Control who can contribute to this project (Timesheets, Expenses, Chat). Viewing permissions are controlled separately.</MudText>
                    
                    <MudGrid>
                        <MudItem xs="12">
                            <MudSelect T="string" Label="Access Policy" @bind-Value="_draft.AccessPolicy" Variant="Variant.Outlined">
                                <MudSelectItem Value="@ProjectAccessPolicy.Public">Public (Everyone can contribute)</MudSelectItem>
                                <MudSelectItem Value="@ProjectAccessPolicy.Restricted">Restricted (Selected Teams/Users only)</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        @if (_draft.AccessPolicy == ProjectAccessPolicy.Restricted)
                        {
                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Allowed Teams</MudText>
                                
                                <TeamAutocomplete Label="Add Team" Teams="@Teams" ExcludedIds="@selectedAllowedTeamIds"
                                    ValueChanged="AddTeam" ResetOnSelect="true" />

                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @foreach(var teamId in selectedAllowedTeamIds)
                                    {
                                        var team = Teams.FirstOrDefault(t => t.Id == teamId);
                                        if (team != null)
                                        {
                                            <TeamChip Team="@team" OnClose="@(() => RemoveTeam(teamId))" Size="Size.Small" />
                                        }
                                        else if (Db.Teams.GetById(teamId) != null)
                                        {
                                            <MudChip T="string" Size="Size.Small">@AppLabels.Team</MudChip>
                                        }
                                    }
                                </div>
                            </MudItem>

                            <MudItem xs="12">
                                <MudText Typo="Typo.subtitle2" Class="mt-4 mb-2">Allowed Users (Exceptions)</MudText>
                                
                                <EmployeeAutocomplete Label="Add User" Employees="@Employees" ExcludedIds="@selectedAllowedUserIds"
                                    ValueChanged="AddUser" ResetOnSelect="true" />

                                <div class="d-flex flex-wrap gap-1 mt-2">
                                    @foreach(var userId in selectedAllowedUserIds)
                                    {
                                        var user = Employees.FirstOrDefault(u => u.Id == userId);
                                        if (user != null)
                                        {
                                            <EmployeeChip Employee="@user" OnClose="@(() => RemoveUser(userId))" Size="Size.Small" />
                                        }
                                        else if (Db.Employees.GetById(userId) != null)
                                        {
                                            <MudChip T="string" Size="Size.Small">@AppLabels.Employee</MudChip>
                                        }
                                    }
                                </div>
                            </MudItem>
                        }
                    </MudGrid>
                </MudTabPanel>

            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Variant="Variant.Filled">Save Project</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Project Project { get; set; } = new();

    private Project _draft = new();
    private Employee? _currentUser;
    private MudForm form = default!;
    private bool success;
    private bool idExists;

    private bool IsUndiscoverableEmployee(string? employeeId)
    {
        if (string.IsNullOrEmpty(employeeId)) return false;
        if (Employees.Any(e => e.Id == employeeId)) return false;
        var emp = Db.Employees.GetById(employeeId);
        return emp != null && (_currentUser == null || !PrivacyService.CanDiscoverUser(_currentUser, emp));
    }

    private void CheckDuplicateId()
    {
        _draft.ProjectNumber = _draft.ProjectNumber?.Trim() ?? string.Empty;
        if (string.IsNullOrWhiteSpace(_draft.ProjectNumber))
        {
            idExists = false;
            return;
        }

        var existing = Db.Projects.GetAll().FirstOrDefault(p => p.ProjectNumber.Equals(_draft.ProjectNumber, StringComparison.InvariantCultureIgnoreCase));
        if (existing != null && (string.IsNullOrEmpty(_draft.Id) || !string.Equals(existing.Id, _draft.Id, StringComparison.OrdinalIgnoreCase)))
        {
            idExists = true;
            var message = _currentUser != null && UserService.CanViewProject(_currentUser, existing)
                ? $"Project ID '{_draft.ProjectNumber}' is already used by '{existing.Name}'"
                : $"Project ID '{_draft.ProjectNumber}' is already in use.";
            Snackbar.Add(message, Severity.Warning);
        }
        else
        {
            idExists = false;
        }
    }

    // Data Sources
    private List<DocumentTemplate> Templates = [];
    private List<Employee> Employees = [];
    private List<WorkType> WorkTypes = [];
    private List<Team> Teams = [];
    private List<ProjectStatusConfig> AvailableStatuses = [];

    // Selection State
    private string? newOverrideWorkTypeId;
    private decimal DefaultInternalRate;
    private decimal TotalInternalCommission => _draft.Commissions.Where(c => c.Type == "Internal").Sum(c => c.Percentage);

    // Access Control Helpers
    private IEnumerable<string> selectedAllowedTeamIds = new HashSet<string>();
    private IEnumerable<string> selectedAllowedUserIds = new HashSet<string>();

    protected override async Task OnInitializedAsync()
    {
        _draft = (Project ?? new Project()).DeepClone();
        _draft.Client ??= new ClientInfo();
        _draft.CustomRates ??= [];
        _draft.Commissions ??= [];
        _draft.ApprovedWorkTypeIds ??= [];
        _draft.AllowedTeamIds ??= [];
        _draft.AllowedUserIds ??= [];

        _currentUser = await UserService.GetEmployeeAsync();

        Templates = Db.DocumentTemplates.GetAll().OrderBy(t => t.Name).ToList();
        Employees = _currentUser != null
            ? PrivacyService.FilterDiscoverableEmployees(_currentUser, Db.Employees.GetActiveEmployees()).OrderBy(e => e.FirstName).ToList()
            : [];
        WorkTypes = Db.WorkTypes.GetAll().Where(w => w.IsActive).OrderBy(w => w.Name).ToList();
        Teams = _currentUser != null
            ? PrivacyService.FilterDiscoverableTeams(_currentUser, Db.Teams.GetAll()).OrderBy(t => t.Name).ToList()
            : [];

        var profile = Db.CompanyProfile.Get();
        DefaultInternalRate = profile.DefaultInternalCommission;
        AvailableStatuses = profile.ProjectStatuses ?? [];

        // 1. Set Default Template for new projects
        if (string.IsNullOrEmpty(_draft.Id) || string.IsNullOrEmpty(_draft.DefaultTemplateId))
        {
            var def = Templates.FirstOrDefault(t => t.IsDefault);
            if (def != null) _draft.DefaultTemplateId = def.Id;
        }

        // Note: Project initialization of Client/Contact UI state is now handled by
        // passing InitialCompanyName and InitialContactName to CompanyContactSelector.

        // 3. Bind Access Control Lists
        selectedAllowedTeamIds = new HashSet<string>(_draft.AllowedTeamIds);
        selectedAllowedUserIds = new HashSet<string>(_draft.AllowedUserIds);
    }

    private void AddCommission()
    {
        // Default to Internal, remaining or default
        var remaining = DefaultInternalRate - TotalInternalCommission;
        if (remaining < 0) remaining = 0;

        _draft.Commissions.Add(new CommissionBeneficiary
            {
                Name = "New Beneficiary",
                Type = "Internal",
                CommissionBasis = "Revenue",
                Percentage = remaining > 0 ? remaining : 0
            });
    }

    private void OnInternalBeneficiarySelected(CommissionBeneficiary context, string employeeId)
    {
        context.EmployeeId = employeeId;
        var emp = Employees.FirstOrDefault(e => e.Id == employeeId);
        if (emp != null)
        {
            context.Name = emp.FullName;
        }
    }



    private void AddOverride()
    {
        if (string.IsNullOrEmpty(newOverrideWorkTypeId)) return;
        var wt = WorkTypes.FirstOrDefault(w => w.Id == newOverrideWorkTypeId);
        if (wt != null && !_draft.CustomRates.ContainsKey(wt.Id))
        {
            _draft.CustomRates.Add(wt.Id, wt.DefaultRate);
            newOverrideWorkTypeId = null;
        }
    }

    private string FullAddress => $"{_draft.Client.BusinessAddressNumber} {_draft.Client.BusinessAddressStreet}\n{_draft.Client.BusinessAddressCity}, {_draft.Client.BusinessAddressState} {_draft.Client.BusinessAddressZip}";

    // --- AUTOCOMPLETE LOGIC ---

    private void OnClientSelected(Supplier s)
    {
        if (s != null)
        {
            // Snapshot the data into the Project (Deep Copy of Business Info)
            // We only want to copy the business details first, then let contact selection handle the rest
            // or default to primary contact if available.
            
            _draft.Client.BusinessName = s.ContactInfo.BusinessName;
            _draft.Client.BusinessAddressNumber = s.ContactInfo.BusinessAddressNumber;
            _draft.Client.BusinessAddressStreet = s.ContactInfo.BusinessAddressStreet;
            _draft.Client.BusinessAddressCity = s.ContactInfo.BusinessAddressCity;
            _draft.Client.BusinessAddressState = s.ContactInfo.BusinessAddressState;
            _draft.Client.BusinessAddressCountry = s.ContactInfo.BusinessAddressCountry;
            _draft.Client.BusinessAddressZip = s.ContactInfo.BusinessAddressZip;

            // Default to primary contact
            var primary = s.Contacts.FirstOrDefault(c => c.IsPrimary) ?? s.Contacts.FirstOrDefault();
            if (primary != null)
            {
                UpdateProjectContactInfo(primary);
            }
        }
    }

    private void OnContactSelected(ContactPerson contact)
    {
        if (contact != null)
        {
            UpdateProjectContactInfo(contact);
        }
    }

    private void UpdateProjectContactInfo(ContactPerson contact)
    {
        _draft.Client.ContactPersonPrefix = contact.Prefix;
        _draft.Client.ContactPersonName = contact.Name;
        _draft.Client.ContactPersonTitle = contact.Title;
        _draft.Client.ContactPersonEmail = contact.Email;
        _draft.Client.ContactPersonPhone = contact.Phone;
    }

    // --- CREATE / EDIT LOGIC ---
    // (Handled by the CompanyContactSelector control)

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!success) return;

        CheckDuplicateId();
        if (idExists) return;

        // Validation: Warn if internal commissions differ from the default rate, but allow saving (override)
        var hasInternalCommissions = _draft.Commissions.Any(c => c.Type == "Internal");
        if (hasInternalCommissions && Math.Abs(TotalInternalCommission - DefaultInternalRate) > 0.001m)
        {
            Snackbar.Add($"Note: Internal commissions ({TotalInternalCommission}%) differ from the company default ({DefaultInternalRate}%).", Severity.Warning);
        }

        // Sync Access Control
        _draft.AllowedTeamIds = selectedAllowedTeamIds.ToList();
        _draft.AllowedUserIds = selectedAllowedUserIds.ToList();

        MudDialog.Close(DialogResult.Ok(_draft));
    }

    private void ToggleTaskApproval(string taskId, bool isApproved)
    {
        if (isApproved)
        {
            if (!_draft.ApprovedWorkTypeIds.Contains(taskId))
            {
                _draft.ApprovedWorkTypeIds.Add(taskId);
            }
        }
        else
        {
            _draft.ApprovedWorkTypeIds.Remove(taskId);
        }
    }

    private void SelectAllTasks()
    {
        foreach (var wt in WorkTypes)
        {
            if (!_draft.ApprovedWorkTypeIds.Contains(wt.Id))
            {
                _draft.ApprovedWorkTypeIds.Add(wt.Id);
            }
        }
    }

    private void DeselectAllTasks()
    {
        _draft.ApprovedWorkTypeIds.Clear();
    }

    private void AddTeam(Team? team)
    {
        if (team != null)
        {
            var list = selectedAllowedTeamIds.ToList();
            if(!list.Contains(team.Id))
            {
                list.Add(team.Id);
                selectedAllowedTeamIds = list;
            }
        }
    }

    private void AddUser(Employee? emp)
    {
        if (emp != null)
        {
            var list = selectedAllowedUserIds.ToList();
            if(!list.Contains(emp.Id))
            {
                 list.Add(emp.Id);
                 selectedAllowedUserIds = list;
            }
        }
    }

    private void RemoveTeam(string teamId)
    {
        if (Teams.All(t => t.Id != teamId) && Db.Teams.GetById(teamId) != null && _currentUser?.IsEffectiveAdmin != true)
        {
            return;
        }
        var list = selectedAllowedTeamIds.ToList();
        list.Remove(teamId);
        selectedAllowedTeamIds = list;
    }

    private void RemoveUser(string userId)
    {
        if (Employees.All(e => e.Id != userId) && Db.Employees.GetById(userId) != null && _currentUser?.IsEffectiveAdmin != true)
        {
            return;
        }
        var list = selectedAllowedUserIds.ToList();
        list.Remove(userId);
        selectedAllowedUserIds = list;
    }
}
