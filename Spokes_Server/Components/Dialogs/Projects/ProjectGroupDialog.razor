@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Data
@using MudBlazor
@inject Database Db
@inject UserService UserService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudForm @ref="form" @bind-IsValid="@success">
            <MudTextField @bind-Value="Group.Name" Label="Group Name" Required="true"
                          RequiredError="Name is required" Variant="Variant.Outlined" Class="mb-4" />

            <MudTextField @bind-Value="Group.Description" Label="Description" Lines="2"
                          Variant="Variant.Outlined" Class="mb-4" />

            <MudText Typo="Typo.subtitle1" Class="mb-2">Client</MudText>
            <MudAutocomplete T="Supplier" Label="Select Client" Value="selectedClient"
                             Disabled="@(!_canModifyAuthorized || (IsEdit && _inaccessibleProjectIds.Count > 0))"
                             SearchFunc="SearchClients" ToStringFunc="@(s => s?.ContactInfo.BusinessName ?? "")"
                             Variant="Variant.Outlined" Class="mb-4" Required="true"
                             RequiredError="Client is required" ValueChanged="OnClientSelected" MaxItems="null" />

            @if (selectedClient != null)
            {
                <MudText Typo="Typo.subtitle1" Class="mb-2 mt-4">Projects for @selectedClient.ContactInfo.BusinessName</MudText>
                
                @if (!AvailableProjects.Any())
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        No available projects found for this client. Projects already in another group are not shown.
                    </MudAlert>
                }
                else
                {
                    <MudPaper Outlined="true" Class="pa-3 mb-4" Style="max-height: 300px; overflow-y: auto;">
                        @foreach (var project in AvailableProjects)
                        {
                            var isSelected = SelectedProjectIds.Contains(project.Id);
                            <MudCheckBox T="bool" Value="@isSelected" 
                                         ValueChanged="@((bool v) => ToggleProject(project.Id, v))"
                                         Label="@project.DisplayName" Color="Color.Primary" />
                        }
                    </MudPaper>
                    
                    <MudText Typo="Typo.body2" Color="Color.Secondary">
                        @SelectedProjectIds.Count project(s) selected
                    </MudText>
                }
            }
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit" Variant="Variant.Filled"
                   Disabled="@(!_canModifyAuthorized || !success || selectedClient == null || (!SelectedProjectIds.Any() && !_inaccessibleProjectIds.Any()))">
            @(IsEdit ? "Save Changes" : "Create Group")
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public ProjectGroup? ExistingGroup { get; set; }

    private MudForm form = default!;
    private bool success;
    private ProjectGroup Group = new();
    private Supplier? selectedClient;
    private List<Supplier> AllClients = [];
    private List<Project> AvailableProjects = [];
    private HashSet<string> SelectedProjectIds = [];
    private HashSet<string> _inaccessibleProjectIds = [];
    private Spokes_Server.Core.Models.HR.Employee? _currentActor;
    private bool _canModifyAuthorized;
    private bool IsEdit => ExistingGroup != null;
    private string RequiredPermission => IsEdit ? AppPermissions.Projects.Edit : AppPermissions.Projects.Create;

    protected override async Task OnInitializedAsync()
    {
        _currentActor = await UserService.GetEmployeeAsync();
        _canModifyAuthorized = _currentActor != null && _currentActor.HasPermission(RequiredPermission);
        AllClients = Db.Suppliers.GetAll().OrderBy(s => s.ContactInfo.BusinessName).ToList();

        if (ExistingGroup != null)
        {
            // Edit mode
            Group = new ProjectGroup
            {
                Id = ExistingGroup.Id,
                Name = ExistingGroup.Name,
                Description = ExistingGroup.Description,
                Client = ExistingGroup.Client,
                ProjectIds = [.. ExistingGroup.ProjectIds],
                CreatedAt = ExistingGroup.CreatedAt
            };

            // Find matching client
            selectedClient = AllClients.FirstOrDefault(c => 
                c.ContactInfo.BusinessName.Equals(Group.Client.BusinessName, StringComparison.OrdinalIgnoreCase));

            SelectedProjectIds = [];
            _inaccessibleProjectIds = [];
            foreach (var pid in Group.ProjectIds)
            {
                var proj = Db.Projects.GetById(pid);
                if (proj != null && _currentActor != null && UserService.CanViewProject(_currentActor, proj, allowAccountingFinancialRead: false))
                {
                    SelectedProjectIds.Add(pid);
                }
                else
                {
                    _inaccessibleProjectIds.Add(pid);
                }
            }
            
            if (selectedClient != null)
            {
                LoadProjectsForClient();
            }
        }
    }

    private Task<IEnumerable<Supplier>> SearchClients(string value, CancellationToken token)
    {
        if (string.IsNullOrEmpty(value))
            return Task.FromResult<IEnumerable<Supplier>>(AllClients);

        return Task.FromResult(AllClients.Where(c => 
            c.ContactInfo.BusinessName.Contains(value, StringComparison.OrdinalIgnoreCase)));
    }

    private void LoadProjectsForClient()
    {
        if (selectedClient == null)
        {
            AvailableProjects = [];
            return;
        }

        var selectedClientName = selectedClient.ContactInfo.BusinessName?.Trim() ?? "";

        // Get all accessible projects for this client that are NOT in another group
        // Match client by trimmed, case-insensitive business name
        var allClientProjects = Db.Projects.GetAll()
            .Where(p => (p.Client.BusinessName?.Trim() ?? "").Equals(selectedClientName, StringComparison.OrdinalIgnoreCase))
            .Where(p => !p.IsInternal)
            .Where(p => _currentActor != null && UserService.CanViewProject(_currentActor, p, allowAccountingFinancialRead: false))
            .ToList();

        // Filter out projects that are in OTHER groups (allow projects in THIS group for editing)
        AvailableProjects = allClientProjects
            .Where(p => string.IsNullOrEmpty(p.ProjectGroupId) || 
                        (IsEdit && p.ProjectGroupId == Group.Id))
            .OrderBy(p => p.DisplayName)
            .ToList();

        // If client changed, clear accessible project selections that don't belong to new client
        var validIds = AvailableProjects.Select(p => p.Id).ToHashSet();
        SelectedProjectIds.RemoveWhere(id => !validIds.Contains(id));
    }

    private void OnClientSelected(Supplier? client)
    {
        if (!_canModifyAuthorized || (IsEdit && _inaccessibleProjectIds.Count > 0 && client?.Id != selectedClient?.Id))
        {
            if (IsEdit && _inaccessibleProjectIds.Count > 0)
            {
                Snackbar.Add("Cannot change client while this group contains restricted projects.", Severity.Warning);
            }
            return;
        }
        selectedClient = client;
        if (client != null)
        {
            Group.Client = new ClientInfo
            {
                BusinessName = client.ContactInfo.BusinessName,
                ContactPersonName = client.ContactInfo.ContactPersonName,
                ContactPersonEmail = client.ContactInfo.ContactPersonEmail,
                ContactPersonPhone = client.ContactInfo.ContactPersonPhone,
                BusinessAddressStreet = client.ContactInfo.BusinessAddressStreet,
                BusinessAddressCity = client.ContactInfo.BusinessAddressCity,
                BusinessAddressState = client.ContactInfo.BusinessAddressState,
                BusinessAddressZip = client.ContactInfo.BusinessAddressZip,
                BusinessAddressCountry = client.ContactInfo.BusinessAddressCountry
            };
            LoadProjectsForClient();
        }
        else
        {
            AvailableProjects = [];
        }
        StateHasChanged();
    }



    private void ToggleProject(string projectId, bool isSelected)
    {
        if (isSelected)
            SelectedProjectIds.Add(projectId);
        else
            SelectedProjectIds.Remove(projectId);
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task Submit()
    {
        await form.ValidateAsync();
        if (!success || selectedClient == null || (!SelectedProjectIds.Any() && !_inaccessibleProjectIds.Any()))
            return;

        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || !emp.HasPermission(RequiredPermission))
        {
            _canModifyAuthorized = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return;
        }

        if (IsEdit && ExistingGroup != null && _inaccessibleProjectIds.Count > 0)
        {
            Group.Client = ExistingGroup.Client;
        }

        var authorizedSelectedIds = SelectedProjectIds
            .Where(pid =>
            {
                var p = Db.Projects.GetById(pid);
                return p != null && UserService.CanViewProject(emp, p, allowAccountingFinancialRead: false);
            })
            .ToHashSet();

        if (!authorizedSelectedIds.Any() && !_inaccessibleProjectIds.Any())
        {
            Snackbar.Add("Select at least one accessible project.", Severity.Warning);
            return;
        }

        Group.ProjectIds = authorizedSelectedIds
            .Concat(_inaccessibleProjectIds)
            .Distinct()
            .ToList();

        // Update project references - set ProjectGroupId only on authorized accessible projects
        foreach (var projectId in authorizedSelectedIds)
        {
            var project = Db.Projects.GetById(projectId);
            if (project != null && UserService.CanViewProject(emp, project, allowAccountingFinancialRead: false))
            {
                project.ProjectGroupId = Group.Id;
                Db.Projects.Save(project);
            }
        }

        // If editing, clear ProjectGroupId only from accessible projects that were explicitly removed
        if (IsEdit && ExistingGroup != null)
        {
            var removedProjectIds = ExistingGroup.ProjectIds
                .Where(id => !_inaccessibleProjectIds.Contains(id))
                .Except(authorizedSelectedIds);
            foreach (var projectId in removedProjectIds)
            {
                var project = Db.Projects.GetById(projectId);
                if (project != null && UserService.CanViewProject(emp, project, allowAccountingFinancialRead: false))
                {
                    project.ProjectGroupId = null;
                    Db.Projects.Save(project);
                }
            }
        }

        MudDialog.Close(DialogResult.Ok(Group));
    }
}

