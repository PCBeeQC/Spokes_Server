    [Inject] private IFileService FileService { get; set; } = default!;

    private async Task HandleImageUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (_isReadOnly || results == null || results.Count == 0 || string.IsNullOrWhiteSpace(Quote.ProjectId)) return;

        var result = results.First();
        if (!FileService.TryResolveScopedFileName(result.FilePath, "projects", Quote.ProjectId, out var safeName))
        {
            return;
        }

        var canonicalPath = $"/spokesapi/files/projects/{Quote.ProjectId}/{safeName}";
        if (!string.IsNullOrWhiteSpace(Quote.MainImagePath) &&
            !string.Equals(Quote.MainImagePath, canonicalPath, StringComparison.OrdinalIgnoreCase) &&
            FileService.TryResolveScopedFileName(Quote.MainImagePath, "projects", Quote.ProjectId, out _))
        {
            await FileService.DeleteAsync(Quote.MainImagePath);
        }

        Quote.MainImagePath = canonicalPath;
        Quote.MainImageBase64 = string.Empty;
        StateHasChanged();
    }

    private async Task RemoveMainImage()
    {
        if (_isReadOnly) return;
        if (!string.IsNullOrWhiteSpace(Quote.MainImagePath) &&
            !string.IsNullOrWhiteSpace(Quote.ProjectId) &&
            FileService.TryResolveScopedFileName(Quote.MainImagePath, "projects", Quote.ProjectId, out _))
        {
            await FileService.DeleteAsync(Quote.MainImagePath);
        }
        Quote.MainImagePath = string.Empty;
        Quote.MainImageBase64 = string.Empty;
        StateHasChanged();
    }

    private async Task ApplyPresetToQuote(string presetId)
    {
        if (_isReadOnly || string.IsNullOrEmpty(presetId)) return;
        var preset = Db.TermsAndConditions.GetById(presetId);
        if (preset == null) return;

        if (!string.IsNullOrWhiteSpace(Quote.TermsAndConditions))
        {
            var confirm = await DialogService.ShowMessageBoxAsync(
                "Overwrite Terms & Conditions?",
                "Applying this preset will overwrite the terms and conditions on this quote. Do you want to continue?",
                yesText: "Overwrite", cancelText: "Cancel");
            if (confirm != true) return;
        }

        Quote.TermsAndConditions = preset.Content;
        Snackbar.Add($"Copied '{preset.Name}' terms into quote", Severity.Info);
        _selectedPresetToApply = "";
        StateHasChanged();
    }

    private void Cancel() => MudDialog.Cancel();

    private async Task<bool> AuthorizeQuoteSubmitAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        if (emp == null ||
            Quote == null ||
            liveProject == null ||
            !UserService.CanViewProject(emp, liveProject, allowAccountingFinancialRead: false))
        {
            _isReadOnly = true;
            Snackbar.Add("Access denied.", Severity.Error);
            return false;
        }

        var liveExisting = string.IsNullOrEmpty(Quote.Id) ? null : Db.Quotes.GetById(Quote.Id);
        if (liveExisting != null && !string.Equals(liveExisting.ProjectId, liveProject.Id, StringComparison.OrdinalIgnoreCase))
        {
            _isReadOnly = true;
            Snackbar.Add("Access denied.", Severity.Error);
            return false;
        }

        var currentStatus = liveExisting?.Status ?? Quote.Status;
        var hasPermission = string.Equals(currentStatus, QuoteStatus.Draft, StringComparison.OrdinalIgnoreCase)
            ? _canEditDraftAuthorized && (emp.HasPermission(AppPermissions.Projects.Edit) || emp.HasPermission(AppPermissions.Projects.ApproveQuotes))
            : _canApproveAuthorized && emp.HasPermission(AppPermissions.Projects.ApproveQuotes);

        if (!hasPermission)
        {
            _isReadOnly = true;
            Snackbar.Add("Access denied.", Severity.Error);
            return false;
        }

        Quote.ProjectId = liveProject.Id;
        return true;
    }

    private async Task Submit()
    {
        if (_isReadOnly) return;
        if (!await AuthorizeQuoteSubmitAsync()) return;

        if (Quote.Status == QuoteStatus.Final)
        {
            var parameters = new DialogParameters<ConfirmDialog>
            {
                { x => x.ContentText, BizLoc["This quote is already in Final status. Saving changes will update the finalized quote and invalidate any cached PDF. Do you want to save your changes?"].Value },
                { x => x.ButtonText, BizLoc["Save Changes"].Value },
                { x => x.Color, Color.Warning },
                { x => x.ShowReasonInput, true },
                { x => x.ReasonRequired, false },
                { x => x.ReasonLabel, BizLoc["Edit Note / Reason (optional)"].Value },
                { x => x.ReasonPlaceholder, BizLoc["Describe what was updated..."].Value }
            };

            var dialog = await DialogService.ShowAsync<ConfirmDialog>(BizLoc["Confirm Final Quote Edit"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;
            if (result == null || result.Canceled) return;

            if (!await AuthorizeQuoteSubmitAsync()) return;

            var reason = result.Data as string;
            Quote.History.Add(new DocumentHistoryEntry
            {
                Timestamp = DateTime.UtcNow,
                Action = DocumentHistoryActions.EditedInFinal,
                OldStatus = Quote.Status,
                NewStatus = Quote.Status,
                ChangedBy = string.IsNullOrWhiteSpace(CurrentUserName) ? "System" : CurrentUserName,
                Summary = "Edited quote while in Final status",
                Reason = string.IsNullOrWhiteSpace(reason) ? null : reason.Trim()
            });

            if (!string.IsNullOrEmpty(Quote.PdfPath))
            {
                if (File.Exists(Quote.PdfPath))
                {
                    try { File.Delete(Quote.PdfPath); } catch { }
                }
                Quote.PdfPath = string.Empty;
            }
        }

        MudDialog.Close(DialogResult.Ok(Quote));
    }

    // --- RECALCULATION ---
    private void RecalculateTerms()
    {
        // When GrandTotal changes, update the amounts of all payment terms
        foreach (var term in Quote.PaymentTerms)
        {
            term.Amount = Quote.GrandTotal * (term.Percentage / 100m);
        }
        StateHasChanged();
    }

    private DateTime? QuoteDate { get => Quote.Date; set { if (!_isReadOnly) Quote.Date = value ?? DateTime.Today; } }
    private DateTime? QuoteStartDate { get => Quote.StartDate?.ToDateTime(TimeOnly.MinValue); set { if (!_isReadOnly) Quote.StartDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null; } }
    private DateTime? QuoteDeadline { get => Quote.Deadline?.ToDateTime(TimeOnly.MinValue); set { if (!_isReadOnly) Quote.Deadline = value.HasValue ? DateOnly.FromDateTime(value.Value) : null; } }

    // --- MONTHLY PAYMENTS ---
    private decimal GetRemainingPercentage() => 100 - Quote.PaymentTerms.Sum(x => x.Percentage);
    private decimal GetRemainingAmount() => Quote.GrandTotal * (GetRemainingPercentage() / 100m);
    private decimal GetMonthlyAmount() => Quote.MonthlyPaymentMonths > 0 ? GetRemainingAmount() / Quote.MonthlyPaymentMonths : 0;

    private string GetMonthlyPaymentPreview()
    {
        try
        {
            return string.Format(Quote.MonthlyPaymentDescription, 
                Quote.MonthlyPaymentMonths, 
                GetMonthlyAmount().ToString("C"), 
                GetRemainingPercentage());
        }
        catch
        {
            return Quote.MonthlyPaymentDescription;
        }
    }
