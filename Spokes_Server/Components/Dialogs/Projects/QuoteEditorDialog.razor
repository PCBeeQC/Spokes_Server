@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Common
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Components.Dialogs.Common
@inject ISnackbar Snackbar
@inject Database Db
@inject IDialogService DialogService
@inject UserService UserService
@inject FileUrlSigner FileUrls

<MudDialog>
    <DialogContent>
        <MudForm>
            @if (QuoteStatus.CanUnlockEdit(Quote.Status) && CanApproveQuote && _canApproveAuthorized)
            {
                <MudAlert Severity="@(_isReadOnly ? Severity.Info : Severity.Warning)" Dense="true" Class="mb-3">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2" style="width: 100%;">
                        <span>
                            @(_isReadOnly
                                ? BizLoc["This quote is in Final status and is currently in Read-Only mode. Toggle Edit Mode to make changes."]
                                : BizLoc["Edit Mode is unlocked for this Final quote. Saving will require confirmation and regenerate the PDF."])
                        </span>
                        <MudSwitch T="bool"
                                   Value="@(!_isReadOnly)"
                                   ValueChanged="@(v => _isReadOnly = !v)"
                                   Color="Color.Warning"
                                   Label="@BizLoc["Edit Mode"]"
                                   Size="Size.Small" />
                    </div>
                </MudAlert>
            }
            else if (_isReadOnly)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-3">
                    @string.Format(BizLoc["This quote is in Read-Only mode ({0}). You can inspect how it was built and copy Markdown text."].Value, Quote.Status)
                </MudAlert>
            }

            <MudGrid Class="mb-4">
                <MudItem xs="4">
                    <MudTextField @bind-Value="Quote.QuoteNumber" Label="Quote #" Required="true" ReadOnly="true"
                        Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
                <MudItem xs="4">
                     <MudDatePicker @bind-Date="QuoteDate" Label="Date" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_isReadOnly" Disabled="@_isReadOnly" />
                </MudItem>
                <MudItem xs="4" Class="d-flex align-center">
                    <div class="d-flex align-center gap-2">
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@BizLoc["Status:"]</MudText>
                        <StatusChip Status="@Quote.Status" />
                    </div>
                </MudItem>

                <MudItem xs="4">
                     <MudDatePicker @bind-Date="QuoteStartDate" Label="Start Date" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_isReadOnly" Disabled="@_isReadOnly" />
                </MudItem>
                <MudItem xs="4">
                     <MudDatePicker @bind-Date="QuoteDeadline" Label="Deadline" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_isReadOnly" Disabled="@_isReadOnly" />
                </MudItem>
                <MudItem xs="4">
                    <MudTextField @bind-Value="Quote.Title" Label="Title" Variant="Variant.Outlined"
                        Margin="Margin.Dense" ReadOnly="@_isReadOnly" />
                </MudItem>
            </MudGrid>


            <MudTabs Elevation="0" Outlined="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">

                <MudTabPanel Text="Estimation (Costs)" Icon="@Icons.Material.Filled.Calculate">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Class="mt-2">Time / Labor</MudText>
                    <MudTable Items="@Quote.LaborItems" Dense="true" Hover="true" Elevation="0" Outlined="true">
                        <HeaderContent>
                            <MudTh Style="width: 24%; min-width: 200px;">Task</MudTh>
                            <MudTh Style="width: 38%; min-width: 300px;">Sub-Task</MudTh>
                            <MudTh Style="width: 38%; min-width: 300px;">Note</MudTh>
                            <MudTh Style="width: 125px; min-width: 125px; white-space: nowrap;">Rate ($/h)</MudTh>
                            <MudTh Style="width: 80px; min-width: 80px;">Hours</MudTh>
                            <MudTh Style="width: 110px;">Total</MudTh>
                            <MudTh Style="width: 120px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <WorkTypeSubTaskSelector WorkTypes="@WorkTypes"
                                                     WorkTypeId="@context.WorkTypeId"
                                                     SubTaskId="@context.SubTaskId"
                                                     OnSelectionChanged="@(sel => UpdateLaborSelection(context, sel.WorkTypeId, sel.SubTaskId))"
                                                     Layout="WorkTypeSelectorLayout.TableCells"
                                                     Variant="Variant.Text"
                                                     UsePlaceholder="true"
                                                     Underline="false"
                                                     Disabled="@_isReadOnly" />
                            <MudTd>
                                <MudTextField @bind-Value="context.Note" Margin="Margin.Dense" Placeholder="Note..." Underline="false" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Value="@context.Rate" ValueChanged="@((decimal v) => UpdateLaborRate(context, v))" Format="0.##" Margin="Margin.Dense"
                                    HideSpinButtons="true" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Value="@context.Hours" ValueChanged="@((decimal v) => UpdateLaborHours(context, v))" Format="0.##" Margin="Margin.Dense"
                                    HideSpinButtons="true" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>@context.Total.ToString("C")</MudTd>
                            <MudTd>
                                @if (!_isReadOnly)
                                {
                                    <div class="d-flex">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                       OnClick="@(() => MoveLaborUp(context))" Disabled="@(Quote.LaborItems.IndexOf(context) == 0)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                       OnClick="@(() => MoveLaborDown(context))" Disabled="@(Quote.LaborItems.IndexOf(context) == Quote.LaborItems.Count - 1)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => RemoveLabor(context))" />
                                    </div>
                                }
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            @if (!_isReadOnly)
                            {
                                <MudTd colspan="7">
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddLabor" Size="Size.Small">
                                        Add Time Row</MudButton>
                                </MudTd>
                            }
                        </FooterContent>
                    </MudTable>

                    <MudDivider Class="my-4" />

                    <MudText Typo="Typo.h6" Color="Color.Secondary">Hardware & Items</MudText>
                    <MudTable Items="@Quote.MaterialLineItems" Dense="true" Hover="true" Elevation="0" Outlined="true">
                        <HeaderContent>
                            <MudTh>Description</MudTh>
                            <MudTh Style="width: 100px;">Client Bought</MudTh>
                            <MudTh Style="width: 150px;">Unit Cost</MudTh>
                            <MudTh Style="width: 80px;">Markup %</MudTh>
                            <MudTh Style="width: 150px;">Unit Price</MudTh>
                            <MudTh Style="width: 70px;">Qty</MudTh>
                            <MudTh Style="width: 130px;">Total</MudTh>
                            <MudTh Style="width: 140px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudTextField @bind-Value="context.Description" Margin="Margin.Dense"
                                    Placeholder="Item Name" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>
                                <MudCheckBox T="bool" Value="@context.IsClientBought" ValueChanged="@((bool v) => UpdateIsClientBought(context, v))" Size="Size.Small" Color="Color.Info" Dense="true" ReadOnly="@_isReadOnly" Disabled="@_isReadOnly" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Value="@context.UnitCost"
                                    ValueChanged="@((decimal v) => UpdateItemCost(context, v))" Format="0.##"
                                    Margin="Margin.Dense" HideSpinButtons="true" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Value="@context.MarkupPercentage"
                                    ValueChanged="@((decimal v) => UpdateItemMarkup(context, v))" Format="0.##"
                                    Margin="Margin.Dense" HideSpinButtons="true" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Value="@context.UnitPrice"
                                    ValueChanged="@((decimal v) => UpdateItemPrice(context, v))" Format="0.##"
                                    Margin="Margin.Dense" HideSpinButtons="true" ReadOnly="true" Disabled="true" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Value="@context.Quantity"
                                    ValueChanged="@((decimal v) => UpdateItemQty(context, v))" Format="0.##"
                                    Margin="Margin.Dense" HideSpinButtons="true" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>@context.Total.ToString("C")</MudTd>
                            <MudTd>
                                @if (!_isReadOnly)
                                {
                                    <div class="d-flex">
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                                       OnClick="@(() => MoveItemUp(context))" Disabled="@(Quote.MaterialLineItems.IndexOf(context) == 0)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                                       OnClick="@(() => MoveItemDown(context))" Disabled="@(Quote.MaterialLineItems.IndexOf(context) == Quote.MaterialLineItems.Count - 1)" />
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small"
                                                       Color="Color.Error" OnClick="@(() => RemoveItem(context))" />
                                    </div>
                                }
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            @if (!_isReadOnly)
                            {
                                <MudTd colspan="8">
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddItem" Size="Size.Small">
                                        Add Item Row</MudButton>
                                </MudTd>
                            }
                        </FooterContent>
                    </MudTable>

                    <MudPaper Class="pa-4 mt-4 d-flex flex-column align-end gap-1" Elevation="0" Outlined="true"
                        Style="background-color: var(--mud-palette-background-grey);">
                        <div class="d-flex gap-4">
                            <MudText>Labor: <b>@Quote.TotalLabor.ToString("C")</b></MudText>
                            <MudText>Items (Contract): <b>@Quote.TotalItems.ToString("C")</b></MudText>
                        </div>
                        
                        <MudDivider Class="my-1" />
                        <div class="d-flex gap-4" style="min-width: 200px; justify-content: space-between;">
                            <MudText>Subtotal:</MudText>
                            <MudText><b>@Quote.SubTotal.ToString("C")</b></MudText>
                        </div>


                        <div class="d-flex justify-end my-1">
                             <MudSwitch T="bool" Value="@Quote.ShowTax" ValueChanged="@(UpdateShowTax)" Label="Apply Tax" Color="Color.Primary" Size="Size.Small" Disabled="@_isReadOnly" />
                        </div>

                        @if (Quote.ShowTax)
                        {
                                <div class="d-flex gap-4" style="min-width: 200px; justify-content: space-between;">
                                    <MudText>Tax Rate:</MudText>
                                    <div style="width: 100px;">
                                        <MudNumericField Value="@(Quote.TaxRate * 100)" ValueChanged="@((decimal v) => UpdateTaxRate(v / 100))" Format="@FinancialCalculationEngine.TaxRatePercentFormat" Margin="Margin.Dense" HideSpinButtons="true" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" ReadOnly="@_isReadOnly" />
                                    </div>
                                </div>
                                <div class="d-flex gap-4" style="min-width: 200px; justify-content: space-between;">
                                    <MudText>Tax Amount:</MudText>
                                    <MudText><b>@Quote.TaxAmount.ToString("C")</b></MudText>
                                </div>
                        }
                        
                        <MudDivider Class="my-1" />

                        <div class="d-flex gap-4 mt-1" style="min-width: 200px; justify-content: space-between;">
                            <MudText Typo="Typo.h6" Color="Color.Primary"><b>Contract Subtotal:</b></MudText>
                            <MudText Typo="Typo.h6" Color="Color.Primary"><b>@Quote.GrandTotal.ToString("C")</b>
                            </MudText>
                        </div>

                        @if(Quote.TotalClientBought > 0)
                        {
                            <div class="d-flex gap-4 mt-1" style="min-width: 200px; justify-content: space-between;">
                                <MudText Color="Color.Info" Typo="Typo.body1"><b>Client Bought Items:</b></MudText>
                                <MudText Color="Color.Info" Typo="Typo.body1"><b>@Quote.TotalClientBought.ToString("C")</b></MudText>
                            </div>
                        }

                        <div class="d-flex gap-4 mt-1" style="min-width: 200px; justify-content: space-between;">
                            <MudText Typo="Typo.h6" Color="Color.Success"><b>Budget Total:</b></MudText>
                            <MudText Typo="Typo.h6" Color="Color.Success"><b>@Quote.TotalProjectBudget.ToString("C")</b>
                            </MudText>
                        </div>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Payment Terms" Icon="@Icons.Material.Filled.Schedule">
                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mb-2">Payment Millestones</MudText>
                    <MudAlert Severity="Severity.Info" Class="my-2" Dense="true">
                        Define payment milestones here. Percentages are based on the Grand Total (inc. Tax).
                    </MudAlert>

                    <MudTable Items="@Quote.PaymentTerms" Dense="true" Hover="true" Elevation="0" Outlined="true">
                        <HeaderContent>
                            <MudTh>Description</MudTh>
                            <MudTh Style="width: 120px;">%</MudTh>
                            <MudTh Style="width: 150px;">Amount</MudTh>
                            <MudTh Style="width: 50px;"></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudTextField @bind-Value="context.Description" Margin="Margin.Dense"
                                    Placeholder="e.g. Deposit" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField Value="@context.Percentage"
                                    ValueChanged="@((decimal v) => UpdateTermPercent(context, v))" Format="0.##"
                                    Margin="Margin.Dense" HideSpinButtons="true" Adornment="Adornment.End"
                                    AdornmentText="%" ReadOnly="@_isReadOnly" />
                            </MudTd>
                            <MudTd>@context.Amount.ToString("C")</MudTd>
                            <MudTd>
                                @if (!_isReadOnly)
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                        Size="Size.Small" OnClick="@(() => Quote.PaymentTerms.Remove(context))" />
                                }
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            @if (!_isReadOnly)
                            {
                                <MudTd colspan="4">
                                    <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddTerm" Size="Size.Small">
                                        Add Milestone</MudButton>
                                </MudTd>
                            }
                        </FooterContent>
                    </MudTable>


                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4 mb-2">Monthly Payments (Remaining Balance)</MudText>
                    <MudAlert Severity="Severity.Info" Class="mb-2" Dense="true">
                        Display approximate monthly payments for the remaining balance not covered by milestones above.
                    </MudAlert>

                    <MudGrid>
                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Quote.ShowMonthlyPayments" Color="Color.Primary"
                                Label="Show Monthly Payments on Quote" Disabled="@_isReadOnly" />
                        </MudItem>

                        @if (Quote.ShowMonthlyPayments)
                        {
                            <MudItem xs="4">
                                <MudNumericField @bind-Value="Quote.MonthlyPaymentMonths" Label="Number of Months"
                                    Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" ReadOnly="@_isReadOnly" />
                            </MudItem>
                            <MudItem xs="8">
                                <MudTextField @bind-Value="Quote.MonthlyPaymentDescription" Label="Description Text"
                                    Variant="Variant.Outlined" Margin="Margin.Dense"
                                    HelperText="Use {0} for months, {1} for monthly amount, {2} for remaining %" ReadOnly="@_isReadOnly" />
                            </MudItem>
                            <MudItem xs="12">
                                <MudPaper Class="pa-3" Elevation="0" Outlined="true" Style="background-color: var(--mud-palette-background-grey);">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Preview:</MudText>
                                    <MudText>@GetMonthlyPaymentPreview()</MudText>
                                    <MudText Typo="Typo.body2" Class="mt-1">
                                        <b>Remaining:</b> @GetRemainingPercentage()% (@GetRemainingAmount().ToString("C")) |
                                        <b>Per Month:</b> @GetMonthlyAmount().ToString("C")
                                    </MudText>
                                </MudPaper>
                            </MudItem>
                        }
                    </MudGrid>

                    <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4 mb-2">Total Payments allocated</MudText>
                    @{
                        var milestonesPercent = Quote.PaymentTerms.Sum(x => x.Percentage);
                        var isFullyAllocated = milestonesPercent == 100 || (Quote.ShowMonthlyPayments && Quote.MonthlyPaymentMonths > 0);
                        var displayPercent = isFullyAllocated ? 100 : milestonesPercent;
                    }
                    <MudPaper Class="pa-4 mt-4 d-flex justify-end gap-4 align-center" Elevation="0" Outlined="true">
                        <MudText>Total Terms:</MudText>
                        <MudText Typo="Typo.h6"><b>@Quote.PaymentTerms.Sum(x => x.Amount).ToString("C")</b></MudText>
                        @if (Quote.ShowMonthlyPayments && Quote.MonthlyPaymentMonths > 0 && milestonesPercent < 100)
                        {
                            <MudText>+ @GetRemainingPercentage()% monthly</MudText>
                        }
                        <MudChip T="string"
                                 Color="@(isFullyAllocated ? Color.Success : Color.Warning)"
                                 Size="Size.Small">
                            @displayPercent% allocated
                        </MudChip>
                    </MudPaper>
                </MudTabPanel>

                <MudTabPanel Text="Presentation" Icon="@Icons.Material.Filled.PhotoCamera">
                    <MudGrid>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">Project Rendering / Main Image</MudText>
                            @if (!string.IsNullOrEmpty(Quote.EffectiveMainImageUrl))
                            {
                                <MudImage Src="@FileUrls.SignUrl(Quote.EffectiveMainImageUrl)" Height="200" ObjectFit="ObjectFit.Cover"
                                    Class="rounded-lg mb-2" Style="width:100%;" />
                                @if (!_isReadOnly)
                                {
                                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                        OnClick="RemoveMainImage">Remove Image</MudButton>
                                }
                            }
                            else if (!_isReadOnly)
                            {
                                <MudPaper Class="d-flex align-center justify-center pa-4" Height="200px" Outlined="true"
                                    Style="background-color: var(--mud-palette-background-grey);">
                                    <div class="d-inline-flex">
                                        <ApiFileUpload 
                                            Category="projects" 
                                            ContextId="@Quote.ProjectId" 
                                            OnUploadCompleted="HandleImageUploaded">
                                            <CustomContent>
                                                <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                                    Upload Rendering
                                                </MudButton>
                                            </CustomContent>
                                        </ApiFileUpload>
                                    </div>
                                </MudPaper>
                            }
                            else
                            {
                                <MudPaper Class="d-flex align-center justify-center pa-4" Height="100px" Outlined="true"
                                    Style="background-color: var(--mud-palette-background-grey);">
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@BizLoc["No rendering uploaded."]</MudText>
                                </MudPaper>
                            }
                        </MudItem>

                        <MudItem xs="12">
                             <MudSelect @bind-Value="Quote.TemplateId" Label="Document Template" Variant="Variant.Outlined" Margin="Margin.Dense"
                                 HelperText="Leave empty to use Project/System default" Disabled="@_isReadOnly">
                                 <MudSelectItem Value="@((string?)null)">Default</MudSelectItem>
                                 @foreach (var t in Templates)
                                 {
                                     <MudSelectItem Value="@t.Id">@t.Name</MudSelectItem>
                                 }
                             </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudSwitch @bind-Value="Quote.IsConfidential" Color="Color.Error"
                                Label="Mark as Confidential" Disabled="@_isReadOnly" />

                            <MudSwitch @bind-Value="Quote.SignatureRequired" Color="Color.Primary"
                                Label="Show Signature Block (End of Document)" Disabled="@_isReadOnly" />

                            <MudSwitch @bind-Value="Quote.ShowIntermediateSignature" Color="Color.Primary"
                                Label="Show Intermediate Signature Block (After Budget)" Disabled="@_isReadOnly" />
                        </MudItem>

                        <MudItem xs="12">
                            <Spokes_Server.Components.Shared.MarkdownEditor @bind-Value="Quote.ScopeOfWork" ReadOnly="@_isReadOnly" />
                        </MudItem>

                        <MudItem xs="12">
                             <MudText Typo="Typo.subtitle2" Class="mb-2">Signature Details</MudText>
                             <MudGrid>
                                 <MudItem xs="12" sm="6">
                                     <MudTextField @bind-Value="Quote.ClientRepresentativeName" Label="Client Representative Name" 
                                         HelperText="Overrides the default sign-off name" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_isReadOnly" />
                                 </MudItem>
                                 <MudItem xs="12" sm="6">
                                     <MudTextField @bind-Value="Quote.CompanyRepresentativeName" Label="Company Representative Name" 
                                         HelperText="Overrides the default sign-off name" Variant="Variant.Outlined" Margin="Margin.Dense" ReadOnly="@_isReadOnly" />
                                 </MudItem>
                             </MudGrid>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Terms & Conditions" Icon="@Icons.Material.Filled.Gavel">
                    <div class="d-flex align-center justify-space-between mb-3 gap-4 flex-wrap">
                        <MudSwitch @bind-Value="Quote.TermsStartOnNewPage" Color="Color.Primary"
                            Label="Force section to start on a new page" Disabled="@_isReadOnly" />
                        @if (!_isReadOnly)
                        {
                            <div style="min-width: 260px;">
                                <MudSelect T="string" Label="Load from Preset" Variant="Variant.Outlined" Margin="Margin.Dense"
                                           Dense="true" Value="_selectedPresetToApply" ValueChanged="ApplyPresetToQuote"
                                           HelperText="One-way copy into this quote" Clearable="false">
                                    <MudSelectItem T="string" Value="@("")">-- Select Preset to Copy --</MudSelectItem>
                                    @foreach (var preset in AvailableTermsPresets)
                                    {
                                        <MudSelectItem T="string" Value="@preset.Id">@preset.Name</MudSelectItem>
                                    }
                                </MudSelect>
                            </div>
                        }
                    </div>
                    <Spokes_Server.Components.Shared.MarkdownEditor @bind-Value="Quote.TermsAndConditions" ReadOnly="@_isReadOnly" />
                </MudTabPanel>

                <MudTabPanel Text="@BizLoc["History"]" Icon="@Icons.Material.Filled.History">
                    <DocumentHistoryTab Entries="@Quote.History" />
                </MudTabPanel>
            </MudTabs>

        </MudForm>
    </DialogContent>
    <DialogActions>
        @if (_isReadOnly)
        {
            <MudButton OnClick="Cancel">@Loc["Close"]</MudButton>
        }
        else
        {
            <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
            <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit">@BizLoc["Save Quote"]</MudButton>
        }
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;
    [Parameter] public Quote Quote { get; set; } = new();
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public bool CanEditDraft { get; set; } = false;
    [Parameter] public bool CanApproveQuote { get; set; } = false;
    [Parameter] public string CurrentUserName { get; set; } = "System";

    private bool _isReadOnly = true;
    private bool _canEditDraftAuthorized;
    private bool _canApproveAuthorized;
    private List<WorkType> WorkTypes = [];
    private List<DocumentTemplate> Templates = [];
    private Project? Project;
    private RateCard? ProjectRateCard;
    private List<TermsAndConditions> AvailableTermsPresets = [];
    private string _selectedPresetToApply = "";

    protected override async Task OnInitializedAsync()
    {
        Quote ??= new();
        var emp = await UserService.GetEmployeeAsync();
        Project = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        var liveExisting = string.IsNullOrEmpty(Quote.Id) ? null : Db.Quotes.GetById(Quote.Id);
        var projectMatch = Project != null && (liveExisting == null || string.Equals(liveExisting.ProjectId, Project.Id, StringComparison.OrdinalIgnoreCase));
        var canView = emp != null && Project != null && projectMatch && UserService.CanViewProject(emp, Project, allowAccountingFinancialRead: false);

        _canApproveAuthorized = canView && CanApproveQuote && emp!.HasPermission(AppPermissions.Projects.ApproveQuotes);
        _canEditDraftAuthorized = canView && CanEditDraft && (emp!.HasPermission(AppPermissions.Projects.Edit) || emp.HasPermission(AppPermissions.Projects.ApproveQuotes));
        _isReadOnly = Quote.Status == QuoteStatus.Draft ? !_canEditDraftAuthorized : true;

        Templates = Db.DocumentTemplates.GetAll();
        AvailableTermsPresets = Db.TermsAndConditions.GetAll().OrderBy(t => t.Name).ToList();

        WorkTypes = Db.WorkTypes.GetAll().Where(x => x.IsActive).OrderBy(x => x.Name).ToList();

        if (Project != null && !string.IsNullOrEmpty(Project.RateCardId))
        {
            ProjectRateCard = Db.RateCards.GetById(Project.RateCardId);
        }

        foreach (var item in Quote.LaborItems)
        {
            if (string.IsNullOrEmpty(item.WorkTypeId)) continue;
            var task = WorkTypes.FirstOrDefault(w => w.Id == item.WorkTypeId);
            if (task == null) continue;

            item.WorkTypeName = task.Name;
            var st = !string.IsNullOrEmpty(item.SubTaskId)
                ? task.SubTasks.FirstOrDefault(s => s.Id == item.SubTaskId)
                : TimesheetSearchHelper.GetDefaultSubTask(task);

            if (st != null)
            {
                item.SubTaskId = st.Id;
                item.SubTaskName = st.Name;
            }
        }
    }

    // --- ESTIMATION LOGIC ---
    private void AddLabor()
    {
        if (_isReadOnly) return;
        Quote.LaborItems.Add(new QuoteLaborItem { Hours = 0, Rate = 0 });
    }

    private void AddItem()
    {
        if (_isReadOnly) return;
        Quote.MaterialLineItems.Add(new QuoteItemRow { UnitPrice = 0, Quantity = 1 });
    }

    private void UpdateLaborSelection(QuoteLaborItem item, string workTypeId, string subTaskId)
    {
        if (_isReadOnly) return;

        if (string.IsNullOrEmpty(workTypeId))
        {
            item.WorkTypeId = string.Empty;
            item.WorkTypeName = string.Empty;
            item.SubTaskId = string.Empty;
            item.SubTaskName = string.Empty;
            item.Rate = 0;
            RecalculateTerms();
            return;
        }

        var taskChanged = item.WorkTypeId != workTypeId;
        item.WorkTypeId = workTypeId;

        var task = WorkTypes.FirstOrDefault(x => x.Id == workTypeId);
        if (task != null)
        {
            item.WorkTypeName = task.Name;
            if (taskChanged)
            {
                item.Rate = Project?.GetEffectiveRate(task.Id, task.DefaultRate, ProjectRateCard) ?? task.DefaultRate;
                RecalculateTerms();
            }

            var st = !string.IsNullOrEmpty(subTaskId)
                ? task.SubTasks.FirstOrDefault(s => s.Id == subTaskId)
                : TimesheetSearchHelper.GetDefaultSubTask(task);

            item.SubTaskId = st?.Id ?? subTaskId;
            item.SubTaskName = st?.Name ?? string.Empty;
        }
    }

    // --- PAYMENT TERMS LOGIC ---
    private void AddTerm()
    {
        if (_isReadOnly) return;

        var currentTotal = Quote.PaymentTerms.Sum(t => t.Percentage);
        var remaining = 100 - currentTotal;
        if (remaining < 0) remaining = 0;

        var term = new PaymentTerm { Description = "Milestone", Percentage = remaining };
        UpdateTermPercent(term, remaining);
        Quote.PaymentTerms.Add(term);
    }

    private void UpdateTermPercent(PaymentTerm term, decimal percent)
    {
        if (_isReadOnly) return;

        term.Percentage = percent;
        // IMPORTANT: Milestones are based on Grand Total (Inc Tax)
        term.Amount = Quote.GrandTotal * (percent / 100m);
    }

    // --- MARKUP & COST LOGIC ---
    private void UpdateItemCost(QuoteItemRow item, decimal cost)
    {
        if (_isReadOnly) return;

        item.UnitCost = cost;
        // Cost changed, keep Markup %, update Price
        item.UnitPrice = item.UnitCost * (1 + (item.MarkupPercentage / 100m));
        RecalculateTerms();
    }

    private void UpdateItemMarkup(QuoteItemRow item, decimal markup)
    {
        if (_isReadOnly) return;

        item.MarkupPercentage = markup;
        // Markup changed, update Price
        item.UnitPrice = item.UnitCost * (1 + (item.MarkupPercentage / 100m));
        RecalculateTerms();
    }

    private void UpdateItemPrice(QuoteItemRow item, decimal price)
    {
        if (_isReadOnly) return;

        item.UnitPrice = price;
        // Price changed manually, back-calculate Markup %
        if (item.UnitCost != 0)
        {
            item.MarkupPercentage = ((item.UnitPrice / item.UnitCost) - 1) * 100m;
        }
        RecalculateTerms();
    }

    private void UpdateItemQty(QuoteItemRow item, decimal qty)
    {
        if (_isReadOnly) return;

        item.Quantity = qty;
        RecalculateTerms();
    }

    private void RemoveItem(QuoteItemRow item)
    {
        if (_isReadOnly) return;

        Quote.MaterialLineItems.Remove(item);
        RecalculateTerms();
    }

    private void MoveLaborUp(QuoteLaborItem item)
    {
        if (_isReadOnly) return;

        var index = Quote.LaborItems.IndexOf(item);
        if (index > 0)
        {
            Quote.LaborItems.RemoveAt(index);
            Quote.LaborItems.Insert(index - 1, item);
        }
    }

    private void MoveLaborDown(QuoteLaborItem item)
    {
        if (_isReadOnly) return;

        var index = Quote.LaborItems.IndexOf(item);
        if (index < Quote.LaborItems.Count - 1)
        {
            Quote.LaborItems.RemoveAt(index);
            Quote.LaborItems.Insert(index + 1, item);
        }
    }

    private void UpdateLaborRate(QuoteLaborItem item, decimal rate)
    {
        if (_isReadOnly) return;

        item.Rate = rate;
        RecalculateTerms();
    }

    private void UpdateLaborHours(QuoteLaborItem item, decimal hours)
    {
        if (_isReadOnly) return;

        item.Hours = hours;
        RecalculateTerms();
    }

    private void RemoveLabor(QuoteLaborItem item)
