@inject Database Db
@inject TimesheetTimerService TimerService
@inject UserService UserService
@inject ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        <MudStack Spacing="3">
            <MudAutocomplete T="string" Value="_selectedProjectId" ValueChanged="OnProjectChanged" Label="Project"
                Variant="Variant.Outlined" Dense="true" Required="true" AnchorOrigin="Origin.BottomCenter"
                SearchFunc="SearchProjects" ToStringFunc="GetProjectName" 
                ResetValueOnEmptyText="true" CoerceText="false" MaxItems="null" />

            <WorkTypeSubTaskSelector WorkTypes="@_allWorkTypes"
                                     Projects="@_projects"
                                     ProjectId="@_selectedProjectId"
                                     RequireProject="true"
                                     @bind-WorkTypeId="_selectedWorkTypeId"
                                     @bind-SubTaskId="_selectedSubTaskId"
                                     Layout="WorkTypeSelectorLayout.Stack"
                                     Variant="Variant.Outlined"
                                     Required="true" />

            <MudTextField T="string" @bind-Value="_note" Label="Note (optional)" Variant="Variant.Outlined" Margin="Margin.Dense"
                Lines="2" Placeholder="What are you working on?" />
        </MudStack>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">Close</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
            Disabled="@(string.IsNullOrEmpty(_selectedProjectId) || string.IsNullOrEmpty(_selectedWorkTypeId))">
            Start
        </MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;

    // We can pass the current user if we want, or fetch it. Fetching is safer.
    private Employee? _currentUser;

    private string _selectedProjectId = string.Empty;
    private string _selectedWorkTypeId = string.Empty;
    private string? _selectedSubTaskId;
    private string _note = string.Empty;

    private List<Project> _projects = new();
    private List<WorkType> _allWorkTypes = new();

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync();
        if (_currentUser == null)
        {
            MudDialog.Cancel();
            return;
        }

        LoadProjects();
        _allWorkTypes = Db.WorkTypes.GetAll().Where(w => w.IsActive).OrderBy(w => w.Name).ToList();
    }

    private void LoadProjects()
    {
        if (_currentUser == null) return;

        if (_currentUser.IsAdmin)
        {
            _projects = Db.Projects.GetAll()
                .Where(p => p.IsActive || p.Status != ProjectStatus.Archived)
                .OrderBy(p => p.DisplayName)
                .ToList();
            return;
        }

        _projects = Db.Projects.GetAll()
            .Where(p => (p.IsActive || p.Status != ProjectStatus.Archived) &&
            (p.AccessPolicy == ProjectAccessPolicy.Public ||
            (p.AllowedUserIds != null && p.AllowedUserIds.Contains(_currentUser.Id)) ||
            (!string.IsNullOrEmpty(_currentUser.TeamId) && p.AllowedTeamIds != null && p.AllowedTeamIds.Contains(_currentUser.TeamId))))
            .OrderBy(p => p.DisplayName)
            .ToList();
    }

    private Task<IEnumerable<string>> SearchProjects(string value, CancellationToken token)
        => Task.FromResult(TimesheetSearchHelper.SearchProjects(value, _projects));

    private string GetProjectName(string id)
        => TimesheetSearchHelper.GetProjectName(id, _projects);

    private void OnProjectChanged(string projectId)
    {
        _selectedProjectId = projectId;
        _selectedWorkTypeId = string.Empty;
        _selectedSubTaskId = null;
    }

    private void Submit()
    {
        if (_currentUser == null || string.IsNullOrEmpty(_selectedProjectId) || string.IsNullOrEmpty(_selectedWorkTypeId))
            return;

        var result = TimerService.Start(_currentUser.Id, _selectedProjectId, _selectedWorkTypeId, _selectedSubTaskId, _note);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? "Cannot start timer.", Severity.Error);
            return;
        }

        MudDialog.Close(DialogResult.Ok(true));
        Snackbar.Add("Timer started", Severity.Success);
    }

    private void Close() => MudDialog.Cancel();
}

