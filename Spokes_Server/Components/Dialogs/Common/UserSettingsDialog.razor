@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Security
@using Spokes_Server.Core.Services.Licensing
@using Spokes_Server.Core.Services.UI
@using Spokes_Server.Core.Models.Communication.Notifications
@using Microsoft.Extensions.Configuration
@using System.Security.Claims
@using System.Text.Json
@implements IDisposable
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject Database Db
@inject AuthenticationStateProvider AuthStateProvider
@inject UserService UserService
@inject IDialogService DialogService
@inject PresenceStateService PresenceState
@inject UserCircuitContext CircuitContext
@inject SessionService SessionService
@inject NavigationManager Nav
@inject AccountDeletionService AccountDeletionService
@inject IConfiguration Config
@inject LicenseValidationService LicenseValidationService
@inject ISoundService SoundService
@inject ILogger<UserSettingsDialog> Logger

<MudDialog>
    <TitleContent>
        <div class="d-flex align-center gap-2">
            <MudIcon Icon="@Icons.Material.Filled.Settings" />
            <MudText Typo="Typo.h6">@Loc["UserSettings"]</MudText>
        </div>
    </TitleContent>
    <DialogContent>
        <div class="d-flex flex-column gap-4 mb-4">
                @* --- Language & Region Panel --- *@
                <div>
                    <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
                        <div class="d-flex align-center my-1 ml-4">
                            <MudIcon Icon="@Icons.Material.Filled.Language" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.h6">@Loc["LanguageAndRegion"]</MudText>
                        </div>
                        <MudDivider />
                        <div class="d-flex align-center justify-space-between px-4 py-3">
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight: 500;">@Loc["SelectLanguage"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["SelectLanguageDescription"]</MudText>
                            </div>
                            <MudSelect T="string" Value="@_selectedLanguage" ValueChanged="OnLanguageChanged" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 170px;">
                                <MudSelectItem Value="@("en-US")">English (US)</MudSelectItem>
                                <MudSelectItem Value="@("fr-FR")">Français (French)</MudSelectItem>
                                <MudSelectItem Value="@("de-DE")">Deutsch (German)</MudSelectItem>
                            </MudSelect>
                        </div>
                    </MudPaper>
                </div>

                @* --- Security Panel --- *@
                <div>
                    
                    <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
                        <div class="d-flex align-center my-1 ml-4">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.h6">@Loc["Security"]</MudText>
                        </div>
                        <MudDivider />
                        <div class="d-flex align-center justify-space-between px-4 py-3">
                            <div>
                                <MudText Typo="Typo.body1" Style="font-weight: 500;">@Loc["Secure Chat"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Manage your local chat encryption password."]</MudText>
                            </div>
                            <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenSecureChatSettings">@Loc["Manage"]</MudButton>
                        </div>
                    </MudPaper>
                </div>

                @* --- Notification Preferences Panel --- *@
                <div>
                    
                    <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
                        <div class="d-flex align-center my-1 ml-4">
                            <MudIcon Icon="@Icons.Material.Filled.Notifications" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.h6">@Loc["Notification Preferences"]</MudText>
                        </div>
                        <MudDivider />
                        @if (!IsFriendEdition)
                        {
                            <div class="d-flex align-center justify-space-between px-4 mt-2">
                                <MudText Typo="Typo.body2" Style="font-weight: 500;">Enable All Notifications</MudText>
                                <MudSwitch Value="_pushEnabled" Color="Color.Primary" ValueChanged="OnMasterToggleChanged" T="bool" Class="ma-0" />
                            </div>
                        }

                        <div class="d-flex flex-column px-4 pb-4">
                            @if (!IsFriendEdition)
                            {
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.body2">@BizLoc["Chat Messages"]</MudText>
                                    <MudSwitch Value="_chatEnabled" Color="Color.Secondary" Disabled="!_pushEnabled" ValueChanged="OnChatToggleChanged" T="bool" Class="ma-0" />
                                </div>
                                <div class="d-flex align-center justify-space-between">
                                    <MudText Typo="Typo.body2">@BizLoc["Emails"]</MudText>
                                    <MudSwitch Value="_emailEnabled" Color="Color.Secondary" Disabled="!_pushEnabled" ValueChanged="OnEmailToggleChanged" T="bool" Class="ma-0" />
                                </div>
                            }

                            <div class="d-flex align-center justify-space-between py-2">
                                <div class="mr-4">
                                    <MudText Typo="Typo.body2">@Loc["Chat Reactions"]</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["Receive notifications when another user reacts to your messages."]</MudText>
                                </div>
                                <MudSwitch Value="_reactionEnabled" Color="Color.Secondary" Disabled="!_pushEnabled" ValueChanged="OnReactionToggleChanged" T="bool" Class="ma-0" />
                            </div>

                            <div class="d-flex align-center justify-space-between py-2">
                                <div class="mr-4">
                                    <MudText Typo="Typo.body2">@Loc["Treat Replies as Mentions"]</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["Receive notifications when someone replies directly to your message."]</MudText>
                                </div>
                                <MudSwitch Value="_replyTreatAsMentionEnabled" Color="Color.Secondary" Disabled="!_pushEnabled" ValueChanged="OnReplyTreatAsMentionToggleChanged" T="bool" Class="ma-0" />
                            </div>

                            @if (_currentUser?.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Chat.Moderator) == true)
                            {
                                <div class="d-flex align-center justify-space-between py-2">
                                    <div class="mr-4">
                                        <MudText Typo="Typo.body2">@Loc["Moderation Alerts"]</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["Receive notifications when a user reports a message."]</MudText>
                                    </div>
                                    <MudSwitch Value="_moderationEnabled" Color="Color.Secondary" Disabled="!_pushEnabled" ValueChanged="OnModerationToggleChanged" T="bool" Class="ma-0" />
                                </div>
                            }

                                <div class="d-flex align-center justify-space-between py-2">
                                    <div class="mr-4">
                                        <MudText Typo="Typo.body2">@Loc["Limit Notification Sounds"]</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["Only play a sound for the first few unread messages in a channel."]</MudText>
                                    </div>
                                <MudSwitch Value="_limitConsecutiveSounds" Color="Color.Secondary" ValueChanged="OnLimitConsecutiveSoundsChanged" T="bool" Class="ma-0" />
                                </div>
                                
                                <MudCollapse Expanded="_limitConsecutiveSounds">
                                    <div class="d-flex align-center pt-2 pb-2 pl-4">
                                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mr-4">@Loc["Notification limit per channel"]</MudText>
                                        <MudNumericField Value="_consecutiveSoundLimit" T="int" ValueChanged="OnConsecutiveSoundLimitChanged" Min="1" Max="20" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 80px;" />
                                    </div>
                                </MudCollapse>

                                <div class="d-flex align-center justify-space-between py-2">
                                    <div class="mr-4">
                                        <MudText Typo="Typo.body2">@Loc["Shared Calendar Alerts"]</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["Receive reminders for events shared with you by default. Turn off to opt out by default and enable alerts per event."]</MudText>
                                    </div>
                                    <MudSwitch Value="!_muteSharedCalendarAlertsByDefault" Color="Color.Secondary" ValueChanged="OnReceiveSharedCalendarAlertsChanged" T="bool" Class="ma-0" />
                                </div>

                                <MudDivider Class="my-2" />

                                <div class="d-flex align-center justify-space-between py-2">
                                    <div>
                                        <MudText Typo="Typo.body2" Style="font-weight: 500;">@Loc["Notification Sounds"]</MudText>
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["Customize notification sounds for chats, calls, and calendar alerts."]</MudText>
                                    </div>
                                    <MudButton Class="ml-2 flex-shrink-0" Variant="Variant.Outlined" Color="Color.Primary" OnClick="OpenNotificationSoundsDialog">@Loc["Manage"]</MudButton>
                                </div>
                        </div>
                    </MudPaper>
                </div>

                @* --- Notification Schedule Panel --- *@
                @if (_pushEnabled)
                {
                    <div>
                        
                        <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
                            <div class="d-flex align-center my-1 ml-4">
                                <MudIcon Icon="@Icons.Material.Filled.AccessTime" Size="Size.Small" Class="mr-2" />
                                <MudText Typo="Typo.h6">@Loc["Quiet Hours"]</MudText>
                            </div>
                            <MudDivider />
                            <div class="d-flex align-center justify-space-between px-4 py-3">
                                <div class="mr-4">
                                    <MudText Typo="Typo.body1" Style="font-weight: 500;">@Loc["Enable Quiet Hours"]</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["Notifications outside these hours will be queued and delivered when your day starts."]</MudText>
                                </div>
                                <MudSwitch Value="_scheduleEnabled" Color="Color.Secondary" ValueChanged="OnScheduleToggleChanged" T="bool" Class="ma-0" />
                            </div>

                            @if (_scheduleEnabled)
                            {
                                <div class="px-4 pb-4">
                                    <MudGrid Spacing="2">
                                        @foreach (var day in _schedule)
                                        {
                                            <MudItem xs="12" sm="6" md="6">
                                                <MudCard Elevation="0" Outlined="true" Class="h-100 device-card" Style="border-radius: 8px;">
                                                    <MudCardContent Class="pa-3">
                                                        <div class="d-flex justify-space-between align-center mb-2">
                                                            <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">@day.Day.ToString()</MudText>
                                                            <MudSwitch T="bool" Value="day.IsEnabled"
                                                                ValueChanged="@(v => OnDayToggleChanged(day.Day, v))"
                                                                Color="Color.Primary" Class="ma-0" />
                                                        </div>
                                                        <div class="d-flex gap-2">
                                                            <MudSelect T="int" Value="day.StartHour" Dense="true" Margin="Margin.Dense"
                                                                Variant="Variant.Outlined" Disabled="!day.IsEnabled" Label="@Loc["From"]"
                                                                ValueChanged="@(v => OnStartHourChanged(day.Day, v))">
                                                                @for (int h = 0; h < 24; h++)
                                                                {
                                                                    var hour = h;
                                                                    <MudSelectItem T="int" Value="hour">@FormatHour(hour)</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                            <MudSelect T="int" Value="day.EndHour" Dense="true" Margin="Margin.Dense"
                                                                Variant="Variant.Outlined" Disabled="!day.IsEnabled" Label="@Loc["To"]"
                                                                ValueChanged="@(v => OnEndHourChanged(day.Day, v))">
                                                                @for (int h = 0; h < 24; h++)
                                                                {
                                                                    var hour = h;
                                                                    <MudSelectItem T="int" Value="hour">@FormatHour(hour)</MudSelectItem>
                                                                }
                                                            </MudSelect>
                                                        </div>
                                                    </MudCardContent>
                                                </MudCard>
                                            </MudItem>
                                        }
                                    </MudGrid>
                                </div>
                            }
                        </MudPaper>
                    </div>
                }

                @* --- Current Device Panel --- *@
                <div>
                    
                    <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
                        <div class="d-flex align-center my-1 ml-4">
                            <MudIcon Icon="@Icons.Material.Filled.Smartphone" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.h6">@Loc["This Device"]</MudText>
                        </div>
                        <MudDivider></MudDivider>
                        <div class="pa-4">
                            @if (_isDeviceStatusLoading)
                            {
                                <div class="d-flex align-center justify-center py-2">
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Detecting device status..."]</MudText>
                                </div>
                            }
                            else if (!IsSupported)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-0">
                                    @Loc["Push notifications are not supported on this browser:"] @UnsupportedReason
                                </MudAlert>
                            }
                            else if (!IsConfigured)
                            {
                                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-0">
                                    @Loc["Push notifications are not configured by an administrator."]
                                </MudAlert>
                            }
                            else if (_requiresRelay && !_isNativePushLicensed)
                            {
                                @if (IsSubscribed)
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="false" Class="mb-0">
                                        <div class="d-flex flex-column gap-1">
                                            <div class="d-flex align-center justify-space-between">
                                                <MudText Typo="Typo.subtitle2" Style="font-weight: 600;">
                                                    @(_isDesktopApp ? Loc["Desktop Notifications Paused"] : Loc["Mobile Notifications Paused"])
                                                </MudText>
                                                <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                                    Disabled="@IsLoading" OnClick="UnsubscribeDevice">
                                                    @Loc["Disable"]
                                                </MudButton>
                                            </div>
                                            <MudText Typo="Typo.body2">
                                                @Loc["This device is registered, but notifications cannot be delivered because this server's Spokes Pass has expired. Subscriptions are retained and will resume automatically once renewed."]
                                            </MudText>
                                            @if (_currentUser?.IsAdmin == true || _currentUser?.HasPermission(AppPermissions.Admin.ManageSettings) == true)
                                            {
                                                <div class="mt-2">
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                               OnClick="@(() => { MudDialog.Close(); Nav.NavigateTo("/admin/settings?tab=setup"); })">
                                                        @Loc["Manage Spokes Pass"]
                                                    </MudButton>
                                                </div>
                                            }
                                        </div>
                                    </MudAlert>
                                }
                                else
                                {
                                    <MudAlert Severity="Severity.Warning" Dense="false" Class="license-warning-alert mb-0">
                                        <div class="d-flex flex-column gap-2">
                                            <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">
                                                @(_isDesktopApp ? Loc["Desktop Notifications Unavailable"] : Loc["Mobile Notifications Unavailable"])
                                            </MudText>
                                            <MudText Typo="Typo.body2">
                                                @if (_currentUser?.IsAdmin == true || _currentUser?.HasPermission(AppPermissions.Admin.ManageSettings) == true)
                                                {
                                                    <span>@Loc["Your server is not currently licensed for native push notifications. A single Spokes Pass covers all desktop and mobile apps on this server."]</span>
                                                }
                                                else
                                                {
                                                    @if (_isDesktopApp)
                                                    {
                                                        <span>@Loc["A Spokes Pass is required for desktop app notifications. Only 1 pass per server is required. Talk to your server owner to enable notifications."]</span>
                                                    }
                                                    else
                                                    {
                                                        <span>@Loc["Spokes Pass is required for mobile notifications to work. Only 1 pass per server is required. Talk to your server owner, I'm sure they would love to split the cost :)"]</span>
                                                    }
                                                }
                                            </MudText>
                                            @if (_currentUser?.IsAdmin == true || _currentUser?.HasPermission(AppPermissions.Admin.ManageSettings) == true)
                                            {
                                                <div class="mt-1">
                                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                                               OnClick="@(() => { MudDialog.Close(); Nav.NavigateTo("/admin/settings?tab=setup"); })">
                                                        @Loc["Resolve in Server Settings"]
                                                    </MudButton>
                                                </div>
                                            }
                                        </div>
                                    </MudAlert>
                                }
                            }
                            else if (IsSubscribed)
                            {
                                <div class="d-flex align-center justify-space-between">
                                    <div class="d-flex align-center gap-2">
                                        <MudIcon Icon="@Icons.Material.Filled.CheckCircle" Color="Color.Success" Size="Size.Small" />
                                        <MudText Typo="Typo.body2">@Loc["Notifications are enabled on this device."]</MudText>
                                    </div>
                                    <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small"
                                        Disabled="@IsLoading" OnClick="UnsubscribeDevice">
                                        @Loc["Disable"]
                                    </MudButton>
                                </div>
                            }
                            else if (_currentUser?.IsSuspended == true)
                            {
                                <MudAlert Severity="Severity.Warning" Dense="true" Class="mb-0">
                                    @Loc["Suspended accounts cannot enable notifications for new devices."]
                                </MudAlert>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2" Class="mb-3">
                                    @Loc["Enable push notifications to receive alerts when the browser is minimized."]
                                </MudText>

                                <MudGrid Spacing="2">
                                    <MudItem xs="12" sm="6">
                                        <MudSelect Value="_newDeviceType" ValueChanged="@((string v) => _newDeviceType = v)" Label="@Loc["Device Type"]" Variant="Variant.Outlined"
                                            Margin="Margin.Dense" T="string">
                                            <MudSelectItem Value="@Spokes_Server.Core.Models.Core.DeviceType.Desktop">@Loc["Desktop"]</MudSelectItem>
                                            <MudSelectItem Value="@Spokes_Server.Core.Models.Core.DeviceType.Mobile">@Loc["Mobile"]</MudSelectItem>
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="12" sm="6">
                                        <MudTextField Value="_newDeviceName" ValueChanged="@((string v) => _newDeviceName = v)" Label="@Loc["Device Name (optional)"]"
                                            Placeholder="@Loc["e.g., Work Laptop"]" Variant="Variant.Outlined" Margin="Margin.Dense" T="string" />
                                    </MudItem>
                                </MudGrid>

                                <div class="mt-3">
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                        Disabled="@IsLoading" OnClick="SubscribeDevice" StartIcon="@Icons.Material.Filled.NotificationsActive">
                                        @if (IsLoading)
                                        {
                                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                        }
                                        @Loc["Enable Notifications"]
                                    </MudButton>
                                </div>
                            }
                            </div>
                        
                    </MudPaper>
                </div>
            </div>

            @* --- Registered Devices --- *@
            @if (_devices.Any())
            {
                <MudDivider Class="mt-5 mb-3" />
                <MudText Typo="Typo.h6" Class="ml-4 mb-2">@Loc["Registered Devices"]</MudText>

                <MudGrid Spacing="3">
                    @foreach (var device in _devices)
                    {
                        <MudItem xs="12" sm="6" md="6">
                            <MudCard Elevation="0" Outlined="true" Class="h-100 d-flex flex-column device-card" Style="border-radius: 16px;">
                                <MudCardContent Class="pa-4 flex-grow-1">
                                    <div class="d-flex align-center justify-space-between mb-2">
                                        <div class="d-flex align-center gap-2 flex-grow-1" style="min-width: 0; max-width: 100%;">
                                            <MudIcon Icon="@(device.DeviceType == Spokes_Server.Core.Models.Core.DeviceType.Mobile || device.IsCapacitor ? Icons.Material.Filled.PhoneAndroid : Icons.Material.Filled.Computer)" Size="Size.Small" Color="Color.Default" Class="flex-shrink-0" />
                                            
                                            @if (_editingDeviceId == device.Id)
                                            {
                                                <div class="d-flex align-center flex-grow-1 gap-1" style="min-width: 0;">
                                                    <MudTextField Value="_editingDeviceName" ValueChanged="@((string v) => _editingDeviceName = v)" Variant="Variant.Text"
                                                        Margin="Margin.Dense" FullWidth="true" Class="flex-grow-1" Style="margin-top: -8px;"
                                                        OnKeyDown="@(e => { if (e.Key == "Enter") SaveDeviceName(device.Id); })"
                                                        Immediate="true" T="string" />
                                                    <MudIconButton Icon="@Icons.Material.Filled.Check" Size="Size.Small" Color="Color.Primary"
                                                        OnClick="@(() => SaveDeviceName(device.Id))" Class="flex-shrink-0" />
                                                </div>
                                            }
                                            else
                                            {
                                                <MudText Typo="Typo.subtitle1" Style="font-weight: 600; text-overflow: ellipsis; overflow: hidden; white-space: nowrap;" title="@device.DeviceName">
                                                    @(string.IsNullOrEmpty(device.DeviceName) ? Loc["(unnamed)"].Value : device.DeviceName)
                                                </MudText>
                                                
                                                @if (!string.IsNullOrEmpty(device.DeviceName) ? true : device.HasPush)
                                                {
                                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                                                   OnClick="@(() => StartEditDeviceName(device))" Class="flex-shrink-0 pa-1 ml-n1" />
                                                }
                                            }
                                        </div>
                                    </div>
                                    
                                    <div class="d-flex align-center mb-1 ml-1">
                                        @if (device.Id == _currentSessionId)
                                        {

                                            <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Text" Class="ml-n2"
                                                     Style="font-size: 0.7rem; padding: 0 4px; height: 20px;">@Loc["This device"]</MudChip>
                                        
                                        }

                                        @if (PresenceState.GetOnlineSessions().Contains(device.Id))
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Filled" Class="ml-2"
                                                     Style="font-size: 0.7rem; padding: 0 4px; height: 20px;">@Loc["Online"]</MudChip>
                                        }

                                        @if (device.HasVaultCookie)
                                        {
                                            <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled" Class="ml-2"
                                                     Style="font-size: 0.7rem; padding: 0 4px; height: 20px;">@Loc["Secure Chat"]</MudChip>
                                        }
                                    </div>

                                    @if (device.LastSeenAt.HasValue)
                                    {
                                        <div class="d-flex align-center mb-3 ml-1">
                                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Last seen:"] @device.LastSeenAt.Value.ToLocalTime().ToString("g")</MudText>
                                        </div>
                                    }

                                    @if (device.HasPush)
                                    {
                                        var isDeviceRelay = device.PushSubscriptionType == Spokes_Server.Core.Models.Core.PushSubscriptionType.NativeRelay || device.IsCapacitor;
                                        var isPushBlockedForDevice = isDeviceRelay && !_isNativePushLicensed;

                                        <MudDivider Class="mb-3" />
                                        <div class="d-flex flex-column gap-2 ml-1">
                                            <div class="d-flex justify-space-between align-center">
                                                <div class="d-flex align-center gap-2">
                                                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Push Notifications"]</MudText>
                                                    @if (isPushBlockedForDevice)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Outlined" Style="font-size: 0.65rem; height: 18px; padding: 0 4px;">@Loc["Pass Required"]</MudChip>
                                                    }
                                                </div>
                                                <MudSwitch T="bool" Value="device.IsEnabled" Class="ma-0"
                                                    Disabled="@isPushBlockedForDevice"
                                                    ValueChanged="@(v => ToggleDeviceEnabled(device.Id, v))"
                                                    Color="Color.Primary" Size="Size.Small" />
                                            </div>
                                            
                                            <div class="d-flex justify-space-between align-center mt-n1">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Test Notification"]</MudText>
                                                <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" Class="px-2" Style="min-width: unset; height: 28px;"
                                                           OnClick="@(() => TestDevice(device.Id))" Disabled="@(_isTesting || isPushBlockedForDevice)">@Loc["Send"]</MudButton>
                                            </div>
                                            
                                            <div class="d-flex justify-space-between align-center mt-n1">
                                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Remove Push"]</MudText>
                                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" Class="px-2" Style="min-width: unset; height: 28px;"
                                                           OnClick="@(() => DeleteDevice(device.Id))">@Loc["Remove"]</MudButton>
                                            </div>
                                        </div>
                                    }
                                </MudCardContent>
                                
                                <MudCardActions Class="px-4 pb-3 pt-0 d-flex justify-end align-center">
                                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Logout"
                                        OnClick="@(() => RevokeSession(device.Id))">@Loc["Log Out"]</MudButton>
                                </MudCardActions>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
            }

            @if (IsFriendEdition)
            {
                <MudDivider Class="my-4" />
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden" Style="border-color: var(--mud-palette-error);">
                    <div class="d-flex align-center my-1 ml-4">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.h6" Color="Color.Error">@Loc["Danger Zone"]</MudText>
                    </div>
                    <MudDivider />
                    <div class="d-flex align-center justify-space-between px-4 py-3">
                        <div>
                            <MudText Typo="Typo.body1" Style="font-weight: 500;">@Loc["Delete Account"]</MudText>
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Permanently delete your account and wipe your data from the server."]</MudText>
                        </div>
                        <MudButton Class="ml-2" Variant="Variant.Filled" Color="Color.Error" OnClick="ConfirmDeleteAccount">@Loc["Delete Account"]</MudButton>
                    </div>
                </MudPaper>
            }

            <MudDivider Class="my-4" />
            <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden">
                <div class="d-flex align-center my-1 ml-4">
                    <MudIcon Icon="@Icons.Material.Filled.PrivacyTip" Color="Color.Default" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.h6" Color="Color.Default">@Loc["Legal"]</MudText>
                </div>
                <MudDivider />
                <div class="d-flex align-center justify-space-between px-4 py-3">
                    <div>
                        <MudText Typo="Typo.body1" Style="font-weight: 500;">@Loc["Privacy Policy"]</MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Read how your data is handled by this server."]</MudText>
                    </div>
                    <MudButton Class="ml-2" Variant="Variant.Outlined" Color="Color.Primary" Href="@(Db.CompanyProfile.Get()?.PrivacyPolicyUrl ?? "https://spokes.sh/privacy/")" Target="_blank">@Loc["View Policy"]</MudButton>
                </div>
            </MudPaper>
        @if (_debugLogs.Any())
        {
            <MudDivider Class="my-4" />
            <div class="d-flex justify-space-between align-center mb-2">
                <MudText Typo="Typo.subtitle1" Style="font-weight: 600;">@Loc["Debug Logs"]</MudText>
                <div>
                    <MudIconButton Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" OnClick="CopyLogs" title="@Loc["Copy Logs"]" />
                    <MudIconButton Icon="@Icons.Material.Filled.Clear" Size="Size.Small" OnClick="@(() => _debugLogs.Clear())" title="@Loc["Clear Logs"]" />
                </div>
            </div>
            <div style="background: var(--mud-palette-background-grey); padding: 8px; border-radius: 4px; font-family: monospace; font-size: 0.8rem; max-height: 150px; overflow-y: auto;">
                @foreach(var log in _debugLogs)
                {
                    <div style="margin-bottom: 4px; color: @(log.IsError ? "var(--mud-palette-error)" : "inherit")">
                        <span style="color: var(--mud-palette-text-secondary)">[@log.Timestamp.ToString("HH:mm:ss")]</span> @log.Message
                    </div>
                }
            </div>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Close">@Loc["Close"]</MudButton>
    </DialogActions>
</MudDialog>

