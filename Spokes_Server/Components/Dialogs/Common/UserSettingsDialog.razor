    private string FormatHour(int hour)
    {
        var ampm = hour < 12 ? "AM" : "PM";
        var display = hour == 0 ? 12 : (hour > 12 ? hour - 12 : hour);
        return $"{display}:00 {ampm}";
    }

    // --- Subscribe / Unsubscribe ---

    [JSInvokable]
    public void OnJSLog(string message)
    {
        AddSubscriptionLog($"[JS] {message}");
    }

    private async Task SubscribeDevice()
    {
        if (IsLoading) return;
        IsLoading = true;
        _debugLogs.Clear();
        AddSubscriptionLog("Starting subscription process...");
        StateHasChanged();

        try
        {
            // 1. Request permission
            AddSubscriptionLog("Requesting permission...");
            var permResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.requestPermission", _objRef);
            var permission = permResult?.GetValueOrDefault("permission")?.ToString() ?? "denied";

            if (permission != "granted")
            {
                AddSubscriptionLog($"Permission denied. Result: {permission}", true);
                Snackbar.Add(Loc["Notification permission was denied. Enable in browser settings."].Value, Severity.Warning);
                return;
            }
            AddSubscriptionLog("Permission granted.");

            if (permResult != null && permResult.TryGetValue("soundDisabled", out var sd) && sd?.ToString()?.Equals("True", StringComparison.OrdinalIgnoreCase) == true)
            {
                Snackbar.Add(Loc["Notification sounds are disabled for Spokes in your iPhone Settings."].Value, Severity.Warning, config =>
                {
                    config.Action = Loc["Open Settings"].Value;
                    config.ActionColor = Color.Warning;
                    config.OnClick = _ => JS.InvokeVoidAsync("pushNotifications.openAppSettings").AsTask();
                    config.RequireInteraction = true;
                });
            }

            // 2. Register service worker
            AddSubscriptionLog("Registering service worker...");
            var swResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.registerServiceWorker");
            var swSuccess = swResult?.GetValueOrDefault("success")?.ToString() == "True";

            if (!swSuccess)
            {
                var swErr = swResult?.GetValueOrDefault("error")?.ToString();
                AddSubscriptionLog($"SW registration failed: {swErr}", true);
                Snackbar.Add(Loc["Failed to register service worker."].Value, Severity.Error);
                return;
            }
            AddSubscriptionLog("Service worker registered.");

            // 3. Get VAPID public key
            var profile = Db.CompanyProfile.Get();
            if (string.IsNullOrEmpty(profile?.VapidPublicKey))
            {
                AddSubscriptionLog("VAPID public key not found.", true);
                Snackbar.Add(Loc["Push notifications not configured."].Value, Severity.Error);
                return;
            }
            AddSubscriptionLog("VAPID public key retrieved.");

            // 4. Subscribe to push
            AddSubscriptionLog("Subscribing to push manager/native APNs...");
            var subscription = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.subscribe",
                profile.VapidPublicKey, _objRef);

            if (subscription == null || !subscription.ContainsKey("endpoint"))
            {
                var subErr = subscription?.GetValueOrDefault("error")?.ToString() ?? "Unknown error";
                AddSubscriptionLog($"Subscription failed: {subErr}", true);
                Snackbar.Add(Loc["Failed to subscribe to push notifications."].Value, Severity.Error);
                return;
            }
            AddSubscriptionLog("Push subscription successful.");

            // 5. Send to server with device info
            AddSubscriptionLog("Sending subscription to server...");
            var result = await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer",
                subscription, _newDeviceType, _newDeviceName, true);

            if (result)
            {
                AddSubscriptionLog("Subscription saved on server.");
                IsSubscribed = true;
                _currentEndpoint = subscription.GetValueOrDefault("endpoint")?.ToString();
                CircuitContext.HasPushEnabled = true;
                PresenceState.UpdatePushEnabledState(CircuitContext.SubscriptionId, true);
                Snackbar.Add(Loc["Push notifications enabled!"].Value, Severity.Success);
                LoadDevices();
                StateHasChanged();
            }
            else
            {
                AddSubscriptionLog("Server failed to save subscription.", true);
                try
                {
                    var lastErr = await JS.InvokeAsync<Dictionary<string, object>?>("pushNotifications.getLastSubscriptionError");
                    var errCode = lastErr?.GetValueOrDefault("code")?.ToString();
                    if (errCode == "PASS_EXPIRED")
                    {
                        Snackbar.Add(Loc["Native push notifications require an active Spokes Pass."].Value, Severity.Warning);
                    }
                    else
                    {
                        Snackbar.Add(Loc["Failed to save subscription."].Value, Severity.Error);
                    }
                }
                catch
                {
                    Snackbar.Add(Loc["Failed to save subscription."].Value, Severity.Error);
                }
            }
        }
        catch (Exception ex)
        {
            AddSubscriptionLog($"Exception: {ex.Message}", true);
            Logger.LogError(ex, "Error enabling notifications");
            Snackbar.Add(Loc["Error enabling notifications."].Value, Severity.Error);
        }
        finally
        {
            AddSubscriptionLog("Finished.");
            IsLoading = false;
            StateHasChanged();
        }
    }

    private async Task UnsubscribeDevice()
    {
        if (IsLoading) return;
        IsLoading = true;
        StateHasChanged();

        try
        {
            var result = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.unsubscribeAndNotifyServer");
            var success = result?.GetValueOrDefault("success")?.ToString() == "True";

            if (success)
            {
                IsSubscribed = false;
                _currentEndpoint = null;
                CircuitContext.HasPushEnabled = false;
                PresenceState.UpdatePushEnabledState(CircuitContext.SubscriptionId, false);
                Snackbar.Add(Loc["Push notifications disabled on this device."].Value, Severity.Success);
                LoadDevices();
                StateHasChanged();
            }
            else
            {
                Snackbar.Add(Loc["Failed to disable notifications."].Value, Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Error: {0}"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            IsLoading = false;
            StateHasChanged();
        }
    }

    // --- Device Management ---

    private void StartEditDeviceName(DeviceInfo device)
    {
        _editingDeviceId = device.Id;
        _editingDeviceName = device.DeviceName ?? "";
    }

    private void SaveDeviceName(string deviceId)
    {
        try
        {
            var device = _devices.FirstOrDefault(d => d.Id == deviceId);
            if (device == null) return;

            // Update the DeviceSession directly (push fields and session are now unified)
            var session = Db.DeviceSessions.GetById(deviceId);
            if (session != null)
            {
                session.DeviceName = _editingDeviceName;
                session.DeviceInfo = _editingDeviceName;
                Db.DeviceSessions.Save(session);
            }

            device.DeviceName = _editingDeviceName;
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Error renaming device: {0}"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _editingDeviceId = null;
            StateHasChanged();
        }
    }

    private async Task ToggleDeviceEnabled(string deviceId, bool enabled)
    {
        try
        {
            var enabledStr = enabled ? "true" : "false";
            await JS.InvokeAsync<dynamic>("eval", $@"
                (async () => {{
                    var hdrs = await window.spokesAuth.getHeaders({{ 'Content-Type': 'application/json' }});
                    await fetch('/spokesapi/push/devices/{deviceId}', {{
                        method: 'PUT',
                        headers: hdrs,
                        body: JSON.stringify({{ isEnabled: {enabledStr} }})
                    }});
                }})()
            ");

            var device = _devices.FirstOrDefault(d => d.Id == deviceId);
            if (device != null) device.IsEnabled = enabled;

            if (deviceId == _currentSessionId || (device != null && device.Endpoint == _currentEndpoint))
            {
                CircuitContext.HasPushEnabled = enabled;
                PresenceState.UpdatePushEnabledState(CircuitContext.SubscriptionId, enabled);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Error updating device: {0}"].Value, ex.Message), Severity.Error);
        }
    }

    private async Task DeleteDevice(string sessionId)
    {
        try
        {
            // Clear push fields from the DeviceSession (via API for auth)
            await JS.InvokeAsync<dynamic>("eval", $@"
                (async () => {{
                    var hdrs = await window.spokesAuth.getHeaders();
                    await fetch('/spokesapi/push/devices/{sessionId}', {{
                        method: 'DELETE',
                        headers: hdrs
                    }});
                }})()
            ");

            var device = _devices.FirstOrDefault(d => d.Id == sessionId);
            if (device != null)
            {
                device.HasPush = false;
                device.IsEnabled = false;
            }

            // If we deleted the current device's subscription
            if (sessionId == _currentSessionId)
            {
                // The server-side push data is cleared, but the browser push subscription may still exist.
                // Unsubscribe locally too.
                await JS.InvokeAsync<object>("pushNotifications.unsubscribe");
                IsSubscribed = false;
                _currentEndpoint = null;
                CircuitContext.HasPushEnabled = false;
                PresenceState.UpdatePushEnabledState(CircuitContext.SubscriptionId, false);
            }

            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Error deleting device: {0}"].Value, ex.Message), Severity.Error);
        }
    }

