@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public Employee? Employee { get; set; }

    // State
    private bool _isDeviceStatusLoading = true;
    private bool IsSupported = false;
    private string UnsupportedReason = "";
    private bool IsConfigured = false;
    private bool IsSubscribed = false;
    private bool IsLoading = false;
    private bool _isNativeMobile = false;
    private bool _isDesktopApp = false;
    private bool _requiresRelay = false;
    private bool _isNativePushLicensed = true;
    private string _nativePushMessage = "";

    // Preferences
    private string _selectedLanguage = "en-US";
    private bool _pushEnabled = true;
    private bool _chatEnabled = true;
    private bool _reactionEnabled = true;
    private bool _replyTreatAsMentionEnabled = true;
    private bool _emailEnabled = true;
    private bool _moderationEnabled = true;
    private bool _limitConsecutiveSounds = false;
    private int _consecutiveSoundLimit = 3;
    private bool _muteSharedCalendarAlertsByDefault = false;

    // Schedule
    private bool _scheduleEnabled = false;
    private List<DaySchedule> _schedule = Enumerable.Range(0, 7)
        .Select(i => new DaySchedule { Day = (DayOfWeek)i }).ToList();

    // New device form
    private string _newDeviceType = DeviceType.Desktop;
    private string _newDeviceName = "";

    // Device list
    private List<DeviceInfo> _devices = new();
    private string? _currentEndpoint = null;
    private string? _currentSessionId = null;
    private string? _editingDeviceId = null;
    private string _editingDeviceName = "";

    // User
    private Employee? _currentUser;
    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";

    // Debugging and Testing
    private DotNetObjectReference<UserSettingsDialog>? _objRef;
    private List<DebugLog> _debugLogs = new();
    private bool _isTesting = false;

    private void AddSubscriptionLog(string message, bool isError = false)
    {
        AddDebugLog(message, isError);
    }

    private class DebugLog
    {
        public DateTime Timestamp { get; set; } = DateTime.Now;
        public string Message { get; set; } = "";
        public bool IsError { get; set; }
    }

    private async Task CopyLogs()
    {
        var logText = string.Join(Environment.NewLine, _debugLogs.Select(l => $"[{l.Timestamp:HH:mm:ss}] {l.Message}"));
        try
        {
            await JS.InvokeVoidAsync("spokesCopyText", logText);
            Snackbar.Add(Loc["Logs copied to clipboard"].Value, Severity.Success);
        }
        catch (Exception)
        {
            Snackbar.Add(Loc["Failed to copy logs"].Value, Severity.Error);
        }
    }

    private void AddDebugLog(string message, bool isError = false)
    {
        _debugLogs.Add(new DebugLog { Message = message, IsError = isError });
        InvokeAsync(StateHasChanged);
    }

    protected override async Task OnInitializedAsync()
    {
        _objRef = DotNetObjectReference.Create(this);

        // 1. Resolve current user from passed parameter or UserService
        _currentUser = Employee ?? await UserService.GetEmployeeAsync();
        if (_currentUser != null)
        {
            _pushEnabled = _currentUser.PushNotificationsEnabled;
            _chatEnabled = _currentUser.ChatNotificationsEnabled;
            _reactionEnabled = _currentUser.ReactionNotificationsEnabled;
            _replyTreatAsMentionEnabled = _currentUser.ReplyNotificationsTreatAsMention;
            _emailEnabled = _currentUser.EmailNotificationsEnabled;
            _moderationEnabled = _currentUser.ModerationNotificationsEnabled;
            _limitConsecutiveSounds = _currentUser.LimitConsecutiveNotificationSounds;
            _consecutiveSoundLimit = _currentUser.ConsecutiveNotificationSoundLimit;
            _muteSharedCalendarAlertsByDefault = _currentUser.MuteSharedCalendarAlertsByDefault;
            _scheduleEnabled = _currentUser.NotificationScheduleEnabled;
            _schedule = _currentUser.NotificationSchedule
                .Select(d => new DaySchedule { Day = d.Day, IsEnabled = d.IsEnabled, StartHour = d.StartHour, EndHour = d.EndHour })
                .ToList();
            _selectedLanguage = !string.IsNullOrWhiteSpace(_currentUser.PreferredLanguage)
                ? _currentUser.PreferredLanguage
                : System.Globalization.CultureInfo.CurrentUICulture.Name;
        }

        // 2. Resolve current session ID
        try
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            _currentSessionId = authState.User.FindFirst("SessionId")?.Value;
        }
        catch { }

        // 3. Populate devices immediately from database
        LoadDevices();
    }

    public void Dispose()
    {
        _objRef?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            await LoadClientDeviceStateAsync();
            if (_objRef != null)
            {
                try
                {
                    await JS.InvokeVoidAsync("pushNotifications.setupMessageListener", _objRef);
                }
                catch { }
            }
            _isDeviceStatusLoading = false;
            StateHasChanged();
        }
    }

    private async Task LoadClientDeviceStateAsync()
    {
        // Load push support status
        try
        {
            IsSupported = await JS.InvokeAsync<bool>("pushNotifications.isSupported");
            if (!IsSupported)
            {
                UnsupportedReason = await JS.InvokeAsync<string>("pushNotifications.getSupportReason");
            }
            if (IsSupported)
            {
                try
                {
                    _isNativeMobile = await JS.InvokeAsync<bool>("pushNotifications.isNativePlatform");
                    _isDesktopApp = await JS.InvokeAsync<bool>("pushNotifications.isDesktopApp");
                    _requiresRelay = await JS.InvokeAsync<bool>("pushNotifications.requiresPushRelay");
                }
                catch { }

                var currentConfig = Db.ServerConfigs.GetOrCreateGlobalConfig();
                var profile = Db.CompanyProfile.Get();
                var licenseResult = LicenseValidationService.ValidateLicense(profile?.LicensePayload, currentConfig);
                _isNativePushLicensed = licenseResult.Status != Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock &&
                                        licenseResult.Status != Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired;
                _nativePushMessage = licenseResult.Message;

                IsConfigured = !string.IsNullOrEmpty(profile?.VapidPublicKey);

                if (IsConfigured)
                {
                    var existingSub = await JS.InvokeAsync<Dictionary<string, object>?>("pushNotifications.getExistingSubscription");
                    if (existingSub != null && existingSub.TryGetValue("endpoint", out var epObj))
                    {
                        _currentEndpoint = epObj?.ToString();
                    }
                    if (existingSub != null && existingSub.TryGetValue("subscriptionType", out var subTypeObj) && subTypeObj?.ToString() == "NativeRelay")
                    {
                        _requiresRelay = true;
                    }

                    // Keep IsSubscribed strictly server-authoritative from current session in _devices
                    if (!string.IsNullOrEmpty(_currentSessionId))
                    {
                        var current = _devices.FirstOrDefault(d => d.Id == _currentSessionId);
                        IsSubscribed = current?.HasPush == true && current.IsEnabled;
                    }
                }

                // Auto-detect device type
                _newDeviceType = await JS.InvokeAsync<string>("pushNotifications.detectDeviceType");
                _newDeviceName = await JS.InvokeAsync<string>("pushNotifications.detectDeviceName");
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading push status");
        }

        if (!string.IsNullOrEmpty(_currentSessionId))
        {
            try
            {
                var vaultRes = await JS.InvokeAsync<System.Text.Json.JsonElement>("spokesVault.getStatus");
                if (vaultRes.ValueKind != System.Text.Json.JsonValueKind.Null && vaultRes.TryGetProperty("hasCookie", out var hc))
                {
                    var hasCookie = hc.GetBoolean();
                    var currentSession = Db.DeviceSessions.GetById(_currentSessionId);
                    if (currentSession != null && currentSession.HasVaultCookie != hasCookie)
                    {
                        currentSession.HasVaultCookie = hasCookie;
                        Db.DeviceSessions.Save(currentSession);
                        LoadDevices();
                    }
                }
            }
            catch { }
        }
    }

    private async Task OnLanguageChanged(string newCulture)
    {
        _selectedLanguage = newCulture;
        if (_currentUser != null)
        {
            var freshUser = Db.Employees.GetById(_currentUser.Id);
            if (freshUser != null)
            {
                freshUser.PreferredLanguage = newCulture;
                Db.Employees.Save(freshUser);
            }
        }

        var relativePath = "/" + Nav.ToBaseRelativePath(Nav.Uri);
        Nav.NavigateTo($"/spokesapi/culture/set?culture={Uri.EscapeDataString(newCulture)}&redirectUri={Uri.EscapeDataString(relativePath)}", forceLoad: true);
    }

    private void LoadDevices()
    {
        try
        {
            if (_currentUser == null) return;

            // Unified device list: each DeviceSession IS a device card. No join logic needed.
            var sessions = Db.DeviceSessions.GetActiveByEmployeeId(_currentUser.Id);
            _devices = sessions.Select(s => new DeviceInfo
            {
                Id = s.Id,
                DeviceType = s.IsCapacitorApp ? Spokes_Server.Core.Models.Core.DeviceType.Mobile : s.DeviceType,
                DeviceName = !string.IsNullOrEmpty(s.DeviceName) ? s.DeviceName : s.DeviceInfo,
                DeviceInfoText = s.DeviceInfo,
                LastSeenAt = s.LastSeenAt,
                IsEnabled = s.HasPush && s.PushEnabled,
                IsIdleDetectionEnabled = s.IsCapacitorApp ? false : s.IsIdleDetectionEnabled,
                HasPush = s.HasPush,
                PushSubscriptionType = s.PushSubscriptionType ?? "",
                Endpoint = s.PushEndpoint ?? "",
                HasVaultCookie = s.HasVaultCookie,
                DeviceId = s.DeviceId,
                IsCapacitor = s.IsCapacitorApp
            })
            .OrderByDescending(d => d.Id == _currentSessionId)
            .ThenByDescending(d => d.LastSeenAt)
            .ToList();

            // Update IsSubscribed based on server-authoritative state
            if (!string.IsNullOrEmpty(_currentSessionId))
            {
                var currentDevice = _devices.FirstOrDefault(d => d.Id == _currentSessionId);
                if (currentDevice != null)
                {
                    IsSubscribed = currentDevice.HasPush;
                }
            }
        }
        catch
        {
            _devices = new List<DeviceInfo>();
        }
    }

    private string ParseUserAgentToDeviceInfo(string userAgent)
    {
        if (string.IsNullOrEmpty(userAgent)) return "Unknown Device";
        var deviceInfo = "Unknown Device";
        if (userAgent.Contains("Windows")) deviceInfo = "Windows";
        else if (userAgent.Contains("iPhone") || userAgent.Contains("iPad")) deviceInfo = "iOS";
        else if (userAgent.Contains("Android")) deviceInfo = "Android";
        else if (userAgent.Contains("Mac OS")) deviceInfo = "macOS";
        
        if (userAgent.Contains("Capacitor") || userAgent.Contains("wv")) deviceInfo += " (App)";
        return deviceInfo;
    }

    private async Task RevokeSession(string sessionId)
    {
        var session = Db.DeviceSessions.GetById(sessionId);
        if (session != null)
        {
            session.RevokedAt = DateTime.UtcNow;
            // Push fields live on the session — clear them on revocation
            if (session.HasPush)
            {
                session.PushEndpoint = null;
                session.PushEnabled = false;
            }
            Db.DeviceSessions.Save(session);

            if (sessionId == _currentSessionId)
            {
                // Force logout immediately if revoking the current session
                bool isCapacitor = false;
                try { isCapacitor = await JS.InvokeAsync<bool>("eval", "!!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform())"); } catch { }
                var suffix = isCapacitor ? "?client=mobile" : "";
                Nav.NavigateTo($"/spokesapi/auth/force-logout{suffix}", forceLoad: true);
                return;
            }
            else
            {
                // Trigger remote logout for active clients via SessionService
                SessionService.TriggerRemoteLogout(sessionId);
            }

            Snackbar.Add(Loc["Session revoked."].Value, Severity.Success);
            LoadDevices();
            StateHasChanged();
        }
    }

    // --- Preferences ---

    private async Task OnMasterToggleChanged(bool value)
    {
        _pushEnabled = value;
        await SavePreferences();
    }

    private async Task OnChatToggleChanged(bool value)
    {
        _chatEnabled = value;
        await SavePreferences();
    }

    private async Task OnEmailToggleChanged(bool value)
    {
        _emailEnabled = value;
        await SavePreferences();
    }

    private async Task OnReactionToggleChanged(bool value)
    {
        _reactionEnabled = value;
        await SavePreferences();
    }

    private async Task OnReplyTreatAsMentionToggleChanged(bool value)
    {
        _replyTreatAsMentionEnabled = value;
        await SavePreferences();
    }

    private async Task OnModerationToggleChanged(bool value)
    {
        _moderationEnabled = value;
        await SavePreferences();
    }

    private async Task OnLimitConsecutiveSoundsChanged(bool value)
