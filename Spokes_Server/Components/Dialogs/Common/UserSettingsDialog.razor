    private async Task SavePreferences()
    {
        if (_currentUser == null) return;

        var fresh = Db.Employees.GetById(_currentUser.Id);
        if (fresh == null) return;

        fresh.PushNotificationsEnabled = _pushEnabled;
        fresh.ChatNotificationsEnabled = _chatEnabled;
        fresh.ReactionNotificationsEnabled = _reactionEnabled;
        fresh.ReplyNotificationsTreatAsMention = _replyTreatAsMentionEnabled;
        fresh.EmailNotificationsEnabled = _emailEnabled;
        fresh.ModerationNotificationsEnabled = _moderationEnabled;
        fresh.LimitConsecutiveNotificationSounds = _limitConsecutiveSounds;
        fresh.ConsecutiveNotificationSoundLimit = _consecutiveSoundLimit;
        fresh.MuteSharedCalendarAlertsByDefault = _muteSharedCalendarAlertsByDefault;
        fresh.NotificationScheduleEnabled = _scheduleEnabled;
        fresh.NotificationSchedule = _schedule
            .Select(d => new DaySchedule { Day = d.Day, IsEnabled = d.IsEnabled, StartHour = d.StartHour, EndHour = d.EndHour })
            .ToList();
        Db.Employees.Save(fresh);

        await Task.CompletedTask;
    }

    // --- Schedule ---

    private async Task OnScheduleToggleChanged(bool value)
    {
        _scheduleEnabled = value;
        await SavePreferences();
    }

    private async Task OnDayToggleChanged(DayOfWeek day, bool value)
    {
        var entry = _schedule.FirstOrDefault(d => d.Day == day);
