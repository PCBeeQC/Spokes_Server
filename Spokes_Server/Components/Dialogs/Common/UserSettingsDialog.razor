    private async Task ConfirmDeleteAccount()
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
            Loc["Delete Account"].Value,
            Loc["Are you absolutely sure? This will permanently delete your account and all associated data from this server. This action cannot be undone."].Value,
            yesText: Loc["Delete My Account"].Value, cancelText: Loc["Cancel"].Value);

        if (result == true && _currentUser != null)
        {
            bool isDemo = Config.GetValue<bool>("Spokes_DemoMode");
            
            if (!isDemo)
            {
                AccountDeletionService.DeleteAccount(_currentUser.Id, _currentSessionId);
            }

            var successMessage = isDemo 
                ? Loc["Your account deletion was successfully simulated (Demo Mode). You will now be logged out."].Value
                : Loc["Your account and all associated personal data have been successfully wiped from our servers."].Value;

            await DialogService.ShowMessageBoxAsync(Loc["Account Deleted"].Value, successMessage, yesText: Loc["Return to Login"].Value);
                
            bool isCapacitor = false;
            try { isCapacitor = await JS.InvokeAsync<bool>("eval", "!!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform())"); } catch { }
            
            if (isDemo)
            {
                // To prevent the demo server from instantly auto-logging the reviewer back into a new random account,
                // we manually wipe cookies and redirect directly to the login page with admin_login=1 to bypass auto-login.
                await JS.InvokeVoidAsync("eval", $@"
                    document.cookie = 'Spokes_Session_v3=; Max-Age=0; path=/';
                    document.cookie = 'Spokes_Refresh=; Max-Age=0; path=/';
                    var suffix = {isCapacitor.ToString().ToLower()} ? '&client=mobile' : '';
                    window.location.href = '/sso/login?admin_login=1' + suffix;
                ");
            }
            else
            {
                await JS.InvokeVoidAsync("eval", $@"
                    var form = document.getElementById('delete-account-logout-form');
                    if (form) {{
                        if ({isCapacitor.ToString().ToLower()}) {{
                            document.getElementById('delete-account-client-input').value = 'mobile';
                        }}
                        form.submit();
                    }}
                ");
            }
        }
    }

    private string EscapeJs(string input)
    {
        return (input ?? "").Replace("\\", "\\\\").Replace("'", "\\'").Replace("\n", "\\n").Replace("\r", "");
    }

    private async Task TestDevice(string deviceId)
    {
        _isTesting = true;
        AddDebugLog($"Starting test push for device {deviceId}...");
        
        try
        {
            var response = await JS.InvokeAsync<dynamic>("eval", $@"
                (async () => {{
                    var hdrs = await window.spokesAuth.getHeaders();
                    var res = await fetch('/spokesapi/push/devices/{deviceId}/test', {{ method: 'POST', headers: hdrs }});
                    var data = await res.json();
                    return {{ ok: res.ok, status: res.status, data: data }};
                }})()
            ");

            var ok = response.GetProperty("ok").GetBoolean();
            if (ok)
            {
                var msg = response.GetProperty("data").TryGetProperty("message", out JsonElement successMsg) ? successMsg.GetString() : "Test push dispatched to push service successfully.";
                AddDebugLog($"Server: {msg}");
                Snackbar.Add(Loc["Test notification sent successfully!"].Value, Severity.Success);
            }
            else
            {
                var data = response.GetProperty("data");
                var msg = data.TryGetProperty("error", out JsonElement errMsg) ? errMsg.GetString() : "Unknown error";
                var code = data.TryGetProperty("code", out JsonElement codeElem) ? codeElem.GetString() : "";
                AddDebugLog($"Server Error {response.GetProperty("status").GetInt32()}: {msg}", true);

                switch (code)
                {
                    case "TRIAL_EXPIRED":
                    case "LICENSE_EXPIRED":
                        Snackbar.Add(Loc["Spokes Pass is required for mobile notifications to work. Only 1 pass per server is required. Talk to your server owner, I'm sure they would love to split the cost :)"].Value, Severity.Warning, config =>
                        {
                            config.VisibleStateDuration = 10000;
                            config.ShowCloseIcon = true;
                        });
                        break;
                    case "LICENSE_INVALID":
                        Snackbar.Add(Loc["This server's Spokes Pass couldn't be verified, so mobile notifications are disabled. Ask your server owner to check the Spokes Pass in the admin settings."].Value, Severity.Warning, config =>
                        {
                            config.VisibleStateDuration = 10000;
                            config.ShowCloseIcon = true;
                        });
                        break;
                    default:
                        Snackbar.Add(string.Format(Loc["Failed to send test notification: {0}"].Value, msg), Severity.Error);
                        break;
                }
            }
        }
        catch (Exception ex)
        {
            AddDebugLog($"Client Error: {ex.Message}", true);
            Snackbar.Add(string.Format(Loc["Error: {0}"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _isTesting = false;
            StateHasChanged();
        }
    }

    public class TestPushResult
    {
        public bool Success { get; set; }
        public bool FallbackUsed { get; set; }
        public string? Error { get; set; }
        public string? Category { get; set; }
        public string? Sound { get; set; }
    }

    [JSInvokable]
    public void OnTestPushResult(TestPushResult result)
    {
        if (result.Success)
        {
            AddDebugLog($"Service Worker: Notification displayed successfully{(result.FallbackUsed ? " (using Safari fallback)" : "")}.");
            var cat = !string.IsNullOrEmpty(result.Category) ? result.Category : NotificationCategories.Chat;
            _ = SoundService.PlayNotificationSoundAsync(cat, isPreview: true);
        }
        else
        {
            AddDebugLog($"Service Worker Error: Failed to display notification. {result.Error}", true);
        }
    }

