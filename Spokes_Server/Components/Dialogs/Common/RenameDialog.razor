<MudDialog>
    <TitleContent>
        <MudText Typo="Typo.h6">@(Title == "Rename" ? Loc["Rename"].Value : Title)</MudText>
    </TitleContent>
    <DialogContent>
        <MudTextField @bind-Value="_name" Label="@(Label == "Name" ? Loc["Name"].Value : Label)" Required="true" Immediate="true" Placeholder="@Loc["Enter a name"]"
            AutoFocus="true" />
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">@Loc["Cancel"]</MudButton>
        <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="Submit"
            Disabled="@(string.IsNullOrWhiteSpace(_name))">@(SubmitLabel == "Save" ? Loc["Save"].Value : SubmitLabel)</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public string CurrentName { get; set; } = string.Empty;
    [Parameter] public string ContentText { get; set; } = "Enter a name:";
    [Parameter] public string Title { get; set; } = "Rename";
    [Parameter] public string Label { get; set; } = "Name";
    [Parameter] public string SubmitLabel { get; set; } = "Save";

    private string _name = string.Empty;

    protected override void OnInitialized() => _name = CurrentName;

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(_name));
}
