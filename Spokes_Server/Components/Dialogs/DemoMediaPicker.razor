@using System.IO
@using MudBlazor
@inject IConfiguration Config
@inject MudBlazor.ISnackbar Snackbar

<MudDialog>
    <DialogContent>
        @if (_mediaFiles == null)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (!_mediaFiles.Any())
        {
            <MudAlert Severity="Severity.Warning">No sample media found. An admin needs to upload sample media in Demo Settings first.</MudAlert>
        }
        else
        {
            <MudGrid>
                @foreach (var file in _mediaFiles)
                {
                    <MudItem xs="4" sm="3" md="2">
                        <MudPaper Elevation="2" Class="pa-2 cursor-pointer" @onclick="() => SelectImage(file)" Style="height: 100%; display: flex; flex-direction: column; justify-content: center; align-items: center;">
                            <img src="@($"/spokesapi/files/demo-media/{Path.GetFileName(file)}")" style="max-width: 100%; max-height: 100px; object-fit: contain;" />
                            <MudText Typo="Typo.caption" Class="mt-2" Style="word-break: break-all;">@Path.GetFileName(file)</MudText>
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>
        }
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = null!;

    private List<string>? _mediaFiles;

    protected override void OnInitialized()
    {
        var dataPath = Config["DataPath"] ?? "Data";
        var demoMediaPath = Path.Combine(dataPath, "DemoMedia");
        if (Directory.Exists(demoMediaPath))
        {
            _mediaFiles = Directory.GetFiles(demoMediaPath).ToList();
        }
        else
        {
            _mediaFiles = new List<string>();
        }
    }

    private void SelectImage(string fullPath)
    {
        // Return just the file name. The ApiFileUpload component will reconstruct the mock UploadResult.
        MudDialog.Close(DialogResult.Ok(Path.GetFileName(fullPath)));
    }

    private void Cancel()
    {
        MudDialog.Cancel();
    }
}
