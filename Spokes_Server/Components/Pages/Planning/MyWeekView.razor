@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.HR
@using Spokes_Server.Core.Services.Projects
@inject Database Db
@inject UserService UserService
@inject WeeklyPlanService WeeklyPlanService
@inject ISnackbar Snackbar

<div class="my-week-view">
    <WeeklyPlanWeekNavigator Title="@BizLoc["My Weekly Plan"]"
                             CurrentWeek="CurrentWeek"
                             CurrentYear="CurrentYear"
                             IsSaving="IsSaving"
                             OnPrevWeek="PrevWeek"
                             OnNextWeek="NextWeek" />

    <!-- Capacity Summary -->
    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
        <MudGrid>
            @{
                var weeklyCapacity = CurrentEmployee?.WeeklyHours > 0 ? CurrentEmployee.WeeklyHours : 40m;
                var percent = (CurrentPlan.TotalHours / weeklyCapacity) * 100;
                var color = percent > 100 ? Color.Error : (percent > 90 ? Color.Warning : Color.Success);
            }
            <MudItem xs="12" sm="3">
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@BizLoc["Total Planned"]</MudText>
                <MudText Typo="Typo.h4">@CurrentPlan.TotalHours.ToString("F1") <span
                        style="font-size: 0.5em; color: gray;">/ @(weeklyCapacity.ToString("0.#"))h</span></MudText>
            </MudItem>
            <MudItem xs="12" sm="9" Class="d-flex align-center">
                <MudProgressLinear Value="@((double)percent)" Color="@color" Size="Size.Large" Rounded="true"
                    Class="my-3">
                    <MudText Typo="Typo.subtitle2" Color="Color.Dark"><b>@CurrentPlan.TotalHours.ToString("F1")h</b>
                    </MudText>
                </MudProgressLinear>
            </MudItem>
        </MudGrid>
    </MudPaper>

    <!-- Plan Editor -->
    <MudPaper Class="pa-4" Elevation="0" Outlined="true">
        <MudText Typo="Typo.h6" Class="mb-4">@BizLoc["Planned Activities"]</MudText>

        <WeeklyPlanEntriesTable Entries="CurrentPlan.Entries"
                                CanEdit="CanEdit"
                                CanAccessEntry="CanCallerAccessEntry"
                                SearchProjects="SearchProjects"
                                ShowProjectLabel="true"
                                NotePlaceholder="@BizLoc["Specific focus..."]"
                                ShowEmptyStateWhenEmpty="true"
                                EmptyStateMessage="@(CanEdit ? BizLoc["No activities planned for this week. Click 'Add Activity' to start."].Value : BizLoc["No activities planned for this week."].Value)"
                                HideActionButtonsWhenReadOnly="true"
                                AddButtonVariant="Variant.Outlined"
                                AddButtonSize="Size.Medium"
                                AddButtonContainerClass="d-flex mt-4 gap-2"
                                OnProjectChanged="@(args => UpdateProjectByName(args.Entry, args.ProjectName))"
                                OnHoursChanged="@(args => UpdateHours(args.Entry, args.Hours))"
                                OnNoteChanged="@(args => UpdateNote(args.Entry, args.Note))"
                                OnRemoveEntry="RemoveEntry"
                                OnAddEntry="AddEntry" />
    </MudPaper>
</div>

@code {
    private int CurrentYear;
    private int CurrentWeek;
    private WeeklyPlan CurrentPlan = new();

    private List<Project> ActiveProjects = [];
    private HashSet<string> _accessibleProjectIds = [];

    private Employee? CurrentEmployee;
    private bool CanEdit;
    private bool IsSaving;

    protected override async Task OnInitializedAsync()
    {
        (CurrentYear, CurrentWeek) = WeeklyPlanService.GetCurrentIsoYearWeek();

        // Get Current User
        CurrentEmployee = await UserService.GetEmployeeAsync(allowSuspended: true);
        CanEdit = CurrentEmployee is { IsActiveUnsuspended: true } && CurrentEmployee.HasPermission(AppPermissions.MyWeek.Edit);

        RefreshAccessibleProjects(CurrentEmployee);
        LoadPlan();
    }

    private void RefreshAccessibleProjects(Employee? actor)
    {
        var allProjects = Db.Projects.GetAll();
        _accessibleProjectIds = actor == null
            ? []
            : allProjects
                .Where(p => ProjectAccessHelper.CanAccessProjectForContribution(actor, p, Db.Teams, allowSuspended: true))
                .Select(p => p.Id)
                .ToHashSet();

        ActiveProjects = actor == null
            ? []
            : allProjects
                .Where(p => p.IsActive
                            && ((p.Status != ProjectStatus.Archived && p.Status != ProjectStatus.Draft) || (p.IsInternal && p.Status != ProjectStatus.Archived))
                            && ProjectAccessHelper.CanAccessProjectForContribution(actor, p, Db.Teams, allowSuspended: false))
                .OrderBy(p => p.DisplayName)
                .ToList();
    }

    private bool CanCallerAccessEntry(PlanEntry entry) =>
        WeeklyPlanService.CanAccessEntry(entry, _accessibleProjectIds);

    private void LoadPlan()
    {
        if (CurrentEmployee == null) return;

        CurrentPlan = WeeklyPlanService.GetOrLoadEnrichedPlan(
            CurrentEmployee.Id,
            CurrentYear,
            CurrentWeek,
            $"{CurrentEmployee.FirstName} {CurrentEmployee.LastName}",
            ActiveProjects);
    }

    private Task<IEnumerable<string>> SearchProjects(string value, CancellationToken token) =>
        Task.FromResult(WeeklyPlanService.SearchProjectNames(value, ActiveProjects));

    private async Task<bool> AuthorizeMyPlanMutationAsync(string? existingProjectId = null, string? targetProjectId = null)
    {
        var liveUser = await UserService.GetEmployeeAsync(allowSuspended: false);
        CurrentEmployee = liveUser ?? await UserService.GetEmployeeAsync(allowSuspended: true);
        CanEdit = liveUser != null && liveUser.HasPermission(AppPermissions.MyWeek.Edit);
        RefreshAccessibleProjects(CurrentEmployee);

        if (!CanEdit || liveUser == null || !string.Equals(CurrentPlan.EmployeeId, liveUser.Id, StringComparison.Ordinal))
        {
            Snackbar.Add(BizLoc["You do not have permission to edit your weekly plan."].Value, Severity.Warning);
            LoadPlan();
            StateHasChanged();
            return false;
        }

        if (!string.IsNullOrWhiteSpace(existingProjectId))
        {
            var existingProj = Db.Projects.GetById(existingProjectId);
            if (!ProjectAccessHelper.CanAccessProjectForContribution(liveUser, existingProj, Db.Teams, allowSuspended: false))
            {
                Snackbar.Add(BizLoc["You do not have permission to modify entries for a restricted project."].Value, Severity.Warning);
                LoadPlan();
                StateHasChanged();
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(targetProjectId))
        {
            var targetProj = Db.Projects.GetById(targetProjectId);
            if (!ProjectAccessHelper.CanAccessProjectForContribution(liveUser, targetProj, Db.Teams, allowSuspended: false))
            {
                Snackbar.Add(BizLoc["You do not have access to assign that project."].Value, Severity.Warning);
                LoadPlan();
                StateHasChanged();
                return false;
            }
        }

        return true;
    }

    private async Task UpdateProjectByName(PlanEntry entry, string projectName)
    {
        if (string.IsNullOrWhiteSpace(projectName))
        {
            if (!await AuthorizeMyPlanMutationAsync(existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
            entry.ProjectName = "";
            entry.ProjectId = "";
            AutoSave();
            return;
        }

        var proj = WeeklyPlanService.ResolveAccessibleProjectByName(projectName, ActiveProjects);
        if (proj == null)
        {
            Snackbar.Add(BizLoc["Please select an accessible project from the list."].Value, Severity.Warning);
            LoadPlan();
            StateHasChanged();
            return;
        }

        if (!await AuthorizeMyPlanMutationAsync(existingProjectId: entry.ProjectId, targetProjectId: proj.Id) || !CanCallerAccessEntry(entry)) return;
        entry.ProjectName = proj.DisplayName;
        entry.ProjectId = proj.Id;
        AutoSave();
    }

    private async Task UpdateHours(PlanEntry entry, decimal hours)
    {
        if (!await AuthorizeMyPlanMutationAsync(existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
        entry.Hours = hours;
        AutoSave();
    }

    private async Task UpdateNote(PlanEntry entry, string note)
    {
        if (!await AuthorizeMyPlanMutationAsync(existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
        entry.Note = note;
        AutoSave();
    }

    private async Task AddEntry()
    {
        if (!await AuthorizeMyPlanMutationAsync()) return;
        CurrentPlan.Entries.Add(new PlanEntry { Hours = 4 }); // Default 4h block
        AutoSave();
    }

    private async Task RemoveEntry(PlanEntry entry)
    {
        if (!await AuthorizeMyPlanMutationAsync(existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
        CurrentPlan.Entries.Remove(entry);
        AutoSave();
    }

    private void AutoSave()
    {
        IsSaving = true;
        StateHasChanged();

        Db.WeeklyPlans.Save(CurrentPlan);

        IsSaving = false;
        StateHasChanged();
    }

    private void PrevWeek()
    {
        (CurrentYear, CurrentWeek) = WeeklyPlanService.ShiftIsoWeek(CurrentYear, CurrentWeek, -1);
        LoadPlan();
    }

    private void NextWeek()
    {
        (CurrentYear, CurrentWeek) = WeeklyPlanService.ShiftIsoWeek(CurrentYear, CurrentWeek, 1);
        LoadPlan();
    }
}
