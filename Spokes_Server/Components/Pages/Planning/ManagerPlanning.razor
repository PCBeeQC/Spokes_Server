@page "/planning/manager"
@attribute [Authorize(Policy = AppPermissions.Projects.View)]
@implements IDisposable
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.HR
@inject Database Db
@inject NavigationManager Nav
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject UserService UserService
@inject WeeklyPlanService WeeklyPlanService
@inject AppLabelService AppLabels

<PageTitle>@string.Format(BizLoc["{0} Planning"].Value, AppLabels.Team)</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4">
    <WeeklyPlanWeekNavigator Title="@string.Format(BizLoc["{0} Planning"].Value, AppLabels.Team)"
                             CurrentWeek="CurrentWeek"
                             CurrentYear="CurrentYear"
                             IsSaving="IsSaving"
                             OnPrevWeek="PrevWeek"
                             OnNextWeek="NextWeek" />

    @if (MyTeams.Count == 0 && !Loading)
    {
        <MudAlert Severity="Severity.Info">@string.Format(BizLoc["You are not assigned as a Leader of any {0}, and have no direct reports."].Value, AppLabels.Team)</MudAlert>
    }
    else
    {
        <MudTabs ActivePanelIndex="activeTabIndex" ActivePanelIndexChanged="UpdateActiveTab" Elevation="0" Outlined="true" Border="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
            @foreach (var team in MyTeams)
            {
                var demand = GetTeamDemand(team.Id);
                var metrics = GetTeamMetrics(team.Id, demand);

                <MudTabPanel Text="@team.Name">

                    <!-- TEAM DASHBOARD -->
                    <MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true" Style="background-color: var(--mud-palette-surface);">
                        <MudGrid>
                             <MudItem xs="12" md="3">
                                <MudText Typo="Typo.subtitle2" Color="Color.Default">@BizLoc["Capacity (Weekly)"]</MudText>
                                <MudText Typo="Typo.h5"><b>@metrics.Capacity.ToString("N0") h</b></MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.subtitle2" Color="Color.Primary">@BizLoc["Planned (This Week)"]</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Primary"><b>@metrics.Planned.ToString("N1") h</b></MudText>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">@BizLoc["Utilization"]</MudText>
                                <div class="d-flex align-center gap-2">
                                    <MudProgressLinear Value="@((double)metrics.Utilization)" Color="@metrics.UtilizationColor" Rounded="true" Size="Size.Large" Class="my-2" />
                                    <MudText Typo="Typo.body2">@metrics.Utilization.ToString("F0")%</MudText>
                                </div>
                            </MudItem>
                            <MudItem xs="12" md="3">
                                <MudText Typo="Typo.subtitle2" Color="Color.Warning">@BizLoc["Backlog (Unassigned)"]</MudText>
                                <MudText Typo="Typo.h5" Color="Color.Warning"><b>@metrics.Backlog.ToString("N1") h</b></MudText>
                            </MudItem>
                        </MudGrid>
                    </MudPaper>

                    <MudGrid>
                        <!-- DEMAND (Left) -->
                        <MudItem xs="12" md="4">
                            <MudPaper Class="pa-4" Elevation="0" Outlined="true" Style="height: 100%; background-color: var(--mud-palette-background-grey);">
                                <MudText Typo="Typo.h6" Class="mb-4">@BizLoc["Work Queue / Demand"]</MudText>

                                @if (!demand.Any())
                                {
                                    <MudText Typo="Typo.caption">@string.Format(BizLoc["No active allocations for this {0}."].Value, AppLabels.Team.ToLowerInvariant())</MudText>
                                }
                                else
                                {
                                    <div class="d-flex flex-column gap-2">
                                        @foreach (var item in demand)
                                        {
                                            <MudPaper Class="pa-3" Elevation="0" Outlined="true">
                                                <div class="d-flex justify-space-between">
                                                    <MudText Typo="Typo.subtitle2"><b>@item.ProjectName</b></MudText>
                                                    @if(item.Deadline.HasValue)
                                                    {
                                                        <MudChip T="string" Size="Size.Small" Color="@(item.Deadline.Value < DateOnly.FromDateTime(DateTime.Today.AddDays(7)) ? Color.Error : Color.Default)">
                                                            @string.Format(BizLoc["Due {0}"].Value, item.Deadline.Value.ToString("MM/dd"))
                                                        </MudChip>
                                                    }
                                                </div>
                                                <MudText Typo="Typo.body2">@item.TaskName @(string.IsNullOrEmpty(item.Description) ? "" : $"- {item.Description}")</MudText>
                                                <div class="d-flex justify-space-between align-center mt-2">
                                                    <div class="d-flex flex-column">
                                                        <MudText Typo="Typo.caption">@BizLoc["Quoted:"] <b>@item.QuotedHours.ToString("N1") h</b></MudText>
                                                        <MudText Typo="Typo.caption" Color="@(item.AssignedHours >= item.QuotedHours ? Color.Success : Color.Warning)">
                                                            @BizLoc["Assigned:"] <b>@item.AssignedHours.ToString("N1") h</b>
                                                        </MudText>
                                                    </div>
                                                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary"
                                                               Disabled="@(!_canEditPlan)"
                                                               OnClick="@(() => OpenAllocateDialog(team, item))">@BizLoc["Allocate"]</MudButton>
                                                </div>
                                            </MudPaper>
                                        }
                                    </div>
                                }
                            </MudPaper>
                        </MudItem>

                        <!-- SUPPLY (Right) -->
                        <MudItem xs="12" md="8">
                            <MudText Typo="Typo.h6" Class="mb-4">@string.Format(BizLoc["{0} Schedule ({1})"].Value, AppLabels.Team, team.Name)</MudText>
                            <MudExpansionPanels MultiExpansion="true">
                                @foreach (var report in GetTeamMemberPlans(team.Id))
                                {
                                    <MudExpansionPanel Text="@($"{report.Employee.FirstName} {report.Employee.LastName}")">
                                        <TitleContent>
                                            <div class="d-flex align-center justify-space-between w-100 pr-4">
                                                <MudText><b>@report.Employee.FirstName @report.Employee.LastName</b></MudText>
                                                @{
                                                    var h = report.Plan.TotalHours;
                                                    var cap = report.Employee.WeeklyHours;
                                                    var c = h > cap ? Color.Error : (h > (cap * 0.85m) ? Color.Success : Color.Warning);
                                                }
                                                <MudText Color="@c">@h.ToString("F1")h / @cap.ToString("F0")h</MudText>
                                            </div>
                                        </TitleContent>
                                        <ChildContent>
                                            <WeeklyPlanEntriesTable Entries="report.Plan.Entries"
                                                                    CanEdit="_canEditPlan"
                                                                    CanAccessEntry="CanCallerAccessEntry"
                                                                    SearchProjects="SearchProjects"
                                                                    NotePlaceholder="..."
                                                                    AddButtonVariant="Variant.Text"
                                                                    AddButtonSize="Size.Small"
                                                                    AddButtonContainerClass="d-flex justify-end gap-2 mt-2"
                                                                    OnProjectChanged="@(args => UpdateProjectByName(report.Plan, args.Entry, args.ProjectName))"
                                                                    OnHoursChanged="@(args => UpdateHours(report.Plan, args.Entry, args.Hours))"
                                                                    OnNoteChanged="@(args => UpdateNote(report.Plan, args.Entry, args.Note))"
                                                                    OnRemoveEntry="@(entry => RemoveEntry(report.Plan, entry))"
                                                                    OnAddEntry="@(() => AddEntry(report.Plan))" />
                                        </ChildContent>
                                    </MudExpansionPanel>
                                }
                            </MudExpansionPanels>
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>
            }
        </MudTabs>
    }

</MudContainer>

@code {
    // --- STATE ---
    private int CurrentYear;
    private int CurrentWeek;
    private bool Loading = true;
    private bool IsSaving;

    // --- DATA ---
    private Employee? CurrentUser;
    private bool _canEditPlan => CurrentUser?.IsActiveUnsuspended == true && CurrentUser.HasPermission(AppPermissions.Projects.View);
    private List<Team> MyTeams = [];
    private List<Project> ActiveProjects = [];
    private HashSet<string> _viewableProjectIds = [];

    // --- VIEW MODELS ---
    private List<EmployeePlanViewModel> AllEmployeePlans = []; // Cache of all loaded plans

    [SupplyParameterFromQuery] public int? Tab { get; set; }
    private int activeTabIndex;

    protected override void OnParametersSet()
    {
        if (Tab.HasValue)
        {
            activeTabIndex = Tab.Value;
        }
    }

    private bool _isDisposed;

    public void Dispose() => _isDisposed = true;

    private void UpdateActiveTab(int index)
    {
        if (_isDisposed) return;

        activeTabIndex = index;

        if (!Nav.Uri.Contains("/planning/manager", StringComparison.OrdinalIgnoreCase))
            return;

        try
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", index), replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
        }
    }

    protected override async Task OnInitializedAsync()
    {
        // Redirect if feature is disabled
        var profile = Db.CompanyProfile.GetAll().FirstOrDefault();
        if (!(profile?.TimesheetConfig?.EnableWeeklyPlan ?? true))
        {
            Snackbar.Add(BizLoc["Weekly Plan is disabled for your organization"].Value, Severity.Info);
            Nav.NavigateTo("/my-timesheet");
            return;
        }

        (CurrentYear, CurrentWeek) = WeeklyPlanService.GetCurrentIsoYearWeek();

        CurrentUser = await UserService.GetEmployeeAsync(allowSuspended: true);
        RefreshAccessibleProjects(CurrentUser);

        LoadData();
    }

    private void LoadData()
    {
        if (CurrentUser == null) return;
        Loading = true;
        AllEmployeePlans.Clear();

        // 1. Find Teams I lead
        MyTeams = Db.Teams.GetAll().Where(t => t.LeaderId == CurrentUser.Id).ToList();

        // 2. Load Plans for ALL team members
        var relevantEmployees = new HashSet<string>();

        foreach(var team in MyTeams)
        {
            var members = Db.Employees.GetAll().Where(e => e.TeamId == team.Id && e.IsActive);
            foreach(var m in members) relevantEmployees.Add(m.Id);

            // Should always be true since MyTeams filtered by LeaderId == CurrentUser.Id,
            // but good for completeness if logic changes.
            if (!string.IsNullOrEmpty(team.LeaderId))
            {
                relevantEmployees.Add(team.LeaderId);
            }
        }

        foreach (var empId in relevantEmployees)
        {
             var emp = Db.Employees.GetAll().FirstOrDefault(e => e.Id == empId);
             if (emp == null) continue;

             var plan = WeeklyPlanService.GetOrLoadEnrichedPlan(emp.Id, CurrentYear, CurrentWeek, emp.FullName, ActiveProjects);

             var vm = new EmployeePlanViewModel { Employee = emp, Plan = plan };
             AllEmployeePlans.Add(vm);
        }

        Loading = false;
    }

    // --- HELPERS ---
    private List<DemandViewModel> GetTeamDemand(string teamId)
    {
        List<DemandViewModel> demand = [];

        // 1. Get accepted quotes for active projects
        var activeProjectIds = ActiveProjects.Select(p => p.Id).ToHashSet();
        var quotes = Db.Quotes.GetAll()
            .Where(q => q.Status == QuoteStatus.Accepted && activeProjectIds.Contains(q.ProjectId))
            .ToList();

        // 2. Iterate labor items
        foreach (var quote in quotes)
        {
            var proj = ActiveProjects.FirstOrDefault(p => p.Id == quote.ProjectId);
            if (proj == null) continue;

            foreach (var item in quote.LaborItems)
            {
                // 3. Check if Work Type is assigned to this team
                var workType = Db.WorkTypes.GetAll().FirstOrDefault(w => w.Id == item.WorkTypeId);
                if (workType != null && workType.AssignedTeamIds.Contains(teamId))
                {
                    // Calculate already assigned hours for this project + task across all weekly plans
                    var assigned = Db.WeeklyPlans.GetAll()
                        .SelectMany(p => p.Entries)
                        .Where(e => e.ProjectId == proj.Id && e.WorkTypeId == item.WorkTypeId)
                        .Sum(e => e.Hours);

                    demand.Add(new DemandViewModel
                    {
                        ProjectName = proj.DisplayName,
                        ProjectId = proj.Id,
                        TaskName = workType.Name,
                        WorkTypeId = item.WorkTypeId,
                        QuotedHours = item.Hours,
                        AssignedHours = assigned,
                        Description = string.Format(BizLoc["From Quote #{0}"].Value, quote.QuoteNumber),
                        Deadline = quote.Deadline
                    });
                }
            }
        }
        return demand;
    }

    private TeamDashboardMetrics GetTeamMetrics(string teamId, List<DemandViewModel> demand)
    {
        var plans = GetTeamMemberPlans(teamId);

        decimal capacity = plans.Sum(p => p.Employee.WeeklyHours);
        decimal planned = plans.Sum(p => p.Plan.TotalHours);
        decimal backlog = demand.Sum(d => Math.Max(0, d.QuotedHours - d.AssignedHours)); // Only count positive backlog

        decimal utilization = capacity > 0 ? (planned / capacity) * 100 : 0;

        return new TeamDashboardMetrics
        {
            Capacity = capacity,
            Planned = planned,
            Backlog = backlog,
            Utilization = utilization,
            UtilizationColor = utilization > 100 ? Color.Error : (utilization > 80 ? Color.Success : Color.Info)
        };
    }

    private List<EmployeePlanViewModel> GetTeamMemberPlans(string teamId)
    {
        var team = MyTeams.FirstOrDefault(t => t.Id == teamId);
        if (team == null) return [];

        return AllEmployeePlans.Where(p =>
            p.Employee.TeamId == teamId ||
            (p.Employee.Id == team.LeaderId)
        ).ToList();
    }

    // --- AUTO SAVE ---
    private void RefreshAccessibleProjects(Employee? actor)
    {
        var allProjects = Db.Projects.GetAll();
        _viewableProjectIds = actor == null
            ? []
            : allProjects
                .Where(p => UserService.CanViewProject(actor, p, allowAccountingFinancialRead: false))
                .Select(p => p.Id)
                .ToHashSet();

        ActiveProjects = allProjects
            .Where(p => ((p.Status != ProjectStatus.Archived && p.Status != ProjectStatus.Draft) || p.IsInternal)
                && _viewableProjectIds.Contains(p.Id))
            .OrderBy(p => p.DisplayName)
            .ToList();
    }

    private bool CanCallerAccessEntry(PlanEntry entry) =>
        WeeklyPlanService.CanAccessEntry(entry, _viewableProjectIds);

    private async Task<bool> AuthorizePlanMutationAsync(WeeklyPlan plan, string? existingProjectId = null, string? targetProjectId = null)
    {
        var liveUser = await UserService.GetEmployeeAsync();
        CurrentUser = liveUser ?? await UserService.GetEmployeeAsync(allowSuspended: true);
        RefreshAccessibleProjects(CurrentUser);
        if (liveUser == null || !liveUser.IsActiveUnsuspended || !liveUser.HasPermission(AppPermissions.Projects.View))
        {
            Snackbar.Add(BizLoc["You do not have permission to edit weekly plans."].Value, Severity.Warning);
            LoadData();
            StateHasChanged();
            return false;
        }

        var targetEmployee = Db.Employees.GetById(plan.EmployeeId);
        bool leadsTargetTeam = Db.Teams.GetAll().Any(t =>
            t.LeaderId == liveUser.Id &&
            (t.LeaderId == plan.EmployeeId || targetEmployee?.TeamId == t.Id));
        if (!leadsTargetTeam)
        {
            Snackbar.Add(string.Format(BizLoc["You can only modify plans for {0} you lead."].Value, AppLabels.Teams.ToLowerInvariant()), Severity.Warning);
            LoadData();
            StateHasChanged();
            return false;
        }

        if (!string.IsNullOrWhiteSpace(existingProjectId))
        {
            var existingProj = Db.Projects.GetById(existingProjectId);
            if (existingProj == null || !UserService.CanViewProject(liveUser, existingProj, allowAccountingFinancialRead: false))
            {
                Snackbar.Add(BizLoc["You do not have permission to modify entries for a restricted project."].Value, Severity.Warning);
                LoadData();
                StateHasChanged();
                return false;
            }
        }

        if (!string.IsNullOrWhiteSpace(targetProjectId))
        {
            var proj = Db.Projects.GetById(targetProjectId);
            if (proj == null || !UserService.CanViewProject(liveUser, proj, allowAccountingFinancialRead: false))
            {
                Snackbar.Add(BizLoc["You do not have access to assign that project."].Value, Severity.Warning);
                LoadData();
                StateHasChanged();
                return false;
            }
        }

        return true;
    }

    private async Task UpdateProjectByName(WeeklyPlan plan, PlanEntry entry, string projectName)
    {
        if (string.IsNullOrWhiteSpace(projectName))
        {
            if (!await AuthorizePlanMutationAsync(plan, existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
            entry.ProjectName = "";
            entry.ProjectId = "";
            AutoSave(plan);
            return;
        }

        var proj = WeeklyPlanService.ResolveAccessibleProjectByName(projectName, ActiveProjects);
        if (proj == null)
        {
            Snackbar.Add(BizLoc["Please select an accessible project from the list."].Value, Severity.Warning);
            LoadData();
            StateHasChanged();
            return;
        }

        if (!await AuthorizePlanMutationAsync(plan, existingProjectId: entry.ProjectId, targetProjectId: proj.Id) || !CanCallerAccessEntry(entry)) return;
        entry.ProjectName = proj.DisplayName;
        entry.ProjectId = proj.Id;
        AutoSave(plan);
    }

    private async Task UpdateHours(WeeklyPlan plan, PlanEntry entry, decimal val)
    {
        if (!await AuthorizePlanMutationAsync(plan, existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
        entry.Hours = val;
        AutoSave(plan);
    }

    private async Task UpdateNote(WeeklyPlan plan, PlanEntry entry, string val)
    {
        if (!await AuthorizePlanMutationAsync(plan, existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
        entry.Note = val;
        AutoSave(plan);
    }

    private async Task AddEntry(WeeklyPlan plan)
    {
        if (!await AuthorizePlanMutationAsync(plan)) return;
        plan.Entries.Add(new PlanEntry { Hours = 4 });
        AutoSave(plan);
    }

    private async Task RemoveEntry(WeeklyPlan plan, PlanEntry entry)
    {
        if (!await AuthorizePlanMutationAsync(plan, existingProjectId: entry.ProjectId) || !CanCallerAccessEntry(entry)) return;
        plan.Entries.Remove(entry);
        AutoSave(plan);
    }

    private void AutoSave(WeeklyPlan plan)
    {
        IsSaving = true; StateHasChanged();
        Db.WeeklyPlans.Save(plan);
        IsSaving = false; StateHasChanged();
    }

    // --- NAV ---
    private void PrevWeek()
    {
        (CurrentYear, CurrentWeek) = WeeklyPlanService.ShiftIsoWeek(CurrentYear, CurrentWeek, -1);
        LoadData();
    }

    private void NextWeek()
    {
        (CurrentYear, CurrentWeek) = WeeklyPlanService.ShiftIsoWeek(CurrentYear, CurrentWeek, 1);
        LoadData();
    }

    // --- SEARCH ---
    private Task<IEnumerable<string>> SearchProjects(string value, CancellationToken token) =>
        Task.FromResult(WeeklyPlanService.SearchProjectNames(value, ActiveProjects));

    // --- ALLOCATION DIALOG ---
    private async Task OpenAllocateDialog(Team team, DemandViewModel item)
    {
         var liveBefore = await UserService.GetEmployeeAsync();
         CurrentUser = liveBefore ?? await UserService.GetEmployeeAsync(allowSuspended: true);
         if (liveBefore == null || !liveBefore.IsActiveUnsuspended || !liveBefore.HasPermission(AppPermissions.Projects.View) || team.LeaderId != liveBefore.Id)
         {
             Snackbar.Add(string.Format(BizLoc["You do not have permission to allocate work for this {0}."].Value, AppLabels.Team.ToLowerInvariant()), Severity.Warning);
             StateHasChanged();
             return;
         }

         var members = GetTeamMemberPlans(team.Id).Select(vm => vm.Employee).ToList();

         var parameters = new DialogParameters
         {
             ["Members"] = members,
             ["ProjectName"] = item.ProjectName,
             ["TaskName"] = item.TaskName
         };

         var dialog = await DialogService.ShowAsync<AllocateDialog>(BizLoc["Allocate Work"].Value, parameters);
         var result = await dialog.Result;

         if (result is { Canceled: false, Data: AllocationResult res })
         {
             // Add entry to the chosen employee
             var vm = AllEmployeePlans.FirstOrDefault(p => p.Employee.Id == res.EmployeeId);
             if (vm != null)
             {
                 if (!await AuthorizePlanMutationAsync(vm.Plan, targetProjectId: item.ProjectId)) return;
                 vm.Plan.Entries.Add(new PlanEntry
                 {
                     ProjectId = item.ProjectId,
                     ProjectName = item.ProjectName,
                     WorkTypeId = item.WorkTypeId,
                     Note = $"{item.TaskName}: {res.Note}",
                     Hours = res.Hours
                 });
                 AutoSave(vm.Plan);
                 Snackbar.Add(string.Format(BizLoc["Allocated {0}h to {1}"].Value, res.Hours, vm.Employee.FirstName), Severity.Success);
             }
         }
    }

    // --- MODELS ---
    public class EmployeePlanViewModel { public Employee Employee { get; set; } = default!; public WeeklyPlan Plan { get; set; } = default!; }

    public class DemandViewModel
    {
        public string ProjectName { get; set; } = "";
        public string ProjectId { get; set; } = "";
        public string TaskName { get; set; } = "";
        public string WorkTypeId { get; set; } = "";
        public decimal QuotedHours { get; set; }
        public decimal AssignedHours { get; set; }
        public string Description { get; set; } = "";
        public DateOnly? Deadline { get; set; }
    }

    public class TeamDashboardMetrics
    {
        public decimal Capacity { get; set; }
        public decimal Planned { get; set; }
        public decimal Backlog { get; set; }
        public decimal Utilization { get; set; }
        public Color UtilizationColor { get; set; }
    }
}
