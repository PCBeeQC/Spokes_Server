@code {
    private DateOnly CurrentMonth = DateOnly.FromDateTime(DateTime.Today);
    private List<CalendarDay> CalendarDays = [];

    private List<CalendarCategory> Categories = [];
    private List<CalendarEffectiveCategory> DynamicCategories = [];
    private HashSet<string> SelectedCategoryKeys = [];
    private HashSet<string> CurrentUserTeamIds = [];

    // View Model for rendering
    private List<CalendarEventViewModel> AllEvents = [];
    private IEnumerable<CalendarEventViewModel> FilteredEvents => AllEvents; // Can add filters later

    [SupplyParameterFromQuery(Name = "date")]
    public string? QueryDate { get; set; }

    [SupplyParameterFromQuery(Name = "eventId")]
    public string? QueryEventId { get; set; }

    private bool _hasHandledQueryParameters;

    private bool Loading;
    private string CurrentUserId = "";
    private string CurrentUserTeamId = "";

    // Mobile View Variables
    private DateOnly SelectedDate = DateOnly.FromDateTime(DateTime.Today);

    private void OnMobileDayClick(CalendarDay day) => SelectedDate = day.Date;

    private string GetMobileCellClass(CalendarDay day)
    {
        var cls = "m-cell";
        if (!day.IsCurrentMonth) cls += " m-other-month";
        if (day.Date == DateOnly.FromDateTime(DateTime.Today)) cls += " m-today";
        if (day.Date == SelectedDate) cls += " m-selected";
        if (day.Date.DayOfWeek == DayOfWeek.Sunday) cls += " m-sunday";
        return cls;
    }

    protected override async Task OnInitializedAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp != null)
        {
            CurrentUserId = emp.Id;
            CurrentUserTeamId = emp.TeamId;
            CurrentUserTeamIds.Clear();
            if (!string.IsNullOrEmpty(emp.TeamId))
                CurrentUserTeamIds.Add(emp.TeamId);
            foreach (var t in Db.Teams.GetAll().Where(t => t.LeaderId == emp.Id))
                CurrentUserTeamIds.Add(t.Id);

            var serverProfile = Db.CompanyProfile.Get();
            Categories = emp.EnsureCalendarCategories(serverProfile);
        }

        ChatState.CalendarEventUpdated += HandleCalendarEventChanged;
        ChatState.CalendarEventDeleted += HandleCalendarEventDeleted;

        // Go to first of month
        CurrentMonth = new DateOnly(CurrentMonth.Year, CurrentMonth.Month, 1);
        LoadData();
    }

    protected override void OnParametersSet()
    {
        if (!_hasHandledQueryParameters && (!string.IsNullOrEmpty(QueryDate) || !string.IsNullOrEmpty(QueryEventId)))
        {
            _hasHandledQueryParameters = true;

            CalendarEvent? targetEvt = null;
            if (!string.IsNullOrEmpty(QueryEventId))
            {
                targetEvt = CalendarService.GetEventById(QueryEventId);
            }

            if (targetEvt != null)
            {
                var dt = DateOnly.FromDateTime(targetEvt.Start);
                SelectedDate = dt;
                CurrentMonth = new DateOnly(dt.Year, dt.Month, 1);
                LoadData();
                _ = OpenDialog(targetEvt, false);
            }
            else if (!string.IsNullOrEmpty(QueryDate) && DateOnly.TryParse(QueryDate, out var parsedDate))
            {
                SelectedDate = parsedDate;
                CurrentMonth = new DateOnly(parsedDate.Year, parsedDate.Month, 1);
                LoadData();
            }
        }
    }

    public void Dispose()
    {
        ChatState.CalendarEventUpdated -= HandleCalendarEventChanged;
        ChatState.CalendarEventDeleted -= HandleCalendarEventDeleted;
    }

    private void HandleCalendarEventChanged(CalendarEvent evt)
    {
        InvokeAsync(() =>
        {
            LoadData();
            StateHasChanged();
        });
    }

    private void HandleCalendarEventDeleted(string eventId)
    {
        InvokeAsync(() =>
        {
            LoadData();
            StateHasChanged();
        });
    }

    private void ToggleCategoryFilter(string filterKey)
    {
        if (SelectedCategoryKeys.Contains(filterKey))
            SelectedCategoryKeys.Remove(filterKey);
        else
            SelectedCategoryKeys.Add(filterKey);
        StateHasChanged();
    }

    private async Task OpenCategoryManager()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<CalendarCategoryManagerDialog>("", options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            var emp = await UserService.GetEmployeeAsync();
            if (emp != null)
            {
                Categories = CalendarService.GetEffectiveCategories(emp.Id);
            }
            LoadData();
        }
    }

    private void PrevMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(-1);
        LoadData();
    }

    private void NextMonth()
    {
        CurrentMonth = CurrentMonth.AddMonths(1);
        LoadData();
    }

    private void GoToToday()
    {
        var today = DateOnly.FromDateTime(DateTime.Today);
        CurrentMonth = new DateOnly(today.Year, today.Month, 1);
        SelectedDate = today;
        LoadData();
    }

    private void LoadData()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return;

        Categories = CalendarService.GetEffectiveCategories(CurrentUserId);

        Loading = true;
        BuildGrid();

        AllEvents.Clear();
        var startEx = CalendarDays.First().Date;
        var endEx = CalendarDays.Last().Date;

        // Fetch all employees once for mapping
        var employees = Db.Employees.GetAll().ToDictionary(e => e.Id, e => e.FullName);
        var teamsDict = Db.Teams.GetAll().ToDictionary(t => t.Id, t => t.Name);
        var userCategoriesDict = Categories.ToDictionary(c => c.Id, c => c);
        var viewingContext = new CalendarViewingContext(
            CurrentUserId,
            CurrentUserTeamIds,
            employees,
            teamsDict,
            userCategoriesDict);

        // Load Events from DB
        var dbEvents = CalendarService.GetEventsForUser(CurrentUserId, CurrentUserTeamIds);

        foreach (var evt in dbEvents)
        {
            var start = DateOnly.FromDateTime(evt.Start);
            var end = DateOnly.FromDateTime(evt.End);

            // If End < Start (bug safeguard), fix it locally
            if (end < start) end = start;

            // Check intersection with view
            if (start <= endEx && end >= startEx)
            {
                var current = start < startEx ? startEx : start;
                var last = end > endEx ? endEx : end;

                var ownerName = evt.EmployeeId == CurrentUserId ? "" : employees.GetValueOrDefault(evt.EmployeeId, Loc["Unknown"].Value);
                var effCat = CalendarEffectiveCategory.Resolve(evt, viewingContext);

                while (current <= last)
                {
                    var isStart = current == start;
                    var isCont = !isStart;

                    var vm = new CalendarEventViewModel
                        {
                            Date = current,
                            Title = evt.Title,
                            OwnerName = ownerName,
                            Color = effCat.Color,
                            EffectiveCategory = effCat,
                            SourceEvent = evt,
                            IsAllDay = evt.IsAllDay,
                            TimeStr = evt.Start.ToString("HH:mm"),
                            TypeClass = $"{(current < last ? "evt-span-start" : "")}", // Add custom color logic here
                            IsContinuation = isCont
                        };

                    AllEvents.Add(vm);
                    current = current.AddDays(1);
                }
            }
        }

        // Sort: Earliest time first
        AllEvents = AllEvents.OrderBy(e => e.IsAllDay ? 0 : 1).ThenBy(e => e.TimeStr).ToList();

        // Dynamically compute active month categories for filtering
        DynamicCategories = AllEvents
            .Where(e => !e.IsContinuation)
            .GroupBy(e => e.EffectiveCategory.FilterKey)
            .Select(g =>
            {
                var first = g.First().EffectiveCategory;
                return new CalendarEffectiveCategory
                {
                    FilterKey = first.FilterKey,
                    DisplayName = first.DisplayName,
                    CategoryName = first.CategoryName,
                    Color = first.Color,
                    IsShared = first.IsShared,
                    Attribution = first.Attribution,
                    EventCount = g.Count()
                };
            })
            .OrderBy(c => c.IsShared ? 1 : 0)
            .ThenBy(c => c.DisplayName)
            .ToList();

        var validKeys = DynamicCategories.Select(c => c.FilterKey).ToHashSet();
        SelectedCategoryKeys.RemoveWhere(k => !validKeys.Contains(k));

        Loading = false;
    }

    private void BuildGrid()
    {
        CalendarDays.Clear();
        var firstDayOfMonth = CurrentMonth;
        var lastDayOfMonth = firstDayOfMonth.AddMonths(1).AddDays(-1);

        int diff = (7 + (firstDayOfMonth.DayOfWeek - DayOfWeek.Monday)) % 7;
        var runner = firstDayOfMonth.AddDays(-1 * diff);

        while (runner <= lastDayOfMonth || runner.DayOfWeek != DayOfWeek.Monday)
        {
            CalendarDays.Add(new CalendarDay { Date = runner, IsCurrentMonth = runner.Month == CurrentMonth.Month });
            runner = runner.AddDays(1);
        }
    }

    private string GetCellClass(CalendarDay day)
    {
        var cls = "calendar-cell";
        if (!day.IsCurrentMonth) cls += " other-month";
        if (day.Date == DateOnly.FromDateTime(DateTime.Today)) cls += " today";
        if (day.Date == SelectedDate) cls += " selected";
        return cls;
    }

    private List<CalendarEventViewModel> SelectedDayEvents => FilteredEvents
        .Where(e => e.Date == SelectedDate && (SelectedCategoryKeys.Count == 0 || SelectedCategoryKeys.Contains(e.EffectiveCategory.FilterKey)))
        .OrderBy(e => e.IsAllDay ? 0 : 1)
        .ThenBy(e => e.SourceEvent.Start)
        .ToList();

    private List<CalendarEventViewModel> SelectedDayAllDayEvents =>
        SelectedDayEvents.Where(e => e.IsAllDay).ToList();

    private List<CalendarEventViewModel> SelectedDayTimedEvents =>
        SelectedDayEvents.Where(e => !e.IsAllDay).OrderBy(e => e.SourceEvent.Start).ToList();

    private async Task AddEvent()
    {
        var newEvent = new CalendarEvent
            {
                EmployeeId = CurrentUserId,
                Start = SelectedDate.ToDateTime(TimeOnly.Parse("09:00")),
                End = SelectedDate.ToDateTime(TimeOnly.Parse("10:00"))
            };
        await OpenDialog(newEvent, true);
    }

    private void OnDayClick(CalendarDay day)
    {
        SelectedDate = day.Date;
    }

    private async Task OnDayDoubleClick(CalendarDay day)
    {
        SelectedDate = day.Date;
        var newEvent = new CalendarEvent
            {
                EmployeeId = CurrentUserId,
                Start = day.Date.ToDateTime(TimeOnly.Parse("09:00")),
                End = day.Date.ToDateTime(TimeOnly.Parse("10:00"))
            };
        await OpenDialog(newEvent, true);
    }

    private Task OnEventClick(CalendarEventViewModel vm, MouseEventArgs e) => OpenDialog(vm.SourceEvent, false);

    private async Task OpenDialog(CalendarEvent evt, bool isNew)
    {
        var parameters = new DialogParameters { ["Event"] = evt, ["IsNew"] = isNew };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };

        var dialog = await DialogService.ShowAsync<CalendarEventDialog>(isNew ? Loc["New Event"].Value : Loc["Event Details"].Value, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            if (result.Data is CalendarEvent resultEvent) // Saved
            {
                CalendarService.SaveEvent(resultEvent);
                Snackbar.Add(Loc["Event saved"].Value, Severity.Success);
            }
            else if (!isNew) // Deleted
            {
                CalendarService.DeleteEvent(evt.Id);
                Snackbar.Add(Loc["Event deleted"].Value, Severity.Success);
            }
            LoadData();
        }
    }

    private static double GetEventDurationMinutes(CalendarEvent evt)
    {
        var duration = (evt.End - evt.Start).TotalMinutes;
        return duration <= 0 ? 30 : duration;
    }

    internal static string GetDurationTierMinHeight(CalendarEvent evt)
    {
        var mins = GetEventDurationMinutes(evt);
        if (mins < 45) return "min-height: 44px;";
        if (mins <= 75) return "min-height: 56px;";
        if (mins <= 120) return "min-height: 84px;";
        if (mins <= 180) return "min-height: 112px;";
        return "min-height: 140px;";
    }

    private string GetDurationBadgeText(CalendarEvent evt)
    {
        var duration = evt.End - evt.Start;
        var totalMinutes = (int)Math.Max(1, duration.TotalMinutes);
        if (totalMinutes < 60)
            return string.Format(Loc["{0}m"].Value, totalMinutes);

        var hours = totalMinutes / 60;
        var remMinutes = totalMinutes % 60;
        return remMinutes > 0 ? string.Format(Loc["{0}h {1}m"].Value, hours, remMinutes) : string.Format(Loc["{0}h"].Value, hours);
    }

    internal string GetFreeTimeGapText(TimeSpan gap)
    {
        if (gap.TotalHours >= 1)
        {
            var hours = (int)gap.TotalHours;
            var minutes = gap.Minutes;
            return minutes > 0
                ? string.Format(Loc["{0}h {1}m free"].Value, hours, minutes)
                : string.Format(Loc["{0}h free"].Value, hours);
        }
        return string.Format(Loc["{0}m free"].Value, (int)gap.TotalMinutes);
    }

    private static bool IsEventHappeningNow(CalendarEvent evt)
    {
        var now = DateTime.Now;
        return now >= evt.Start && now <= evt.End;
    }

    private static bool IsEventPast(CalendarEvent evt)
    {
        var now = DateTime.Now;
        return evt.End < now;
    }

    public class CalendarDay
    {
        public DateOnly Date { get; set; }
        public bool IsCurrentMonth { get; set; }
    }

    public class CalendarEventViewModel
    {
        public DateOnly Date { get; set; }
        public string Title { get; set; } = "";
        public string OwnerName { get; set; } = "";
        public Color Color { get; set; }
        public CalendarEffectiveCategory EffectiveCategory { get; set; } = default!;
        public CalendarEvent SourceEvent { get; set; } = default!;
        public bool IsAllDay { get; set; }
        public string TimeStr { get; set; } = "";
        public string TypeClass { get; set; } = "";
        public bool IsContinuation { get; set; }
    }
}

