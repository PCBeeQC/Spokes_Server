@page "/my-timesheet"
@page "/timesheet/{TargetEmployeeId}"
@attribute [Authorize(Policy = AppPermissions.Timesheets.AccessTimesheet)]
@using Microsoft.AspNetCore.Authorization
<PageTitle>My Timesheet</PageTitle>
@using System.Globalization
@using Spokes_Server.Components.Pages.Planning
@using Spokes_Server.Core.Constants
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Core.Services.HR
@using Spokes_Server.Core.Services.Projects
@inject UserService UserService
@inject OvertimeService OvertimeService
@inject HRService HRService
@inject Database Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject TimesheetTimerService TimerService
@inject NavigationManager Nav
@inject AppLabelService AppLabels
@implements IDisposable

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-6">
<MudHidden Breakpoint="Breakpoint.SmAndDown">
    <MudGrid Class="align-center mb-4">
        <MudItem xs="12" md="5">
            <div class="d-flex align-center flex-wrap gap-2">
                @if (IsViewingOtherEmployee)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack"
                                   Size="Size.Small"
                                   Variant="Variant.Outlined"
                                   title="@($"Back to {AppLabels.Team} Timesheets")"
                                   OnClick="@(() => Nav.NavigateTo($"/planning/timesheet-approvals?year={CurrentYear}&week={CurrentWeekNumber}"))" />
                }
                <MudText Typo="Typo.h4">
                    @(IsViewingOtherEmployee && TimesheetOwner != null ? TimesheetOwner.FullName : "Timesheet")
                </MudText>
                @if (CurrentSheet != null && (_timesheetSettings.RequireApproval || CurrentSheet.Status == TimesheetStatus.Approved || CurrentSheet.Status == TimesheetStatus.Submitted))
                {
                    <StatusChip Status="@CurrentSheet.Status" Class="ml-1" />
                }
            </div>
        </MudItem>

        <MudItem xs="12" md="7" Class="d-flex justify-center justify-md-end align-center gap-3 flex-wrap">
            @if (!IsViewingCurrentWeek)
            {
                <MudButton Variant="Variant.Text"
                           Color="Color.Primary"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Today"
                           OnClick="GoToCurrentWeek">
                    Current Week
                </MudButton>
            }

            <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" OnClick="@(() => ChangeWeek(-1))"
                Variant="Variant.Outlined" title="Previous Week" />

            <div class="d-flex flex-column align-center" style="min-width: 210px;">
                <div class="d-flex align-center gap-1">
                    <MudText Typo="Typo.h6">Week @CurrentWeekNumber, @CurrentYear</MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.CalendarMonth"
                                   Size="Size.Small"
                                   Color="Color.Primary"
                                   title="Jump to week"
                                   OnClick="OpenWeekPickerAsync" />
                    <div style="width: 0; height: 0; overflow: hidden; position: absolute;">
                        <MudDatePicker @ref="_weekDatePicker"
                                       Date="@WeekStart"
                                       DateChanged="OnJumpDateSelected"
                                       PickerVariant="PickerVariant.Dialog"
                                       ShowWeekNumbers="true"
                                       FirstDayOfWeek="DayOfWeek.Monday"
                                       Color="Color.Primary" />
                    </div>
                </div>
                <MudText Typo="Typo.caption">@WeekStart.ToString("MMM dd") - @WeekEnd.ToString("MMM dd, yyyy")</MudText>
                <div>
                    @if (IsSaving)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Warning">Saving...</MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Success">All changes saved</MudText>
                    }
                </div>
                @if (_timesheetSettings.RequireApproval && CurrentSheet != null)
                {
                    @if (CanEdit && (CurrentSheet.Status == TimesheetStatus.Draft || CurrentSheet.Status == TimesheetStatus.Rejected))
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" 
                            StartIcon="@Icons.Material.Filled.Send" OnClick="SubmitForApproval" Class="mt-1">
                            Submit for Approval
                        </MudButton>
                    }
                    else if (CurrentSheet.Status == TimesheetStatus.Submitted)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Info">Pending approval</MudText>
                    }
                }
            </div>

            <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" OnClick="@(() => ChangeWeek(1))"
                Variant="Variant.Outlined" title="Next Week" />
        </MudItem>
    </MudGrid>
</MudHidden>

<MudHidden Breakpoint="Breakpoint.MdAndUp">
    <div class="d-flex align-center justify-space-between mb-2 px-3 pt-1">
        <MudText Typo="Typo.h5" Style="font-weight: 700;">
            @(IsViewingOtherEmployee && TimesheetOwner != null ? TimesheetOwner.FullName : "Timesheet")
        </MudText>
        @if (CurrentSheet != null && (_timesheetSettings.RequireApproval || CurrentSheet.Status == TimesheetStatus.Approved || CurrentSheet.Status == TimesheetStatus.Submitted))
        {
            <StatusChip Status="@CurrentSheet.Status" />
        }
    </div>
</MudHidden>

@if (IsLoading)
{
    <MudProgressLinear Color="Color.Primary" Indeterminate="true" Class="my-4" />
}
else
{
    @if (!_hasBaseEditPermission)
    {
        <MudAlert Severity="Severity.Info" Class="mb-4 mx-3 mx-md-0">You have read-only access to this timesheet.</MudAlert>
    }
    @if (CurrentSheet?.Status == TimesheetStatus.Rejected && !string.IsNullOrEmpty(CurrentSheet.RejectionNote))
    {
        <MudAlert Severity="Severity.Warning" Class="mb-4 mx-3 mx-md-0" Variant="Variant.Outlined">
            <b>Timesheet Rejected:</b> @CurrentSheet.RejectionNote
        </MudAlert>
    }
    @if (IsSheetLocked)
    {
        <MudAlert Severity="@(_isEditModeUnlocked ? Severity.Warning : (CurrentSheet?.Status == TimesheetStatus.Approved ? Severity.Success : Severity.Info))"
                  Class="mb-4 mx-3 mx-md-0"
                  Variant="Variant.Outlined">
            <div class="d-flex align-center justify-space-between flex-wrap gap-2" style="width: 100%;">
                <span>
                    @if (_isEditModeUnlocked)
                    {
                        <b>Edit Mode Unlocked:</b> @("Changes are saved directly while keeping this timesheet's status unchanged.")
                    }
                    else if (CurrentSheet?.Status == TimesheetStatus.Approved)
                    {
                        @("This timesheet has been approved and is locked.")
                    }
                    else if (CurrentSheet?.Status == TimesheetStatus.Submitted)
                    {
                        @("This timesheet is pending approval and cannot be edited.")
                    }
                    else if (_isDateLocked)
                    {
                        @($"This timesheet is locked (past the {_timesheetSettings.LockTimesheetsOlderThanDays}-day cutoff).")
                    }
                </span>
                @if (CanOverrideLock)
                {
                    <MudSwitch T="bool"
                               Value="@_isEditModeUnlocked"
                               ValueChanged="OnEditModeToggled"
                               Color="Color.Warning"
                               Label="Edit Mode"
                               Size="Size.Small" />
                }
            </div>
        </MudAlert>
    }

    @if (_hiddenRestrictedEntries.Count > 0)
    {
        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true" Class="mb-3">
            @($"{_hiddenRestrictedEntries.Sum(e => e.Hours):0.##}h logged on restricted project(s) outside your access scope are hidden and preserved.")
        </MudAlert>
    }

    <MudHidden Breakpoint="Breakpoint.SmAndDown">
        <MudTable Items="@UiRows" Dense="true" Striped="false" Outlined="true" Elevation="0" Hover="true" FixedHeader="true">
            <HeaderContent>
                <MudTh Style="width: 18%;">Project</MudTh>
                <MudTh Style="width: 18%;">Task</MudTh>
                <MudTh Style="width: 18%;">Sub-Task</MudTh>

                @for (int i = 0; i < 7; i++)
                {
                    var day = WeekStart.AddDays(i);
                    var isToday = day == DateTime.Today;
                    var isWeekend = day.DayOfWeek == DayOfWeek.Saturday || day.DayOfWeek == DayOfWeek.Sunday;

                    <MudTh Class="@(isToday ? "mud-theme-primary lighten-5" : "")" Style="text-align: center;">
                        <div class="d-flex flex-column align-center">
                            <MudText Typo="Typo.caption" Color="@(isWeekend? Color.Secondary: Color.Default)">
                                @day.ToString("ddd")
                            </MudText>

                            <MudText Typo="Typo.body2" Style="font-weight:bold;"
                                Color="@(isWeekend? Color.Secondary: Color.Default)">
                                @day.Day
                            </MudText>
                        </div>
                    </MudTh>
                }
                <MudTh Style="width: 50px;">Total</MudTh>
                <MudTh Style="width: 50px;"></MudTh>
            </HeaderContent>

            <RowTemplate>
                <MudTd>
                    <MudAutocomplete T="string" Value="@context.ProjectId"
                        ValueChanged="@((string s) => OnProjectChanged(context, s))"
                        SearchFunc="SearchProjects"
                        ToStringFunc="GetProjectName"
                        Dense="true" Margin="Margin.Dense" Variant="Variant.Outlined" 
                        Placeholder="Project or Time Off"
                        ResetValueOnEmptyText="false"
                        CoerceText="false" 
                        Disabled="@(!CanEdit)" 
                        MaxItems="null"
                        Style="text-align: left;" />
                </MudTd>

                @if (context.IsLeaveRow)
                {
                    <MudTd colspan="2">
                        <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.EventAvailable">
                            @TimeEntryTypes.GetDisplayLabel(context.ProjectId)
                        </MudChip>
                    </MudTd>
                }
                else
                {
                    <WorkTypeSubTaskSelector WorkTypes="@ActiveWorkTypes"
                                             Projects="@ActiveProjects"
                                             ProjectId="@context.ProjectId"
                                             RequireProject="true"
                                             WorkTypeId="@context.WorkTypeId"
                                             SubTaskId="@context.SubTaskId"
                                             OnSelectionChanged="@(async (sel) => { context.WorkTypeId = sel.WorkTypeId; context.SubTaskId = sel.SubTaskId; await AutoSave(); })"
                                             Layout="WorkTypeSelectorLayout.TableCells"
                                             Variant="Variant.Outlined"
                                             UsePlaceholder="true"
                                             Disabled="@(!CanEdit)" />
                }

                @for (int i = 0; i < 7; i++)
                {
                    var dayIndex = i;
                    <MudTd Class="pa-1">
                        <div class="d-flex align-center gap-1">
                            <MudTextField Value="@FormatHours(context.DailyHours[dayIndex])"
                                ValueChanged="@((string v) => OnTimeChanged(context, dayIndex, v))"
                                Variant="Variant.Outlined" Margin="Margin.Dense" Style="text-align: center; flex: 1;"
                                Placeholder="-" Immediate="false"
                                Disabled="@(string.IsNullOrEmpty(context.ProjectId) || (!context.IsLeaveRow && string.IsNullOrEmpty(context.WorkTypeId) && _timesheetSettings.RequireTask && context.DailyHours.All(h => h == 0)) || !CanEdit)" />
                            @if (context.DailyHours[dayIndex] > 0 || !string.IsNullOrEmpty(context.DailyNotes[dayIndex]))
                            {
                                <MudTooltip Text="@(string.IsNullOrEmpty(context.DailyNotes[dayIndex]) ? "Add note" : context.DailyNotes[dayIndex])">
                                    <MudIconButton Icon="@(string.IsNullOrEmpty(context.DailyNotes[dayIndex]) ? Icons.Material.Outlined.StickyNote2 : Icons.Material.Filled.StickyNote2)"
                                        Size="Size.Small"
                                        Color="@(string.IsNullOrEmpty(context.DailyNotes[dayIndex]) ? Color.Default : Color.Primary)"
                                        Style="@(string.IsNullOrEmpty(context.DailyNotes[dayIndex]) ? "opacity: 0.3;" : "")"
                                        OnClick="@(() => OpenNoteDialog(context, dayIndex))" />
                                </MudTooltip>
                            }
                        </div>
                    </MudTd>
                }

                <MudTd Style="text-align: center; font-weight: bold;">
                    @FormatHours(context.DailyHours.Sum())
                </MudTd>

                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" Color="Color.Error"
                        OnClick="@(() => RemoveRow(context))" Disabled="@(!CanEdit)" />
                </MudTd>
            </RowTemplate>

            <FooterContent>
                <MudTd colspan="3" Class="pa-2">
                    @if (CanEdit)
                    {
                        <div class="d-flex align-center gap-2 flex-wrap">
                            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddNewRow" Variant="Variant.Text"
                                Color="Color.Primary">
                                Add Row
                            </MudButton>
                            <MudMenu Label="Add Time Off / Holiday"
                                     StartIcon="@Icons.Material.Filled.BeachAccess"
                                     EndIcon="@Icons.Material.Filled.KeyboardArrowDown"
                                     Variant="Variant.Outlined"
                                     Color="Color.Info"
                                     Size="Size.Small"
                                     Dense="true">
                                <MudMenuItem OnClick="@(() => AddLeaveRow(TimeEntryTypes.VacationRowKey))" Icon="@Icons.Material.Filled.BeachAccess">
                                    Vacation / Paid Time Off
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => AddLeaveRow(TimeEntryTypes.StatutoryHolidayRowKey))" Icon="@Icons.Material.Filled.Event">
                                    Statutory / Public Holiday
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => AddLeaveRow(TimeEntryTypes.BankedTimeOffRowKey))" Icon="@Icons.Material.Filled.Schedule">
                                    Banked Time Off (Redeem Hour Bank)
                                </MudMenuItem>
                                <MudMenuItem OnClick="@(() => AddLeaveRow(TimeEntryTypes.SickOrPersonalLeaveRowKey))" Icon="@Icons.Material.Filled.Healing">
                                    Sick / Personal Leave
                                </MudMenuItem>
                            </MudMenu>
                        </div>
                    }
                </MudTd>

                @for (int i = 0; i < 7; i++)
                {
                    var dayTotal = UiRows.Sum(r => r.DailyHours[i]);
                    // Added background color and larger text
                    <MudTd Style="text-align: center; background-color: var(--mud-palette-background-grey);">
                        @if (dayTotal > 0)
                        {
                            <MudText Typo="Typo.h6" Style="font-weight: 700;">@FormatHours(dayTotal)</MudText>
                        }
                    </MudTd>
                }

                <MudTd Style="text-align: center; background-color: var(--mud-palette-background-grey);">
                    <MudText Typo="Typo.h6" Color="Color.Primary" Style="font-weight: 900;">
                        @FormatHours(UiRows.Sum(r => r.DailyHours.Sum()))
                    </MudText>
                </MudTd>

                <MudTd Style="background-color: var(--mud-palette-background-grey);"></MudTd>
            </FooterContent>
        </MudTable>
    </MudHidden>

    <MudHidden Breakpoint="Breakpoint.MdAndUp">
        <TimesheetMobileDayView
            UiRows="@UiRows"
            WeekStart="@WeekStart"
            CurrentWeekNumber="@CurrentWeekNumber"
            IsSaving="@IsSaving"
            TimesheetOwner="@TimesheetOwner"
            WeeklyResult="@WeeklyResult"
            CurrentSheet="@CurrentSheet"
            Settings="@_timesheetSettings"
            CanEdit="@CanEdit"
            ActiveProjects="@ActiveProjects"
            ActiveWorkTypes="@ActiveWorkTypes"
            OnAddEntry="OpenDayLogDialog"
            OnEditEntry="OpenDayEditDialog"
            OnSubmitApproval="SubmitForApproval"
            OnChangeWeek="ChangeWeek"
            OnGoToCurrentWeek="GoToCurrentWeek" />
    </MudHidden>

    @* Hour Bank Panel *@
    <MudPaper Class="pa-4 mt-4 mx-3 mx-md-0" Elevation="0" Outlined="true" Style="border-radius: 16px;">
        <MudGrid>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.overline">Hour Bank</MudText>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h4" Color="@(HourBankResult.HourBank >= 0 ? Color.Success : Color.Error)">
                        @(HourBankResult.HourBank >= 0 ? "+" : "")@FormatHours(HourBankResult.HourBank)
                    </MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.History" Size="Size.Small" Color="Color.Secondary" OnClick="OpenHourBankAuditDialog" title="View Audit Trail" />
                    @if (CurrentUser != null && TimesheetOwner != null && (CurrentUser.IsAdmin || CurrentUser.HasPermission(AppPermissions.Hr.ManageEmployees) || CurrentUser.HasPermission(AppPermissions.Admin.ManageUsers) || (CurrentUser.Id != TimesheetOwner.Id && CanManage(CurrentUser, TimesheetOwner.Id))))
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Color="Color.Primary" OnClick="OpenAdjustHourBankDialog" title="Adjust Hour Bank" />
                    }
                </div>
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Since @HourBankResult.StartDate.ToString("MMM yyyy")</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.overline">This Week</MudText>
                <MudText Typo="Typo.h5">
                    @FormatHours(WeeklyResult.WorkedHours)
                    <span style="font-size: 0.8em; color: var(--mud-palette-text-secondary);">
                        / @FormatHours(WeeklyResult.ExpectedHours)
                    </span>
                </MudText>
                <MudText Typo="Typo.caption" Color="@(WeeklyResult.Difference >= 0 ? Color.Success : Color.Warning)">
                    @(WeeklyResult.Difference >= 0 ? "+" : "")@FormatHours(WeeklyResult.Difference)
                </MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.overline">Weekly Target</MudText>
                <MudText Typo="Typo.h5">@FormatHours(TimesheetOwner?.WeeklyHours ?? 0)</MudText>
                <MudText Typo="Typo.caption" Color="Color.Tertiary">Default hours</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" md="3">
                <MudText Typo="Typo.overline">Weeks Tracked</MudText>
                <MudText Typo="Typo.h5">@HourBankResult.WeeksTracked</MudText>
                <MudText Typo="Typo.caption" Color="Color.Tertiary">@FormatHours(HourBankResult.TotalWorkedHours) worked</MudText>
            </MudItem>
        </MudGrid>
    </MudPaper>

    @if (_timesheetSettings.EnableWeeklyPlan)
    {
        <MudPaper Elevation="0" Outlined="true" Class="pa-4 pa-md-6 mt-4 mx-3 mx-md-0 mb-4" Style="border-radius: 16px;">
            <MyWeekView />
        </MudPaper>
    }
}
</MudContainer>

@code {
    private static string FormatHours(decimal hours) => TimesheetFormatHelper.FormatHours(hours);

    private async Task OnTimeChanged(TimesheetUiRow row, int dayIndex, string value)
    {
        if (!CanEdit) return;
        decimal hours = TimesheetFormatHelper.ParseTimeInput(value);
        row.DailyHours[dayIndex] = hours;
        await AutoSave();
    }

    private async Task OnProjectChanged(TimesheetUiRow row, string? newProjectId)
    {
        if (!CanEdit) return;
        if (string.IsNullOrEmpty(newProjectId) && row.DailyHours.Any(h => h > 0))
        {
            // Never clear ProjectId on a row that already has logged hours; prevents accidental row wiping.
            return;
        }
        var targetProjectId = newProjectId ?? string.Empty;
        if (!CanCallerAccessTimesheetProject(CurrentUser, targetProjectId, allowSuspended: false))
        {
            Snackbar.Add("You do not have permission to assign that project.", Severity.Warning);
            LoadTimesheet();
            StateHasChanged();
            return;
        }
        row.ProjectId = targetProjectId;
        row.EntryType = TimeEntryTypes.ResolveEntryType(row.ProjectId);
        if (row.IsLeaveRow)
        {
            row.WorkTypeId = string.Empty;
            row.SubTaskId = string.Empty;
            row.IsBillable = false;
        }
        await AutoSave();
    }

    // --- UI STATE ---
    private DateTime WeekStart;
    private DateTime WeekEnd => WeekStart.AddDays(6);
    private int CurrentWeekNumber;
    private int CurrentYear;
    private bool IsLoading = true;
    private bool IsSaving = false;

    // --- DATA ---
    private Employee? CurrentUser;
    private Timesheet? CurrentSheet;
    private List<Project> ActiveProjects = new();
    private List<WorkType> ActiveWorkTypes = new();
    private MudDatePicker? _weekDatePicker;
    private TimesheetSettings _timesheetSettings = new();
    private bool _isDateLocked = false;

    // --- PERMISSIONS & LOCK OVERRIDE ---
    private bool _hasBaseEditPermission = false;
    private bool _isEditModeUnlocked = false;
    private bool CanEdit = false;

    private bool IsViewingOtherEmployee =>
        CurrentUser != null && TimesheetOwner != null && CurrentUser.Id != TimesheetOwner.Id;

    private bool IsViewingCurrentWeek
    {
        get
        {
            var today = DateTime.Today;
            return today >= WeekStart.Date && today <= WeekEnd.Date;
        }
    }

    private bool CanOverrideLock =>
        CurrentUser != null && TimesheetOwner != null && HRService.CanOverrideTimesheetLock(CurrentUser, TimesheetOwner.Id);

    private bool IsSheetLocked =>
        CurrentSheet != null &&
        (_isDateLocked ||
         CurrentSheet.Status == TimesheetStatus.Submitted ||
         CurrentSheet.Status == TimesheetStatus.Approved);

    // --- THE MATRIX (ViewModel) ---
    private List<TimesheetUiRow> UiRows = new();
    private List<TimeEntry> _hiddenRestrictedEntries = [];

    // --- OVERTIME TRACKING ---
    private HourBankResult HourBankResult = new();
    private WeeklyOvertimeResult WeeklyResult = new();

    // --- QUERY & ROUTE PARAMETERS ---
    [Parameter] public string? TargetEmployeeId { get; set; }
    [SupplyParameterFromQuery(Name = "year")] public int? QueryYear { get; set; }
    [SupplyParameterFromQuery(Name = "week")] public int? QueryWeek { get; set; }
    [SupplyParameterFromQuery(Name = "date")] public string? QueryDate { get; set; }
    private Employee? TimesheetOwner;

    protected override async Task OnInitializedAsync()
    {
        // 1. Setup Dates (Start on Monday)
        var today = DateTime.Today;
        var diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        WeekStart = today.AddDays(-1 * diff);
        UpdateWeekInfo();

        // 2. Load Helper Data
        ActiveWorkTypes = Db.WorkTypes.GetAll().Where(t => t.IsActive).OrderBy(t => t.Name).ToList();

        // Subscribe to timer changes so timesheet refreshes when timer stops
        TimerService.OnTimerChanged += OnTimerChanged;
    }

    protected override async Task OnParametersSetAsync()
    {
        IsLoading = true;
        ApplyQueryWeekIfPresent();

        CurrentUser = await UserService.GetEmployeeAsync(allowSuspended: true);
        if (CurrentUser != null)
        {
            // Determine which timesheet to load
            if (!string.IsNullOrEmpty(TargetEmployeeId) && TargetEmployeeId != CurrentUser.Id)
            {
                if (CanManage(CurrentUser, TargetEmployeeId))
                {
                    var target = Db.Employees.GetById(TargetEmployeeId);
                    if (target != null)
                    {
                        _hasBaseEditPermission = CurrentUser.IsActiveUnsuspended && CurrentUser.HasPermission(AppPermissions.Timesheets.AccessTimesheet);
                        _isEditModeUnlocked = false;
                        TimesheetOwner = target;
                        FilterProjects(TimesheetOwner);
                        LoadTimesheet();
                    }
                    else
                    {
                        Snackbar.Add("Employee not found", Severity.Error);
                        _hasBaseEditPermission = false;
                        CanEdit = false;
                    }
                }
                else
                {
                    Snackbar.Add("You do not have permission to view/edit this timesheet.", Severity.Error);
                    _hasBaseEditPermission = false;
                    CanEdit = false;
                }
            }
            else
            {
                // Own Timesheet
                _hasBaseEditPermission = CurrentUser.IsActiveUnsuspended && CurrentUser.HasPermission(AppPermissions.Timesheets.AccessTimesheet);
                _isEditModeUnlocked = false;
                TimesheetOwner = CurrentUser;
                FilterProjects(TimesheetOwner);
                LoadTimesheet();
            }
        }
        IsLoading = false;
    }

    private void ApplyQueryWeekIfPresent()
    {
        if (QueryYear is > 1900 and < 9999 && QueryWeek is >= 1 and <= 53)
        {
            try
            {
                int maxWeek = ISOWeek.GetWeeksInYear(QueryYear.Value);
                int clampedWeek = Math.Min(QueryWeek.Value, maxWeek);
                WeekStart = ISOWeek.ToDateTime(QueryYear.Value, clampedWeek, DayOfWeek.Monday);
                UpdateWeekInfo();
                return;
            }
            catch
            {
                // Ignore invalid query parameters
            }
        }

        if (!string.IsNullOrWhiteSpace(QueryDate) && DateTime.TryParse(QueryDate, out var parsedDate))
        {
            var d = parsedDate.Date;
            var diff = (7 + (d.DayOfWeek - DayOfWeek.Monday)) % 7;
            WeekStart = d.AddDays(-diff);
            UpdateWeekInfo();
        }
    }

    private Task OpenWeekPickerAsync() => _weekDatePicker?.OpenAsync() ?? Task.CompletedTask;

    private void OnJumpDateSelected(DateTime? selectedDate)
    {
        if (!selectedDate.HasValue) return;
        var d = selectedDate.Value.Date;
        var diff = (7 + (d.DayOfWeek - DayOfWeek.Monday)) % 7;
        WeekStart = d.AddDays(-diff);
        _isEditModeUnlocked = false;
        UpdateWeekInfo();
        LoadTimesheet();
    }

    private void OnEditModeToggled(bool unlocked)
    {
        _isEditModeUnlocked = unlocked;
        UpdateEditPermissions();
        if (CanEdit && !UiRows.Any())
        {
            UiRows.Add(new TimesheetUiRow());
        }
        else if (!CanEdit)
        {
            UiRows.RemoveAll(r => string.IsNullOrEmpty(r.ProjectId) && string.IsNullOrEmpty(r.WorkTypeId) && r.DailyHours.All(h => h == 0));
        }
        StateHasChanged();
    }

    private void OnTimerChanged()
    {
        InvokeAsync(() =>
        {
            LoadTimesheet();
            StateHasChanged();
        });
    }

