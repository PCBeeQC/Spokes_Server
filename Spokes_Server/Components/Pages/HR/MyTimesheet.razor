    private void UpdateWeekInfo()
    {
        CurrentWeekNumber = ISOWeek.GetWeekOfYear(WeekStart);
        CurrentYear = ISOWeek.GetYear(WeekStart);
    }

    private void ChangeWeek(int offset)
    {
        WeekStart = WeekStart.AddDays(offset * 7);
        _isEditModeUnlocked = false;
        UpdateWeekInfo();
        LoadTimesheet();
    }

    private bool CanCallerAccessTimesheetProject(Employee? caller, string? projectId, bool allowSuspended = true)
    {
        if (string.IsNullOrWhiteSpace(projectId) || TimeEntryTypes.IsLeaveProjectKey(projectId))
            return true;

        var proj = Db.Projects.GetById(projectId);
        return proj != null && ProjectAccessHelper.CanAccessProjectForContribution(caller, proj, Db.Teams, allowSuspended);
    }

    private void LoadTimesheet()
    {
        // 1. Get from DB
        if (TimesheetOwner == null) return;
        CurrentSheet = Db.Timesheets.GetOrStubByWeek(TimesheetOwner.Id, CurrentYear, CurrentWeekNumber);

        var sourceEntries = CurrentSheet.Entries ?? [];
        var visibleEntries = sourceEntries
            .Where(e => e.IsLeaveOrHoliday || CanCallerAccessTimesheetProject(CurrentUser, e.ProjectId, allowSuspended: true))
            .ToList();
        _hiddenRestrictedEntries = sourceEntries
            .Where(e => !e.IsLeaveOrHoliday && !CanCallerAccessTimesheetProject(CurrentUser, e.ProjectId, allowSuspended: true))
            .ToList();

        var visibleSheet = new Timesheet
        {
            Id = CurrentSheet.Id,
            EmployeeId = CurrentSheet.EmployeeId,
            EmployeeName = CurrentSheet.EmployeeName,
            Year = CurrentSheet.Year,
            WeekNumber = CurrentSheet.WeekNumber,
            Status = CurrentSheet.Status,
            Entries = visibleEntries
        };

        // Ensure any historical/inactive projects referenced by visible entries are in ActiveProjects (caller-ACL filtered)
        EnsureHistoricalProjectsIncluded(visibleSheet);

        // 2. Apply approval/locking restrictions first so CanEdit is accurate for the blank-row check
        UpdateEditPermissions();

        // 3. Convert "Flat List" to "Matrix Rows"
        UiRows = TimesheetUiRow.FromTimesheet(visibleSheet, WeekStart);

        // If empty, add one blank row to get them started without triggering concurrent autosave
        if (!UiRows.Any() && CanEdit) UiRows.Add(new TimesheetUiRow());

        // Load overtime data
        LoadOvertimeData();
    }

    private void EnsureHistoricalProjectsIncluded(Timesheet sheet)
    {
        if (sheet?.Entries == null || sheet.Entries.Count == 0 || CurrentUser == null) return;

        var activeIds = ActiveProjects.Select(p => p.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
        bool addedAny = false;

        foreach (var entry in sheet.Entries)
        {
            if (entry.IsLeaveOrHoliday || string.IsNullOrWhiteSpace(entry.ProjectId) || activeIds.Contains(entry.ProjectId))
                continue;

            var proj = Db.Projects.GetById(entry.ProjectId);
            if (proj != null && ProjectAccessHelper.CanAccessProjectForContribution(CurrentUser, proj, Db.Teams, allowSuspended: true))
            {
                ActiveProjects.Add(proj);
                activeIds.Add(proj.Id);
                addedAny = true;
            }
        }

        if (addedAny)
        {
            ActiveProjects = ActiveProjects.OrderBy(p => p.DisplayName).ToList();
        }
    }

    private void LoadOvertimeData()
    {
        if (TimesheetOwner == null) return;
        HourBankResult = OvertimeService.CalculateHourBank(TimesheetOwner.Id);
        WeeklyResult = OvertimeService.CalculateWeeklyOvertime(TimesheetOwner.Id, CurrentYear, CurrentWeekNumber);
    }

    private void UpdateEditPermissions()
    {
        if (CurrentSheet == null)
        {
            CanEdit = false;
            return;
        }

        // Load settings
        var profile = Db.CompanyProfile.Get();
        _timesheetSettings = profile?.TimesheetConfig ?? new TimesheetSettings();

        // Check date lock
        _isDateLocked = HRService.IsTimesheetLocked(CurrentSheet, _timesheetSettings);

        // Check status lock (Submitted or Approved timesheets are locked unless Edit Mode is unlocked by an authorized manager/admin)
        bool isStatusLocked = CurrentSheet.Status == TimesheetStatus.Submitted || CurrentSheet.Status == TimesheetStatus.Approved;
        bool isLocked = isStatusLocked || _isDateLocked;

        CanEdit = _hasBaseEditPermission && (!isLocked || (CanOverrideLock && _isEditModeUnlocked));
    }

    private async Task AddNewRow()
    {
        if (!CanEdit) return;
        UiRows.Add(new TimesheetUiRow());
        await AutoSave();
    }

    private async Task AddLeaveRow(string leaveRowKey)
    {
        if (!CanEdit || string.IsNullOrWhiteSpace(leaveRowKey)) return;
        if (UiRows.Any(r => string.Equals(r.ProjectId, leaveRowKey, StringComparison.OrdinalIgnoreCase)))
        {
            return;
        }
        UiRows.RemoveAll(r => string.IsNullOrEmpty(r.ProjectId) && string.IsNullOrEmpty(r.WorkTypeId) && r.DailyHours.All(h => h == 0));
        UiRows.Add(new TimesheetUiRow
        {
            ProjectId = leaveRowKey,
            EntryType = TimeEntryTypes.ResolveEntryType(leaveRowKey),
            IsBillable = false
        });
        await AutoSave();
    }

    private async Task RemoveRow(TimesheetUiRow row)
    {
        if (!CanEdit) return;
        UiRows.Remove(row);
        await AutoSave();
    }
