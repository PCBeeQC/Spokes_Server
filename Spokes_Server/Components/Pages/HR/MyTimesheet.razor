    private async Task<bool> AuthorizeTimesheetMutationAsync(string? targetProjectId = null)
    {
        var liveUser = await UserService.GetEmployeeAsync(allowSuspended: false);
        CurrentUser = liveUser ?? await UserService.GetEmployeeAsync(allowSuspended: true);

        if (liveUser == null || TimesheetOwner == null)
        {
            _hasBaseEditPermission = false;
            CanEdit = false;
            Snackbar.Add("You do not have permission to edit this timesheet.", Severity.Warning);
            LoadTimesheet();
            StateHasChanged();
            return false;
        }

        bool isSelf = string.Equals(liveUser.Id, TimesheetOwner.Id, StringComparison.Ordinal);
        bool hasTimesheetAccess = liveUser.HasPermission(AppPermissions.Timesheets.AccessTimesheet);
        _hasBaseEditPermission = isSelf
            ? hasTimesheetAccess
            : hasTimesheetAccess && CanManage(liveUser, TimesheetOwner.Id);

        UpdateEditPermissions();
        if (!CanEdit || CurrentSheet == null)
        {
            Snackbar.Add("You do not have permission to modify this timesheet.", Severity.Warning);
            if (TimesheetOwner != null) FilterProjects(TimesheetOwner);
            LoadTimesheet();
            StateHasChanged();
            return false;
        }

        if (!string.IsNullOrWhiteSpace(targetProjectId) &&
            !CanCallerAccessTimesheetProject(liveUser, targetProjectId, allowSuspended: false))
        {
            Snackbar.Add("You do not have permission to assign that project.", Severity.Warning);
            FilterProjects(TimesheetOwner);
            LoadTimesheet();
            StateHasChanged();
            return false;
        }

        foreach (var row in UiRows)
        {
            if (row.IsLeaveRow || string.IsNullOrWhiteSpace(row.ProjectId))
                continue;

            if (!CanCallerAccessTimesheetProject(liveUser, row.ProjectId, allowSuspended: false))
            {
                Snackbar.Add("Timesheet contains a restricted project outside your access scope.", Severity.Warning);
                FilterProjects(TimesheetOwner);
                LoadTimesheet();
                StateHasChanged();
                return false;
            }
        }

        return true;
    }

    private async Task AutoSave()
    {
        if (!await AuthorizeTimesheetMutationAsync()) return;
        IsSaving = true;
        StateHasChanged();

        var hiddenIds = _hiddenRestrictedEntries
            .Select(h => h.Id)
            .Where(id => !string.IsNullOrWhiteSpace(id))
            .ToHashSet(StringComparer.Ordinal);
        var currentVisibleEntries = (CurrentSheet!.Entries ?? [])
            .Where(e => !hiddenIds.Contains(e.Id) && !_hiddenRestrictedEntries.Contains(e))
            .ToList();

        // 1. Flatten the visible Matrix back into a List<TimeEntry> and preserve hidden restricted entries untouched
        var newVisibleEntries = TimesheetUiRow.ToTimeEntries(UiRows, WeekStart, currentVisibleEntries);

        // 2. Update the Sheet (preserving existing Status such as Approved)
        CurrentSheet.EmployeeName = TimesheetOwner?.FullName ?? "";
        CurrentSheet.Entries = newVisibleEntries.Concat(_hiddenRestrictedEntries).ToList();

        // 3. Persist
        Db.Timesheets.Save(CurrentSheet);
        LoadOvertimeData();

        await Task.Delay(300); // Give user visual feedback

        IsSaving = false;
        StateHasChanged();
    }

    private void GoToCurrentWeek()
    {
        var today = DateTime.Today;
        var diff = (7 + (today.DayOfWeek - DayOfWeek.Monday)) % 7;
        WeekStart = today.AddDays(-1 * diff);
        _isEditModeUnlocked = false;
        UpdateWeekInfo();
        LoadTimesheet();
    }

    private async Task OpenDayLogDialog(int dayIndex)
    {
        if (!CanEdit) return;

        var day = WeekStart.AddDays(dayIndex);
        var dailyTarget = (TimesheetOwner?.WeeklyHours ?? 40.0m) / 5.0m;

        var parameters = new DialogParameters<TimesheetDayEntryDialog>
        {
            { x => x.Date, day },
            { x => x.DefaultDailyHours, dailyTarget },
            { x => x.Projects, ActiveProjects },
            { x => x.WorkTypes, ActiveWorkTypes },
            { x => x.RequireNote, _timesheetSettings.RequireNote },
            { x => x.IsEditMode, false }
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TimesheetDayEntryDialog>(null, parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: TimesheetDayEntryResult entry })
        {
            if (!await AuthorizeTimesheetMutationAsync(entry.ProjectId)) return;

            var existingRow = UiRows.FirstOrDefault(r =>
                r.ProjectId == entry.ProjectId &&
                r.WorkTypeId == entry.WorkTypeId &&
                (r.SubTaskId ?? "") == (entry.SubTaskId ?? ""));

            if (existingRow != null)
            {
                existingRow.DailyHours[dayIndex] = entry.Hours;
                existingRow.DailyNotes[dayIndex] = entry.Note;
            }
            else
            {
                var newRow = new TimesheetUiRow
                {
                    ProjectId = entry.ProjectId,
                    WorkTypeId = entry.WorkTypeId,
                    SubTaskId = entry.SubTaskId ?? ""
                };
                newRow.DailyHours[dayIndex] = entry.Hours;
                newRow.DailyNotes[dayIndex] = entry.Note;
                UiRows.Add(newRow);
            }

            UiRows.RemoveAll(r => string.IsNullOrEmpty(r.ProjectId) && string.IsNullOrEmpty(r.WorkTypeId));

            await AutoSave();
            LoadOvertimeData();
            StateHasChanged();
        }
    }

    private async Task OpenDayEditDialog((TimesheetUiRow Row, int DayIndex) args)
    {
        if (!CanEdit) return;

        var row = args.Row;
        var dayIndex = args.DayIndex;
        var day = WeekStart.AddDays(dayIndex);
        var dailyTarget = (TimesheetOwner?.WeeklyHours ?? 40.0m) / 5.0m;

        var parameters = new DialogParameters<TimesheetDayEntryDialog>
        {
            { x => x.Date, day },
            { x => x.DefaultDailyHours, dailyTarget },
            { x => x.Projects, ActiveProjects },
            { x => x.WorkTypes, ActiveWorkTypes },
            { x => x.RequireNote, _timesheetSettings.RequireNote },
            { x => x.IsEditMode, true },
            { x => x.ProjectId, row.ProjectId },
            { x => x.WorkTypeId, row.WorkTypeId },
            { x => x.SubTaskId, row.SubTaskId },
            { x => x.Hours, row.DailyHours[dayIndex] },
            { x => x.Note, row.DailyNotes[dayIndex] ?? "" }
        };

        var options = new DialogOptions { CloseButton = true, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<TimesheetDayEntryDialog>(null, parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: TimesheetDayEntryResult entry })
        {
            if (!await AuthorizeTimesheetMutationAsync(entry.IsDelete ? null : entry.ProjectId)) return;

            if (entry.IsDelete)
            {
                row.DailyHours[dayIndex] = 0;
                row.DailyNotes[dayIndex] = "";
                row.EntryIds[dayIndex] = null;

                if (row.DailyHours.All(h => h == 0))
                {
                    UiRows.Remove(row);
                }
            }
            else
            {
                bool taskChanged = row.ProjectId != entry.ProjectId ||
                                   row.WorkTypeId != entry.WorkTypeId ||
                                   (row.SubTaskId ?? "") != (entry.SubTaskId ?? "");

                if (!taskChanged)
                {
                    row.DailyHours[dayIndex] = entry.Hours;
                    row.DailyNotes[dayIndex] = entry.Note;
                }
                else
                {
                    row.DailyHours[dayIndex] = 0;
                    row.DailyNotes[dayIndex] = "";
                    row.EntryIds[dayIndex] = null;
                    if (row.DailyHours.All(h => h == 0))
                    {
                        UiRows.Remove(row);
                    }

                    var targetRow = UiRows.FirstOrDefault(r =>
                        r.ProjectId == entry.ProjectId &&
                        r.WorkTypeId == entry.WorkTypeId &&
                        (r.SubTaskId ?? "") == (entry.SubTaskId ?? ""));

                    if (targetRow != null)
                    {
                        targetRow.DailyHours[dayIndex] = entry.Hours;
                        targetRow.DailyNotes[dayIndex] = entry.Note;
                    }
                    else
                    {
                        var newRow = new TimesheetUiRow
                        {
                            ProjectId = entry.ProjectId,
                            WorkTypeId = entry.WorkTypeId,
                            SubTaskId = entry.SubTaskId ?? ""
                        };
                        newRow.DailyHours[dayIndex] = entry.Hours;
                        newRow.DailyNotes[dayIndex] = entry.Note;
                        UiRows.Add(newRow);
                    }
                }
            }

            await AutoSave();
            LoadOvertimeData();
            StateHasChanged();
        }
    }

    private async Task OpenNoteDialog(TimesheetUiRow row, int dayIndex)
    {
        if (!CanEdit) return;
        var day = WeekStart.AddDays(dayIndex);
        var currentNote = row.DailyNotes[dayIndex] ?? "";

        var parameters = new DialogParameters<NoteEditDialog>
        {
            { x => x.Note, currentNote }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<NoteEditDialog>($"Note — {day:ddd, MMM dd}", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: string newNote })
        {
            row.DailyNotes[dayIndex] = newNote;
            await AutoSave();
        }
    }

    private void SubmitForApproval()
    {
        if (CurrentSheet == null) return;

        // Check if RequireNote is enabled and some entries are missing notes
        if (_timesheetSettings.RequireNote && UiRows.Any(r => r.DailyHours.Select((h, idx) => (Hours: h, Note: r.DailyNotes[idx])).Any(x => x.Hours > 0 && string.IsNullOrWhiteSpace(x.Note))))
        {
            Snackbar.Add("All time entries require a note before submitting.", Severity.Warning);
            return;
        }

        var result = HRService.SubmitTimesheet(CurrentSheet.Id, _timesheetSettings);
        if (result.IsSuccess)
        {
            LoadTimesheet();
            StateHasChanged();
            Snackbar.Add("Timesheet submitted for approval", Severity.Success);
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Could not submit timesheet.", Severity.Error);
        }
    }

    // --- MANAGER LOGIC ---
    private bool CanManage(Employee manager, string targetId) => HRService.CanManageEmployee(manager, targetId);


    private void FilterProjects(Employee owner)
    {
        if (CurrentUser == null)
        {
            ActiveProjects = [];
            return;
        }

        ActiveProjects = Db.Projects.GetAll()
            .Where(p => p.IsActive
                        && p.Status != ProjectStatus.Archived
                        && p.Status != ProjectStatus.Draft
                        && ProjectAccessHelper.CanAccessProjectForContribution(owner, p, Db.Teams, allowSuspended: true)
                        && ProjectAccessHelper.CanAccessProjectForContribution(CurrentUser, p, Db.Teams, allowSuspended: true))
            .OrderBy(p => p.DisplayName)
            .ToList();
    }

