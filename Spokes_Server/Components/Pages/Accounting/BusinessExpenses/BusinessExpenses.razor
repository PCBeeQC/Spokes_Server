@page "/business/expenses"
@attribute [Authorize]
@inject NavigationManager Nav

@code {
    [SupplyParameterFromQuery] public string? Tab { get; set; }

    protected override void OnInitialized()
    {
        var target = (Tab ?? "").ToLowerInvariant() switch
        {
            "salaries" => "/business/operating-costs?tab=internal",
            "recurring" => "/business/operating-costs?tab=recurring",
            "one-time" => "/business/operating-costs?tab=one-time",
            "estimator" => "/business/operating-costs?tab=overview",
            _ => "/business/operating-costs"
        };

        try
        {
            Nav.NavigateTo(target, replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
        }
    }
}
