        if (!_canManageBills)
        {
            Snackbar.Add(BizLoc["Active Purchases.ManageBills permission is required."].Value, Severity.Error);
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            Loc["Delete"].Value,
            string.Format(BizLoc["Are you sure you want to delete '{0}'?"].Value, item.Title),
            yesText: Loc["Delete"].Value,
            cancelText: Loc["Cancel"].Value);

        if (confirm != true) return;

        try
        {
            await RefreshCurrentUserAsync();
            DomainActorGuard.RequirePermission(_currentUser, AppPermissions.Purchases.ManageBills, "delete overhead item", allowSuspended: false);
            if (item.SourceBill != null)
            {
                AccountingService.DeleteBill(item.SourceBill.Id, _currentUser);
            }
            else if (item.SourceRecurringProfile != null)
            {
                AccountingService.DeleteRecurringExpense(item.SourceRecurringProfile.Id, _currentUser);
            }

            RefreshData();
            Snackbar.Add(BizLoc["Overhead item deleted."].Value, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
