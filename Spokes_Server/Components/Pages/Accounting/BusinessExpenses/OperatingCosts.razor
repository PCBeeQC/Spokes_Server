@page "/business/operating-costs"
@attribute [Authorize(Policy = AppPermissions.Finance.AccessAccounting)]
@implements IDisposable
@using System.Globalization
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Extensions
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Projects
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Components.Dialogs.Accounting
@using Spokes_Server.Components.Pages.Accounting.BusinessExpenses.Tabs
@using Spokes_Server.Components.Shared
@inject Database Db
@inject IBusinessOverheadService OverheadService
@inject IAccountingService AccountingService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject UserService UserService
@inject AppLabelService AppLabels

<PageTitle>@BizLoc["Company Bills & Overhead"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4 px-md-6">
    @* Header & Period Controls *@
    <div class="d-flex align-center justify-space-between flex-wrap gap-3 mt-2 mb-4">
        <div>
            <MudText Typo="Typo.h4">@BizLoc["Company Bills & Overhead"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">
                @BizLoc["Manage recurring fixed costs, one-time company bills, internal projects, and hourly overhead burden rates."]
            </MudText>
        </div>

        <div class="d-flex align-center flex-wrap gap-2">
            <MudSelect T="string"
                       Value="@_periodMode"
                       ValueChanged="OnPeriodModeChanged"
                       Variant="Variant.Outlined"
                       Margin="Margin.Dense"
                       Dense="true"
                       Style="min-width: 170px;">
                <MudSelectItem Value="@("Month")">@BizLoc["Monthly View"]</MudSelectItem>
                <MudSelectItem Value="@("Year")">@BizLoc["Annual View (12 Months)"]</MudSelectItem>
            </MudSelect>

            <div class="d-flex align-center gap-1">
                <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Small" OnClick="PrevPeriod" />
                <MudText Typo="Typo.subtitle1" Style="min-width: 140px; text-align: center;">
                    <b>@PeriodLabel</b>
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Small" OnClick="NextPeriod" />
            </div>
        </div>
    </div>

    @* KPI Summary Strip *@
    <div class="d-flex flex-wrap gap-4 mb-5">
        <div style="flex: 1; min-width: 220px;">
            <StatCard Title="@BizLoc["Fixed & Amortized Bills (Pre-Tax)"]"
                      Value="@FixedAndAmortizedPreTax.ToString("C0")"
                      Icon="@Icons.Material.Filled.ReceiptLong"
                      IconColor="Color.Primary"
                      Subtitle="@($"{ActiveRecurringProfilesCount} {BizLoc["Recurring"].Value.ToLower()} · {ActiveAmortizedItemsCount} {BizLoc["amortized (12-mo)"].Value}")" />
        </div>
        <div style="flex: 1; min-width: 220px;">
            <StatCard Title="@BizLoc["Internal Project Cost (Pre-Tax)"]"
                      Value="@InternalProjectsTotalPreTax.ToString("C0")"
                      Icon="@Icons.Material.Filled.Engineering"
                      IconColor="Color.Warning"
                      Subtitle="@($"{_overheadSummary.InternalLaborHours:N1} h {BizLoc["internal labor"].Value}")" />
        </div>
        <div style="flex: 1; min-width: 220px;">
            <StatCard Title="@BizLoc["Total Business Overhead Pool"]"
                      Value="@_overheadSummary.CompanyOverheadPoolPreTax.ToString("C0")"
                      Icon="@Icons.Material.Filled.AccountBalanceWallet"
                      IconColor="Color.Info"
                      Subtitle="@($"{BizLoc["Incl. Tax:"].Value} {_overheadSummary.CompanyOverheadPoolTotal:C0}")" />
        </div>
        <div style="flex: 1; min-width: 220px;">
            <StatCard Title="@BizLoc["Overhead Rate / Direct Hour"]"
                      Value="@($"{_overheadSummary.EffectiveOverheadRatePerDirectHourPreTax:C2}/h")"
                      Icon="@Icons.Material.Filled.Speed"
                      IconColor="Color.Success"
                      Subtitle="@($"{_overheadSummary.TotalCompanyDirectLaborHours:N1} h {BizLoc["direct client labor"].Value}")" />
        </div>
    </div>

    @* Primary Tabs *@
    <SpokesTabs ActivePanelIndex="@ActiveTabIndex"
                ActivePanelIndexChanged="OnTabIndexChanged"
                Class="mb-4">
        <MudTabPanel Text="@BizLoc["Recurring Company Bills"]" Icon="@Icons.Material.Filled.Repeat">
        <MudTable Items="@FilteredRecurringProfiles" Dense="true" Hover="true" Striped="true" Outlined="true" Elevation="0">
            <ToolBarContent>
                <div>
                    <MudText Typo="Typo.h6">@BizLoc["Recurring Fixed Cost Profiles"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @BizLoc["Rent, utilities, insurance, software subscriptions, and telecom bills prorated monthly."]
                    </MudText>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="_searchRecurring"
                              Placeholder="@BizLoc["Search name, supplier, category..."]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mt-0 mr-3"
                              Style="max-width: 260px;" />
                @if (_canManageBills)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddRecurringProfile">
                        @BizLoc["Add Recurring Cost"]
                    </MudButton>
                }
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@BizLoc["Expense Name"]</MudTh>
                <MudTh>@BizLoc["Supplier"]</MudTh>
                <MudTh>@BizLoc["GL Account"]</MudTh>
                <MudTh>@BizLoc["Frequency"]</MudTh>
                <MudTh Style="text-align: right;">@BizLoc["Base Amount"]</MudTh>
                <MudTh Style="text-align: right;">@BizLoc["Monthly Prorated (Pre-Tax)"]</MudTh>
                <MudTh>@BizLoc["Latest Bill Status"]</MudTh>
                <MudTh Style="text-align: right;">@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                @{
                    var monthlyPreTax = OverheadService.GetRecurringProfileMonthlyPreTax(context, _selectedDate.Year, _selectedDate.Month);
                    var linkedActualBills = Db.Bills.GetAll()
                        .Where(b => !b.IsVoid && b.Status != BillStatus.Void && string.Equals(b.LinkedRecurringExpenseId, context.Id, StringComparison.OrdinalIgnoreCase))
                        .ToList();
                    var latestLinkedBill = linkedActualBills.OrderByDescending(b => b.Date).FirstOrDefault();
                    var latestHistoryBill = context.History?.OrderByDescending(h => h.Date).FirstOrDefault();
                    var totalBillCount = (context.History?.Count ?? 0) + linkedActualBills.Count;
                }
                <MudTd DataLabel="@BizLoc["Expense Name"]">
                    <MudText Typo="Typo.body2"><b>@context.Name</b></MudText>
                    @if (!string.IsNullOrWhiteSpace(context.Description))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Description</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@BizLoc["Supplier"]">
                    @(string.IsNullOrWhiteSpace(context.Supplier) ? "—" : context.Supplier)
                </MudTd>
                <MudTd DataLabel="@BizLoc["GL Account"]">
                    @(string.IsNullOrWhiteSpace(context.GlAccountCode) ? "—" : context.GlAccountCode)
                </MudTd>
                <MudTd DataLabel="@BizLoc["Frequency"]">
                    <MudChip T="string" Size="Size.Small" Color="Color.Info" Variant="Variant.Outlined">
                        @context.Frequency
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@BizLoc["Base Amount"]" Style="text-align: right;">
                    @((context.Amount > 0 ? context.Amount : (latestLinkedBill?.Amount ?? latestHistoryBill?.Amount ?? 0m)).ToString("C2"))
                </MudTd>
                <MudTd DataLabel="@BizLoc["Monthly Prorated (Pre-Tax)"]" Style="text-align: right; font-weight: 700;">
                    @monthlyPreTax.ToString("C2")/mo
                </MudTd>
                <MudTd DataLabel="@BizLoc["Latest Bill Status"]">
                    @if (latestLinkedBill != null && (latestHistoryBill == null || latestLinkedBill.Date >= latestHistoryBill.Date))
                    {
                        var isBillSettled = latestLinkedBill.BalanceDue <= 0m || BillStatus.IsSettled(latestLinkedBill.Status);
                        var isWrittenOff = latestLinkedBill.Status == BillStatus.WrittenOff;
                        <MudChip T="string" Size="Size.Small" Color="@(isWrittenOff ? Color.Secondary : (isBillSettled ? Color.Success : Color.Warning))">
                            @(isWrittenOff ? BizLoc["Written Off"] : (isBillSettled ? BizLoc["Paid"] : BizLoc["Pending"])) (@latestLinkedBill.Date.ToString("MMM dd"))
                        </MudChip>
                    }
                    else if (latestHistoryBill != null)
                    {
                        var isHistSettled = latestHistoryBill.BalanceDue <= 0m || latestHistoryBill.IsPaid;
                        var isHistWrittenOff = latestHistoryBill.Status == BillStatus.WrittenOff;
                        <MudChip T="string" Size="Size.Small" Color="@(isHistWrittenOff ? Color.Secondary : (isHistSettled ? Color.Success : Color.Warning))">
                            @(isHistWrittenOff ? BizLoc["Written Off"] : (isHistSettled ? BizLoc["Paid"] : BizLoc["Pending"])) (@latestHistoryBill.Date.ToString("MMM dd"))
                        </MudChip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined">
                            @BizLoc["Prorated Estimate"]
                        </MudChip>
                    }
                </MudTd>
                <MudTd DataLabel="@Loc["Actions"]" Style="text-align: right; white-space: nowrap;">
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Receipt"
                               Class="mr-1"
                               OnClick="@(() => OpenRecurringBillHistory(context))">
                        @BizLoc["Bills"] (@totalBillCount)
                    </MudButton>
                    @if (_canManageBills)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditRecurringProfile(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteRecurringProfile(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-4 mud-text-secondary">
                    @BizLoc["No recurring fixed costs configured yet."]
                </MudText>
            </NoRecordsContent>
        </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["One-Time Company Bills"]" Icon="@Icons.Material.Filled.EventRepeat">
        <MudTable Items="@FilteredAmortizedItems" Dense="true" Hover="true" Striped="true" Outlined="true" Elevation="0">
            <ToolBarContent>
                <div>
                    <MudText Typo="Typo.h6">@BizLoc["One-Time Overhead Bills (Amortized Over 12 Months)"]</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @BizLoc["Non-project business purchases, legal/accounting fees, annual licenses, and shop tooling spread evenly across 12 calendar months."]
                    </MudText>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="_searchOneTime"
                              Placeholder="@BizLoc["Search supplier, description, invoice #..."]"
                              Adornment="Adornment.Start"
                              AdornmentIcon="@Icons.Material.Filled.Search"
                              Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              Class="mt-0 mr-3"
                              Style="max-width: 260px;" />
                @if (_canManageBills)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Primary"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="AddOverheadBill">
                        @BizLoc["Add Overhead Bill"]
                    </MudButton>
                }
            </ToolBarContent>
            <HeaderContent>
                <MudTh>@BizLoc["Date"]</MudTh>
                <MudTh>@BizLoc["Description / Invoice #"]</MudTh>
                <MudTh>@BizLoc["Supplier"]</MudTh>
                <MudTh Style="text-align: right;">@BizLoc["Pre-Tax Amount"]</MudTh>
                <MudTh Style="text-align: right;">@BizLoc["Total (Incl. Tax)"]</MudTh>
                <MudTh Style="text-align: right;">@BizLoc["Monthly Amortized (Pre-Tax)"]</MudTh>
                <MudTh>@BizLoc["12-Month Window"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh Style="text-align: right;">@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="@BizLoc["Date"]">@context.Date.ToString("yyyy-MM-dd")</MudTd>
                <MudTd DataLabel="@BizLoc["Description / Invoice #"]">
                    <MudText Typo="Typo.body2"><b>@context.Title</b></MudText>
                    @if (!string.IsNullOrWhiteSpace(context.Subtitle))
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Subtitle</MudText>
                    }
                </MudTd>
                <MudTd DataLabel="@BizLoc["Supplier"]">@(string.IsNullOrWhiteSpace(context.Supplier) ? "—" : context.Supplier)</MudTd>
                <MudTd DataLabel="@BizLoc["Pre-Tax Amount"]" Style="text-align: right;">@context.PreTaxAmount.ToString("C2")</MudTd>
                <MudTd DataLabel="@BizLoc["Total (Incl. Tax)"]" Style="text-align: right;">@context.TotalAmount.ToString("C2")</MudTd>
                <MudTd DataLabel="@BizLoc["Monthly Amortized (Pre-Tax)"]" Style="text-align: right; font-weight: 700;">
                    @context.MonthlyPreTax.ToString("C2")/mo
                </MudTd>
                <MudTd DataLabel="@BizLoc["12-Month Window"]">
                    <div class="d-flex align-center gap-1">
                        <MudText Typo="Typo.caption">@context.WindowStart.ToString("MMM yyyy") → @context.WindowEnd.ToString("MMM yyyy")</MudText>
                        @if (context.IsActiveInSelectedPeriod)
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Text">
                                @BizLoc["Active"]
                            </MudChip>
                        }
                    </div>
                </MudTd>
                <MudTd DataLabel="@Loc["Status"]">
                    <MudChip T="string" Size="Size.Small" Color="@context.StatusColor">
                        @context.StatusLabel
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="@Loc["Actions"]" Style="text-align: right; white-space: nowrap;">
                    @if (_canManageBills)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Edit"
                                       Color="Color.Primary"
                                       Size="Size.Small"
                                       OnClick="@(() => EditAmortizedItem(context))" />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                       Color="Color.Error"
                                       Size="Size.Small"
                                       OnClick="@(() => DeleteAmortizedItem(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-4 mud-text-secondary">
                    @BizLoc["No one-time business overhead bills recorded yet."]
                </MudText>
            </NoRecordsContent>
        </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["Internal Projects & Salaries"]" Icon="@Icons.Material.Filled.Groups">
        <MudPaper Class="pa-4 mb-5" Elevation="0" Outlined="true">
            <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                <div>
                    <MudText Typo="Typo.h6">@BizLoc["Internal & Unbillable Projects Overhead"] (@PeriodLabel)</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @BizLoc["All employee hours (loaded cost) and purchases logged to internal projects are included in the Business Overhead Pool."]
                    </MudText>
                </div>
            </div>

            <MudTable Items="@_internalProjectRows" Dense="true" Hover="true" Striped="true" Outlined="true" Elevation="0">
                <HeaderContent>
                    <MudTh>@BizLoc["Internal Project"]</MudTh>
                    @if (_canManageSalaries)
                    {
                        <MudTh>@AppLabels.Employees</MudTh>
                    }
                    <MudTh Style="text-align: right;">@BizLoc["Hours Logged"]</MudTh>
                    @if (_canManageSalaries)
                    {
                        <MudTh Style="text-align: right;">@BizLoc["Loaded Labor Cost"]</MudTh>
                    }
                    <MudTh Style="text-align: right;">@BizLoc["Purchases & Expenses (Pre-Tax)"]</MudTh>
                    <MudTh Style="text-align: right;">@BizLoc["Total Overhead Contribution"]</MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd DataLabel="@BizLoc["Internal Project"]">
                        @if (context.CanOpenProject)
                        {
                            <MudLink Href="@($"/projects/{context.ProjectId}")" Typo="Typo.body2">
                                <b>@context.ProjectDisplayName</b>
                            </MudLink>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2"><b>@context.ProjectDisplayName</b></MudText>
                        }
                    </MudTd>
                    @if (_canManageSalaries)
                    {
                        <MudTd DataLabel="@AppLabels.Employees">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @(context.Contributors.Count > 0 ? string.Join(", ", context.Contributors) : "—")
                            </MudText>
                        </MudTd>
                    }
                    <MudTd DataLabel="@BizLoc["Hours Logged"]" Style="text-align: right; font-weight: 600;">
                        @context.Hours.ToString("N1") h
                    </MudTd>
                    @if (_canManageSalaries)
                    {
                        <MudTd DataLabel="@BizLoc["Loaded Labor Cost"]" Style="text-align: right;">
                            @context.LaborCost.ToString("C2")
                        </MudTd>
                    }
                    <MudTd DataLabel="@BizLoc["Purchases & Expenses (Pre-Tax)"]" Style="text-align: right;">
                        @context.PurchasesAndExpensesPreTax.ToString("C2")
                    </MudTd>
                    <MudTd DataLabel="@BizLoc["Total Overhead Contribution"]" Style="text-align: right; font-weight: 700;">
                        @context.TotalPreTax.ToString("C2")
                    </MudTd>
                </RowTemplate>
                <NoRecordsContent>
                    <MudText Align="Align.Center" Class="py-3 mud-text-secondary">
                        @BizLoc["No internal projects found."]
                    </MudText>
                </NoRecordsContent>
            </MudTable>
        </MudPaper>

        @if (_canManageSalaries)
        {
            <SalaryTab />
        }
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["Overhead Rate & Allocation"]" Icon="@Icons.Material.Filled.PieChart">
            <MudGrid Spacing="4">
                <MudItem xs="12" md="5">
                    <MudPaper Class="pa-4 h-100" Elevation="0" Outlined="true">
                        <MudText Typo="Typo.h6" Class="mb-1">@BizLoc["Overhead Pool Distribution"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-block mb-4">
                            @PeriodLabel — @BizLoc["Pre-Tax Prorated Breakdown"]
                        </MudText>

                        @if (_chartData.Length > 0 && _overheadSummary.CompanyOverheadPoolPreTax > 0)
                        {
                            <MudChart ChartOptions="_chartOptions"
                                      ChartType="ChartType.Pie"
                                      ChartSeries="@_chartData.AsChartDataSet()"
                                      ChartLabels="@_chartLabels"
                                      Width="100%"
                                      Height="290px" />
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="mt-4">
                                @BizLoc["No operating overhead recorded for this period yet. Add recurring costs, overhead bills, or internal project time to populate the overhead pool."]
                            </MudAlert>
                        }
                    </MudPaper>
                </MudItem>

                <MudItem xs="12" md="7">
                    <MudPaper Class="pa-4 h-100" Elevation="0" Outlined="true">
                        <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-3">
                            <div>
                                <MudText Typo="Typo.h6">@BizLoc["Accountant Overhead & Allocation Summary"]</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @BizLoc["Allocated to client projects proportionally by direct labor hours."]
                                </MudText>
                            </div>
                            <MudChip T="string" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined">
                                @PeriodLabel
                            </MudChip>
                        </div>

                        <MudSimpleTable Elevation="0" Outlined="true" Dense="true" Hover="true" Bordered="true" Striped="true">
                            <thead>
                                <tr>
                                    <th>@BizLoc["Overhead Pillar"]</th>
                                    <th>@BizLoc["Details"]</th>
                                    <th style="text-align: right;">@BizLoc["Pre-Tax"]</th>
                                    <th style="text-align: right;">@BizLoc["Taxes"]</th>
                                    <th style="text-align: right;">@BizLoc["Total"]</th>
                                    <th style="text-align: right;">%</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var row in _overheadSummary.BreakdownRows)
                                {
                                    var sharePct = _overheadSummary.CompanyOverheadPoolPreTax > 0
                                        ? Math.Round(row.CompanyPoolPreTax / _overheadSummary.CompanyOverheadPoolPreTax * 100m, 1)
                                        : 0m;
                                    <tr>
                                        <td><b>@GetLocalizedCategoryName(row.Category, row.Name)</b></td>
                                        <td><MudText Typo="Typo.caption" Color="Color.Secondary">@row.Details</MudText></td>
                                        <td style="text-align: right; font-weight: 600;">@row.CompanyPoolPreTax.ToString("C2")</td>
                                        <td style="text-align: right; color: var(--mud-palette-text-secondary);">@row.CompanyPoolTax.ToString("C2")</td>
                                        <td style="text-align: right;">@row.CompanyPoolTotal.ToString("C2")</td>
                                        <td style="text-align: right;">@sharePct.ToString("N1")%</td>
                                    </tr>
                                }
                                <tr style="background-color: var(--mud-palette-background-grey); font-weight: 800;">
                                    <td><b>@BizLoc["Total Business Overhead Pool"]</b></td>
                                    <td>@BizLoc["100% allocated across active client projects"]</td>
                                    <td style="text-align: right;"><b>@_overheadSummary.CompanyOverheadPoolPreTax.ToString("C2")</b></td>
                                    <td style="text-align: right;"><b>@_overheadSummary.CompanyOverheadPoolTax.ToString("C2")</b></td>
                                    <td style="text-align: right;"><b>@_overheadSummary.CompanyOverheadPoolTotal.ToString("C2")</b></td>
                                    <td style="text-align: right;"><b>100%</b></td>
                                </tr>
                            </tbody>
                        </MudSimpleTable>

                        <MudPaper Class="pa-3 mt-4" Elevation="0" Style="background-color: var(--mud-palette-background-grey);">
                            <MudGrid Spacing="2" Class="align-center">
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Direct Client Hours (Period)"]</MudText>
                                    <MudText Typo="Typo.subtitle1"><b>@_overheadSummary.TotalCompanyDirectLaborHours.ToString("N1") h</b></MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Internal / Unbillable Hours"]</MudText>
                                    <MudText Typo="Typo.subtitle1"><b>@_overheadSummary.InternalLaborHours.ToString("N1") h</b></MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["Effective Overhead Rate (Pre-Tax)"]</MudText>
                                    <MudText Typo="Typo.subtitle1" Color="Color.Primary">
                                        <b>@_overheadSummary.EffectiveOverheadRatePerDirectHourPreTax.ToString("C2") / h</b>
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    </MudPaper>
                </MudItem>
            </MudGrid>
        </MudTabPanel>
    </SpokesTabs>
</MudContainer>

@code {
    [SupplyParameterFromQuery] public string? Tab { get; set; }

    private string _currentTab = "recurring";

    private int ActiveTabIndex => _currentTab switch
    {
        "recurring" => 0,
        "one-time" => 1,
        "internal" => 2,
        "overview" => 3,
        _ => 0
    };

