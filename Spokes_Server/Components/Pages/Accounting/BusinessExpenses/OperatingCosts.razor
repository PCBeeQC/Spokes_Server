    private void ResolveTabFromQuery()
    {
        if (string.IsNullOrWhiteSpace(Tab)) return;
        _currentTab = Tab.Trim().ToLowerInvariant() switch
        {
            "overview" or "estimator" => "overview",
            "recurring" or "manage" or "add-bills" => "recurring",
            "one-time" or "onetime" => "one-time",
            "internal" or "salaries" => "internal",
            _ => "overview"
        };
    }

    private void UpdateActiveTab(string tabName)
    {
        if (_isDisposed || string.IsNullOrWhiteSpace(tabName)) return;
        _currentTab = tabName;

        if (!Nav.Uri.Contains("/business/operating-costs", StringComparison.OrdinalIgnoreCase))
            return;

        try
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", tabName), replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
        }
    }

    private void OnPeriodModeChanged(string mode)
    {
        _periodMode = mode;
        RefreshData();
    }

    private void PrevPeriod()
    {
        _selectedDate = _periodMode == "Year"
            ? _selectedDate.AddYears(-1)
            : _selectedDate.AddMonths(-1);
        RefreshData();
    }

    private void NextPeriod()
    {
        _selectedDate = _periodMode == "Year"
            ? _selectedDate.AddYears(1)
            : _selectedDate.AddMonths(1);
        RefreshData();
    }

    private void RefreshData()
    {
        _overheadSummary = _currentUser != null
            ? OverheadService.CalculatePeriodOverhead(PeriodStart, PeriodEnd, actor: _currentUser)
            : new PeriodOverheadCalculationResult();

        var allRecurring = Db.RecurringExpenses.GetAll();
        _recurringProfiles = allRecurring
            .Where(r => !string.Equals(r.Frequency, RecurringExpenseFrequency.OneTime, StringComparison.OrdinalIgnoreCase))
            .OrderBy(r => r.Name)
            .ToList();

        BuildAmortizedItems(allRecurring);
        BuildInternalProjectRows();
        BuildChartData();
        StateHasChanged();
    }

    private void BuildChartData()
    {
        var nonZeroRows = _overheadSummary.BreakdownRows.Where(r => r.CompanyPoolPreTax > 0).ToList();
        if (nonZeroRows.Count > 0)
        {
            _chartLabels = nonZeroRows
                .Select(r => $"{GetLocalizedCategoryName(r.Category, r.Name)} ({r.CompanyPoolPreTax:C0})")
                .ToArray();
            _chartData = nonZeroRows
                .Select(r => (double)Math.Round(r.CompanyPoolPreTax, 2))
                .ToArray();
        }
        else
        {
            _chartLabels = [];
            _chartData = [];
        }
    }

    private string GetLocalizedCategoryName(string key, string fallback) => key switch
    {
        OverheadCostCategory.RecurringFixed => string.IsNullOrWhiteSpace(fallback) ? BizLoc["Recurring Fixed Costs"].Value : fallback,
        OverheadCostCategory.OneTimeAmortized => string.IsNullOrWhiteSpace(fallback) ? BizLoc["One-Time Overhead Bills (12-Mo Amortized)"].Value : fallback,
        OverheadCostCategory.InternalLabor => string.IsNullOrWhiteSpace(fallback) ? BizLoc["Internal & Unbillable Project Labor"].Value : fallback,
        OverheadCostCategory.InternalPurchasesAndExpenses => string.IsNullOrWhiteSpace(fallback) ? BizLoc["Internal Project Purchases & Expenses"].Value : fallback,
        _ => fallback
    };

    private void BuildAmortizedItems(IReadOnlyList<RecurringExpense> allRecurring)
    {
        _amortizedItems.Clear();

        // 1. Standalone Company Bills (not tied to a PO or Recurring Profile)
        var overheadBills = Db.Bills.GetAll()
            .Where(b => !string.Equals(b.Status, BillStatus.Void, StringComparison.OrdinalIgnoreCase)
                        && string.IsNullOrWhiteSpace(b.PurchaseOrderId)
                        && string.IsNullOrWhiteSpace(b.LinkedRecurringExpenseId))
            .OrderByDescending(b => b.Date)
            .ToList();

        foreach (var bill in overheadBills)
        {
            var sign = bill.IsCreditNote ? -1m : 1m;
            var preTax = (bill.SubTotal > 0m ? bill.SubTotal : Math.Max(0m, bill.Amount - bill.TaxAmount)) * sign;
            var total = bill.Amount * sign;
            var winStart = new DateTime(bill.Date.Year, bill.Date.Month, 1);
            var winEnd = winStart.AddMonths(11);
            var isActive = winStart <= PeriodEnd && winEnd >= new DateTime(PeriodStart.Year, PeriodStart.Month, 1);

            var isPaid = bill.BalanceDue <= 0m || BillStatus.IsSettled(bill.Status);
            var statusColor = bill.Status == BillStatus.WrittenOff
                ? Color.Secondary
                : (isPaid
                    ? Color.Success
                    : (string.Equals(bill.Status, BillStatus.AwaitingApproval, StringComparison.OrdinalIgnoreCase) ? Color.Warning : Color.Error));

            _amortizedItems.Add(new AmortizedOverheadItemViewModel
            {
                Id = bill.Id,
                Date = bill.Date,
                Title = !string.IsNullOrWhiteSpace(bill.Description)
                    ? bill.Description
                    : (!string.IsNullOrWhiteSpace(bill.InvoiceNumber) ? $"Invoice #{bill.InvoiceNumber}" : BizLoc["Business Overhead Bill"].Value),
                Subtitle = !string.IsNullOrWhiteSpace(bill.InvoiceNumber) ? $"Inv #{bill.InvoiceNumber}" : string.Empty,
                Supplier = bill.SupplierName,
                PreTaxAmount = preTax,
                TotalAmount = total,
                MonthlyPreTax = Math.Round(preTax / 12m, 2),
                WindowStart = winStart,
                WindowEnd = winEnd,
                IsActiveInSelectedPeriod = isActive,
                StatusLabel = isPaid ? BizLoc["Paid"].Value : bill.Status,
                StatusColor = statusColor,
                SourceBill = bill
            });
        }

        // 2. Legacy / One-Time RecurringExpense items
        var oneTimeProfiles = allRecurring
            .Where(r => string.Equals(r.Frequency, RecurringExpenseFrequency.OneTime, StringComparison.OrdinalIgnoreCase))
            .OrderByDescending(r => r.CreatedDate)
            .ToList();

        foreach (var profile in oneTimeProfiles)
        {
            var latestRec = profile.History?.OrderByDescending(h => h.Date).FirstOrDefault();
            var effDate = latestRec?.Date ?? profile.CreatedDate;
            decimal preTax;
            decimal total;

            if (latestRec != null && latestRec.Amount > 0m)
            {
                total = latestRec.Amount;
                preTax = latestRec.SubTotal > 0m
                    ? latestRec.SubTotal
                    : FinancialCalculationEngine.CalculateFromGrandTotal(latestRec.Amount, profile.IsTaxExempt).SubTotal;
            }
            else
            {
                total = profile.Amount;
                preTax = FinancialCalculationEngine.CalculateFromGrandTotal(profile.Amount, profile.IsTaxExempt).SubTotal;
            }

            var winStart = new DateTime(effDate.Year, effDate.Month, 1);
            var winEnd = winStart.AddMonths(11);
            var isActive = winStart <= PeriodEnd && winEnd >= new DateTime(PeriodStart.Year, PeriodStart.Month, 1);
            var isPaid = latestRec?.IsPaid == true;

            _amortizedItems.Add(new AmortizedOverheadItemViewModel
            {
                Id = profile.Id,
                Date = effDate,
                Title = profile.Name,
                Subtitle = profile.Description,
                Supplier = profile.Supplier,
                PreTaxAmount = preTax,
                TotalAmount = total,
                MonthlyPreTax = Math.Round(preTax / 12m, 2),
                WindowStart = winStart,
                WindowEnd = winEnd,
                IsActiveInSelectedPeriod = isActive,
                StatusLabel = isPaid ? BizLoc["Paid"].Value : (latestRec != null ? BizLoc["Pending"].Value : BizLoc["One-Time Profile"].Value),
                StatusColor = isPaid ? Color.Success : Color.Warning,
                SourceRecurringProfile = profile
            });
        }

        _amortizedItems = _amortizedItems.OrderByDescending(i => i.Date).ToList();
    }

    private void BuildInternalProjectRows()
    {
        _internalProjectRows.Clear();
        if (_currentUser == null) return;

        var internalProjects = Db.Projects.GetAll()
            .Where(p => p.IsInternal && ProjectAccessHelper.CanAccess(_currentUser, p, Db.Teams, allowAccountingFinancialRead: true))
            .OrderBy(p => p.ProjectNumber)
            .ThenBy(p => p.Name)
            .ToList();

        if (internalProjects.Count == 0) return;

        var employees = _canManageSalaries
            ? Db.Employees.GetAll().ToDictionary(e => e.Id, StringComparer.OrdinalIgnoreCase)
            : new Dictionary<string, Employee>(StringComparer.OrdinalIgnoreCase);
        var contributions = _canManageSalaries ? Db.EmployerContributions.GetAll() : [];
        var timesheets = Db.Timesheets.GetAll()
            .Where(t => t != null && !string.Equals(t.Status, TimesheetStatus.Rejected, StringComparison.OrdinalIgnoreCase))
            .ToList();
        var pos = Db.PurchaseOrders.GetAll()
            .Where(po => !string.Equals(po.Status, PurchaseOrderStatus.Void, StringComparison.OrdinalIgnoreCase)
                         && !string.Equals(po.Status, PurchaseOrderStatus.Draft, StringComparison.OrdinalIgnoreCase)
                         && po.Date.Date >= PeriodStart.Date && po.Date.Date <= PeriodEnd.Date)
            .ToList();
        var expenseReports = Db.ExpenseReports.GetAll()
            .Where(exp => exp != null && !string.Equals(exp.Status, ExpenseReportStatus.Draft, StringComparison.OrdinalIgnoreCase))
            .ToList();

        foreach (var proj in internalProjects)
        {
            decimal hours = 0m;
            decimal laborCost = 0m;
            var contributors = new HashSet<string>(StringComparer.OrdinalIgnoreCase);

            foreach (var ts in timesheets)
            {
                if (ts?.Entries == null) continue;
                Employee? emp = null;
                var hourlyCost = 0m;
                if (_canManageSalaries)
                {
                    employees.TryGetValue(ts.EmployeeId ?? string.Empty, out emp);
                    hourlyCost = EmployerContribution.CalculateTotalHourlyCost(emp, contributions);
                }

                foreach (var entry in ts.Entries)
                {
                    if (entry.Hours <= 0m) continue;
                    if (!string.Equals(entry.ProjectId, proj.Id, StringComparison.OrdinalIgnoreCase)) continue;
                    var d = entry.Date.Date;
                    if (d < PeriodStart.Date || d > PeriodEnd.Date) continue;

                    hours += entry.Hours;
                    if (_canManageSalaries)
                    {
                        laborCost += Math.Round(entry.Hours * hourlyCost, 2);
                        if (emp != null && !string.IsNullOrWhiteSpace(emp.FullName))
                            contributors.Add(emp.FullName);
                    }
                }
            }

            decimal purchasesPreTax = 0m;
            foreach (var po in pos)
            {
                if (po.LineItems == null) continue;
                foreach (var item in po.LineItems)
                {
                    if (string.Equals(item.ProjectId, proj.Id, StringComparison.OrdinalIgnoreCase))
                        purchasesPreTax += Math.Round(item.Total, 2);
                }
            }

            foreach (var exp in expenseReports)
            {
                if (exp?.LineItems == null) continue;
                foreach (var item in exp.LineItems)
                {
                    if (!string.Equals(item.ProjectId, proj.Id, StringComparison.OrdinalIgnoreCase)) continue;
                    if (item.Date.Date < PeriodStart.Date || item.Date.Date > PeriodEnd.Date) continue;
                    purchasesPreTax += Math.Round(item.EffectiveSubTotal, 2);
                }
            }

            _internalProjectRows.Add(new InternalProjectOverheadRow
            {
                ProjectId = proj.Id,
                ProjectDisplayName = proj.DisplayName,
                CanOpenProject = ProjectAccessHelper.CanAccess(_currentUser, proj, Db.Teams, allowAccountingFinancialRead: false),
                Contributors = _canManageSalaries ? contributors.OrderBy(c => c).ToList() : [],
                Hours = Math.Round(hours, 2),
                LaborCost = _canManageSalaries ? Math.Round(laborCost, 2) : 0m,
                PurchasesAndExpensesPreTax = Math.Round(purchasesPreTax, 2),
                TotalPreTax = Math.Round((_canManageSalaries ? laborCost : 0m) + purchasesPreTax, 2)
            });
        }
    }

