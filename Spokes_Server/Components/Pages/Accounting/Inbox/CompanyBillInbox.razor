    private async Task ApproveSingleBill(Bill bill)
    {
        if (_selectedMessage == null || _approvingBillId != null || _isApprovingAll) return;

        _approvingBillId = bill.Id;
        StateHasChanged();
        try
        {
            var isPaid = bill.BalanceDue <= 0;
            var msgId = _selectedMessage.Id;
            BillInboxService.ApproveBillFromEmail(msgId, bill.Id, _currentUserId);
            _approvingBillId = null;
            Snackbar.Add(
                string.Format(
                    isPaid ? BizLoc["Bill for {0} approved! Marked as Paid."].Value : BizLoc["Bill for {0} approved! Marked as Unpaid."].Value,
                    bill.SupplierName),
                Severity.Success);

            var updatedEmail = Db.EmailMessages.GetById(msgId);
            if (updatedEmail == null || updatedEmail.BillingStatus == CompanyBillInboxConstants.BillingStatus.Approved)
            {
                await AdvanceToNextAfterActionAsync(msgId);
            }
            else
            {
                await ReloadMessagesAsync(msgId);
            }
        }
        catch (Exception ex)
        {
            _approvingBillId = null;
            Logger.LogError(ex, "Failed to approve bill {BillId} from email {MessageId}", bill.Id, _selectedMessage.Id);
            Snackbar.Add(BizLoc["Failed to approve bill."].Value, Severity.Error);
        }
        finally
        {
            _approvingBillId = null;
            StateHasChanged();
        }
    }

    private async Task PromptRejectSingleBill(Bill bill)
    {
        if (_selectedMessage == null || _rejectingBillId != null || _approvingBillId != null || _isApprovingAll) return;

        var parameters = new DialogParameters<RejectDraftBillDialog>
        {
