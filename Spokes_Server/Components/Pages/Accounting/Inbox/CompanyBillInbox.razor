    private async Task AdvanceToNextAfterActionAsync(string completedMessageId)
    {
        var prevFiltered = FilteredMessages;
        var prevIndex = prevFiltered.FindIndex(m => m.Id == completedMessageId);

        _allMessages = Db.EmailMessages.GetAllForEmployee(CompanyBillInboxConstants.SystemEmployeeId)
            .OrderByDescending(m => m.Date)
            .ToList();

        var newFiltered = FilteredMessages;

        if (newFiltered.Count > 0)
        {
            int targetIndex;
            if (newFiltered.Any(m => m.Id == completedMessageId))
            {
                targetIndex = prevIndex >= 0 && prevIndex < newFiltered.Count - 1
                    ? prevIndex + 1
                    : Math.Clamp(prevIndex, 0, newFiltered.Count - 1);
            }
            else
            {
                targetIndex = Math.Clamp(prevIndex >= 0 ? prevIndex : 0, 0, newFiltered.Count - 1);
            }

            await OnMessageSelected(newFiltered[targetIndex]);
        }
        else
        {
            await OnMessageSelected(null);
        }
        StateHasChanged();
    }

