    private async Task PromptDeleteEmail(EmailMessage msg)
    {
        if (_isDeleting) return;

        var (draftCount, _) = GetMessageBillCounts(msg);
        var folderName = string.IsNullOrWhiteSpace(_settings.DeletedFolderName) ? "SPOKES_DELETED" : _settings.DeletedFolderName;
        string content = draftCount > 0
            ? string.Format(BizLoc["Are you sure you want to delete this email? It will be moved to '{0}' on the mail server and its {1} unapproved draft bill(s) will be permanently deleted."].Value, folderName, draftCount)
            : string.Format(BizLoc["Are you sure you want to delete this email? It will be moved to '{0}' on the mail server."].Value, folderName);

        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            BizLoc["Delete Billing Email?"].Value,
            content,
            yesText: BizLoc["Delete"].Value,
            cancelText: Loc["Cancel"].Value);

        if (confirmed == true)
        {
            _isDeleting = true;
            StateHasChanged();
            try
            {
                var result = await BillInboxService.DeleteEmailAsync(msg.Id, _currentUserId, deleteLinkedDrafts: true);
                if (result.Success)
                {
                    Snackbar.Add(string.Format(BizLoc["Email moved to '{0}' and draft bills cleaned up."].Value, folderName), Severity.Success);
                    await AdvanceToNextAfterActionAsync(msg.Id);
                }
                else
                {
                    Snackbar.Add(result.Message, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to delete billing email {MessageId}", msg.Id);
                Snackbar.Add(BizLoc["An error occurred while deleting the email."].Value, Severity.Error);
            }
            finally
            {
                _isDeleting = false;
                StateHasChanged();
            }
        }
    }

    private async Task PromptBlockSenderDomain()
    {
        if (_isDeleting || _selectedMessage == null || string.IsNullOrWhiteSpace(_selectedMessage.FromAddress)) return;

        var domain = _selectedMessage.FromAddress.Split('@').LastOrDefault()?.ToLowerInvariant();
        if (string.IsNullOrEmpty(domain)) return;

        var folderName = string.IsNullOrWhiteSpace(_settings.DeletedFolderName) ? "SPOKES_DELETED" : _settings.DeletedFolderName;
        bool? confirmed = await DialogService.ShowMessageBoxAsync(
            BizLoc["Block Sender Domain?"].Value,
            string.Format(BizLoc["Are you sure you want to block '{0}'? All future emails from this domain will be ignored, and this email will be moved to '{1}'."].Value, domain, folderName),
            yesText: BizLoc["Block & Delete Email"].Value,
            cancelText: Loc["Cancel"].Value);

        if (confirmed == true)
        {
            _isDeleting = true;
            StateHasChanged();
            try
            {
                var msgId = _selectedMessage.Id;
                var result = await BillInboxService.BlockSenderDomainAsync(_selectedMessage.FromAddress, msgId, _currentUserId);
                if (result.Success)
                {
                    Snackbar.Add(string.Format(BizLoc["Domain '{0}' added to ignored list and email deleted."].Value, domain), Severity.Success);
                    ReloadSettings();
                    await AdvanceToNextAfterActionAsync(msgId);
                }
                else
                {
                    Snackbar.Add(result.Message, Severity.Error);
                }
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to block sender domain {Domain}", domain);
                Snackbar.Add(BizLoc["An error occurred while blocking the sender domain."].Value, Severity.Error);
            }
            finally
            {
                _isDeleting = false;
                StateHasChanged();
            }
        }
    }

    private async Task OpenLinkToExistingBill()
    {
        if (_selectedMessage == null) return;

        var parameters = new DialogParameters<LinkBillToEmailDialog>
        {
            { x => x.Email, _selectedMessage }
        };

        var dialog = await DialogService.ShowAsync<LinkBillToEmailDialog>(BizLoc["Link Email to Existing Bill"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        });

        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            var msgId = _selectedMessage.Id;
            if (result.Data is LinkBillToEmailDialog.ExistingBillItem item)
            {
                if (item.IsRecurring && item.RecurringExpense != null && item.RecurringRecord != null)
                {
                    BillInboxService.AttachAttachmentToExistingRecurringBill(
                        msgId,
                        item.RecurringExpense.Id,
                        item.RecurringRecord.Id,
                        _currentUserId);
                    Snackbar.Add(string.Format(BizLoc["Email linked to recurring bill '{0}' and marked as dealt with!"].Value, item.SupplierName), Severity.Success);
                }
                else if (item.Bill != null)
                {
                    BillInboxService.AttachAttachmentToExistingBill(
                        msgId,
                        item.Bill.Id,
                        _currentUserId);
                    Snackbar.Add(string.Format(BizLoc["Email linked to bill #{0} and marked as dealt with!"].Value, item.InvoiceNumber ?? item.Bill.Id), Severity.Success);
                }
                await AdvanceToNextAfterActionAsync(msgId);
            }
            else if (result.Data is Bill linkedBill)
            {
                BillInboxService.AttachAttachmentToExistingBill(msgId, linkedBill.Id, _currentUserId);
                Snackbar.Add(string.Format(BizLoc["Email linked to bill #{0} and marked as dealt with!"].Value, linkedBill.InvoiceNumber ?? linkedBill.Id), Severity.Success);
                await AdvanceToNextAfterActionAsync(msgId);
            }
        }
    }

    private async Task OpenAddToRecurringBill()
    {
        if (_selectedMessage == null) return;

        var parameters = new DialogParameters<AddBillToRecurringExpenseDialog>
        {
            { x => x.Email, _selectedMessage }
        };

        var dialog = await DialogService.ShowAsync<AddBillToRecurringExpenseDialog>(
            BizLoc["Add to Existing Recurring Bill"],
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true
            });

        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is RecurringBillRecord)
        {
            var msgId = _selectedMessage.Id;
            Snackbar.Add(BizLoc["Bill added to recurring expense and email marked as dealt with!"], Severity.Success);
            await AdvanceToNextAfterActionAsync(msgId);
        }
    }

    private async Task ViewLinkedRecurringExpense(RecurringExpense? expense = null)
    {
        var target = expense ?? (!string.IsNullOrEmpty(_selectedMessage?.LinkedRecurringExpenseId) ? Db.RecurringExpenses.GetById(_selectedMessage.LinkedRecurringExpenseId) : null);
        if (target == null) return;

        var parameters = new DialogParameters<RecurringExpenseDialog>
        {
            { x => x.Expense, target },
            { x => x.IsNew, false },
            { x => x.ActiveTabIndex, 1 } // Bill History tab
        };

        var dialog = await DialogService.ShowAsync<RecurringExpenseDialog>(
            string.Format(BizLoc["Recurring Bill: {0}"].Value, target.Name),
            parameters,
            new DialogOptions
            {
                MaxWidth = MaxWidth.Medium,
                FullWidth = true,
                CloseButton = true
            });

        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is RecurringExpense updated)
        {
            Db.RecurringExpenses.Save(updated);
            StateHasChanged();
        }
    }

    private async Task OpenLinkPoDialog(Bill draft)
    {
        var parameters = new DialogParameters<SelectPurchaseOrderDialog>
        {
            { x => x.SupplierName, draft.SupplierName }
        };

        var dialog = await DialogService.ShowAsync<SelectPurchaseOrderDialog>(BizLoc["Link Purchase Order"], parameters, new DialogOptions
        {
            MaxWidth = MaxWidth.Medium,
            FullWidth = true,
            CloseButton = true
        });

        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is PurchaseOrder po)
        {
            draft.PurchaseOrderId = po.Id;
            draft.AutoMatchReason = $"Manually linked to PO #{po.PoNumber}";
            Db.Bills.Save(draft);
            Snackbar.Add(string.Format(BizLoc["Purchase Order #{0} linked to draft bill."].Value, po.PoNumber), Severity.Success);
            await ReloadMessagesAsync();
        }
    }

    private void UnlinkPoFromDraft(Bill draft)
    {
        draft.PurchaseOrderId = null;
        draft.AutoMatchReason = null;
        Db.Bills.Save(draft);
        Snackbar.Add(BizLoc["Purchase Order unlinked from draft bill."], Severity.Info);
        StateHasChanged();
    }
}
