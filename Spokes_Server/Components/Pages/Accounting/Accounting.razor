@page "/business/accounting"
@attribute [Authorize(Policy = AppPermissions.Finance.AccessAccounting)]
@implements IDisposable
<PageTitle>Accounting Dashboard</PageTitle>
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Components.Pages.Accounting.Expenses
@using Spokes_Server.Components.Pages.Projects
@using Spokes_Server.Components.Pages.Accounting.Tabs
@using Spokes_Server.Components.Pages.Accounting.BusinessExpenses
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Shared
@using Spokes_Server.Core.Services.Accounting
@inject Database Db
@inject IAccountingService AccountingService
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject AuthenticationStateProvider AuthStateProvider
@inject UserService UserService

<div class="d-flex flex-column h-100" style="min-height: 0;">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mt-4 mb-3 flex-shrink-0">
        <div>
            <MudText Typo="Typo.h4">Accounting & Invoicing</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">Payables, receivables, cash flow, and bill processing.</MudText>
        </div>
        <div class="d-flex align-center gap-2">
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Dashboard"
                       OnClick="@(() => Nav.NavigateTo("/business-dashboard"))">
                Financial Dashboard
            </MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.MarkEmailUnread"
                       OnClick="@(() => Nav.NavigateTo("/business/accounting/inbox"))">
                Company Bill Inbox
            </MudButton>
        </div>
    </div>

<div class="d-flex flex-wrap gap-4 mb-6 flex-shrink-0">
    <div style="flex: 1; min-width: 200px;">
        <StatCard Title="Total Outstanding Payable" 
                  Value="@TotalOutstandingPayable.ToString("C0")" 
                  Icon="@Icons.Material.Filled.MoneyOff" 
                  IconColor="Color.Error" 
                  Subtitle="@(AwaitingApprovalBills.Count > 0 ? $"{AwaitingApprovalBills.Count} bill(s) ({TotalAwaitingApproval.ToString("C0")}) awaiting approval" : null)" />
    </div>
    <div style="flex: 1; min-width: 200px;">
        <StatCard Title="Due or Past Due Payable" 
                  Value="@DuePastDuePayable.ToString("C0")" 
                  Icon="@Icons.Material.Filled.Warning" 
                  IconColor="Color.Error" 
                  Subtitle="@($"{DuePastDuePayableCount} item(s)")" />
    </div>
    <div style="flex: 1; min-width: 200px;">
        <StatCard Title="Outstanding Receivable" 
                  Value="@OutstandingReceivable.ToString("C0")" 
                  Icon="@Icons.Material.Filled.AttachMoney" 
                  IconColor="Color.Success" />
    </div>
    <div style="flex: 1; min-width: 200px;">
        <StatCard Title="Overdue Receivable" 
                  Value="@OverdueReceivable.ToString("C0")" 
                  Icon="@Icons.Material.Filled.AssignmentLate" 
                  IconColor="Color.Warning" 
                  Subtitle="@($"{OverdueReceivableCount} invoice(s) past due")" />
    </div>
    <div style="flex: 1; min-width: 200px;">
        <StatCard Title="Net Cash Flow (30 Days)" 
                  Value="@NetCashFlow30Days.ToString("C0")" 
                  Icon="@Icons.Material.Filled.Timeline" 
                  IconColor="@(NetCashFlow30Days >= 0 ? Color.Success : Color.Error)" 
                  Subtitle="Expected AR - AP" />
    </div>
</div>

<MudToggleGroup T="string" Value="@currentTab" ValueChanged="UpdateActiveTab" Outlined="true" Delimiters="true" CheckMark="false" Class="mb-4 flex-wrap">
    <MudToggleItem Value="@("receivables")" Text="Receivables" UnselectedIcon="@Icons.Material.Filled.AttachMoney" SelectedIcon="@Icons.Material.Filled.AttachMoney" />
    <MudToggleItem Value="@("payables")" Text="Payables" UnselectedIcon="@Icons.Material.Filled.MoneyOff" SelectedIcon="@Icons.Material.Filled.MoneyOff" />
    <MudToggleItem Value="@("history")" Text="History" UnselectedIcon="@Icons.Material.Filled.History" SelectedIcon="@Icons.Material.Filled.History" />
    <MudToggleItem Value="@("manage")" Text="Manage Bills" UnselectedIcon="@Icons.Material.Filled.NoteAdd" SelectedIcon="@Icons.Material.Filled.NoteAdd" />
    <MudToggleItem Value="@("export")" Text="Sage 50 Export" UnselectedIcon="@Icons.Material.Filled.AccountBalance" SelectedIcon="@Icons.Material.Filled.AccountBalance" />
</MudToggleGroup>

<div class="flex-grow-1 overflow-auto">
    @if (currentTab == "receivables")
    {
        <!-- RECEIVABLES (Money In - Invoices) -->
        <MudTable Items="@ReceivableItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" Filter="new Func<AccountingItem, bool>(FilterFuncReceivables)">
            <ToolBarContent>
                <MudText Typo="Typo.h6">Client Invoices</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchReceivables" Placeholder="Search Number, Client, Project..."
                    Adornment="Adornment.Start" Margin="Margin.Dense" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                    Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>Invoice #</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Date</MudTh></MudHidden>
                <MudTh>Client</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Project</MudTh></MudHidden>
                <MudTh>Total</MudTh>
                <MudTh>Balance</MudTh>
                <MudTh>Due Date</MudTh>
                <MudTh>Status</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Paid Date</MudTh></MudHidden>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><b>@context.Number</b></MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.Date.ToShortDateString()</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.ClientName</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Proj: @context.ProjectName</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.ProjectName</MudTd></MudHidden>
                <MudTd>@context.Total.ToString("C")</MudTd>
                <MudTd>
                    @if (context.Balance > 0)
                    {
                        <MudText Color="Color.Error"><b>@context.Balance.ToString("C")</b></MudText>
                    }
                    else
                    {
                        <MudText Color="Color.Success">Paid</MudText>
                    }
                </MudTd>
                <MudTd>
                    @if (context.DueDate.HasValue && context.DueDate < DateTime.Today && context.Balance > 0)
                    {
                        <div class="d-flex align-center gap-1">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" />
                            <MudText Color="Color.Error" Style="font-weight:bold;">@context.DueDate?.ToShortDateString()
                            </MudText>
                        </div>
                    }
                    else
                    {
                        @context.DueDate?.ToShortDateString()
                    }
                </MudTd>
                <MudTd>
                    <StatusChip Status="@context.Status" />
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@(context.DatePaid.HasValue ? context.DatePaid.Value.ToShortDateString() : "-")</MudTd></MudHidden>
                <MudTd>
                    <div class="d-flex align-center justify-end gap-1">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                        @if (context.Status != InvoiceStatus.Paid)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PriceCheck" OnClick="@(() => MarkPaid(context))">Mark Paid</MudButton>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
    else if (currentTab == "payables")
    {
        <!-- APPROVED OUTSTANDING PAYABLES (Money Out) -->
        <MudTable Items="@PayableItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" Filter="new Func<AccountingItem, bool>(FilterFuncPayables)" Class="mb-6">
            <ToolBarContent>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h6">Approved Outstanding Payables</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">
                        @Payables.Count
                    </MudChip>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="searchPayables" Placeholder="Search Approved Payables..." Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Type</MudTh></MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Number</MudTh></MudHidden>
                <MudTh>Entity</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Date</MudTh></MudHidden>
                <MudTh>Due Date</MudTh>
                <MudTh>Balance / Total</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Type)">@context.Type</MudChip>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.Number</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.Entity</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Type - @context.Number</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.Date.ToShortDateString()</MudTd></MudHidden>
                <MudTd>
                    @if (context.DueDate.HasValue && context.DueDate < DateTime.Today && context.Balance > 0)
                    {
                        <MudText Color="Color.Error">@context.DueDate?.ToShortDateString()</MudText>
                    }
                    else
                    {
                        @context.DueDate?.ToShortDateString()
                    }
                </MudTd>
                <MudTd>
                    @if (context.Balance > 0 && context.Balance < context.Total)
                    {
                        <MudText Color="Color.Warning"><b>@context.Balance.ToString("C")</b> / @context.Total.ToString("C")</MudText>
                    }
                    else if (context.Balance > 0)
                    {
                        <MudText Color="Color.Error"><b>@context.Balance.ToString("C")</b> / @context.Total.ToString("C")</MudText>
                    }
                    else
                    {
                        <MudText Color="Color.Success">Paid</MudText>
                    }
                </MudTd>
                <MudTd>
                    <div class="d-flex align-center justify-end gap-1">
                        @if (context.Type == "Recurring" || context.Type == "One-Time")
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                            @if (context.RecurringRecord != null && !string.IsNullOrEmpty(context.RecurringRecord.AttachmentPath))
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile" Href="@context.RecurringRecord.AttachmentPath" Target="_blank">
                                    Attachment
                                </MudButton>
                            }
                            else
                            {
                                <ApiFileUpload 
                                    Category="recurringcosts" 
                                    ContextId="@((context.OriginalItem as RecurringExpense)?.Id ?? "temp")" 
                                    OnUploadCompleted="@(results => HandleBillUploadCompleted(context, results))">
                                    <CustomContent>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload File
                                        </MudButton>
                                    </CustomContent>
                                </ApiFileUpload>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PriceCheck" OnClick="@(() => MarkRecurringPaid(context))">
                                Mark Paid
                            </MudButton>
                        }
                        else
                        {
                            @if (context.Type == "Bill" && context.OriginalItem is Bill bill && !string.IsNullOrEmpty(bill.PurchaseOrderId))
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Assignment" OnClick="@(() => ViewPo(bill.PurchaseOrderId))">View PO</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PriceCheck" OnClick="@(() => MarkPaid(context))">
                                Mark Paid
                            </MudButton>
                            @if (context.Type == "Bill" && context.OriginalItem is Bill unvoidedBill && unvoidedBill.Status != BillStatus.Void && unvoidedBill.AmountPaid == 0)
                            {
                                <MudTooltip Text="Void Bill">
                                    <MudIconButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Block" OnClick="@(() => VoidBill(context))" />
                                </MudTooltip>
                            }
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-3 text-muted">No outstanding payables.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>

        <!-- BILLS AWAITING APPROVAL -->
        <MudTable Items="@AwaitingApprovalBillItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" 
                  Filter="new Func<AccountingItem, bool>(FilterFuncAwaitingApproval)">
            <ToolBarContent>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" />
                    <MudText Typo="Typo.h6">Bills Awaiting Approval</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                        @AwaitingApprovalBills.Count
                    </MudChip>
                    @if (AwaitingApprovalBills.Any())
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">
                            Total: <b>@TotalAwaitingApproval.ToString("C")</b>
                        </MudText>
                    }
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="searchAwaitingApproval" Placeholder="Search Awaiting Approval..." 
                              Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Type</MudTh></MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Number</MudTh></MudHidden>
                <MudTh>Supplier / Entity</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Date</MudTh></MudHidden>
                <MudTh>Due Date</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Bill</MudChip>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.Number</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.Entity</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Number</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.Date.ToShortDateString()</MudTd></MudHidden>
                <MudTd>@(context.DueDate?.ToShortDateString() ?? "-")</MudTd>
                <MudTd>
                    <MudText Color="Color.Error"><b>@context.Total.ToString("C")</b></MudText>
                </MudTd>
                <MudTd>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Awaiting Approval</MudChip>
                </MudTd>
                <MudTd>
                    <div class="d-flex align-center justify-end gap-1">
                        @if (context.OriginalItem is Bill bill && !string.IsNullOrEmpty(bill.PurchaseOrderId))
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Assignment" OnClick="@(() => ViewPo(bill.PurchaseOrderId))">View PO</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                        @if (CanApproveBills)
                        {
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="@(() => ApproveBill(context))">
                                Approve
                            </MudButton>
                        }
                        else
                        {
                            <MudTooltip Text="Requires Purchases.ApproveBills permission">
                                <MudButton Variant="Variant.Filled" Color="Color.Default" Size="Size.Small" Disabled="true" StartIcon="@Icons.Material.Filled.CheckCircle">
                                    Approve
                                </MudButton>
                            </MudTooltip>
                        }
                        @if (context.OriginalItem is Bill unvoidedBill && unvoidedBill.AmountPaid == 0)
                        {
                            <MudTooltip Text="Void Bill">
                                <MudIconButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Block" OnClick="@(() => VoidBill(context))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-3 text-muted">No bills awaiting approval.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
    else if (currentTab == "history")
    {
        <!-- PAYABLES & VOID HISTORY -->
        <MudTable Items="@HistoryDisplayItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" Filter="new Func<AccountingItem, bool>(FilterFuncHistory)">
            <ToolBarContent>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.h6">History</MudText>
                    <MudChipSet T="string" SelectedValue="@historyFilter" SelectedValueChanged="OnHistoryFilterChanged" Variant="Variant.Filled">
                        <MudChip Value="@("all")" Color="Color.Default" Size="Size.Small">All (@(PaidPayables.Count + VoidedPayables.Count))</MudChip>
                        <MudChip Value="@("paid")" Color="Color.Success" Size="Size.Small">Paid (@PaidPayables.Count)</MudChip>
                        <MudChip Value="@("voided")" Color="Color.Error" Size="Size.Small">Voided (@VoidedPayables.Count)</MudChip>
                    </MudChipSet>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="searchHistory" Placeholder="Search..." Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Type)">Type</MudTableSortLabel></MudTh></MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Number)">Number</MudTableSortLabel></MudTh></MudHidden>
                <MudTh><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Entity)">Entity</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<AccountingItem, object>(x => x.DatePaid ?? x.Date)">Date</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Total)">Total</MudTableSortLabel></MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="text-align: right;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudTd>
                        <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Type)">@context.Type</MudChip>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.Number</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.Entity</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Type - @context.Number</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudTd>@context.DatePaid?.ToShortDateString()</MudTd>
                <MudTd>@context.Total.ToString("C")</MudTd>
                <MudTd>
                    @if (context.Status == BillStatus.Void)
                    {
                        var b = context.OriginalItem as Bill;
                        var voidTooltip = b != null && !string.IsNullOrWhiteSpace(b.VoidReason) 
                            ? $"Voided by {b.VoidedBy ?? "User"} on {b.VoidedAt?.ToLocalTime().ToString("d") ?? ""}: {b.VoidReason}" 
                            : "Voided";
                        <MudTooltip Text="@voidTooltip">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">Void</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <MudChip T="string" Size="Size.Small" Color="Color.Success">Paid</MudChip>
                    }
                </MudTd>
                <MudTd>
                    <div class="d-flex align-center justify-end gap-1">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
    }
    else if (currentTab == "manage")
    {
        <!-- ADD BILLS (Manage Actual Profiles) -->
        <AddBillsTab OnChanged="Refresh" />
    }
    else if (currentTab == "export")
    {
        <!-- SAGE 50 EXPORT -->
        <SageExportTab />
    }
</div>
</div>

@code {
    public class AccountingItem
    {
        public string Id { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty; // "Expense", "Bill", "Invoice"
        public string Number { get; set; } = string.Empty;
        public string Entity { get; set; } = string.Empty; // For Payables, this is who we pay.
        public string ClientName { get; set; } = string.Empty; // For Receivables
        public string ProjectName { get; set; } = string.Empty; // For Receivables
        public DateTime Date { get; set; }
        public DateTime? DueDate { get; set; }
        public decimal Total { get; set; }
        public decimal Balance { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime? DatePaid { get; set; }
        public object OriginalItem { get; set; } = default!;
        public RecurringBillRecord? RecurringRecord { get; set; }
    }

    private List<AccountingItem> Payables = []; // Outstanding Bills/Expenses
