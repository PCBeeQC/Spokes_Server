    private bool FilterFuncAwaitingApproval(AccountingItem element) => FilterFunc(element, searchAwaitingApproval);
    private bool FilterFuncPayables(AccountingItem element) => FilterFunc(element, searchPayables);
    private bool FilterFuncReceivables(AccountingItem element) => FilterFunc(element, searchReceivables);
    private bool FilterFuncHistory(AccountingItem element) => FilterFunc(element, searchHistory);

    private bool FilterFunc(AccountingItem element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.Number?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (element.Entity?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (element.ClientName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (element.ProjectName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        return false;
    }

    private async Task MarkRecurringPaid(AccountingItem item)
    {
        if (item.OriginalItem is not RecurringExpense expense || item.RecurringRecord == null) return;
        var actor = await UserService.GetEmployeeAsync();
        if (actor == null || !actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
        {
            Snackbar.Add("Missing Purchases.ManageBills permission to record recurring bill payments.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters<RecordPaymentDialog>
        {
            { x => x.Message, $"Record payment for recurring bill '{expense.Name}'?" },
            { x => x.MaxAmount, item.Balance },
            { x => x.ExistingPayments, item.RecurringRecord.Payments }
        };
        var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Payment", parameters);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: PaymentRecord payment })
        {
            actor = await UserService.GetEmployeeAsync();
            if (actor == null || !actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false)) return;
            var userName = actor.FullName ?? actor.Email ?? "User";
            item.RecurringRecord.Payments.Add(payment);
            if (item.RecurringRecord.BalanceDue <= 0)
            {
                AccountingService.MarkRecurringBillRecordPaid(expense, item.RecurringRecord, payment.Date, payment.BankGlAccountCode, userName, actor);
            }
            else
            {
                DocumentHistoryHelper.RecordPaymentAction(
                    item.RecurringRecord,
                    DocumentHistoryActions.PaymentRecorded,
                    item.RecurringRecord.Status,
                    item.RecurringRecord.Status,
                    $"Partial payment of {payment.Amount:C2} recorded on {payment.Date:yyyy-MM-dd}",
                    userName);
                AccountingService.SaveRecurringExpense(expense, actor);
            }

            Snackbar.Add($"Payment of {payment.Amount:C} recorded", Severity.Success);
            Refresh();
        }
    }



    private async Task HandleBillUploadCompleted(AccountingItem item, List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0 || item.OriginalItem is not RecurringExpense expense || item.RecurringRecord == null) return;
        var actor = await UserService.GetEmployeeAsync();
        if (actor == null || !actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
        {
            Snackbar.Add("Missing Purchases.ManageBills permission to attach recurring bill files.", Severity.Error);
            return;
        }
        
        try
        {
            var result = results.First();
            item.RecurringRecord.AttachmentPath = result.FilePath;
            item.RecurringRecord.AttachmentName = result.FileName;
            
            AccountingService.SaveRecurringExpense(expense, actor);
            Snackbar.Add("File uploaded successfully", Severity.Success);
            Refresh();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
    }

    [SupplyParameterFromQuery] public string? Tab { get; set; }
    [SupplyParameterFromQuery] public string? SubTab { get; set; }
    private string currentTab = "receivables";
    private string? _effectiveSubTab;

    private int ActiveTabIndex => Math.Max(0, AvailableTabs.ToList().IndexOf(currentTab));

    private void OnTabIndexChanged(int index)
    {
        if (index >= 0 && index < AvailableTabs.Count)
        {
            UpdateActiveTab(AvailableTabs[index]);
        }
    }

    protected override void OnParametersSet()
    {
        _effectiveSubTab = SubTab;

        if (!string.IsNullOrEmpty(Tab))
        {
            var lower = Tab.ToLowerInvariant();
            if (lower == "manage" || lower == "add-bills")
            {
                try
                {
                    Nav.NavigateTo("/business/operating-costs?tab=recurring", replace: true);
                }
                catch (Microsoft.AspNetCore.Components.NavigationException)
                {
                }
                return;
            }

            if (lower is "migration" or "cutover")
            {
                currentTab = "ledger";
                _effectiveSubTab = "migration";
                return;
            }

            var resolved = lower switch
            {
                "receivables" => "receivables",
                "payables" => "payables",
                "transactions" or "other" or "direct" or "directtransactions" => "transactions",
                "payroll" or "payruns" => "payroll",
                "reconciliation" or "bankreconciliation" => "reconciliation",
                "taxes" or "salestax" => "taxes",
                "ledger" or "gl" or "generalledger" => "ledger",
                "cpa" or "accountant" or "export" => "cpa",
                "history" => "history",
                _ => "receivables"
            };
            if (resolved == "payroll" && _isInitialized && !_canReadPayroll)
            {
                resolved = "receivables";
            }
            currentTab = resolved;
        }
    }

    private bool _isDisposed;

    public void Dispose()
    {
        _isDisposed = true;
    }

    private void UpdateActiveTab(string tabName)
    {
        if (_isDisposed) return;

        currentTab = tabName;

        if (!Nav.Uri.Contains("/business/accounting", StringComparison.OrdinalIgnoreCase))
            return;

        try
        {
            var url = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                ["tab"] = tabName,
                ["subtab"] = tabName == "ledger" ? SubTab : null
            });
            Nav.NavigateTo(url, replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
        }
    }
}

