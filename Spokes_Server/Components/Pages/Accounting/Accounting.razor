    private void Refresh()
    {
        Payables.Clear();
        AwaitingApprovalBills.Clear();
        PaidPayables.Clear();
        VoidedPayables.Clear();
        Receivables.Clear();

        // 1. Expense Reports
        var reports = Db.ExpenseReports.GetAll().Where(x => x.Status != ExpenseReportStatus.Draft).ToList();
        foreach (var r in reports)
        {
            var isPaid = r.DatePaid.HasValue || r.Status == ExpenseReportStatus.Paid;
            var item = new AccountingItem
                {
                    Id = r.Id,
                    Type = "Expense",
                    Number = r.ReportNumber,
                    Entity = r.EmployeeName,
                    Date = r.DateCreated,
                    DueDate = r.DateSubmitted,
                    Total = r.TotalAmount,
                    Balance = isPaid ? 0 : r.TotalAmount,
                    Status = isPaid ? BillStatus.Paid : BillStatus.Unpaid,
                    DatePaid = r.DatePaid ?? r.DateSubmitted ?? r.DateCreated,
                    OriginalItem = r
                };

            if (isPaid) PaidPayables.Add(item); else Payables.Add(item);
        }

        // 2. Bills (and POs)
        var bills = Db.Bills.GetAll();
        foreach (var b in bills)
        {
            var isPo = !string.IsNullOrEmpty(b.PurchaseOrderId);

            if (b.Status == BillStatus.Void)
            {
                VoidedPayables.Add(new AccountingItem
                {
                    Id = b.Id,
                    Type = "Bill",
                    Number = string.IsNullOrWhiteSpace(b.Description) ? (isPo ? $"Bill for PO {b.PurchaseOrderId}" : "Bill") : b.Description,
                    Entity = b.SupplierName,
                    Date = b.Date,
                    DueDate = b.DueDate,
                    Total = b.Amount,
                    Balance = 0,
                    Status = BillStatus.Void,
                    DatePaid = b.VoidedAt?.ToLocalTime().Date ?? b.Date,
                    OriginalItem = b
                });
                continue;
            }

            var isPaid = b.BalanceDue <= 0 || b.Status == BillStatus.Paid;

            var item = new AccountingItem
                {
                    Id = b.Id,
                    Type = "Bill", // Always Bill, avoids PO confusion
                    Number = string.IsNullOrWhiteSpace(b.Description) ? (isPo ? $"Bill for PO {b.PurchaseOrderId}" : "Bill") : b.Description,
                    Entity = b.SupplierName,
                    Date = b.Date,
                    DueDate = b.DueDate,
                    Total = b.Amount,
                    Balance = b.BalanceDue,
                    Status = isPaid ? BillStatus.Paid : (b.AmountPaid > 0 ? "Partially Paid" : b.Status),
                    DatePaid = b.DatePaid ?? b.Date,
                    OriginalItem = b
                };

            if (isPaid) 
            {
                PaidPayables.Add(item);
            }
            else if (b.Status == BillStatus.AwaitingApproval)
            {
                AwaitingApprovalBills.Add(item);
            }
            else 
            {
                Payables.Add(item);
            }
        }

        // 3. Recurring Expenses (All Unpaid Actual Bills for Payables List)
        var allRecurring = Db.RecurringExpenses.GetAll().Where(e => !e.IsEstimate).ToList();

        foreach (var re in allRecurring)
        {
            var unpaidRecords = re.History.Where(h => h.BalanceDue > 0).ToList();
            foreach (var record in unpaidRecords)
            {
                var typeStr = re.Frequency == RecurringExpenseFrequency.OneTime ? "One-Time" : "Recurring";
                var entityStr = string.IsNullOrEmpty(re.Supplier) ? (typeStr == "One-Time" ? "One-Time Expense" : "Recurring Bill") : re.Supplier;
                
                Payables.Add(new AccountingItem
                {
                    Id = record.Id,
                    Type = typeStr,
                    Number = re.Name,
                    Entity = entityStr,
                    Date = record.Date,
                    DueDate = record.DueDate ?? record.Date,
                    Total = record.Amount,
                    Balance = record.BalanceDue,
                    Status = record.AmountPaid > 0 ? "Partially Paid" : BillStatus.Unpaid,
                    OriginalItem = re,
                    RecurringRecord = record
                });
            }
        }

        // 5. PAID HISTORY from Recurring & One-Time Expenses
        foreach (var re in allRecurring)
        {
            foreach (var historyItem in re.History.Where(h => h.BalanceDue <= 0))
            {
                PaidPayables.Add(new AccountingItem
                    {
                        Id = historyItem.Id,
                        Type = re.Frequency == RecurringExpenseFrequency.OneTime ? "One-Time" : "Recurring",
                        Number = re.Name,
                        Entity = string.IsNullOrEmpty(re.Supplier) ? (re.Frequency == RecurringExpenseFrequency.OneTime ? "One-Time Expense" :
                    "Recurring Bill") : re.Supplier,
                        Date = historyItem.Date,
                        DueDate = historyItem.Date,
                        Total = historyItem.Amount,
                        Balance = 0,
                        Status = BillStatus.Paid,
                        DatePaid = historyItem.DatePaid ?? historyItem.Date,
                        OriginalItem = re, // Identify as the parent expense
                        RecurringRecord = historyItem
                    });
            }
        }

        // 6. Invoices (Receivables)
        var invoices = Db.Invoices.GetAll();
        foreach (var inv in invoices)
        {
            if (inv.Status == InvoiceStatus.Draft || inv.Status == InvoiceStatus.Void) continue;

            var proj = Db.Projects.GetById(inv.ProjectId);

            Receivables.Add(new AccountingItem
                {
                    Id = inv.Id,
                    Type = "Invoice",
                    Number = inv.InvoiceNumber,
                    Entity = proj?.Client?.BusinessName ?? "Unknown", // Fallback for Search
                    ClientName = proj?.Client?.BusinessName ?? "-",
                    ProjectName = proj?.DisplayName ?? "-",
                    Date = inv.Date,
                    DueDate = inv.DueDate,
                    Total = inv.GrandTotal,
                    Balance = inv.BalanceDue,
                    Status = inv.BalanceDue <= 0 ? InvoiceStatus.Paid : (inv.AmountPaid > 0 ? InvoiceStatus.Partial : inv.Status),
                    DatePaid = inv.DatePaid ?? (inv.BalanceDue <= 0 ? inv.Date : null),
                    OriginalItem = inv
                });
        }

        // 7. Commissions from Ledger
        var ledgerRecords = Db.CommissionLedgerRecords.GetAll();
        foreach (var record in ledgerRecords)
        {
            var isPaid = record.Status == CommissionStatus.Paid || record.DatePaid.HasValue;
            var proj = Db.Projects.GetById(record.ProjectId);
            
            var item = new AccountingItem
            {
                Id = record.Id,
                Type = record.Status == CommissionStatus.Clawback ? "Clawback" : "Commission",
                Number = proj?.ProjectNumber ?? "-",
                Entity = record.BeneficiaryName,
                ClientName = proj?.Client?.BusinessName ?? "-",
                ProjectName = proj?.DisplayName ?? "-",
                Date = record.DateGenerated,
                DueDate = record.DateGenerated,
                Total = record.CommissionAmount,
                Balance = isPaid ? 0 : record.CommissionAmount,
                Status = record.Status,
                DatePaid = record.DatePaid ?? record.DateGenerated,
                OriginalItem = record
            };
            
            if (isPaid) PaidPayables.Add(item); else Payables.Add(item);
        }

        ComputeDashboardMetrics();
    }

    private void ComputeDashboardMetrics()
    {
        TotalOutstandingPayable = Payables.Sum(x => x.Balance);
        TotalAwaitingApproval = AwaitingApprovalBills.Sum(x => x.Balance);
        
        var duePayables = Payables.Where(x => x.DueDate.HasValue && x.DueDate.Value.Date <= DateTime.Today.Date).ToList();
        DuePastDuePayable = duePayables.Sum(x => x.Balance);
        DuePastDuePayableCount = duePayables.Count;

        OutstandingReceivable = Receivables.Where(x => x.Balance > 0).Sum(x => x.Balance);

        var overdueReceivables = Receivables.Where(x => x.Balance > 0 && x.DueDate.HasValue && x.DueDate.Value.Date < DateTime.Today.Date).ToList();
        OverdueReceivable = overdueReceivables.Sum(x => x.Balance);
        OverdueReceivableCount = overdueReceivables.Count;

        var thirtyDaysFromNow = DateTime.Today.AddDays(30);
        var comingAR30Days = Receivables.Where(x => x.Balance > 0 && (!x.DueDate.HasValue || x.DueDate.Value.Date <= thirtyDaysFromNow)).Sum(x => x.Balance);
        var comingAP30Days = Payables.Where(x => x.Balance > 0 && (!x.DueDate.HasValue || x.DueDate.Value.Date <= thirtyDaysFromNow)).Sum(x => x.Balance);
        NetCashFlow30Days = comingAR30Days - comingAP30Days;

        // Compute Weekly Chart (Next 4 Weeks)
        var today = DateTime.Today;
        CashFlowLabels = new string[4];
        var arData = new double[4];
        var apData = new double[4];

        for (int i = 0; i < 4; i++)
        {
            var weekStart = today.AddDays(i * 7);
            var weekEnd = weekStart.AddDays(7).AddSeconds(-1);
            
            if (i == 0) CashFlowLabels[i] = "This Week";
            else if (i == 1) CashFlowLabels[i] = "Next Week";
            else CashFlowLabels[i] = $"In {i} Weeks";

            // If it's the first week, we also include everything past due
            var arSum = Receivables.Where(x => x.Balance > 0 && x.DueDate.HasValue && 
                (i == 0 ? x.DueDate.Value <= weekEnd : (x.DueDate.Value > weekStart && x.DueDate.Value <= weekEnd))).Sum(x => x.Balance);
                
            var apSum = Payables.Where(x => x.Balance > 0 && x.DueDate.HasValue && 
                (i == 0 ? x.DueDate.Value <= weekEnd : (x.DueDate.Value > weekStart && x.DueDate.Value <= weekEnd))).Sum(x => x.Balance);

            arData[i] = (double)arSum;
            apData[i] = (double)apSum;
        }

        CashFlowSeries =
        [
            new ChartSeries<double> { Name = "Receivables (AR)", Data = arData },
            new ChartSeries<double> { Name = "Payables (AP)", Data = apData }
        ];
    }

