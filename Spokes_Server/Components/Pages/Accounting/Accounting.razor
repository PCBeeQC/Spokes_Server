@page "/business/accounting"
@attribute [Authorize(Policy = AppPermissions.Finance.AccessAccounting)]
@implements IDisposable
<PageTitle>Accounting Dashboard</PageTitle>
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Common
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Components.Pages.Accounting.Expenses
@using Spokes_Server.Components.Pages.Projects
@using Spokes_Server.Components.Pages.Accounting.Tabs
@using Spokes_Server.Components.Pages.Accounting.BusinessExpenses
@using Spokes_Server.Components.Pages.HR
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Dialogs.HR
@using Spokes_Server.Components.Shared
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.HR
@using Spokes_Server.Core.Services.Projects
@using Spokes_Server.Core.Services.Security
@inject Database Db
@inject IAccountingService AccountingService
@inject IPayrollCalculationEngine PayrollEngine
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject UserService UserService
@inject FileUrlSigner FileUrls

<MudContainer MaxWidth="MaxWidth.False" Class="pa-4 px-md-6 h-100 d-flex flex-column" Style="min-height: 0;">
    <div class="d-flex align-center justify-space-between flex-wrap gap-2 mt-2 mb-3 flex-shrink-0">
        <div>
            <MudText Typo="Typo.h4">@BizLoc["Accounting & Invoicing"]</MudText>
            <MudText Typo="Typo.body2" Color="Color.Secondary">@BizLoc["Receivables, payables, payroll, bank reconciliation, tax filings, and general ledger."]</MudText>
        </div>
    </div>

    <SpokesTabs ActivePanelIndex="@ActiveTabIndex"
                ActivePanelIndexChanged="OnTabIndexChanged"
                Class="flex-grow-1"
                Style="min-height: 0;"
                TabPanelsClass="pa-4 flex-grow-1 overflow-auto">
        <MudTabPanel Text="@BizLoc["Receivables"]" Icon="@Icons.Material.Filled.AttachMoney">
        <!-- RECEIVABLES (Money In - Invoices) -->
        <MudTable Items="@FilteredReceivableItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" Filter="new Func<AccountingItem, bool>(FilterFuncReceivables)">
            <ToolBarContent>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.h6">@BizLoc["Client Invoices"]</MudText>
                    <MudChipSet T="string" SelectedValue="@receivablesStatusFilter" SelectedValueChanged="OnReceivablesFilterChanged" Variant="Variant.Filled">
                        <MudChip Value="@("open")" Color="Color.Primary" Size="Size.Small">@BizLoc["Open"] (@Receivables.Count(r => r.Balance > 0 && r.Status != InvoiceStatus.Draft))</MudChip>
                        <MudChip Value="@("overdue")" Color="Color.Error" Size="Size.Small">@BizLoc["Overdue"] (@Receivables.Count(r => r.Balance > 0 && r.DueDate < DateTime.Today && r.Status != InvoiceStatus.Draft))</MudChip>
                        <MudChip Value="@("paid")" Color="Color.Success" Size="Size.Small">@BizLoc["Paid / Closed"] (@Receivables.Count(r => InvoiceStatus.IsSettled(r.Status) || (r.Balance <= 0 && r.Status != InvoiceStatus.Draft)))</MudChip>
                        <MudChip Value="@("draft")" Color="Color.Default" Size="Size.Small">@BizLoc["Draft"] (@Receivables.Count(r => r.Status == InvoiceStatus.Draft))</MudChip>
                        <MudChip Value="@("all")" Color="Color.Info" Size="Size.Small">@BizLoc["All"] (@Receivables.Count)</MudChip>
                    </MudChipSet>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="searchReceivables" Placeholder="Search Number, Client, Project..."
                    Adornment="Adornment.Start" Margin="Margin.Dense" Variant="Variant.Outlined" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium"
                    Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh Style="width: 140px; white-space: nowrap;">Invoice #</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 110px; white-space: nowrap;">Date</MudTh></MudHidden>
                <MudTh>Client</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh>Project</MudTh></MudHidden>
                <MudTh Style="width: 110px; white-space: nowrap;">Total</MudTh>
                <MudTh Style="width: 110px; white-space: nowrap;">Balance</MudTh>
                <MudTh Style="min-width: 150px; width: 150px; white-space: nowrap;">Due Date</MudTh>
                <MudTh Style="width: 100px; white-space: nowrap;">Status</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 110px; white-space: nowrap;">Paid Date</MudTh></MudHidden>
                <MudTh Style="text-align: right; min-width: 220px; width: 220px; white-space: nowrap;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd Style="white-space: nowrap;"><b>@context.Number</b></MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd Style="white-space: nowrap;">@context.Date.ToShortDateString()</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.ClientName</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">Proj: @context.ProjectName</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd>@context.ProjectName</MudTd></MudHidden>
                <MudTd Style="white-space: nowrap;">@context.Total.ToString("C")</MudTd>
                <MudTd Style="white-space: nowrap;">
                    @if (context.Balance > 0)
                    {
                        <MudText Color="Color.Error"><b>@context.Balance.ToString("C")</b></MudText>
                    }
                    else if (context.Status == InvoiceStatus.WrittenOff)
                    {
                        <MudText Color="Color.Secondary">@BizLoc["Written Off"]</MudText>
                    }
                    else
                    {
                        <MudText Color="Color.Success">@BizLoc["Paid"]</MudText>
                    }
                </MudTd>
                <MudTd Style="white-space: nowrap;">
                    @if (context.DueDate.HasValue && context.DueDate < DateTime.Today && context.Balance > 0)
                    {
                        <div class="d-flex align-center gap-1" style="white-space: nowrap;">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Class="flex-shrink-0" />
                            <MudText Color="Color.Error" Style="font-weight:bold; white-space: nowrap;">@context.DueDate?.ToShortDateString()
                            </MudText>
                        </div>
                    }
                    else
                    {
                        @context.DueDate?.ToShortDateString()
                    }
                </MudTd>
                <MudTd Style="white-space: nowrap;">
                    <div class="d-flex align-center gap-1">
                        <StatusChip Status="@context.Status" />
                        @if (context.HasWriteOffs)
                        {
                            <MudTooltip Text="@context.WriteOffTooltip">
                                <MudIcon Icon="@Icons.Material.Filled.Balance" Size="Size.Small" Color="Color.Warning" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd Style="white-space: nowrap;">@(context.DatePaid.HasValue ? context.DatePaid.Value.ToShortDateString() : "-")</MudTd></MudHidden>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    <div class="d-flex align-center justify-end gap-2" style="white-space: nowrap;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">@Loc["View"]</MudButton>
                        @if (_canWriteAccounting && !InvoiceStatus.IsSettled(context.Status) && context.Status != InvoiceStatus.Draft && context.Balance > 0)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PriceCheck" OnClick="@(() => MarkPaid(context))">@BizLoc["Mark Paid"]</MudButton>
                            <MudTooltip Text="@BizLoc["Close / Write Off Balance"]">
                                <MudIconButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Balance" OnClick="@(() => CloseBalance(context))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["Payables"]" Icon="@Icons.Material.Filled.MoneyOff">
        @if (GovernmentPayableItems.Count > 0)
        {
            <!-- GOVERNMENT & PAYROLL REMITTANCES DUE -->
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4" Style="border-left: 4px solid var(--mud-palette-warning);">
                <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                    <div class="d-flex align-center gap-2">
                        <MudIcon Icon="@Icons.Material.Filled.AccountBalance" Color="Color.Warning" />
                        <MudText Typo="Typo.h6">@BizLoc["Government & Payroll Obligations Due"]</MudText>
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                            @GovernmentPayableItems.Sum(g => g.Balance).ToString("C2")
                        </MudChip>
                    </div>
                </div>
                <MudTable Items="@GovernmentPayableItems" Dense="true" Hover="true" Elevation="0" Outlined="true">
                    <HeaderContent>
                        <MudTh Style="width: 140px;">@BizLoc["Type"]</MudTh>
                        <MudTh Style="width: 150px;">@BizLoc["Reference"]</MudTh>
                        <MudTh>@BizLoc["Authority / Payee"]</MudTh>
                        <MudTh Style="width: 130px;">@BizLoc["Due Date"]</MudTh>
                        <MudTh Style="width: 140px; text-align: right;">@BizLoc["Amount Due"]</MudTh>
                        <MudTh Style="width: 240px; text-align: right;">@Loc["Actions"]</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="gov">
                        <MudTd>
                            <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(gov.Type)">@gov.Type</MudChip>
                        </MudTd>
                        <MudTd><b>@gov.Number</b></MudTd>
                        <MudTd>@gov.Entity</MudTd>
                        <MudTd>@(gov.DueDate?.ToString("yyyy-MM-dd") ?? "-")</MudTd>
                        <MudTd Style="text-align: right; font-weight: 700; color: var(--mud-palette-warning);">@gov.Balance.ToString("C2")</MudTd>
                        <MudTd Style="text-align: right;">
                            <div class="d-flex justify-end gap-2">
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility"
                                           OnClick="@(() => OpenItem(gov))">@Loc["View"]</MudButton>
                                @if (CanMarkItemPaid(gov))
                                {
                                    <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PriceCheck"
                                               OnClick="@(() => MarkPaid(gov))">@BizLoc["Mark Paid / Remitted"]</MudButton>
                                }
                            </div>
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            </MudPaper>
        }

        <!-- APPROVED OUTSTANDING PAYABLES (Money Out) -->
        <MudTable Items="@PayableItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" Filter="new Func<AccountingItem, bool>(FilterFuncPayables)" Class="mb-6">
            <ToolBarContent>
                <div class="d-flex align-center gap-2">
                    <MudText Typo="Typo.h6">Approved Outstanding Payables</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Filled">
                        @Payables.Count
                    </MudChip>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="searchPayables" Placeholder="Search Approved Payables..." Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 100px; white-space: nowrap;">Type</MudTh></MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 130px; white-space: nowrap;">Number</MudTh></MudHidden>
                <MudTh>Entity</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 110px; white-space: nowrap;">Date</MudTh></MudHidden>
                <MudTh Style="min-width: 150px; width: 150px; white-space: nowrap;">Due Date</MudTh>
                <MudTh Style="width: 150px; white-space: nowrap;">Balance / Total</MudTh>
                <MudTh Style="text-align: right; min-width: 260px; width: 260px; white-space: nowrap;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudTd Style="white-space: nowrap;">
                        <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Type)">@context.Type</MudChip>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd Style="white-space: nowrap;">@context.Number</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.Entity</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Type - @context.Number</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd Style="white-space: nowrap;">@context.Date.ToShortDateString()</MudTd></MudHidden>
                <MudTd Style="white-space: nowrap;">
                    @if (context.DueDate.HasValue && context.DueDate < DateTime.Today && context.Balance > 0)
                    {
                        <div class="d-flex align-center gap-1" style="white-space: nowrap;">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Class="flex-shrink-0" />
                            <MudText Color="Color.Error" Style="font-weight:bold; white-space: nowrap;">@context.DueDate?.ToShortDateString()</MudText>
                        </div>
                    }
                    else
                    {
                        @context.DueDate?.ToShortDateString()
                    }
                </MudTd>
                <MudTd Style="white-space: nowrap;">
                    @if (context.Balance > 0 && context.Balance < context.Total)
                    {
                        <MudText Color="Color.Warning"><b>@context.Balance.ToString("C")</b> / @context.Total.ToString("C")</MudText>
                    }
                    else if (context.Balance > 0)
                    {
                        <MudText Color="Color.Error"><b>@context.Balance.ToString("C")</b> / @context.Total.ToString("C")</MudText>
                    }
                    else
                    {
                        <MudText Color="Color.Success">Paid</MudText>
                    }
                </MudTd>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    <div class="d-flex align-center justify-end gap-2" style="white-space: nowrap;">
                        @if (context.Type == "Recurring" || context.Type == "One-Time")
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                            @if (context.RecurringRecord != null && !string.IsNullOrEmpty(context.RecurringRecord.AttachmentPath))
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.AttachFile" Href="@FileUrls.SignUrl(context.RecurringRecord.AttachmentPath)" Target="_blank">
                                    Attachment
                                </MudButton>
                            }
                            else if (_canManageBills)
                            {
                                <ApiFileUpload 
                                    Category="recurringcosts" 
                                    ContextId="@((context.OriginalItem as RecurringExpense)?.Id ?? "temp")" 
                                    OnUploadCompleted="@(results => HandleBillUploadCompleted(context, results))">
                                    <CustomContent>
                                        <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload">
                                            Upload File
                                        </MudButton>
                                    </CustomContent>
                                </ApiFileUpload>
                            }
                            @if (_canManageBills)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PriceCheck" OnClick="@(() => MarkRecurringPaid(context))">
                                    @BizLoc["Mark Paid"]
                                </MudButton>
                                @if (context.Balance > 0)
                                {
                                    <MudTooltip Text="@BizLoc["Close / Write Off Balance"]">
                                        <MudIconButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Balance" OnClick="@(() => CloseBalance(context))" />
                                    </MudTooltip>
                                }
                            }
                        }
                        else
                        {
                            @if (context.Type == "Bill" && context.OriginalItem is Bill bill && !string.IsNullOrEmpty(bill.PurchaseOrderId))
                            {
                                <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Assignment" OnClick="@(() => ViewPo(bill.PurchaseOrderId))">View PO</MudButton>
                            }
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">@Loc["View"]</MudButton>
                            @if (CanMarkItemPaid(context))
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.PriceCheck" OnClick="@(() => MarkPaid(context))">
                                    @BizLoc["Mark Paid"]
                                </MudButton>
                                @if (context.Type == "Bill" && context.Balance > 0)
                                {
                                    <MudTooltip Text="@BizLoc["Close / Write Off Balance"]">
                                        <MudIconButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small" Icon="@Icons.Material.Filled.Balance" OnClick="@(() => CloseBalance(context))" />
                                    </MudTooltip>
                                }
                            }
                            @if (_canManageBills && context.Type == "Bill" && context.OriginalItem is Bill unvoidedBill && unvoidedBill.Status != BillStatus.Void && unvoidedBill.AmountPaid == 0 && !unvoidedBill.HasWriteOffs)
                            {
                                <MudTooltip Text="Void Bill">
                                    <MudIconButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Block" OnClick="@(() => VoidBill(context))" />
                                </MudTooltip>
                            }
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-3 text-muted">No outstanding payables.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>

        <!-- BILLS AWAITING APPROVAL -->
        <MudTable Items="@AwaitingApprovalBillItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" 
                  Filter="new Func<AccountingItem, bool>(FilterFuncAwaitingApproval)">
            <ToolBarContent>
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.PendingActions" Color="Color.Warning" />
                    <MudText Typo="Typo.h6">Bills Awaiting Approval</MudText>
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning" Variant="Variant.Filled">
                        @AwaitingApprovalBills.Count
                    </MudChip>
                    @if (AwaitingApprovalBills.Any())
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-2">
                            Total: <b>@TotalAwaitingApproval.ToString("C")</b>
                        </MudText>
                    }
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="searchAwaitingApproval" Placeholder="Search Awaiting Approval..." 
                              Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                              AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0" />
            </ToolBarContent>
            <HeaderContent>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 100px; white-space: nowrap;">Type</MudTh></MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 130px; white-space: nowrap;">Number</MudTh></MudHidden>
                <MudTh>Supplier / Entity</MudTh>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 110px; white-space: nowrap;">Date</MudTh></MudHidden>
                <MudTh Style="min-width: 150px; width: 150px; white-space: nowrap;">Due Date</MudTh>
                <MudTh Style="width: 120px; white-space: nowrap;">Amount</MudTh>
                <MudTh Style="width: 140px; white-space: nowrap;">Status</MudTh>
                <MudTh Style="text-align: right; min-width: 250px; width: 250px; white-space: nowrap;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudTd Style="white-space: nowrap;">
                        <MudChip T="string" Size="Size.Small" Color="Color.Warning">Bill</MudChip>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd Style="white-space: nowrap;">@context.Number</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.Entity</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Number</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd Style="white-space: nowrap;">@context.Date.ToShortDateString()</MudTd></MudHidden>
                <MudTd Style="white-space: nowrap;">
                    @if (context.DueDate.HasValue && context.DueDate < DateTime.Today)
                    {
                        <div class="d-flex align-center gap-1" style="white-space: nowrap;">
                            <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Error" Size="Size.Small" Class="flex-shrink-0" />
                            <MudText Color="Color.Error" Style="font-weight:bold; white-space: nowrap;">@context.DueDate?.ToShortDateString()</MudText>
                        </div>
                    }
                    else
                    {
                        @(context.DueDate?.ToShortDateString() ?? "-")
                    }
                </MudTd>
                <MudTd Style="white-space: nowrap;">
                    <MudText Color="Color.Error"><b>@context.Total.ToString("C")</b></MudText>
                </MudTd>
                <MudTd Style="white-space: nowrap;">
                    <MudChip T="string" Size="Size.Small" Color="Color.Warning">Awaiting Approval</MudChip>
                </MudTd>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    <div class="d-flex align-center justify-end gap-2" style="white-space: nowrap;">
                        @if (context.OriginalItem is Bill bill && !string.IsNullOrEmpty(bill.PurchaseOrderId))
                        {
                            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Assignment" OnClick="@(() => ViewPo(bill.PurchaseOrderId))">View PO</MudButton>
                        }
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                        @if (CanApproveBills)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Success" Size="Size.Small" StartIcon="@Icons.Material.Filled.CheckCircle" OnClick="@(() => ApproveBill(context))">
                                Approve
                            </MudButton>
                        }
                        else
                        {
                            <MudTooltip Text="Requires Purchases.ApproveBills permission">
                                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" Disabled="true" StartIcon="@Icons.Material.Filled.CheckCircle">
                                    Approve
                                </MudButton>
                            </MudTooltip>
                        }
                        @if (_canManageBills && context.OriginalItem is Bill unvoidedBill && unvoidedBill.AmountPaid == 0)
                        {
                            <MudTooltip Text="Void Bill">
                                <MudIconButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" Icon="@Icons.Material.Filled.Block" OnClick="@(() => VoidBill(context))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="py-3 text-muted">No bills awaiting approval.</MudText>
            </NoRecordsContent>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["Other Transactions"]" Icon="@Icons.Material.Filled.SwapHoriz">
            <DirectTransactionsTab OnTransactionChanged="Refresh" />
        </MudTabPanel>

        @if (_canReadPayroll)
        {
            <MudTabPanel Text="@BizLoc["Payroll & Pay Runs"]" Icon="@Icons.Material.Filled.Payments">
                <PayrollTab />
            </MudTabPanel>
        }

        <MudTabPanel Text="@BizLoc["Bank Reconciliation"]" Icon="@Icons.Material.Filled.FactCheck">
            <BankReconciliationTab />
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["Sales Tax Filing"]" Icon="@Icons.Material.Filled.RequestQuote">
            <TaxRemittanceTab />
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["General Ledger"]" Icon="@Icons.Material.Filled.AccountBalance">
            <GeneralLedgerAndExportTab InitialSubTab="@(_effectiveSubTab)" />
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["CPA & Accountant"]" Icon="@Icons.Material.Filled.WorkHistory">
            <AccountantCpaTab />
        </MudTabPanel>

        <MudTabPanel Text="@BizLoc["History"]" Icon="@Icons.Material.Filled.History">
        <!-- PAYABLES & VOID HISTORY -->
        <MudTable Items="@HistoryDisplayItems" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" Filter="new Func<AccountingItem, bool>(FilterFuncHistory)">
            <ToolBarContent>
                <div class="d-flex align-center gap-2 flex-wrap">
                    <MudText Typo="Typo.h6">History</MudText>
                    <MudChipSet T="string" SelectedValue="@historyFilter" SelectedValueChanged="OnHistoryFilterChanged" Variant="Variant.Filled">
                        <MudChip Value="@("all")" Color="Color.Default" Size="Size.Small">@BizLoc["All"] (@(PaidPayables.Count + WrittenOffPayables.Count + VoidedPayables.Count))</MudChip>
                        <MudChip Value="@("paid")" Color="Color.Success" Size="Size.Small">@BizLoc["Paid"] (@PaidPayables.Count)</MudChip>
                        <MudChip Value="@("writtenoff")" Color="Color.Secondary" Size="Size.Small">@BizLoc["Written Off"] (@WrittenOffPayables.Count)</MudChip>
                        <MudChip Value="@("voided")" Color="Color.Error" Size="Size.Small">@BizLoc["Voided"] (@VoidedPayables.Count)</MudChip>
                    </MudChipSet>
                </div>
                <MudSpacer />
                <MudTextField @bind-Value="searchHistory" Placeholder="Search..." Adornment="Adornment.Start" Variant="Variant.Outlined" Margin="Margin.Dense"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 100px; white-space: nowrap;"><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Type)">Type</MudTableSortLabel></MudTh></MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTh Style="width: 130px; white-space: nowrap;"><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Number)">Number</MudTableSortLabel></MudTh></MudHidden>
                <MudTh><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Entity)">Entity</MudTableSortLabel></MudTh>
                <MudTh Style="width: 120px; white-space: nowrap;"><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<AccountingItem, object>(x => x.DatePaid ?? x.Date)">Date</MudTableSortLabel></MudTh>
                <MudTh Style="width: 120px; white-space: nowrap;"><MudTableSortLabel SortBy="new Func<AccountingItem, object>(x => x.Total)">Total</MudTableSortLabel></MudTh>
                <MudTh Style="width: 110px; white-space: nowrap;">Status</MudTh>
                <MudTh Style="text-align: right; min-width: 120px; width: 120px; white-space: nowrap;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudTd Style="white-space: nowrap;">
                        <MudChip T="string" Size="Size.Small" Color="@GetTypeColor(context.Type)">@context.Type</MudChip>
                    </MudTd>
                </MudHidden>
                <MudHidden Breakpoint="Breakpoint.SmAndDown"><MudTd Style="white-space: nowrap;">@context.Number</MudTd></MudHidden>
                <MudTd>
                    <MudStack Spacing="0">
                        <MudText>@context.Entity</MudText>
                        <MudHidden Breakpoint="Breakpoint.MdAndUp">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@context.Type - @context.Number</MudText>
                        </MudHidden>
                    </MudStack>
                </MudTd>
                <MudTd Style="white-space: nowrap;">@context.DatePaid?.ToShortDateString()</MudTd>
                <MudTd Style="white-space: nowrap;">@context.Total.ToString("C")</MudTd>
                <MudTd Style="white-space: nowrap;">
                    @if (context.Status == BillStatus.Void)
                    {
                        var b = context.OriginalItem as Bill;
                        var voidTooltip = b != null && !string.IsNullOrWhiteSpace(b.VoidReason) 
                            ? $"Voided by {b.VoidedBy ?? "User"} on {b.VoidedAt?.ToLocalTime().ToString("d") ?? ""}: {b.VoidReason}" 
                            : "Voided";
                        <MudTooltip Text="@voidTooltip">
                            <MudChip T="string" Size="Size.Small" Color="Color.Error">@BizLoc["Void"]</MudChip>
                        </MudTooltip>
                    }
                    else if (context.Status == BillStatus.WrittenOff)
                    {
                        <MudTooltip Text="@context.WriteOffTooltip">
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">@BizLoc["Written Off"]</MudChip>
                        </MudTooltip>
                    }
                    else
                    {
                        <div class="d-flex align-center gap-1">
                            <MudChip T="string" Size="Size.Small" Color="Color.Success">@BizLoc["Paid"]</MudChip>
                            @if (context.HasWriteOffs)
                            {
                                <MudTooltip Text="@context.WriteOffTooltip">
                                    <MudIcon Icon="@Icons.Material.Filled.Balance" Size="Size.Small" Color="Color.Warning" />
                                </MudTooltip>
                            }
                        </div>
                    }
                </MudTd>
                <MudTd Style="white-space: nowrap; text-align: right;">
                    <div class="d-flex align-center justify-end gap-2" style="white-space: nowrap;">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenItem(context))">View</MudButton>
                    </div>
                </MudTd>
            </RowTemplate>
            <PagerContent>
                <MudTablePager />
            </PagerContent>
        </MudTable>
        </MudTabPanel>
    </SpokesTabs>
</MudContainer>

@code {
    public class AccountingItem
    {
        public string Id { get; set; } = string.Empty;
        public string Type { get; set; } = string.Empty; // "Expense", "Bill", "Invoice"
        public string Number { get; set; } = string.Empty;
        public string Entity { get; set; } = string.Empty; // For Payables, this is who we pay.
        public string ClientName { get; set; } = string.Empty; // For Receivables
        public string ProjectName { get; set; } = string.Empty; // For Receivables
        public DateTime Date { get; set; }
        public DateTime? DueDate { get; set; }
        public decimal Total { get; set; }
        public decimal Balance { get; set; }
        public string Status { get; set; } = string.Empty;
        public DateTime? DatePaid { get; set; }
        public bool HasWriteOffs { get; set; }
        public string WriteOffTooltip { get; set; } = string.Empty;
        public object OriginalItem { get; set; } = default!;
        public RecurringBillRecord? RecurringRecord { get; set; }
    }

    private List<AccountingItem> Payables = []; // Outstanding Bills/Expenses
    private List<AccountingItem> GovernmentPayableItems = []; // Payroll Net Pay, Payroll DAS, Sales Tax Remittances
    private List<AccountingItem> AwaitingApprovalBills = []; // Bills awaiting approval
    private List<AccountingItem> PaidPayables = []; // History
    private List<AccountingItem> WrittenOffPayables = []; // Written Off History
    private List<AccountingItem> VoidedPayables = []; // Voided History
    private List<AccountingItem> Receivables = []; // Invoices (Draft/Sent/Paid/WrittenOff/Partial)

    private string historyFilter = "all";
    private string receivablesStatusFilter = "open";

    private void OnHistoryFilterChanged(string val)
    {
        historyFilter = val ?? "all";
        StateHasChanged();
    }

    private void OnReceivablesFilterChanged(string val)
    {
        receivablesStatusFilter = val ?? "open";
        StateHasChanged();
    }

    private IEnumerable<AccountingItem> FilteredReceivableItems => receivablesStatusFilter switch
    {
        "open" => Receivables.Where(r => r.Balance > 0 && r.Status != InvoiceStatus.Draft).OrderByDescending(r => r.Date),
        "overdue" => Receivables.Where(r => r.Balance > 0 && r.DueDate < DateTime.Today && r.Status != InvoiceStatus.Draft).OrderBy(r => r.DueDate),
        "paid" => Receivables.Where(r => InvoiceStatus.IsSettled(r.Status) || (r.Balance <= 0 && r.Status != InvoiceStatus.Draft)).OrderByDescending(r => r.DatePaid ?? r.Date),
        "draft" => Receivables.Where(r => r.Status == InvoiceStatus.Draft).OrderByDescending(r => r.Date),
        _ => Receivables.OrderByDescending(r => r.Date)
    };

    private IEnumerable<AccountingItem> HistoryDisplayItems
    {
        get
        {
            var items = historyFilter switch
            {
                "paid" => PaidPayables,
                "writtenoff" => WrittenOffPayables,
                "voided" => VoidedPayables,
                _ => PaidPayables.Concat(WrittenOffPayables).Concat(VoidedPayables)
            };
            return items.OrderByDescending(i => i.DatePaid ?? i.Date);
        }
    }

    private IEnumerable<AccountingItem> PayableItems => Payables.OrderBy(i => i.DueDate);
    private IEnumerable<AccountingItem> AwaitingApprovalBillItems => AwaitingApprovalBills.OrderBy(i => i.DueDate ?? i.Date);

    private string searchPayables = "";
    private string searchAwaitingApproval = "";
    private string searchReceivables = "";
    private string searchHistory = "";

    private decimal TotalAwaitingApproval;
    private Employee? _currentUser;
    private bool _isInitialized = false;
    private bool _canWriteAccounting = false;
    private bool _canApproveBills = false;
    private bool _canManageBills = false;
    private bool _canReadPayroll = false;
    private bool _canEditPayroll = false;
    private bool CanApproveBills => _canApproveBills;

    private IReadOnlyList<string> AvailableTabs => _canReadPayroll
        ? ["receivables", "payables", "transactions", "payroll", "reconciliation", "taxes", "ledger", "cpa", "history"]
        : ["receivables", "payables", "transactions", "reconciliation", "taxes", "ledger", "cpa", "history"];

    private bool CanMarkItemPaid(AccountingItem item) => item.Type switch
    {
        "Payroll Net" or "Payroll DAS" => _canEditPayroll,
        "Bill" or "PO" or "Recurring" or "One-Time" => _canManageBills,
        "Expense" or "Commission" or "Clawback" or "Invoice" or "Sales Tax" => _canWriteAccounting,
        _ => false
    };

    protected override async Task OnInitializedAsync()
    {
        await RefreshCurrentUserAsync();
        if (currentTab == "payroll" && !_canReadPayroll)
        {
            currentTab = "receivables";
        }
        _isInitialized = true;
        Refresh();
    }

    private async Task RefreshCurrentUserAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync();
        _canWriteAccounting = _currentUser != null && _currentUser.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false);
        _canApproveBills = _currentUser != null && _currentUser.HasEffectivePermission(AppPermissions.Purchases.ApproveBills, allowSuspended: false);
        _canManageBills = _currentUser != null && _currentUser.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false);
        _canReadPayroll = _currentUser != null && _currentUser.HasEffectivePermission(AppPermissions.Hr.ManageSalaries, allowSuspended: true);
        _canEditPayroll = _currentUser != null && _currentUser.HasEffectivePermission(AppPermissions.Hr.ManageSalaries, allowSuspended: false);
    }

    private void ViewPo(string id)
    {
        Nav.NavigateTo($"/purchases/po/{id}");
    }

    private void Refresh()
    {
        Payables.Clear();
        GovernmentPayableItems.Clear();
        AwaitingApprovalBills.Clear();
        PaidPayables.Clear();
        WrittenOffPayables.Clear();
        VoidedPayables.Clear();
        Receivables.Clear();

        // 1. Expense Reports
        var reports = Db.ExpenseReports.GetAll().Where(x => x.Status != ExpenseReportStatus.Draft).ToList();
        foreach (var r in reports)
        {
            var isPaid = r.DatePaid.HasValue || r.Status == ExpenseReportStatus.Paid;
            var item = new AccountingItem
                {
                    Id = r.Id,
                    Type = "Expense",
                    Number = r.ReportNumber,
                    Entity = r.EmployeeName,
                    Date = r.DateCreated,
                    DueDate = r.DateSubmitted,
                    Total = r.TotalAmount,
                    Balance = isPaid ? 0 : r.TotalAmount,
                    Status = isPaid ? BillStatus.Paid : BillStatus.Unpaid,
                    DatePaid = r.DatePaid ?? r.DateSubmitted ?? r.DateCreated,
                    OriginalItem = r
                };

            if (isPaid) PaidPayables.Add(item); else Payables.Add(item);
        }

        // 2. Bills (and POs)
        var bills = Db.Bills.GetAll();
        foreach (var b in bills)
        {
            var isPo = !string.IsNullOrEmpty(b.PurchaseOrderId);

            if (b.Status == BillStatus.Void)
            {
                VoidedPayables.Add(new AccountingItem
                {
                    Id = b.Id,
                    Type = "Bill",
                    Number = string.IsNullOrWhiteSpace(b.Description) ? (isPo ? $"Bill for PO {b.PurchaseOrderId}" : "Bill") : b.Description,
                    Entity = b.SupplierName,
                    Date = b.Date,
                    DueDate = b.DueDate,
                    Total = b.Amount,
                    Balance = 0,
                    Status = BillStatus.Void,
                    DatePaid = b.VoidedAt?.ToLocalTime().Date ?? b.Date,
                    OriginalItem = b
                });
                continue;
            }

            var isSettled = b.BalanceDue <= 0 || BillStatus.IsSettled(b.Status);
            var resolvedBillStatus = isSettled
                ? (b.AmountPaid <= 0 && b.HasWriteOffs ? BillStatus.WrittenOff : BillStatus.Paid)
                : (b.AmountPaid > 0 ? "Partially Paid" : b.Status);

            var item = new AccountingItem
                {
                    Id = b.Id,
                    Type = "Bill", // Always Bill, avoids PO confusion
                    Number = string.IsNullOrWhiteSpace(b.Description) ? (isPo ? $"Bill for PO {b.PurchaseOrderId}" : "Bill") : b.Description,
                    Entity = b.SupplierName,
                    Date = b.Date,
                    DueDate = b.DueDate,
                    Total = b.Amount,
                    Balance = b.BalanceDue,
                    Status = resolvedBillStatus,
                    DatePaid = b.DatePaid ?? (b.HasWriteOffs ? b.WriteOffs.MaxBy(w => w.Date)?.Date : null) ?? b.Date,
                    HasWriteOffs = b.HasWriteOffs,
                    WriteOffTooltip = FormatWriteOffTooltip(b.WriteOffs),
                    OriginalItem = b
                };

            if (isSettled)
            {
                if (resolvedBillStatus == BillStatus.WrittenOff)
                    WrittenOffPayables.Add(item);
                else
                    PaidPayables.Add(item);
            }
            else if (b.Status == BillStatus.AwaitingApproval)
            {
                AwaitingApprovalBills.Add(item);
            }
            else 
            {
                Payables.Add(item);
            }
        }

        // 3. Recurring Expenses (All Unpaid Actual Bills for Payables List)
        var allRecurring = Db.RecurringExpenses.GetAll().ToList();

        foreach (var re in allRecurring)
        {
            var unpaidRecords = re.History.Where(h => h.BalanceDue > 0).ToList();
            foreach (var record in unpaidRecords)
            {
                var typeStr = re.Frequency == RecurringExpenseFrequency.OneTime ? "One-Time" : "Recurring";
                var entityStr = string.IsNullOrEmpty(re.Supplier) ? (typeStr == "One-Time" ? "One-Time Expense" : "Recurring Bill") : re.Supplier;
                
                Payables.Add(new AccountingItem
                {
                    Id = record.Id,
                    Type = typeStr,
                    Number = re.Name,
                    Entity = entityStr,
                    Date = record.Date,
                    DueDate = record.DueDate ?? record.Date,
                    Total = record.Amount,
                    Balance = record.BalanceDue,
                    Status = record.AmountPaid > 0 ? "Partially Paid" : BillStatus.Unpaid,
                    HasWriteOffs = record.HasWriteOffs,
                    WriteOffTooltip = FormatWriteOffTooltip(record.WriteOffs),
                    OriginalItem = re,
                    RecurringRecord = record
                });
            }
        }

        // 5. PAID & WRITTEN OFF HISTORY from Recurring & One-Time Expenses
        foreach (var re in allRecurring)
        {
            foreach (var historyItem in re.History.Where(h => h.BalanceDue <= 0))
            {
                var isRecWrittenOff = historyItem.AmountPaid <= 0 && historyItem.HasWriteOffs;
                var recItem = new AccountingItem
                    {
                        Id = historyItem.Id,
                        Type = re.Frequency == RecurringExpenseFrequency.OneTime ? "One-Time" : "Recurring",
                        Number = re.Name,
                        Entity = string.IsNullOrEmpty(re.Supplier) ? (re.Frequency == RecurringExpenseFrequency.OneTime ? "One-Time Expense" :
                    "Recurring Bill") : re.Supplier,
                        Date = historyItem.Date,
                        DueDate = historyItem.Date,
                        Total = historyItem.Amount,
                        Balance = 0,
                        Status = isRecWrittenOff ? BillStatus.WrittenOff : BillStatus.Paid,
                        DatePaid = historyItem.DatePaid ?? (historyItem.HasWriteOffs ? historyItem.WriteOffs.MaxBy(w => w.Date)?.Date : null) ?? historyItem.Date,
                        HasWriteOffs = historyItem.HasWriteOffs,
                        WriteOffTooltip = FormatWriteOffTooltip(historyItem.WriteOffs),
                        OriginalItem = re, // Identify as the parent expense
                        RecurringRecord = historyItem
                    };

                if (isRecWrittenOff)
                    WrittenOffPayables.Add(recItem);
                else
                    PaidPayables.Add(recItem);
            }
        }

        // 6. Invoices (Receivables)
        var invoices = Db.Invoices.GetAll();
        foreach (var inv in invoices)
        {
            if (inv.Status == InvoiceStatus.Void) continue;

            var proj = Db.Projects.GetById(inv.ProjectId);
            var resolvedInvStatus = inv.Status == InvoiceStatus.Draft
                ? InvoiceStatus.Draft
                : (inv.BalanceDue <= 0
                    ? (inv.AmountPaid <= 0 && inv.HasWriteOffs ? InvoiceStatus.WrittenOff : InvoiceStatus.Paid)
                    : ((inv.AmountPaid > 0 || inv.HasWriteOffs) ? InvoiceStatus.Partial : inv.Status));

            var invItem = new AccountingItem
            {
                Id = inv.Id,
                Type = "Invoice",
                Number = inv.InvoiceNumber,
                Entity = proj?.Client?.BusinessName ?? "Unknown",
                ClientName = proj?.Client?.BusinessName ?? "-",
                ProjectName = proj?.DisplayName ?? "-",
                Date = inv.Date,
                DueDate = inv.DueDate,
                Total = inv.GrandTotal,
                Balance = inv.Status == InvoiceStatus.Draft ? inv.GrandTotal : inv.BalanceDue,
                Status = resolvedInvStatus,
                DatePaid = inv.DatePaid ?? (inv.BalanceDue <= 0 && inv.Status != InvoiceStatus.Draft
                    ? (inv.HasWriteOffs ? inv.WriteOffs.MaxBy(w => w.Date)?.Date : inv.Date)
                    : null),
                HasWriteOffs = inv.HasWriteOffs,
                WriteOffTooltip = FormatWriteOffTooltip(inv.WriteOffs),
                OriginalItem = inv
            };
            Receivables.Add(invItem);

            if (inv.Status != InvoiceStatus.Draft && inv.BalanceDue <= 0)
            {
                if (resolvedInvStatus == InvoiceStatus.WrittenOff)
                    WrittenOffPayables.Add(invItem);
                else
                    PaidPayables.Add(invItem);
            }
        }

        // 7. Commissions from Ledger
        var ledgerRecords = Db.CommissionLedgerRecords.GetAll();
        foreach (var record in ledgerRecords)
        {
            var isPaid = record.Status == CommissionStatus.Paid || record.DatePaid.HasValue;
            var proj = Db.Projects.GetById(record.ProjectId);
            
            var item = new AccountingItem
            {
                Id = record.Id,
                Type = record.Status == CommissionStatus.Clawback ? "Clawback" : "Commission",
                Number = proj?.ProjectNumber ?? "-",
                Entity = record.BeneficiaryName,
                ClientName = proj?.Client?.BusinessName ?? "-",
                ProjectName = proj?.DisplayName ?? "-",
                Date = record.DateGenerated,
                DueDate = record.DateGenerated,
                Total = record.CommissionAmount,
                Balance = isPaid ? 0 : record.CommissionAmount,
                Status = record.Status,
                DatePaid = record.DatePaid ?? record.DateGenerated,
                OriginalItem = record
            };
            
            if (isPaid) PaidPayables.Add(item); else Payables.Add(item);
        }

        // 8. Payroll Obligations (Net Pay & DAS Remittances)
        if (_canReadPayroll)
        {
            var allPayRuns = Db.PayRuns?.GetAll() ?? [];
            foreach (var run in allPayRuns)
            {
                if (run.Status == PayRunStatus.Void)
                {
                    VoidedPayables.Add(new AccountingItem
                    {
                        Id = run.Id,
                        Type = "Payroll",
                        Number = run.RunNumber,
                        Entity = $"Pay Period {run.PeriodStart:yyyy-MM-dd} → {run.PeriodEnd:yyyy-MM-dd}",
                        Date = run.PayDate,
                        DueDate = run.PayDate,
                        Total = run.TotalNetPay,
                        Balance = 0,
                        Status = BillStatus.Void,
                        DatePaid = run.PayDate,
                        OriginalItem = run
                    });
                    continue;
                }

                if (run.Status == PayRunStatus.Finalized && !run.DatePaid.HasValue && run.TotalNetPay > 0)
                {
                    GovernmentPayableItems.Add(new AccountingItem
                    {
                        Id = run.Id,
                        Type = "Payroll Net",
                        Number = run.RunNumber,
                        Entity = $"Employee Net Payroll ({run.Stubs.Count} employees)",
                        Date = run.PayDate,
                        DueDate = run.PayDate,
                        Total = run.TotalNetPay,
                        Balance = run.TotalNetPay,
                        Status = BillStatus.Unpaid,
                        OriginalItem = run
                    });
                }
                else if (run.Status == PayRunStatus.Paid || run.DatePaid.HasValue)
                {
                    PaidPayables.Add(new AccountingItem
                    {
                        Id = run.Id,
                        Type = "Payroll Net",
                        Number = run.RunNumber,
                        Entity = $"Employee Net Payroll ({run.Stubs.Count} employees)",
                        Date = run.PayDate,
                        DueDate = run.PayDate,
                        Total = run.TotalNetPay,
                        Balance = 0,
                        Status = BillStatus.Paid,
                        DatePaid = run.DatePaid ?? run.PayDate,
                        OriginalItem = run
                    });
                }

                var totalDas = Math.Round(run.TotalEmployeeDeductions + run.TotalEmployerContributions, 2);
                if ((run.Status == PayRunStatus.Finalized || run.Status == PayRunStatus.Paid) && totalDas > 0)
                {
                    var nextMonth15 = new DateTime(run.PayDate.Year, run.PayDate.Month, 1).AddMonths(1).AddDays(14);
                    var dasItem = new AccountingItem
                    {
                        Id = $"{run.Id}:DAS",
                        Type = "Payroll DAS",
                        Number = $"{run.RunNumber} DAS",
                        Entity = $"Government Source Deductions (DAS — {run.JurisdictionId})",
                        Date = run.PayDate,
                        DueDate = nextMonth15,
                        Total = totalDas,
                        Balance = run.IsDasRemitted ? 0 : totalDas,
                        Status = run.IsDasRemitted ? BillStatus.Paid : BillStatus.Unpaid,
                        DatePaid = run.DasRemittedAt ?? run.PayDate,
                        OriginalItem = run
                    };

                    if (run.IsDasRemitted)
                        PaidPayables.Add(dasItem);
                    else
                        GovernmentPayableItems.Add(dasItem);
                }
            }
        }

        // 9. Sales Tax Filing Periods
        var taxPeriods = Db.TaxFilingPeriods?.GetAll() ?? [];
        foreach (var tp in taxPeriods)
        {
            if (tp.NetTaxRemittanceDue == 0) continue;
            var isRemitted = tp.Status == TaxFilingStatus.Paid || tp.PaidAt.HasValue;
            var tpItem = new AccountingItem
            {
                Id = tp.Id,
                Type = "Sales Tax",
                Number = !string.IsNullOrWhiteSpace(tp.PeriodLabel) ? tp.PeriodLabel : $"{tp.StartDate:yyyy-MM}..{tp.EndDate:yyyy-MM}",
                Entity = $"Sales Tax Remittance ({tp.Frequency})",
                Date = tp.EndDate,
                DueDate = tp.EndDate.AddMonths(1),
                Total = tp.NetTaxRemittanceDue,
                Balance = isRemitted ? 0 : tp.NetTaxRemittanceDue,
                Status = isRemitted ? BillStatus.Paid : BillStatus.Unpaid,
                DatePaid = tp.PaidAt?.ToLocalTime().Date ?? tp.EndDate,
                OriginalItem = tp
            };

            if (isRemitted)
                PaidPayables.Add(tpItem);
            else if (tp.Status == TaxFilingStatus.Filed && tp.NetTaxRemittanceDue > 0)
                GovernmentPayableItems.Add(tpItem);
        }

        TotalAwaitingApproval = AwaitingApprovalBills.Sum(x => x.Balance);
    }

    private Color GetTypeColor(string type) => type switch
    {
        "Expense" => Color.Info,
        "Bill" => Color.Warning,
        "PO" => Color.Secondary,
        "Invoice" => Color.Primary,
        "Commission" => Color.Secondary,
        "Recurring" => Color.Tertiary,
        "One-Time" => Color.Dark,
        "Payroll Net" or "Payroll" => Color.Success,
        "Payroll DAS" or "Sales Tax" => Color.Warning,
        _ => Color.Default
    };

    private async Task OpenItem(AccountingItem item)
    {
        if (item.Type == "Expense")
        {
            var r = (ExpenseReport)item.OriginalItem;
            var parameters = new DialogParameters { ["Report"] = r, ["IsReadOnly"] = true };
            await DialogService.ShowAsync<ExpenseReportDialog>("Expense Report", parameters, new DialogOptions
                {
                    MaxWidth =
                MaxWidth.Medium,
                    FullWidth = true
                });
        }
        else if (item.Type == "Bill")
        {
            var b = ((Bill)item.OriginalItem).DeepClone();
            var parameters = new DialogParameters { ["Bill"] = b };
            var dialog = await DialogService.ShowAsync<BillEditorDialog>("Bill Details", parameters, new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraExtraLarge,
                    FullWidth = true,
                    CloseButton = true
                });
            var result = await dialog.Result;
            if (result != null && !result.Canceled && result.Data is Bill bResult) 
            { 
                var actor = await UserService.GetEmployeeAsync();
                var userName = actor?.FullName ?? actor?.Email ?? "User";
                if (item.Status == BillStatus.AwaitingApproval && bResult.Status != BillStatus.AwaitingApproval && bResult.Status != BillStatus.Void)
                {
                    if (actor == null || !actor.HasEffectivePermission(AppPermissions.Purchases.ApproveBills, allowSuspended: false))
                    {
                        Snackbar.Add("Missing Purchases.ApproveBills permission to approve bills.", Severity.Error);
                        return;
                    }
                    AccountingService.ApproveBill(bResult, userName, actor);
                }
                else
                {
                    if (actor == null || !actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
                    {
                        Snackbar.Add("Missing Purchases.ManageBills permission to save bills.", Severity.Error);
                        return;
                    }
                    AccountingService.SaveBill(bResult, userName, actor);
                }
            }
            Refresh();
        }
        else if (item.Type is "Payroll Net" or "Payroll DAS" or "Payroll" && item.OriginalItem is PayRun payRun)
        {
            var actor = await UserService.GetEmployeeAsync();
            if (actor == null || !actor.HasEffectivePermission(AppPermissions.Hr.ManageSalaries, allowSuspended: true))
            {
                Snackbar.Add("Missing Hr.ManageSalaries permission to view payroll.", Severity.Error);
                return;
            }
            var clonedPayRun = payRun.DeepClone() ?? payRun;
            var parameters = new DialogParameters<PayRunDialog> { { x => x.PayRun, clonedPayRun } };
            var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
            await DialogService.ShowAsync<PayRunDialog>($"Pay Run {payRun.RunNumber}", parameters, options);
            Refresh();
        }
        else if (item.Type == "Sales Tax")
        {
            UpdateActiveTab("taxes");
        }
        else if (item.Type == "PO")
        {
            var b = (Bill)item.OriginalItem;
            Nav.NavigateTo($"/purchases/{b.PurchaseOrderId}");
        }
        else if (item.Type == "Invoice")
        {
            // Invoices need ProjectID to construct URL
            var inv = (Invoice)item.OriginalItem;
            Nav.NavigateTo($"/projects/{inv.ProjectId}/invoices/{inv.Id}");
        }
        else if (item.Type == "Commission" || item.Type == "Clawback")
        {
            var record = (CommissionLedgerRecord)item.OriginalItem;
            if (_currentUser != null && ProjectAccessHelper.HasAccess(Db.Projects, Db.Teams, _currentUser, record.ProjectId, allowAccountingFinancialRead: false))
            {
                Nav.NavigateTo($"/projects/{record.ProjectId}");
            }
            else
            {
                Snackbar.Add("You do not have permission to open this restricted project workspace.", Severity.Warning);
            }
        }
        else if (item.Type == "Recurring" || item.Type == "One-Time")
        {
            if (item.OriginalItem is RecurringExpense expense)
            {
                var clonedExpense = expense.DeepClone() ?? expense;
                var record = item.RecurringRecord != null
                    ? clonedExpense.History.FirstOrDefault(h => h.Id == item.RecurringRecord.Id) ?? item.RecurringRecord.DeepClone()
                    : clonedExpense.History.FirstOrDefault(h => h.Id == item.Id);
                if (record != null)
                {
                    var parameters = new DialogParameters<RecurringBillViewerDialog>
                    {
                        { x => x.Expense, clonedExpense },
                        { x => x.Record, record }
                    };
                    var dialog = await DialogService.ShowAsync<RecurringBillViewerDialog>(
                        $"{clonedExpense.Name} - {record.Date:yyyy-MM-dd}",
                        parameters,
                        new DialogOptions
                        {
                            MaxWidth = MaxWidth.ExtraExtraLarge,
                            FullWidth = true,
                            CloseButton = true
                        });
                    var result = await dialog.Result;
                    if (result != null && !result.Canceled && result.Data is RecurringExpense updated)
                    {
                        var actor = await UserService.GetEmployeeAsync();
                        if (actor == null || !actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
                        {
                            Snackbar.Add("Missing Purchases.ManageBills permission to save recurring bills.", Severity.Error);
                            return;
                        }
                        AccountingService.SaveRecurringExpense(updated, actor);
                    }
                    Refresh();
                }
                else
                {
                    var parameters = new DialogParameters<RecurringExpenseDialog>
                    {
                        { x => x.Expense, clonedExpense },
                        { x => x.IsNew, false },
                        { x => x.ActiveTabIndex, 1 }
                    };
                    var dialog = await DialogService.ShowAsync<RecurringExpenseDialog>(
                        $"Recurring Bill - {clonedExpense.Name}",
                        parameters,
                        new DialogOptions
                        {
                            MaxWidth = MaxWidth.Medium,
                            FullWidth = true,
                            CloseButton = true
                        });
                    var result = await dialog.Result;
                    if (result != null && !result.Canceled && result.Data is RecurringExpense updated)
                    {
                        var actor = await UserService.GetEmployeeAsync();
                        if (actor == null || !actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
                        {
                            Snackbar.Add("Missing Purchases.ManageBills permission to save recurring bills.", Severity.Error);
                            return;
                        }
                        AccountingService.SaveRecurringExpense(updated, actor);
                    }
                    Refresh();
                }
            }
        }
    }

    private async Task MarkPaid(AccountingItem item)
    {
        var actor = await UserService.GetEmployeeAsync();
        if (actor == null)
        {
            Snackbar.Add("Authentication is required.", Severity.Error);
            return;
        }
        var userName = actor.FullName ?? actor.Email ?? "User";

        if (item.Type is "Expense" or "Commission" or "Clawback" or "Payroll Net" or "Payroll DAS" or "Sales Tax")
        {
            if (item.Type == "Sales Tax")
            {
                UpdateActiveTab("taxes");
                return;
            }

            if (item.Type is "Payroll Net" or "Payroll DAS")
            {
                if (!actor.HasEffectivePermission(AppPermissions.Hr.ManageSalaries, allowSuspended: false))
                {
                    Snackbar.Add("Missing Hr.ManageSalaries permission to record payroll disbursements.", Severity.Error);
                    return;
                }
            }
            else if (!actor.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false))
            {
                Snackbar.Add("Missing active accounting permission to record payments.", Severity.Error);
                return;
            }

            var parameters = new DialogParameters<ConfirmPaymentDateDialog>
            {
                { x => x.Message, $"Confirm payment/remittance date for {item.Type} ({item.Number} — {item.Balance:C2}):" }
            };
            var dialog = await DialogService.ShowAsync<ConfirmPaymentDateDialog>("Confirm Payment", parameters);
            var result = await dialog.Result;

            if (result is { Canceled: false, Data: DateTime datePaid })
            {
                actor = await UserService.GetEmployeeAsync();
                if (actor == null) return;

                var defaultBankCode = Db.GlAccounts?.GetBySystemRole(GlSystemRole.OperatingBank)?.Code ?? "1020";
                if (item.Type == "Expense" && item.OriginalItem is ExpenseReport r)
                {
                    if (!actor.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false)) return;
                    AccountingService.MarkExpenseReportPaid(r, datePaid, defaultBankCode, userName, actor);
                }
                else if (item.Type is "Commission" or "Clawback" && item.OriginalItem is CommissionLedgerRecord record)
                {
                    if (!actor.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false)) return;
                    AccountingService.MarkCommissionPaid(record, datePaid, defaultBankCode, userName, actor);
                }
                else if (item.Type == "Payroll Net" && item.OriginalItem is PayRun payRunNet)
                {
                    if (!actor.HasEffectivePermission(AppPermissions.Hr.ManageSalaries, allowSuspended: false)) return;
                    PayrollEngine.MarkPayRunPaid(payRunNet, datePaid, defaultBankCode, actor: actor);
                }
                else if (item.Type == "Payroll DAS" && item.OriginalItem is PayRun payRunDas)
                {
                    if (!actor.HasEffectivePermission(AppPermissions.Hr.ManageSalaries, allowSuspended: false)) return;
                    PayrollEngine.RecordDasRemittance(payRunDas, datePaid, defaultBankCode, actor: actor);
                }
                Snackbar.Add($"{item.Type} marked as paid on {datePaid.ToShortDateString()}", Severity.Success);
                Refresh();
            }
        }
        else
        {
            if (item.Type is "Bill" or "PO")
            {
                if (!actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
                {
                    Snackbar.Add("Missing Purchases.ManageBills permission to record bill payments.", Severity.Error);
                    return;
                }
            }
            else if (item.Type == "Invoice")
            {
                if (!actor.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false))
                {
                    Snackbar.Add("Missing active accounting permission to record invoice payments.", Severity.Error);
                    return;
                }
            }
            else
            {
                return;
            }

            List<PaymentRecord>? existingPayments = null;
            if (item.OriginalItem is Bill b) existingPayments = b.Payments;
            else if (item.OriginalItem is Invoice inv) existingPayments = inv.Payments;

            var parameters = new DialogParameters<RecordPaymentDialog>
            {
                { x => x.Message, $"Record payment for {item.Type} ({item.Number})" },
                { x => x.MaxAmount, item.Balance },
                { x => x.ExistingPayments, existingPayments }
            };
            var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Payment", parameters);
            var result = await dialog.Result;

            if (result is { Canceled: false, Data: PaymentRecord payment })
            {
                actor = await UserService.GetEmployeeAsync();
                if (actor == null) return;
                userName = actor.FullName ?? actor.Email ?? userName;

                if (item.Type == "Bill" || item.Type == "PO")
                {
                    if (!actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false)) return;
                    var bill = (Bill)item.OriginalItem;
                    AccountingService.RecordBillPayment(bill, payment, userName, actor);
                }
                else if (item.Type == "Invoice")
                {
                    if (!actor.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false)) return;
                    var inv = (Invoice)item.OriginalItem;
                    AccountingService.RecordInvoicePayment(inv, payment, userName, actor);
                }
                Snackbar.Add($"Payment of {payment.Amount:C} recorded on {payment.Date.ToShortDateString()}", Severity.Success);
                Refresh();
            }
        }
    }

    private static string FormatWriteOffTooltip(List<BalanceWriteOff>? writeOffs)
    {
        if (writeOffs == null || writeOffs.Count == 0) return string.Empty;
        var total = writeOffs.Sum(w => w.Amount);
        var reasons = string.Join("; ", writeOffs.Select(w => $"{w.Amount:C2} ({w.Date:yyyy-MM-dd}): {w.Reason}"));
        return $"Written off {total:C2} — {reasons}";
    }

    private async Task CloseBalance(AccountingItem item)
    {
        var actor = await UserService.GetEmployeeAsync();
        if (actor == null)
        {
            Snackbar.Add("Authentication is required.", Severity.Error);
            return;
        }

        if (item.Type == "Invoice")
        {
            if (!actor.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: false) &&
                !actor.HasEffectivePermission(AppPermissions.Finance.ApproveInvoices, allowSuspended: false))
            {
                Snackbar.Add(BizLoc["Missing active accounting permission to close invoice balances."].Value, Severity.Error);
                return;
            }
        }
        else if (item.Type is "Bill" or "Recurring" or "One-Time")
        {
            if (!actor.HasEffectivePermission(AppPermissions.Purchases.ManageBills, allowSuspended: false))
            {
                Snackbar.Add(BizLoc["Missing Purchases.ManageBills permission to close payable balances."].Value, Severity.Error);
                return;
            }
        }
        else
        {
            return;
        }

        decimal amountPaid = 0m;
        if (item.OriginalItem is Invoice inv0) amountPaid = inv0.AmountPaid;
        else if (item.OriginalItem is Bill b0) amountPaid = b0.AmountPaid;
        else if (item.RecurringRecord != null) amountPaid = item.RecurringRecord.AmountPaid;

        var parameters = new DialogParameters<WriteOffBalanceDialog>
        {
            { x => x.DocumentTypeLabel, item.Type },
            { x => x.DocumentNumber, item.Number },
            { x => x.PartyLabel, item.Type == "Invoice" ? BizLoc["Client"].Value : BizLoc["Supplier"].Value },
            { x => x.PartyName, item.Type == "Invoice" ? item.ClientName : item.Entity },
            { x => x.TotalAmount, item.Total },
            { x => x.AmountPaid, amountPaid },
            { x => x.RemainingBalance, item.Balance },
            { x => x.IsReceivable, item.Type == "Invoice" }
        };

        var dialog = await DialogService.ShowAsync<WriteOffBalanceDialog>(
            BizLoc["Close / Write Off Balance"].Value,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BalanceWriteOff writeOff })
        {
            try
            {
                actor = await UserService.GetEmployeeAsync();
                if (actor == null) return;
                var userName = actor.FullName ?? actor.Email ?? "User";

                if (item.Type == "Invoice" && item.OriginalItem is Invoice inv)
                {
                    AccountingService.RecordInvoiceWriteOff(inv, writeOff, userName, actor);
                }
                else if (item.Type == "Bill" && item.OriginalItem is Bill bill)
                {
                    AccountingService.RecordBillWriteOff(bill, writeOff, userName, actor);
                }
                else if (item.Type is "Recurring" or "One-Time" && item.OriginalItem is RecurringExpense expense && item.RecurringRecord != null)
                {
                    AccountingService.RecordRecurringBillWriteOff(expense, item.RecurringRecord, writeOff, userName, actor);
                }

                Snackbar.Add(string.Format(BizLoc["Closed balance of {0} without creating a bank transaction."].Value, writeOff.Amount.ToString("C2")), Severity.Success);
                Refresh();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
    }

