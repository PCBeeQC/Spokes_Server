    private async Task RegisterPayment()
    {
        var preAuth = await AuthorizeInvoiceMutationAsync();
        if (preAuth == null || preAuth.Value.Invoice.Status == InvoiceStatus.Draft)
        {
            return;
        }
        var liveInvoice = preAuth.Value.Invoice;

        var parameters = new DialogParameters<RecordPaymentDialog> 
        { 
            { x => x.MaxAmount, Math.Max(0, liveInvoice.BalanceDue) },
            { x => x.Message, string.Format(BizLoc["Record payment for invoice #{0}."].Value, liveInvoice.InvoiceNumber) },
            { x => x.ExistingPayments, liveInvoice.Payments }
        };
        var dialog = await DialogService.ShowAsync<RecordPaymentDialog>(BizLoc["Record Payment"].Value, parameters);
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: PaymentRecord payment })
        {
            var saveAuth = await AuthorizeInvoiceMutationAsync();
            if (saveAuth == null || saveAuth.Value.Invoice.Status == InvoiceStatus.Draft) return;
            AccountingService.RecordInvoicePayment(saveAuth.Value.Invoice, payment, saveAuth.Value.Actor.FullName ?? _currentUserName, saveAuth.Value.Actor);
            Invoice = Db.Invoices.GetById(saveAuth.Value.Invoice.Id);
            Snackbar.Add(string.Format(BizLoc["Payment of {0} Registered"].Value, payment.Amount.ToString("C2")), Severity.Success);
            await RefreshViewer();
        }
    }

    private async Task EditInvoice()
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveInvoice = string.IsNullOrEmpty(InvoiceId) ? null : Db.Invoices.GetById(InvoiceId);
        if (emp == null || liveInvoice == null || !CanEmployeeViewInvoiceScope(emp, liveInvoice))
        {
            Snackbar.Add("Access denied.", Severity.Error);
            return;
        }

        var liveCanApprove = emp.HasPermission(AppPermissions.Finance.ApproveInvoices);
        var liveCanManage = emp.HasPermission(AppPermissions.Finance.AccessAccounting) || liveCanApprove;
        CanApproveInvoice = liveCanApprove;
        CanManageAccounting = liveCanManage;
        CanEditInvoice = liveCanManage;
        _canUseEmail = emp.HasPermission(AppPermissions.Email.Use);
        _currentUserName = emp.FullName ?? emp.Email ?? "System";

        var parameters = new DialogParameters<InvoiceMasterDialog>
        {
            { x => x.Invoice, liveInvoice },
            { x => x.CanEditDraft, liveCanManage },
            { x => x.CanApproveInvoice, liveCanApprove }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true };
        var dialogTitle = liveInvoice.Status == InvoiceStatus.Draft && liveCanManage
            ? BizLoc["Edit Invoice"].Value
            : BizLoc["Invoice Builder & Details"].Value;

        var dialog = await DialogService.ShowAsync<InvoiceMasterDialog>(dialogTitle, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            // Reload to ensure UI reflects changes (Totals, Descriptions, etc.)
            Invoice = Db.Invoices.GetById(liveInvoice.Id);

            // Re-evaluate template in case it changed
            if (!string.IsNullOrEmpty(Invoice?.TemplateId))
            {
                Template = Db.DocumentTemplates.GetById(Invoice.TemplateId);
            }
            else if (Project != null && !string.IsNullOrEmpty(Project.DefaultTemplateId))
            {
                Template = Db.DocumentTemplates.GetById(Project.DefaultTemplateId);
            }
            else
            {
                Template = Db.DocumentTemplates.GetDefault();
            }

            await RefreshViewer();
            Snackbar.Add("Invoice updated successfully", Severity.Success);
        }
    }

    private async Task DuplicateInvoice()
    {
        var preAuth = await AuthorizeInvoiceMutationAsync();
        if (preAuth == null) return;
        var result = await DialogService.ShowMessageBoxAsync("Duplicate Invoice", "Are you sure you want to create a copy of this invoice?", yesText: "Duplicate", cancelText: "Cancel");
        if (result != true) return;

        try
        {
            var saveAuth = await AuthorizeInvoiceMutationAsync();
            if (saveAuth == null) return;
            var sourceInvoice = saveAuth.Value.Invoice;

            var newNumber = Db.Invoices.GenerateInvoiceNumber(Profile?.InvoicePrefix ?? "INV-");
            var newInv = sourceInvoice.DuplicateAsDraft(newNumber, _currentUserName);
            newInv.ProjectId = sourceInvoice.ProjectId;
            newInv.ProjectGroupId = sourceInvoice.ProjectGroupId;

            Db.Invoices.Save(newInv);

            Snackbar.Add("Invoice Duplicated Successfully", Severity.Success);
            if (!string.IsNullOrEmpty(newInv.ProjectGroupId))
            {
                Nav.NavigateTo($"/project-groups/{newInv.ProjectGroupId}/invoices/{newInv.Id}");
            }
            else
            {
                Nav.NavigateTo($"/projects/{ProjectId}/invoices/{newInv.Id}");
            }
        }
        catch (Exception)
        {
            Snackbar.Add("Failed to duplicate invoice", Severity.Error);
        }
    }

    private async Task<bool> EnsurePdfExistsAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveInvoice = string.IsNullOrEmpty(InvoiceId) ? null : Db.Invoices.GetById(InvoiceId);
        if (emp == null || liveInvoice == null || !CanEmployeeViewInvoiceScope(emp, liveInvoice))
        {
            Snackbar.Add("Access denied.", Severity.Error);
            return false;
        }

        Invoice = liveInvoice;
        if (PdfService.IsValidCachedPdf(liveInvoice.PdfPath))
        {
            return true;
        }

        try
        {
            Snackbar.Add("Generating PDF document...", Severity.Info);
            var targetProjectId = !string.IsNullOrEmpty(ProjectId) ? ProjectId : liveInvoice.ProjectId;
            liveInvoice.PdfPath = await PdfService.GenerateInvoicePdfAsync(liveInvoice, targetProjectId, Nav.BaseUri, emp.Id);
            if (emp.HasPermission(AppPermissions.Finance.AccessAccounting) || emp.HasPermission(AppPermissions.Finance.ApproveInvoices))
            {
                Db.Invoices.Save(liveInvoice);
            }
            Invoice = liveInvoice;
            return true;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to generate invoice PDF on demand");
            Snackbar.Add("Failed to generate PDF document", Severity.Error);
            return false;
        }
    }

    private async Task SendByEmail()
    {
        var auth = await AuthorizeInvoiceMutationAsync(requireApprove: true);
        if (auth == null) return;
        if (string.Equals(Db.CompanyProfile.Get()?.Edition, "Family", StringComparison.OrdinalIgnoreCase) ||
            !auth.Value.Actor.HasPermission(AppPermissions.Email.Use))
        {
            Snackbar.Add("Active Email.Use permission is required to send emails.", Severity.Error);
            return;
        }

        if (!await EnsurePdfExistsAsync() || Invoice == null)
        {
            return;
        }

        var parameters = new DialogParameters
        {
            ["To"] = Project?.Client?.ContactPersonEmail ?? "",
            ["Subject"] = $"Invoice #{Invoice.InvoiceNumber} from {Profile?.CompanyName}",
            ["Body"] = $"<p>Dear {Project?.Client?.ContactPersonName ?? "Client"},</p><p>Please find attached invoice #{Invoice.InvoiceNumber}.</p>",
            ["IsTemplate"] = true,
            ["PreloadedDocumentAttachments"] = new List<OutboundDocumentAttachmentRef>
            {
                new(OutboundDocumentKind.Invoice, Invoice.Id, $"Invoice_{Invoice.InvoiceNumber}.pdf")
            }
