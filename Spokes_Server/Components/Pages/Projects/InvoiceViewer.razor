@page "/projects/{ProjectId}/invoices/{InvoiceId}"
@page "/project-groups/{GroupId}/invoices/{InvoiceId}"
@attribute [Authorize(Policy = AppPermissions.Projects.View)]
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Dialogs.Common
@using Spokes_Server.Components.Pages.Email
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Common
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Documents
@using Spokes_Server.Core.Services.Content
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Components.Shared
@inject Database Db
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject UserService UserService
@inject DocumentPdfService PdfService
@inject IAccountingService AccountingService
@inject IJurisdictionTemplateService JurisdictionService
@inject MarkdownSanitizerService MarkdownSanitizer
@inject FileUrlSigner FileUrls
@inject ILogger<InvoiceViewer> Logger
@implements IAsyncDisposable

@if (Invoice == null || Template == null || Profile == null)
{
        <MudAlert Severity="Severity.Error">Loading...</MudAlert>
        <MudButton OnClick="GoBack">Back</MudButton>
}
else
{
    @if (Invoice != null)
    {
        <PageTitle>@(Project?.Client?.BusinessName is { Length: > 0 } clientName ? $"{Template.Label_Invoice} {Invoice.InvoiceNumber} - {clientName}" : $"{Template.Label_Invoice} {Invoice.InvoiceNumber}")</PageTitle>
    }
        <MudContainer MaxWidth="MaxWidth.Large" Class="py-4 pb-8">
        <div class="d-print-none mb-1">
            <SpokesBreadcrumbs Items="@(new (string, string?)[] { ("Projects", "projects"), (Project?.DisplayName ?? "Project", $"projects/{ProjectId}"), ("Invoices", $"business/accounting?tab=receivables"), (Invoice!.InvoiceNumber, null) })" />
        </div>
        <div class="d-flex justify-space-between align-center flex-wrap gap-2 py-2 d-print-none" Style="position: sticky; top: 0; z-index: 99; background-color: var(--mud-palette-background);">
            <div>
            @if (!string.IsNullOrEmpty(Invoice.ProjectGroupId))
            {
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">Back to Project Group</MudButton>
            }
            else
            {
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">Back to Project</MudButton>
            }
            </div>
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudSelect T="string"
                           Value="@Invoice.Status"
                           ValueChanged="UpdateStatusAsync"
                           Disabled="@(!CanApproveInvoice || Invoice.Payments.Any() || Invoice.WriteOffs.Any())"
                           Dense="true"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Style="width: 170px; min-width: 170px; flex-shrink: 0;">
                    @foreach (var status in InvoiceStatus.GetDropdownStatuses(Invoice.Status, Invoice.Payments.Any() || Invoice.WriteOffs.Any()))
                    {
                        <MudSelectItem Value="@status">@status</MudSelectItem>
                    }
                </MudSelect>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="PrintPdf">Print / PDF</MudButton>
                @if (Invoice.Status != InvoiceStatus.Draft)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenPdf">Open PDF</MudButton>
                    @if (CanSendEmail)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Email" OnClick="SendByEmail">Send by Email</MudButton>
                    }
                }
                @if (CanEditInvoice)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="DuplicateInvoice">Duplicate</MudButton>
                }

                @if (CanManageAccounting && (Invoice.Status != InvoiceStatus.Draft || Invoice.Payments.Any() || Invoice.WriteOffs.Any()))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Payments" OnClick="OpenPaymentsDialog">
                        @BizLoc["Payments"]@((Invoice.Payments.Count + Invoice.WriteOffs.Count) > 0 ? $" ({Invoice.Payments.Count + Invoice.WriteOffs.Count})" : "")
                    </MudButton>
                    @if (Invoice.Status != InvoiceStatus.Draft && Invoice.Status != InvoiceStatus.Void && Invoice.BalanceDue > 0)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.AttachMoney" OnClick="RegisterPayment">@BizLoc["Add Payment"]</MudButton>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Balance" OnClick="CloseInvoiceBalance">@BizLoc["Close Balance"]</MudButton>
                    }
                }

                <MudButton Variant="Variant.Outlined"
                           Color="@(Invoice.Status == InvoiceStatus.Draft && CanManageAccounting ? Color.Warning : Color.Default)"
                           StartIcon="@(Invoice.Status == InvoiceStatus.Draft && CanManageAccounting ? Icons.Material.Filled.Edit : (InvoiceStatus.CanUnlockEdit(Invoice.Status) && !Invoice.Payments.Any() && !Invoice.WriteOffs.Any() && CanApproveInvoice ? Icons.Material.Filled.EditNote : Icons.Material.Filled.Visibility))"
                           OnClick="EditInvoice">
                    @(Invoice.Status == InvoiceStatus.Draft && CanManageAccounting
                        ? Loc["Edit"].Value
                        : (InvoiceStatus.CanUnlockEdit(Invoice.Status) && !Invoice.Payments.Any() && !Invoice.WriteOffs.Any() && CanApproveInvoice
                            ? BizLoc["View / Edit"].Value
                            : BizLoc["View Details"].Value))
                </MudButton>

                @if (CanManageAccounting && Invoice.Status == InvoiceStatus.Draft)
                {
                    <MudTooltip Text="Delete Draft">
                        <MudIconButton Variant="Variant.Outlined" Icon="@Icons.Material.Filled.Delete" Color="Color.Error" OnClick="DeleteInvoice" />
                    </MudTooltip>
                }
            </div>
        </div>

        <style>
            .markdown-content p {
                margin-top: 0;
                margin-bottom: 0.25rem;
            }
            .markdown-content p:last-child {
                margin-bottom: 0;
            }
        </style>

        <MudPaper Class="mx-auto overflow-hidden" Style="max-width: 8.5in; width: 100%; min-height: 11in;" Elevation="3" id="printable-area">

            <div class="print-footer-custom">
                <span>@Profile.CompanyName</span>
                <span>Ref: @Invoice.InvoiceNumber</span>
            <span data-page-number style="display:none">{page} / {pages}</span>
            </div>

            <div class="print-body">

                <div class="d-flex justify-space-between align-start mb-4 keep-together">
                    <div style="max-width: 50%;">
                        <div style="height: 70px; display: flex; align-items: center;" class="mb-2">
                        @if (Profile.HasCustomLogo)
                        {
                            <MudImage Src="@($"/spokesapi/Media/Logo?v={Profile.LogoVersion}")" Height="70" ObjectFit="ObjectFit.Contain" />
                        }
                        else
                        {
                            <MudAvatar Rounded="true" Style="@($"width: 60px; height: 60px; font-size: 2rem; color: white; background-color: {Profile.PrimaryColor}; -webkit-print-color-adjust: exact;")">
                                @Profile.CompanyName.Substring(0, 1)
                            </MudAvatar>
                        }
                        </div>
                        <MudText Typo="Typo.h6" Style="font-weight: 700;">@Profile.CompanyName</MudText>
                        <MudText Typo="Typo.body2">@Profile.AddressStreet</MudText>
                        <MudText Typo="Typo.body2">@Profile.AddressCity, @Profile.AddressState @Profile.AddressZip</MudText>
                        <MudText Typo="Typo.body2">@Profile.Website</MudText>
                    </div>

                    <div class="d-flex flex-column align-end">
                        <div style="height: 70px; display: flex; align-items: center; justify-content: flex-end;" class="mb-2">
                            <MudText Typo="Typo.h3" Style="@($"color: {Profile.PrimaryColor}; font-weight: 300;")">@Template.Label_Invoice</MudText>
                        </div>
                        <MudText Typo="Typo.h6" Style="@($"color: {Profile.SecondaryColor};")">#@Invoice.InvoiceNumber</MudText>
                        <MudText Typo="Typo.body2">@Template.Label_Date: @Invoice.Date.ToString(!string.IsNullOrEmpty(Template.DateFormat) ? Template.DateFormat : "yyyy-MM-dd")</MudText>
                        <MudText Typo="Typo.body2">@Template.Label_DueDate: @Invoice.DueDate.ToString(!string.IsNullOrEmpty(Template.DateFormat) ? Template.DateFormat : "yyyy-MM-dd")</MudText>
                    @if (!string.IsNullOrEmpty(Project?.ProjectNumber))
                    {
                        <MudText Typo="Typo.body2">@Template.Label_ProjectNumber @Project?.ProjectNumber</MudText>
                    }

                    @if (InvoiceStatus.IsSettled(Invoice.Status))
                    {
                        <div class="mt-2 px-3 py-1 rounded" style="@($"background-color: {GetStatusColor()}; color: white; font-size: 0.8rem; font-weight: bold; -webkit-print-color-adjust: exact;")">
                            @(string.Equals(Invoice.Status, InvoiceStatus.Paid, StringComparison.OrdinalIgnoreCase) && !string.IsNullOrWhiteSpace(Template.Label_Paid)
                                ? Template.Label_Paid
                                : Invoice.Status.ToUpper())
                        </div>
                    }

                    </div>
                </div>

                <MudDivider Class="my-4" />

                <div class="d-flex justify-space-between align-start mb-4 keep-together">
                    <div style="max-width: 50%;">
                        <MudText Typo="Typo.subtitle2" Style="@($"color: {Profile.SecondaryColor}; text-transform: uppercase; letter-spacing: 1px; font-weight: bold;")">@Template.Label_BillTo</MudText>
                        <MudText Typo="Typo.h6">@Project?.Client.BusinessName</MudText>
                        <MudText Typo="Typo.body2">@Project?.Client.ContactPersonPrefix @Project?.Client.ContactPersonName</MudText>
                        <MudText Typo="Typo.body2">@Project?.Client.BusinessAddressNumber @Project?.Client.BusinessAddressStreet</MudText>
                        <MudText Typo="Typo.body2">@Project?.Client.BusinessAddressCity, @Project?.Client.BusinessAddressZip</MudText>
                    </div>

                @if (!string.IsNullOrEmpty(ProjectManagerName))
                {
                    <div class="d-flex flex-column align-end" style="max-width: 50%; text-align: right;">
                        <MudText Typo="Typo.subtitle2" Style="@($"color: {Profile.SecondaryColor}; font-weight: bold;")">@Template.Label_ProjectManager</MudText>
                        <MudText Typo="Typo.body2">@ProjectManagerName</MudText>

                        @if (!string.IsNullOrEmpty(ProjectManagerEmail))
                        {
                            <MudText Typo="Typo.body2">@ProjectManagerEmail</MudText>
                        }
                    </div>
                }
                </div>

                @if (!string.IsNullOrEmpty(Invoice.Note))
                {
                    <div class="mb-4 pa-3 keep-together" style="@($"background-color: #f8f9fa; border-left: 4px solid {(string.IsNullOrEmpty(Profile.PrimaryColor) ? "var(--mud-palette-primary)" : Profile.PrimaryColor)}; border-radius: 2px; -webkit-print-color-adjust: exact;")">
                        <MudText Typo="Typo.body2" Style="white-space: pre-line;">@Invoice.Note</MudText>
                    </div>
                }

                <div class="allow-break">
                    <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; table-layout: fixed;">
                        <thead class="keep-together keep-with-next repeat-on-break">
                            <tr class="mud-table-row">
                                <th class="mud-table-cell" style="text-align: left; font-weight: bold; padding: 12px 8px 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); width: 40px; white-space: nowrap;">@(!string.IsNullOrEmpty(Template.Label_ItemNumber) ? Template.Label_ItemNumber : "#")</th>
                                <th class="mud-table-cell" style="text-align: left; font-weight: bold; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); word-wrap: break-word; overflow-wrap: break-word;">@Template.Label_Description</th>
                            @if (HasTransparency)
                            {
                                    <th class="mud-table-cell" style="text-align: right; font-weight: bold; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); width: 100px;">Cost</th>
                                    <th class="mud-table-cell" style="text-align: right; font-weight: bold; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); width: 80px;">Markup</th>
                            }
                                <th class="mud-table-cell" style="text-align: right; font-weight: bold; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); width: 80px;">@Template.Label_Quantity</th>
                                <th class="mud-table-cell" style="text-align: right; font-weight: bold; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); width: 100px;">@Template.Label_Price</th>
                                <th class="mud-table-cell" style="text-align: right; font-weight: bold; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); width: 100px;">@Template.Label_Total</th>
                            </tr>
                        </thead>
                        <tbody class="allow-break">
                            @{ var rowIndex = 0; }
                            @foreach (var line in Invoice.LineItems)
                            {
                                var rowClass = rowIndex % 2 == 1 ? "background-color: rgba(0,0,0,0.02);" : "";
                                <tr class="mud-table-row keep-together" style="@rowClass">
                                    <td class="mud-table-cell" style="padding: 12px 8px 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines); width: 40px; white-space: nowrap;">@(rowIndex + 1)</td>
                                    <td class="mud-table-cell" style="padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines);">@GetTranslatedDescription(line)</td>
                                @if (HasTransparency)
                                {
                                        <td class="mud-table-cell" style="text-align: right; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines);">
                                            @(line.OriginalUnitCost > 0 ? FormatMoney(line.OriginalUnitCost) : "-")
                                        </td>
                                        <td class="mud-table-cell" style="text-align: right; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines);">
                                            @(line.MarkupPercentage > 0 ? $"{line.MarkupPercentage:P0}" : "-")
                                        </td>
                                }
                                    <td class="mud-table-cell" style="text-align: right; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines);">@line.Quantity.ToString("G29")</td>
                                    <td class="mud-table-cell" style="text-align: right; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines);">@FormatMoney(line.UnitPrice)</td>
                                    <td class="mud-table-cell" style="text-align: right; padding: 12px 16px; border-bottom: 1px solid var(--mud-palette-table-lines);">@FormatMoney(line.Total)</td>
                                </tr>
                                rowIndex++;
                            }
                        </tbody>
                    </table>
                </div>

                <div class="print-row mt-8 d-flex keep-together" style="gap: 20px;">

                    <div class="print-col-6" style="flex: 1;">
                    @if (!string.IsNullOrEmpty(Invoice.PaymentTerms))
                    {
                        <MudPaper Class="pa-3 mb-2" Style="background-color: #f8f9fa; -webkit-print-color-adjust: exact; print-color-adjust: exact;" Elevation="0">
                            <MudText Typo="Typo.subtitle2" Class="mb-1" Style="@($"color: {Profile.PrimaryColor};")"><b>@Template.Label_PaymentTerms</b></MudText>
                            <div class="markdown-content allow-break" style="font-size: 0.85rem; color: #444;">
                                @RenderMarkdown(Invoice.PaymentTerms)
                            </div>
                        </MudPaper>
                    }
                    @{
                        var taxRegs = JurisdictionService.GetCompanyTaxRegistrations();
                    }
                    @if (!string.IsNullOrEmpty(Template.PaymentInstructions) || !string.IsNullOrEmpty(Template.BankAccountNumber) || taxRegs.Count > 0)
                    {
                        <MudPaper Class="pa-3" Style="background-color: #f8f9fa; -webkit-print-color-adjust: exact; print-color-adjust: exact;" Elevation="0">
                            @if (!string.IsNullOrEmpty(Template.PaymentInstructions))
                            {
                                <MudText Typo="Typo.subtitle2" Class="mb-1" Style="@($"color: {Profile.PrimaryColor};")"><b>@Template.Label_PaymentInstructions</b></MudText>
                                <MudText Typo="Typo.caption" Style="white-space: pre-line;">@Template.PaymentInstructions</MudText>
                            }

                            @if (!string.IsNullOrEmpty(Template.BankName))
                            {
                                <MudDivider Class="my-2" />
                                <MudText Typo="Typo.caption"><b>@Template.Label_BankName:</b> @Template.BankName</MudText>
                                <MudText Typo="Typo.caption" Class="d-block"><b>@Template.Label_SwiftCode:</b> @Template.BankSwiftCode</MudText>
                                <MudText Typo="Typo.caption" Class="d-block"><b>@Template.Label_BankAccount:</b> @Template.BankAccountNumber</MudText>
                            }

                            @if (taxRegs.Count > 0)
                            {
                                @if (!string.IsNullOrEmpty(Template.PaymentInstructions) || !string.IsNullOrEmpty(Template.BankName))
                                {
                                    <MudDivider Class="my-2" />
                                }
                                @foreach (var reg in taxRegs)
                                {
                                    <MudText Typo="Typo.caption" Class="d-block"><b>@reg.Label</b> @reg.Number</MudText>
                                }
                            }
                        </MudPaper>
                    }
                    </div>

                    <div class="print-col-6" style="flex: 1;">
                        <div class="d-flex justify-space-between mb-1">
                            <MudText>@Template.Label_Subtotal:</MudText>
                            <MudText>@FormatMoney(Invoice.SubTotal)</MudText>
                        </div>
                        <div class="d-flex justify-space-between mb-1">
                            <MudText>@Template.Label_Tax (@FinancialCalculationEngine.FormatTaxRatePercent(Invoice.TaxRate)%):</MudText>
                            <MudText>@FormatMoney(Invoice.TaxAmount)</MudText>
                        </div>

                        <MudDivider Class="my-2" />

                        <div class="d-flex justify-space-between mb-1">
                            <MudText Typo="Typo.h6" Style="@($"color: {Profile.PrimaryColor}; font-weight: bold;")">@Template.Label_GrandTotal:</MudText>
                            <MudText Typo="Typo.h6" Style="@($"color: {Profile.PrimaryColor}; font-weight: bold;")">@FormatMoney(Invoice.GrandTotal)</MudText>
                        </div>

                    @if (Invoice.AmountPaid > 0 || Invoice.AmountWrittenOff > 0)
                    {
                        @if (Invoice.AmountPaid > 0)
                        {
                                <div class="d-flex justify-space-between mb-1 mt-2" style="color: green;">
                                    <MudText>@(!string.IsNullOrWhiteSpace(Template.Label_AmountPaid) ? Template.Label_AmountPaid : "Amount Paid"):</MudText>
                                    <MudText>(- @FormatMoney(Invoice.AmountPaid))</MudText>
                                </div>
                        }
                        @if (Invoice.AmountWrittenOff > 0)
                        {
                                <div class="d-flex justify-space-between mb-1 @(Invoice.AmountPaid <= 0 ? "mt-2" : "")" style="color: #607d8b;">
                                    <MudText>@BizLoc["Balance Adjustment"]:</MudText>
                                    <MudText>(- @FormatMoney(Invoice.AmountWrittenOff))</MudText>
                                </div>
                        }
                        @if (Invoice.DatePaid.HasValue)
                        {
                                        <div class="d-flex justify-space-between mb-1" style="@($"color: {GetStatusColor()};")">
                                            <MudText>@(!string.IsNullOrWhiteSpace(Template.Label_DateReceived) ? Template.Label_DateReceived : "Date Received"):</MudText>
                                            <MudText>@Invoice.DatePaid.Value.ToString(!string.IsNullOrEmpty(Template.DateFormat) ? Template.DateFormat : "yyyy-MM-dd")</MudText>
                                        </div>
                        }
                                <MudDivider Class="my-2" />
                                <div class="d-flex justify-space-between mb-1">
                                    <MudText Typo="Typo.h6" Style="@($"color: {Profile.SecondaryColor}; font-weight: bold;")">@(!string.IsNullOrWhiteSpace(Template.Label_BalanceDue) ? Template.Label_BalanceDue : "Balance Due"):</MudText>
                                    <MudText Typo="Typo.h6" Style="@($"color: {Profile.SecondaryColor}; font-weight: bold;")">@FormatMoney(Invoice.BalanceDue)</MudText>
                                </div>
                    }
                    </div>
                </div>

            </div>
        </MudPaper>
        </MudContainer>
}

@code {
    [Parameter] public string ProjectId { get; set; } = "";
    [Parameter] public string GroupId { get; set; } = "";
    [Parameter] public string InvoiceId { get; set; } = "";

    private Project? Project;
    private Invoice? Invoice;
    private CompanyProfile? Profile;
    private DocumentTemplate? Template;
    private string ProjectManagerName = "";
    private string ProjectManagerEmail = "";
    private bool HasTransparency => Invoice?.HideCostAndMarkup == true && Invoice.LineItems.Any(l => l.MarkupPercentage > 0);
    private bool CanManageAccounting;
    private bool CanEditInvoice;
    private bool CanApproveInvoice;
    private bool _canUseEmail;
    private bool CanSendEmail => CanApproveInvoice && _canUseEmail && !string.Equals(Profile?.Edition, "Family", StringComparison.OrdinalIgnoreCase);
    private string? _authorizedProjectId;
    private string? _authorizedGroupId;
    private string? _authorizedInvoiceId;
    private string _currentUserName = "System";

    private const int PageHeight = 940;
    private bool _needsPagination;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Invoice != null && Profile != null)
        {
            try { await JS.InvokeVoidAsync("paginateSections", "printable-area", PageHeight); }
            catch { /* pagination failed, single-page fallback */ }
        }
        else if (_needsPagination && Invoice != null && Profile != null)
        {
            _needsPagination = false;
            try { await JS.InvokeVoidAsync("paginateSections", "printable-area", PageHeight); }
            catch { /* pagination failed, single-page fallback */ }
        }
    }

    private async Task RefreshViewer()
    {
        try { await JS.InvokeVoidAsync("cleanupPagination", "printable-area"); } catch {}
        _needsPagination = true;
        await InvokeAsync(StateHasChanged);
    }

    public async ValueTask DisposeAsync()
    {
        try { await JS.InvokeVoidAsync("cleanupPagination", "printable-area"); }
        catch { /* component already disposed or JS unavailable */ }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_authorizedProjectId, ProjectId, StringComparison.Ordinal) ||
            !string.Equals(_authorizedGroupId, GroupId, StringComparison.Ordinal) ||
            !string.Equals(_authorizedInvoiceId, InvoiceId, StringComparison.Ordinal))
        {
            if (_authorizedInvoiceId != null && _authorizedInvoiceId != InvoiceId)
            {
                try { await JS.InvokeVoidAsync("cleanupPagination", "printable-area"); } catch { }
                _needsPagination = true;
            }

            Project = null;
            Invoice = null;
            Profile = null;
            Template = null;
            ProjectManagerName = "";
            ProjectManagerEmail = "";
            CanManageAccounting = false;
            CanEditInvoice = false;
            CanApproveInvoice = false;
            _canUseEmail = false;
            _authorizedProjectId = null;
            _authorizedGroupId = null;
            _authorizedInvoiceId = null;
        }

        // Use UserService for consistent permission checking
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null)
        {
            Nav.NavigateTo("/projects");
            return;
        }

        var canAccountingRead = emp.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: true);
        CanApproveInvoice = emp.HasPermission(AppPermissions.Finance.ApproveInvoices);
        CanManageAccounting = emp.HasPermission(AppPermissions.Finance.AccessAccounting) || CanApproveInvoice;
        CanEditInvoice = CanManageAccounting;
        _canUseEmail = emp.HasPermission(AppPermissions.Email.Use);
        _currentUserName = emp.FullName ?? emp.Email ?? "System";

        var loadedInvoice = string.IsNullOrEmpty(InvoiceId) ? null : Db.Invoices.GetById(InvoiceId);
        if (loadedInvoice == null)
        {
            Nav.NavigateTo("/projects");
            return;
        }

        if (!string.IsNullOrEmpty(GroupId))
        {
            var group = Db.ProjectGroups.GetById(GroupId);
            if (group == null || !string.Equals(loadedInvoice.ProjectGroupId, GroupId, StringComparison.OrdinalIgnoreCase))
            {
                Nav.NavigateTo("/projects");
                return;
            }

            var groupProjects = group.ProjectIds
                .Select(pid => Db.Projects.GetById(pid))
                .Where(p => p != null)
                .Cast<Project>()
                .ToList();

            bool canViewGroup = canAccountingRead ||
                                CanApproveInvoice ||
                                (groupProjects.Any() && groupProjects.All(gp => UserService.CanViewProject(emp, gp, allowAccountingFinancialRead: true)));

            if (!canViewGroup)
            {
                Nav.NavigateTo("/projects");
                return;
            }

            Project = (!string.IsNullOrEmpty(loadedInvoice.ProjectId) ? Db.Projects.GetById(loadedInvoice.ProjectId) : null)
                      ?? groupProjects.FirstOrDefault();
            if (string.IsNullOrEmpty(ProjectId) && Project != null)
            {
                ProjectId = Project.Id;
            }
        }
        else
        {
            var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
            if (liveProject == null || !UserService.CanViewProject(emp, liveProject, allowAccountingFinancialRead: true))
            {
                Nav.NavigateTo("/projects");
                return;
            }

            bool belongsToProject = string.Equals(loadedInvoice.ProjectId, liveProject.Id, StringComparison.OrdinalIgnoreCase);
            bool groupAccessOk = true;
            if (!belongsToProject && !string.IsNullOrEmpty(loadedInvoice.ProjectGroupId))
            {
                var group = Db.ProjectGroups.GetById(loadedInvoice.ProjectGroupId);
                belongsToProject = group != null && group.ProjectIds.Contains(liveProject.Id);
                if (belongsToProject && group != null && !canAccountingRead && !CanApproveInvoice)
                {
                    var groupProjects = group.ProjectIds
                        .Select(pid => Db.Projects.GetById(pid))
                        .Where(p => p != null)
                        .Cast<Project>()
                        .ToList();
                    groupAccessOk = groupProjects.Any() && groupProjects.All(gp => UserService.CanViewProject(emp, gp, allowAccountingFinancialRead: true));
                }
            }

            if (!belongsToProject || !groupAccessOk)
            {
                Nav.NavigateTo("/projects");
                return;
            }

            Project = liveProject;
        }

        _authorizedProjectId = ProjectId;
        _authorizedGroupId = GroupId;
        _authorizedInvoiceId = loadedInvoice.Id;
        Invoice = loadedInvoice;
        Profile = Db.CompanyProfile.Get();

        if (Invoice != null && !string.IsNullOrEmpty(Invoice.TemplateId))
        {
            Template = Db.DocumentTemplates.GetById(Invoice.TemplateId);
        }

        if (Template == null && Project != null && !string.IsNullOrEmpty(Project.DefaultTemplateId))
        {
            Template = Db.DocumentTemplates.GetById(Project.DefaultTemplateId);
        }
        if (Template == null) Template = Db.DocumentTemplates.GetDefault();

        ProjectManagerName = "";
        ProjectManagerEmail = "";
        if (Project != null && !string.IsNullOrEmpty(Project.ProjectManagerId))
        {
            var pm = Db.Employees.GetById(Project.ProjectManagerId);
            if (pm != null)
            {
                ProjectManagerName = pm.FullName;
                ProjectManagerEmail = pm.IsEmailPublic ? pm.Email : string.Empty;
            }
        }
    }

    private string FormatMoney(decimal amount)
    {
        var symbol = Template?.CurrencySymbol ?? "$";
        return Template?.CurrencySymbolAfter == true
            ? $"{amount.ToString("N2")}{symbol}"
            : $"{symbol}{amount.ToString("N2")}";
    }
