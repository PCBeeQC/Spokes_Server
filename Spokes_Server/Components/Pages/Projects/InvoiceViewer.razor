    private MarkupString RenderMarkdown(string text)
    {
        if (string.IsNullOrEmpty(text)) return default;
        try
        {
            // Preserve multiple blank lines
            text = text.Replace("\r\n", "\n").Replace("\r", "\n");
            text = System.Text.RegularExpressions.Regex.Replace(text, @"\n{3,}", match => 
                "\n\n" + string.Join("", System.Linq.Enumerable.Repeat("<div style=\"height: 1rem;\"></div>\n\n", match.Length - 2)));

            var html = MarkdownSanitizer.RenderSanitizedHtml(text);
            return new MarkupString(FileUrls.SignHtmlFileUrls(html));
        }
        catch (Exception)
        {
            return new MarkupString(System.Net.WebUtility.HtmlEncode(text)); // Fallback to encoded text
        }
    }
    private string GetStatusColor() => Invoice?.Status switch { InvoiceStatus.Paid => "#4caf50", InvoiceStatus.WrittenOff => "#607d8b", InvoiceStatus.Partial => "#ff9800", InvoiceStatus.Draft => "#9e9e9e", _ => "#2196f3" };

    private string GetTranslatedDescription(InvoiceLine line)
    {
        string desc = line.Description;
        if (Template != null && !string.IsNullOrEmpty(Template.TaskTranslationLanguage) && !string.IsNullOrEmpty(line.WorkTypeId))
        {
            var workType = Db.WorkTypes.GetById(line.WorkTypeId);
            if (workType != null)
            {
                string taskLabel = TimesheetSearchHelper.FormatTranslatedTaskAndSubTask(
                    workType.Name,
                    null,
                    line.SubTaskId,
                    workType,
                    Template.TaskTranslationLanguage,
                    separator: ": ");

                desc = $"{taskLabel} {Template.Label_ItemLaborTag}".Trim();
            }
        }

        if (!string.IsNullOrWhiteSpace(line.Note) && !desc.EndsWith($"({line.Note.Trim()})", StringComparison.OrdinalIgnoreCase))
        {
            return $"{desc} ({line.Note.Trim()})";
        }

        return desc;
    }

    private bool HasConsumedPrepaymentCredits(Invoice invoice)
        => AccountingService.HasConsumedPrepaymentCredits(invoice);

    private async Task<(Spokes_Server.Core.Models.HR.Employee Actor, Invoice Invoice)?> AuthorizeInvoiceMutationAsync(bool requireApprove = false, bool requireDraft = false)
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveInvoice = string.IsNullOrEmpty(InvoiceId) ? null : Db.Invoices.GetById(InvoiceId);
        if (emp == null || liveInvoice == null || !CanEmployeeViewInvoiceScope(emp, liveInvoice))
        {
            CanManageAccounting = false;
            CanEditInvoice = false;
            CanApproveInvoice = false;
            _canUseEmail = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        var canApprove = emp.HasPermission(AppPermissions.Finance.ApproveInvoices);
        var canManage = emp.HasPermission(AppPermissions.Finance.AccessAccounting) || canApprove;
        if (requireApprove ? !canApprove : !canManage)
        {
            CanApproveInvoice = canApprove;
            CanManageAccounting = canManage;
            CanEditInvoice = canManage;
            _canUseEmail = emp.HasPermission(AppPermissions.Email.Use);
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        if (requireDraft && !string.Equals(liveInvoice.Status, InvoiceStatus.Draft, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Only draft invoices can be deleted.", Severity.Warning);
            return null;
        }

        _currentUserName = emp.FullName ?? emp.Email ?? _currentUserName;
        return (emp, liveInvoice);
    }

    private bool CanEmployeeViewInvoiceScope(Spokes_Server.Core.Models.HR.Employee emp, Invoice inv)
    {
        if (!string.IsNullOrEmpty(inv.ProjectGroupId))
        {
            var group = Db.ProjectGroups.GetById(inv.ProjectGroupId);
            if (group == null) return false;
            var groupProjects = group.ProjectIds
                .Select(pid => Db.Projects.GetById(pid))
                .Where(p => p != null)
                .Cast<Project>()
                .ToList();
            return groupProjects.Any() && groupProjects.All(gp => UserService.CanViewProject(emp, gp, allowAccountingFinancialRead: true));
        }

        var targetProjectId = !string.IsNullOrEmpty(inv.ProjectId) ? inv.ProjectId : ProjectId;
        var project = string.IsNullOrEmpty(targetProjectId) ? null : Db.Projects.GetById(targetProjectId);
        return project != null && UserService.CanViewProject(emp, project, allowAccountingFinancialRead: true);
    }

