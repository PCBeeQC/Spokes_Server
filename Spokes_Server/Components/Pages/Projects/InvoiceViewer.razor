    private async Task CloseInvoiceBalance()
    {
        var auth = await AuthorizeInvoiceMutationAsync();
        if (auth == null) return;
        var liveInvoice = auth.Value.Invoice;
        if (liveInvoice.Status == InvoiceStatus.Draft || liveInvoice.Status == InvoiceStatus.Void || liveInvoice.BalanceDue <= 0)
        {
            return;
        }

        var parameters = new DialogParameters<WriteOffBalanceDialog>
        {
            { x => x.DocumentTypeLabel, BizLoc["Invoice"].Value },
            { x => x.DocumentNumber, liveInvoice.InvoiceNumber },
            { x => x.PartyLabel, BizLoc["Client"].Value },
            { x => x.PartyName, Project?.Client?.BusinessName ?? Project?.DisplayName ?? "-" },
            { x => x.TotalAmount, liveInvoice.GrandTotal },
            { x => x.AmountPaid, liveInvoice.AmountPaid },
            { x => x.RemainingBalance, liveInvoice.BalanceDue },
            { x => x.IsReceivable, true }
        };

        var dialog = await DialogService.ShowAsync<WriteOffBalanceDialog>(
            BizLoc["Close / Write Off Balance"].Value,
            parameters,
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: BalanceWriteOff writeOff })
        {
            try
            {
                var saveAuth = await AuthorizeInvoiceMutationAsync();
                if (saveAuth == null) return;
                AccountingService.RecordInvoiceWriteOff(saveAuth.Value.Invoice, writeOff, _currentUserName, saveAuth.Value.Actor);
                Invoice = Db.Invoices.GetById(saveAuth.Value.Invoice.Id);
                Snackbar.Add(string.Format(BizLoc["Closed balance of {0} without creating a bank transaction."].Value, writeOff.Amount.ToString("C2")), Severity.Success);
                await RefreshViewer();
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Warning);
            }
        }
    }

    private async Task UpdateStatusAsync(string newStatus)
    {
        if (Invoice == null || newStatus == Invoice.Status) return;

        var preAuth = await AuthorizeInvoiceMutationAsync(requireApprove: true);
        if (preAuth == null)
        {
            StateHasChanged();
            return;
        }
        var liveInvoice = preAuth.Value.Invoice;

        if ((liveInvoice.Payments.Any() || liveInvoice.WriteOffs.Any()) && newStatus == InvoiceStatus.Draft)
        {
            Snackbar.Add(BizLoc["Cannot revert an invoice with recorded payments or write-offs to Draft. Remove them first."].Value, Severity.Warning);
            StateHasChanged();
            return;
        }

        if (InvoiceStatus.IsSettled(liveInvoice.Status) && !InvoiceStatus.IsSettled(newStatus) && HasConsumedPrepaymentCredits(liveInvoice))
        {
            Snackbar.Add(BizLoc["Cannot revert a paid prepayment invoice while its credits are applied to other invoices."].Value, Severity.Warning);
            StateHasChanged();
            return;
        }

        var oldStatus = liveInvoice.Status;
        var requiresReason = InvoiceStatus.RequiresReason(oldStatus, newStatus);
        string? reason = null;

        if (requiresReason)
        {
            var parameters = new DialogParameters<ConfirmDialog>
            {
                { x => x.ContentText, string.Format(BizLoc["Please provide a reason for changing the invoice status from {0} to {1}."].Value, oldStatus, newStatus) },
                { x => x.ButtonText, BizLoc["Confirm Status Change"].Value },
                { x => x.Color, Color.Warning },
                { x => x.ShowReasonInput, true },
                { x => x.ReasonRequired, true },
                { x => x.ReasonLabel, BizLoc["Reason for status change"].Value },
                { x => x.ReasonPlaceholder, BizLoc["Explain why this invoice status is being reverted..."].Value }
            };

            var dialog = await DialogService.ShowAsync<ConfirmDialog>(BizLoc["Confirm Status Change"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var result = await dialog.Result;
            if (result == null || result.Canceled || string.IsNullOrWhiteSpace(result.Data as string))
            {
                StateHasChanged();
                return;
            }

            reason = (result.Data as string)?.Trim();
        }

        var saveAuth = await AuthorizeInvoiceMutationAsync(requireApprove: true);
        if (saveAuth == null)
        {
            StateHasChanged();
            return;
        }
        liveInvoice = saveAuth.Value.Invoice;
        var emp = saveAuth.Value.Actor;
        if (liveInvoice.Status == newStatus) return;

        liveInvoice.Status = newStatus;
        liveInvoice.History.Add(new DocumentHistoryEntry
        {
            Timestamp = DateTime.UtcNow,
            Action = requiresReason ? DocumentHistoryActions.StatusReverted : DocumentHistoryActions.StatusChanged,
            OldStatus = oldStatus,
            NewStatus = newStatus,
            ChangedBy = _currentUserName,
            Summary = requiresReason
                ? $"Reverted status from {oldStatus} to {newStatus}"
                : $"Changed status from {oldStatus} to {newStatus}",
            Reason = reason
        });

        Invoice = liveInvoice;
        if (oldStatus != InvoiceStatus.Draft && newStatus == InvoiceStatus.Draft)
        {
            if (!string.IsNullOrEmpty(Invoice.PdfPath) && System.IO.File.Exists(Invoice.PdfPath))
            {
                try { System.IO.File.Delete(Invoice.PdfPath); } catch { }
            }
            Invoice.PdfPath = "";
            Db.Invoices.Save(Invoice);
        }
        else if (oldStatus == InvoiceStatus.Draft && newStatus == InvoiceStatus.Final)
        {
            Db.Invoices.Save(Invoice);
            await EnsurePdfExistsAsync();
        }
        else
        {
            Db.Invoices.Save(Invoice);
        }
        AccountingService.ProcessInvoiceStatusChange(Invoice, oldStatus, newStatus, _currentUserName, emp);
        Snackbar.Add($"Status updated to {newStatus}", Severity.Success);
        
        await RefreshViewer();
    }

    private async Task DeleteInvoice()
    {
        var preAuth = await AuthorizeInvoiceMutationAsync(requireDraft: true);
        if (preAuth == null) return;
        var targetInvoice = preAuth.Value.Invoice;

        if (HasConsumedPrepaymentCredits(targetInvoice))
        {
            Snackbar.Add("Cannot delete a prepayment invoice while its credits are applied to other invoices.", Severity.Warning);
            return;
        }
        var result = await DialogService.ShowMessageBoxAsync("Delete Invoice?", "Deleting this draft will release all linked time entries.", yesText: "Delete", cancelText: "Cancel");
        if (result == true)
        {
            var deleteAuth = await AuthorizeInvoiceMutationAsync(requireDraft: true);
            if (deleteAuth == null) return;
            if (HasConsumedPrepaymentCredits(deleteAuth.Value.Invoice))
            {
                Snackbar.Add("Cannot delete a prepayment invoice while its credits are applied to other invoices.", Severity.Warning);
                return;
            }
            Db.Invoices.Delete(deleteAuth.Value.Invoice.Id);
            Snackbar.Add("Invoice deleted", Severity.Success);
            GoBack();
        }
    }

