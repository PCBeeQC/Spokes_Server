    private void UpdateStatus(string newStatus)
    {
        _ = UpdateStatusAsync(newStatus);
    }

    private string GetTranslatedTaskName(QuoteLaborItem labor)
    {
        var taskName = labor.WorkTypeName;
        var subTaskName = labor.SubTaskName;

        if (Template != null && !string.IsNullOrEmpty(Template.TaskTranslationLanguage))
        {
            var lang = Template.TaskTranslationLanguage;
            var workType = Db.WorkTypes.GetById(labor.WorkTypeId);
            if (workType != null)
            {
                if (workType.NameTranslations != null && workType.NameTranslations.TryGetValue(lang, out var taskTrans) && !string.IsNullOrWhiteSpace(taskTrans))
                {
                    taskName = taskTrans;
                }
                
                if (!string.IsNullOrEmpty(labor.SubTaskId))
                {
                    var subTask = workType.SubTasks.FirstOrDefault(s => s.Id == labor.SubTaskId);
                    if (subTask != null && subTask.NameTranslations != null && subTask.NameTranslations.TryGetValue(lang, out var subTaskTrans) && !string.IsNullOrWhiteSpace(subTaskTrans))
                    {
                        subTaskName = subTaskTrans;
                    }
                }
            }
        }

        return string.IsNullOrEmpty(subTaskName) || subTaskName == "General" ? taskName : $"{taskName} : {subTaskName}";
    }

    private async Task UpdateStatusAsync(string newStatus)
    {
        try
        {
            // Admin-only revert from Final to Draft
            if (Quote.Status == "Final" && newStatus == "Draft" && !_isAdmin)
            {
                Snackbar.Add("Only administrators can revert a finalized document to draft.", Severity.Warning);
                return;
            }

            var oldStatus = Quote.Status;
            Quote.Status = newStatus;

            if (oldStatus == "Final" && newStatus == "Draft")
            {
                if (!string.IsNullOrEmpty(Quote.PdfPath) && System.IO.File.Exists(Quote.PdfPath))
                {
                    try
                    {
                        System.IO.File.Delete(Quote.PdfPath);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Failed to delete old PDF upon reverting to draft");
                    }
                }
                Quote.PdfPath = string.Empty;
            }
            else if (oldStatus != "Final" && newStatus == "Final")
            {
                Snackbar.Add("Generating PDF document...", Severity.Info);
                Quote.PdfPath = await PdfService.GenerateQuotePdfAsync(Quote, ProjectId, Nav.BaseUri);
            }

            Db.Quotes.Save(Quote);
            Spokes_Server.Core.Services.Projects.TimelineEventHelper.ProcessQuoteStatusChange(Db, Quote, oldStatus, newStatus, null);
            Logger.LogInformation("Updated Quote Status to {Status}", newStatus);
            Snackbar.Add($"Status updated to {newStatus}", Severity.Success);
            
            await RefreshViewer();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to update status");
            Snackbar.Add("Failed to save status", Severity.Error);
        }
    }

    private async Task EditQuote()
    {
        try
        {
            var parameters = new DialogParameters { ["Quote"] = Quote, ["ProjectId"] = ProjectId };
            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true };

            var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Pages.Projects.Tabs.QuoteEditorDialog>("Edit Quote",
            parameters, options);
            var result = await dialog.Result;
            if (!result.Canceled)
            {
                Db.Quotes.Save((Quote)result.Data);
                // Refresh local state
                Quote = Db.Quotes.GetByProject(ProjectId).FirstOrDefault(q => q.Id == QuoteId);
                
                // Re-evaluate template in case it changed
                if (!string.IsNullOrEmpty(Quote?.TemplateId))
                {
                    Template = Db.DocumentTemplates.GetById(Quote.TemplateId);
                }
                else if (Project != null && !string.IsNullOrEmpty(Project.DefaultTemplateId))
                {
                    Template = Db.DocumentTemplates.GetById(Project.DefaultTemplateId);
                }
                else
                {
                    Template = Db.DocumentTemplates.GetDefault();
                }

                Logger.LogInformation("Quote edited and saved.");
                await RefreshViewer();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error opening Edit Dialog");
        }
    }

