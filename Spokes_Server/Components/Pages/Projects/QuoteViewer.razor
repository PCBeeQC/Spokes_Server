    private async Task DuplicateQuote()
    {
        var result = await DialogService.ShowMessageBoxAsync("Duplicate Quote", "Are you sure you want to create a copy of this quote?", yesText: "Duplicate", cancelText: "Cancel");
        if (result != true) return;

        try 
        {
            // 1. Clone via serialization to ensure deep copy
            var json = System.Text.Json.JsonSerializer.Serialize(Quote);
            var newQuote = System.Text.Json.JsonSerializer.Deserialize<Quote>(json);
            
            // 2. Update Metadata
            newQuote.Id = Guid.NewGuid().ToString();
            newQuote.QuoteNumber = Db.Quotes.GenerateQuoteNumber(Profile?.QuotePrefix ?? "EST-");
            newQuote.Date = DateTime.Today;
            newQuote.Status = "Draft";
            newQuote.Title = $"{Quote.Title} (Copy)";
            
            // 3. Save
            Db.Quotes.Save(newQuote);
            
            // 4. Navigate
            Snackbar.Add("Quote Duplicated Successfully", Severity.Success);
            Nav.NavigateTo($"/projects/{ProjectId}/quotes/{newQuote.Id}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error duplicating quote");
            Snackbar.Add("Failed to duplicate quote", Severity.Error);
        }
    }

    private async Task DeleteQuote()
    {
        var result = await DialogService.ShowMessageBoxAsync("Delete Quote", "Are you sure you want to delete this draft quote?", yesText: "Delete", cancelText: "Cancel");
        if (result != true) return;

        try
        {
            Db.Quotes.Delete(QuoteId);
            Snackbar.Add("Quote deleted successfully", Severity.Success);
            Nav.NavigateTo($"/projects/{ProjectId}?tab=quote");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error deleting quote");
            Snackbar.Add("Failed to delete quote", Severity.Error);
        }
    }

    private async Task SendByEmail()
    {
        if (string.IsNullOrEmpty(Quote?.PdfPath) || !System.IO.File.Exists(Quote.PdfPath))
        {
            Snackbar.Add("PDF file not found. Please try generating it again by setting status to Draft then Final.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            ["To"] = Project?.Client?.ContactPersonEmail ?? "",
            ["Subject"] = $"Quote #{Quote.QuoteNumber} from {Profile?.CompanyName}",
            ["Body"] = $"<p>Dear {Project?.Client?.ContactPersonName ?? "Client"},</p><p>Please find attached quote #{Quote.QuoteNumber}.</p>",
            ["IsTemplate"] = true,
            ["PreloadedFiles"] = new List<(string Path, string FileName)> 
            { 
                (Quote.PdfPath, $"Quote_{Quote.QuoteNumber}.pdf") 
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        await DialogService.ShowAsync<Spokes_Server.Components.Pages.Email.EmailComposer>("Send Email", parameters, options);
    }

    private async Task OpenPdf()
    {
        if (string.IsNullOrEmpty(Quote?.PdfPath) || !System.IO.File.Exists(Quote.PdfPath))
        {
            Snackbar.Add("PDF file not found.", Severity.Warning);
            return;
        }

        try
        {
            var bytes = await System.IO.File.ReadAllBytesAsync(Quote.PdfPath);
            var base64 = Convert.ToBase64String(bytes);
            var dataUrl = $"data:application/pdf;base64,{base64}";
            await JS.InvokeVoidAsync("window.openBase64InNewTab", dataUrl, $"Quote_{Quote.QuoteNumber}.pdf");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to open PDF");
            Snackbar.Add("Failed to open PDF view", Severity.Error);
        }
    }
