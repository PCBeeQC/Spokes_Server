@page "/projects/{ProjectId}/reports/{ReportId}"
@using Microsoft.AspNetCore.Authorization
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Documents
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Models.Common
@using Spokes_Server.Core.Services.Documents
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.HR
@using Spokes_Server.Core.Services.Projects
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Helpers
@using Spokes_Server.Components.Dialogs.Common
@using Spokes_Server.Components.Dialogs.Projects
@using Spokes_Server.Components.Pages.Email
@using Spokes_Server.Components.Shared
@attribute [Authorize(Policy = AppPermissions.Projects.View)]
@inject Database Db
@inject ProjectReportService ReportService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject DocumentPdfService PdfService
@inject IJurisdictionTemplateService JurisdictionService
@inject UserService UserService
@inject HRService HRService
@inject IUserPrivacyService PrivacyService
@inject AppLabelService AppLabels
@inject ITimelineEventService TimelineService
@inject IEmailInboxService InboxService
@implements IDisposable
@implements IAsyncDisposable

@if (_accessDenied)
{
    <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Style="font-size: 4rem;" Class="mb-4" />
        <MudText Typo="Typo.h5" GutterBottom="true">@Loc["Access Denied"]</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mb-6">
            @BizLoc["You do not have permission to view this project report."]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => Nav.NavigateTo("/projects"))">
            @BizLoc["Return to Projects"]
        </MudButton>
    </MudContainer>
}
else if (_report == null || _project == null)
{
    <MudContainer Class="mt-8">
        <MudAlert Severity="Severity.Error">@BizLoc["Project report not found."]</MudAlert>
    </MudContainer>
}
else
{
    <PageTitle>@(_project?.Client?.BusinessName is { Length: > 0 } clientName ? $"{Template.Label_ProjectReport} {_report.ReportNumber} - {clientName}" : $"{Template.Label_ProjectReport} {_report.ReportNumber}")</PageTitle>

    <MudContainer MaxWidth="MaxWidth.Large" Class="py-4 pb-8">
        <div class="d-print-none mb-1">
            <SpokesBreadcrumbs Items="@(new (string, string?)[] { ("Projects", "projects"), (_project?.DisplayName ?? "Project", $"projects/{ProjectId}"), (BizLoc["Reports"].Value, $"projects/{ProjectId}?tab=reports"), (_report.ReportNumber, null) })" />
        </div>

        @* --- TOP ACTION BAR (Matches QuoteViewer / InvoiceViewer height & layout) --- *@
        <div class="d-flex justify-space-between align-center flex-wrap gap-2 py-2 d-print-none" Style="position: sticky; top: 0; z-index: 99; background-color: var(--mud-palette-background);">
            <div class="d-flex align-center gap-2 flex-wrap">
                <MudButton StartIcon="@Icons.Material.Filled.ArrowBack" OnClick="GoBack">
                    @BizLoc["Back to Project"]
                </MudButton>
                <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.EventAvailable">
                    @Template.Label_AsOfDate: @_snap.AsOfDate.ToString("yyyy-MM-dd")
                </MudChip>
                @if (_canEditReport && _report.Status == ProjectReportStatus.Draft)
                {
                    <MudTooltip Text="@BizLoc["Recalculate snapshot data using current project records up to the report's As-Of date"]">
                        <MudButton Variant="Variant.Text"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Refresh"
                                   OnClick="RefreshSnapshotNow">
                            @BizLoc["Refresh Data"]
                        </MudButton>
                    </MudTooltip>
                }
            </div>

            <div class="d-flex align-center gap-2 flex-wrap">
                <MudSelect T="string"
                           Value="@_report.Status"
                           ValueChanged="OnStatusChanged"
                           Disabled="@(_report.Status == ProjectReportStatus.Final ? !_canUnlockOrDeleteFinal : !_canEditReport)"
                           Dense="true"
                           Margin="Margin.Dense"
                           Variant="Variant.Outlined"
                           Style="width: 170px; min-width: 170px; flex-shrink: 0;">
                    @foreach (var status in ProjectReportStatus.GetAllowedTransitions())
                    {
                        <MudSelectItem Value="@status">@BizLoc[status]</MudSelectItem>
                    }
                </MudSelect>
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" />
                @if ((_canEditReport && _report.Status == ProjectReportStatus.Draft) || (_canUnlockOrDeleteFinal && _report.Status == ProjectReportStatus.Final))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteReport">
                        @Loc["Delete"]
                    </MudButton>
                }
                <MudButton Variant="Variant.Outlined" Color="Color.Success" StartIcon="@Icons.Material.Filled.PictureAsPdf" OnClick="Print">
                    @BizLoc["Print / PDF"]
                </MudButton>
                @if (_report.Status != ProjectReportStatus.Draft)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Info" StartIcon="@Icons.Material.Filled.OpenInNew" OnClick="OpenPdf">
                        @BizLoc["Open PDF"]
                    </MudButton>
                    @if (_canEditReport && _hasEmailInboxes && _canAccessUnredactedReport)
                    {
                        <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Email" OnClick="SendEmail">
                            @BizLoc["Send by Email"]
                        </MudButton>
                    }
                }
                @if (_canEditReport)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ContentCopy" OnClick="DuplicateReport">
                        @BizLoc["Duplicate"]
                    </MudButton>
                }
                @if (_canEditReport && _report.Status == ProjectReportStatus.Draft)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" StartIcon="@Icons.Material.Filled.Edit" OnClick="@(() => EditReport(false))">
                        @Loc["Edit"]
                    </MudButton>
                }
                else if (_canUnlockOrDeleteFinal && ProjectReportStatus.CanUnlockEdit(_report.Status))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.EditNote" OnClick="@(() => EditReport(true))">
                        @BizLoc["Unlock & Edit"]
                    </MudButton>
                }
            </div>
        </div>

        @* --- THE PAPER DOCUMENT --- *@
        <MudPaper Class="mx-auto overflow-hidden" Style="max-width: 8.5in; width: 100%; min-height: 11in;" Elevation="3" id="printable-area">

            @* --- 0. CUSTOM FOOTER (Cloned onto each page by paginateSections) --- *@
            <div class="print-footer-custom">
                <span>@Company.CompanyName</span>
                <span>
                    Ref: @_report.Title
                    @if (_report.IsConfidential)
                    {
                        <span> - </span>
                        <span style="color: #d32f2f; font-weight: bold; text-transform: uppercase;">@Template.Label_Confidential</span>
                    }
                </span>
                <span data-page-number style="display:none">{page} / {pages}</span>
            </div>

            @* --- MAIN CONTENT WRAPPER --- *@
            <div class="print-body">

                @* 1. FULL COVER PAGE (Dedicated Page 1) *@
                <div class="keep-together" style="padding-top: 8px; padding-bottom: 8px;">
                    @* Top Company & Document Identity Bar *@
                    <div>
                        <div class="d-flex justify-space-between align-start mb-6">
                            <div style="max-width: 55%;">
                                @if (Company.HasCustomLogo)
                                {
                                    <MudImage Src="@($"/spokesapi/Media/Logo?v={Company.LogoVersion}")" Height="72" ObjectFit="ObjectFit.Contain" Class="mb-2" />
                                }
                                else if (!string.IsNullOrEmpty(Company.CompanyName))
                                {
                                    <MudAvatar Rounded="true"
                                        Style="@($"width: 56px; height: 56px; font-size: 1.8rem; color: white; background-color: {Company.PrimaryColor}; -webkit-print-color-adjust: exact;")"
                                        Class="mb-2">
                                        @Company.CompanyName.Substring(0, 1)
                                    </MudAvatar>
                                }
                                <MudText Typo="Typo.h6" Style="@($"font-weight: 800; color: {Company.PrimaryColor}; letter-spacing: 0.4px;")">
                                    @Company.CompanyName
                                </MudText>
                                @if (!string.IsNullOrEmpty(Company.AddressStreet))
                                {
                                    <MudText Typo="Typo.body2" Style="color: #555; font-size: 0.82rem;">@Company.AddressStreet</MudText>
                                }
                                @if (!string.IsNullOrEmpty(Company.AddressCity) || !string.IsNullOrEmpty(Company.AddressState) || !string.IsNullOrEmpty(Company.AddressZip))
                                {
                                    <MudText Typo="Typo.body2" Style="color: #555; font-size: 0.82rem;">@Company.AddressCity, @Company.AddressState @Company.AddressZip</MudText>
                                }
                                @if (!string.IsNullOrEmpty(Company.PhoneNumber) || !string.IsNullOrEmpty(Company.Website))
                                {
                                    <MudText Typo="Typo.body2" Style="color: #555; font-size: 0.82rem;">
                                        @Company.PhoneNumber
                                        @if (!string.IsNullOrEmpty(Company.PhoneNumber) && !string.IsNullOrEmpty(Company.Website))
                                        {
                                            <span> · </span>
                                        }
                                        @Company.Website
                                    </MudText>
                                }
                                @{
                                    var reportTaxRegs = JurisdictionService.GetCompanyTaxRegistrations();
                                }
                                @if (reportTaxRegs.Count > 0)
                                {
                                    <div class="mt-1" style="font-size: 0.7rem; color: #777;">
                                        @for (int i = 0; i < reportTaxRegs.Count; i++)
                                        {
                                            if (i > 0)
                                            {
                                                <span> · </span>
                                            }
                                            <span>@reportTaxRegs[i].Label @reportTaxRegs[i].Number</span>
                                        }
                                    </div>
                                }
                            </div>

                            <div class="text-right" style="max-width: 42%;">
                                <div class="d-flex justify-end align-center flex-wrap gap-1 mb-2">
                                    <span style="@($"display: inline-block; padding: 3px 10px; background-color: {Company.PrimaryColor}; color: white; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; border-radius: 3px; -webkit-print-color-adjust: exact;")">
                                        @(IsInternalAudience ? Template.Label_InternalManagementReport : Template.Label_ClientProjectReport)
                                    </span>
                                    @if (_report.IsConfidential)
                                    {
                                        <span style="display: inline-block; padding: 2px 8px; border: 1px solid #c62828; color: #c62828; font-size: 0.68rem; font-weight: 800; letter-spacing: 0.8px; text-transform: uppercase; border-radius: 3px;">
                                            @Template.Label_Confidential
                                        </span>
                                    }
                                </div>
                                <div style="font-size: 0.82rem; color: #666; font-weight: 600;">
                                    #@_report.ReportNumber
                                </div>
                                <div style="font-size: 0.78rem; color: #777; margin-top: 2px;">
                                    @Template.Label_AsOfDate: <b style="color: #333;">@_snap.AsOfDate.ToString("yyyy-MM-dd")</b>
                                </div>
                            </div>
                        </div>

                        @* Hero Cover Title Banner *@
                        <div class="pa-6 my-4 rounded" style="@($"background-color: #f8f9fb; border: 1px solid #e2e8f0; border-left: 6px solid {Company.PrimaryColor}; -webkit-print-color-adjust: exact;")">
                            <div class="d-flex justify-space-between align-center flex-wrap gap-2 mb-2">
                                <div style="@($"font-size: 0.78rem; font-weight: 800; text-transform: uppercase; letter-spacing: 1.5px; color: {Company.SecondaryColor};")">
                                    @Template.Label_ProjectReport
                                </div>
                                @if (!string.IsNullOrWhiteSpace(_snap.ProjectStatus))
                                {
                                    <span style="@($"display: inline-block; padding: 3px 12px; border-radius: 12px; font-size: 0.74rem; font-weight: 700; background-color: #e8eef5; color: {Company.PrimaryColor}; -webkit-print-color-adjust: exact;")">
                                        @Template.Label_ProjectStatus: @_snap.ProjectStatus
                                    </span>
                                }
                            </div>
                            <div style="@($"font-size: 1.55rem; font-weight: 900; color: {Company.PrimaryColor}; line-height: 1.25;")">
                                @_report.Title
                            </div>
                            @if (!string.IsNullOrWhiteSpace(_snap.ProjectDescription))
                            {
                                <div class="mt-3" style="font-size: 0.85rem; color: #4a5568; white-space: pre-line; line-height: 1.45;">
                                    @_snap.ProjectDescription
                                </div>
                            }
                        </div>

                        @* Two-Column Structured Metadata Cards *@
                        <div style="display: grid; grid-template-columns: 1fr 1fr; gap: 16px;" class="my-4">
                            @* Left Card: Project Client (Internal) or Prepared For (Client) *@
                            <div class="pa-4 rounded" style="background-color: #ffffff; border: 1px solid #e2e8f0;">
                                <div style="@($"font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: {Company.SecondaryColor}; border-bottom: 1px solid #edf2f7; padding-bottom: 6px; margin-bottom: 10px;")">
                                    @(IsInternalAudience ? Template.Label_ProjectClient : Template.Label_PreparedFor)
                                </div>

                                @if (_snap.IsInternalProject && string.IsNullOrWhiteSpace(_snap.Client?.BusinessName))
                                {
                                    <div style="font-size: 0.98rem; font-weight: 700; color: #222;">@Company.CompanyName (@BizLoc["Internal Project"])</div>
                                }
                                else
                                {
                                    <div style="font-size: 1rem; font-weight: 800; color: #1a202c;">@_snap.Client?.BusinessName</div>
                                    @if (!string.IsNullOrWhiteSpace(_snap.Client?.GetFormattedStreetAddress()))
                                    {
                                        <div style="font-size: 0.83rem; color: #4a5568; margin-top: 2px;">@_snap.Client.GetFormattedStreetAddress()</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_snap.Client?.BusinessAddressCity) || !string.IsNullOrWhiteSpace(_snap.Client?.BusinessAddressState) || !string.IsNullOrWhiteSpace(_snap.Client?.BusinessAddressZip))
                                    {
                                        <div style="font-size: 0.83rem; color: #4a5568;">@_snap.Client?.BusinessAddressCity, @_snap.Client?.BusinessAddressState @_snap.Client?.BusinessAddressZip</div>
                                    }
                                    @if (!string.IsNullOrWhiteSpace(_snap.Client?.ContactPersonName))
                                    {
                                        <div class="mt-3 pt-2" style="border-top: 1px dashed #e2e8f0; font-size: 0.82rem;">
                                            <div style="font-weight: 700; color: #2d3748;">@_snap.Client.ContactPersonPrefix @_snap.Client.ContactPersonName</div>
                                            @if (!string.IsNullOrWhiteSpace(_snap.Client.ContactPersonEmail))
                                            {
                                                <div style="color: #4a5568;">@_snap.Client.ContactPersonEmail</div>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(_snap.Client.ContactPersonPhone))
                                            {
                                                <div style="color: #4a5568;">@_snap.Client.ContactPersonPhone</div>
                                            }
                                        </div>
                                    }
                                }

                                @if (IsInternalAudience)
                                {
                                    <div class="mt-3 pt-2" style="border-top: 1px solid #edf2f7; font-size: 0.78rem; color: #4a5568;">
                                        <span style="color: #718096; font-weight: 600;">@Template.Label_ReportAudience:</span>
                                        <b style="color: #2d3748;"> @Company.CompanyName — @Template.Label_InternalManagementReport</b>
                                    </div>
                                }
                            </div>

                            @* Right Card: Report & Project Parameters *@
                            <div class="pa-4 rounded" style="background-color: #ffffff; border: 1px solid #e2e8f0;">
                                <div style="@($"font-size: 0.72rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.8px; color: {Company.SecondaryColor}; border-bottom: 1px solid #edf2f7; padding-bottom: 6px; margin-bottom: 10px;")">
                                    @Template.Label_ReportDetails
                                </div>
                                <table style="width: 100%; border-collapse: collapse; font-size: 0.83rem;">
                                    <tr>
                                        <td style="padding: 4px 8px 4px 0; color: #718096; font-weight: 600; width: 34%; white-space: nowrap;">@Template.Label_ReportNumber:</td>
                                        <td style="padding: 4px 0; font-weight: 700; color: #1a202c;">@_report.ReportNumber</td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 8px 4px 0; color: #718096; font-weight: 600; white-space: nowrap;">@Template.Label_ProjectNumber:</td>
                                        <td style="padding: 4px 0; font-weight: 700; color: #1a202c;">
                                            @(!string.IsNullOrWhiteSpace(_snap.ProjectNumber) ? $"{_snap.ProjectNumber} : {_snap.ProjectName}" : _snap.ProjectName)
                                        </td>
                                    </tr>
                                    <tr>
                                        <td style="padding: 4px 8px 4px 0; color: #718096; font-weight: 600; white-space: nowrap;">@Template.Label_ReportPeriod:</td>
                                        <td style="padding: 4px 0; font-weight: 600; color: #1a202c; white-space: nowrap;">
                                            @(_snap.PeriodStartDate.HasValue ? _snap.PeriodStartDate.Value.ToString("yyyy-MM-dd") : Template.Label_ProjectInception) → @_snap.AsOfDate.ToString("yyyy-MM-dd")
                                        </td>
                                    </tr>
                                    @if (!string.IsNullOrWhiteSpace(_snap.ProjectManagerName))
                                    {
                                        <tr>
                                            <td style="padding: 4px 8px 4px 0; color: #718096; font-weight: 600; white-space: nowrap;">@Template.Label_ProjectManager:</td>
                                            <td style="padding: 4px 0; font-weight: 600; color: #1a202c;">@_snap.ProjectManagerName</td>
                                        </tr>
                                    }
                                    @if (_snap.ProjectStartDate.HasValue || _snap.ProjectDeadline.HasValue)
                                    {
                                        <tr>
                                            <td style="padding: 4px 8px 4px 0; color: #718096; font-weight: 600; white-space: nowrap;">@Template.Label_ProjectSchedule:</td>
                                            <td style="padding: 4px 0; color: #1a202c; white-space: nowrap;">
                                                @(_snap.ProjectStartDate.HasValue ? _snap.ProjectStartDate.Value.ToString("yyyy-MM-dd") : "—") → @(_snap.ProjectDeadline.HasValue ? _snap.ProjectDeadline.Value.ToString("yyyy-MM-dd") : "—")
                                            </td>
                                        </tr>
                                    }
                                </table>
                            </div>
                        </div>
                    </div>

                    @* Cover Page Bottom Snapshot Highlights Bar *@
                    <div class="pa-4 rounded mt-5" style="@($"background-color: #f8f9fb; border: 1px solid #e2e8f0; border-top: 3px solid {Company.PrimaryColor}; -webkit-print-color-adjust: exact;")">
                        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(120px, 1fr)); gap: 12px; text-align: center;">
                            <div>
                                <div style="font-size: 0.7rem; text-transform: uppercase; color: #718096; font-weight: 700;">@Template.Label_Hours</div>
                                <div style="@($"font-size: 1.15rem; font-weight: 800; color: {Company.PrimaryColor};")">@_snap.TotalLaborHours.ToString("N1") h</div>
                            </div>
                            @if (_canViewAllLabor)
                            {
                                <div>
                                    <div style="font-size: 0.7rem; text-transform: uppercase; color: #718096; font-weight: 700;">@Template.Label_Employees</div>
                                    <div style="font-size: 1.15rem; font-weight: 800; color: #2d3748;">@_snap.EmployeeLaborRows.Count</div>
                                </div>
                            }
                            @if (_canViewPurchases)
                            {
                                <div>
                                    <div style="font-size: 0.7rem; text-transform: uppercase; color: #718096; font-weight: 700;">@Template.Label_PurchasesBreakdown</div>
                                    <div style="font-size: 1.15rem; font-weight: 800; color: #2d3748;">@_snap.PurchaseItems.Count</div>
                                </div>
                            }
                            <div>
                                <div style="font-size: 0.7rem; text-transform: uppercase; color: #718096; font-weight: 700;">@Template.Label_Invoices</div>
                                <div style="font-size: 1.15rem; font-weight: 800; color: #2d3748;">@_snap.Invoices.Count</div>
                            </div>
                        </div>
                    </div>
                </div>

                @* Force Page 2 after the Cover Page *@
                <div class="force-break"></div>

                @* 2. EXECUTIVE SUMMARY (At top of Page 2 when present) *@
                @if (!string.IsNullOrWhiteSpace(_report.ExecutiveSummary))
                {
                    <div class="mb-6 keep-together">
                        <MudText Typo="Typo.h6" Class="mb-2 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @Template.Label_ExecutiveSummary
                        </MudText>
                        <div class="pa-3 rounded" style="@($"background-color: #fbfcfd; border-left: 4px solid {Company.PrimaryColor}; white-space: pre-line; font-size: 0.9rem; color: #222;")">
                            @_report.ExecutiveSummary
                        </div>
                    </div>
                }

                @* 3. SECTION 1: FINANCIAL & PROFITABILITY SUMMARY *@
                @if (_opt.ShowFinancialSummary && ShowFinancialAmounts)
                {
                    var expectedRevPreTax = _snap.GetExpectedRevenueSubTotal();
                    var expectedRevTax = _snap.GetExpectedRevenueTax();
                    var expectedRevIncTax = _snap.ExpectedRevenue;

                    var invoicedPreTax = _snap.GetTotalInvoicedSubTotal();
                    var invoicedTax = _snap.GetTotalInvoicedTax();
                    var invoicedIncTax = _snap.TotalInvoiced;

                    var baseRevPreTax = _snap.BaseRevenuePreTax;
                    var baseRevTax = _snap.BaseRevenueTax;
                    var baseRevIncTax = _snap.BaseRevenueIncTax;

                    var totalCostPreTax = _snap.TotalInternalSpentPreTax + _snap.TotalCommissions;
                    var totalCostTax = _snap.TotalInternalSpentTax;
                    var totalCostIncTax = _snap.TotalInternalSpent + _snap.TotalCommissions;

                    var netProfitPreTax = _snap.NetProfitPreTax;
                    var netMarginPreTax = _snap.NetMarginPreTaxPercent;

                    <div class="mb-6 allow-break">
                        <div class="d-flex justify-space-between align-center mb-3 keep-together keep-with-next" style="border-bottom: 1px solid #ddd; padding-bottom: 4px;">
                            <MudText Typo="Typo.h6" Style="@($"color: {Company.PrimaryColor}; font-weight: 700;")">
                                @Template.Label_FinancialSummary
                            </MudText>
                            <span style="font-size: 0.72rem; font-weight: 700; color: #666; text-transform: uppercase; letter-spacing: 0.5px;">
                                @(IsTaxExcluded ? Template.Label_AmountsExclTax : (IsTaxSeparate ? Template.Label_PreTaxSeparateTaxBreakdown : Template.Label_AmountsInclTax))
                            </span>
                        </div>

                        @if (ShowInternalCosts)
                        {
                            var pnlRev = IsTaxIncluded ? baseRevIncTax : baseRevPreTax;
                            var pnlInvoiced = IsTaxIncluded ? invoicedIncTax : invoicedPreTax;
                            var pnlExpected = IsTaxIncluded ? expectedRevIncTax : expectedRevPreTax;
                            var pnlPoCost = IsTaxIncluded ? _snap.TotalPurchaseCost : _snap.TotalPurchaseNet;
                            var pnlExpCost = IsTaxIncluded ? _snap.TotalExpenseCost : _snap.TotalExpenseSubTotal;
                            var pnlDirectIncome = IsTaxIncluded ? _snap.TotalDirectIncome : _snap.TotalDirectIncomeSubTotal;
                            var pnlDirectExpCost = IsTaxIncluded ? _snap.TotalDirectExpense : _snap.TotalDirectExpenseSubTotal;
                            var pnlTotalCost = IsTaxIncluded ? totalCostIncTax : totalCostPreTax;
                            var pnlNetProfit = IsTaxIncluded ? _snap.NetProfit : netProfitPreTax;
                            var pnlNetMargin = IsTaxIncluded ? _snap.NetMarginPercent : netMarginPreTax;

                            decimal directLaborBaseCost = 0m;
                            if (_snap.EmployeeLaborRows.Count > 0)
                            {
                                foreach (var empRow in _snap.EmployeeLaborRows)
                                {
                                    var effectiveBase = empRow.BaseHourlyRate > 0m
                                        ? empRow.BaseHourlyRate
                                        : Math.Max(0m, empRow.EffectiveInternalRate - empRow.EmployerContributionHourlyRate);
                                    var empBaseCost = Math.Min(empRow.InternalCost, Math.Round(empRow.TotalHours * effectiveBase, 2, MidpointRounding.AwayFromZero));
                                    directLaborBaseCost += empBaseCost;
                                }
                                directLaborBaseCost = Math.Min(_snap.TotalLaborInternalCost, Math.Round(directLaborBaseCost, 2, MidpointRounding.AwayFromZero));
                            }
                            else
                            {
                                directLaborBaseCost = _snap.TotalLaborInternalCost;
                            }
                            var directLaborContribCost = Math.Max(0m, _snap.TotalLaborInternalCost - directLaborBaseCost);

                            var avgBaseHourlyCost = _snap.TotalLaborHours > 0 ? Math.Round(directLaborBaseCost / _snap.TotalLaborHours, 2) : 0m;
                            var avgContribHourlyCost = _snap.TotalLaborHours > 0 ? Math.Round(directLaborContribCost / _snap.TotalLaborHours, 2) : 0m;
                            var invoicedSharePct = pnlExpected > 0 ? Math.Round(pnlInvoiced / pnlExpected * 100m, 1) : 100m;

                            var laborBaseRevPct = pnlRev > 0 ? Math.Round(directLaborBaseCost / pnlRev * 100m, 1) : 0m;
                            var laborBaseCostPct = pnlTotalCost > 0 ? Math.Round(directLaborBaseCost / pnlTotalCost * 100m, 1) : 0m;

                            var laborContribRevPct = pnlRev > 0 ? Math.Round(directLaborContribCost / pnlRev * 100m, 1) : 0m;
                            var laborContribCostPct = pnlTotalCost > 0 ? Math.Round(directLaborContribCost / pnlTotalCost * 100m, 1) : 0m;

                            var poRevPct = pnlRev > 0 ? Math.Round(pnlPoCost / pnlRev * 100m, 1) : 0m;
                            var poCostPct = pnlTotalCost > 0 ? Math.Round(pnlPoCost / pnlTotalCost * 100m, 1) : 0m;

                            var expRevPct = pnlRev > 0 ? Math.Round(pnlExpCost / pnlRev * 100m, 1) : 0m;
                            var expCostPct = pnlTotalCost > 0 ? Math.Round(pnlExpCost / pnlTotalCost * 100m, 1) : 0m;

                            var directIncomeRevPct = pnlRev > 0 ? Math.Round(pnlDirectIncome / pnlRev * 100m, 1) : 0m;
                            var directExpRevPct = pnlRev > 0 ? Math.Round(pnlDirectExpCost / pnlRev * 100m, 1) : 0m;
                            var directExpCostPct = pnlTotalCost > 0 ? Math.Round(pnlDirectExpCost / pnlTotalCost * 100m, 1) : 0m;

                            var commRevPct = pnlRev > 0 ? Math.Round(_snap.TotalCommissions / pnlRev * 100m, 1) : 0m;
                            var commCostPct = pnlTotalCost > 0 ? Math.Round(_snap.TotalCommissions / pnlTotalCost * 100m, 1) : 0m;

                            var costToRevPct = pnlRev > 0 ? Math.Round(pnlTotalCost / pnlRev * 100m, 1) : 0m;

                            var showOverheadInPnl = _opt.ShowOverheadSection && !_snap.IsInternalProject &&
                                (_snap.CompanyOverheadPoolPreTax > 0m || _snap.AllocatedOverheadPreTax > 0m || _snap.OverheadRows.Count > 0);
                            var hasSplitOverheadFields = _snap.AllocatedFixedOverheadPreTax > 0m || _snap.AllocatedInternalCostsPreTax > 0m;
                            var fixedOverheadPreTax = hasSplitOverheadFields
                                ? _snap.AllocatedFixedOverheadPreTax
                                : Math.Round(_snap.OverheadRows.Where(r => r.Category == OverheadCostCategory.RecurringFixed || r.Category == OverheadCostCategory.OneTimeAmortized).Sum(r => r.AllocatedPreTax), 2, MidpointRounding.AwayFromZero);
                            var fixedOverheadTax = hasSplitOverheadFields
                                ? _snap.AllocatedFixedOverheadTax
                                : Math.Round(_snap.OverheadRows.Where(r => r.Category == OverheadCostCategory.RecurringFixed || r.Category == OverheadCostCategory.OneTimeAmortized).Sum(r => r.AllocatedTax), 2, MidpointRounding.AwayFromZero);
                            var internalCostsPreTax = hasSplitOverheadFields
                                ? _snap.AllocatedInternalCostsPreTax
                                : Math.Round(_snap.OverheadRows.Where(r => r.Category == OverheadCostCategory.InternalLabor || r.Category == OverheadCostCategory.InternalPurchasesAndExpenses).Sum(r => r.AllocatedPreTax), 2, MidpointRounding.AwayFromZero);
                            var internalCostsTax = hasSplitOverheadFields
                                ? _snap.AllocatedInternalCostsTax
                                : Math.Round(_snap.OverheadRows.Where(r => r.Category == OverheadCostCategory.InternalLabor || r.Category == OverheadCostCategory.InternalPurchasesAndExpenses).Sum(r => r.AllocatedTax), 2, MidpointRounding.AwayFromZero);

                            var pnlFixedOverhead = IsTaxIncluded ? (fixedOverheadPreTax + fixedOverheadTax) : fixedOverheadPreTax;
                            var pnlInternalCosts = IsTaxIncluded ? (internalCostsPreTax + internalCostsTax) : internalCostsPreTax;
                            var totalAllocatedOverhead = pnlFixedOverhead + pnlInternalCosts;
                            var pnlNetProfitAfterOverhead = IsTaxIncluded ? _snap.NetProfitAfterOverhead : _snap.NetProfitAfterOverheadPreTax;
                            var pnlNetMarginAfterOverhead = IsTaxIncluded ? _snap.NetMarginAfterOverheadPercent : _snap.NetMarginAfterOverheadPreTaxPercent;
                            var fixedOverheadRevPct = pnlRev > 0 ? Math.Round(pnlFixedOverhead / pnlRev * 100m, 1) : 0m;
                            var internalCostsRevPct = pnlRev > 0 ? Math.Round(pnlInternalCosts / pnlRev * 100m, 1) : 0m;
                            var totalAllocatedOverheadRevPct = pnlRev > 0 ? Math.Round(totalAllocatedOverhead / pnlRev * 100m, 1) : 0m;
                            var internalLaborHours = _snap.OverheadRows.Where(r => r.Category == OverheadCostCategory.InternalLabor).Sum(r => r.Hours);
                            var showFixedOverheadRow = pnlFixedOverhead > 0m || pnlInternalCosts == 0m;
                            var showInternalProjectsRow = pnlInternalCosts > 0m;

                            @* TABLE A: Project Profitability Statement (Standard Accounting Income Statement Layout) *@
                            <div class="mb-4 keep-together">
                                <MudText Typo="Typo.subtitle2" Class="mb-1 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                    @ProfitabilityStatementTitle @(IsTaxIncluded ? $"({Template.Label_AmountsInclTax})" : $"({Template.Label_PreTax})")
                                </MudText>

                                <table class="mud-table-root keep-together" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #cbd5e1;">
                                    <thead>
                                        <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                            <th style="padding: 6px 10px; text-align: left; width: 38%;">@Template.Label_FinancialCategory</th>
                                            <th style="padding: 6px 10px; text-align: left; width: 31%;">@Template.Label_Details</th>
                                            <th style="padding: 6px 10px; text-align: right; width: 15%; white-space: nowrap;">
                                                @(IsTaxIncluded ? Template.Label_Total : $"{ReportSubtotalLabel} ({Template.Label_PreTax})")
                                            </th>
                                            <th style="padding: 6px 10px; text-align: right; width: 8%; white-space: nowrap;">% Rev.</th>
                                            <th style="padding: 6px 10px; text-align: right; width: 8%; white-space: nowrap;">% @Template.Label_TotalCost</th>
                                        </tr>
                                    </thead>
                                    <tbody>
                                        @* Section 1: Revenue *@
                                        <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                            <td colspan="5" style="padding: 4px 10px; font-size: 0.71rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: #475569;">
                                                @RevenueGroupHeader
                                            </td>
                                        </tr>
                                        @if (expectedRevPreTax > 0 && Math.Abs(expectedRevPreTax - invoicedPreTax) > 0.01m)
                                        {
                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 10px 6px 18px; font-weight: 600;">@Template.Label_ExpectedRevenue</td>
                                                <td style="padding: 6px 10px; color: #555;">
                                                    @_snap.Quotes.Count(q => q.Status == QuoteStatus.Accepted) @(_snap.Quotes.Count(q => q.Status == QuoteStatus.Accepted) == 1 ? Template.Label_Quote : Template.Label_Quotes)
                                                </td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(pnlExpected)</td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; color: #555; font-variant-numeric: tabular-nums;">100.0%</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #999;">—</td>
                                            </tr>
                                            <tr style="border-bottom: 1px solid #cbd5e1;">
                                                <td style="padding: 6px 10px 6px 18px; color: #334155;">@Template.Label_TotalInvoiced</td>
                                                <td style="padding: 6px 10px; color: #555;">
                                                    @_snap.Invoices.Count @(_snap.Invoices.Count == 1 ? Template.Label_Invoice : Template.Label_Invoices)
                                                </td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(pnlInvoiced)</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@invoicedSharePct.ToString("N1")%</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #999;">—</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr style="border-bottom: 1px solid #cbd5e1;">
                                                <td style="padding: 6px 10px 6px 18px; font-weight: 600;">@Template.Label_TotalInvoiced</td>
                                                <td style="padding: 6px 10px; color: #555;">
                                                    @_snap.Invoices.Count @(_snap.Invoices.Count == 1 ? Template.Label_Invoice : Template.Label_Invoices)
                                                </td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(pnlInvoiced)</td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; color: #555; font-variant-numeric: tabular-nums;">@(pnlInvoiced > 0 ? "100.0%" : "—")</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #999;">—</td>
                                            </tr>
                                        }

                                        @if (pnlDirectIncome > 0m)
                                        {
                                            var directInCount = _snap.DirectTransactions.Count(d => string.Equals(d.Direction, DirectTransactionDirection.MoneyIn, StringComparison.OrdinalIgnoreCase));
                                            <tr style="border-bottom: 1px solid #cbd5e1;">
                                                <td style="padding: 6px 10px 6px 18px; color: #2e7d32; font-weight: 600;">@BizLoc["Other Project Income"]</td>
                                                <td style="padding: 6px 10px; color: #555;">
                                                    @directInCount @(directInCount == 1 ? Template.Label_Item : Template.Label_Items)
                                                </td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; color: #2e7d32; white-space: nowrap; font-variant-numeric: tabular-nums;">+@FormatMoney(pnlDirectIncome)</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{directIncomeRevPct:N1}%" : "—")</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #999;">—</td>
                                            </tr>
                                        }

                                        @* Section 2: Direct Project Costs *@
                                        <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                            <td colspan="5" style="padding: 4px 10px; font-size: 0.71rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: #475569;">
                                                @DirectCostsGroupHeader
                                            </td>
                                        </tr>
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 6px 10px 6px 18px;">@DirectLaborBaseLabel</td>
                                            <td style="padding: 6px 10px; color: #555;">
                                                @_snap.TotalLaborHours.ToString("N1") h · @_snap.EmployeeLaborRows.Count @(_snap.EmployeeLaborRows.Count == 1 ? Template.Label_Employee : Template.Label_Employees) · @FormatMoney(avgBaseHourlyCost)/h
                                            </td>
                                            <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(directLaborBaseCost)</td>
                                            <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{laborBaseRevPct:N1}%" : "—")</td>
                                            <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlTotalCost > 0 ? $"{laborBaseCostPct:N1}%" : "—")</td>
                                        </tr>

                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 6px 10px 6px 18px;">@DirectLaborContribLabel</td>
                                            <td style="padding: 6px 10px; color: #555;">
                                                @_snap.TotalLaborHours.ToString("N1") h · @FormatMoney(avgContribHourlyCost)/h
                                            </td>
                                            <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(directLaborContribCost)</td>
                                            <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{laborContribRevPct:N1}%" : "—")</td>
                                            <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlTotalCost > 0 ? $"{laborContribCostPct:N1}%" : "—")</td>
                                        </tr>

                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 6px 10px 6px 18px;">@Template.Label_PurchasesBreakdown</td>
                                            <td style="padding: 6px 10px; color: #555;">
                                                @_snap.PurchaseItems.Count @(_snap.PurchaseItems.Count == 1 ? Template.Label_Item : Template.Label_Items)
                                            </td>
                                            <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(pnlPoCost)</td>
                                            <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{poRevPct:N1}%" : "—")</td>
                                            <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlTotalCost > 0 ? $"{poCostPct:N1}%" : "—")</td>
                                        </tr>

                                        @if (_snap.TotalExpenseCost > 0)
                                        {
                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 10px 6px 18px;">@Template.Label_ExpensesBreakdown</td>
                                                <td style="padding: 6px 10px; color: #555;">
                                                    @_snap.ExpenseItems.Count @(_snap.ExpenseItems.Count == 1 ? Template.Label_Item : Template.Label_Items)
                                                </td>
                                                <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(pnlExpCost)</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{expRevPct:N1}%" : "—")</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlTotalCost > 0 ? $"{expCostPct:N1}%" : "—")</td>
                                            </tr>
                                        }

                                        @if (_snap.TotalDirectExpense > 0m)
                                        {
                                            var directOutCount = _snap.DirectTransactions.Count(d => string.Equals(d.Direction, DirectTransactionDirection.MoneyOut, StringComparison.OrdinalIgnoreCase));
                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 10px 6px 18px;">@BizLoc["Other Direct Expenses"]</td>
                                                <td style="padding: 6px 10px; color: #555;">
                                                    @directOutCount @(directOutCount == 1 ? Template.Label_Item : Template.Label_Items)
                                                </td>
                                                <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(pnlDirectExpCost)</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{directExpRevPct:N1}%" : "—")</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlTotalCost > 0 ? $"{directExpCostPct:N1}%" : "—")</td>
                                            </tr>
                                        }

                                        @if (_snap.TotalCommissions > 0)
                                        {
                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 10px 6px 18px;">@Template.Label_CommissionsBreakdown</td>
                                                <td style="padding: 6px 10px; color: #555;">@_snap.Commissions.Count @BizLoc["beneficiaries"]</td>
                                                <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(_snap.TotalCommissions)</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{commRevPct:N1}%" : "—")</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlTotalCost > 0 ? $"{commCostPct:N1}%" : "—")</td>
                                            </tr>
                                        }

                                        <tr style="border-top: 1px solid #94a3b8; border-bottom: 1px solid #cbd5e1; background-color: #fafbfc; font-weight: 700;">
                                            <td style="padding: 6px 10px;">@Template.Label_TotalCost (@(IsTaxIncluded ? Template.Label_AmountsInclTax : Template.Label_PreTax))</td>
                                            <td style="padding: 6px 10px;"></td>
                                            <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(pnlTotalCost)</td>
                                            <td style="@($"padding: 6px 10px; text-align: right; font-variant-numeric: tabular-nums; color: {(costToRevPct > 100m ? "#c62828" : "#334155")};")">
                                                @(pnlRev > 0 ? $"{costToRevPct:N1}%" : "—")
                                            </td>
                                            <td style="padding: 6px 10px; text-align: right; color: #334155; font-variant-numeric: tabular-nums;">@(pnlTotalCost > 0 ? "100.0%" : "—")</td>
                                        </tr>

                                        @if (showOverheadInPnl)
                                        {
                                            <tr style="border-top: 1px solid #64748b; border-bottom: 1px solid #94a3b8; background-color: #f8fafc; font-weight: 700;">
                                                <td style="padding: 7px 10px;">@DirectProjectProfitLabel (@(IsTaxIncluded ? Template.Label_AmountsInclTax : Template.Label_PreTax))</td>
                                                <td style="padding: 7px 10px; color: #64748b; font-weight: 500; font-size: 0.78rem;">@DirectProfitHintLabel</td>
                                                <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(pnlNetProfit >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @FormatMoney(pnlNetProfit)
                                                </td>
                                                <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(pnlNetProfit >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @(pnlRev > 0 ? $"{pnlNetMargin:N1}%" : "—")
                                                </td>
                                                <td style="padding: 7px 10px; text-align: right; color: #999;">—</td>
                                            </tr>

                                            @* Section 3: Allocated Overhead & Internal Projects *@
                                            <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                                <td colspan="5" style="padding: 4px 10px; font-size: 0.71rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: #475569;">
                                                    @AllocatedOverheadGroupHeader
                                                </td>
                                            </tr>
                                            @if (showFixedOverheadRow)
                                            {
                                                <tr style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 6px 10px 6px 18px;">@AllocatedOverheadLabel</td>
                                                    <td style="padding: 6px 10px; color: #555;">
                                                        @_snap.TotalLaborHours.ToString("N1") h / @_snap.TotalCompanyDirectLaborHours.ToString("N1") h · @_snap.OverheadAllocationSharePercent.ToString("N1")%
                                                    </td>
                                                    <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(pnlFixedOverhead)</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{fixedOverheadRevPct:N1}%" : "—")</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #999;">—</td>
                                                </tr>
                                            }
                                            @if (showInternalProjectsRow)
                                            {
                                                <tr style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 6px 10px 6px 18px;">@AllocatedInternalProjectsLabel</td>
                                                    <td style="padding: 6px 10px; color: #555;">
                                                        @internalLaborHours.ToString("N1") h · @_snap.OverheadAllocationSharePercent.ToString("N1")%
                                                    </td>
                                                    <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(pnlInternalCosts)</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #555; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{internalCostsRevPct:N1}%" : "—")</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #999;">—</td>
                                                </tr>
                                            }
                                            @if (showFixedOverheadRow && showInternalProjectsRow)
                                            {
                                                <tr style="border-top: 1px solid #94a3b8; border-bottom: 1px solid #cbd5e1; background-color: #fafbfc; font-weight: 700;">
                                                    <td style="padding: 6px 10px;">@TotalAllocatedOverheadLabel</td>
                                                    <td style="padding: 6px 10px;"></td>
                                                    <td style="padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(totalAllocatedOverhead)</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #334155; font-variant-numeric: tabular-nums;">@(pnlRev > 0 ? $"{totalAllocatedOverheadRevPct:N1}%" : "—")</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #999;">—</td>
                                                </tr>
                                            }
                                            <tr style="background-color: #f1f5f9; font-weight: 800; border-top: 1.5px solid #334155; border-bottom: 3px double #334155;">
                                                <td style="padding: 8px 10px;">@NetProfitAfterOverheadLabel (@(IsTaxIncluded ? Template.Label_AmountsInclTax : Template.Label_PreTax))</td>
                                                <td style="padding: 8px 10px; color: #64748b; font-weight: 500; font-size: 0.78rem;">@NetProfitAfterOverheadHintLabel</td>
                                                <td style="@($"padding: 8px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(pnlNetProfitAfterOverhead >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @FormatMoney(pnlNetProfitAfterOverhead)
                                                </td>
                                                <td style="@($"padding: 8px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(pnlNetProfitAfterOverhead >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @(pnlRev > 0 ? $"{pnlNetMarginAfterOverhead:N1}%" : "—")
                                                </td>
                                                <td style="padding: 8px 10px; text-align: right; color: #999;">—</td>
                                            </tr>
                                        }
                                        else
                                        {
                                            <tr style="background-color: #f1f5f9; font-weight: 800; border-top: 1.5px solid #334155; border-bottom: 3px double #334155;">
                                                <td style="padding: 8px 10px;">@Template.Label_NetProfit (@(IsTaxIncluded ? Template.Label_AmountsInclTax : Template.Label_PreTax))</td>
                                                <td style="padding: 8px 10px; color: #64748b; font-weight: 500; font-size: 0.78rem;">@DirectProfitHintLabel</td>
                                                <td style="@($"padding: 8px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(pnlNetProfit >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @FormatMoney(pnlNetProfit)
                                                </td>
                                                <td style="@($"padding: 8px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(pnlNetProfit >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @(pnlRev > 0 ? $"{pnlNetMargin:N1}%" : "—")
                                                </td>
                                                <td style="padding: 8px 10px; text-align: right; color: #999;">—</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>

                            @* TABLE B: Billing, Taxes & Cash Flow Summary *@
                            @if (!IsTaxExcluded || _opt.ShowCashFlowPosition || _snap.Invoices.Count > 0)
                            {
                                var paidInvoicesCount = _snap.Invoices.Count(i => i.AmountPaid > 0 && i.BalanceDue <= 0.05m);
                                <div class="mb-4 keep-together">
                                    <MudText Typo="Typo.subtitle2" Class="mb-1 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                        @BillingAndCashTitle
                                    </MudText>

                                    <div style="@($"display: grid; grid-template-columns: {(_opt.ShowCashFlowPosition ? "1fr 1fr" : "1fr")}; gap: 12px; align-items: start;")">
                                        @* Left Sub-Table: Billing & Accounts Receivable *@
                                        <table class="mud-table-root" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #cbd5e1;">
                                            <thead>
                                                <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                                    <th style="padding: 5px 10px; text-align: left; white-space: nowrap;">@Template.Label_TotalInvoiced</th>
                                                    <th style="padding: 5px 10px; text-align: right; white-space: nowrap;">@Template.Label_Total</th>
                                                </tr>
                                            </thead>
                                            <tbody>
                                                <tr style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 5px 10px;">@Template.Label_TotalInvoiced (@ReportSubtotalLabel)</td>
                                                    <td style="padding: 5px 10px; text-align: right; font-weight: 600; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(invoicedPreTax)</td>
                                                </tr>
                                                <tr style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 5px 10px 5px 18px; color: #555;">+ @Template.Label_Tax</td>
                                                    <td style="padding: 5px 10px; text-align: right; color: #555; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(invoicedTax)</td>
                                                </tr>
                                                <tr style="border-top: 1px solid #94a3b8; border-bottom: 1px solid #cbd5e1; background-color: #fafbfc; font-weight: 700;">
                                                    <td style="padding: 5px 10px;">@Template.Label_TotalInvoiced (@Template.Label_AmountsInclTax)</td>
                                                    <td style="padding: 5px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(invoicedIncTax)</td>
                                                </tr>
                                                <tr style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 5px 10px 5px 18px; color: #2e7d32; font-weight: 600;">
                                                        @Template.Label_Paid (@paidInvoicesCount/@_snap.Invoices.Count @(_snap.Invoices.Count == 1 ? Template.Label_Invoice : Template.Label_Invoices))
                                                    </td>
                                                    <td style="padding: 5px 10px; text-align: right; color: #2e7d32; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums;">
                                                        @(_snap.TotalPaid > 0m ? $"-{FormatMoney(_snap.TotalPaid)}" : FormatMoney(0m))
                                                    </td>
                                                </tr>
                                                <tr style="background-color: #f1f5f9; font-weight: 800; border-top: 1.5px solid #334155; border-bottom: 3px double #334155;">
                                                    <td style="padding: 6px 10px;">@Template.Label_BalanceDue</td>
                                                    <td style="@($"padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(_snap.BalanceDue > 0 ? "#c62828" : "#1e293b")};")">
                                                        @FormatMoney(_snap.BalanceDue)
                                                    </td>
                                                </tr>
                                            </tbody>
                                        </table>

                                        @* Right Sub-Table: Cash Flow Position *@
                                        @if (_opt.ShowCashFlowPosition)
                                        {
                                            var cashOutPurchasesTax = _snap.TotalPurchaseTax + _snap.TotalExpenseTax + _snap.TotalDirectExpenseTax;
                                            var cashPositionVal = IsTaxExcluded ? _snap.CashPositionPreTax : _snap.CashPosition;

                                            <table class="mud-table-root" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #cbd5e1;">
                                                <thead>
                                                    <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                                        <th style="padding: 5px 10px; text-align: left; white-space: nowrap;">@Template.Label_CashPosition</th>
                                                        <th style="padding: 5px 10px; text-align: right; white-space: nowrap;">@Template.Label_Total</th>
                                                    </tr>
                                                </thead>
                                                <tbody>
                                                    <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                                        <td colspan="2" style="padding: 4px 10px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: #475569;">
                                                            @CashInflowsGroupHeader
                                                        </td>
                                                    </tr>
                                                    <tr style="border-bottom: 1px solid #cbd5e1;">
                                                        <td style="padding: 5px 10px 5px 18px; color: #2e7d32; font-weight: 600;">@Template.Label_Paid</td>
                                                        <td style="padding: 5px 10px; text-align: right; color: #2e7d32; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(_snap.TotalPaid)</td>
                                                    </tr>
                                                    @if (_snap.TotalDirectIncome > 0m)
                                                    {
                                                        <tr style="border-bottom: 1px solid #cbd5e1;">
                                                            <td style="padding: 5px 10px 5px 18px; color: #2e7d32; font-weight: 600;">@BizLoc["Other Cash Received"]</td>
                                                            <td style="padding: 5px 10px; text-align: right; color: #2e7d32; font-weight: 700; white-space: nowrap; font-variant-numeric: tabular-nums;">@FormatMoney(IsTaxExcluded ? _snap.TotalDirectIncomeSubTotal : _snap.TotalDirectIncome)</td>
                                                        </tr>
                                                    }
                                                    <tr style="background-color: #f8fafc; border-bottom: 1px solid #e2e8f0;">
                                                        <td colspan="2" style="padding: 4px 10px; font-size: 0.7rem; font-weight: 800; text-transform: uppercase; letter-spacing: 0.6px; color: #475569;">
                                                            @CashOutflowsGroupHeader
                                                        </td>
                                                    </tr>
                                                    <tr style="border-bottom: 1px solid #eee;">
                                                        <td style="padding: 5px 10px 5px 18px;">@DirectLaborBaseLabel</td>
                                                        <td style="padding: 5px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(directLaborBaseCost)</td>
                                                    </tr>
                                                    <tr style="border-bottom: 1px solid #eee;">
                                                        <td style="padding: 5px 10px 5px 18px;">@DirectLaborContribLabel</td>
                                                        <td style="padding: 5px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(directLaborContribCost)</td>
                                                    </tr>
                                                    <tr style="border-bottom: 1px solid #eee;">
                                                        <td style="padding: 5px 10px 5px 18px;">@Template.Label_PurchasesBreakdown (@ReportSubtotalLabel)</td>
                                                        <td style="padding: 5px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(_snap.TotalPurchaseNet)</td>
                                                    </tr>
                                                    @if (_snap.TotalExpenseCost > 0)
                                                    {
                                                        <tr style="border-bottom: 1px solid #eee;">
                                                            <td style="padding: 5px 10px 5px 18px;">@Template.Label_ExpensesBreakdown (@ReportSubtotalLabel)</td>
                                                            <td style="padding: 5px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(_snap.TotalExpenseSubTotal)</td>
                                                        </tr>
                                                    }
                                                    @if (_snap.TotalDirectExpense > 0m)
                                                    {
                                                        <tr style="border-bottom: 1px solid #eee;">
                                                            <td style="padding: 5px 10px 5px 18px;">@BizLoc["Other Direct Payments"] (@ReportSubtotalLabel)</td>
                                                            <td style="padding: 5px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(_snap.TotalDirectExpenseSubTotal)</td>
                                                        </tr>
                                                    }
                                                    @if (!IsTaxExcluded)
                                                    {
                                                        <tr style="border-bottom: 1px solid #eee;">
                                                            <td style="padding: 5px 10px 5px 18px; color: #555;">
                                                                @Template.Label_Tax (@(_snap.TotalExpenseCost > 0 ? $"{Template.Label_PurchasesBreakdown} & {Template.Label_ExpensesBreakdown}" : Template.Label_PurchasesBreakdown))
                                                            </td>
                                                            <td style="padding: 5px 10px; text-align: right; color: #555; white-space: nowrap; font-variant-numeric: tabular-nums;">-@FormatMoney(cashOutPurchasesTax)</td>
                                                        </tr>
                                                    }
                                                    <tr style="background-color: #f1f5f9; font-weight: 800; border-top: 1.5px solid #334155; border-bottom: 3px double #334155;">
                                                        <td style="padding: 6px 10px;">@Template.Label_CashPosition</td>
                                                        <td style="@($"padding: 6px 10px; text-align: right; white-space: nowrap; font-variant-numeric: tabular-nums; color: {(cashPositionVal >= 0 ? "#2e7d32" : "#c62828")};")">
                                                            @FormatMoney(cashPositionVal)
                                                        </td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        }
                                    </div>
                                </div>
                            }

                            @* TABLE C: Quote vs. Actual Comparison (Hours & Internal Costs Only — Incl. Material Tax) *@
                            @if (_snap.HasQuoteBudget)
                            {
                                var hoursVar = _snap.TotalQuotedHours - _snap.TotalLaborHours;
                                var hoursUsagePct = _snap.TotalQuotedHours > 0 ? Math.Round(_snap.TotalLaborHours / _snap.TotalQuotedHours * 100m, 1) : 0m;

                                var laborCostVar = _snap.QuotedLaborCost - _snap.TotalLaborInternalCost;
                                var laborCostUsagePct = _snap.QuotedLaborCost > 0 ? Math.Round(_snap.TotalLaborInternalCost / _snap.QuotedLaborCost * 100m, 1) : 0m;

                                var matNetVar = _snap.QuotedMaterialCostNet - _snap.TotalPurchaseNet;
                                var matNetUsagePct = _snap.QuotedMaterialCostNet > 0 ? Math.Round(_snap.TotalPurchaseNet / _snap.QuotedMaterialCostNet * 100m, 1) : 0m;

                                var matTaxVar = _snap.QuotedMaterialCostTax - _snap.TotalPurchaseTax;
                                var matTaxUsagePct = _snap.QuotedMaterialCostTax > 0 ? Math.Round(_snap.TotalPurchaseTax / _snap.QuotedMaterialCostTax * 100m, 1) : 0m;

                                var matIncTaxVar = _snap.QuotedMaterialCostIncTax - _snap.TotalPurchaseCost;
                                var matIncTaxUsagePct = _snap.QuotedMaterialCostIncTax > 0 ? Math.Round(_snap.TotalPurchaseCost / _snap.QuotedMaterialCostIncTax * 100m, 1) : 0m;

                                var totalCostPreTaxVar = _snap.QuotedTotalCostPreTax - _snap.TotalInternalSpentPreTax;
                                var totalCostPreTaxUsagePct = _snap.QuotedTotalCostPreTax > 0 ? Math.Round(_snap.TotalInternalSpentPreTax / _snap.QuotedTotalCostPreTax * 100m, 1) : 0m;

                                var totalCostIncTaxVar = _snap.QuotedTotalCostIncTax - _snap.TotalInternalSpent;
                                var totalCostIncTaxUsagePct = _snap.QuotedTotalCostIncTax > 0 ? Math.Round(_snap.TotalInternalSpent / _snap.QuotedTotalCostIncTax * 100m, 1) : 0m;

                                <div class="keep-together">
                                    <MudText Typo="Typo.subtitle2" Class="mb-1 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                        @QuoteVsActualTitle
                                    </MudText>

                                    <table class="mud-table-root keep-together" style="width: 100%; border-collapse: collapse; font-size: 0.83rem; border: 1px solid #e0e0e0;">
                                        <thead>
                                            <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                                <th style="padding: 6px 10px; text-align: left; width: 38%;">@Template.Label_FinancialCategory</th>
                                                <th style="padding: 6px 10px; text-align: right; width: 18%; white-space: nowrap;">@Template.Label_Budgeted (@Template.Label_Quote)</th>
                                                <th style="padding: 6px 10px; text-align: right; width: 18%; white-space: nowrap;">@Template.Label_Actual</th>
                                                <th style="padding: 6px 10px; text-align: right; width: 16%; white-space: nowrap;">@Template.Label_Variance</th>
                                                <th style="padding: 6px 10px; text-align: right; width: 10%; white-space: nowrap;">@Template.Label_Usage</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 10px; font-weight: 600;">@Template.Label_Hours (@DirectLaborLabel)</td>
                                                <td style="padding: 6px 10px; text-align: right; white-space: nowrap;">@_snap.TotalQuotedHours.ToString("N1") h</td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap;">@_snap.TotalLaborHours.ToString("N1") h</td>
                                                <td style="@($"padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap; color: {(hoursVar >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @FormatSignedHours(hoursVar)
                                                </td>
                                                <td style="@($"padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap; color: {(hoursUsagePct <= 100m ? "#2e7d32" : "#c62828")};")">
                                                    @(_snap.TotalQuotedHours > 0 ? $"{hoursUsagePct:N1}%" : "—")
                                                </td>
                                            </tr>

                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 10px;">@DirectLaborLabel (@InternalCostLabel)</td>
                                                <td style="padding: 6px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.QuotedLaborCost)</td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(_snap.TotalLaborInternalCost)</td>
                                                <td style="@($"padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap; color: {(laborCostVar >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @FormatSignedMoney(laborCostVar)
                                                </td>
                                                <td style="@($"padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap; color: {(laborCostUsagePct <= 100m ? "#2e7d32" : "#c62828")};")">
                                                    @(_snap.QuotedLaborCost > 0 ? $"{laborCostUsagePct:N1}%" : "—")
                                                </td>
                                            </tr>

                                            <tr style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 10px;">@Template.Label_PurchasesBreakdown (@Template.Label_PreTax)</td>
                                                <td style="padding: 6px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.QuotedMaterialCostNet)</td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(_snap.TotalPurchaseNet)</td>
                                                <td style="@($"padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap; color: {(matNetVar >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @FormatSignedMoney(matNetVar)
                                                </td>
                                                <td style="@($"padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap; color: {(matNetUsagePct <= 100m ? "#2e7d32" : "#c62828")};")">
                                                    @(_snap.QuotedMaterialCostNet > 0 ? $"{matNetUsagePct:N1}%" : "—")
                                                </td>
                                            </tr>

                                            @if (!IsTaxExcluded)
                                            {
                                                <tr style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 6px 10px; color: #555; padding-left: 18px;">+ @Template.Label_Tax (@Template.Label_PurchasesBreakdown)</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #555; white-space: nowrap;">@FormatMoney(_snap.QuotedMaterialCostTax)</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #555; white-space: nowrap;">@FormatMoney(_snap.TotalPurchaseTax)</td>
                                                    <td style="@($"padding: 6px 10px; text-align: right; white-space: nowrap; color: {(matTaxVar >= 0 ? "#2e7d32" : "#c62828")};")">
                                                        @FormatSignedMoney(matTaxVar)
                                                    </td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #555; white-space: nowrap;">
                                                        @(_snap.QuotedMaterialCostTax > 0 ? $"{matTaxUsagePct:N1}%" : "—")
                                                    </td>
                                                </tr>

                                                <tr style="border-bottom: 1px solid #cbd5e1; background-color: #fafbfc; font-weight: 600;">
                                                    <td style="padding: 6px 10px;">@Template.Label_PurchasesBreakdown (@Template.Label_AmountsInclTax)</td>
                                                    <td style="padding: 6px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.QuotedMaterialCostIncTax)</td>
                                                    <td style="padding: 6px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.TotalPurchaseCost)</td>
                                                    <td style="@($"padding: 6px 10px; text-align: right; white-space: nowrap; color: {(matIncTaxVar >= 0 ? "#2e7d32" : "#c62828")};")">
                                                        @FormatSignedMoney(matIncTaxVar)
                                                    </td>
                                                    <td style="@($"padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap; color: {(matIncTaxUsagePct <= 100m ? "#2e7d32" : "#c62828")};")">
                                                        @(_snap.QuotedMaterialCostIncTax > 0 ? $"{matIncTaxUsagePct:N1}%" : "—")
                                                    </td>
                                                </tr>
                                            }

                                            <tr style="@($"border-bottom: {(IsTaxExcluded ? "none" : "1px solid #cbd5e1")}; background-color: #f1f5f9; font-weight: 800;")">
                                                <td style="padding: 7px 10px;">@Template.Label_TotalCost (@Template.Label_PreTax)</td>
                                                <td style="padding: 7px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.QuotedTotalCostPreTax)</td>
                                                <td style="padding: 7px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.TotalInternalSpentPreTax)</td>
                                                <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; color: {(totalCostPreTaxVar >= 0 ? "#2e7d32" : "#c62828")};")">
                                                    @FormatSignedMoney(totalCostPreTaxVar)
                                                </td>
                                                <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; color: {(totalCostPreTaxUsagePct <= 100m ? "#2e7d32" : "#c62828")};")">
                                                    @(_snap.QuotedTotalCostPreTax > 0 ? $"{totalCostPreTaxUsagePct:N1}%" : "—")
                                                </td>
                                            </tr>

                                            @if (!IsTaxExcluded)
                                            {
                                                <tr style="background-color: #e2e8f0; font-weight: 800;">
                                                    <td style="padding: 7px 10px;">@Template.Label_TotalCost (@Template.Label_AmountsInclTax)</td>
                                                    <td style="padding: 7px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.QuotedTotalCostIncTax)</td>
                                                    <td style="padding: 7px 10px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.TotalInternalSpent)</td>
                                                    <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; color: {(totalCostIncTaxVar >= 0 ? "#2e7d32" : "#c62828")};")">
                                                        @FormatSignedMoney(totalCostIncTaxVar)
                                                    </td>
                                                    <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; color: {(totalCostIncTaxUsagePct <= 100m ? "#2e7d32" : "#c62828")};")">
                                                        @(_snap.QuotedTotalCostIncTax > 0 ? $"{totalCostIncTaxUsagePct:N1}%" : "—")
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }

                            @* TABLE D: Optional Itemized Business Overhead Allocation *@
                            @if (_opt.ShowOverheadSection && _opt.ShowOverheadBreakdownTable && !_snap.IsInternalProject && _snap.OverheadRows.Count > 0)
                            {
                                var poolDisplayTotal = IsTaxIncluded ? _snap.CompanyOverheadPoolTotal : _snap.CompanyOverheadPoolPreTax;
                                var allocatedDisplayTotal = IsTaxIncluded ? _snap.AllocatedOverheadTotal : _snap.AllocatedOverheadPreTax;

                                <div class="@(_opt.PageBreakBeforeOverhead ? "force-break" : "") mt-4 @(_snap.OverheadRows.Count <= 10 ? "keep-together" : "allow-break")">
                                    <MudText Typo="Typo.subtitle2" Class="mb-1 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                        @OverheadAllocationTitle @(IsTaxIncluded ? $"({Template.Label_AmountsInclTax})" : $"({Template.Label_PreTax})")
                                    </MudText>

                                    <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.83rem; border: 1px solid #e0e0e0;">
                                        <thead class="keep-together keep-with-next repeat-on-break">
                                            <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                                <th style="padding: 6px 10px; text-align: left; width: 32%;">@Template.Label_FinancialCategory</th>
                                                <th style="padding: 6px 10px; text-align: left; width: 32%;">@Template.Label_Details</th>
                                                <th style="padding: 6px 10px; text-align: right; width: 13%; white-space: nowrap;">@BizLoc["Company Pool"]</th>
                                                <th style="padding: 6px 10px; text-align: right; width: 9%; white-space: nowrap;">@BizLoc["Share %"]</th>
                                                <th style="padding: 6px 10px; text-align: right; width: 14%; white-space: nowrap;">@BizLoc["Allocated"]</th>
                                            </tr>
                                        </thead>
                                        <tbody class="allow-break">
                                            @foreach (var row in _snap.OverheadRows)
                                            {
                                                var rowPool = IsTaxIncluded ? row.CompanyPoolTotal : row.CompanyPoolPreTax;
                                                var rowAlloc = IsTaxIncluded ? row.AllocatedTotal : row.AllocatedPreTax;
                                                <tr class="mud-table-row keep-together" style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 6px 10px; font-weight: 600;">@GetLocalizedOverheadCategoryName(row.Category, row.Name)</td>
                                                    <td style="padding: 6px 10px; color: #555;">@(string.IsNullOrWhiteSpace(row.Details) ? "—" : row.Details)</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #555; white-space: nowrap;">@FormatMoney(rowPool)</td>
                                                    <td style="padding: 6px 10px; text-align: right; color: #555; white-space: nowrap;">@_snap.OverheadAllocationSharePercent.ToString("N1")%</td>
                                                    <td style="padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(rowAlloc)</td>
                                                </tr>
                                            }
                                            <tr class="mud-table-row keep-together" style="background-color: #f1f5f9; font-weight: 800;">
                                                <td style="padding: 7px 10px;">@AllocatedOverheadLabel (@(IsTaxIncluded ? Template.Label_AmountsInclTax : Template.Label_PreTax))</td>
                                                <td style="padding: 7px 10px; color: #555;">
                                                    @_snap.TotalLaborHours.ToString("N1") h / @_snap.TotalCompanyDirectLaborHours.ToString("N1") h (@BizLoc["Direct Client Hours"])
                                                </td>
                                                <td style="padding: 7px 10px; text-align: right; white-space: nowrap;">@FormatMoney(poolDisplayTotal)</td>
                                                <td style="padding: 7px 10px; text-align: right; white-space: nowrap;">@_snap.OverheadAllocationSharePercent.ToString("N1")%</td>
                                                <td style="padding: 7px 10px; text-align: right; white-space: nowrap;">@FormatMoney(allocatedDisplayTotal)</td>
                                            </tr>
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                        else
                        {
                            @* Client Billable Mode — Clean Accounting Summary Table (No Cards) *@
                            <table class="mud-table-root keep-together" style="width: 100%; border-collapse: collapse; font-size: 0.83rem; border: 1px solid #e0e0e0;">
                                <thead>
                                    <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                        <th style="padding: 6px 10px; text-align: left;">@Template.Label_FinancialCategory</th>
                                        <th style="padding: 6px 10px; text-align: left;">@Template.Label_Details</th>
                                        @if (IsTaxSeparate)
                                        {
                                            <th style="padding: 6px 10px; text-align: right; white-space: nowrap;">@ReportSubtotalLabel</th>
                                            <th style="padding: 6px 10px; text-align: right; white-space: nowrap;">@Template.Label_Tax</th>
                                            <th style="padding: 6px 10px; text-align: right; white-space: nowrap;">@Template.Label_Total</th>
                                        }
                                        else if (IsTaxExcluded)
                                        {
                                            <th style="padding: 6px 10px; text-align: right; white-space: nowrap;">@ReportSubtotalLabel (@Template.Label_PreTax)</th>
                                        }
                                        else
                                        {
                                            <th style="padding: 6px 10px; text-align: right; white-space: nowrap;">@Template.Label_Total</th>
                                        }
                                    </tr>
                                </thead>
                                <tbody>
                                    @if (_snap.ExpectedRevenue > 0)
                                    {
                                        <tr style="border-bottom: 1px solid #eee;">
                                            <td style="padding: 6px 10px; font-weight: 600;">@Template.Label_ExpectedRevenue</td>
                                            <td style="padding: 6px 10px; color: #555;">@_snap.Quotes.Count @(_snap.Quotes.Count == 1 ? Template.Label_Quote : Template.Label_Quotes)</td>
                                            @if (IsTaxSeparate)
                                            {
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(expectedRevPreTax)</td>
                                                <td style="padding: 6px 10px; text-align: right; color: #555; white-space: nowrap;">@FormatMoney(expectedRevTax)</td>
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap;">@FormatMoney(expectedRevIncTax)</td>
                                            }
                                            else
                                            {
                                                <td style="padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap;">@FormatMoney(IsTaxExcluded ? expectedRevPreTax : expectedRevIncTax)</td>
                                            }
                                        </tr>
                                    }
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 6px 10px; font-weight: 600;">@Template.Label_TotalInvoiced</td>
                                        <td style="padding: 6px 10px; color: #555;">@_snap.Invoices.Count @(_snap.Invoices.Count == 1 ? Template.Label_Invoice : Template.Label_Invoices)</td>
                                        @if (IsTaxSeparate)
                                        {
                                            <td style="padding: 6px 10px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(invoicedPreTax)</td>
                                            <td style="padding: 6px 10px; text-align: right; color: #555; white-space: nowrap;">@FormatMoney(invoicedTax)</td>
                                            <td style="padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap;">@FormatMoney(invoicedIncTax)</td>
                                        }
                                        else
                                        {
                                            <td style="padding: 6px 10px; text-align: right; font-weight: 700; white-space: nowrap;">@FormatMoney(IsTaxExcluded ? invoicedPreTax : invoicedIncTax)</td>
                                        }
                                    </tr>
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 6px 10px; color: #2e7d32; font-weight: 600;">@Template.Label_Paid</td>
                                        <td style="padding: 6px 10px; color: #555;">—</td>
                                        @if (IsTaxSeparate)
                                        {
                                            <td colspan="2"></td>
                                            <td style="padding: 6px 10px; text-align: right; color: #2e7d32; font-weight: 700; white-space: nowrap;">@FormatMoney(_snap.TotalPaid)</td>
                                        }
                                        else
                                        {
                                            <td style="padding: 6px 10px; text-align: right; color: #2e7d32; font-weight: 700; white-space: nowrap;">@FormatMoney(_snap.TotalPaid)</td>
                                        }
                                    </tr>
                                    <tr style="background-color: #f1f5f9; font-weight: 800;">
                                        <td style="padding: 7px 10px;">@Template.Label_BalanceDue</td>
                                        <td style="padding: 7px 10px; color: #555;">
                                            @Template.Label_Hours: @_snap.TotalLaborHours.ToString("N1") h @(_snap.TotalQuotedHours > 0 ? $"/ {_snap.TotalQuotedHours:N1} h ({_snap.LaborEfficiencyPercent:N0}%)" : "")
                                        </td>
                                        @if (IsTaxSeparate)
                                        {
                                            <td colspan="2"></td>
                                            <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; color: {(_snap.BalanceDue > 0 ? "#c62828" : "#1e293b")};")">@FormatMoney(_snap.BalanceDue)</td>
                                        }
                                        else
                                        {
                                            <td style="@($"padding: 7px 10px; text-align: right; white-space: nowrap; color: {(_snap.BalanceDue > 0 ? "#c62828" : "#1e293b")};")">@FormatMoney(_snap.BalanceDue)</td>
                                        }
                                    </tr>
                                </tbody>
                            </table>
                        }
                    </div>
                }

                @* 5. SECTION 2: LABOR & TIME BREAKDOWN *@
                @if (_opt.ShowLaborSection && (_snap.TaskLaborRows.Any() || _snap.EmployeeLaborRows.Any() || _snap.TimeEntries.Any()))
                {
                    <div class="@(_opt.PageBreakBeforeLabor ? "force-break" : "") allow-break mb-6">
                        <MudText Typo="Typo.h6" Class="mb-3 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @Template.Label_LaborBreakdown
                        </MudText>

                        @* 5A. Labor by Task & Subtask *@
                        @if (_opt.ShowLaborByTask && _snap.TaskLaborRows.Any())
                        {
                            <div class="mb-5 @(_snap.TaskLaborRows.Count <= 12 ? "keep-together" : "allow-break")">
                                <MudText Typo="Typo.subtitle2" Class="mb-2 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                    @Template.Label_LaborByTask
                                </MudText>

                                <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.83rem; border: 1px solid #e0e0e0;">
                                    <thead class="keep-together keep-with-next repeat-on-break">
                                        <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                            <th style="padding: 6px 8px; text-align: left;">@Template.Label_Description</th>
                                            <th style="padding: 6px 8px; text-align: left;">@Template.Label_Employees</th>
                                            @if (_snap.TotalQuotedHours > 0)
                                            {
                                                <th style="padding: 6px 8px; text-align: right;">@Template.Label_Budgeted (h)</th>
                                            }
                                            <th style="padding: 6px 8px; text-align: right;">@Template.Label_Actual (h)</th>
                                            @if (_snap.TotalQuotedHours > 0)
                                            {
                                                <th style="padding: 6px 8px; text-align: right;">@Template.Label_Usage</th>
                                            }
                                            <th style="padding: 6px 8px; text-align: right;">%</th>
                                            @if (ShowLaborMoney)
                                            {
                                                <th style="padding: 6px 8px; text-align: right;">@Template.Label_Total</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="allow-break">
                                        @for (int i = 0; i < _snap.TaskLaborRows.Count; i++)
                                        {
                                            var row = _snap.TaskLaborRows[i];
                                            var isLast = i == _snap.TaskLaborRows.Count - 1;
                                            <tr class="mud-table-row keep-together @(isLast ? "keep-with-next" : "")" style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 8px; font-weight: 600;">
                                                    @row.TaskName
                                                    @if (!string.IsNullOrWhiteSpace(row.SubTaskName) && row.SubTaskName != "General")
                                                    {
                                                        <span style="color: #666; font-weight: 400;"> — @row.SubTaskName</span>
                                                    }
                                                </td>
                                                <td style="padding: 6px 8px; color: #555; font-size: 0.78rem;">
                                                    @(row.ContributorNames.Count > 0 ? string.Join(", ", row.ContributorNames) : "—")
                                                </td>
                                                @if (_snap.TotalQuotedHours > 0)
                                                {
                                                    <td style="padding: 6px 8px; text-align: right;">
                                                        @(row.QuotedHours > 0 ? row.QuotedHours.ToString("N1") : "—")
                                                    </td>
                                                }
                                                <td style="padding: 6px 8px; text-align: right; font-weight: 600;">
                                                    @row.ActualHours.ToString("N1")
                                                </td>
                                                @if (_snap.TotalQuotedHours > 0)
                                                {
                                                    <td style="@($"padding: 6px 8px; text-align: right; color: {(row.IsOverBudget ? "#c62828" : "#2e7d32")}; font-weight: 600;")">
                                                        @(row.QuotedHours > 0 ? $"{row.UsagePercent:N0}%" : "—")
                                                    </td>
                                                }
                                                <td style="padding: 6px 8px; text-align: right; color: #555;">
                                                    @row.SharePercent.ToString("N1")%
                                                </td>
                                                @if (ShowLaborMoney)
                                                {
                                                    <td style="padding: 6px 8px; text-align: right; font-weight: 600;">
                                                        @FormatMoney(GetLaborAmount(row.InternalCost, row.BillableValue))
                                                    </td>
                                                }
                                            </tr>
                                        }
                                        <tr class="mud-table-row keep-together" style="background-color: #f4f6f8; font-weight: 800;">
                                            <td colspan="2" style="padding: 7px 8px;">@Template.Label_Total</td>
                                            @if (_snap.TotalQuotedHours > 0)
                                            {
                                                <td style="padding: 7px 8px; text-align: right;">@_snap.TotalQuotedHours.ToString("N1")</td>
                                            }
                                            <td style="padding: 7px 8px; text-align: right;">@_snap.TotalLaborHours.ToString("N1")</td>
                                            @if (_snap.TotalQuotedHours > 0)
                                            {
                                                <td style="padding: 7px 8px; text-align: right;">@_snap.LaborEfficiencyPercent.ToString("N0")%</td>
                                            }
                                            <td style="padding: 7px 8px; text-align: right;">100%</td>
                                            @if (ShowLaborMoney)
                                            {
                                                <td style="padding: 7px 8px; text-align: right;">
                                                    @FormatMoney(GetLaborAmount(_snap.TotalLaborInternalCost, _snap.TotalLaborBillableValue))
                                                </td>
                                            }
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* 5B. Labor by Employee *@
                        @if (_opt.ShowLaborByEmployee && _snap.EmployeeLaborRows.Any())
                        {
                            <div class="mb-5 @(_snap.EmployeeLaborRows.Count <= 12 ? "keep-together" : "allow-break")">
                                <MudText Typo="Typo.subtitle2" Class="mb-2 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                    @Template.Label_LaborByEmployee
                                </MudText>

                                <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.83rem; border: 1px solid #e0e0e0;">
                                    <thead class="keep-together keep-with-next repeat-on-break">
                                        <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                            <th style="padding: 6px 8px; text-align: left;">@Template.Label_Employee</th>
                                            <th style="padding: 6px 8px; text-align: left;">@AppLabels.Team</th>
                                            <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">@Template.Label_Hours</th>
                                            <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">%</th>
                                            @if (ShowLaborMoney)
                                            {
                                                <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">
                                                    @(ShowInternalCosts ? BizLoc["Total Cost / h"] : Template.Label_HourlyRate)
                                                </th>
                                                <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">@Template.Label_Total</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="allow-break">
                                        @for (int i = 0; i < _snap.EmployeeLaborRows.Count; i++)
                                        {
                                            var emp = _snap.EmployeeLaborRows[i];
                                            var isLast = i == _snap.EmployeeLaborRows.Count - 1;
                                            <tr class="mud-table-row keep-together @(isLast ? "keep-with-next" : "")" style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 8px; font-weight: 600;">@emp.EmployeeName</td>
                                                <td style="padding: 6px 8px; color: #555;">@(string.IsNullOrWhiteSpace(emp.TeamName) ? "—" : emp.TeamName)</td>
                                                <td style="padding: 6px 8px; text-align: right; font-weight: 600; white-space: nowrap;">@emp.TotalHours.ToString("N1")</td>
                                                <td style="padding: 6px 8px; text-align: right; color: #555; white-space: nowrap;">@emp.SharePercent.ToString("N1")%</td>
                                                @if (ShowLaborMoney)
                                                {
                                                    <td style="padding: 6px 8px; text-align: right; color: #555; white-space: nowrap;">
                                                        @FormatMoney(GetLaborAmount(emp.EffectiveInternalRate, emp.EffectiveBillableRate))/h
                                                    </td>
                                                    <td style="padding: 6px 8px; text-align: right; font-weight: 600; white-space: nowrap;">
                                                        @FormatMoney(GetLaborAmount(emp.InternalCost, emp.BillableValue))
                                                    </td>
                                                }
                                            </tr>
                                        }
                                        <tr class="mud-table-row keep-together" style="background-color: #f4f6f8; font-weight: 800;">
                                            <td colspan="2" style="padding: 7px 8px;">@Template.Label_Total (@_snap.EmployeeLaborRows.Count @Template.Label_Employees)</td>
                                            <td style="padding: 7px 8px; text-align: right; white-space: nowrap;">@_snap.TotalLaborHours.ToString("N1")</td>
                                            <td style="padding: 7px 8px; text-align: right; white-space: nowrap;">100%</td>
                                            @if (ShowLaborMoney)
                                            {
                                                <td style="padding: 7px 8px; text-align: right;">—</td>
                                                <td style="padding: 7px 8px; text-align: right; white-space: nowrap;">
                                                    @FormatMoney(GetLaborAmount(_snap.TotalLaborInternalCost, _snap.TotalLaborBillableValue))
                                                </td>
                                            }
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* 5C. Periodic Labor Breakdown (1 Table: 1 Row per Week/Month × 1 Column per Employee + 2 Totals, Hours Only) *@
                        @if (_opt.ShowLaborPeriodicBreakdown && _snap.TimeEntries.Any())
                        {
                            <div class="mb-4 allow-break">
                                <MudText Typo="Typo.subtitle2" Class="mb-2 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                    @Template.Label_LaborByPeriod
                                    (@(_opt.LaborPeriodGranularity == ProjectReportPeriodGranularity.Monthly ? Template.Label_Month : Template.Label_Week))
                                </MudText>

                                @if (_opt.LaborPeriodicLayout == ProjectReportLaborLayout.TaskMatrix)
                                {
                                    @foreach (var taskGroup in _taskPeriodicGroups)
                                    {
                                        <div class="mb-4 @(taskGroup.Rows.Count <= 12 ? "keep-together" : "allow-break")">
                                            <div class="d-flex justify-space-between align-center px-3 py-1 rounded-t keep-together keep-with-next"
                                                 style="@($"background-color: {Company.PrimaryColor}; color: white; font-size: 0.84rem;")">
                                                <div><b>@taskGroup.DisplayTitle</b></div>
                                                <div><b>@taskGroup.TotalHours.ToString("N1") h</b></div>
                                            </div>
                                            <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.8rem; border: 1px solid #e0e0e0;">
                                                <thead class="keep-together keep-with-next repeat-on-break">
                                                    <tr style="background-color: #f1f3f5; color: #333;">
                                                        <th style="padding: 5px 8px; text-align: left; width: 28%; white-space: nowrap;">@PeriodColumnLabel</th>
                                                        <th style="padding: 5px 8px; text-align: left;">@Template.Label_Employees</th>
                                                        <th style="padding: 5px 8px; text-align: right; width: 15%; white-space: nowrap;">@Template.Label_Hours</th>
                                                        <th style="padding: 5px 8px; text-align: right; width: 15%; white-space: nowrap;">@Template.Label_RunningTotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="allow-break">
                                                    @foreach (var pRow in taskGroup.Rows)
                                                    {
                                                        <tr class="mud-table-row keep-together" style="border-bottom: 1px solid #eee;">
                                                            <td style="padding: 5px 8px; font-weight: 600; white-space: nowrap;">@pRow.PeriodLabel</td>
                                                            <td style="padding: 5px 8px; color: #555;">@pRow.TasksSummary</td>
                                                            <td style="padding: 5px 8px; text-align: right; font-weight: 600; white-space: nowrap;">@pRow.Hours.ToString("N1")</td>
                                                            <td style="padding: 5px 8px; text-align: right; color: #666; white-space: nowrap;">@pRow.RunningHours.ToString("N1")</td>
                                                        </tr>
                                                    }
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                                else
                                {
                                    @* Unified Weekly / Monthly Labor Summary Table (1 Row per Week/Month × 1 Column per Employee + Total & Cumulative) *@
                                    @foreach (var chunk in _periodicLaborMatrices)
                                    {
                                        <div class="mb-4 @(chunk.Rows.Count <= 12 ? "keep-together" : "allow-break")">
                                            @if (chunk.TotalChunks > 1)
                                            {
                                                <div class="mb-1 keep-together keep-with-next" style="font-size: 0.76rem; color: #666; font-weight: 600;">
                                                    @string.Format(BizLoc["{0} Columns ({1} of {2})"].Value, AppLabels.Employee, chunk.ChunkIndex, chunk.TotalChunks)
                                                </div>
                                            }
                                            <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.78rem; border: 1px solid #e0e0e0;">
                                                <thead class="keep-together keep-with-next repeat-on-break">
                                                    <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                                        <th style="padding: 5px 8px; text-align: left; white-space: nowrap;">@PeriodColumnLabel</th>
                                                        @foreach (var col in chunk.Columns)
                                                        {
                                                            <th style="padding: 5px 6px; text-align: right; white-space: nowrap;">
                                                                @(chunk.Columns.Count <= 5 ? col.EmployeeName : col.ShortName)
                                                            </th>
                                                        }
                                                        <th style="padding: 5px 8px; text-align: right; white-space: nowrap;">@Template.Label_Total (h)</th>
                                                        <th style="padding: 5px 8px; text-align: right; white-space: nowrap;">@Template.Label_RunningTotal</th>
                                                    </tr>
                                                </thead>
                                                <tbody class="allow-break">
                                                    @for (int i = 0; i < chunk.Rows.Count; i++)
                                                    {
                                                        var mRow = chunk.Rows[i];
                                                        var isLast = i == chunk.Rows.Count - 1;
                                                        <tr class="mud-table-row keep-together @(isLast ? "keep-with-next" : "")" style="border-bottom: 1px solid #eee;">
                                                            <td style="padding: 5px 8px; font-weight: 600; white-space: nowrap;">
                                                                @mRow.PeriodLabel
                                                                @if (!string.IsNullOrWhiteSpace(mRow.SubLabel))
                                                                {
                                                                    <span style="color: #666; font-weight: 400; font-size: 0.72rem;"> (@mRow.SubLabel)</span>
                                                                }
                                                            </td>
                                                            @foreach (var col in chunk.Columns)
                                                            {
                                                                var hrs = mRow.GetHours(col.EmployeeId);
                                                                <td style="padding: 5px 6px; text-align: right; white-space: nowrap; color: @(hrs > 0 ? "#111" : "#bbb");">
                                                                    @(hrs > 0 ? hrs.ToString("N1") : "—")
                                                                </td>
                                                            }
                                                            <td style="padding: 5px 8px; text-align: right; font-weight: 700; white-space: nowrap;">@mRow.PeriodTotalHours.ToString("N1")</td>
                                                            <td style="padding: 5px 8px; text-align: right; color: #555; white-space: nowrap;">@mRow.RunningTotalHours.ToString("N1")</td>
                                                        </tr>
                                                    }
                                                    <tr class="mud-table-row keep-together" style="background-color: #f4f6f8; font-weight: 800;">
                                                        <td style="padding: 6px 8px; white-space: nowrap;">@Template.Label_Total</td>
                                                        @foreach (var col in chunk.Columns)
                                                        {
                                                            <td style="padding: 6px 6px; text-align: right; white-space: nowrap;">@chunk.GetColumnTotalHours(col.EmployeeId).ToString("N1")</td>
                                                        }
                                                        <td style="padding: 6px 8px; text-align: right; white-space: nowrap;">@chunk.GrandTotalHours.ToString("N1")</td>
                                                        <td style="padding: 6px 8px; text-align: right; white-space: nowrap;">@chunk.GrandTotalHours.ToString("N1")</td>
                                                    </tr>
                                                </tbody>
                                            </table>
                                        </div>
                                    }
                                }
                            </div>
                        }
                    </div>
                }

                @* 6. SECTION 3: PURCHASES & PROCUREMENT BREAKDOWN ("ACHATS PAR MOIS") *@
                @if (_canViewPurchases && _opt.ShowPurchasesSection && _purchaseGroups.Any())
                {
                    <div class="@(_opt.PageBreakBeforePurchases ? "force-break" : "") allow-break mb-6">
                        <MudText Typo="Typo.h6" Class="mb-3 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @Template.Label_PurchasesBreakdown
                        </MudText>

                        @* 6A. Monthly Purchases Summary Table at Top of Section (Includes Grand Total Footer) *@
                        @if (_monthlyPurchaseGroups.Any())
                        {
                            <div class="mb-5 @(_monthlyPurchaseGroups.Count <= 12 ? "keep-together" : "allow-break")">
                                <MudText Typo="Typo.subtitle2" Class="mb-2 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700; text-transform: uppercase; letter-spacing: 0.5px;")">
                                    @Template.Label_MonthlyPurchasesSummary
                                </MudText>
                                <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.83rem; border: 1px solid #e0e0e0;">
                                    <thead class="keep-together keep-with-next repeat-on-break">
                                        <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                            <th style="padding: 6px 8px; text-align: left;">@Template.Label_Month</th>
                                            <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">@Template.Label_Items</th>
                                            @if (ShowFinancialAmounts)
                                            {
                                                @if (_opt.ShowPurchaseTaxBreakdown)
                                                {
                                                    <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">@ReportSubtotalLabel</th>
                                                    <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">@Template.Label_Tax</th>
                                                }
                                                <th style="padding: 6px 8px; text-align: right; white-space: nowrap;">@Template.Label_Total</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="allow-break">
                                        @for (int i = 0; i < _monthlyPurchaseGroups.Count; i++)
                                        {
                                            var grp = _monthlyPurchaseGroups[i];
                                            var isLast = i == _monthlyPurchaseGroups.Count - 1;
                                            <tr class="mud-table-row keep-together @(isLast ? "keep-with-next" : "")" style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 6px 8px; font-weight: 600;">@grp.GroupTitle</td>
                                                <td style="padding: 6px 8px; text-align: right; white-space: nowrap;">@grp.ItemCount</td>
                                                @if (ShowFinancialAmounts)
                                                {
                                                    @if (_opt.ShowPurchaseTaxBreakdown)
                                                    {
                                                        <td style="padding: 6px 8px; text-align: right; white-space: nowrap;">@FormatMoney(grp.NetTotal)</td>
                                                        <td style="padding: 6px 8px; text-align: right; color: #555; white-space: nowrap;">@FormatMoney(grp.TaxAmount)</td>
                                                    }
                                                    <td style="padding: 6px 8px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(grp.GrandTotal)</td>
                                                }
                                            </tr>
                                        }
                                        <tr class="mud-table-row keep-together" style="background-color: #f4f6f8; font-weight: 800;">
                                            <td style="padding: 7px 8px;">@Template.Label_PurchasesBreakdown — @Template.Label_Total</td>
                                            <td style="padding: 7px 8px; text-align: right; white-space: nowrap;">@_snap.PurchaseItems.Count</td>
                                            @if (ShowFinancialAmounts)
                                            {
                                                @if (_opt.ShowPurchaseTaxBreakdown)
                                                {
                                                    <td style="padding: 7px 8px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.TotalPurchaseNet)</td>
                                                    <td style="padding: 7px 8px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.TotalPurchaseTax)</td>
                                                }
                                                <td style="@($"padding: 7px 8px; text-align: right; white-space: nowrap; color: {Company.PrimaryColor};")">@FormatMoney(_snap.TotalPurchaseCost)</td>
                                            }
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }

                        @* 6B. Detailed Purchase Line Items (Wider Description, Single-Line Date, No Redundant Tax/Subtotal Columns) *@
                        @if (_opt.PurchasesGrouping != ProjectReportPurchasesGrouping.ByMonthSummaryOnly)
                        {
                            @foreach (var grp in _purchaseGroups)
                            {
                                <div class="mb-4 @(grp.Items.Count <= 12 ? "keep-together" : "allow-break")">
                                    @if (!string.IsNullOrWhiteSpace(grp.GroupTitle))
                                    {
                                        <div class="d-flex justify-space-between align-center px-3 py-1 rounded-t keep-together keep-with-next"
                                             style="@($"background-color: {Company.PrimaryColor}; color: white; font-size: 0.84rem;")">
                                            <div><b>@grp.GroupTitle</b> (@grp.ItemCount @(grp.ItemCount == 1 ? Template.Label_Item : Template.Label_Items))</div>
                                            @if (ShowFinancialAmounts)
                                            {
                                                <div><b>@FormatMoney(grp.GrandTotal)</b></div>
                                            }
                                        </div>
                                    }
                                    <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.8rem; border: 1px solid #e0e0e0;">
                                        <thead class="keep-together keep-with-next repeat-on-break">
                                            <tr style="background-color: #f1f3f5; color: #333;">
                                                <th style="padding: 5px 8px; text-align: left; width: 92px; white-space: nowrap;">@Template.Label_Date</th>
                                                <th style="padding: 5px 8px; text-align: left; width: 100px; white-space: nowrap;">PO #</th>
                                                @if (_opt.PurchasesGrouping != ProjectReportPurchasesGrouping.BySupplier)
                                                {
                                                    <th style="padding: 5px 8px; text-align: left; width: 20%;">@BizLoc["Supplier"]</th>
                                                }
                                                <th style="padding: 5px 8px; text-align: left;">@Template.Label_Description</th>
                                                <th style="padding: 5px 8px; text-align: right; width: 64px; white-space: nowrap;">@Template.Label_Quantity</th>
                                                @if (ShowFinancialAmounts)
                                                {
                                                    <th style="padding: 5px 8px; text-align: right; width: 104px; white-space: nowrap;">@Template.Label_Total</th>
                                                }
                                            </tr>
                                        </thead>
                                        <tbody class="allow-break">
                                            @for (int i = 0; i < grp.Items.Count; i++)
                                            {
                                                var item = grp.Items[i];
                                                var isLast = i == grp.Items.Count - 1 && !string.IsNullOrWhiteSpace(grp.GroupTitle) && ShowFinancialAmounts;
                                                <tr class="mud-table-row keep-together @(isLast ? "keep-with-next" : "")" style="border-bottom: 1px solid #eee;">
                                                    <td style="padding: 5px 8px; white-space: nowrap;">@item.Date.ToString("yyyy-MM-dd")</td>
                                                    <td style="padding: 5px 8px; font-weight: 600; white-space: nowrap;">@item.PoNumber</td>
                                                    @if (_opt.PurchasesGrouping != ProjectReportPurchasesGrouping.BySupplier)
                                                    {
                                                        <td style="padding: 5px 8px; color: #444;">@item.SupplierName</td>
                                                    }
                                                    <td style="padding: 5px 8px;">
                                                        @if (!string.IsNullOrWhiteSpace(item.PartNumber))
                                                        {
                                                            <span style="font-weight: 600; color: #444;">[@item.PartNumber] </span>
                                                        }
                                                        @item.Description
                                                    </td>
                                                    <td style="padding: 5px 8px; text-align: right; white-space: nowrap;">@item.Quantity.ToString("N2")</td>
                                                    @if (ShowFinancialAmounts)
                                                    {
                                                        <td style="padding: 5px 8px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(item.GrandTotal)</td>
                                                    }
                                                </tr>
                                            }
                                            @if (!string.IsNullOrWhiteSpace(grp.GroupTitle) && ShowFinancialAmounts)
                                            {
                                                <tr class="mud-table-row keep-together" style="background-color: #f8f9fa; font-weight: 700;">
                                                    <td colspan="@(_opt.PurchasesGrouping == ProjectReportPurchasesGrouping.BySupplier ? 4 : 5)" style="padding: 5px 8px;">
                                                        @Template.Label_Total — @grp.GroupTitle
                                                        @if (_opt.ShowPurchaseTaxBreakdown)
                                                        {
                                                            <span style="font-weight: 500; color: #666; font-size: 0.75rem;" class="ml-2">
                                                                (@ReportSubtotalLabel: @FormatMoney(grp.NetTotal) + @Template.Label_Tax: @FormatMoney(grp.TaxAmount))
                                                            </span>
                                                        }
                                                    </td>
                                                    <td style="padding: 5px 8px; text-align: right; white-space: nowrap;">@FormatMoney(grp.GrandTotal)</td>
                                                </tr>
                                            }
                                        </tbody>
                                    </table>
                                </div>
                            }
                        }
                    </div>
                }

                @* 7. SECTION 4: EMPLOYEE EXPENSES BREAKDOWN *@
                @if (_canViewAccounting && _opt.ShowExpensesSection && _expenseGroups.Any())
                {
                    <div class="allow-break mb-6">
                        <MudText Typo="Typo.h6" Class="mb-3 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @Template.Label_ExpensesBreakdown
                        </MudText>

                        @foreach (var grp in _expenseGroups)
                        {
                            <div class="mb-4 @(grp.Items.Count <= 12 ? "keep-together" : "allow-break")">
                                @if (!string.IsNullOrWhiteSpace(grp.GroupTitle))
                                {
                                    <div class="d-flex justify-space-between align-center px-3 py-1 rounded-t keep-together keep-with-next"
                                         style="@($"background-color: {Company.PrimaryColor}; color: white; font-size: 0.84rem;")">
                                        <div><b>@grp.GroupTitle</b> (@grp.ItemCount @BizLoc["items"])</div>
                                        @if (ShowFinancialAmounts)
                                        {
                                            <div><b>@FormatMoney(grp.Total)</b></div>
                                        }
                                    </div>
                                }
                                <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.8rem; border: 1px solid #e0e0e0;">
                                    <thead class="keep-together keep-with-next repeat-on-break">
                                        <tr style="background-color: #f1f3f5; color: #333;">
                                            <th style="padding: 5px 8px; text-align: left; width: 13%;">@Template.Label_Date</th>
                                            <th style="padding: 5px 8px; text-align: left; width: 14%;">@BizLoc["Report #"]</th>
                                            <th style="padding: 5px 8px; text-align: left; width: 18%;">@Template.Label_Employee</th>
                                            <th style="padding: 5px 8px; text-align: left;">@Template.Label_Description</th>
                                            @if (ShowFinancialAmounts)
                                            {
                                                <th style="padding: 5px 8px; text-align: right; width: 12%;">@ReportSubtotalLabel</th>
                                                <th style="padding: 5px 8px; text-align: right; width: 10%;">@Template.Label_Tax</th>
                                                <th style="padding: 5px 8px; text-align: right; width: 12%;">@Template.Label_Total</th>
                                            }
                                        </tr>
                                    </thead>
                                    <tbody class="allow-break">
                                        @foreach (var exp in grp.Items)
                                        {
                                            <tr class="mud-table-row keep-together" style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 5px 8px;">@exp.Date.ToString("yyyy-MM-dd")</td>
                                                <td style="padding: 5px 8px; font-weight: 600;">@exp.ReportNumber</td>
                                                <td style="padding: 5px 8px;">@exp.EmployeeName</td>
                                                <td style="padding: 5px 8px;">
                                                    @exp.Description
                                                    @if (exp.IsKilometrage)
                                                    {
                                                        <span style="color: #666;"> (@exp.Kilometers.ToString("N1") km)</span>
                                                    }
                                                </td>
                                                @if (ShowFinancialAmounts)
                                                {
                                                    <td style="padding: 5px 8px; text-align: right;">@FormatMoney(exp.SubTotal)</td>
                                                    <td style="padding: 5px 8px; text-align: right; color: #666;">@FormatMoney(exp.TaxAmount)</td>
                                                    <td style="padding: 5px 8px; text-align: right; font-weight: 600;">@FormatMoney(exp.Total)</td>
                                                }
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }

                @* 7b. SECTION 4B: OTHER DIRECT TRANSACTIONS *@
                @if (_canViewAccounting && _opt.ShowDirectTransactions && ShowFinancialAmounts && _snap.DirectTransactions.Any())
                {
                    <div class="allow-break mb-6">
                        <MudText Typo="Typo.h6" Class="mb-3 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @BizLoc["Other Project Transactions"]
                        </MudText>
                        <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #e0e0e0;">
                            <thead class="keep-together keep-with-next repeat-on-break">
                                <tr style="background-color: #f1f3f5; color: #333;">
                                    <th style="padding: 5px 8px; text-align: left;">@Template.Label_Date</th>
                                    <th style="padding: 5px 8px; text-align: left;">@BizLoc["Ref #"]</th>
                                    <th style="padding: 5px 8px; text-align: left;">@BizLoc["Type"]</th>
                                    <th style="padding: 5px 8px; text-align: left;">@BizLoc["Party / Description"]</th>
                                    <th style="padding: 5px 8px; text-align: left;">@BizLoc["Category"]</th>
                                    <th style="padding: 5px 8px; text-align: right;">@ReportSubtotalLabel</th>
                                    <th style="padding: 5px 8px; text-align: right;">@Template.Label_Tax</th>
                                    <th style="padding: 5px 8px; text-align: right;">@Template.Label_Total</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var dtx in _snap.DirectTransactions)
                                {
                                    var isIn = string.Equals(dtx.Direction, DirectTransactionDirection.MoneyIn, StringComparison.OrdinalIgnoreCase);
                                    <tr style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 5px 8px; white-space: nowrap;">@dtx.Date.ToString("yyyy-MM-dd")</td>
                                        <td style="padding: 5px 8px; white-space: nowrap;">@dtx.TransactionNumber</td>
                                        <td style="padding: 5px 8px; white-space: nowrap; font-weight: 600; color: @(isIn ? "#2e7d32" : "#c62828");">
                                            @(isIn ? BizLoc["Money In"] : BizLoc["Money Out"])
                                        </td>
                                        <td style="padding: 5px 8px;">
                                            @if (!string.IsNullOrWhiteSpace(dtx.PartyName))
                                            {
                                                <strong>@dtx.PartyName</strong>
                                                @if (!string.IsNullOrWhiteSpace(dtx.Description))
                                                {
                                                    <span> — @dtx.Description</span>
                                                }
                                            }
                                            else
                                            {
                                                @dtx.Description
                                            }
                                        </td>
                                        <td style="padding: 5px 8px; color: #555;">@dtx.CategoryLabel</td>
                                        <td style="padding: 5px 8px; text-align: right; white-space: nowrap;">@(isIn ? "+" : "-")@FormatMoney(dtx.SubTotal)</td>
                                        <td style="padding: 5px 8px; text-align: right; color: #666; white-space: nowrap;">@FormatMoney(dtx.TaxAmount)</td>
                                        <td style="padding: 5px 8px; text-align: right; font-weight: 600; white-space: nowrap; color: @(isIn ? "#2e7d32" : "#c62828");">@(isIn ? "+" : "-")@FormatMoney(dtx.GrandTotal)</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* 8. SECTION 5: BILLING, QUOTES & CLIENT POs HISTORY *@
                @if (_opt.ShowBillingHistory && ShowFinancialAmounts && (_snap.Quotes.Any() || _snap.Invoices.Any() || _snap.ClientPos.Any()))
                {
                    <div class="@(_opt.PageBreakBeforeBilling ? "force-break" : "") allow-break mb-6">
                        <MudText Typo="Typo.h6" Class="mb-3 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @Template.Label_BillingSummary
                        </MudText>

                        @if (_snap.Quotes.Any())
                        {
                            <div class="mb-4 @(_snap.Quotes.Count <= 12 ? "keep-together" : "allow-break")">
                                <MudText Typo="Typo.subtitle2" Class="mb-1 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700;")">
                                    @Template.Label_Quotes
                                </MudText>
                                <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #e0e0e0;">
                                    <thead class="keep-together keep-with-next repeat-on-break">
                                        <tr style="background-color: #f1f3f5; color: #333;">
                                            <th style="padding: 5px 8px; text-align: left;">@Template.Label_Quote #</th>
                                            <th style="padding: 5px 8px; text-align: left;">@Template.Label_Date</th>
                                            <th style="padding: 5px 8px; text-align: left;">@Template.Label_Description</th>
                                            <th style="padding: 5px 8px; text-align: left;">@Loc["Status"]</th>
                                            <th style="padding: 5px 8px; text-align: right;">@ReportSubtotalLabel</th>
                                            <th style="padding: 5px 8px; text-align: right;">@Template.Label_Tax</th>
                                            <th style="padding: 5px 8px; text-align: right;">@Template.Label_Total</th>
                                        </tr>
                                    </thead>
                                    <tbody class="allow-break">
                                        @foreach (var q in _snap.Quotes)
                                        {
                                            <tr class="mud-table-row keep-together" style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 5px 8px; font-weight: 600; white-space: nowrap;">@q.QuoteNumber</td>
                                                <td style="padding: 5px 8px; white-space: nowrap;">@q.Date.ToString("yyyy-MM-dd")</td>
                                                <td style="padding: 5px 8px;">@q.Title</td>
                                                <td style="padding: 5px 8px; font-weight: 600; white-space: nowrap;">@BizLoc[q.Status]</td>
                                                <td style="padding: 5px 8px; text-align: right; white-space: nowrap;">@FormatMoney(q.SubTotal)</td>
                                                <td style="padding: 5px 8px; text-align: right; color: #666; white-space: nowrap;">@FormatMoney(q.TaxAmount)</td>
                                                <td style="padding: 5px 8px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(q.GrandTotal)</td>
                                            </tr>
                                        }
                                    </tbody>
                                </table>
                            </div>
                        }

                        @if (_snap.Invoices.Any())
                        {
                            <div class="mb-4 @(_snap.Invoices.Count <= 12 ? "keep-together" : "allow-break")">
                                <MudText Typo="Typo.subtitle2" Class="mb-1 keep-together keep-with-next" Style="@($"color: {Company.SecondaryColor}; font-weight: 700;")">
                                    @Template.Label_Invoices
                                </MudText>
                                <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #e0e0e0;">
                                    <thead class="keep-together keep-with-next repeat-on-break">
                                        <tr style="background-color: #f1f3f5; color: #333;">
                                            <th style="padding: 5px 8px; text-align: left; white-space: nowrap;">@Template.Label_Invoice #</th>
                                            <th style="padding: 5px 8px; text-align: left; white-space: nowrap;">@Template.Label_Date</th>
                                            <th style="padding: 5px 8px; text-align: left; white-space: nowrap;">@Template.Label_DueDate</th>
                                            <th style="padding: 5px 8px; text-align: left; white-space: nowrap;">@Loc["Status"]</th>
                                            <th style="padding: 5px 8px; text-align: right; white-space: nowrap;">@Template.Label_Total</th>
                                            <th style="padding: 5px 8px; text-align: right; white-space: nowrap;">@Template.Label_Paid</th>
                                            <th style="padding: 5px 8px; text-align: right; white-space: nowrap;">@Template.Label_BalanceDue</th>
                                        </tr>
                                    </thead>
                                    <tbody class="allow-break">
                                        @for (int i = 0; i < _snap.Invoices.Count; i++)
                                        {
                                            var inv = _snap.Invoices[i];
                                            var isLast = i == _snap.Invoices.Count - 1;
                                            var isPaid = string.Equals(inv.Status, InvoiceStatus.Paid, StringComparison.OrdinalIgnoreCase);
                                            <tr class="mud-table-row keep-together @(isLast ? "keep-with-next" : "")" style="border-bottom: 1px solid #eee;">
                                                <td style="padding: 5px 8px; font-weight: 600; white-space: nowrap;">@inv.InvoiceNumber</td>
                                                <td style="padding: 5px 8px; white-space: nowrap;">@inv.Date.ToString("yyyy-MM-dd")</td>
                                                <td style="padding: 5px 8px; white-space: nowrap;">@inv.DueDate.ToString("yyyy-MM-dd")</td>
                                                <td style="padding: 5px 8px; font-weight: 600; white-space: nowrap; color: @(isPaid ? "#2e7d32" : "#333");">
                                                    @BizLoc[inv.Status]
                                                    @if (isPaid && inv.DatePaid.HasValue)
                                                    {
                                                        <span style="font-weight: 400; color: #666; font-size: 0.72rem;"> (@inv.DatePaid.Value.ToString("yyyy-MM-dd"))</span>
                                                    }
                                                </td>
                                                <td style="padding: 5px 8px; text-align: right; font-weight: 600; white-space: nowrap;">@FormatMoney(inv.GrandTotal)</td>
                                                <td style="padding: 5px 8px; text-align: right; color: #2e7d32; white-space: nowrap;">@FormatMoney(inv.AmountPaid)</td>
                                                <td style="padding: 5px 8px; text-align: right; font-weight: 600; white-space: nowrap; color: @(inv.BalanceDue > 0 ? "#c62828" : "#222");">
                                                    @FormatMoney(inv.BalanceDue)
                                                </td>
                                            </tr>
                                        }
                                        <tr class="mud-table-row keep-together" style="background-color: #f4f6f8; font-weight: 800;">
                                            <td colspan="4" style="padding: 6px 8px;">@Template.Label_Total</td>
                                            <td style="padding: 6px 8px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.TotalInvoiced)</td>
                                            <td style="padding: 6px 8px; text-align: right; color: #2e7d32; white-space: nowrap;">@FormatMoney(_snap.TotalPaid)</td>
                                            <td style="padding: 6px 8px; text-align: right; white-space: nowrap;">@FormatMoney(_snap.BalanceDue)</td>
                                        </tr>
                                    </tbody>
                                </table>
                            </div>
                        }
                    </div>
                }

                @* 9. SECTION 6: SALES COMMISSIONS *@
                @if (_opt.ShowCommissionsSection && ShowInternalCosts && _snap.Commissions.Any())
                {
                    <div class="@(_snap.Commissions.Count <= 12 ? "keep-together" : "allow-break") mb-6">
                        <MudText Typo="Typo.h6" Class="mb-3 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @Template.Label_CommissionsBreakdown
                        </MudText>
                        <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #e0e0e0;">
                            <thead class="keep-together keep-with-next repeat-on-break">
                                <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                    <th style="padding: 6px 8px; text-align: left;">@BizLoc["Beneficiary"]</th>
                                    <th style="padding: 6px 8px; text-align: left;">@BizLoc["Basis"]</th>
                                    <th style="padding: 6px 8px; text-align: right;">%</th>
                                    <th style="padding: 6px 8px; text-align: right;">@BizLoc["Base Amount"]</th>
                                    <th style="padding: 6px 8px; text-align: right;">@Template.Label_Total</th>
                                    <th style="padding: 6px 8px; text-align: left;">@Loc["Status"]</th>
                                </tr>
                            </thead>
                            <tbody class="allow-break">
                                @foreach (var comm in _snap.Commissions)
                                {
                                    <tr class="mud-table-row keep-together" style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 5px 8px; font-weight: 600;">@comm.BeneficiaryName</td>
                                        <td style="padding: 5px 8px;">@comm.Basis</td>
                                        <td style="padding: 5px 8px; text-align: right;">@comm.Percentage.ToString("N1")%</td>
                                        <td style="padding: 5px 8px; text-align: right;">@FormatMoney(comm.BaseAmount)</td>
                                        <td style="padding: 5px 8px; text-align: right; font-weight: 600;">@FormatMoney(comm.CommissionAmount)</td>
                                        <td style="padding: 5px 8px;">@comm.Status</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* 10. SECTION 7: PROJECT TIMELINE & MILESTONE NOTES *@
                @if (_opt.ShowTimelineNotes && _snap.TimelineNotes.Any())
                {
                    <div class="@(_snap.TimelineNotes.Count <= 12 ? "keep-together" : "allow-break") mb-6">
                        <MudText Typo="Typo.h6" Class="mb-3 keep-together keep-with-next" Style="@($"color: {Company.PrimaryColor}; border-bottom: 1px solid #ddd; padding-bottom: 4px; font-weight: 700;")">
                            @Template.Label_ProjectTimeline
                        </MudText>
                        <table class="mud-table-root allow-break" style="width: 100%; border-collapse: collapse; font-size: 0.82rem; border: 1px solid #e0e0e0;">
                            <thead class="keep-together keep-with-next repeat-on-break">
                                <tr style="@($"background-color: {Company.PrimaryColor}; color: white;")">
                                    <th style="padding: 6px 8px; text-align: left; width: 14%; white-space: nowrap;">@Template.Label_Date</th>
                                    <th style="padding: 6px 8px; text-align: left; width: 16%;">@BizLoc["Category"]</th>
                                    <th style="padding: 6px 8px; text-align: left;">@Template.Label_Description</th>
                                    <th style="padding: 6px 8px; text-align: left; width: 18%;">@BizLoc["Author"]</th>
                                </tr>
                            </thead>
                            <tbody class="allow-break">
                                @foreach (var note in _snap.TimelineNotes)
                                {
                                    <tr class="mud-table-row keep-together" style="border-bottom: 1px solid #eee;">
                                        <td style="padding: 5px 8px; white-space: nowrap;">@note.Date.ToString("yyyy-MM-dd")</td>
                                        <td style="padding: 5px 8px; font-weight: 600; color: #555;">@note.Category</td>
                                        <td style="padding: 5px 8px;">
                                            @if (!string.IsNullOrWhiteSpace(note.Title))
                                            {
                                                <div style="font-weight: 700;">@note.Title</div>
                                            }
                                            <div style="white-space: pre-line; color: #444;">@note.Content</div>
                                        </td>
                                        <td style="padding: 5px 8px; color: #555;">@note.CreatedBy</td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }

                @* 11. CLOSING NOTES & SIGNATURES *@
                @if (!string.IsNullOrWhiteSpace(_report.ClosingNotes))
                {
