    private async Task LoadDataAsync()
    {
        var routeChanged = !string.Equals(_authorizedProjectId, ProjectId, StringComparison.Ordinal) ||
                           !string.Equals(_authorizedReportId, ReportId, StringComparison.Ordinal);
        var hadPreviousReport = _authorizedReportId != null && _authorizedReportId != ReportId;

        if (routeChanged)
        {
            _report = null;
            _project = null;
            _viewerSnapshot = null;
            _currentViewer = null;
            _accessDenied = false;
            _canViewCostRates = false;
            _canViewAccounting = false;
            _canViewPurchases = false;
            _canViewLaborRates = false;
            _canViewAllLabor = false;
            _canAccessUnredactedReport = false;
            _canEditReport = false;
            _canUnlockOrDeleteFinal = false;
            _hasEmailInboxes = false;
            _authorizedProjectId = null;
            _authorizedReportId = null;
            _periodicLaborMatrices = [];
            _employeePeriodicGroups = [];
            _taskPeriodicGroups = [];
            _monthlyPurchaseGroups = [];
            _purchaseGroups = [];
