    private async Task<(Spokes_Server.Core.Models.HR.Employee Actor, Project Project, ProjectReport Report)?> AuthorizeEditAsync(bool requireFinalPrivilege = false)
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        var liveReport = string.IsNullOrEmpty(ReportId) ? null : Db.ProjectReports.GetById(ReportId);

        if (emp == null ||
            liveProject == null ||
            liveReport == null ||
            !string.Equals(liveReport.ProjectId, liveProject.Id, StringComparison.OrdinalIgnoreCase) ||
            !UserService.CanEditProject(emp, liveProject))
        {
            _canEditReport = false;
            _canUnlockOrDeleteFinal = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        var canUnlockOrDelete = emp.IsEffectiveAdmin || emp.HasPermission(AppPermissions.Projects.Delete);
        if (requireFinalPrivilege && !canUnlockOrDelete)
        {
            _canUnlockOrDeleteFinal = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        _currentUserName = emp.FullName ?? "Unknown";
        return (emp, liveProject, liveReport);
    }

    private async Task RefreshSnapshotNow()
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;
        var liveReport = auth.Value.Report;
        var liveProject = auth.Value.Project;
        if (!string.Equals(liveReport.Status, ProjectReportStatus.Draft, StringComparison.OrdinalIgnoreCase))
        {
            Snackbar.Add("Only draft reports can refresh live snapshot data.", Severity.Warning);
            return;
        }

        liveReport.Snapshot = ReportService.BuildSnapshot(liveProject, liveReport.PeriodStartDate, liveReport.AsOfDate);
        liveReport.UpdatedAt = DateTime.UtcNow;
        liveReport.History.Add(new DocumentHistoryEntry
        {
            Timestamp = DateTime.UtcNow,
            Action = DocumentHistoryActions.StatusChanged,
            OldStatus = liveReport.Status,
            NewStatus = liveReport.Status,
            ChangedBy = _currentUserName,
            Summary = $"Refreshed snapshot as of {liveReport.AsOfDate:yyyy-MM-dd}"
        });
        Db.ProjectReports.Save(liveReport);
        _report = liveReport;
        _project = liveProject;
        RebuildViewModels();
        Snackbar.Add(BizLoc["Report snapshot updated."], Severity.Success);
        await RefreshViewer();
    }

    private async Task Print()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task OnStatusChanged(string newStatus)
    {
        if (_report == null || _report.Status == newStatus) return;

        var preAuth = await AuthorizeEditAsync(requireFinalPrivilege: string.Equals(_report.Status, ProjectReportStatus.Final, StringComparison.OrdinalIgnoreCase));
        if (preAuth == null)
        {
            StateHasChanged();
            return;
        }

        var oldStatus = preAuth.Value.Report.Status;
        if (!ProjectReportStatus.GetAllowedTransitions().Contains(newStatus))
        {
            StateHasChanged();
            return;
        }

        var requiresReason = ProjectReportStatus.RequiresReason(oldStatus, newStatus);
        string? reason = null;
        if (requiresReason)
        {
            var reasonParams = new DialogParameters<ConfirmDialog>
            {
                { x => x.ContentText, string.Format(BizLoc["Please provide a reason for changing the report status from {0} to {1}."].Value, oldStatus, newStatus) },
                { x => x.ButtonText, BizLoc["Confirm Status Change"].Value },
                { x => x.Color, Color.Warning },
                { x => x.ShowReasonInput, true },
                { x => x.ReasonRequired, true },
                { x => x.ReasonLabel, BizLoc["Reason for status change"].Value },
                { x => x.ReasonPlaceholder, BizLoc["Explain why this report status is being reverted..."].Value }
            };
            var reasonDialog = await DialogService.ShowAsync<ConfirmDialog>(BizLoc["Confirm Status Change"].Value, reasonParams, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
            var reasonResult = await reasonDialog.Result;
            if (reasonResult == null || reasonResult.Canceled || string.IsNullOrWhiteSpace(reasonResult.Data as string))
            {
                StateHasChanged();
                return;
            }
            reason = (reasonResult.Data as string)?.Trim();
        }

        var saveAuth = await AuthorizeEditAsync(requireFinalPrivilege: string.Equals(oldStatus, ProjectReportStatus.Final, StringComparison.OrdinalIgnoreCase));
        if (saveAuth == null)
        {
            StateHasChanged();
            return;
        }

        var liveReport = saveAuth.Value.Report;
        if (liveReport.Status == newStatus) return;

        liveReport.Status = newStatus;
        liveReport.UpdatedAt = DateTime.UtcNow;
        liveReport.History.Add(new DocumentHistoryEntry
        {
            Timestamp = DateTime.UtcNow,
            Action = requiresReason ? DocumentHistoryActions.StatusReverted : DocumentHistoryActions.StatusChanged,
            OldStatus = oldStatus,
            NewStatus = newStatus,
            ChangedBy = _currentUserName,
            Summary = requiresReason
                ? $"Reverted status from {oldStatus} to {newStatus}"
                : $"Changed status from {oldStatus} to {newStatus}",
            Reason = reason
        });

        TimelineService.SyncProjectReportStatusTimelineEvent(liveReport, oldStatus, newStatus, _currentUserName);

        if (newStatus != ProjectReportStatus.Draft && oldStatus == ProjectReportStatus.Draft)
        {
            Db.ProjectReports.Save(liveReport);
            if (ReportService.CanViewerAccessUnredactedReport(liveReport, saveAuth.Value.Actor, PrivacyService, Db.Employees.GetAll()))
            {
                try
                {
                    Snackbar.Add(BizLoc["Generating official PDF..."], Severity.Info);
                    liveReport.PdfPath = await PdfService.GenerateProjectReportPdfAsync(liveReport, saveAuth.Value.Project.Id, Nav.BaseUri, saveAuth.Value.Actor.Id);
                }
                catch (Exception ex)
                {
                    Snackbar.Add(string.Format(BizLoc["Failed to generate PDF: {0}"].Value, ex.Message), Severity.Error);
                }
            }
        }
        else if (newStatus == ProjectReportStatus.Draft && !string.IsNullOrEmpty(liveReport.PdfPath))
        {
            if (System.IO.File.Exists(liveReport.PdfPath))
            {
                try { System.IO.File.Delete(liveReport.PdfPath); } catch { }
            }
            liveReport.PdfPath = string.Empty;
        }

        Db.ProjectReports.Save(liveReport);
        _report = liveReport;
        Snackbar.Add(string.Format(BizLoc["Report marked as {0}"].Value, BizLoc[newStatus].Value), Severity.Success);
        await RefreshViewer();
    }

