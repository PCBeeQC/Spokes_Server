            liveReport == null ||
            !string.Equals(liveReport.ProjectId, liveProject.Id, StringComparison.OrdinalIgnoreCase) ||
            !UserService.CanViewProject(emp, liveProject, allowAccountingFinancialRead: false))
        {
            Snackbar.Add("Access denied.", Severity.Error);
            return;
        }

        if (!ReportService.CanViewerAccessUnredactedReport(liveReport, emp, PrivacyService, Db.Employees.GetAll()))
        {
            byte[] ephemeralBytes;
            try
            {
                Snackbar.Add(BizLoc["Generating PDF..."], Severity.Info);
                ephemeralBytes = await PdfService.GenerateEphemeralProjectReportPdfBytesAsync(liveReport, emp.Id, Nav.BaseUri);
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(BizLoc["Error generating PDF: {0}"].Value, ex.Message), Severity.Error);
                return;
            }

            await JS.OpenPdfBytesInNewTabAsync(ephemeralBytes, $"{liveReport.ReportNumber}.pdf");
            return;
        }

        var pdfPath = liveReport.PdfPath;
        if (!PdfService.IsValidCachedPdf(pdfPath))
        {
            try
            {
                Snackbar.Add(BizLoc["Regenerating missing PDF..."], Severity.Info);
                pdfPath = await PdfService.GenerateProjectReportPdfAsync(liveReport, liveProject.Id, Nav.BaseUri, emp.Id);
                liveReport.PdfPath = pdfPath;
                if (UserService.CanEditProject(emp, liveProject))
                {
                    Db.ProjectReports.Save(liveReport);
                    _report = liveReport;
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(BizLoc["Error generating PDF: {0}"].Value, ex.Message), Severity.Error);
                return;
            }
        }

        await JS.OpenPdfFileInNewTabAsync(pdfPath, $"{liveReport.ReportNumber}.pdf");
    }

    private async Task SendEmail()
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;
        if (string.Equals(Db.CompanyProfile.Get()?.Edition, "Family", StringComparison.OrdinalIgnoreCase) ||
            !auth.Value.Actor.HasPermission(AppPermissions.Email.Use))
        {
            Snackbar.Add("Active Email.Use permission is required to send emails.", Severity.Error);
            return;
        }
        var liveReport = auth.Value.Report;
        var liveProject = auth.Value.Project;

        if (!ReportService.CanViewerAccessUnredactedReport(liveReport, auth.Value.Actor, PrivacyService, Db.Employees.GetAll()))
        {
            Snackbar.Add("You are not authorized to email an unredacted PDF of this project report.", Severity.Error);
            return;
        }

        if (!PdfService.IsValidCachedPdf(liveReport.PdfPath))
        {
            try
            {
                Snackbar.Add(BizLoc["Generating PDF for attachment..."], Severity.Info);
                liveReport.PdfPath = await PdfService.GenerateProjectReportPdfAsync(liveReport, liveProject.Id, Nav.BaseUri, auth.Value.Actor.Id);
                Db.ProjectReports.Save(liveReport);
                _report = liveReport;
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(BizLoc["Error generating PDF: {0}"].Value, ex.Message), Severity.Error);
                return;
            }
        }

        var toAddress = liveProject.Client?.ContactPersonEmail ?? "";
        var subject = $"{Template.Label_ProjectReport} #{liveReport.ReportNumber} - {liveProject.Name}";
        var body = $"<p>{BizLoc["Hello"]} {liveProject.Client?.ContactPersonName ?? BizLoc["Client"].Value},</p><p>{string.Format(BizLoc["Please find attached report #{0} ({1}) for {2} as of {3}."].Value, liveReport.ReportNumber, liveReport.Title, liveProject.Name, liveReport.AsOfDate.ToShortDateString())}</p><p>{BizLoc["Best regards,"]}<br/>{Company.CompanyName}</p>";

        var parameters = new DialogParameters
        {
            ["To"] = toAddress,
            ["Subject"] = subject,
            ["Body"] = body,
            ["IsTemplate"] = true,
            ["PreloadedDocumentAttachments"] = new List<OutboundDocumentAttachmentRef>
            {
                new(OutboundDocumentKind.ProjectReport, liveReport.Id, $"{liveReport.ReportNumber}.pdf")
            }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true, CloseOnEscapeKey = true };
        await DialogService.ShowAsync<EmailComposer>(BizLoc["Send Project Report by Email"], parameters, options);
    }

    private async Task EditReport(bool forceUnlock = false)
    {
        var auth = await AuthorizeEditAsync(requireFinalPrivilege: forceUnlock || string.Equals(_report?.Status, ProjectReportStatus.Final, StringComparison.OrdinalIgnoreCase));
        if (auth == null) return;
        var liveReport = auth.Value.Report;
        if (string.Equals(liveReport.Status, ProjectReportStatus.Final, StringComparison.OrdinalIgnoreCase) && !forceUnlock)
        {
            return;
        }

        var parameters = new DialogParameters<ProjectReportEditorDialog>
        {
            { x => x.ProjectId, auth.Value.Project.Id },
            { x => x.ExistingReport, liveReport },
            { x => x.ForceUnlockEdit, forceUnlock }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ProjectReportEditorDialog>(BizLoc["Edit Project Report"], parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            LoadData();
            var emp = await UserService.GetEmployeeAsync();
            if (_report != null && _report.Status != ProjectReportStatus.Draft && emp != null &&
                UserService.CanEditProject(emp, auth.Value.Project) &&
                ReportService.CanViewerAccessUnredactedReport(_report, emp, PrivacyService, Db.Employees.GetAll()))
            {
                try
                {
                    Snackbar.Add(BizLoc["Regenerating official PDF..."], Severity.Info);
                    _report.PdfPath = await PdfService.GenerateProjectReportPdfAsync(_report, auth.Value.Project.Id, Nav.BaseUri, emp.Id);
                    Db.ProjectReports.Save(_report);
                }
                catch (Exception ex)
                {
                    Snackbar.Add(string.Format(BizLoc["Failed to regenerate PDF: {0}"].Value, ex.Message), Severity.Warning);
                }
            }
            await RefreshViewer();
        }
    }

    private async Task DuplicateReport()
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;
        var liveReport = auth.Value.Report;
        var liveProject = auth.Value.Project;

        var copy = liveReport.DeepClone();
        if (copy != null)
        {
            var profile = Db.CompanyProfile.Get();
            copy.Id = Guid.NewGuid().ToString();
            copy.ProjectId = liveProject.Id;
            copy.ReportNumber = Db.ProjectReports.GenerateReportNumber(profile.ReportPrefix);
            copy.Title = $"{liveReport.Title} (Copy)";
            copy.Status = ProjectReportStatus.Draft;
            copy.PdfPath = string.Empty;
            copy.CreatedAt = DateTime.UtcNow;
            copy.UpdatedAt = DateTime.UtcNow;
            copy.CreatedBy = _currentUserName;
            copy.AsOfDate = DateTime.Today;
            copy.Snapshot = ReportService.BuildSnapshot(liveProject, copy.PeriodStartDate, copy.AsOfDate);
            copy.History =
            [
                new DocumentHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Action = DocumentHistoryActions.Created,
                    NewStatus = ProjectReportStatus.Draft,
                    ChangedBy = _currentUserName,
                    Summary = $"Created (Duplicated from #{liveReport.ReportNumber})"
                }
            ];

            Db.ProjectReports.Save(copy);
            Snackbar.Add(string.Format(BizLoc["Duplicated as {0} (Snapshot as of today)"].Value, copy.ReportNumber), Severity.Success);
            Nav.NavigateTo($"/projects/{liveProject.Id}/reports/{copy.Id}");
        }
    }

    private async Task DeleteReport()
    {
        if (_report == null) return;
        var preAuth = await AuthorizeEditAsync(requireFinalPrivilege: string.Equals(_report.Status, ProjectReportStatus.Final, StringComparison.OrdinalIgnoreCase));
        if (preAuth == null) return;

        var targetReport = preAuth.Value.Report;
        bool? confirm = await DialogService.ShowMessageBoxAsync(
            BizLoc["Delete Project Report"].Value,
            string.Format(BizLoc["Are you sure you want to delete report #{0} ({1})? This cannot be undone."].Value, targetReport.ReportNumber, targetReport.Title),
            yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value);

        if (confirm == true)
        {
            var deleteAuth = await AuthorizeEditAsync(requireFinalPrivilege: string.Equals(targetReport.Status, ProjectReportStatus.Final, StringComparison.OrdinalIgnoreCase));
            if (deleteAuth == null) return;
            var liveDeleteTarget = deleteAuth.Value.Report;
            if (string.Equals(liveDeleteTarget.Status, ProjectReportStatus.Final, StringComparison.OrdinalIgnoreCase) &&
                !deleteAuth.Value.Actor.IsEffectiveAdmin &&
                !deleteAuth.Value.Actor.HasPermission(AppPermissions.Projects.Delete))
            {
                Snackbar.Add("Access denied.", Severity.Error);
                return;
            }

            if (!string.IsNullOrEmpty(liveDeleteTarget.PdfPath) && System.IO.File.Exists(liveDeleteTarget.PdfPath))
            {
                try { System.IO.File.Delete(liveDeleteTarget.PdfPath); } catch { }
            }
            Db.ProjectReports.Delete(liveDeleteTarget.Id);
            Snackbar.Add(BizLoc["Project report deleted."], Severity.Success);
            await GoBack();
        }
    }
}
