        LoadData();
    }

    private void LoadData()
    {
        if (_accessDenied || string.IsNullOrEmpty(_authorizedProjectId) || string.IsNullOrEmpty(_authorizedReportId))
        {
            return;
        }

        var liveReport = Db.ProjectReports.GetById(ReportId);
        var liveProject = Db.Projects.GetById(ProjectId);
        Company = Db.CompanyProfile.Get();

        if (liveReport == null || liveProject == null || !string.Equals(liveReport.ProjectId, liveProject.Id, StringComparison.OrdinalIgnoreCase))
        {
            _report = null;
            _project = liveProject;
            _viewerSnapshot = null;
            _canAccessUnredactedReport = false;
            return;
        }

        _report = liveReport;
        _project = liveProject;

        // Keep Draft reports up to date with their configured PeriodStartDate..AsOfDate cutoff
        if (string.Equals(_report.Status, ProjectReportStatus.Draft, StringComparison.OrdinalIgnoreCase))
        {
            _report.Snapshot = ReportService.BuildSnapshot(_project, _report.PeriodStartDate, _report.AsOfDate);
        }
        else if (_report.Snapshot != null)
        {
            ReportService.EnsureQuoteCostEstimates(_report.Snapshot, ProjectId);
            ReportService.EnsureOverheadAllocation(_report.Snapshot, _project);
        }

        if (!string.IsNullOrEmpty(_report.TemplateId))
        {
            Template = Db.DocumentTemplates.GetById(_report.TemplateId) ?? Db.DocumentTemplates.GetDefault();
        }
        else
        {
            Template = Db.DocumentTemplates.GetDefault();
        }

        var allEmployees = Db.Employees.GetAll();
        var allTeams = Db.Teams.GetAll();
        _canAccessUnredactedReport = _currentViewer != null &&
            ReportService.CanViewerAccessUnredactedReport(_report, _currentViewer, PrivacyService, allEmployees);

        _viewerSnapshot = _report.Snapshot != null
            ? ReportService.ScopeSnapshotForViewer(
                _report.Snapshot,
                _currentViewer,
                PrivacyService,
                HRService,
                allEmployees,
                allTeams,
                canViewPurchases: _canViewPurchases,
                canViewExpenses: _canViewAccounting,
                canViewLaborFinancials: _canViewLaborRates,
                canViewInternalCosts: _canViewCostRates)
            : null;

        RebuildViewModels();
    }

    private void RebuildViewModels()
    {
        if (_viewerSnapshot == null)
        {
            _periodicLaborMatrices = [];
            _employeePeriodicGroups = [];
            _taskPeriodicGroups = [];
            _monthlyPurchaseGroups = [];
            _purchaseGroups = [];
            _expenseGroups = [];
            return;
        }
        var reportCulture = ProjectReportService.ResolveTemplateCulture(Template);
        _periodicLaborMatrices = ReportService.BuildPeriodicLaborMatrices(_snap, _opt.LaborPeriodGranularity, culture: reportCulture);
        _employeePeriodicGroups = ReportService.BuildEmployeePeriodicGroups(_snap, _opt.LaborPeriodGranularity, culture: reportCulture);
        _taskPeriodicGroups = ReportService.BuildTaskPeriodicGroups(_snap, _opt.LaborPeriodGranularity, culture: reportCulture);
        _monthlyPurchaseGroups = ReportService.BuildPurchaseGroups(_snap, ProjectReportPurchasesGrouping.ByMonthSummaryOnly, culture: reportCulture);
        _purchaseGroups = ReportService.BuildPurchaseGroups(_snap, _opt.PurchasesGrouping, culture: reportCulture);
        _expenseGroups = ReportService.BuildExpenseGroups(_snap, _opt.ExpensesGrouping, _opt.SubmittedOrPaidExpensesOnly, culture: reportCulture);
    }

