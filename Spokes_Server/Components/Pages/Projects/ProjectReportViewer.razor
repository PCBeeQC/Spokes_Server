    private string FormatMoney(decimal amount)
    {
        var symbol = Template?.CurrencySymbol ?? "$";
        return Template?.CurrencySymbolAfter == true
            ? $"{amount:N2}{symbol}"
            : $"{symbol}{amount:N2}";
    }

    private string FormatSignedMoney(decimal variance)
    {
        if (variance > 0m) return $"+{FormatMoney(variance)}";
        if (variance < 0m) return $"-{FormatMoney(Math.Abs(variance))}";
        return FormatMoney(0m);
    }

    private string FormatSignedHours(decimal variance)
    {
        if (variance > 0m) return $"+{variance:N1} h";
        if (variance < 0m) return $"-{Math.Abs(variance):N1} h";
        return "0.0 h";
    }

