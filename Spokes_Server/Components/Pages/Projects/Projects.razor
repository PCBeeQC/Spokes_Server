<MudTable Dense="true" Striped="true" Bordered="true" Items="@ExternalProjects" Hover="true" Outlined="true"
    Elevation="0" Breakpoint="Breakpoint.Sm" Class="mt-2" SortLabel="Sort By">
    <ToolBarContent>
        <MudText Typo="Typo.h5" Class="mr-4" Color="Color.Primary">Client Projects</MudText>
        @if (CanCreate)
        {
            <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" Color="Color.Primary" OnClick="OpenCreateDialog">
                Create Project
            </MudButton>
        }
        <MudSpacer />
    </ToolBarContent>
    <HeaderContent>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Project, object>(x=>x.DisplayName)">Name</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Project, object>(x=>x.Client?.BusinessName ?? string.Empty)">Client
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Project, object>(x=>GetGroupName(x.ProjectGroupId))">Group
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Project, object>(x=>x.CreatedAt)">Date Created</MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<Project, object>(x=>x.LastEdited)">Last Edited
            </MudTableSortLabel>
        </MudTh>
        <MudTh>
            <MudTableSortLabel SortBy="new Func<Project, object>(x=>x.Status)">Status</MudTableSortLabel>
        </MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.DisplayName</MudTd>
        <MudTd DataLabel="Client">@context.Client?.BusinessName</MudTd>
        <MudTd DataLabel="Group">
            @if (!string.IsNullOrEmpty(context.ProjectGroupId))
            {
                <MudLink Href="@($"/project-groups/{context.ProjectGroupId}")">
                    @GetGroupName(context.ProjectGroupId)
                </MudLink>
            }
            else
            {
                <span class="text-muted">None</span>
            }
        </MudTd>
        <MudTd DataLabel="Date Created">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>

        <MudTd DataLabel="Last Edited">
            @context.LastEdited.ToString("MMM dd, yyyy")
        </MudTd>

        <MudTd DataLabel="Status">
            <MudChip T="string" Size="Size.Small" Color="@GetStatusColor(context.Status)">@context.Status</MudChip>
        </MudTd>
        <MudTd>
            <MudTooltip Text="Open Dashboard">
                <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Color="Color.Primary"
                    Href="@($"/projects/{context.Id}")" />
            </MudTooltip>
        </MudTd>
    </RowTemplate>
</MudTable>



