@page "/projects"
<PageTitle>Projects</PageTitle>
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Constants
@using Microsoft.AspNetCore.Components.Authorization
@inject Database Db
@inject IDialogService DialogService
@using Spokes_Server.Core.Services
@inject ISnackbar Snackbar
@inject UserService UserService
@inject AuthenticationStateProvider AuthStateProvider

<MudText Class="mt-2" Typo="Typo.h4" GutterBottom="true">Projects</MudText>



<MudPaper Class="pa-4 mt-4 mb-4" Elevation="0" Outlined="true">
    <div class="d-flex justify-space-between align-center">
        <MudText Typo="Typo.h6" Color="Color.Default">Project Search</MudText>

        <MudChipSet T="string" @bind-SelectedValue="SelectedFilter" CheckMark="true"
                    SelectionMode="SelectionMode.SingleSelection">
            <MudChip T="string" Text="All" Value="@("All")" Default="true" Color="Color.Default">All</MudChip>
            @foreach (var status in Statuses)
            {
                // Parse color string to Enum
                Color chipColor = Color.Default;
                Enum.TryParse(status.Color, out chipColor);

                <MudChip T="string" Text="@status.Name" Value="@status.Name" Color="@chipColor">@status.Name</MudChip>
            }
        </MudChipSet>
    </div>

    @* <MudText Typo="Typo.h6" Color="Color.Default">Project Search</MudText> *@
    <MudTextField @bind-Value="globalSearchString" Margin="Margin.Dense" Variant="Variant.Outlined"
        Placeholder="Search All Projects and Groups..." Adornment="Adornment.Start"
        AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Immediate="true" Clearable="true">
    </MudTextField>

    @if (!string.IsNullOrWhiteSpace(globalSearchString))
    {
        <MudTable Dense="true" Striped="true" Bordered="true" Items="@GlobalSearchResults" Hover="true" Outlined="true"
                  Elevation="0" Breakpoint="Breakpoint.Sm" Class="mt-4" SortLabel="Sort By">
            <HeaderContent>
                <MudTh><MudTableSortLabel SortBy="new Func<GlobalSearchResult, object>(x => x.Type)">Type</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<GlobalSearchResult, object>(x => x.Name)">Name</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<GlobalSearchResult, object>(x => x.Description)">Client / Description</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<GlobalSearchResult, object>(x => x.CreatedAt)">Date Created</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel InitialDirection="SortDirection.Descending" SortBy="new Func<GlobalSearchResult, object>(x => x.LastEdited)">Last Edited</MudTableSortLabel></MudTh>
                <MudTh><MudTableSortLabel SortBy="new Func<GlobalSearchResult, object>(x => x.Status)">Status</MudTableSortLabel></MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd DataLabel="Type">
                    <MudChip T="string" Size="Size.Small" Color="@context.TypeColor">@context.Type</MudChip>
                </MudTd>
                <MudTd DataLabel="Name">
                    <MudLink Href="@context.Url" Typo="Typo.body2">@context.Name</MudLink>
                </MudTd>
                <MudTd DataLabel="Client / Description">@context.Description</MudTd>
                <MudTd DataLabel="Date Created">@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                <MudTd DataLabel="Last Edited">
                    @context.LastEdited.ToString("MMM dd, yyyy")
                </MudTd>
                <MudTd DataLabel="Status">
                    @if (!string.IsNullOrEmpty(context.Status))
                    {
                        <MudChip T="string" Size="Size.Small" Color="@context.StatusColor">@context.Status</MudChip>
                    }
                    else
                    {
                        <span>-</span>
                    }
                </MudTd>
                <MudTd DataLabel="Actions">
                    <MudTooltip Text="Open Dashboard">
                        <MudIconButton Icon="@Icons.Material.Filled.ArrowForward" Color="@context.TypeColor" Href="@context.Url" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

