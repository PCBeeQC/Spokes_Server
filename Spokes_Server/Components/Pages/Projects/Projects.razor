@inject NavigationManager Nav

@code {
    private List<Project> ExternalProjects = new();
    private List<Project> InternalProjects = new();
    private List<Project> ArchivedProjects = new();
    private List<ProjectGroup> ProjectGroups = new(); // Added Project Groups list

    private string globalSearchString = "";

    private string _selectedFilter = "All";
    private string SelectedFilter
    {
        get => _selectedFilter;
        set
        {
            if (_selectedFilter != value)
            {
                _selectedFilter = value;
                ApplyFilter();
            }
        }
    }

    // Permissions
    private bool CanCreate = false;
    private bool CanViewFinancials = false;

    private List<ProjectStatusConfig> Statuses = new();

    protected override async Task OnInitializedAsync()
    {
        await LoadPermissions();

        // Load Status Config
        var profile = Db.CompanyProfile.Get();
        Statuses = profile.ProjectStatuses;

        RefreshList();
    }

    private Color GetStatusColor(string statusName)
    {
        var match = Statuses.FirstOrDefault(s => s.Name.Equals(statusName, StringComparison.InvariantCultureIgnoreCase));
        if (match != null && Enum.TryParse<Color>(match.Color, out var c))
        {
            return c;
        }
        return Color.Default;
    }

    private async Task LoadPermissions()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp != null)
        {
            CanCreate = emp.HasPermission(AppPermissions.Projects.Create);
            CanViewFinancials = emp.HasPermission(AppPermissions.Projects.View);
        }
    }

    private void RefreshList()
    {
        var all = Db.Projects.GetAll().OrderByDescending(p => p.LastEdited).ToList();

        ExternalProjects = all.Where(p => !p.IsInternal && p.Status != ProjectStatus.Archived).ToList();
        InternalProjects = all.Where(p => p.IsInternal && p.Status != ProjectStatus.Archived).ToList();
        ArchivedProjects = all.Where(p => p.Status == ProjectStatus.Archived).ToList();

        // Load Project Groups
        ProjectGroups = Db.ProjectGroups.GetAll().OrderBy(g => g.Name).ToList();



        ApplyFilter();
    }

    private void ApplyFilter()
    {
        var all = Db.Projects.GetAll().OrderByDescending(p => p.LastEdited).ToList();
        var baseExternal = all.Where(p => !p.IsInternal && p.Status != ProjectStatus.Archived);

        if (!string.IsNullOrEmpty(SelectedFilter) && SelectedFilter != "All")
        {
            ExternalProjects = baseExternal.Where(p => p.Status == SelectedFilter).ToList();
        }
        else
        {
            ExternalProjects = baseExternal.ToList();
        }

        // Note: Project Groups are not currently filtered by status as they don't have a status property
    }

    private class GlobalSearchResult
    {
        public string Type { get; set; } = string.Empty;
        public string Name { get; set; } = string.Empty;
        public string Description { get; set; } = string.Empty;
        public DateTime CreatedAt { get; set; }
        public DateTime LastEdited { get; set; }
        public string Status { get; set; } = string.Empty;
        public Color StatusColor { get; set; }
        public Color TypeColor { get; set; }
        public string Url { get; set; } = string.Empty;
    }

    private IEnumerable<GlobalSearchResult> GlobalSearchResults
    {
        get
        {
            if (string.IsNullOrWhiteSpace(globalSearchString))
                return Array.Empty<GlobalSearchResult>();

            var results = new List<GlobalSearchResult>();
            string search = globalSearchString.Trim();

            // Client Projects
            var clientMatches = ExternalProjects.Where(p => MatchProject(p, search));
            foreach (var p in clientMatches)
            {
                results.Add(new GlobalSearchResult
                {
                    Type = "Client Project",
                    TypeColor = Color.Primary,
                    Name = p.DisplayName ?? string.Empty,
                    Description = p.Client?.BusinessName ?? string.Empty,
                    CreatedAt = p.CreatedAt,
                    LastEdited = p.LastEdited,
                    Status = p.Status ?? string.Empty,
                    StatusColor = GetStatusColor(p.Status ?? string.Empty),
                    Url = $"/projects/{p.Id}"
                });
            }

            // Project Groups
            var groupMatches = ProjectGroups.Where(g => MatchGroup(g, search));
            foreach (var g in groupMatches)
            {
                results.Add(new GlobalSearchResult
                {
                    Type = "Project Group",
                    TypeColor = Color.Tertiary,
                    Name = g.Name ?? string.Empty,
                    Description = g.Client?.BusinessName ?? string.Empty,
                    CreatedAt = g.CreatedAt,
                    LastEdited = g.CreatedAt, // Groups don't have LastEdited yet
                    Status = $"{g.ProjectIds.Count} projects",
                    StatusColor = Color.Tertiary,
                    Url = $"/project-groups/{g.Id}"
                });
            }

            // Internal Projects
            var internalMatches = InternalProjects.Where(p => MatchProject(p, search));
            foreach (var p in internalMatches)
            {
                results.Add(new GlobalSearchResult
                {
                    Type = "Internal Project",
                    TypeColor = Color.Secondary,
                    Name = p.DisplayName ?? string.Empty,
                    Description = p.Description ?? string.Empty,
                    CreatedAt = p.CreatedAt,
                    LastEdited = p.LastEdited,
                    Status = p.Status ?? string.Empty,
                    StatusColor = GetStatusColor(p.Status ?? string.Empty),
                    Url = $"/projects/{p.Id}"
                });
            }

            // Archived Projects
            var archivedMatches = ArchivedProjects.Where(p => MatchProject(p, search));
            foreach (var p in archivedMatches)
            {
                results.Add(new GlobalSearchResult
                {
                    Type = "Archived Project",
                    TypeColor = Color.Default,
                    Name = p.DisplayName ?? string.Empty,
                    Description = p.IsInternal ? (p.Description ?? string.Empty) : (p.Client?.BusinessName ?? string.Empty),
                    CreatedAt = p.CreatedAt,
                    LastEdited = p.LastEdited,
                    Status = p.Status ?? string.Empty,
                    StatusColor = GetStatusColor(p.Status ?? string.Empty),
                    Url = $"/projects/{p.Id}"
                });
            }

            return results.OrderByDescending(x => x.LastEdited);
        }
    }

    private bool MatchProject(Project element, string searchString)
    {
        if (element.DisplayName != null && element.DisplayName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.ProjectNumber != null && element.ProjectNumber.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Client?.BusinessName != null && element.Client.BusinessName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Status != null && element.Status.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Description != null && element.Description.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private bool MatchGroup(ProjectGroup element, string searchString)
    {
        if (element.Name != null && element.Name.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        if (element.Client?.BusinessName != null && element.Client.BusinessName.Contains(searchString, StringComparison.OrdinalIgnoreCase))
            return true;
        return false;
    }

    private string GetGroupName(string? groupId)
    {
        if (string.IsNullOrEmpty(groupId)) return "";
        return ProjectGroups.FirstOrDefault(g => g.Id == groupId)?.Name ?? "Unknown Group";
    }



    private async Task OpenCreateDialog()
    {
        if (!CanCreate) return;
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };

        var dialog = await DialogService.ShowAsync<ProjectDialog>("New Project", options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            var newProject = (Project)result.Data;
            Db.Projects.Save(newProject);

            // Auto-create chat channel removed as per requirements
            // Db.ChatChannels.GetOrCreateProjectChannel(newProject.Id, newProject.Name);

            Snackbar.Add("Project Created!", Severity.Success);
            RefreshList();
        }
    }

    private async Task CreateGroup()
    {
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProjectGroupDialog>("Create Project Group", options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is ProjectGroup newGroup)
        {
            Db.ProjectGroups.Save(newGroup);
            Snackbar.Add("Project Group Created!", Severity.Success);
            RefreshList();
            Nav.NavigateTo($"/project-groups/{newGroup.Id}");
        }
    }
}
