@page "/project-groups/{Id}"
@attribute [Authorize(Policy = AppPermissions.Projects.View)]
@implements IDisposable
<PageTitle>@Group?.Name - Project Group</PageTitle>
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services
@using Spokes_Server.Components.Pages.Projects.Tabs
@inject Database Db
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject NavigationManager Nav
@inject UserService UserService

@if (Group == null)
{
    <MudAlert Severity="Severity.Error">Project group not found.</MudAlert>
}
else
{
    <MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-6">
    <MudPaper Class="pa-6 mb-4" Elevation="2">
        <div class="d-flex justify-space-between align-center mb-2">
            <div>
                <MudText Typo="Typo.h4" Color="Color.Primary">@Group.Name</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">
                    Client: @Group.Client.BusinessName
                </MudText>
            </div>
            <div class="d-flex gap-2">
                <MudChip T="string" Color="Color.Info" Size="Size.Small">
                    @GroupedProjects.Count Projects
                </MudChip>
            </div>
        </div>
        @if (!string.IsNullOrEmpty(Group.Description))
        {
            <MudDivider Class="my-3" />
            <MudText Typo="Typo.body1" Style="white-space: pre-line; color: var(--mud-palette-text-secondary);">
                @Group.Description
            </MudText>
        }
    </MudPaper>

    <MudTabs ActivePanelIndex="activeTabIndex" ActivePanelIndexChanged="UpdateActiveTab" Elevation="0" Outlined="true" Border="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">

        <MudTabPanel Text="Projects" Icon="@Icons.Material.Filled.Work">
            <MudGrid>
                <MudItem xs="12">
                    <div class="d-flex justify-space-between align-center mb-4">
                        <MudText Typo="Typo.h6">Projects in this Group</MudText>
                        @if (CanEdit)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit" OnClick="EditGroup">
                                Edit Group
                            </MudButton>
                        }
                    </div>
                </MudItem>
            </MudGrid>

            @if (!GroupedProjects.Any())
            {
                <MudAlert Severity="Severity.Info">No projects in this group yet.</MudAlert>
            }
            else
            {
                <MudTable Elevation="0" Outlined="true" Items="@GroupedProjects" Hover="true" Dense="true">
                    <HeaderContent>
                        <MudTh>Project</MudTh>
                        <MudTh>Status</MudTh>
                        <MudTh>Created</MudTh>
                        <MudTh>Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudLink Href="@($"/projects/{context.Id}")">@context.DisplayName</MudLink>
                        </MudTd>
                        <MudTd>
                            <StatusChip Status="@context.Status" Color="@GetStatusColor(context.Status)" />
                        </MudTd>
                        <MudTd>@context.CreatedAt.ToString("MMM dd, yyyy")</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.OpenInNew" Size="Size.Small"
                                           Href="@($"/projects/{context.Id}")" />
                        </MudTd>
                    </RowTemplate>
                </MudTable>
            }
        </MudTabPanel>

        <MudTabPanel Text="Invoices" Icon="@Icons.Material.Filled.Receipt">
            <GroupInvoiceList ProjectGroupId="@Id" />
        </MudTabPanel>

        <MudTabPanel Text="Settings" Icon="@Icons.Material.Filled.Settings">
            <MudCard Elevation="0" Class="pa-4">
                <MudText Typo="Typo.h6" Class="mb-4">Group Administration</MudText>
                <div class="d-flex gap-4">
                    @if (CanEdit || CanDeleteGroup)
                    {
                        @if (CanEdit)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Edit" OnClick="EditGroup">
                                Edit Group Details
                            </MudButton>
                        }
                        @if (CanDeleteGroup)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error"
                                       StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteGroup">
                                Delete Group
                            </MudButton>
                        }
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Info">You do not have permission to edit this group.</MudAlert>
                    }
                </div>
            </MudCard>
        </MudTabPanel>

    </MudTabs>
    </MudContainer>
}

@code {
    [Parameter] public string Id { get; set; } = string.Empty;

    private ProjectGroup? Group;
    private string? _authorizedGroupId;
    private List<Project> GroupedProjects = [];
    private int activeTabIndex;
    private bool CanEdit;
    private bool CanDeleteGroup;
    private List<ProjectStatusConfig> AvailableStatuses = [];

    protected override async Task OnParametersSetAsync()
    {
        ApplyTabFromQuery();
        if (!string.Equals(_authorizedGroupId, Id, StringComparison.OrdinalIgnoreCase) || Group == null)
        {
            await LoadDataAsync();
            return;
        }

        await RefreshPermissionsAsync();
    }

    private async Task RefreshPermissionsAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp == null || Group == null)
        {
            CanEdit = false;
            CanDeleteGroup = false;
            return;
        }

        var allProjects = Group.ProjectIds
            .Select(id => Db.Projects.GetById(id))
            .Where(p => p != null)
            .Cast<Project>()
            .ToList();

        ApplyPermissions(emp, Group, allProjects);
    }

    private void ApplyPermissions(Employee? emp, ProjectGroup? group, List<Project> allProjects)
    {
        if (emp == null || group == null)
        {
            CanEdit = false;
            CanDeleteGroup = false;
            return;
        }

        bool canAccessAnyProject = emp.IsEffectiveAdmin || allProjects.Count == 0 ||
            allProjects.Any(p => UserService.CanViewProject(emp, p, allowAccountingFinancialRead: false));
        CanEdit = emp.HasPermission(AppPermissions.Projects.Edit) && canAccessAnyProject;

        bool canAccessAllProjects = emp.IsEffectiveAdmin ||
            (allProjects.Count == group.ProjectIds.Count &&
             allProjects.All(p => UserService.CanViewProject(emp, p, allowAccountingFinancialRead: false)));
        CanDeleteGroup = emp.IsEffectiveAdmin ||
            (emp.HasPermission(AppPermissions.Projects.Delete) && canAccessAllProjects);
    }

    private async Task LoadDataAsync()
    {
        _authorizedGroupId = null;
        Group = null;
        GroupedProjects = [];
        CanEdit = false;
        CanDeleteGroup = false;
        AvailableStatuses = [];

        var emp = await UserService.GetEmployeeAsync();
        var candidateGroup = Db.ProjectGroups.GetById(Id);
        if (candidateGroup == null) return;

        bool canAccountingRead = emp != null &&
            emp.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: true);

        if (emp == null || (!emp.HasEffectivePermission(AppPermissions.Projects.View, allowSuspended: true) && !canAccountingRead))
        {
            Nav.NavigateTo("/projects");
            return;
        }

        var allProjects = candidateGroup.ProjectIds
            .Select(id => Db.Projects.GetById(id))
            .Where(p => p != null)
            .Cast<Project>()
            .OrderBy(p => p.DisplayName)
            .ToList();

        var visibleProjects = allProjects
            .Where(p => UserService.CanViewProject(emp, p, allowAccountingFinancialRead: false))
            .ToList();

        // Deny non-admin / non-accounting users who cannot view any projects in this group
        if (!emp.IsEffectiveAdmin && !canAccountingRead && !visibleProjects.Any() && candidateGroup.ProjectIds.Any())
        {
            Nav.NavigateTo("/projects");
            return;
        }

        Group = candidateGroup;
        _authorizedGroupId = candidateGroup.Id;
        GroupedProjects = visibleProjects;
        ApplyPermissions(emp, candidateGroup, allProjects);

        var profile = Db.CompanyProfile.Get();
        AvailableStatuses = profile?.ProjectStatuses ?? [];
    }

    private Color GetStatusColor(string status) =>
        StatusColorHelper.GetProjectStatusColor(status, AvailableStatuses, fallbackToSemantic: true);

    private async Task EditGroup()
    {
        if (Group == null) return;

        var emp = await UserService.GetEmployeeAsync();
        var liveGroup = Db.ProjectGroups.GetById(Group.Id);
        if (emp == null || liveGroup == null || !emp.HasPermission(AppPermissions.Projects.Edit))
        {
            await LoadDataAsync();
            Snackbar.Add("You do not have permission to edit this project group.", Severity.Warning);
            return;
        }

        if (!emp.IsEffectiveAdmin && liveGroup.ProjectIds.Any() &&
            !liveGroup.ProjectIds.Any(pid => ProjectAccessHelper.HasAccess(Db.Projects, Db.Teams, emp, pid)))
        {
            await LoadDataAsync();
            Snackbar.Add("You do not have permission to edit this project group.", Severity.Warning);
            return;
        }

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters { ["ExistingGroup"] = liveGroup };
        var dialog = await DialogService.ShowAsync<ProjectGroupDialog>("Edit Project Group", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ProjectGroup updatedGroup })
        {
            var saveActor = await UserService.GetEmployeeAsync();
            var saveTarget = Db.ProjectGroups.GetById(liveGroup.Id);
            if (saveActor == null || saveTarget == null || !saveActor.HasPermission(AppPermissions.Projects.Edit))
            {
                await LoadDataAsync();
                Snackbar.Add("You do not have permission to edit this project group.", Severity.Warning);
                return;
            }

            // Preserve any restricted/inaccessible project IDs the caller could not view
            var preservedInaccessible = saveTarget.ProjectIds
                .Where(pid => !saveActor.IsEffectiveAdmin && !ProjectAccessHelper.HasAccess(Db.Projects, Db.Teams, saveActor, pid))
                .ToList();
            var authorizedSelected = updatedGroup.ProjectIds
                .Where(pid => saveActor.IsEffectiveAdmin || ProjectAccessHelper.HasAccess(Db.Projects, Db.Teams, saveActor, pid))
                .ToList();

            updatedGroup.Id = saveTarget.Id;
            updatedGroup.ProjectIds = authorizedSelected.Concat(preservedInaccessible).Distinct(StringComparer.OrdinalIgnoreCase).ToList();

            Db.ProjectGroups.Save(updatedGroup);
            Snackbar.Add("Project Group Updated!", Severity.Success);
            await LoadDataAsync();
        }
    }

    private async Task DeleteGroup()
    {
        if (Group == null) return;

        var emp = await UserService.GetEmployeeAsync();
        var liveGroup = Db.ProjectGroups.GetById(Group.Id);
        bool canDelete = emp != null && liveGroup != null && (
            await UserService.IsAdminAsync() ||
            (emp.HasPermission(AppPermissions.Projects.Delete) &&
             liveGroup.ProjectIds.All(pid => ProjectAccessHelper.HasAccess(Db.Projects, Db.Teams, emp, pid))));

        if (!canDelete)
        {
            await LoadDataAsync();
            Snackbar.Add("You do not have permission to delete this project group.", Severity.Warning);
            return;
        }

        var result = await DialogService.ShowMessageBoxAsync(
            "Delete Project Group",
            $"Are you sure you want to delete '{liveGroup!.Name}'? This will not delete the projects, but they will no longer be grouped.",
            yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            var confirmActor = await UserService.GetEmployeeAsync();
            var confirmGroup = Db.ProjectGroups.GetById(liveGroup.Id);
            bool stillAuthorized = confirmActor != null && confirmGroup != null && (
                await UserService.IsAdminAsync() ||
                (confirmActor.HasPermission(AppPermissions.Projects.Delete) &&
                 confirmGroup.ProjectIds.All(pid => ProjectAccessHelper.HasAccess(Db.Projects, Db.Teams, confirmActor, pid))));

            if (!stillAuthorized)
            {
                await LoadDataAsync();
                Snackbar.Add("You do not have permission to delete this project group.", Severity.Warning);
                return;
            }

            // Clear ProjectGroupId from all projects in this group
            foreach (var projectId in confirmGroup!.ProjectIds)
            {
                var project = Db.Projects.GetById(projectId);
                if (project != null)
                {
                    project.ProjectGroupId = null;
                    Db.Projects.Save(project);
                }
            }

            Db.ProjectGroups.Delete(confirmGroup.Id);
            Nav.NavigateTo("/project-groups");
            Snackbar.Add("Project Group Deleted", Severity.Success);
        }
    }
    [SupplyParameterFromQuery] public string? Tab { get; set; }

    private void ApplyTabFromQuery()
    {
        if (!string.IsNullOrEmpty(Tab))
        {
            activeTabIndex = Tab.ToLower() switch
            {
                "projects" => 0,
                "invoices" => 1,
                "settings" => 2,
                _ => 0
            };
        }
    }

    private bool _isDisposed;

    public void Dispose()
    {
        _isDisposed = true;
    }

    private void UpdateActiveTab(int index)
    {
        if (_isDisposed) return;

        activeTabIndex = index;

        if (!Nav.Uri.Contains("/project-groups/", StringComparison.OrdinalIgnoreCase))
            return;

        var tabName = index switch
        {
            0 => "projects",
            1 => "invoices",
            2 => "settings",
            _ => "projects"
        };
        
        try
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", tabName), replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
        }
    }
}

