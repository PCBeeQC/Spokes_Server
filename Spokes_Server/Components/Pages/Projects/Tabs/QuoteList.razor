@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Common
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Data
@using Spokes_Server.Components.Dialogs
@inject Database Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Projects
@inject UserService UserService

<MudGrid Class="mb-4 align-center">

    @* Quotes *@
    <MudItem xs="10">
        <MudText Typo="Typo.h5">Project Quotes</MudText>
    </MudItem>

    <MudItem xs="2" Class="justify-end">
        @if (CanEdit)
        {
            <MudButton FullWidth="true" Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="CreateQuote">New Quote</MudButton>
        }
    </MudItem>

    <MudItem xs="12">
        <MudTable Items="@Quotes" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true">
            <HeaderContent>
                <MudTh>Number</MudTh>
                <MudTh>Title</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.QuoteNumber</MudTd>
                <MudTd>@context.Title</MudTd>
                <MudTd>@context.Date.ToShortDateString()</MudTd>
                <MudTd Style="font-weight: bold;">@context.GrandTotal.ToString("C0")</MudTd>
                <MudTd>
                    <StatusChip Status="@context.Status" />
                </MudTd>
                <MudTd>
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenViewer(context))">View</MudButton>
                </MudTd>
            </RowTemplate>
        </MudTable>
    </MudItem>
    <MudItem Class="mt-4" xs="12">
        <MudDivider></MudDivider>
    </MudItem>

    @* Invoices *@
    <MudItem xs="12">
        @if (!string.IsNullOrEmpty(Project?.ProjectGroupId))
        {
            <MudAlert Severity="Severity.Info" Class="mb-4">
                <MudText>
                    This project is part of a <b>project group</b>. Invoicing is managed at the group level.
                </MudText>
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Class="mt-2"
                           Href="@($"/project-groups/{Project.ProjectGroupId}")">
                    Go to Project Group
                </MudButton>
            </MudAlert>

            @* Show existing invoices (read-only) including group invoices *@
            <MudText Typo="Typo.h5" Class="mt-4 mb-2">Invoice History</MudText>
            <MudTable Items="@Invoices" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>#</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Paid Date</MudTh>
                    <MudTh>Source</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Date.ToShortDateString()</MudTd>
                    <MudTd><b>@context.InvoiceNumber</b></MudTd>
                    <MudTd>@context.GrandTotal.ToString("C")</MudTd>
                    <MudTd>
                        <StatusChip Status="@context.Status" />
                    </MudTd>
                    <MudTd>@(context.DatePaid.HasValue? context.DatePaid.Value.ToShortDateString() : "-")</MudTd>
                    <MudTd>
                        @if (!string.IsNullOrEmpty(context.ProjectGroupId))
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Secondary">Group Invoice</MudChip>
                        }
                        else
                        {
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Individual</MudChip>
                        }
                    </MudTd>
                    <MudTd>
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenInvoice(context))">View</MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
        else
        {
            <MudGrid Class="mb-4 align-center">
                <MudItem xs="6">
                    <MudText Typo="Typo.h5">Invoices</MudText>
                </MudItem>
                <MudItem xs="6" Class="d-flex justify-end gap-2">
                    @if (_canCreateInvoice)
                    {
                        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateInvoice">Create Invoice</MudButton>
                    }
                </MudItem>

            </MudGrid>

            @if (Project != null && Project.BillingMethod == BillingMethods.TimeAndMaterials)
            {
                <MudAlert Severity="Severity.Info" Class="mb-4">
                    Unbilled Work Available: <b>@UnbilledLabor.ToString("C")</b> (Labor) + <b>@UnbilledExpenses.ToString("C")</b>
                    (Expenses)
                </MudAlert>
            }

            <MudTable Items="@Invoices" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>#</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh>Balance</MudTh>
                    <MudTh>Status</MudTh>
                    <MudTh>Paid Date</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>@context.Date.ToShortDateString()</MudTd>
                    <MudTd><b>@context.InvoiceNumber</b></MudTd>
                    <MudTd>@context.GrandTotal.ToString("C")</MudTd>
                    <MudTd>@context.BalanceDue.ToString("C")</MudTd>
                    <MudTd>
                        <StatusChip Status="@context.Status" />
                    </MudTd>
                    <MudTd>@(context.DatePaid.HasValue? context.DatePaid.Value.ToShortDateString() : "-")</MudTd>
                    <MudTd>
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                       OnClick="@(() => OpenInvoice(context))" />
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudItem>
</MudGrid>



@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;
    [Inject] NavigationManager Nav { get; set; } = default!;
    private List<Quote> Quotes = [];
    private bool CanEdit = false;
    private bool _canApproveQuote = false;
    private bool _canCreateInvoice = false;
    private bool _canApproveInvoice = false;
    private bool _hasAuthorizedAccess;
    private string? _authorizedProjectId;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_authorizedProjectId, ProjectId, StringComparison.Ordinal))
        {
            Project = null;
            Quotes = [];
            Invoices = [];
            UnbilledLabor = 0;
            UnbilledExpenses = 0;
            CanEdit = false;
            _canApproveQuote = false;
            _canCreateInvoice = false;
            _canApproveInvoice = false;
            _hasAuthorizedAccess = false;
            _authorizedProjectId = null;
        }

        await LoadPermissions();
        Refresh();
    }

    private async Task LoadPermissions()
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        if (emp == null || liveProject == null || !UserService.CanViewProject(emp, liveProject, allowAccountingFinancialRead: false))
        {
            Project = null;
            _hasAuthorizedAccess = false;
            _authorizedProjectId = null;
            CanEdit = false;
            _canApproveQuote = false;
            _canCreateInvoice = false;
            _canApproveInvoice = false;
            return;
        }

        Project = liveProject;
        _hasAuthorizedAccess = true;
        _authorizedProjectId = liveProject.Id;
        _canApproveQuote = emp.HasPermission(AppPermissions.Projects.ApproveQuotes);
        _canApproveInvoice = emp.HasPermission(AppPermissions.Finance.ApproveInvoices);
        _canCreateInvoice = emp.HasPermission(AppPermissions.Finance.AccessAccounting) || _canApproveInvoice;
        CanEdit = emp.HasPermission(AppPermissions.Projects.Edit) || _canApproveQuote;
    }

    private void Refresh()
    {
        if (!_hasAuthorizedAccess || string.IsNullOrEmpty(ProjectId))
        {
            Quotes = [];
            Invoices = [];
            UnbilledLabor = 0;
            UnbilledExpenses = 0;
            return;
        }

        Quotes = Db.Quotes.GetByProject(ProjectId);
        Invoices = Db.Invoices.GetByProject(ProjectId);
        if (Project != null && Project.BillingMethod == BillingMethods.TimeAndMaterials)
        {
            CalculateUnbilled();
        }
    }

    private async Task<(Spokes_Server.Core.Models.HR.Employee Actor, Project Project)?> AuthorizeQuoteEditAsync(bool requireApprovePermission = false)
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        if (emp == null || liveProject == null || !UserService.CanViewProject(emp, liveProject, allowAccountingFinancialRead: false))
        {
            CanEdit = false;
            _canApproveQuote = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        var canApprove = emp.HasPermission(AppPermissions.Projects.ApproveQuotes);
        var canEdit = emp.HasPermission(AppPermissions.Projects.Edit) || canApprove;
        if (requireApprovePermission ? !canApprove : !canEdit)
        {
            CanEdit = canEdit;
            _canApproveQuote = canApprove;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        return (emp, liveProject);
    }

    private async Task<(Spokes_Server.Core.Models.HR.Employee Actor, Project Project)?> AuthorizeInvoiceCreateAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        if (emp == null || liveProject == null || !UserService.CanViewProject(emp, liveProject, allowAccountingFinancialRead: false))
        {
            _canCreateInvoice = false;
            _canApproveInvoice = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        var canApprove = emp.HasPermission(AppPermissions.Finance.ApproveInvoices);
        var canCreate = emp.HasPermission(AppPermissions.Finance.AccessAccounting) || canApprove;
        if (!canCreate)
        {
            _canCreateInvoice = false;
            _canApproveInvoice = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }

        return (emp, liveProject);
    }

    private async Task CreateQuote()
    {
        var auth = await AuthorizeQuoteEditAsync();
        if (auth == null) return;

        var profile = Db.CompanyProfile.Get();
        var nextNum = Db.Quotes.GenerateQuoteNumber(profile.QuotePrefix);
        var newQuote = new Quote
        {
            ProjectId = auth.Value.Project.Id,
            QuoteNumber = nextNum,
            Date = DateTime.Today,
            History =
            [
                new DocumentHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Action = DocumentHistoryActions.Created,
                    NewStatus = QuoteStatus.Draft,
                    ChangedBy = auth.Value.Actor.FullName ?? auth.Value.Actor.Email ?? "System",
                    Summary = "Created draft quote"
                }
            ]
        };

        // Pull template defaults ONLY on creation
        var project = auth.Value.Project;
        if (project != null)
        {
            var template = (!string.IsNullOrEmpty(project.DefaultTemplateId))
            ? Db.DocumentTemplates.GetById(project.DefaultTemplateId)
            : Db.DocumentTemplates.GetDefault();

            if (template != null)
            {
                if (!string.IsNullOrEmpty(template.DefaultTermsAndConditionsId))
                {
                    var terms = Db.TermsAndConditions.GetById(template.DefaultTermsAndConditionsId);
                    newQuote.TermsAndConditions = terms?.Content ?? template.DefaultTermsAndConditions;
                }
                else
                {
                    newQuote.TermsAndConditions = template.DefaultTermsAndConditions;
                }
                newQuote.TaxRate = template.TaxRate;
                newQuote.TermsStartOnNewPage = template.TermsStartOnNewPage;
            }
        }

        await OpenEditor(newQuote);
    }

    private async Task OpenEditor(Quote quote)
    {
        var auth = await AuthorizeQuoteEditAsync();
        if (auth == null) return;

        var actorCanApprove = auth.Value.Actor.HasPermission(AppPermissions.Projects.ApproveQuotes);
        var actorName = auth.Value.Actor.FullName ?? auth.Value.Actor.Email ?? "System";
        var parameters = new DialogParameters<QuoteEditorDialog>
        {
            { x => x.Quote, quote },
            { x => x.ProjectId, auth.Value.Project.Id },
            { x => x.CanEditDraft, true },
            { x => x.CanApproveQuote, actorCanApprove },
            { x => x.CurrentUserName, actorName }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true };
        var dialog = await DialogService.ShowAsync<QuoteEditorDialog>("Edit Quote", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is Quote q)
        {
            var saveAuth = await AuthorizeQuoteEditAsync();
            if (saveAuth == null) return;

            q.ProjectId = saveAuth.Value.Project.Id;
            var existing = Db.Quotes.GetById(q.Id);
            if (existing != null && existing.ProjectId != saveAuth.Value.Project.Id)
            {
                Snackbar.Add("Access denied.", Severity.Error);
                return;
            }
            if (existing != null && existing.Status != QuoteStatus.Draft && !saveAuth.Value.Actor.HasPermission(AppPermissions.Projects.ApproveQuotes))
            {
                Snackbar.Add("Only quote approvers can modify non-draft quotes.", Severity.Error);
                return;
            }

            Db.Quotes.Save(q);
            Refresh();
        }
    }

    private void OpenViewer(Quote quote) =>
        Nav.NavigateTo($"/projects/{ProjectId}/quotes/{quote.Id}");

    private Project? Project;
    private List<Invoice> Invoices = [];

    // Unbilled Tracking
    private decimal UnbilledLabor = 0;
    private decimal UnbilledExpenses = 0;

    private void CalculateUnbilled()
    {
        // 1. Get IDs of everything already billed on posted invoices (Draft and Void invoices do not count)
        var postedInvoices = Invoices.Where(i => InvoiceStatus.IsPosted(i.Status)).ToList();
        var billedTimeIds = postedInvoices.SelectMany(i => i.BilledTimeEntryIds).ToHashSet();
        var billedPoItemIds = postedInvoices.SelectMany(i => i.BilledPoItemIds).ToHashSet();
        var billedExpenseItemIds = postedInvoices.SelectMany(i => i.BilledExpenseItemIds).ToHashSet();

        // 2. Scan Time
        var allTime = Db.Timesheets.GetAll().SelectMany(t => t.Entries).Where(e => e.ProjectId == ProjectId);
        var unbilledTime = allTime.Where(e => !billedTimeIds.Contains(e.Id));

        // Calculate Value (Need Rates)
        UnbilledLabor = 0;
        foreach (var t in unbilledTime)
        {
            var task = Db.WorkTypes.GetById(t.WorkTypeId);
            // We use the Billing Rate here (Revenue), not the Cost Rate
            var rate = Project?.GetEffectiveRate(t.WorkTypeId, task?.DefaultRate ?? 0) ?? (task?.DefaultRate ?? 0);
            UnbilledLabor += t.Hours * rate;
        }

        // 3. Scan POs
        var allPos = Db.PurchaseOrders.GetAll();
        var poItems = allPos.SelectMany(p => p.LineItems.Where(i => i.ProjectId == ProjectId));
        var unbilledPoItems = poItems.Where(i => !billedPoItemIds.Contains(i.Id));

        // 4. Scan Expense Reports
        var allReports = Db.ExpenseReports.GetAll();
        var expenseItems = allReports
        .Where(r => r.DateSubmitted.HasValue && r.Status != ExpenseReportStatus.Draft)
        .SelectMany(r => r.LineItems.Where(i => i.ProjectId == ProjectId));
        var unbilledExpenseItems = expenseItems.Where(i => !billedExpenseItemIds.Contains(i.Id));

        // For Cost+, we usually markup expenses. Let's assume 15% markup for estimation
        decimal markupRate = 0.15m;
        if (Project != null && !string.IsNullOrEmpty(Project.RateCardId))
        {
            var card = Db.RateCards.GetById(Project.RateCardId);
            if (card != null) markupRate = card.MarkupRate;
        }

        decimal costTotal = unbilledPoItems.Sum(i => i.Total) + unbilledExpenseItems.Sum(i => i.Total);
        UnbilledExpenses = costTotal * (1 + markupRate);
    }

    private async Task CreateInvoice()
    {
        var auth = await AuthorizeInvoiceCreateAsync();
        if (auth == null) return;

        var liveProject = auth.Value.Project;
        var actorName = auth.Value.Actor.FullName ?? auth.Value.Actor.Email ?? "System";
        var profile = Db.CompanyProfile.Get();
        var template = (!string.IsNullOrEmpty(liveProject.DefaultTemplateId))
            ? Db.DocumentTemplates.GetById(liveProject.DefaultTemplateId)
            : Db.DocumentTemplates.GetDefault();
        if (template == null) template = Db.DocumentTemplates.GetDefault();

        var invoice = new Invoice
        {
            ProjectId = liveProject.Id,
            InvoiceNumber = Db.Invoices.GenerateInvoiceNumber(profile.InvoicePrefix),
            Date = DateTime.Today,
            Status = InvoiceStatus.Draft,
            TaxRate = template.TaxRate,
            History =
            [
                new DocumentHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Action = DocumentHistoryActions.Created,
                    NewStatus = InvoiceStatus.Draft,
                    ChangedBy = actorName,
                    Summary = "Created draft invoice"
                }
            ]
        };

        var parameters = new DialogParameters<InvoiceMasterDialog>
        {
            { x => x.Invoice, invoice },
            { x => x.CanEditDraft, true },
            { x => x.CanApproveInvoice, auth.Value.Actor.HasPermission(AppPermissions.Finance.ApproveInvoices) }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true };

        var dialog = await DialogService.ShowAsync<InvoiceMasterDialog>("Create Invoice", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Refresh();
            Snackbar.Add("Invoice Created", Severity.Success);
        }
    }


    private void OpenInvoice(Invoice inv) =>
        Nav.NavigateTo($"/projects/{ProjectId}/invoices/{inv.Id}");
}
