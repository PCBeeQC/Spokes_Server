@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Constants
@using Spokes_Server.Components.Shared
@inject Database Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@using Microsoft.AspNetCore.Components.Authorization
@inject UserService UserService
@inject Spokes_Server.Core.Services.Accounting.FinancialCalculationEngine CalcEngine

<MudGrid Class="mb-4 align-center">
    <MudItem xs="6">
        <MudText Typo="Typo.h5">Project Documents</MudText>
    </MudItem>
    <MudItem xs="6" Class="d-flex justify-end gap-2">
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.NoteAdd"
                OnClick="CreateBlankDocument">Blank Document</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenGenerateDialog">From Template</MudButton>
        }
    </MudItem>

    @* Project Documents *@
    <MudItem xs="12" Class="mt-n2">
        <MudTable Items="@_documents" Hover="true" Dense="true" Striped="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="width: 120px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="doc">
                <MudTd DataLabel="Name">@doc.Name</MudTd>
                <MudTd DataLabel="Created">@doc.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(doc.Status == "Final" ? Color.Success : Color.Info)">
                        @doc.Status
                    </MudChip>
                </MudTd>
                <MudTd>
                    <div class="d-flex gap-1">
                        @* <MudTooltip Text="View / Print">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                                           OnClick="@(() => OpenViewer(doc))" />
                        </MudTooltip> *@
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenViewer(doc))">View</MudButton>
                        @if (CanEdit && doc.Status != "Final")
                        {
                            <MudTooltip Text="Rename">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => RenameDocument(doc))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => OnDelete(doc))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">No documents generated for this project yet.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudItem>

    <MudItem Class="mt-2" xs="12">
        <MudDivider></MudDivider>
    </MudItem>

    <MudItem xs="12">
        <MudText Typo="Typo.h5">Project Procurement</MudText>
    </MudItem>

    <MudItem xs="12" Class="mt-n4 d-flex justify-space-between align-center">
        <MudText Typo="Typo.body2">Purchase Orders sent by @(Profile?.CompanyName ?? "the company") for this project.</MudText>
    </MudItem>

    <MudItem xs="12" Class="mt-n4">
        @if (!PurchaseRows.Any())
        {
            <MudAlert Severity="Severity.Info" Dense="true">No purchase orders found for this project.</MudAlert>
        }
        else
        {
            <MudTable Items="@PurchaseRows" Hover="true" Dense="true" Outlined="true" Elevation="0">
                <HeaderContent>
                    <MudTh>Date</MudTh>
                    <MudTh>PO #</MudTh>
                    <MudTh>Description</MudTh>
                    <MudTh>Net Cost</MudTh>
                    <MudTh>Tax</MudTh>
                    <MudTh>Total</MudTh>
                    <MudTh Style="width: 80px;">Actions</MudTh>
                </HeaderContent>
                <RowTemplate Context="poRow">
                    <MudTd>@poRow.Date.ToShortDateString()</MudTd>
                    <MudTd><b>@poRow.PoNumber</b></MudTd>
                    <MudTd>
                        @poRow.Description
                        @if (!string.IsNullOrEmpty(poRow.PartNumber))
                        {
                            <MudText Typo="Typo.caption" Class="ml-2" Color="Color.Secondary">Ref: @poRow.PartNumber</MudText>
                        }
                    </MudTd>
                    <MudTd>@poRow.NetTotal.ToString("C")</MudTd>
                    <MudTd>@poRow.TaxAmount.ToString("C")</MudTd>
                    <MudTd><b>@poRow.GrandTotal.ToString("C")</b></MudTd>
                    <MudTd>
                        <MudTooltip Text="View PO">
                            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                                           OnClick="@(() => Nav.NavigateTo($"/purchases/{poRow.Id}"))" />
                        </MudTooltip>
                    </MudTd>
                </RowTemplate>
                <FooterContent>
                    <MudTd colspan="5"><b>Total Procurement Cost</b></MudTd>
                    <MudTd><b>@TotalPurchaseCost.ToString("C")</b></MudTd>
                    <MudTd></MudTd>
                </FooterContent>
            </MudTable>
        }
    </MudItem>

    <MudItem Class="mt-2" xs="12">
        <MudDivider></MudDivider>
    </MudItem>

    <MudItem xs="12">
        <MudText Typo="Typo.h5">PO Received for this project</MudText>
    </MudItem>

    <MudItem xs="12" Class="mt-n8 d-flex justify-space-between align-center">
        <MudText Typo="Typo.body2">Attach client Purchase Orders (POs) to this project.</MudText>
        @if (CanEdit)
        {
            <MudSwitch T="bool" @bind-Value="IsEditing" Label="Edit Mode" Color="Color.Primary" />
        }
    </MudItem>

    <MudItem xs="12" Class="mt-n4">
        <MudTable Items="@Project.PurchaseOrders" Hover="true" Dense="true" Striped="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>PO Number</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>File</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudTextField @bind-Value="context.PoNumber" Label="PO #" Margin="Margin.Dense" OnBlur="AutoSave"
                                  Disabled="@(!IsEditing)" Variant="@(IsEditing? Variant.Text: Variant.Text)"
                                  DisableUnderLine="@(!IsEditing)" />
                </MudTd>
                <MudTd>
                    <MudDatePicker Date="context.DateReceived"
                                   DateChanged="@((DateTime? d) => { context.DateReceived = d; AutoSave(); })" Label="Date"
                                   Margin="Margin.Dense" Editable="true" Disabled="@(!IsEditing)" DisableToolbar="@(!IsEditing)" />
                </MudTd>
                <MudTd>
                    <MudNumericField Value="context.Amount"
                                     ValueChanged="@((decimal v) => { context.Amount = v; AutoSave(); })" Label="Amount" Format="N2"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                     Margin="Margin.Dense" Disabled="@(!IsEditing)" DisableUnderLine="@(!IsEditing)"
                                     HideSpinButtons="@(!IsEditing)" />
                </MudTd>
                <MudTd>
                    @if (!string.IsNullOrEmpty(context.FilePath))
                    {
                        <div class="d-flex align-center gap-2">
                            <MudLink Href="@context.FilePath" Target="_blank" Typo="Typo.body2">View</MudLink>
                            @if (IsEditing)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               Title="Remove File" OnClick="@(() => RemoveFile(context))" />
                            }
                        </div>
                    }
                    else if (IsEditing)
                    {
                        <ApiFileUpload Category="projects" ContextId="@Project.Id" MaximumFileCount="1"
                                       OnUploadCompleted="@((results) => HandlePoApiUpload(results, context))"
                                       OnUploadError='(e) => Snackbar.Add($"Upload failed: {e}", Severity.Error)'>
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">Upload</MudButton>
                            </CustomContent>
                        </ApiFileUpload>
                    }
                </MudTd>
                <MudTd>
                    @if (IsEditing)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => RemovePO(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd colspan="5">
                    @if (IsEditing)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddPurchaseOrder" Color="Color.Primary">
                            Add PO
                        </MudButton>
                    }
                </MudTd>
            </FooterContent>
        </MudTable>
    </MudItem>

    
</MudGrid>



@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    private List<ProjectDocument> _documents = new();
    private bool CanEdit = false;
    private CompanyProfile Profile;

    protected override async Task OnInitializedAsync()
    {
        Profile = Db.CompanyProfile.Get();
        await LoadPermissions();
        Reload();
    }

    private async Task LoadPermissions()
    {
        var emp = await UserService.GetEmployeeAsync();
        if (emp != null) CanEdit = emp.HasPermission(AppPermissions.Projects.Edit);
    }

    private void Reload()
    {
        _documents = Db.ProjectDocuments.GetByProject(ProjectId);
        LoadPurchases();
    }

    class PurchaseRow
    {
        public string Id { get; set; }
        public DateTime Date { get; set; }
        public string PoNumber { get; set; }
        public string Description { get; set; }
        public string PartNumber { get; set; }

        public decimal NetTotal { get; set; }
        public decimal TaxAmount { get; set; }
        public decimal GrandTotal => NetTotal + TaxAmount;
    }

    private List<PurchaseRow> PurchaseRows = new();
    private decimal TotalPurchaseCost => PurchaseRows.Sum(p => p.GrandTotal);

    private void LoadPurchases()
    {
        var allPos = Db.Purchases.GetAll().Where(p => p.Status != "Void");
        PurchaseRows.Clear();

        foreach (var po in allPos)
        {
            var myItems = po.Items.Where(i => i.ProjectId == ProjectId);

            foreach (var item in myItems)
            {
                decimal taxForThisItem = 0;
                if (po.ApplyTax)
                {
                    taxForThisItem = item.Total * po.TaxRate;
                }

                PurchaseRows.Add(new PurchaseRow
                    {
                        Id = po.Id,
                        Date = po.Date,
                        PoNumber = po.PoNumber,
                        Description = item.Description,
                        PartNumber = item.PartNumber,
                        NetTotal = item.Total,
                        TaxAmount = taxForThisItem
                    });
            }
        }

        PurchaseRows = PurchaseRows.OrderByDescending(x => x.Date).ToList();
    }

    private async Task OpenGenerateDialog()
    {
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<GenerateDocumentDialog>("Generate New Document", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is StandardDocument template)
        {
            var name = await PromptForName(template.Name);
            if (name != null)
                GenerateFromTemplate(template, name);
        }
    }

    private void GenerateFromTemplate(StandardDocument template, string name)
    {
        var doc = new ProjectDocument
            {
                ProjectId = ProjectId,
                StandardDocumentId = template.Id,
                Name = name,
                Status = "Draft",
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

        Db.ProjectDocuments.Save(doc);
        Snackbar.Add($"Document '{doc.Name}' generated as Draft", Severity.Success);
        Reload();

        // Auto-navigate to viewer for the new draft
        OpenViewer(doc);
    }

    private async Task CreateBlankDocument()
    {
        var name = await PromptForName("Untitled Document");
        if (name == null) return;

        var doc = new ProjectDocument
            {
                ProjectId = ProjectId,
                StandardDocumentId = string.Empty,
                Name = name,
                ResolvedBody = "",
                Status = "Draft",
                IsManualEdit = true,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

        Db.ProjectDocuments.Save(doc);
        Snackbar.Add("Blank document created", Severity.Success);
        Reload();
        OpenViewer(doc);
    }

    private async Task<string?> PromptForName(string defaultName)
    {
        var parameters = new DialogParameters
            {
                ["CurrentName"] = defaultName,
                ["Label"] = "Document Name",
                ["SubmitLabel"] = "Create"
            };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RenameDialog>("Name Your Document", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string name && !string.IsNullOrWhiteSpace(name))
            return name;

        return null;
    }

    private async Task RenameDocument(ProjectDocument doc)
    {
        var parameters = new DialogParameters
            {
                ["ContentText"] = "Enter a new name for this document:",
                ["CurrentName"] = doc.Name
            };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RenameDialog>("Rename Document", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string newName && !string.IsNullOrWhiteSpace(newName))
        {
            doc.Name = newName;
            doc.UpdatedAt = DateTime.UtcNow;
            Db.ProjectDocuments.Save(doc);
            Snackbar.Add($"Document renamed to '{newName}'", Severity.Success);
            Reload();
        }
    }

    private void OpenViewer(ProjectDocument doc)
    {
        Nav.NavigateTo($"/projects/{ProjectId}/documents/{doc.Id}");
    }

    private async Task OnDelete(ProjectDocument doc)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Delete Document",
        $"Are you sure you want to delete '{doc.Name}'?",
        "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            Db.ProjectDocuments.Delete(doc.Id);
            Snackbar.Add("Document deleted", Severity.Info);
            Reload();
        }
    }

    [Parameter] public Project Project { get; set; } = new();
    private bool IsEditing = false;


    private void AddPurchaseOrder()
    {
        Project.PurchaseOrders.Add(new ClientPO());
        AutoSave();
    }

    private async Task RemovePO(ClientPO po)
    {
        bool? result = await DialogService.ShowMessageBoxAsync(
        "Delete Purchase Order",
        "Are you sure you want to delete this Purchase Order? This cannot be undone.",
        yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            Project.PurchaseOrders.Remove(po);
            AutoSave(); // Also save the changes
            StateHasChanged();
        }
    }

    private void RemoveFile(ClientPO po)
    {
        po.FilePath = "";
        po.MimeType = "";
        AutoSave();
    }

    private void AutoSave()
    {
        Db.Projects.Save(Project);
    }

    [Inject] private IFileService FileService { get; set; } = default!;

    private void HandlePoApiUpload(List<ApiFileUpload.UploadResult> results, ClientPO po)
    {
        var result = results.FirstOrDefault();
        if (result != null)
        {
            po.FilePath = result.FilePath;
            po.MimeType = result.ContentType;
            Snackbar.Add("PO File Uploaded", Severity.Success);

            AutoSave();
            StateHasChanged();
        }
    }
}
