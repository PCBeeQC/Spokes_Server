@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Constants
@using Spokes_Server.Components.Shared
@using Spokes_Server.Components.Dialogs.Projects
@inject Database Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject UserService UserService
@using Spokes_Server.Core.Services.Storage
@inject IFileService FileService

<MudGrid Class="mb-4 align-center">
    @* --- PROJECT REPORTS SECTION --- *@
    <MudItem xs="12" sm="7">
        <MudText Typo="Typo.h5">@BizLoc["Project Reports"]</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @BizLoc["Point-in-time project status, labor, and financial reports (Bilan de Projet) preserved at their cutoff date."]
        </MudText>
    </MudItem>
    <MudItem xs="12" sm="5" Class="d-flex justify-end gap-2">
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Assessment"
                       OnClick="CreateNewReport">@BizLoc["New Project Report"]</MudButton>
        }
    </MudItem>

    <MudItem xs="12" Class="mt-n2">
        <MudTable Items="@_reports" Hover="true" Dense="true" Striped="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>@BizLoc["Report #"]</MudTh>
                <MudTh>@Loc["Title"]</MudTh>
                <MudTh>@BizLoc["Report Period / As-Of"]</MudTh>
                <MudTh Style="text-align: right;">@BizLoc["Hours"]</MudTh>
                <MudTh>@Loc["Created"]</MudTh>
                <MudTh>@Loc["Status"]</MudTh>
                <MudTh Style="width: 140px;">@Loc["Actions"]</MudTh>
            </HeaderContent>
            <RowTemplate Context="report">
                <MudTd DataLabel="Report #"><b>@report.ReportNumber</b></MudTd>
                <MudTd DataLabel="Title">@report.Title</MudTd>
                <MudTd DataLabel="Period">
                    <MudChip T="string" Size="Size.Small" Variant="Variant.Outlined" Color="Color.Info" Icon="@Icons.Material.Filled.EventAvailable">
                        @(report.PeriodStartDate.HasValue ? $"{report.PeriodStartDate.Value:yyyy-MM-dd} → " : "")@report.AsOfDate.ToString("yyyy-MM-dd")
                    </MudChip>
                </MudTd>
                <MudTd DataLabel="Hours" Style="text-align: right;">
                    <b>@report.Snapshot.TotalLaborHours.ToString("N1") h</b>
                </MudTd>
                <MudTd DataLabel="Created">@report.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(report.Status == ProjectReportStatus.Final ? Color.Success : Color.Default)">
                        @BizLoc[report.Status]
                    </MudChip>
                </MudTd>
                <MudTd>
                    <div class="d-flex gap-1 align-center">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility"
                                   OnClick="@(() => OpenReportViewer(report))">@Loc["View"]</MudButton>
                        @if (CanEdit && report.Status != ProjectReportStatus.Final)
                        {
                            <MudTooltip Text="@Loc["Delete"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => DeleteReport(report))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4" Color="Color.Secondary">
                    @BizLoc["No project reports created yet. Click 'New Project Report' to generate a point-in-time bilan."]
                </MudText>
            </NoRecordsContent>
        </MudTable>
    </MudItem>

    <MudItem Class="mt-2" xs="12">
        <MudDivider></MudDivider>
    </MudItem>

    @* --- PROJECT DOCUMENTS SECTION --- *@
    <MudItem xs="6">
        <MudText Typo="Typo.h5">Project Documents</MudText>
    </MudItem>
    <MudItem xs="6" Class="d-flex justify-end gap-2">
        @if (CanEdit)
        {
            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.NoteAdd"
                OnClick="CreateBlankDocument">Blank Document</MudButton>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
                OnClick="OpenGenerateDialog">From Template</MudButton>
        }
    </MudItem>

    @* Project Documents *@
    <MudItem xs="12" Class="mt-n2">
        <MudTable Items="@_documents" Hover="true" Dense="true" Striped="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>Name</MudTh>
                <MudTh>Created</MudTh>
                <MudTh>Status</MudTh>
                <MudTh Style="width: 120px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate Context="doc">
                <MudTd DataLabel="Name">@doc.Name</MudTd>
                <MudTd DataLabel="Created">@doc.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                <MudTd DataLabel="Status">
                    <MudChip T="string" Size="Size.Small" Color="@(doc.Status == ProjectDocumentStatus.Final ? Color.Success : Color.Info)">
                        @doc.Status
                    </MudChip>
                </MudTd>
                <MudTd>
                    <div class="d-flex gap-1">
                        <MudButton Variant="Variant.Outlined" Size="Size.Small" StartIcon="@Icons.Material.Filled.Visibility" OnClick="@(() => OpenViewer(doc))">View</MudButton>
                        @if (CanEdit && doc.Status != ProjectDocumentStatus.Final)
                        {
                            <MudTooltip Text="Rename">
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Size="Size.Small"
                                               OnClick="@(() => RenameDocument(doc))" />
                            </MudTooltip>
                            <MudTooltip Text="Delete">
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => OnDelete(doc))" />
                            </MudTooltip>
                        }
                    </div>
                </MudTd>
            </RowTemplate>
            <NoRecordsContent>
                <MudText Align="Align.Center" Class="pa-4">No documents generated for this project yet.</MudText>
            </NoRecordsContent>
        </MudTable>
    </MudItem>

    @if (CanViewPurchases)
    {
        <MudItem Class="mt-2" xs="12">
            <MudDivider></MudDivider>
        </MudItem>

        <MudItem xs="12">
            <MudText Typo="Typo.h5">Project Procurement</MudText>
        </MudItem>

        <MudItem xs="12" Class="mt-n4 d-flex justify-space-between align-center">
            <MudText Typo="Typo.body2">Purchase Orders sent by @(Profile?.CompanyName ?? "the company") for this project.</MudText>
        </MudItem>

        <MudItem xs="12" Class="mt-n4">
            @if (!PurchaseRows.Any())
            {
                <MudAlert Severity="Severity.Info" Dense="true">No purchase orders found for this project.</MudAlert>
            }
            else
            {
                <MudTable Items="@PurchaseRows" Hover="true" Dense="true" Outlined="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>Date</MudTh>
                        <MudTh>PO #</MudTh>
                        <MudTh>Description</MudTh>
                        <MudTh>Net Cost</MudTh>
                        <MudTh>Tax</MudTh>
                        <MudTh>Total</MudTh>
                        <MudTh Style="width: 80px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate Context="poRow">
                        <MudTd>@poRow.Date.ToShortDateString()</MudTd>
                        <MudTd><b>@poRow.PoNumber</b></MudTd>
                        <MudTd>
                            @poRow.Description
                            @if (!string.IsNullOrEmpty(poRow.PartNumber))
                            {
                                <MudText Typo="Typo.caption" Class="ml-2" Color="Color.Secondary">Ref: @poRow.PartNumber</MudText>
                            }
                        </MudTd>
                        <MudTd>@poRow.NetTotal.ToString("C")</MudTd>
                        <MudTd>@poRow.TaxAmount.ToString("C")</MudTd>
                        <MudTd><b>@poRow.GrandTotal.ToString("C")</b></MudTd>
                        <MudTd>
                            <MudTooltip Text="View PO">
                                <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small" Color="Color.Primary"
                                               OnClick="@(() => Nav.NavigateTo($"/purchases/{poRow.Id}"))" />
                            </MudTooltip>
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="5"><b>Total Procurement Cost</b></MudTd>
                        <MudTd><b>@TotalPurchaseCost.ToString("C")</b></MudTd>
                        <MudTd></MudTd>
                    </FooterContent>
                </MudTable>
            }
        </MudItem>
    }

    <MudItem Class="mt-2" xs="12">
        <MudDivider></MudDivider>
    </MudItem>

    <MudItem xs="12">
        <MudText Typo="Typo.h5">PO Received for this project</MudText>
    </MudItem>

    <MudItem xs="12" Class="mt-n8 d-flex justify-space-between align-center">
        <MudText Typo="Typo.body2">Attach client Purchase Orders (POs) to this project.</MudText>
        @if (CanEdit)
        {
            <MudSwitch T="bool" @bind-Value="IsEditing" Label="Edit Mode" Color="Color.Primary" />
        }
    </MudItem>

    <MudItem xs="12" Class="mt-n4">
        <MudTable Items="@Project.PurchaseOrders" Hover="true" Dense="true" Striped="true" Outlined="true" Elevation="0">
            <HeaderContent>
                <MudTh>PO Number</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Amount</MudTh>
                <MudTh>File</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>
                    <MudTextField @bind-Value="context.PoNumber" Label="PO #" Margin="Margin.Dense" OnBlur="@(() => AutoSave())"
                                  Disabled="@(!IsEditing)" Variant="Variant.Text"
                                  Underline="@IsEditing" />
                </MudTd>
                <MudTd>
                    <MudDatePicker Date="context.DateReceived"
                                   DateChanged="@(async (DateTime? d) => { context.DateReceived = d; await AutoSave(); })" Label="Date"
                                   Margin="Margin.Dense" Editable="true" Disabled="@(!IsEditing)" ShowToolbar="@IsEditing" />
                </MudTd>
                <MudTd>
                    <MudNumericField Value="context.Amount"
                                     ValueChanged="@(async (decimal v) => { context.Amount = v; await AutoSave(); })" Label="Amount" Format="N2"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney"
                                     Margin="Margin.Dense" Disabled="@(!IsEditing)" Underline="@IsEditing"
                                     HideSpinButtons="@(!IsEditing)" />
                </MudTd>
                <MudTd>
                    @if (!string.IsNullOrEmpty(context.FilePath))
                    {
                        <FileAttachmentChip FileName="@context.FileName"
                                            FilePath="@context.FilePath"
                                            ContentType="@context.MimeType"
                                            ReadOnly="@(!IsEditing)"
                                            OnRemove="@(async _ => await RemoveFile(context))" />
                    }
                    else if (IsEditing)
                    {
                        <ApiFileUpload Category="projects" ContextId="@Project.Id" MaximumFileCount="1"
                                       OnUploadCompleted="@((results) => HandlePoApiUpload(results, context))"
                                       OnUploadError='(e) => Snackbar.Add($"Upload failed: {e}", Severity.Error)'>
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">Upload</MudButton>
                            </CustomContent>
                        </ApiFileUpload>
                    }
                </MudTd>
                <MudTd>
                    @if (IsEditing)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                       OnClick="@(() => RemovePO(context))" />
                    }
                </MudTd>
            </RowTemplate>
            <FooterContent>
                <MudTd colspan="5">
                    @if (IsEditing)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddPurchaseOrder" Color="Color.Primary">
                            Add PO
                        </MudButton>
                    }
                </MudTd>
            </FooterContent>
        </MudTable>
    </MudItem>

    
</MudGrid>



@code {
    [Parameter] public string ProjectId { get; set; } = string.Empty;

    private List<ProjectReport> _reports = [];
    private List<ProjectDocument> _documents = [];
    private bool CanEdit = false;
    private bool CanViewPurchases = false;
    private bool _hasAuthorizedAccess;
    private string? _authorizedProjectId;
    private CompanyProfile? Profile;

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_authorizedProjectId, ProjectId, StringComparison.Ordinal))
        {
            _reports = [];
            _documents = [];
            PurchaseRows.Clear();
            CanEdit = false;
            CanViewPurchases = false;
            IsEditing = false;
            _hasAuthorizedAccess = false;
            _authorizedProjectId = null;
        }

        Profile = Db.CompanyProfile.Get();
        await LoadPermissions();
        Reload();
    }

    private async Task LoadPermissions()
    {
        var emp = await UserService.GetEmployeeAsync(allowSuspended: true);
        var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        if (emp == null || liveProject == null || !UserService.CanViewProject(emp, liveProject, allowAccountingFinancialRead: false))
        {
            CanEdit = false;
            CanViewPurchases = false;
            IsEditing = false;
            _hasAuthorizedAccess = false;
            _authorizedProjectId = null;
            return;
        }

        _hasAuthorizedAccess = true;
        _authorizedProjectId = liveProject.Id;
        CanEdit = UserService.CanEditProject(emp, liveProject);
        CanViewPurchases = emp.IsEffectiveAdmin ||
                           emp.HasPermission(AppPermissions.Finance.AccessAccounting) ||
                           (emp.IsAdmin && emp.IsActive && !emp.IsBanned) ||
                           emp.HasEffectivePermission(AppPermissions.Purchases.ViewPOs, allowSuspended: true) ||
                           emp.HasEffectivePermission(AppPermissions.Purchases.ManagePOs, allowSuspended: true);
        if (!CanEdit)
        {
            IsEditing = false;
        }
    }

    private void Reload()
    {
        if (!_hasAuthorizedAccess || string.IsNullOrEmpty(ProjectId))
        {
            _reports = [];
            _documents = [];
            PurchaseRows.Clear();
            return;
        }

        _reports = Db.ProjectsContext?.ProjectReports != null
            ? Db.ProjectReports.GetByProject(ProjectId)
            : [];
        _documents = Db.ProjectDocuments.GetByProject(ProjectId);
        LoadPurchases();
    }

    private async Task<(Spokes_Server.Core.Models.HR.Employee Actor, Project Project)?> AuthorizeEditAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveProject = string.IsNullOrEmpty(ProjectId) ? null : Db.Projects.GetById(ProjectId);
        if (emp == null || liveProject == null || !UserService.CanEditProject(emp, liveProject))
        {
            CanEdit = false;
            IsEditing = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return null;
        }
        return (emp, liveProject);
    }

    private async Task CreateNewReport()
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        var parameters = new DialogParameters<ProjectReportEditorDialog>
        {
            { x => x.ProjectId, auth.Value.Project.Id }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ProjectReportEditorDialog>(BizLoc["Create Project Report"], parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ProjectReport createdReport)
        {
            Snackbar.Add(string.Format(BizLoc["Project report #{0} created."].Value, createdReport.ReportNumber), Severity.Success);
            Reload();
            OpenReportViewer(createdReport);
        }
    }

    private void OpenReportViewer(ProjectReport report) =>
        Nav.NavigateTo($"/projects/{ProjectId}/reports/{report.Id}");

    private async Task DeleteReport(ProjectReport report)
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        var liveReport = Db.ProjectReports.GetById(report.Id);
        if (liveReport == null || liveReport.ProjectId != auth.Value.Project.Id)
        {
            Snackbar.Add("Project report not found.", Severity.Error);
            return;
        }

        if (liveReport.Status == ProjectReportStatus.Final &&
            !auth.Value.Actor.IsEffectiveAdmin &&
            !auth.Value.Actor.HasPermission(AppPermissions.Projects.Delete))
        {
            Snackbar.Add("Access denied.", Severity.Error);
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync(
            BizLoc["Delete Project Report"],
            string.Format(BizLoc["Are you sure you want to delete report #{0} ({1})?"].Value, liveReport.ReportNumber, liveReport.Title),
            Loc["Delete"], cancelText: Loc["Cancel"]);

        if (confirm == true)
        {
            var confirmAuth = await AuthorizeEditAsync();
            if (confirmAuth == null) return;

            var confirmReport = Db.ProjectReports.GetById(liveReport.Id);
            if (confirmReport == null || confirmReport.ProjectId != confirmAuth.Value.Project.Id)
            {
                Snackbar.Add("Access denied.", Severity.Error);
                return;
            }
            if (confirmReport.Status == ProjectReportStatus.Final &&
                !confirmAuth.Value.Actor.IsEffectiveAdmin &&
                !confirmAuth.Value.Actor.HasPermission(AppPermissions.Projects.Delete))
            {
                Snackbar.Add("Access denied.", Severity.Error);
                return;
            }

            if (!string.IsNullOrEmpty(confirmReport.PdfPath) && System.IO.File.Exists(confirmReport.PdfPath))
            {
                try { System.IO.File.Delete(confirmReport.PdfPath); } catch { }
            }
            Db.ProjectReports.Delete(confirmReport.Id);
            Snackbar.Add(BizLoc["Project report deleted."], Severity.Info);
            Reload();
        }
    }

    private List<ProjectPurchaseRow> PurchaseRows = [];
    private decimal TotalPurchaseCost => PurchaseRows.Sum(p => p.GrandTotal);

    private void LoadPurchases()
    {
        PurchaseRows = CanViewPurchases
            ? Db.PurchaseOrders.GetProjectPurchaseRows(ProjectId)
            : [];
    }

    private async Task OpenGenerateDialog()
    {
        if (await AuthorizeEditAsync() == null) return;

        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<GenerateDocumentDialog>("Generate New Document", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is StandardDocument template)
        {
            var name = await PromptForName(template.Name);
            if (name != null)
                await GenerateFromTemplate(template, name);
        }
    }

    private async Task GenerateFromTemplate(StandardDocument template, string name)
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        var doc = new ProjectDocument
            {
                ProjectId = auth.Value.Project.Id,
                StandardDocumentId = template.Id,
                Name = name,
                Status = ProjectDocumentStatus.Draft,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

        Db.ProjectDocuments.Save(doc);
        Snackbar.Add($"Document '{doc.Name}' generated as Draft", Severity.Success);
        Reload();

        // Auto-navigate to viewer for the new draft
        OpenViewer(doc);
    }

    private async Task CreateBlankDocument()
    {
        if (await AuthorizeEditAsync() == null) return;

        var name = await PromptForName("Untitled Document");
        if (name == null) return;

        var saveAuth = await AuthorizeEditAsync();
        if (saveAuth == null) return;

        var doc = new ProjectDocument
            {
                ProjectId = saveAuth.Value.Project.Id,
                StandardDocumentId = string.Empty,
                Name = name,
                ResolvedBody = "",
                Status = ProjectDocumentStatus.Draft,
                IsManualEdit = true,
                CreatedAt = DateTime.UtcNow,
                UpdatedAt = DateTime.UtcNow
            };

        Db.ProjectDocuments.Save(doc);
        Snackbar.Add("Blank document created", Severity.Success);
        Reload();
        OpenViewer(doc);
    }

    private async Task<string?> PromptForName(string defaultName)
    {
        var parameters = new DialogParameters
            {
                ["CurrentName"] = defaultName,
                ["Label"] = "Document Name",
                ["SubmitLabel"] = "Create"
            };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RenameDialog>("Name Your Document", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string name && !string.IsNullOrWhiteSpace(name))
            return name;

        return null;
    }

    private async Task RenameDocument(ProjectDocument doc)
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        var liveDoc = Db.ProjectDocuments.GetById(doc.Id);
        if (liveDoc == null || liveDoc.ProjectId != auth.Value.Project.Id)
        {
            Snackbar.Add("Document not found.", Severity.Error);
            return;
        }

        var parameters = new DialogParameters
            {
                ["CurrentName"] = liveDoc.Name
            };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RenameDialog>("Rename Document", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is string newName && !string.IsNullOrWhiteSpace(newName))
        {
            var saveAuth = await AuthorizeEditAsync();
            if (saveAuth == null) return;

            var saveDoc = Db.ProjectDocuments.GetById(liveDoc.Id);
            if (saveDoc == null || saveDoc.ProjectId != saveAuth.Value.Project.Id)
            {
                Snackbar.Add("Access denied.", Severity.Error);
                return;
            }

            saveDoc.Name = newName;
            saveDoc.UpdatedAt = DateTime.UtcNow;
            Db.ProjectDocuments.Save(saveDoc);
            Snackbar.Add($"Document renamed to '{newName}'", Severity.Success);
            Reload();
        }
    }

    private void OpenViewer(ProjectDocument doc) =>
        Nav.NavigateTo($"/projects/{ProjectId}/documents/{doc.Id}");

    private async Task OnDelete(ProjectDocument doc)
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        var liveDoc = Db.ProjectDocuments.GetById(doc.Id);
        if (liveDoc == null || liveDoc.ProjectId != auth.Value.Project.Id)
        {
            Snackbar.Add("Document not found.", Severity.Error);
            return;
        }
        if (liveDoc.Status == ProjectDocumentStatus.Final &&
            !auth.Value.Actor.IsEffectiveAdmin &&
            !auth.Value.Actor.HasPermission(AppPermissions.Projects.Delete))
        {
            Snackbar.Add("Access denied.", Severity.Error);
            return;
        }

        var confirm = await DialogService.ShowMessageBoxAsync("Delete Document",
        $"Are you sure you want to delete '{liveDoc.Name}'?",
        "Delete", cancelText: "Cancel");

        if (confirm == true)
        {
            var deleteAuth = await AuthorizeEditAsync();
            if (deleteAuth == null) return;

            var deleteDoc = Db.ProjectDocuments.GetById(liveDoc.Id);
            if (deleteDoc == null || deleteDoc.ProjectId != deleteAuth.Value.Project.Id)
            {
                Snackbar.Add("Access denied.", Severity.Error);
                return;
            }
            if (deleteDoc.Status == ProjectDocumentStatus.Final &&
                !deleteAuth.Value.Actor.IsEffectiveAdmin &&
                !deleteAuth.Value.Actor.HasPermission(AppPermissions.Projects.Delete))
            {
                Snackbar.Add("Access denied.", Severity.Error);
                return;
            }

            Db.ProjectDocuments.Delete(deleteDoc.Id);
            Snackbar.Add("Document deleted", Severity.Info);
            Reload();
        }
    }

    [Parameter] public Project Project { get; set; } = new();
    private bool IsEditing = false;


    private async Task AddPurchaseOrder()
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        Project.PurchaseOrders.Add(new ClientPo());
        await SavePurchaseOrdersAsync(auth.Value.Project);
    }

    private async Task RemovePO(ClientPo po)
    {
        if (await AuthorizeEditAsync() == null) return;

        bool? result = await DialogService.ShowMessageBoxAsync(
        "Delete Purchase Order",
        "Are you sure you want to delete this Purchase Order? This cannot be undone.",
        yesText: "Delete", cancelText: "Cancel");

        if (result == true)
        {
            var deleteAuth = await AuthorizeEditAsync();
            if (deleteAuth == null) return;

            await FileService.DeleteAssociatedFilesAsync(po);
            Project.PurchaseOrders.Remove(po);
            await SavePurchaseOrdersAsync(deleteAuth.Value.Project); // Also save the changes
            StateHasChanged();
        }
    }

    private async Task RemoveFile(ClientPo po)
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        if (!string.IsNullOrEmpty(po.FilePath))
        {
            await FileService.DeleteAsync(po.FilePath);
        }
        po.FilePath = "";
        po.FileName = "";
        po.MimeType = "";
        await SavePurchaseOrdersAsync(auth.Value.Project);
        StateHasChanged();
    }

    private async Task AutoSave()
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;
        await SavePurchaseOrdersAsync(auth.Value.Project);
    }

    private Task SavePurchaseOrdersAsync(Project liveProject)
    {
        liveProject.PurchaseOrders = Project.PurchaseOrders;
        Db.Projects.Save(liveProject);
        return Task.CompletedTask;
    }

    private async Task HandlePoApiUpload(List<ApiFileUpload.UploadResult> results, ClientPo po)
    {
        var auth = await AuthorizeEditAsync();
        if (auth == null) return;

        var result = results.FirstOrDefault();
        if (result != null)
        {
            if (!string.IsNullOrEmpty(po.FilePath) && po.FilePath != result.FilePath)
            {
                await FileService.DeleteAsync(po.FilePath);
            }
            po.FilePath = result.FilePath;
            po.FileName = result.FileName;
            po.MimeType = result.ContentType;
            Snackbar.Add("PO File Uploaded", Severity.Success);

            await SavePurchaseOrdersAsync(auth.Value.Project);
            StateHasChanged();
        }
    }
}
