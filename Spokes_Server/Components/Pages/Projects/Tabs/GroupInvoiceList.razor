@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Common
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Core.Data
@inject Database Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject UserService UserService

<MudGrid Class="mb-4">
    <MudItem xs="12" md="6">
        <MudText Typo="Typo.h6">Group Invoices</MudText>
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            Centralized invoicing for all projects in this group
        </MudText>
    </MudItem>
    <MudItem xs="12" md="6" Class="d-flex justify-end align-center gap-2">
        @if (_canManageInvoices)
        {
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="CreateInvoice">Create Invoice</MudButton>
        }
    </MudItem>
</MudGrid>

<MudAlert Severity="Severity.Info" Class="mb-4">
    Unbilled Work Available: <b>@UnbilledLabor.ToString("C")</b> (Labor) + <b>@UnbilledExpenses.ToString("C")</b> (Expenses)
    across @ProjectCount projects
</MudAlert>

<MudTable Elevation="0" Outlined="true" Items="@Invoices" Hover="true" Dense="true">
    <HeaderContent>
        <MudTh>Invoice #</MudTh>
        <MudTh>Date</MudTh>
        <MudTh>Total</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Paid Date</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd>@context.InvoiceNumber</MudTd>
        <MudTd>@context.Date.ToString("MMM dd, yyyy")</MudTd>
        <MudTd>@context.GrandTotal.ToString("C")</MudTd>
        <MudTd>
            <StatusChip Status="@context.Status" />
        </MudTd>
        <MudTd>@(context.DatePaid.HasValue ? context.DatePaid.Value.ToShortDateString() : "-")</MudTd>
        <MudTd>
            <MudIconButton Icon="@Icons.Material.Filled.Visibility" Size="Size.Small"
                           OnClick="@(() => OpenInvoice(context))" />
        </MudTd>
    </RowTemplate>
</MudTable>

@if (!Invoices.Any())
{
    <MudAlert Severity="Severity.Info" Class="mt-4">
        No invoices have been created for this group yet.
    </MudAlert>
}

@code {
    [Parameter] public string ProjectGroupId { get; set; } = string.Empty;

    private ProjectGroup? Group;
    private List<Invoice> Invoices = [];
    private int ProjectCount = 0;

    // Unbilled Tracking
    private decimal UnbilledLabor = 0;
    private decimal UnbilledExpenses = 0;
    private bool _canManageInvoices;
    private bool _canApproveInvoice;
    private bool _hasAuthorizedAccess;
    private string? _authorizedGroupId;
    private List<Project> _accessibleGroupProjects = [];

    protected override async Task OnParametersSetAsync()
    {
        if (!string.Equals(_authorizedGroupId, ProjectGroupId, StringComparison.Ordinal))
        {
            Group = null;
            Invoices = [];
            _accessibleGroupProjects = [];
            ProjectCount = 0;
            UnbilledLabor = 0;
            UnbilledExpenses = 0;
            _canManageInvoices = false;
            _canApproveInvoice = false;
            _hasAuthorizedAccess = false;
            _authorizedGroupId = null;
        }

        var emp = await UserService.GetEmployeeAsync();
        var liveGroup = string.IsNullOrEmpty(ProjectGroupId) ? null : Db.ProjectGroups.GetById(ProjectGroupId);
        if (emp == null || liveGroup == null)
        {
            return;
        }

        var canAccountingRead = emp.HasEffectivePermission(AppPermissions.Finance.AccessAccounting, allowSuspended: true);
        if (!emp.IsActiveUnsuspended && !canAccountingRead)
        {
            return;
        }

        var groupProjects = liveGroup.ProjectIds
            .Select(pid => Db.Projects.GetById(pid))
            .Where(p => p != null)
            .Cast<Project>()
            .ToList();

        var accessibleProjects = groupProjects
            .Where(p => UserService.CanViewProject(emp, p, allowAccountingFinancialRead: true))
            .ToList();

        var canViewGroup = canAccountingRead || !liveGroup.ProjectIds.Any() || accessibleProjects.Any();
        if (!canViewGroup)
        {
            return;
        }

        Group = liveGroup;
        _accessibleGroupProjects = accessibleProjects;
        _hasAuthorizedAccess = true;
        _authorizedGroupId = liveGroup.Id;
        _canApproveInvoice = emp.HasPermission(AppPermissions.Finance.ApproveInvoices);
        _canManageInvoices = emp.HasPermission(AppPermissions.Finance.AccessAccounting) || _canApproveInvoice;
        Refresh();
    }

    private void Refresh()
    {
        if (!_hasAuthorizedAccess || Group == null)
        {
            Invoices = [];
            ProjectCount = 0;
            UnbilledLabor = 0;
            UnbilledExpenses = 0;
            return;
        }

        Group = Db.ProjectGroups.GetById(ProjectGroupId);
        if (Group == null) return;

        ProjectCount = _accessibleGroupProjects.Count;
        Invoices = Db.Invoices.GetByProjectGroup(ProjectGroupId);
        CalculateUnbilled();
    }

    private void CalculateUnbilled()
    {
        if (!_hasAuthorizedAccess || Group == null) return;

        var projectIds = _accessibleGroupProjects.Select(p => p.Id).ToHashSet();
        
        // Get IDs of everything already billed by posted group invoices (Draft and Void invoices do not count)
        var postedGroupInvoices = Invoices.Where(i => InvoiceStatus.IsPosted(i.Status)).ToList();
        var billedTimeIds = postedGroupInvoices.SelectMany(i => i.BilledTimeEntryIds).ToHashSet();
        var billedPoItemIds = postedGroupInvoices.SelectMany(i => i.BilledPoItemIds).ToHashSet();
        var billedExpenseItemIds = postedGroupInvoices.SelectMany(i => i.BilledExpenseItemIds).ToHashSet();

        // Also consider individual posted project invoices (for projects that might have some)
        foreach (var projectId in projectIds)
        {
            var projectInvoices = Db.Invoices.GetByProject(projectId)
                .Where(i => InvoiceStatus.IsPosted(i.Status));
            foreach (var inv in projectInvoices)
            {
                billedTimeIds.UnionWith(inv.BilledTimeEntryIds);
                billedPoItemIds.UnionWith(inv.BilledPoItemIds);
                billedExpenseItemIds.UnionWith(inv.BilledExpenseItemIds);
            }
        }

        // Calculate unbilled labor across all projects in group
        var allSheets = Db.Timesheets.GetAll();
        var allEntries = allSheets.SelectMany(s => s.Entries)
            .Where(e => projectIds.Contains(e.ProjectId) && !billedTimeIds.Contains(e.Id));

        var workTypes = Db.WorkTypes.GetAll().ToDictionary(w => w.Id, w => w);
        decimal laborTotal = 0;

        foreach (var entry in allEntries)
        {
            var project = Db.Projects.GetById(entry.ProjectId);
            if (project == null) continue;

            var rate = workTypes.ContainsKey(entry.WorkTypeId) ? workTypes[entry.WorkTypeId].DefaultRate : 0;
            if (project.RateCardId != null)
            {
                var card = Db.RateCards.GetById(project.RateCardId);
                if (card != null) rate = project.GetEffectiveRate(entry.WorkTypeId, rate, card);
            }
            laborTotal += entry.Hours * rate;
        }
        UnbilledLabor = laborTotal;

        // Calculate unbilled expenses (POs + Expense Reports)
        var allPos = Db.PurchaseOrders.GetAll();
        var allReports = Db.ExpenseReports.GetAll();

        decimal markupRate = 0.15m; // Default markup
        decimal expenseTotal = 0;

        // PO Items
        foreach (var po in allPos)
        {
            var unbilledItems = po.LineItems
                .Where(i => projectIds.Contains(i.ProjectId) && !billedPoItemIds.Contains(i.Id));
            expenseTotal += unbilledItems.Sum(i => i.Total);
        }

        // Expense items
        foreach (var report in allReports.Where(r => r.DateSubmitted.HasValue && r.Status != ExpenseReportStatus.Draft))
        {
            var unbilledItems = report.LineItems
                .Where(i => projectIds.Contains(i.ProjectId) && !billedExpenseItemIds.Contains(i.Id));
            expenseTotal += unbilledItems.Sum(i => i.Total);
        }

        UnbilledExpenses = expenseTotal * (1 + markupRate);
    }

    private async Task CreateInvoice()
    {
        var emp = await UserService.GetEmployeeAsync();
        var liveGroup = string.IsNullOrEmpty(ProjectGroupId) ? null : Db.ProjectGroups.GetById(ProjectGroupId);
        if (emp == null || liveGroup == null)
        {
            _canManageInvoices = false;
            _canApproveInvoice = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return;
        }

        var canApprove = emp.HasPermission(AppPermissions.Finance.ApproveInvoices);
        var canManage = emp.HasPermission(AppPermissions.Finance.AccessAccounting) || canApprove;
        if (!canManage)
        {
            _canManageInvoices = false;
            _canApproveInvoice = false;
            Snackbar.Add("Access denied.", Severity.Error);
            return;
        }

        var groupProjects = liveGroup.ProjectIds
            .Select(pid => Db.Projects.GetById(pid))
            .Where(p => p != null)
            .Cast<Project>()
            .ToList();
        if (groupProjects.Any(p => !UserService.CanViewProject(emp, p, allowAccountingFinancialRead: true)))
        {
            Snackbar.Add("Access denied to one or more projects in this group.", Severity.Error);
            return;
        }

        var actorName = emp.FullName ?? emp.Email ?? "System";
        var profile = Db.CompanyProfile.Get();
        var template = Db.DocumentTemplates.GetDefault();

        var invoice = new Invoice
        {
            ProjectGroupId = liveGroup.Id,
            ProjectId = liveGroup.ProjectIds.FirstOrDefault() ?? "", // Use first project as reference
            InvoiceNumber = Db.Invoices.GenerateInvoiceNumber(profile.InvoicePrefix),
            Date = DateTime.Today,
            Status = InvoiceStatus.Draft,
            TaxRate = FinancialCalculationEngine.ActiveCombinedTaxRate,
            PaymentTerms = template?.DefaultPaymentTerms ?? string.Empty,
            History =
            [
                new DocumentHistoryEntry
                {
                    Timestamp = DateTime.UtcNow,
                    Action = DocumentHistoryActions.Created,
                    NewStatus = InvoiceStatus.Draft,
                    ChangedBy = actorName,
                    Summary = "Created draft group invoice"
                }
            ]
        };

        var parameters = new DialogParameters<InvoiceMasterDialog>
        {
            { x => x.Invoice, invoice },
            { x => x.CanEditDraft, true },
            { x => x.CanApproveInvoice, canApprove }
        };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true };

        var dialog = await DialogService.ShowAsync<InvoiceMasterDialog>("Create Group Invoice", parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            Refresh();
            Snackbar.Add("Invoice Created", Severity.Success);
        }
    }

    private void OpenInvoice(Invoice inv)
    {
        if (!string.IsNullOrEmpty(ProjectGroupId))
        {
            Nav.NavigateTo($"/project-groups/{ProjectGroupId}/invoices/{inv.Id}");
        }
        else if (Group != null && Group.ProjectIds.Any())
        {
            Nav.NavigateTo($"/projects/{Group.ProjectIds.First()}/invoices/{inv.Id}");
        }
    }
}
