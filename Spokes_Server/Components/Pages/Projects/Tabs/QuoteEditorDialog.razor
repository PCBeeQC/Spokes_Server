    [Inject] private Spokes_Server.Core.Services.Core.IFileService FileService { get; set; } = default!;

    private void HandleImageUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        
        var result = results.First();
        var parts = result.FilePath.Substring("/spokesapi/files/".Length).Split('/');
        if (parts.Length != 3) return;
        var fullPath = FileService.GetPhysicalPath(parts[0], parts[1], parts[2]);
        
        if (File.Exists(fullPath))
        {
            try
            {
                var bytes = File.ReadAllBytes(fullPath);
                var base64 = Convert.ToBase64String(bytes);
                var format = result.FileName?.EndsWith("png", StringComparison.OrdinalIgnoreCase) == true ? "png" : "jpeg";
                Quote.MainImageBase64 = $"data:image/{format};base64,{base64}";
                FileService.CleanTempContext(parts[1]);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error processing image: {ex.Message}", Severity.Error);
                FileService.CleanTempContext(parts[1]);
            }
        }
    }

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(Quote));

    // --- RECALCULATION ---
    private void RecalculateTerms()
    {
        // When GrandTotal changes, update the amounts of all payment terms
        foreach (var term in Quote.PaymentTerms)
        {
            term.Amount = Quote.GrandTotal * (term.Percentage / 100m);
        }
        StateHasChanged();
    }

    private DateTime? QuoteDate { get => Quote.Date; set => Quote.Date = value ?? DateTime.Today; }
    private DateTime? QuoteStartDate { get => Quote.StartDate?.ToDateTime(TimeOnly.MinValue); set => Quote.StartDate = value.HasValue ? DateOnly.FromDateTime(value.Value) : null; }
    private DateTime? QuoteDeadline { get => Quote.Deadline?.ToDateTime(TimeOnly.MinValue); set => Quote.Deadline = value.HasValue ? DateOnly.FromDateTime(value.Value) : null; }

    // --- MONTHLY PAYMENTS ---
    private decimal GetRemainingPercentage() => 100 - Quote.PaymentTerms.Sum(x => x.Percentage);
    private decimal GetRemainingAmount() => Quote.GrandTotal * (GetRemainingPercentage() / 100m);
    private decimal GetMonthlyAmount() => Quote.MonthlyPaymentMonths > 0 ? GetRemainingAmount() / Quote.MonthlyPaymentMonths : 0;

    private string GetMonthlyPaymentPreview()
    {
        try
        {
            return string.Format(Quote.MonthlyPaymentDescription, 
                Quote.MonthlyPaymentMonths, 
                GetMonthlyAmount().ToString("C"), 
                GetRemainingPercentage());
        }
        catch
        {
            return Quote.MonthlyPaymentDescription;
        }
    }
