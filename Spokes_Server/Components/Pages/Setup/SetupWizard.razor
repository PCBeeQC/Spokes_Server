    private async Task HandleLicenseUploaded(IBrowserFile file)
    {
        if (file == null) return;
        
        try
        {
            using var stream = file.OpenReadStream(10 * 1024 * 1024);
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            
            var config = Db.ServerConfigs.GetOrCreateGlobalConfig();
            var validationResult = LicenseService.ValidateLicense(json, config);

            if (validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid || validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Tolerated)
            {
                if (validationResult.ParsedLicense != null)
                {
                    _licensePayload = json;
                    
                    var newEditions = Spokes_Server.Core.Services.Licensing.LicenseValidationService.GetAvailableEditions(validationResult);
                    if (!newEditions.Contains(_selectedEdition))
                    {
                        _selectedEdition = newEditions.FirstOrDefault() ?? "Family";
                    }
                    
                    // Automatically select if only 1 edition is available
                    if (newEditions.Count == 1)
                    {
                        _selectedEdition = newEditions.First();
                    }
                    
                    Snackbar.Add("License Validated Successfully!", Severity.Success);
                }
                else
                {
                    Snackbar.Add("License is valid but could not be parsed.", Severity.Warning);
                }
            }
            else
            {
                Snackbar.Add($"Invalid License: {validationResult.Message}", Severity.Error);
            }
            
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload Failed: {ex.Message}", Severity.Error);
        }
    }

    private string GetTimeUntilExpiry(DateTime expiry)
    {
        var span = expiry - DateTime.UtcNow;
        if (span.TotalDays < 0) return $"Expired {(int)Math.Abs(span.TotalDays)} days ago";
        
        int totalDays = (int)span.TotalDays;
        int years = totalDays / 365;
        int months = (totalDays % 365) / 30;
        int days = (totalDays % 365) % 30;
        
        if (years > 0) return $"{years} years, {months} months";
        if (months > 0) return $"{months} months, {days} days";
        return $"{days} days";
    }

    private List<string> GetAvailableEditions()
    {
        var config = Db.ServerConfigs.GetOrCreateGlobalConfig();
        var validationResult = LicenseService.ValidateLicense(_licensePayload, config);
        return Spokes_Server.Core.Services.Licensing.LicenseValidationService.GetAvailableEditions(validationResult);
    }
