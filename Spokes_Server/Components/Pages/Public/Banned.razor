@page "/banned"
@layout LoginLayout
@using Spokes_Server.Components.Layout
@using Microsoft.Extensions.Localization
@using Spokes_Server.Resources
@inject NavigationManager Nav
@inject UserService UserService
@inject IStringLocalizer<AppResources> Loc

<PageTitle>@Loc["Account Banned"]</PageTitle>

<div class="d-flex flex-column align-center justify-center" style="height: 100vh; width: 100vw; background-color: var(--mud-palette-background);">
    <MudIcon Icon="@Icons.Material.Filled.Block" Color="Color.Error" Style="font-size: 6rem;" Class="mb-4" />
    <MudText Typo="Typo.h4" GutterBottom="true" Align="Align.Center">@Loc["Account Banned"]</MudText>
    <MudText Typo="Typo.body1" Align="Align.Center" Class="mb-6">
        @Loc["You have been banned from this server. Please contact a moderator if you believe this is an error."]
    </MudText>
    
    <form action="/logout" method="post">
        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Logout">
            @Loc["Sign Out"]
        </MudButton>
        <AntiforgeryToken />
    </form>
</div>

@code {
    protected override async Task OnInitializedAsync()
    {
        var currentUser = await UserService.GetEmployeeAsync();
        if (currentUser == null || !currentUser.IsBanned)
        {
            Nav.NavigateTo("/", replace: true);
        }
    }
}
