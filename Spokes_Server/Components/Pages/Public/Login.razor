@page "/authentication/login"
@layout LoginLayout
@using Spokes_Server.Components.Layout
@using Spokes_Server.Core.Security
@attribute [AllowAnonymous]
@inject NavigationManager Nav
@inject Database Db

<MudContainer MaxWidth="MaxWidth.False" Class="d-flex align-center justify-center mud-width-full"
    Style="height: 100vh; background-color: #f4f6f8;">

    <MudPaper Elevation="3" Class="pa-8 d-flex flex-column align-center" Width="100%" MaxWidth="400px">

        <div class="d-flex justify-center mb-6">
            @if (Profile?.HasCustomLogo == true)
            {
                <MudImage Src="@($"/spokesapi/Media/Logo?v={Profile.LogoVersion}")" Height="80" ObjectFit="ObjectFit.Contain" />
            }
            else
            {
                <MudAvatar Color="Color.Primary" Style="height: 80px; width: 80px; font-size: 2rem;">
                    @(!string.IsNullOrEmpty(Profile?.CompanyName) ? Profile.CompanyName[..1] : "M")
                </MudAvatar>
            }
        </div>

        <MudText Typo="Typo.h4" Align="Align.Center" GutterBottom="true">@Profile?.CompanyName</MudText>
        <MudText Typo="Typo.body1" Align="Align.Center" Color="Color.Secondary" Class="mb-8">
            @Loc["Please sign in to access the management portal."]
        </MudText>

        <form id="sso-login-form" method="get" action="/sso/login" data-enhance-nav="false" class="mud-width-full">
            <input type="hidden" id="sso-login-device-id" name="deviceId" value="" />
            <input type="hidden" name="returnUrl" value="@SafeReturnUrl" />
            <MudButton id="sso-login-btn" ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Primary"
                Size="Size.Large" FullWidth="true" StartIcon="@Icons.Material.Filled.Login" Class="py-3">
                @Loc["Connect with SSO"]
            </MudButton>
        </form>

        <MudText Typo="Typo.caption" Color="Color.Default" Class="mt-8">
            &copy; @DateTime.Now.Year @Profile?.CompanyName
        </MudText>

    </MudPaper>
</MudContainer>

<script>
    (function () {
        const form = document.getElementById('sso-login-form');
        const deviceInput = document.getElementById('sso-login-device-id');
        if (!form || !deviceInput) return;

        let submitting = false;
        window.addEventListener('pageshow', function () {
            submitting = false;
        });

        form.addEventListener('submit', async function (ev) {
            if (submitting || deviceInput.value) return;
            if (window.pushNotifications && typeof window.pushNotifications.getDeviceId === 'function') {
                ev.preventDefault();
                submitting = true;
                try {
                    const deviceId = await window.pushNotifications.getDeviceId();
                    if (deviceId) {
                        deviceInput.value = deviceId;
                    }
                } catch (e) { }
                form.submit();
            }
        });
    })();
</script>

@code {
    [SupplyParameterFromQuery]
    public string? ReturnUrl { get; set; }

    [CascadingParameter]
    private HttpContext? HttpContext { get; set; }

    private CompanyProfile? Profile;

    private string SafeReturnUrl
    {
        get
        {
            if (HttpContext != null)
            {
                return RedirectHelper.GetSafeRedirectUrl(ReturnUrl, HttpContext, "/");
            }

            var currentHost = Uri.TryCreate(Nav.BaseUri, UriKind.Absolute, out var baseUri) ? baseUri.Host : "localhost";
            return RedirectHelper.GetSafeRedirectUrl(ReturnUrl, currentHost, "/");
        }
    }

    protected override void OnInitialized()
    {
        Profile = Db.CompanyProfile.Get();

        if (HttpContext?.User?.Identity?.IsAuthenticated == true)
        {
            Nav.NavigateTo(SafeReturnUrl, forceLoad: true);
            return;
        }

        // If we haven't tried a silent SSO login yet, redirect immediately (HTTP 302 during Static SSR).
        // This handles users navigating directly to the login page with an active IdP session.
        if (HttpContext != null && !HttpContext.Request.Cookies.ContainsKey("Spokes_SSO_Attempt"))
        {
            Nav.NavigateTo($"/sso/login/auto?returnUrl={Uri.EscapeDataString(SafeReturnUrl)}", forceLoad: true);
        }
    }
}
