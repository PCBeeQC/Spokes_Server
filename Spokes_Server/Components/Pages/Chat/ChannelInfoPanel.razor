@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Components.Dialogs
@implements IDisposable
@inject Database Db
@inject ChatService ChatService
@inject IUserPrivacyService PrivacyService
@inject ChatSecurityService ChatSecurityService
@inject ScopedKeystoreService ScopedKeystore
@inject IChatAuthorizationService ChatAuth
@inject ICryptoService Crypto
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject AppLabelService AppLabels

<MudPaper Elevation="0"
    Style="height: 100%; border-left: 1px solid var(--mud-palette-divider); display: flex; flex-direction: column; overflow: hidden;">
    @* Header *@
    <div class="pa-3" style="border-bottom: 1px solid var(--mud-palette-divider); flex-shrink: 0;">
        <div class="d-flex align-center justify-space-between">
            <MudText Typo="Typo.h6"><b>@Loc["Channel Info"]</b></MudText>
            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="OnClose" />
        </div>
    </div>

    @if (Channel != null)
    {
        <div class="px-2 py-3 d-flex flex-column gap-2" style="flex: 1; overflow-y: auto;">
            @if (IsChannelLocked)
            {
                <MudAlert Severity="Severity.Normal" Dense="true" Icon="@Icons.Material.Filled.Lock" Class="mb-1">
                    @Loc["Unlock secure chat to modify this channel."]
                </MudAlert>
            }
            @* ──────── General Info Card ──────── *@
            <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                <div class="d-flex align-center my-1 ml-3">
                    <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Class="mr-2" />
                    <MudText Typo="Typo.subtitle2">@Loc["General Info"]</MudText>
                </div>
                <MudDivider />
                <div class="px-3 py-2 d-flex flex-column gap-2">
                    @* Channel Icon & Name *@
                    @if (Channel?.ChannelType != ChatChannelType.Direct || (Channel?.ParticipantIds.Count > 2))
                    {
                        <div class="d-flex align-center gap-2">
                            @if (CanEditChannelInfo())
                            {
                                <MudTooltip Text="@Loc["Change Icon"]">
                                    <MudAvatar Style="height: 48px; width: 48px; cursor: pointer; flex-shrink: 0;" Color="Color.Primary" @onclick="PickIcon">
                                        <MudIcon Icon="@GetChannelIcon()" Size="Size.Medium" />
                                    </MudAvatar>
                                </MudTooltip>
                            }
                            else
                            {
                                <MudAvatar Style="height: 48px; width: 48px; flex-shrink: 0;" Color="Color.Primary">
                                    <MudIcon Icon="@GetChannelIcon()" Size="Size.Medium" />
                                </MudAvatar>
                            }
                            <div style="flex: 1; min-width: 0;">
                                @if (_isEditingName && CanEditChannelInfo())
                                {
                                    <MudTextField @bind-Value="_editingName" Variant="Variant.Outlined" Margin="Margin.Dense"
                                        Placeholder="@Loc["Channel name"]" Immediate="true" Class="ma-0"
                                        OnKeyDown="@(async (e) => { if (e.Key == "Enter" || e.Key == "NumpadEnter") await SaveName(); })"
                                        Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Check"
                                        OnAdornmentClick="SaveName" />
                                }
                                else if (CanEditChannelInfo())
                                {
                                    <div class="d-flex align-center gap-1" style="cursor: pointer;" @onclick="StartEditingName">
                                        <MudText Typo="Typo.subtitle2" Class="text-truncate"><b>@CurrentDisplayName</b></MudText>
                                        <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="opacity: 0.4; font-size: 14px;" />
                                    </div>
                                }
                                else
                                {
                                    <MudText Typo="Typo.subtitle2" Class="text-truncate"><b>@CurrentDisplayName</b></MudText>
                                }
                                @if (Channel!.ChannelType == ChatChannelType.Team)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Format(Loc["{0} channel · {1} members"].Value, AppLabels.Team, Channel.ParticipantIds.Count)</MudText>
                                }
                                else if (Channel.ChannelType == ChatChannelType.Group || (Channel.ChannelType == ChatChannelType.Direct && Channel.ParticipantIds.Count > 2))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Format(Loc["Group chat · {0} members"].Value, Channel.ParticipantIds.Count)</MudText>
                                }
                                else if (PrivacyService.ShouldHideMemberList(Channel, _currentUserObj))
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@(Channel.IsAnnouncementOnly ? Loc["Announcement channel"].Value : string.Format(Loc["{0} channel"].Value, Channel.ChannelType))</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Format(Loc["{0} channel"].Value, Channel.ChannelType)</MudText>
                                }
                            </div>
                        </div>
                    }
                    else
                    {
                        <div class="d-flex align-center gap-2">
                            <MudIcon Icon="@GetChannelIcon()" Size="Size.Medium" />
                            <div>
                                <MudText Typo="Typo.subtitle2"><b>@CurrentDisplayName</b></MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@string.Format(Loc["{0} channel"].Value, Channel!.ChannelType)</MudText>
                            </div>
                        </div>
                    }

                    @* Description *@
                    <div>
                        <div class="d-flex align-center justify-space-between mb-1">
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["DESCRIPTION"]</MudText>
                            @if (CanEditChannelInfo() && !_isEditingDescription)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="opacity: 0.4; font-size: 14px; cursor: pointer;" @onclick="StartEditingDescription" />
                            }
                        </div>
                        @if (_isEditingDescription)
                        {
                            <MudTextField @bind-Value="_editingDescription" Variant="Variant.Outlined" Margin="Margin.Dense" Lines="2"
                                Placeholder="@Loc["Channel description (optional)"]" Immediate="true" Class="ma-0" />
                            <div class="d-flex justify-end gap-2 mt-1">
                                <MudButton Size="Size.Small" OnClick="@(() => _isEditingDescription = false)">@Loc["Cancel"]</MudButton>
                                <MudButton Size="Size.Small" Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveDescription">@Loc["Save"]</MudButton>
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(Channel!.Description))
                        {
                            <MudText Typo="Typo.body2">@Channel.Description</MudText>
                        }
                        else if (CanEditChannelInfo())
                        {
                            <MudText Typo="Typo.caption" Style="opacity: 0.5; font-style: italic; cursor: pointer;" @onclick="StartEditingDescription">
                                @Loc["No description provided. Click to add one."]
                            </MudText>
                        }
                    </div>

                    @* Category *@
                    @{
                        bool supportsCategories = Channel!.ChannelType == ChatChannelType.General;
                    }
                    @if (supportsCategories)
                    {
                        if (CanEditChannelInfo())
                        {
                            <div class="d-flex align-end gap-2 mt-1">
                                <MudSelect Margin="Margin.Dense" T="string" Label="@Loc["Category"]" Value="@Channel!.CategoryId" ValueChanged="UpdateCategoryAsync"
                                    AnchorOrigin="Origin.BottomLeft" Variant="Variant.Outlined" Class="flex-grow-1 ma-0" Clearable="true"
                                        ToStringFunc="@(id => string.IsNullOrEmpty(id) ? Loc["None (Public)"].Value : _allCategories.FirstOrDefault(c => c.Id == id)?.Name ?? Loc["Unknown"].Value)">
                                    <MudSelectItem T="string" Value="@(null)">@Loc["None (Public)"]</MudSelectItem>
                                    @foreach (var cat in _allCategories)
                                    {
                                        <MudSelectItem T="string" Value="@cat.Id">@cat.Name</MudSelectItem>
                                    }
                                </MudSelect>
                                @if (CanManageCategories)
                                {
                                    <MudTooltip Text="@Loc["Manage Categories"]">
                                        <MudIconButton Icon="@Icons.Material.Filled.Settings" OnClick="OpenManageCategories" Class="mb-n1 pa-1" />
                                    </MudTooltip>
                                }
                            </div>
                        }
                        else if (!string.IsNullOrEmpty(Channel.CategoryId))
                        {
                            <div>
                                <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["CATEGORY"]</MudText>
                                <MudText Typo="Typo.body2">@(_allCategories.FirstOrDefault(c => c.Id == Channel.CategoryId)?.Name ?? Loc["Unknown"].Value)</MudText>
                            </div>
                        }
                    }

                    @* Created *@
                    <div>
                        <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["CREATED"]</MudText>
                        <MudText Typo="Typo.body2">
                            @string.Format(Loc["{0} by {1}"].Value, Channel.CreatedAt.ToLocalTime().ToString("MMM d, yyyy"), GetCreatorName())
                        </MudText>
                    </div>
                </div>
            </MudPaper>

            @* ──────── Announcement Channel Settings ──────── *@
            @if (Channel != null && Channel.SupportsAnnouncements && (CanEditChannelInfo() || Channel.IsAnnouncementOnly))
            {
                bool lockAnnouncement = Channel.IsPublicChannel && PrivacyService.GetPrivacyConfig().PublicChannels == Spokes_Server.Core.Configuration.PublicChannelPolicy.AnnouncementOnly;
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                    <div class="d-flex align-center justify-space-between my-1 ml-3 mr-1">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2">@Loc["Announcement Channel"]</MudText>
                        </div>
                        @if (CanEditChannelInfo())
                        {
                            <MudSwitch T="bool" Value="@Channel.IsAnnouncementOnly" ValueChanged="UpdateAnnouncementToggleAsync" Color="Color.Primary" Disabled="@lockAnnouncement" Class="ma-0" />
                        }
                    </div>
                    @if (lockAnnouncement)
                    {
                        <div class="px-3 pb-2">
                            <MudText Typo="Typo.caption" Color="Color.Info">@Loc["Public channels must remain announcement-only per server policy."]</MudText>
                        </div>
                    }
                    <MudDivider />
                    @if (Channel.IsAnnouncementOnly)
                    {
                        <div class="px-3 py-2 d-flex flex-column gap-2">
                            @if (CanEditChannelInfo())
                            {
                                <MudText Color="Color.Info" Typo="Typo.caption" Class="mb-1">@string.Format(Loc["Only specific users/{0} can post."].Value, AppLabels.Teams.ToLower())</MudText>
                                
                                <div class="d-flex align-center justify-space-between mb-n1">
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["ALLOWED"] @(AppLabels.Teams.ToUpper())</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Small" OnClick="@(() => _showAddPostTeam = !_showAddPostTeam)" Color="@(_showAddPostTeam ? Color.Primary : Color.Default)" Class="pa-1" />
                                </div>
                                @if (_showAddPostTeam)
                                {
                                    <TeamAutocomplete Margin="Margin.Dense" Label="@(string.Format(Loc["Add {0}..."].Value, AppLabels.Team.ToLower()))"
                                        ExcludedIds="@Channel.AllowedPostTeamIds" ValueChanged="AddPostTeamAsync" ResetOnSelect="true" Class="ma-0" />
                                }
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach(var teamId in Channel.AllowedPostTeamIds ?? new())
                                    {
                                        var team = Db.Teams.GetById(teamId);
                                        if (team != null)
                                        {
                                            <TeamChip Team="@team" OnClose="@(() => RemovePostTeamAsync(teamId))" Color="Color.Secondary" Size="Size.Small" />
                                        }
                                    }
                                </div>

                                <div class="d-flex align-center justify-space-between mb-n1 mt-1">
                                    <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["ALLOWED USERS"]</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small" OnClick="@(() => _showAddPostUser = !_showAddPostUser)" Color="@(_showAddPostUser ? Color.Primary : Color.Default)" Class="pa-1" />
                                </div>
                                @if (_showAddPostUser)
                                {
                                    <EmployeeAutocomplete Margin="Margin.Dense" Label="@Loc["Add user..."]" Employees="@Employees"
                                        ExcludedIds="@Channel.AllowedPostUserIds" ValueChanged="AddPostUserAsync" ResetOnSelect="true" Class="ma-0" />
                                }
                                <div class="d-flex flex-wrap gap-1">
                                    @foreach(var userId in Channel.AllowedPostUserIds ?? new())
                                    {
                                        var user = Employees.FirstOrDefault(u => u.Id == userId);
                                        if (user != null && !user.IsSystem)
                                        {
                                            <EmployeeChip Employee="@user" OnClose="@(() => RemovePostUserAsync(userId))" Size="Size.Small" />
                                        }
                                        else
                                        {
                                            <MudChip T="string" Color="Color.Default" Variant="Variant.Outlined" Size="Size.Small" OnClose="@(() => RemovePostUserAsync(userId))">
                                                @(user?.FullName ?? Loc["Deleted User"].Value)
                                            </MudChip>
                                        }
                                    }
                                </div>
                            }
                            else
                            {
                                <MudText Typo="Typo.body2">@Loc["Only authorized users can post."]</MudText>
                            }
                        </div>
                    }
                </MudPaper>
            }

            @* ──────── Audio Bitrate ──────── *@
            @if (Channel?.IsVoiceChannel == true)
            {
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                    <div class="d-flex align-center my-1 ml-3">
                        <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.subtitle2">@Loc["Voice Channel"]</MudText>
                    </div>
                    <MudDivider />
                    <div class="px-3 py-2">
                        @if (CanEditChannelInfo())
                        {
                            <MudSelect Margin="Margin.Dense" T="int" Label="@Loc["Audio Bitrate"]" Value="@(Channel?.AudioBitrateKbps ?? 96)" ValueChanged="UpdateAudioBitrateAsync"
                                AnchorOrigin="Origin.BottomLeft" Variant="Variant.Outlined" Class="ma-0">
                                <MudSelectItem Value="64">@Loc["64 kbps (Low)"]</MudSelectItem>
                                <MudSelectItem Value="96">@Loc["96 kbps (Standard)"]</MudSelectItem>
                                <MudSelectItem Value="128">@Loc["128 kbps (High)"]</MudSelectItem>
                                <MudSelectItem Value="256">@Loc["256 kbps (Very High)"]</MudSelectItem>
                                <MudSelectItem Value="384">@Loc["384 kbps (Extreme)"]</MudSelectItem>
                            </MudSelect>
                        }
                        else
                        {
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["AUDIO BITRATE"]</MudText>
                            <MudText Typo="Typo.body2">@(Channel?.AudioBitrateKbps ?? 96) @Loc["kbps"]</MudText>
                        }
                    </div>
                </MudPaper>
            }

            @* ──────── Encryption ──────── *@
            @{
                bool canEncrypt = CanEditChannelInfo() || (Channel!.ChannelType == ChatChannelType.Direct && Channel.CreatedById == CurrentUserId);
            }
            @if (Channel!.IsEncrypted || canEncrypt)
            {
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                    <div class="d-flex align-center my-1 ml-3">
                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.subtitle2">@Loc["Channel Encryption"]</MudText>
                    </div>
                    <MudDivider />
                    <div class="px-3 py-2">
                        @if (Channel.IsEncrypted)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Icon="@Icons.Material.Filled.Lock" Class="ma-0 pa-2">
                                @Loc["Encrypted channel."]
                            </MudAlert>
                            @if (canEncrypt)
                            {
                                <div class="d-flex justify-end mt-2">
                                    <MudButton StartIcon="@Icons.Material.Filled.SyncLock" 
                                               Color="Color.Default" 
                                               Variant="Variant.Text" 
                                               Size="Size.Small" 
                                               OnClick="SyncMediaEncryptionAsync" 
                                               Style="font-size: 0.75rem; text-transform: none;">
                                        @Loc["Sync Media Encryption"]
                                    </MudButton>
                                </div>
                            }
                        }
                        else if (canEncrypt)
                        {
                            <MudText Color="Color.Error" Typo="Typo.caption" Class="mb-2 d-block">@Loc["Not E2E encryption. Protects against db leaks."]</MudText>
                            <MudButton StartIcon="@Icons.Material.Filled.Lock" 
                                       Color="Color.Success" 
                                       Variant="Variant.Filled" 
                                       Size="Size.Small" 
                                       FullWidth="true" 
                                       OnClick="ConfirmEncryptionAsync">
                                @Loc["Enable Encryption"]
                            </MudButton>
                        }
                    </div>
                </MudPaper>
            }

            @* ──────── Access Control ──────── *@
            @if (Channel.ChannelType != ChatChannelType.Direct && Channel.ChannelType != ChatChannelType.Project)
            {
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                    <div class="d-flex align-center justify-space-between my-1 ml-3 mr-1">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Security" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2">@Loc["Access Control"]</MudText>
                        </div>
                    </div>
                    <MudDivider />
                    <div class="px-3 py-2">
                        @if (Channel.IsDefaultGeneral)
                        {
                            <MudAlert Severity="Severity.Info" Dense="true" Class="ma-0 pa-2">
                                @Loc["Public — Default organization channel (access cannot be restricted)."]
                            </MudAlert>
                        }
                        else if (!CanEditChannelInfo())
                        {
                            if (IsPublicChannel)
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" Color="Color.Primary" />
                                    <MudText Typo="Typo.body2">@Loc["Public (Everyone)"]</MudText>
                                </div>
                            }
                            else
                            {
                                <div class="d-flex align-center gap-2">
                                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Color="Color.Warning" />
                                    <MudText Typo="Typo.body2">@string.Format(Loc["Restricted ({0} {1}, {2} members)"].Value, Channel.AllowedTeamIds.Count, AppLabels.Teams.ToLower(), Channel.ParticipantIds.Count)</MudText>
                                </div>
                            }
                        }
                        else
                        {
                            <MudSelect Margin="Margin.Dense" T="string" Label="@Loc["Access Type"]" Value="@CurrentAccessType" ValueChanged="OnAccessTypeChanged"
                                       AnchorOrigin="Origin.BottomLeft" Variant="Variant.Outlined" Class="ma-0 mb-3">
                                <MudSelectItem Value="@("Public")">@Loc["Public (Everyone)"]</MudSelectItem>
                                <MudSelectItem Value="@("Restricted")">@string.Format(Loc["Restricted (Specific {0}/People)"].Value, AppLabels.Teams)</MudSelectItem>
                            </MudSelect>

                            @if (!IsPublicChannel)
                            {
                                @* Allowed Teams *@
                                <div class="mb-3">
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">@Loc["ALLOWED"] @(AppLabels.Teams.ToUpper()) (@Channel.AllowedTeamIds.Count)</MudText>
                                    </div>
                                    <TeamAutocomplete Label="@(string.Format(Loc["Add {0}..."].Value, AppLabels.Team.ToLower()))"
                                                      ExcludedIds="@Channel.AllowedTeamIds" ValueChanged="AddTeam"
                                                      ResetOnSelect="true" Margin="Margin.Dense" ShowProgressIndicator="true" Class="mb-2 ma-0" />
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var teamId in Channel.AllowedTeamIds)
                                        {
                                            var team = Db.Teams.GetById(teamId);
                                            if (team != null)
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                                         OnClose="@(() => RemoveTeam(teamId))">
                                                    @team.Name
                                                </MudChip>
                                            }
                                        }
                                    </div>
                                </div>

                                @* Allowed Members *@
                                <div>
                                    <div class="d-flex align-center justify-space-between mb-1">
                                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-weight: 600;">@Loc["ALLOWED MEMBERS"] (@Channel.ParticipantIds.Count)</MudText>
                                    </div>
                                    <EmployeeAutocomplete Label="@Loc["Add member..."]" Employees="@Employees"
                                                          ExcludedIds="@Channel.ParticipantIds" ValueChanged="AddMember"
                                                          ResetOnSelect="true" Margin="Margin.Dense" ShowProgressIndicator="true" Class="mb-2 ma-0" />
                                    <div class="d-flex flex-wrap gap-1">
                                        @foreach (var memberId in Channel.ParticipantIds)
                                        {
                                            var emp = Employees.FirstOrDefault(e => e.Id == memberId);
                                            if (emp != null && PrivacyService.CanDiscoverUser(_currentUserObj, emp))
                                            {
                                                <MudChip T="string" Size="Size.Small" Color="Color.Default" Variant="Variant.Outlined"
                                                         OnClose="@(() => RemoveMember(memberId))">
                                                    @emp.FullName
                                                </MudChip>
                                            }
                                        }
                                    </div>
                                </div>
                            }
                        }
                    </div>
                </MudPaper>
            }

            @* ──────── Teams / Members ──────── *@
            @if (IsTeamChannel)
            {
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                    <div class="d-flex align-center justify-space-between my-1 ml-3 mr-1">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2">@(AppLabels.Teams) (@_teams.Count)</MudText>
                        </div>
                        @if (IsOwner)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.GroupAdd" Size="Size.Small"
                                OnClick="@(() => _showAddTeam = !_showAddTeam)"
                                Color="@(_showAddTeam ? Color.Primary : Color.Default)" Class="pa-1" />
                        }
                    </div>
                    <MudDivider />
                    <div class="px-3 py-2">
                        @if (_showAddTeam && IsOwner)
                        {
                            <TeamAutocomplete Label="@(string.Format(Loc["Add {0}..."].Value, AppLabels.Team.ToLower()))"
                                ExcludedIds="@Channel.AllowedTeamIds" ValueChanged="AddTeam"
                                ResetOnSelect="true" Margin="Margin.Dense" ShowProgressIndicator="true" Class="mb-2 ma-0" />
                        }

                        <div class="d-flex flex-column gap-1">
                            @foreach (var team in _teams)
                            {
                                <div class="d-flex align-center gap-2 py-1">
                                    <TeamAvatar Team="@team" Size="Size.Small" UseIcon="true" Style="width: 24px; height: 24px; flex-shrink: 0;" />
                                    <MudText Typo="Typo.body2" Style="flex: 1;" Class="text-truncate">@team.Name</MudText>
                                    @if (IsOwner && _teams.Count > 1)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                            OnClick="@(() => RemoveTeam(team.Id))"
                                            Style="opacity: 0.4;" Class="pa-0" />
                                    }
                                </div>
                            }
                        </div>
                        
                        <div class="mt-2">
                            <MudText Typo="Typo.overline" Color="Color.Secondary" Style="line-height: 1.2;">@Loc["MEMBERS"] (@_members.Count)</MudText>
                            <div class="d-flex flex-column mt-1">
                                @foreach (var member in _members)
                                {
                                    var isLeader = IsMemberTeamLeader(member.Id);
                                    <div class="d-flex align-center gap-2 py-1">
                                        <EmployeeAvatar Employee="@member" Size="Size.Small" Style="width: 24px; height: 24px;" />
                                        <div style="flex: 1; min-width: 0;">
                                            <div class="d-flex align-center gap-1">
                                                <MudText Typo="Typo.body2" Class="text-truncate" Style="line-height: 1.2;">@member.FullName</MudText>
                                                @if (isLeader)
                                                {
                                                    <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                                        Style="font-size: 12px; color: #fbbf24;" Title="@Loc["Team Leader"]" />
                                                }
                                            </div>
                                            @if (!string.IsNullOrEmpty(member.Position))
                                            {
                                                <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1; display: block;">@member.Position</MudText>
                                            }
                                        </div>
                                    </div>
                                }
                            </div>
                        </div>
                    </div>
                </MudPaper>
            }
            else if (!PrivacyService.ShouldHideMemberList(Channel, _currentUserObj))
            {
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                    <div class="d-flex align-center justify-space-between my-1 ml-3 mr-1">
                        <div class="d-flex align-center">
                            <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" />
                            <MudText Typo="Typo.subtitle2">@Loc["Members"] (@_members.Count)</MudText>
                        </div>
                        @if (CanEditChannelInfo() && !IsPublicChannel && Channel.ChannelType != ChatChannelType.Project)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.PersonAdd" Size="Size.Small"
                                OnClick="@(() => _showAddMember = !_showAddMember)"
                                Color="@(_showAddMember ? Color.Primary : Color.Default)" Class="pa-1" />
                        }
                    </div>
                    <MudDivider />
                    <div class="px-3 py-2">
                        @if (_showAddMember && CanEditChannelInfo() && !IsPublicChannel && Channel.ChannelType != ChatChannelType.Project)
                        {
                            <EmployeeAutocomplete Label="@Loc["Add people..."]" Employees="@Employees"
                                ExcludedIds="@(Channel?.ParticipantIds ?? [])" ValueChanged="AddMember"
                                ResetOnSelect="true" Margin="Margin.Dense" ShowProgressIndicator="true" Class="mb-2 ma-0" />
                        }

                        <div class="d-flex flex-column gap-1">
                            @foreach (var member in _members)
                            {
                                var isCreator = member.Id == Channel?.CreatedById;
                                <div class="d-flex align-center gap-2 py-1">
                                    <EmployeeAvatar Employee="@member" Size="Size.Small" Style="width: 24px; height: 24px;" />
                                    <div style="flex: 1; min-width: 0;">
                                        <div class="d-flex align-center gap-1">
                                            <MudText Typo="Typo.body2" Class="text-truncate" Style="line-height: 1.2;">@member.FullName</MudText>
                                            @if (isCreator)
                                            {
                                                <MudIcon Icon="@Icons.Material.Filled.Star" Size="Size.Small"
                                                    Style="font-size: 12px; color: #fbbf24;" Title="@Loc["Group Owner"]" />
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(member.Position))
                                        {
                                            <MudText Typo="Typo.caption" Color="Color.Secondary" Style="line-height: 1; display: block;">@member.Position</MudText>
                                        }
                                    </div>
                                    @if (CanEditChannelInfo() && !IsPublicChannel && Channel?.ChannelType != ChatChannelType.Project && !isCreator && Channel?.ParticipantIds.Contains(member.Id) == true)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small"
                                            OnClick="@(() => RemoveMember(member.Id))"
                                            Style="opacity: 0.4;" Class="pa-0" />
                                    }
                                </div>
                            }
                        </div>
                    </div>
                </MudPaper>
            }

            @* ──────── Pinned Messages ──────── *@
            @if (_pinnedMessages.Any())
            {
                <MudPaper Elevation="0" Outlined="true" Class="rounded-lg overflow-hidden flex-shrink-0">
                    <div class="d-flex align-center my-1 ml-3">
                        <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.subtitle2">@Loc["Pinned Messages"] (@_pinnedMessages.Count)</MudText>
                    </div>
                    <MudDivider />
                    <div class="px-2 py-2 d-flex flex-column gap-1">
                        @foreach (var msg in _pinnedMessages)
                        {
                            var sender = Employees.FirstOrDefault(e => e.Id == msg.SenderId);
                            var senderName = sender?.FullName ?? Loc["Unknown"].Value;
                            var timeStr = msg.SentAt.ToLocalTime().ToString("MMM d, yyyy");
                            var content = string.IsNullOrEmpty(msg.Content)
                            ? Loc["[Attachment]"].Value
                            : (msg.IsEncrypted && DecryptedContents != null && DecryptedContents.TryGetValue(msg.Id, out var dec) ? dec : msg.Content);
                            content = System.Text.RegularExpressions.Regex.Replace(content, @"!\[gif\]\([^)]+\)|\[gif\]", Loc["Sent a GIF"].Value, System.Text.RegularExpressions.RegexOptions.IgnoreCase);
                            content = content.Length > 100 ? content.Substring(0, 97) + "..." : content;

                            <MudPaper Elevation="0" Class="pa-2"
                                Style="background: var(--mud-palette-background-grey); border-radius: 6px; cursor: pointer;"
                            @onclick="@(() => OnPinnedMessageClicked.InvokeAsync(msg.Id))">
                                <div class="d-flex align-center gap-1 mb-1">
                                    <MudIcon Icon="@Icons.Material.Filled.PushPin" Size="Size.Small" Color="Color.Warning"
                                        Style="font-size: 12px;" />
                                    <MudText Typo="Typo.caption" Style="font-weight: 600;">@senderName</MudText>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@timeStr</MudText>
                                </div>
                                <MudText Typo="Typo.body2" Color="Color.Secondary" Style="line-height: 1.2;">@content</MudText>
                            </MudPaper>
                        }
                    </div>
                </MudPaper>
            }

            @* ──────── Action Buttons ──────── *@
            @if ((IsGroupChannel && IsCurrentParticipant) || IsAdminOrCreator || CanDeleteChannel)
            {
                <div class="d-flex flex-column mt-2">
                    @if (IsGroupChannel && IsCurrentParticipant)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.ExitToApp"
                                   Color="Color.Error"
                                   Variant="Variant.Text"
                                   FullWidth="true"
                                   Size="Size.Small"
                                   Disabled="@IsChannelLocked"
                                   OnClick="LeaveGroup"
                                   Style="justify-content: flex-start;">
                            @Loc["Leave Group"]
                        </MudButton>
                    }
                    @if (IsAdminOrCreator && Channel?.ChannelType != ChatChannelType.Direct && Channel?.IsArchived == false)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Archive"
                                   Color="Color.Warning"
                                   Variant="Variant.Text"
                                   FullWidth="true"
                                   Size="Size.Small"
                                   Disabled="@IsChannelLocked"
                                   OnClick="ArchiveChannel"
                                   Style="justify-content: flex-start;">
                            @Loc["Archive Channel"]
                        </MudButton>
                    }
                    @if (CanDeleteChannel)
                    {
                        <MudButton StartIcon="@Icons.Material.Filled.Delete"
                                   Color="Color.Error"
                                   Variant="Variant.Text"
                                   FullWidth="true"
                                   Size="Size.Small"
                                   Disabled="@IsChannelLocked"
                                   OnClick="DeleteChannelAsync"
                                   Style="justify-content: flex-start;">
                            @Loc["Delete Channel"]
                        </MudButton>
                    }
                </div>
            }
        </div>
    }
</MudPaper>

@code {
    [Parameter] public ChatChannel? Channel { get; set; }
    [Parameter] public string DisplayName { get; set; } = "";
    [Parameter] public List<Employee> Employees { get; set; } = [];
    [Parameter] public Dictionary<string, string>? DecryptedContents { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<string> OnPinnedMessageClicked { get; set; }
    [Parameter] public EventCallback OnChannelUpdated { get; set; }
    [Parameter] public EventCallback OnLeaveGroup { get; set; }
    [Parameter] public EventCallback OnArchiveChannel { get; set; }
    [Parameter] public EventCallback OnDeleteChannel { get; set; }
    [Parameter] public EventCallback<string> OnRemoveMember { get; set; }

    private List<Employee> _members = [];
    private List<ChatMessage> _pinnedMessages = [];
    private List<ChatCategory> _allCategories = [];
    
    // Dynamic Display Name: Uses explicit Channel.Name if provided, otherwise falls back to generated DisplayName
    private string CurrentDisplayName =>
        (Channel?.ChannelType == ChatChannelType.Direct || string.IsNullOrWhiteSpace(Channel?.Name) || Channel?.Name == "Direct Message")
            ? DisplayName
            : (Channel?.Name ?? DisplayName);

    // Edit state
    private bool _isEditingName;
    private string _editingName = "";
    private bool _isEditingDescription;
    private string _editingDescription = "";
    private bool _showAddMember;

    // Team management state
    private List<Team> _teams = [];
    private bool _showAddTeam;

    // Announcement state
    private bool _showAddPostTeam;
    private bool _showAddPostUser;

    private bool IsChannelLocked => Channel?.IsEncrypted == true && !ScopedKeystore.IsUnlocked;
    private bool IsGroupChannel => Channel?.ChannelType == ChatChannelType.Group || 
                                   Channel?.ChannelType == ChatChannelType.Team ||
                                   (Channel?.ChannelType == ChatChannelType.Direct && (Channel?.ParticipantIds.Count ?? 0) > 2);
    private bool IsCurrentParticipant => !string.IsNullOrEmpty(CurrentUserId) && (Channel?.ParticipantIds.Contains(CurrentUserId) == true);
    private bool IsTeamChannel => Channel?.ChannelType == ChatChannelType.Team;
    private bool IsPublicChannel => Channel != null && 
                                   Channel.ChannelType == ChatChannelType.General && 
                                   (!Channel.AllowedTeamIds.Any()) && 
                                   (!Channel.ParticipantIds.Any());
    private string CurrentAccessType => IsPublicChannel ? "Public" : "Restricted";
    private bool IsDirectOrGroupChannel => Channel?.ChannelType == ChatChannelType.Direct || 
                                           Channel?.ChannelType == ChatChannelType.Group ||
                                           Channel?.ChannelType == ChatChannelType.Team;
    private bool IsOwner => IsTeamChannel ? IsCurrentUserTeamLeader() : (!string.IsNullOrEmpty(CurrentUserId) && Channel?.CreatedById == CurrentUserId);
    private Employee? _currentUserObj => Employees.FirstOrDefault(e => e.Id == CurrentUserId);
    private bool IsAdminOrCreator => !IsChannelLocked && ChatAuth.CanUserManageChannel(Channel, _currentUserObj, ScopedKeystore.IsUnlocked);
    private bool CanDeleteChannel => !IsChannelLocked && ChatAuth.CanUserDeleteChannel(Channel, _currentUserObj, ScopedKeystore.IsUnlocked);
    private bool CanManageCategories => _currentUserObj?.HasPermission(AppPermissions.Chat.CreateChannels) == true || _currentUserObj?.IsAdmin == true;

    private bool CanEditChannelInfo()
    {
        if (Channel?.IsArchived == true) return false;
        if (IsChannelLocked) return false;
        return ChatAuth.CanUserManageChannel(Channel, _currentUserObj, ScopedKeystore.IsUnlocked);
    }

    private bool CanManageAnnouncements => CanEditChannelInfo() && (Channel?.SupportsAnnouncements ?? false);

    private bool IsCurrentUserTeamLeader()
    {
        if (Channel == null || string.IsNullOrEmpty(CurrentUserId)) return false;
        return _teams.Any(t => t.LeaderId == CurrentUserId);
    }

    private bool IsMemberTeamLeader(string memberId)
    {
        return _teams.Any(t => t.LeaderId == memberId);
    }

    protected override void OnInitialized()
    {
        ScopedKeystore.OnUnlocked += HandleKeystoreChanged;
        ScopedKeystore.OnLocked += HandleKeystoreChanged;
    }

    private void HandleKeystoreChanged()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ScopedKeystore.OnUnlocked -= HandleKeystoreChanged;
        ScopedKeystore.OnLocked -= HandleKeystoreChanged;
    }

    protected override void OnParametersSet()
    {
        _allCategories = Db.ChatCategories.GetAll().Where(c => !c.IsSystem).OrderBy(c => c.DisplayOrder).ToList();
        LoadTeams();
        LoadMembers();
        LoadPinnedMessages();
        
        if (Channel != null && Channel.AllowedPostTeamIds == null) Channel.AllowedPostTeamIds = new();
        if (Channel != null && Channel.AllowedPostUserIds == null) Channel.AllowedPostUserIds = new();
        if (Channel != null && Channel.AllowedTeamIds == null) Channel.AllowedTeamIds = new();
        if (Channel != null && Channel.ParticipantIds == null) Channel.ParticipantIds = new();
    }

    // ──────── Access Control ────────

    private async Task OnAccessTypeChanged(string newType)
    {
        if (Channel == null || !CanEditChannelInfo() || Channel.IsDefaultGeneral) return;

        if (newType == "Public")
        {
            if (IsPublicChannel) return;

            var result = await DialogService.ShowMessageBoxAsync(
                Loc["Make Channel Public"].Value,
                string.Format(Loc["Are you sure you want to make this channel public? All {0} in the {1} will be able to view and participate."].Value, AppLabels.Employees.ToLowerInvariant(), AppLabels.Company.ToLowerInvariant()),
                yesText: Loc["Make Public"].Value, cancelText: Loc["Cancel"].Value);

            if (result != true) return;

            Channel.AllowedTeamIds.Clear();
            Channel.ParticipantIds.Clear();
            ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
            await OnChannelUpdated.InvokeAsync();
            LoadMembers();
            LoadTeams();
            Snackbar.Add(Loc["Channel is now public to all members"].Value, Severity.Success);
            StateHasChanged();
        }
        else if (newType == "Restricted")
        {
            if (!IsPublicChannel) return;

            // When switching to restricted, initialize with current user and/or creator so it's not empty (which would mean public)
            if (!string.IsNullOrEmpty(CurrentUserId) && !Channel.ParticipantIds.Contains(CurrentUserId))
            {
                Channel.ParticipantIds.Add(CurrentUserId);
            }
            if (!string.IsNullOrEmpty(Channel.CreatedById) && !Channel.ParticipantIds.Contains(Channel.CreatedById))
            {
                Channel.ParticipantIds.Add(Channel.CreatedById);
            }

            ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
            await OnChannelUpdated.InvokeAsync();
            LoadMembers();
            LoadTeams();
            Snackbar.Add(Loc["Channel is now restricted. You can add specific teams and members."].Value, Severity.Info);
            StateHasChanged();
        }
    }

    // ──────── Category Management ────────

    private async Task OpenManageCategories()
    {
        var dialog = await DialogService.ShowAsync<ManageCategoriesDialog>(Loc["Manage Categories"].Value);
        await dialog.Result;
        _allCategories = Db.ChatCategories.GetAll().Where(c => !c.IsSystem).OrderBy(c => c.DisplayOrder).ToList();
        StateHasChanged();
    }

    private async Task UpdateCategoryAsync(string? categoryId)
    {
        if (Channel == null || !CanEditChannelInfo()) return;
        Channel.CategoryId = categoryId;
        ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        await OnChannelUpdated.InvokeAsync();
        StateHasChanged();
    }

    private async Task UpdateAudioBitrateAsync(int bitrateKbps)
    {
        if (Channel == null || !CanEditChannelInfo()) return;
        Channel.AudioBitrateKbps = bitrateKbps;
        ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        await OnChannelUpdated.InvokeAsync();
        Snackbar.Add(string.Format(Loc["Audio bitrate set to {0} kbps"].Value, bitrateKbps), Severity.Success);
        StateHasChanged();
    }

    private async Task UpdateAnnouncementToggleAsync(bool isAnnouncement)
    {
        if (Channel == null || !CanManageAnnouncements) return;
        Channel.IsAnnouncementOnly = isAnnouncement;
        if (isAnnouncement)
        {
            Channel.IsVoiceChannel = false;
        }
        ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        await OnChannelUpdated.InvokeAsync();
        StateHasChanged();
    }

    private async Task AddPostTeamAsync(Team? team)
    {
        if (team == null || Channel == null || !CanManageAnnouncements) return;

        if (!Channel.AllowedPostTeamIds.Contains(team.Id))
        {
            Channel.AllowedPostTeamIds.Add(team.Id);
            ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
            await OnChannelUpdated.InvokeAsync();
        }

        StateHasChanged();
    }

    private async Task RemovePostTeamAsync(string teamId)
    {
        if (Channel == null || string.IsNullOrEmpty(teamId) || !CanManageAnnouncements) return;

        Channel.AllowedPostTeamIds.Remove(teamId);
        ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        await OnChannelUpdated.InvokeAsync();
        StateHasChanged();
    }

    private async Task AddPostUserAsync(Employee? user)
    {
        if (user == null || Channel == null || !CanManageAnnouncements) return;

        if (!Channel.AllowedPostUserIds.Contains(user.Id))
        {
            Channel.AllowedPostUserIds.Add(user.Id);
            ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
            await OnChannelUpdated.InvokeAsync();
        }

        StateHasChanged();
    }

    private async Task RemovePostUserAsync(string userId)
    {
        if (Channel == null || string.IsNullOrEmpty(userId) || !CanManageAnnouncements) return;

        Channel.AllowedPostUserIds.Remove(userId);
        ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        await OnChannelUpdated.InvokeAsync();
        StateHasChanged();
    }



    // ──────── Name & Icon Editing ────────

    private void StartEditingName()
    {
        if (!CanEditChannelInfo() || IsChannelLocked) return;
        _editingName = Channel?.Name ?? "";
        _isEditingName = true;
    }

    private async Task SaveName()
    {
        if (Channel == null || string.IsNullOrWhiteSpace(_editingName) || !CanEditChannelInfo() || IsChannelLocked) 
        {
            _isEditingName = false;
            return;
        }

        Channel.Name = _editingName.Trim();
        _isEditingName = false;
        ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        await OnChannelUpdated.InvokeAsync();
        Snackbar.Add(Loc["Channel name updated"].Value, Severity.Success);
    }

    private void StartEditingDescription()
    {
        if (!CanEditChannelInfo() || IsChannelLocked) return;
        _editingDescription = Channel?.Description ?? "";
        _isEditingDescription = true;
    }

    private async Task SaveDescription()
    {
        if (Channel == null || !CanEditChannelInfo() || IsChannelLocked) return;
        
        Channel.Description = _editingDescription?.Trim() ?? "";
        _isEditingDescription = false;
        ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        await OnChannelUpdated.InvokeAsync();
        Snackbar.Add(Loc["Channel description updated"].Value, Severity.Success);
    }

    private async Task PickIcon()
    {
        if (!CanEditChannelInfo() || IsChannelLocked) return;

        var dialog = await DialogService.ShowAsync<IconPicker>(Loc["Select Icon"].Value);
        var result = await dialog.Result;
        if (result != null && !result.Canceled && result.Data is string icon)
        {
            Channel!.Icon = icon;
            ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
            await OnChannelUpdated.InvokeAsync();
            StateHasChanged();
        }
    }

    // ──────── Add / Remove Members ────────

    private async Task AddMember(Employee? employee)
    {
        if (employee == null || Channel == null || !CanEditChannelInfo() || IsChannelLocked) return;

        bool added = false;
        lock (Channel)
        {
            if (!Channel.ParticipantIds.Contains(employee.Id))
            {
                var updated = new List<string>(Channel.ParticipantIds) { employee.Id };
                Channel.ParticipantIds = updated;
                added = true;
            }
        }

        if (added)
        {
            var updateResult = ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
            if (!updateResult.IsSuccess)
            {
                Snackbar.Add(updateResult.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
                return;
            }

            if (Channel.IsEncrypted && ScopedKeystore.IsUnlocked && !string.IsNullOrEmpty(CurrentUserId))
            {
                var privKey = ScopedKeystore.GetPrivateKey();
                if (privKey != null && Channel.EncryptedChannelKeys.TryGetValue(CurrentUserId, out var cipherKey))
                {
                    try
                    {
                        var chKey = Crypto.DecryptRsa(cipherKey, privKey);
                        _ = ChatSecurityService.ShareKeyOpportunisticallyAsync(Channel.Id, chKey);
                    }
                    catch { }
                }
            }

            await OnChannelUpdated.InvokeAsync();
            LoadMembers();
            Snackbar.Add(string.Format(Loc["Added {0} to the channel"].Value, employee.FullName), Severity.Success);
        }

        StateHasChanged();
    }

    private async Task RemoveMember(string memberId)
    {
        if (Channel == null || string.IsNullOrEmpty(memberId) || !CanEditChannelInfo() || IsChannelLocked) return;
        if (memberId == Channel.CreatedById && Channel.ChannelType != ChatChannelType.General) return; // Can't remove the creator of DM/group

        if (Channel.ChannelType == ChatChannelType.General && !Channel.AllowedTeamIds.Any() && Channel.ParticipantIds.Count <= 1)
        {
            Snackbar.Add(string.Format(Loc["A restricted channel must have at least one {0} or {1}. Switch access type to Public if you want everyone to access."].Value, AppLabels.Team.ToLowerInvariant(), AppLabels.Employee.ToLowerInvariant()), Severity.Warning);
            return;
        }

        lock (Channel)
        {
            var updated = new List<string>(Channel.ParticipantIds);
            updated.Remove(memberId);
            Channel.ParticipantIds = updated;
            if (Channel.IsEncrypted)
            {
                Channel.EncryptedChannelKeys.Remove(memberId);
            }
        }

        var updateResult = ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        if (!updateResult.IsSuccess)
        {
            Snackbar.Add(updateResult.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
            return;
        }

        await OnRemoveMember.InvokeAsync(memberId);
        LoadMembers();
        
        var emp = Employees.FirstOrDefault(e => e.Id == memberId);
        Snackbar.Add(string.Format(Loc["Removed {0} from the channel"].Value, emp?.FullName ?? AppLabels.Employee), Severity.Info);
        StateHasChanged();
    }

    private async Task LeaveGroup()
    {
        if (Channel == null || string.IsNullOrEmpty(CurrentUserId) || IsChannelLocked) return;

        lock (Channel)
        {
            var updated = new List<string>(Channel.ParticipantIds);
            updated.Remove(CurrentUserId);
            Channel.ParticipantIds = updated;

            if (Channel.IsEncrypted)
            {
                Channel.EncryptedChannelKeys.Remove(CurrentUserId);
            }

            // Transfer ownership if the creator is leaving
            if (Channel.CreatedById == CurrentUserId && Channel.ParticipantIds.Any())
            {
                Channel.CreatedById = Channel.ParticipantIds.First();
            }
        }

        var updateResult = ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        if (!updateResult.IsSuccess)
        {
            Snackbar.Add(updateResult.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
            return;
        }

        Snackbar.Add(Loc["You left the group"].Value, Severity.Info);
        await OnLeaveGroup.InvokeAsync();
    }

    private async Task ArchiveChannel()
    {
        if (Channel == null || !IsAdminOrCreator || IsChannelLocked) return;

        var result = await DialogService.ShowMessageBoxAsync(
            Loc["Archive Channel"].Value,
            Loc["Are you sure you want to archive this channel? It will be hidden from the sidebar."].Value,
            yesText: Loc["Archive"].Value, cancelText: Loc["Cancel"].Value);

        if (result == true)
        {
            await OnArchiveChannel.InvokeAsync();
        }
    }

    private async Task DeleteChannelAsync()
    {
        if (Channel == null || !CanDeleteChannel || IsChannelLocked) return;

        var result = await DialogService.ShowMessageBoxAsync(
            Loc["Delete Channel"].Value,
            Loc["Are you sure you want to permanently delete this channel and ALL of its messages?"].Value,
            yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value);

        if (result == true)
        {
            await OnDeleteChannel.InvokeAsync();
        }
    }

    // ──────── Add / Remove Teams ────────

    private async Task AddTeam(Team? team)
    {
        if (team == null || Channel == null || !CanEditChannelInfo() || IsChannelLocked) return;

        if (!Channel.AllowedTeamIds.Contains(team.Id))
        {
            Channel.AllowedTeamIds.Add(team.Id);
            var updateResult = ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
            if (!updateResult.IsSuccess)
            {
                Snackbar.Add(updateResult.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
                return;
            }

            if (Channel.IsEncrypted && ScopedKeystore.IsUnlocked && !string.IsNullOrEmpty(CurrentUserId))
            {
                var privKey = ScopedKeystore.GetPrivateKey();
                if (privKey != null && Channel.EncryptedChannelKeys.TryGetValue(CurrentUserId, out var cipherKey))
                {
                    try
                    {
                        var chKey = Crypto.DecryptRsa(cipherKey, privKey);
                        _ = ChatSecurityService.ShareKeyOpportunisticallyAsync(Channel.Id, chKey);
                    }
                    catch { }
                }
            }

            await OnChannelUpdated.InvokeAsync();
            LoadTeams();
            LoadMembers();
            Snackbar.Add(string.Format(Loc["Added {0} to the channel"].Value, team.Name), Severity.Success);
        }

        StateHasChanged();
    }

    private async Task RemoveTeam(string teamId)
    {
        if (Channel == null || string.IsNullOrEmpty(teamId) || !CanEditChannelInfo() || IsChannelLocked) return;
        if (IsTeamChannel && Channel.AllowedTeamIds.Count <= 1) return; // Must have at least one team for TeamChannel
        
        if (Channel.ChannelType == ChatChannelType.General && Channel.AllowedTeamIds.Count <= 1 && !Channel.ParticipantIds.Any())
        {
            Snackbar.Add(string.Format(Loc["A restricted channel must have at least one {0} or {1}. Switch access type to Public if you want everyone to access."].Value, AppLabels.Team.ToLowerInvariant(), AppLabels.Employee.ToLowerInvariant()), Severity.Warning);
            return;
        }

        Channel.AllowedTeamIds.Remove(teamId);
        var updateResult = ChatService.UpdateChannel(Channel, CurrentUserId, ScopedKeystore.IsUnlocked);
        if (!updateResult.IsSuccess)
        {
            Snackbar.Add(updateResult.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
            return;
        }

        await OnChannelUpdated.InvokeAsync();
        LoadTeams();
        LoadMembers();

        var team = Db.Teams.GetById(teamId);
        Snackbar.Add(string.Format(Loc["Removed {0} from the channel"].Value, team?.Name ?? AppLabels.Team.ToLowerInvariant()), Severity.Info);
        StateHasChanged();
    }

    private void LoadTeams()
    {
        _teams.Clear();
        if (Channel == null || !IsTeamChannel) return;

        foreach (var teamId in Channel.AllowedTeamIds)
        {
            var team = Db.Teams.GetById(teamId);
            if (team != null) _teams.Add(team);
        }
    }

    // ──────── Encryption ────────

    private async Task ConfirmEncryptionAsync()
    {
        if (Channel == null || !IsAdminOrCreator) return;

        if (_currentUserObj?.HasVaultPassword != true)
        {
            Snackbar.Add(Loc["You must enable Secure Chat and set a vault password before encrypting channels."].Value, Severity.Warning);
            return;
        }

        if (!ScopedKeystore.IsUnlocked)
        {
            var parameters = new DialogParameters { ["Employee"] = _currentUserObj };
            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };
            var dialog = await DialogService.ShowAsync<UnlockVaultDialog>(Loc["Unlock Secure Vault"].Value, parameters, options);
            var result = await dialog.Result;
            if (result == null || result.Canceled || !ScopedKeystore.IsUnlocked)
            {
                return;
            }
        }

        if (Channel.ChannelType == ChatChannelType.General || Channel.ChannelType == ChatChannelType.Project)
        {
            var result = await DialogService.ShowMessageBoxAsync(
                Loc["Encrypt Public Channel"].Value,
                Loc["Are you sure you want to encrypt this public channel? This action cannot be reversed."].Value,
                yesText: Loc["Encrypt"].Value, cancelText: Loc["Cancel"].Value);

            if (result != true) return;
        }

        await ConvertChannelToEncryptedAsync();
    }

    private async Task ConvertChannelToEncryptedAsync()
    {
        if (Channel == null || string.IsNullOrEmpty(CurrentUserId) || !IsAdminOrCreator) return;

        try
        {
            await ChatSecurityService.ToggleChannelEncryptionAsync(Channel.Id, true, CurrentUserId, ScopedKeystore.GetPrivateKey());
            Snackbar.Add(Loc["Channel converted to Encrypted successfully."].Value, Severity.Success);
            
            // Reload local state to reflect encryption UI changes
            Channel.IsEncrypted = true;
            await OnChannelUpdated.InvokeAsync();
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Failed to enable encryption: {0}"].Value, ex.Message), Severity.Error);
        }
    }

    private async Task SyncMediaEncryptionAsync()
    {
        if (Channel == null || string.IsNullOrEmpty(CurrentUserId) || !IsAdminOrCreator) return;

        if (_currentUserObj?.HasVaultPassword != true)
        {
            Snackbar.Add(Loc["You must enable Secure Chat and set a vault password first."].Value, Severity.Warning);
            return;
        }

        if (!ScopedKeystore.IsUnlocked)
        {
            var parameters = new DialogParameters { ["Employee"] = _currentUserObj };
            var options = new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true, CloseButton = true };
            var dialog = await DialogService.ShowAsync<UnlockVaultDialog>(Loc["Unlock Secure Vault"].Value, parameters, options);
            var result = await dialog.Result;
            if (result == null || result.Canceled || !ScopedKeystore.IsUnlocked)
            {
                return;
            }
        }

        try
        {
            await ChatSecurityService.ToggleChannelEncryptionAsync(Channel.Id, true, CurrentUserId, ScopedKeystore.GetPrivateKey());
            Snackbar.Add(Loc["Media encryption sync completed."].Value, Severity.Success);
            await OnChannelUpdated.InvokeAsync();
