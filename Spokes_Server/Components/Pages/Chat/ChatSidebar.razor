            RenderFragment<ChatCategory> directBlock = cat => @<text>
        @* Direct Messages (1-to-1 only) *@
        @{
            var directChannels = FilteredChannels.Where(c => c.ChannelType == ChatChannelType.Direct &&
            c.ParticipantIds.Count <= 2 && c.ParticipantIds.Any() &&
            (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id))
            .OrderBy(c => c.IsVoiceChannel ? 1 : 0)
            .ThenBy(c => GetChannelOrder(c)).ToList();
            bool directVoiceShown = false;
            int directUnread = directChannels.Sum(c => ChatNotifications.GetUnreadCount(c.Id));
