                @if (_reorderMode != ReorderMode.None)
                {
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveCategoryUp(cat))" Disabled="@IsFirstVisibleCategory(cat)" Class="pa-0 ml-1" />
                    <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveCategoryDown(cat))" Disabled="@IsLastVisibleCategory(cat)" Class="pa-0 ml-1" />
