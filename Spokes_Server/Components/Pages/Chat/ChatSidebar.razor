                    <div class="d-flex align-center px-3 mt-2 mb-1">
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                        <MudText Typo="Typo.caption" Class="px-2 flex-shrink-0" Style="color: var(--mud-palette-text-secondary); font-size: 0.65rem; font-weight: bold; letter-spacing: 0.5px;">VOICE CHANNELS</MudText>
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                    </div>
                    projectVoiceShown = true;
                }
                var unread = ChatNotifications.GetUnreadCount(channel.Id);
                var preview = GetChannelPreview(channel.Id);
                <MudListItem T="string" Dense="true" OnClick="@(() => OnChannelSelected.InvokeAsync(channel.Id))"
                    Class="@(SelectedChannelId == channel.Id ? "mud-primary-text" : "")">
                    <div class="d-flex gap-2 justify-space-between align-center" style="width: 100%;">
                        <div class="d-flex gap-2 flex-grow-1" style="min-width: 0; align-items: flex-start;">
                            <div style="padding-top: 2px;">
                            @if (!string.IsNullOrEmpty(channel.Icon))
                            {
                                <MudIcon Icon="@channel.Icon" Size="Size.Small" Color="Color.Primary" />
                            }
                            else if (channel.IsVoiceChannel)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Size="Size.Small" Color="Color.Primary" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Folder" Size="Size.Small" Color="Color.Primary" />
                            }
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="flex: 1;">
                                        @GetChannelDisplayName(channel)
                                        @if (channel.IsEncrypted)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-info);" />
                                        }
                                        @if (channel.IsAnnouncementOnly)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-success);" />
                                        }
                                    </MudText>
                                </div>
                                @if (channel.IsVoiceChannel)
                                {
                                    @RenderVoiceAvatars(channel.Id)
                                }
                                else if (!string.IsNullOrEmpty(preview))
                                {
                                    <MudText Typo="Typo.caption" Color="@(unread > 0 ? Color.Secondary : Color.Default)" Class="@($"text-truncate {(unread > 0 ? "" : "mud-text-secondary")}")" Style="display: block;">@preview</MudText>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-center gap-1">
                            @if (unread > 0)
                            {
                                <NotificationBadge Count="@unread" />
                            }
                            @if (_reorderMode != ReorderMode.None)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveChannelUp(channel, projectChannels))" Class="pa-0" />
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveChannelDown(channel, projectChannels))" Class="pa-0" />
                            }
                        </div>
                    </div>
                </MudListItem>
                }
            }
        }

            </text>;
            RenderFragment<ChatCategory> teamsBlock = cat => @<text>
        @* TEAMS Channels (restricted to teams - including auto-created team channels AND General channels with team
        restrictions) *@
        @{
            var teamChannels = FilteredChannels.Where(c =>
            (c.ChannelType == ChatChannelType.Team ||
            (c.ChannelType == ChatChannelType.General && c.AllowedTeamIds.Any())) &&
            (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id))
            .OrderBy(c => c.IsVoiceChannel ? 1 : 0)
            .ThenBy(c => GetChannelOrder(c)).ToList();
            bool teamVoiceShown = false;
        }
        @if (teamChannels.Any())
        {
            int teamsUnread = teamChannels.Sum(c => ChatNotifications.GetUnreadCount(c.Id));
            <div class="d-flex align-center justify-space-between px-3 pt-3">
                <div class="d-flex align-center" style="cursor: pointer; flex-grow: 1; user-select: none;" @onclick="() => { _teamsCollapsed = !_teamsCollapsed; SaveLocalPrefs(); }">
                    <MudIcon Icon="@(_teamsCollapsed ? Icons.Material.Filled.KeyboardArrowRight : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Style="color: var(--mud-palette-text-secondary); width: 18px; height: 18px; margin-right: 4px;" />
                    <MudText Typo="Typo.overline" Style="color: var(--mud-palette-text-secondary); text-transform: uppercase;">
                        @AppLabels.Team
                    </MudText>
                    @if (_teamsCollapsed && teamsUnread > 0)
                    {
                        <NotificationBadge Count="@teamsUnread" Small="true" Class="ml-2" />
                    }
                </div>
                <div class="d-flex align-center">
                    <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => OpenNewTeamChannelDialog())" />
                    @if (_reorderMode != ReorderMode.None)
                    {
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveCategoryUp(cat))" Disabled="@IsFirstVisibleCategory(cat)" Class="pa-0 ml-1" />
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveCategoryDown(cat))" Disabled="@IsLastVisibleCategory(cat)" Class="pa-0 ml-1" />
                    }
                </div>
            </div>
            @if (!_teamsCollapsed)
            {
                @foreach (var channel in teamChannels)
                {
                    if (channel.IsVoiceChannel && !teamVoiceShown)
                {
                    <div class="d-flex align-center px-3 mt-2 mb-1">
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                        <MudText Typo="Typo.caption" Class="px-2 flex-shrink-0" Style="color: var(--mud-palette-text-secondary); font-size: 0.65rem; font-weight: bold; letter-spacing: 0.5px;">VOICE CHANNELS</MudText>
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                    </div>
                    teamVoiceShown = true;
                }
                var unread = ChatNotifications.GetUnreadCount(channel.Id);
                var preview = GetChannelPreview(channel.Id);
                <MudListItem T="string" Dense="true" OnClick="@(() => OnChannelSelected.InvokeAsync(channel.Id))"
                    Class="@(SelectedChannelId == channel.Id ? "mud-primary-text" : "")">
                    <div class="d-flex gap-2 justify-space-between align-center" style="width: 100%;">
                        <div class="d-flex gap-2 flex-grow-1" style="min-width: 0; align-items: flex-start;">
                            <div style="padding-top: 2px;">
                            @if (!string.IsNullOrEmpty(channel.Icon))
                            {
                                <MudIcon Icon="@channel.Icon" Size="Size.Small" Color="Color.Secondary" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Groups" Size="Size.Small" Color="Color.Secondary" />
                            }
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="flex: 1;">
                                        @GetChannelDisplayName(channel)
                                        @if (channel.IsEncrypted)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-info);" />
                                        }
                                        @if (channel.IsAnnouncementOnly)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-success);" />
                                        }
                                    </MudText>
                                </div>
                                @if (channel.IsVoiceChannel)
                                {
                                    @RenderVoiceAvatars(channel.Id)
                                }
                                else if (!string.IsNullOrEmpty(preview))
                                {
                                    <MudText Typo="Typo.caption" Color="@(unread > 0 ? Color.Secondary : Color.Default)" Class="@($"text-truncate {(unread > 0 ? "" : "mud-text-secondary")}")" Style="display: block;">@preview</MudText>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-center gap-1">
                            @if (unread > 0)
                            {
                                <NotificationBadge Count="@unread" />
                            }
                            @if (_reorderMode != ReorderMode.None)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveChannelUp(channel, teamChannels))" Class="pa-0" />
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveChannelDown(channel, teamChannels))" Class="pa-0" />
                            }
                        </div>
                    </div>
                </MudListItem>
                }
            }
        }

            </text>;
            RenderFragment<ChatCategory> groupsBlock = cat => @<text>
        @* GROUP CHATS *@
        @{
            var groupChannels = FilteredChannels.Where(c =>
            (c.ChannelType == ChatChannelType.Group ||
            (c.ChannelType == ChatChannelType.Direct && c.ParticipantIds.Count > 2) ||
            (c.ChannelType == ChatChannelType.General && c.ParticipantIds.Any() && !c.AllowedTeamIds.Any())) &&
            (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id))
            .OrderBy(c => c.IsVoiceChannel ? 1 : 0)
            .ThenBy(c => GetChannelOrder(c)).ToList();
            bool groupVoiceShown = false;
        }
        @if (groupChannels.Any())
        {
            int groupsUnread = groupChannels.Sum(c => ChatNotifications.GetUnreadCount(c.Id));
