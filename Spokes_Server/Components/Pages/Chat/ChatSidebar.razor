    private async Task OpenChannelDialog(ChatChannel? existing, string? initialAccessType = null, string? categoryId = null)
    {
        if (existing?.IsEncrypted == true && !ScopedKeystore.IsUnlocked)
        {
            Snackbar.Add(Loc["Unlock secure chat to modify this channel."].Value, Severity.Warning);
            return;
        }

        var teams = Db.Teams.GetAll().OrderBy(t => t.Name).ToList();
        var employees = Db.Employees.GetAll().Where(e => e.IsActive).OrderBy(e => e.FullName).ToList();
        var userTeamIds = _currentUserObj != null ? ChatAuth.GetUserTeamIds(_currentUserObj) : [];
        var projects = _currentUserObj == null
            ? new List<Project>()
            : Db.Projects.GetAll()
                .Where(p => p.IsActive && ProjectAccessHelper.CanAccess(_currentUserObj, p, userTeamIds))
                .OrderBy(p => p.Name)
                .ToList();

        var parameters = new DialogParameters
            {
                ["AllTeams"] = teams,
                ["AllEmployees"] = employees,
                ["AllProjects"] = projects,
                ["ExistingChannel"] = existing,
                ["InitialAccessType"] = initialAccessType,
                ["InitialCategoryId"] = categoryId,
                ["CanManageCategories"] = CanReorder,
                ["CurrentUser"] = _currentUserObj
            };

        string title = existing == null ? Loc["Create New Channel"].Value : Loc["Edit Channel"].Value;
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateChannelDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateChannelDialog.ChannelCreationResult data)
        {
            ChatChannel channelToSave;

            if (existing == null)
            {
                if (data.IsEncrypted && !ScopedKeystore.IsUnlocked)
                {
                    Snackbar.Add(Loc["Your vault must be unlocked to enable encryption."].Value, Severity.Error);
                    return;
                }

                // Create New
                var participantIds = data.ParticipantIds ?? new();
                if (data.Type == ChatChannelType.Group && !string.IsNullOrEmpty(CurrentUserId) && !participantIds.Contains(CurrentUserId))
                {
                    participantIds.Add(CurrentUserId);
                }

                channelToSave = new ChatChannel
                    {
                        Name = data.Name,
                        Description = data.Description,
                        Icon = data.Icon,
                        CategoryId = data.CategoryId,
                        ChannelType = data.Type,
                        LinkedEntityId = data.LinkedEntityId,
                        AllowedTeamIds = data.AllowedTeamIds ?? new(),
                        ParticipantIds = participantIds,
                        CreatedById = CurrentUserId ?? string.Empty,
                        CreatedAt = DateTime.UtcNow,
                        IsVoiceChannel = data.IsVoiceChannel,
                        IsEncrypted = false,
                        AudioBitrateKbps = data.AudioBitrateKbps,
                        IsAnnouncementOnly = data.IsAnnouncementOnly,
                        AllowedPostUserIds = data.AllowedPostUserIds ?? new(),
                        AllowedPostTeamIds = data.AllowedPostTeamIds ?? new()
                    };
                if (data.IsEncrypted)
                {
                    try
                    {
                        ChatSecurityService.ValidateChannelEncryptionPrerequisites(channelToSave, ScopedKeystore.GetPrivateKey());
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add(ex.Message, Severity.Error);
                        return;
                    }
                }

                try
                {
                    ChatService.CreateChannel(channelToSave);
                }
                catch (Exception ex)
                {
                    Snackbar.Add(ex.Message, Severity.Error);
                    return;
                }
                
                if (data.IsEncrypted)
                {
                    try
                    {
                        await ChatSecurityService.ToggleChannelEncryptionAsync(channelToSave.Id, true, CurrentUserId!, ScopedKeystore.GetPrivateKey());
                    }
                    catch (Exception ex)
                    {
                        Db.ChatChannels.Delete(channelToSave.Id);
                        Snackbar.Add(ex.Message, Severity.Error);
                        return;
                    }
                }

                await OnChannelSelected.InvokeAsync(channelToSave.Id);
            }
            else
            {
                // Update Existing
                channelToSave = existing;
                var isEncryptionChanging = channelToSave.IsEncrypted != data.IsEncrypted;
                
                if (isEncryptionChanging && !ScopedKeystore.IsUnlocked)
                {
                    var msg = data.IsEncrypted
                        ? Loc["Your vault must be unlocked to enable encryption."].Value
                        : Loc["Your vault must be unlocked to disable encryption."].Value;
                    Snackbar.Add(msg, Severity.Error);
                    return;
                }

                channelToSave.Name = data.Name;
                channelToSave.Description = data.Description;
                channelToSave.Icon = data.Icon;
                channelToSave.CategoryId = data.CategoryId;
                if (!string.Equals(existing.ChannelType, ChatChannelType.Project, StringComparison.Ordinal))
                {
                    channelToSave.ChannelType = data.Type;
                    channelToSave.LinkedEntityId = data.LinkedEntityId;
                }
                channelToSave.AllowedTeamIds = data.AllowedTeamIds ?? new();
                channelToSave.ParticipantIds = data.ParticipantIds ?? new();
                channelToSave.IsArchived = data.IsArchived;
                channelToSave.IsVoiceChannel = data.IsVoiceChannel;
                channelToSave.AudioBitrateKbps = data.AudioBitrateKbps;
                channelToSave.IsAnnouncementOnly = data.IsAnnouncementOnly;
                channelToSave.AllowedPostUserIds = data.AllowedPostUserIds ?? new();
                channelToSave.AllowedPostTeamIds = data.AllowedPostTeamIds ?? new();

                if (isEncryptionChanging && data.IsEncrypted)
                {
                    try
                    {
                        ChatSecurityService.ValidateChannelEncryptionPrerequisites(channelToSave, ScopedKeystore.GetPrivateKey());
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add(ex.Message, Severity.Error);
                        return;
                    }
                }

                var updateResult = ChatService.UpdateChannel(channelToSave, CurrentUserId ?? string.Empty, ScopedKeystore.IsUnlocked);
                if (!updateResult.IsSuccess)
                {
                    Snackbar.Add(updateResult.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
                    return;
                }

                if (isEncryptionChanging)
                {
                    try
                    {
                        var privateKey = ScopedKeystore.GetPrivateKey();
                        await ChatSecurityService.ToggleChannelEncryptionAsync(channelToSave.Id, data.IsEncrypted, CurrentUserId!, privateKey);
                        var refreshed = Db.ChatChannels.GetById(channelToSave.Id);
                        if (refreshed != null)
                        {
                            channelToSave.IsEncrypted = refreshed.IsEncrypted;
                            channelToSave.EncryptedChannelKeys = refreshed.EncryptedChannelKeys;
                            channelToSave.CurrentKeyEpoch = refreshed.CurrentKeyEpoch;
                            channelToSave.EncryptedEpochKeys = refreshed.EncryptedEpochKeys;
                        }
                    }
                    catch (Exception ex)
                    {
                        Snackbar.Add(ex.Message, Severity.Error);
                        return;
                    }
                }
            }

            // Force refresh UI (Channel creation event usually handles it, but edit might need manual trigger if not handled)
            _forceRender = true;
            StateHasChanged();
        }
    }

    private bool CanManageChannel(ChatChannel channel)
    {
        var currentUserObj = Employees.FirstOrDefault(e => e.Id == CurrentUserId);
        return ChatAuth.CanUserManageChannel(channel, currentUserObj, isSessionUnlocked: true);
    }

    private async Task MoveChannelAsync(ChatChannel channel, List<ChatChannel> list, int delta)
    {
        var index = list.IndexOf(channel);
        var swapIndex = index + delta;
        if (index < 0 || swapIndex < 0 || swapIndex >= list.Count)
        {
            return;
        }

        if (_reorderMode == ReorderMode.Global)
        {
            if (!CanReorder) return;
            for (int i = 0; i < list.Count; i++) list[i].DisplayOrder = i;

            list[index].DisplayOrder = swapIndex;
            list[swapIndex].DisplayOrder = index;

            var updates = new Dictionary<string, int>
            {
                { list[index].Id, list[index].DisplayOrder },
                { list[swapIndex].Id, list[swapIndex].DisplayOrder }
            };

            await OnChannelOrdersChanged.InvokeAsync(updates);
        }
        else if (_reorderMode == ReorderMode.Personal && _currentUserObj is { IsActive: true, IsSuspended: false, IsBanned: false })
        {
            InitializeCustomOrderIfNeeded();
            for (int i = 0; i < list.Count; i++)
            {
                _currentUserObj.CustomChannelOrder[list[i].Id] = i;
            }
            int temp = _currentUserObj.CustomChannelOrder[channel.Id];
            _currentUserObj.CustomChannelOrder[channel.Id] = _currentUserObj.CustomChannelOrder[list[swapIndex].Id];
            _currentUserObj.CustomChannelOrder[list[swapIndex].Id] = temp;
            Db.Employees.Save(_currentUserObj);
            _forceRender = true;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task OpenNewDMDialog()
    {
        var parameters = new DialogParameters
            {
                ["Employees"] = Employees.Where(e => e.IsActive).OrderBy(e => e.FullName).ToList(),
                ["CurrentUserId"] = CurrentUserId
            };

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                Position = DialogPosition.TopCenter
            };

        var dialog = await DialogService.ShowAsync<NewDirectMessageDialog>(Loc["New Direct Message"].Value, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is (List<string> selectedUserIds, bool isEncrypted))
        {
            try
            {
                if (isEncrypted && !ScopedKeystore.IsUnlocked)
                {
                    Snackbar.Add(Loc["Your vault must be unlocked to enable encryption."].Value, Severity.Error);
                    return;
                }

                ChatChannel channel;
                if (selectedUserIds.Count == 1)
                {
                    channel = ChatService.CreateDirectMessageChannel(CurrentUserId!, selectedUserIds[0]);
                }
                else
                {
                    channel = ChatService.CreateGroupDirectMessageChannel(CurrentUserId!, selectedUserIds);
                }

                if (isEncrypted)
                {
                    await ChatSecurityService.ToggleChannelEncryptionAsync(channel.Id, true, CurrentUserId!, ScopedKeystore.GetPrivateKey());
                }

                // Refresh channels and navigate
                await OnChannelSelected.InvokeAsync(channel.Id);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private async Task OpenNewTeamChannelDialog()
    {
        var actor = _currentUserObj;
        if (actor == null ||
            !actor.IsActiveUnsuspended ||
            !actor.HasPermission(AppPermissions.Chat.Use) ||
            (!actor.IsAdmin && !actor.HasPermission(AppPermissions.Chat.CreateChannels)))
        {
            Snackbar.Add(Loc["Access Denied"].Value, Severity.Warning);
            return;
        }

        var allTeams = Db.Teams.GetAll().OrderBy(t => t.Name);
        var teams = actor.IsAdmin
            ? allTeams.ToList()
            : allTeams.Where(t => ChatAuth.GetUserTeamIds(actor).Contains(t.Id)).ToList();
        var parameters = new DialogParameters
            {
                ["Teams"] = teams,
                ["Employees"] = Employees,
                ["Label"] = AppLabels.Team
            };

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                Position = DialogPosition.TopCenter
            };

        var dialog = await DialogService.ShowAsync<NewTeamChannelDialog>(string.Format(Loc["New {0} Channel"].Value, AppLabels.Team), parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is (List<string> teamIds, bool isEncrypted))
        {
            try
            {
                if (isEncrypted && !ScopedKeystore.IsUnlocked)
                {
                    Snackbar.Add(Loc["Your vault must be unlocked to enable encryption."].Value, Severity.Error);
                    return;
                }

                var channel = ChatService.CreateTeamChannel(CurrentUserId!, teamIds);
                if (isEncrypted)
                {
                    await ChatSecurityService.ToggleChannelEncryptionAsync(channel.Id, true, CurrentUserId!, ScopedKeystore.GetPrivateKey());
                }
                await OnChannelSelected.InvokeAsync(channel.Id);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

    private RenderFragment RenderCategorySection(ChatCategory cat) => __builder =>
    {
        if (!IsCategoryVisible(cat))
        {
            return;
        }

        var spec = ChatSidebarCategoryResolver.GetSectionSpec(cat);
        var sectionChannels = ChatSidebarCategoryResolver.GetChannelsForCategory(
            cat,
            FilteredChannels,
            ArchivedChannels,
            GetChannelOrder,
            GetDirectChannelRecency);
        bool isCollapsed = IsCategoryCollapsed(cat.Id);
        int unreadTotal = sectionChannels.Sum(c => ChatNotifications.GetUnreadCount(c.Id));
        bool voiceDividerShown = false;

        if (spec.IsArchive)
        {
            <div class="d-flex align-center px-3 pt-3" style="cursor: pointer; user-select: none;" @onclick="() => ToggleCategoryCollapsed(cat.Id)">
                <MudIcon Icon="@(isCollapsed ? Icons.Material.Filled.KeyboardArrowRight : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Style="color: var(--mud-palette-text-secondary); width: 18px; height: 18px; margin-right: 4px;" />
                <MudText Typo="Typo.overline" Style="color: var(--mud-palette-text-secondary);">
                    @GetCategoryHeaderTitle(cat)
                </MudText>
                @if (isCollapsed && unreadTotal > 0)
                {
                    <NotificationBadge Count="@unreadTotal" Small="true" Class="ml-2" />
                }
            </div>
        }
        else
        {
            var headerStyle = spec.UppercaseHeader
                ? "color: var(--mud-palette-text-secondary); text-transform: uppercase;"
                : "color: var(--mud-palette-text-secondary);";
            var reorderBtnClass = spec.AddAction != ChatSidebarAddAction.None ? "pa-0 ml-1" : "pa-0";

            <div class="d-flex align-center justify-space-between px-3 @spec.HeaderPaddingClass">
                <div class="d-flex align-center" style="cursor: pointer; flex-grow: 1; user-select: none;" @onclick="() => ToggleCategoryCollapsed(cat.Id)">
                    <MudIcon Icon="@(isCollapsed ? Icons.Material.Filled.KeyboardArrowRight : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Style="color: var(--mud-palette-text-secondary); width: 18px; height: 18px; margin-right: 4px;" />
                    <MudText Typo="Typo.overline" Style="@headerStyle">
                        @GetCategoryHeaderTitle(cat)
                    </MudText>
                    @if (isCollapsed && unreadTotal > 0)
                    {
                        <NotificationBadge Count="@unreadTotal" Small="true" Class="ml-2" />
                    }
                </div>
                @if (spec.AddAction != ChatSidebarAddAction.None || (_reorderMode != ReorderMode.None && spec.CanReorderCategory))
                {
                    <div class="d-flex align-center">
                        @if (spec.AddAction == ChatSidebarAddAction.NewTeamChannel && CanCreateTeamChannel)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => OpenNewTeamChannelDialog())" />
                        }
                        else if (spec.AddAction == ChatSidebarAddAction.NewDirectMessage)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => OpenNewDMDialog())" Disabled="@(_currentUserObj?.IsSuspended == true)" />
                        }
                        @if (_reorderMode != ReorderMode.None && spec.CanReorderCategory)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveCategory(cat, -1))" Disabled="@IsFirstVisibleCategory(cat)" Class="@reorderBtnClass" />
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveCategory(cat, 1))" Disabled="@IsLastVisibleCategory(cat)" Class="@reorderBtnClass" />
                        }
                    </div>
                }
            </div>
        }

        if (!isCollapsed)
        {
            foreach (var channel in sectionChannels)
            {
                if (!spec.IsArchive && channel.IsVoiceChannel && !voiceDividerShown)
                {
                    <div class="d-flex align-center px-3 @spec.VoiceDividerMarginClass">
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                        <MudText Typo="Typo.caption" Class="px-2 flex-shrink-0" Style="color: var(--mud-palette-text-secondary); font-size: 0.65rem; font-weight: bold; letter-spacing: 0.5px;">@(spec.IsDirect ? Loc["VOICE CALLS"] : Loc["VOICE CHANNELS"])</MudText>
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                    </div>
                    voiceDividerShown = true;
                }

                @RenderChannelRow(channel, spec, sectionChannels)
            }
        }
    };

