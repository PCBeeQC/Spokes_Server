        <div class="d-flex align-center justify-space-between px-3 pt-3">
            <div class="d-flex align-center" style="cursor: pointer; flex-grow: 1; user-select: none;" @onclick="() => { _directCollapsed = !_directCollapsed; SaveLocalPrefs(); }">
