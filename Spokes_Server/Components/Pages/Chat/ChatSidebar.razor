                    <MudIcon Icon="@(_groupChatsCollapsed ? Icons.Material.Filled.KeyboardArrowRight : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Style="color: var(--mud-palette-text-secondary); width: 18px; height: 18px; margin-right: 4px;" />
                    <MudText Typo="Typo.overline" Style="color: var(--mud-palette-text-secondary);">
                        GROUP CHATS
                    </MudText>
