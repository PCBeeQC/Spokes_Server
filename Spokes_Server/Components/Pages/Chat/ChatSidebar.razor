@code {
    [Parameter] public List<ChatChannel> Channels { get; set; } = new();
    [Parameter] public string? SelectedChannelId { get; set; }
    [Parameter] public EventCallback<string> OnChannelSelected { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public List<Employee> Employees { get; set; } = new();
    [Parameter] public bool CanViewArchive { get; set; } = false;
    [Parameter] public EventCallback<ChatChannel> OnArchiveChannel { get; set; }
    [Parameter] public EventCallback<ChatChannel> OnUnarchiveChannel { get; set; }
    [Parameter] public EventCallback<Dictionary<string, int>> OnChannelOrdersChanged { get; set; }

    private string _searchText = string.Empty;

    private Dictionary<string, object> _inputAttributes = new()
    {
        { "autocomplete", "off" },
        { "data-lpignore", "true" },
        { "data-1p-ignore", "true" },
        { "data-bwignore", "true" },
        { "data-form-type", "other" }
    };

    private bool _globalEdit = false;

    private enum ReorderMode { None, Personal, Global }
    private ReorderMode _reorderMode = ReorderMode.None;

    private void SetReorderMode(ReorderMode mode)
    {
        if (mode == ReorderMode.Personal)
        {
            InitializeCustomOrderIfNeeded();
        }
        _reorderMode = mode;
    }

    private void InitializeCustomOrderIfNeeded()
    {
        if (_currentUserObj != null && !_currentUserObj.UsesCustomSidebarOrder)
        {
            var cats = Db.ChatCategories.GetAll().OrderBy(c => c.DisplayOrder).ToList();
            for (int i = 0; i < cats.Count; i++)
            {
                _currentUserObj.CustomCategoryOrder[cats[i].Id] = cats[i].Id == "sys_archive" ? 10000 : i;
            }

            var allChannels = Channels.OrderBy(c => c.DisplayOrder).ToList();
            for (int i = 0; i < allChannels.Count; i++)
            {
                _currentUserObj.CustomChannelOrder[allChannels[i].Id] = i;
            }

            _currentUserObj.UsesCustomSidebarOrder = true;
            Db.Employees.Save(_currentUserObj);
        }
    }

    private void ReattachToDefault()
    {
        if (_currentUserObj != null)
        {
            _currentUserObj.UsesCustomSidebarOrder = false;
            _currentUserObj.CustomCategoryOrder.Clear();
            _currentUserObj.CustomChannelOrder.Clear();
            Db.Employees.Save(_currentUserObj);
            _reorderMode = ReorderMode.None;
        }
    }

    private List<ChatCategory> GetAllCategoriesOrdered()
    {
        return Db.ChatCategories.GetAll().OrderBy(c => GetCategoryOrder(c)).ToList();
    }

    private bool IsCategoryVisible(ChatCategory cat)
    {
        if (cat.Id == "sys_public")
        {
            return FilteredChannels.Any(c =>
                c.ChannelType == ChatChannelType.General &&
                !c.AllowedTeamIds.Any() &&
                !c.ParticipantIds.Any() &&
                (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id));
        }
        if (cat.Id == "sys_projects")
        {
            return !IsFriendEdition && FilteredChannels.Any(c =>
                c.ChannelType == ChatChannelType.Project &&
                (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id));
        }
        if (cat.Id == "sys_teams")
        {
            return FilteredChannels.Any(c =>
                (c.ChannelType == ChatChannelType.Team ||
                (c.ChannelType == ChatChannelType.General && c.AllowedTeamIds.Any())) &&
                (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id));
        }
        if (cat.Id == "sys_groups")
        {
            return FilteredChannels.Any(c =>
                (c.ChannelType == ChatChannelType.Group ||
                (c.ChannelType == ChatChannelType.Direct && c.ParticipantIds.Count > 2) ||
                (c.ChannelType == ChatChannelType.General && c.ParticipantIds.Any() && !c.AllowedTeamIds.Any())) &&
                (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id));
        }
        if (cat.Id == "sys_direct")
        {
            return true;
        }
        if (cat.Id == "sys_archive")
        {
            return CanViewArchive && ArchivedChannels.Any();
        }
        if (!cat.IsSystem)
        {
            return FilteredChannels.Any(c => c.CategoryId == cat.Id);
        }
        return false;
    }

    private List<ChatCategory> GetVisibleCategories()
    {
        return GetAllCategoriesOrdered()
            .Where(c => c.Id != "sys_archive" && IsCategoryVisible(c))
            .ToList();
    }

    private bool IsFirstVisibleCategory(ChatCategory cat)
    {
        var visible = GetVisibleCategories();
        return visible.Count > 0 && visible[0].Id == cat.Id;
    }

    private bool IsLastVisibleCategory(ChatCategory cat)
    {
        var visible = GetVisibleCategories();
        return visible.Count > 0 && visible[^1].Id == cat.Id;
    }

    private int GetCategoryOrder(ChatCategory cat)
    {
        if (cat.Id == "sys_archive")
            return 10000;

        if (_reorderMode != ReorderMode.Global && _currentUserObj?.UsesCustomSidebarOrder == true)
        {
            if (_currentUserObj.CustomCategoryOrder.TryGetValue(cat.Id, out int order))
                return order;
            return cat.DisplayOrder + 1000;
        }
        return cat.DisplayOrder;
    }

    private int GetChannelOrder(ChatChannel chan)
    {
        if (_reorderMode != ReorderMode.Global && _currentUserObj?.UsesCustomSidebarOrder == true)
        {
            if (_currentUserObj.CustomChannelOrder.TryGetValue(chan.Id, out int order))
                return order;
            return chan.DisplayOrder + 1000;
        }
        return chan.DisplayOrder;
    }

    private void MoveCategoryUp(ChatCategory cat)
    {
        var visible = GetVisibleCategories();
        int vIdx = visible.FindIndex(c => c.Id == cat.Id);
        if (vIdx <= 0) return;

        var targetCat = visible[vIdx - 1];
        RepositionCategory(cat, targetCat, placeBefore: true);
    }

    private void MoveCategoryDown(ChatCategory cat)
    {
        var visible = GetVisibleCategories();
        int vIdx = visible.FindIndex(c => c.Id == cat.Id);
        if (vIdx < 0 || vIdx >= visible.Count - 1) return;

        var targetCat = visible[vIdx + 1];
        RepositionCategory(cat, targetCat, placeBefore: false);
    }

    private void RepositionCategory(ChatCategory cat, ChatCategory targetCat, bool placeBefore)
    {
        var allCats = GetAllCategoriesOrdered().Where(c => c.Id != "sys_archive").ToList();
        allCats.RemoveAll(c => c.Id == cat.Id);
        int targetIdx = allCats.FindIndex(c => c.Id == targetCat.Id);
        if (targetIdx < 0) return;

        int insertIdx = placeBefore ? targetIdx : targetIdx + 1;
        allCats.Insert(insertIdx, cat);

        var archiveCat = Db.ChatCategories.GetById("sys_archive");
        if (archiveCat != null)
        {
            allCats.Add(archiveCat);
        }

        PersistCategoryOrder(allCats);
        InvokeAsync(StateHasChanged);
    }

    private void PersistCategoryOrder(List<ChatCategory> allCats)
    {
        if (_reorderMode == ReorderMode.Global)
        {
            if (!CanReorder) return;
            for (int i = 0; i < allCats.Count; i++)
            {
                allCats[i].DisplayOrder = allCats[i].Id == "sys_archive" ? 10000 : i;
                Db.ChatCategories.Save(allCats[i]);
            }
        }
        else if (_reorderMode == ReorderMode.Personal && _currentUserObj != null)
        {
            InitializeCustomOrderIfNeeded();
            for (int i = 0; i < allCats.Count; i++)
            {
                _currentUserObj.CustomCategoryOrder[allCats[i].Id] = allCats[i].Id == "sys_archive" ? 10000 : i;
            }
            Db.Employees.Save(_currentUserObj);
        }
    }

    
    
    
    
    
    

    private async Task ToggleCustomCategory(string categoryId) {
        if (_currentUserObj == null) return;
        if (!_currentUserObj.ChatCustomCategoriesCollapsed.ContainsKey(categoryId)) {
            _currentUserObj.ChatCustomCategoriesCollapsed[categoryId] = true;
        } else {
            _currentUserObj.ChatCustomCategoriesCollapsed[categoryId] = !_currentUserObj.ChatCustomCategoriesCollapsed[categoryId];
        }
        SaveLocalPrefs();
    }

    
    
    
    
    private bool _publicCollapsed = false;
    private bool _projectsCollapsed = false;
    private bool _teamsCollapsed = false;
    private bool _groupChatsCollapsed = false;
    private bool _directCollapsed = false;
    private bool _archiveCollapsed = false;
    private bool _prefsLoaded = false;

    private Employee? _currentUserObj => Employees.FirstOrDefault(e => e.Id == CurrentUserId);
    private bool CanCreateChannel => _currentUserObj?.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Chat.CreateChannels) == true || _currentUserObj?.IsAdmin == true;
    private bool CanReorder => _currentUserObj?.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Chat.EditAllPublicChannels) == true || _currentUserObj?.IsAdmin == true;

    protected override void OnParametersSet()
    {
        if (_currentUserObj != null && !_prefsLoaded)
        {
            _publicCollapsed = _currentUserObj.ChatPublicCollapsed;
            _projectsCollapsed = _currentUserObj.ChatProjectsCollapsed;
            _teamsCollapsed = _currentUserObj.ChatTeamsCollapsed;
            _groupChatsCollapsed = _currentUserObj.ChatGroupChatsCollapsed;
            _directCollapsed = _currentUserObj.ChatDirectCollapsed;
            _archiveCollapsed = _currentUserObj.ChatArchiveCollapsed;
            _prefsLoaded = true;
        }
    }

    private void SaveLocalPrefs()
    {
        var user = _currentUserObj;
        if (user != null)
        {
            user.ChatPublicCollapsed = _publicCollapsed;
            user.ChatProjectsCollapsed = _projectsCollapsed;
            user.ChatTeamsCollapsed = _teamsCollapsed;
            user.ChatGroupChatsCollapsed = _groupChatsCollapsed;
            user.ChatDirectCollapsed = _directCollapsed;
            user.ChatArchiveCollapsed = _archiveCollapsed;
            Db.Employees.Save(user);
        }
    }

    private string GetChannelDisplayName(ChatChannel channel)
    {
        return ChatChannelFormatter.GetDisplayName(channel, CurrentUserId, Employees);
    }

    private bool MatchesSearch(ChatChannel c)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var name = GetChannelDisplayName(c);
        if (!string.IsNullOrEmpty(name) && name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private bool IsBlockedDM(ChatChannel c)
    {
        if (c.ChannelType != ChatChannelType.Direct || _currentUserObj == null) return false;
        var otherUserId = c.ParticipantIds.FirstOrDefault(id => id != CurrentUserId) ?? CurrentUserId;
        return otherUserId != CurrentUserId && _currentUserObj.BlockedUserIds.Contains(otherUserId);
    }

    private IEnumerable<ChatChannel> FilteredChannels => Channels.Where(c => !c.IsArchived && MatchesSearch(c) && !IsBlockedDM(c));

    private IEnumerable<ChatChannel> ArchivedChannels => Channels.Where(c => c.IsArchived && MatchesSearch(c));

    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";

    protected override void OnInitialized()
    {
        // Subscribe to unread count changes to re-render badges
        ChatNotifications.OnUnreadCountChanged += OnUnreadChanged;
        ChatState.VoiceMemberJoined += OnVoicePresenceChanged;
        ChatState.VoiceMemberLeft += OnVoicePresenceChanged;
        ChatState.VoiceActiveSpeakersChanged += OnVoiceSpeakersChanged;
    }

    private void OnUnreadChanged()
    {
        InvokeAsync(StateHasChanged);
    }
    
    private void OnVoicePresenceChanged(string channelId, string userId)
    {
        InvokeAsync(StateHasChanged);
    }
    
    private void OnVoiceSpeakersChanged(string channelId, string[] speakerIds)
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ChatNotifications.OnUnreadCountChanged -= OnUnreadChanged;
        ChatState.VoiceMemberJoined -= OnVoicePresenceChanged;
        ChatState.VoiceMemberLeft -= OnVoicePresenceChanged;
        ChatState.VoiceActiveSpeakersChanged -= OnVoiceSpeakersChanged;
    }

    private string FormatPreviewContent(string? rawContent, System.Collections.Generic.List<ChatAttachment>? attachments = null)
    {
        return Spokes_Server.Core.Helpers.ChatPreviewFormatter.FormatAndTruncatePreview(rawContent, attachments, 30);
    }

    private string? GetChannelPreview(string channelId)
    {
        var messages = Db.ChatMessages.GetByChannel(channelId, 10);
        var msg = messages.FirstOrDefault(m => _currentUserObj?.BlockedUserIds?.Contains(m.SenderId) != true);
        if (msg == null) return null;

        var sender = Employees.FirstOrDefault(e => e.Id == msg.SenderId);
        var senderName = sender?.FirstName ?? "Unknown";

        if (msg.IsEncrypted)
        {
            var channel = Db.ChatChannels.GetById(channelId);
            if (channel != null && CurrentUserId != null && ScopedKeystore.IsUnlocked)
            {
                var privKey = ScopedKeystore.GetPrivateKey();
                if (privKey != null && channel.EncryptedChannelKeys.TryGetValue(CurrentUserId, out var cipherChannelKey))
                {
                    try
                    {
                        var plainKey = Crypto.DecryptRsa(cipherChannelKey, privKey);
                        var plainContent = Crypto.DecryptAes(msg.Content, plainKey);
                        return $"{senderName}: {FormatPreviewContent(plainContent, msg.Attachments)}";
                    }
                    catch { }
                }
            }
            return $"{senderName}: 🔒 Locked Message";
        }

        return $"{senderName}: {FormatPreviewContent(msg.Content, msg.Attachments)}";
    }

    private async Task OpenCreateChannelDialog(string? initialAccessType = null, string? categoryId = null)
    {
        await OpenChannelDialog(null, initialAccessType, categoryId);
    }

    private async Task OpenChannelDialog(ChatChannel? existing, string? initialAccessType = null, string? categoryId = null)
    {
        var teams = Db.Teams.GetAll().OrderBy(t => t.Name).ToList();
        var employees = Db.Employees.GetAll().Where(e => e.IsActive).OrderBy(e => e.FullName).ToList();
        var projects = Db.Projects.GetAll().Where(p => p.IsActive).OrderBy(p => p.Name).ToList();

        var parameters = new DialogParameters
            {
                ["AllTeams"] = teams,
                ["AllEmployees"] = employees,
                ["AllProjects"] = projects,
                ["ExistingChannel"] = existing,
                ["InitialAccessType"] = initialAccessType,
                ["InitialCategoryId"] = categoryId,
                ["CanManageCategories"] = CanCreateChannel
            };

        string title = existing == null ? "Create New Channel" : "Edit Channel";
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<CreateChannelDialog>(title, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CreateChannelDialog.ChannelCreationResult data)
        {
            ChatChannel channelToSave;

            if (existing == null)
            {
                // Create New
                var participantIds = data.ParticipantIds ?? new();
                if (data.Type == ChatChannelType.Group && !string.IsNullOrEmpty(CurrentUserId) && !participantIds.Contains(CurrentUserId))
                {
                    participantIds.Add(CurrentUserId);
                }

                channelToSave = new ChatChannel
                    {
                        Name = data.Name,
                        Description = data.Description,
                        Icon = data.Icon,
                        CategoryId = data.CategoryId,
                        ChannelType = data.Type,
                        LinkedEntityId = data.LinkedEntityId,
                        AllowedTeamIds = data.AllowedTeamIds ?? new(),
                        ParticipantIds = participantIds,
                        CreatedById = CurrentUserId,
                        CreatedAt = DateTime.UtcNow,
                        IsVoiceChannel = data.IsVoiceChannel,
                        IsEncrypted = data.IsEncrypted,
                        AudioBitrateKbps = data.AudioBitrateKbps,
                        IsAnnouncementOnly = data.IsAnnouncementOnly,
                        AllowedPostUserIds = data.AllowedPostUserIds ?? new(),
                        AllowedPostTeamIds = data.AllowedPostTeamIds ?? new()
                    };
                await ChatService.CreateChannelAsync(channelToSave);
                
                if (data.IsEncrypted)
                {
                    await ChatService.ToggleChannelEncryptionAsync(channelToSave.Id, true, CurrentUserId!);
                }

                await OnChannelSelected.InvokeAsync(channelToSave.Id);
            }
            else
            {
                // Update Existing
                channelToSave = existing;
                var isEncryptionChanging = channelToSave.IsEncrypted != data.IsEncrypted;
                
                channelToSave.Name = data.Name;
                channelToSave.Description = data.Description;
                channelToSave.Icon = data.Icon;
                channelToSave.CategoryId = data.CategoryId;
                // Type/LinkedEntity usually shouldn't change for project channels, but for custom ones it might.
                // For simplicity, we update them.
                channelToSave.ChannelType = data.Type;
                channelToSave.LinkedEntityId = data.LinkedEntityId;
                channelToSave.AllowedTeamIds = data.AllowedTeamIds ?? new();
                channelToSave.ParticipantIds = data.ParticipantIds ?? new();
                channelToSave.IsArchived = data.IsArchived;
                channelToSave.IsVoiceChannel = data.IsVoiceChannel;
                channelToSave.IsEncrypted = data.IsEncrypted;
                channelToSave.AudioBitrateKbps = data.AudioBitrateKbps;
                channelToSave.IsAnnouncementOnly = data.IsAnnouncementOnly;
                channelToSave.AllowedPostUserIds = data.AllowedPostUserIds ?? new();
                channelToSave.AllowedPostTeamIds = data.AllowedPostTeamIds ?? new();

                if (isEncryptionChanging)
                {
                    if (!data.IsEncrypted && !ScopedKeystore.IsUnlocked)
                    {
                        Snackbar.Add("Your vault must be unlocked to disable encryption.", Severity.Error);
                        return;
                    }

                    var privateKey = !data.IsEncrypted ? ScopedKeystore.GetPrivateKey() : null;
                    await ChatService.ToggleChannelEncryptionAsync(channelToSave.Id, data.IsEncrypted, CurrentUserId!, privateKey);
                }
                
                // ToggleChannelEncryptionAsync handles its own UpdateChannelAsync, otherwise we do it here
                await ChatService.UpdateChannelAsync(channelToSave);
            }

            // Force refresh UI (Channel creation event usually handles it, but edit might need manual trigger if not handled)
            StateHasChanged();
        }
    }

    private bool CanManageChannel(ChatChannel channel)
    {
        var currentUserObj = Employees.FirstOrDefault(e => e.Id == CurrentUserId);
        if (currentUserObj == null) return false;

        // Dynamic owner rules (Channel Creator or Team Leader)
        if (channel.ChannelType == ChatChannelType.Team)
        {
            var teams = Db.Teams.GetAll();
            bool isLeader = teams.Any(t => channel.AllowedTeamIds.Contains(t.Id) && t.LeaderId == CurrentUserId);
            if (isLeader) return true;
        }
        else if (channel.CreatedById == CurrentUserId)
        {
            return true;
        }

        if (currentUserObj.IsAdmin == true)
            return true;
            
        // Check if user has permission to edit all public channels
        if (currentUserObj.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Chat.EditAllPublicChannels))
        {
            if (channel.ChannelType == ChatChannelType.General || channel.ChannelType == ChatChannelType.Project)
            {
                return true;
            }
        }
        return false;
    }

    private async Task MoveChannelUp(ChatChannel channel, List<ChatChannel> list)
    {
        var index = list.IndexOf(channel);
        if (index > 0)
        {
            if (_reorderMode == ReorderMode.Global)
            {
                if (!CanReorder) return;
                for (int i = 0; i < list.Count; i++) list[i].DisplayOrder = i;
                
                list[index].DisplayOrder = index - 1;
                list[index - 1].DisplayOrder = index;

                var updates = new Dictionary<string, int>
                {
                    { list[index].Id, list[index].DisplayOrder },
                    { list[index - 1].Id, list[index - 1].DisplayOrder }
                };
                
                await OnChannelOrdersChanged.InvokeAsync(updates);
            }
            else if (_reorderMode == ReorderMode.Personal && _currentUserObj != null)
            {
                InitializeCustomOrderIfNeeded();
                for (int i = 0; i < list.Count; i++) 
                {
                    _currentUserObj.CustomChannelOrder[list[i].Id] = i;
                }
                int temp = _currentUserObj.CustomChannelOrder[channel.Id];
                _currentUserObj.CustomChannelOrder[channel.Id] = _currentUserObj.CustomChannelOrder[list[index - 1].Id];
                _currentUserObj.CustomChannelOrder[list[index - 1].Id] = temp;
                Db.Employees.Save(_currentUserObj);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task MoveChannelDown(ChatChannel channel, List<ChatChannel> list)
    {
        var index = list.IndexOf(channel);
        if (index >= 0 && index < list.Count - 1)
        {
            if (_reorderMode == ReorderMode.Global)
            {
                if (!CanReorder) return;
                for (int i = 0; i < list.Count; i++) list[i].DisplayOrder = i;
                
                list[index].DisplayOrder = index + 1;
                list[index + 1].DisplayOrder = index;

                var updates = new Dictionary<string, int>
                {
                    { list[index].Id, list[index].DisplayOrder },
                    { list[index + 1].Id, list[index + 1].DisplayOrder }
                };
                
                await OnChannelOrdersChanged.InvokeAsync(updates);
            }
            else if (_reorderMode == ReorderMode.Personal && _currentUserObj != null)
            {
                InitializeCustomOrderIfNeeded();
                for (int i = 0; i < list.Count; i++) 
                {
                    _currentUserObj.CustomChannelOrder[list[i].Id] = i;
                }
                int temp = _currentUserObj.CustomChannelOrder[channel.Id];
                _currentUserObj.CustomChannelOrder[channel.Id] = _currentUserObj.CustomChannelOrder[list[index + 1].Id];
                _currentUserObj.CustomChannelOrder[list[index + 1].Id] = temp;
                Db.Employees.Save(_currentUserObj);
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task OpenNewDMDialog()
    {
        var parameters = new DialogParameters
            {
                ["Employees"] = Employees.Where(e => e.IsActive).OrderBy(e => e.FullName).ToList(),
                ["CurrentUserId"] = CurrentUserId
            };

        var options = new DialogOptions
            {
                CloseButton = true,
                MaxWidth = MaxWidth.Small,
                FullWidth = true,
                Position = DialogPosition.TopCenter
            };

        var dialog = await DialogService.ShowAsync<NewDirectMessageDialog>("New Direct Message", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is (List<string> selectedUserIds, bool isEncrypted))
        {
            try
            {
                ChatChannel channel;
                if (selectedUserIds.Count == 1)
                {
                    channel = await ChatService.CreateDirectMessageChannelAsync(CurrentUserId!, selectedUserIds[0], isEncrypted);
                }
                else
                {
                    channel = await ChatService.CreateGroupDirectMessageChannelAsync(CurrentUserId!, selectedUserIds, isEncrypted);
                }

                // Refresh channels and navigate
                await OnChannelSelected.InvokeAsync(channel.Id);
            }
            catch (Exception ex)
            {
                Snackbar.Add(ex.Message, Severity.Error);
            }
        }
    }

