@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.Communication.Chat.Formatters
@using Spokes_Server.Core.Services.Projects
@inject Database Db
@inject IDialogService DialogService
@inject ChatNotificationService ChatNotifications
@inject ChatService ChatService
@inject IChatAuthorizationService ChatAuth
@inject ChatSecurityService ChatSecurityService
@inject VoiceStateService VoiceState
@inject ScopedKeystoreService ScopedKeystore
@inject ICryptoService Crypto
@inject ISnackbar Snackbar
@inject AppLabelService AppLabels
@inject StartupTimingService StartupTimings
@inject GlobalVoiceService VoiceService
@inject IJSRuntime JS
@implements IDisposable
@implements IHandleEvent

@if (StartupTimings.IsChatProfilerEnabled)
{
    StartupTimings.AddChatTransition($"Server: RenderTree Sidebar[{_diagTag}] Markup Start");
}
<MudPaper Elevation="0" Style="height: 100%; display: flex; flex-direction: column;">
    <!-- Search & Actions -->
    <div class="pa-3 d-flex flex-column gap-2">
        <div class="d-flex gap-2 align-center">
            <MudTextField @bind-Value="_searchText" Placeholder="@Loc["Search channels..."]" Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search"
                DebounceInterval="500"
                Margin="Margin.Dense" Class="flex-grow-1" UserAttributes="@_inputAttributes" />
            <LazyMudMenu Icon="@Icons.Material.Filled.Sort" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Color="@(_reorderMode != ReorderMode.None ? Color.Primary : Color.Default)" ContentVersion="@HashCode.Combine(_reorderMode, _currentUserObj?.UsesCustomSidebarOrder ?? false, CanReorder)" Context="closeMenu">
                <MudListItem T="string" Class="mud-menu-item" OnClick="@(() => { closeMenu(); SetReorderMode(ReorderMode.Personal); })">@Loc["Reorder Channels"]</MudListItem>
                
                @if (_currentUserObj?.UsesCustomSidebarOrder == true)
                {
                    <MudListItem T="string" Class="mud-menu-item" OnClick="@(() => { closeMenu(); ReattachToDefault(); })">@Loc["Reattach to Default"]</MudListItem>
                }

                @if (CanReorder)
                {
                    <div class="d-flex align-center px-3 mt-1 mb-1 pointer-events-none">
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                        <MudText Typo="Typo.caption" Class="px-2 flex-shrink-0" Style="color: var(--mud-palette-text-secondary); font-size: 0.65rem; font-weight: bold; letter-spacing: 0.5px; text-transform: uppercase;">@Loc["Admin"]</MudText>
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                    </div>
                    <MudListItem T="string" Class="mud-menu-item" OnClick="@(() => { closeMenu(); SetReorderMode(ReorderMode.Global); })">@Loc["Modify Default Order"]</MudListItem>
                }
            </LazyMudMenu>
            @if (CanCreateChannel)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => OpenCreateChannelDialog())" />
            }
        </div>
        @if (_reorderMode != ReorderMode.None)
        {
            <div class="d-flex justify-center mt-1">
                <MudButton Variant="Variant.Filled" Color="@(_reorderMode == ReorderMode.Global ? Color.Secondary : Color.Primary)" 
                           OnClick="() => SetReorderMode(ReorderMode.None)" Size="Size.Small" FullWidth="true" Class="mx-2">
                    @Loc["Save Order"]
                </MudButton>
            </div>
        }
    </div>

    <!-- Channel List -->
    <div class="flex-grow-1 overflow-auto mt-n2" style="min-height: 0;">
        @foreach (var cat in GetAllCategoriesOrdered())
        {
            <div data-cat="@cat.Id" style="display: contents;">
                @RenderCategorySection(cat)
            </div>
        }
    </div>
</MudPaper>
@{
    _hasRenderedOnce = true;
    if (StartupTimings.IsChatProfilerEnabled)
    {
        StartupTimings.AddChatTransition($"Server: RenderTree Sidebar[{_diagTag}] Markup End");
    }
}

@code {
    [Parameter] public List<ChatChannel> Channels { get; set; } = [];
    [Parameter] public string? SelectedChannelId { get; set; }
    [Parameter] public EventCallback<string> OnChannelSelected { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public List<Employee> Employees { get; set; } = [];
    [Parameter] public bool CanViewArchive { get; set; }
    [Parameter] public EventCallback<ChatChannel> OnUnarchiveChannel { get; set; }
    [Parameter] public EventCallback<Dictionary<string, int>> OnChannelOrdersChanged { get; set; }
    [Parameter] public bool IsMobile { get; set; }

    private string _searchTextInternal = "";
    private string _searchText
    {
        get => _searchTextInternal;
        set
        {
            if (_searchTextInternal != value)
            {
                _searchTextInternal = value;
                _cachedVisibleCategories = null;
                _forceRender = true;
            }
        }
    }

    private Dictionary<string, object> _inputAttributes = new()
    {
        ["autocomplete"] = "off",
        ["data-lpignore"] = "true",
        ["data-1p-ignore"] = "true",
        ["data-bwignore"] = "true",
        ["data-form-type"] = "other"
    };

    private enum ReorderMode { None, Personal, Global }
    private ReorderMode _reorderMode = ReorderMode.None;

    private void SetReorderMode(ReorderMode mode)
    {
        _cachedVisibleCategories = null;
        if (mode == ReorderMode.Personal)
        {
            InitializeCustomOrderIfNeeded();
        }
        _reorderMode = mode;
        _forceRender = true;
    }

    private void InitializeCustomOrderIfNeeded()
    {
        if (_currentUserObj != null && !_currentUserObj.UsesCustomSidebarOrder)
        {
            var cats = Db.ChatCategories.GetAll().OrderBy(c => c.DisplayOrder).ToList();
            for (int i = 0; i < cats.Count; i++)
            {
                _currentUserObj.CustomCategoryOrder[cats[i].Id] = cats[i].Id == ChatSidebarCategoryResolver.ArchiveCategoryId ? 10000 : i;
            }

            var allChannels = Channels.Where(c => c.ChannelType != ChatChannelType.Direct).OrderBy(c => c.DisplayOrder).ToList();
            for (int i = 0; i < allChannels.Count; i++)
            {
                _currentUserObj.CustomChannelOrder[allChannels[i].Id] = i;
            }

            _currentUserObj.UsesCustomSidebarOrder = true;
            Db.Employees.Save(_currentUserObj);
        }
    }

    private void ReattachToDefault()
    {
        if (_currentUserObj != null)
        {
            _cachedVisibleCategories = null;
            _currentUserObj.UsesCustomSidebarOrder = false;
            _currentUserObj.CustomCategoryOrder.Clear();
            _currentUserObj.CustomChannelOrder.Clear();
            Db.Employees.Save(_currentUserObj);
            _reorderMode = ReorderMode.None;
            _forceRender = true;
        }
    }

    private List<ChatCategory> GetAllCategoriesOrdered()
    {
        return Db.ChatCategories.GetAll().OrderBy(c => GetCategoryOrder(c)).ToList();
    }

    private bool IsCategoryVisible(ChatCategory cat) =>
        ChatSidebarCategoryResolver.IsCategoryVisible(
            cat,
            FilteredChannels,
            ArchivedChannels,
            IsFriendEdition,
            CanCreateTeamChannel,
            CanViewArchive);

    private List<ChatCategory>? _cachedVisibleCategories;
    private List<ChatCategory> GetVisibleCategories()
    {
        return _cachedVisibleCategories ??= GetAllCategoriesOrdered()
            .Where(c => c.Id != ChatSidebarCategoryResolver.ArchiveCategoryId && IsCategoryVisible(c))
            .ToList();
    }

    private bool IsFirstVisibleCategory(ChatCategory cat)
    {
        var visible = GetVisibleCategories();
        return visible.Count > 0 && visible[0].Id == cat.Id;
    }

    private bool IsLastVisibleCategory(ChatCategory cat)
    {
        var visible = GetVisibleCategories();
        return visible.Count > 0 && visible[^1].Id == cat.Id;
    }

    private int GetCategoryOrder(ChatCategory cat)
    {
        if (cat.Id == ChatSidebarCategoryResolver.ArchiveCategoryId)
            return 10000;

        if (_reorderMode != ReorderMode.Global && _currentUserObj?.UsesCustomSidebarOrder == true)
        {
            if (_currentUserObj.CustomCategoryOrder.TryGetValue(cat.Id, out int order))
                return order;
            return cat.DisplayOrder + 1000;
        }
        return cat.DisplayOrder;
    }

    private int GetChannelOrder(ChatChannel chan)
    {
        if (chan.ChannelType == ChatChannelType.Direct)
            return 0;

        if (_reorderMode != ReorderMode.Global && _currentUserObj?.UsesCustomSidebarOrder == true)
        {
            if (_currentUserObj.CustomChannelOrder.TryGetValue(chan.Id, out int order))
                return order;
            return chan.DisplayOrder + 1000;
        }
        return chan.DisplayOrder;
    }

    private void MoveCategory(ChatCategory cat, int delta)
    {
        var visible = GetVisibleCategories();
        int vIdx = visible.FindIndex(c => c.Id == cat.Id);
        int targetVisibleIdx = vIdx + delta;
        if (vIdx < 0 || targetVisibleIdx < 0 || targetVisibleIdx >= visible.Count) return;

        RepositionCategory(cat, visible[targetVisibleIdx], placeBefore: delta < 0);
    }

    private void RepositionCategory(ChatCategory cat, ChatCategory targetCat, bool placeBefore)
    {
        var allCats = GetAllCategoriesOrdered().Where(c => c.Id != ChatSidebarCategoryResolver.ArchiveCategoryId).ToList();
        allCats.RemoveAll(c => c.Id == cat.Id);
        int targetIdx = allCats.FindIndex(c => c.Id == targetCat.Id);
        if (targetIdx < 0) return;

        int insertIdx = placeBefore ? targetIdx : targetIdx + 1;
        allCats.Insert(insertIdx, cat);

        var archiveCat = Db.ChatCategories.GetById(ChatSidebarCategoryResolver.ArchiveCategoryId);
        if (archiveCat != null)
        {
            allCats.Add(archiveCat);
        }

        _cachedVisibleCategories = null;
        PersistCategoryOrder(allCats);
        _forceRender = true;
        InvokeAsync(StateHasChanged);
    }

    private void PersistCategoryOrder(List<ChatCategory> allCats)
    {
        if (_reorderMode == ReorderMode.Global)
        {
            if (!CanReorder) return;
            var orders = new Dictionary<string, int>(StringComparer.Ordinal);
            for (int i = 0; i < allCats.Count; i++)
            {
                orders[allCats[i].Id] = allCats[i].Id == ChatSidebarCategoryResolver.ArchiveCategoryId ? 10000 : i;
            }
            var orderResult = ChatService.UpdateCategoryOrders(orders, CurrentUserId ?? string.Empty);
            if (!orderResult.IsSuccess)
            {
                Snackbar.Add(orderResult.ErrorMessage ?? Loc["Failed to update category order."].Value, Severity.Error);
            }
        }
        else if (_reorderMode == ReorderMode.Personal && _currentUserObj != null)
        {
            InitializeCustomOrderIfNeeded();
            for (int i = 0; i < allCats.Count; i++)
            {
                _currentUserObj.CustomCategoryOrder[allCats[i].Id] = allCats[i].Id == ChatSidebarCategoryResolver.ArchiveCategoryId ? 10000 : i;
            }
            Db.Employees.Save(_currentUserObj);
        }
    }

    private string GetCategoryHeaderTitle(ChatCategory cat) => cat.Id switch
    {
        ChatSidebarCategoryResolver.PublicCategoryId => Loc["PUBLIC"].Value,
        ChatSidebarCategoryResolver.ProjectsCategoryId => BizLoc["Projects"].Value.ToUpper(),
        ChatSidebarCategoryResolver.TeamsCategoryId => AppLabels.Team,
        ChatSidebarCategoryResolver.GroupsCategoryId => Loc["GROUP CHATS"].Value,
        ChatSidebarCategoryResolver.DirectCategoryId => Loc["DIRECT MESSAGES"].Value,
        ChatSidebarCategoryResolver.ArchiveCategoryId => Loc["Archived"].Value.ToUpper(),
        _ => cat.Name
    };

    private bool IsCategoryCollapsed(string categoryId) => categoryId switch
    {
        ChatSidebarCategoryResolver.PublicCategoryId => _publicCollapsed,
        ChatSidebarCategoryResolver.ProjectsCategoryId => _projectsCollapsed,
        ChatSidebarCategoryResolver.TeamsCategoryId => _teamsCollapsed,
        ChatSidebarCategoryResolver.GroupsCategoryId => _groupChatsCollapsed,
        ChatSidebarCategoryResolver.DirectCategoryId => _directCollapsed,
        ChatSidebarCategoryResolver.ArchiveCategoryId => _archiveCollapsed,
        _ => _currentUserObj?.ChatCustomCategoriesCollapsed?.TryGetValue(categoryId, out var collapsed) == true && collapsed
    };

    private void ToggleCategoryCollapsed(string categoryId)
    {
        switch (categoryId)
        {
            case ChatSidebarCategoryResolver.PublicCategoryId:
                _publicCollapsed = !_publicCollapsed;
                break;
            case ChatSidebarCategoryResolver.ProjectsCategoryId:
                _projectsCollapsed = !_projectsCollapsed;
                break;
            case ChatSidebarCategoryResolver.TeamsCategoryId:
                _teamsCollapsed = !_teamsCollapsed;
                break;
            case ChatSidebarCategoryResolver.GroupsCategoryId:
                _groupChatsCollapsed = !_groupChatsCollapsed;
                break;
            case ChatSidebarCategoryResolver.DirectCategoryId:
                _directCollapsed = !_directCollapsed;
                break;
            case ChatSidebarCategoryResolver.ArchiveCategoryId:
                _archiveCollapsed = !_archiveCollapsed;
                break;
            default:
                if (_currentUserObj == null) return;
                _currentUserObj.ChatCustomCategoriesCollapsed[categoryId] =
                    !(_currentUserObj.ChatCustomCategoriesCollapsed.TryGetValue(categoryId, out var current) && current);
                break;
        }

        SaveLocalPrefs();
        _forceRender = true;
    }

    
    
    
    
    private bool _publicCollapsed = false;
    private bool _projectsCollapsed = false;
    private bool _teamsCollapsed = false;
    private bool _groupChatsCollapsed = false;
    private bool _directCollapsed = false;
    private bool _archiveCollapsed = false;
    private bool _prefsLoaded = false;

    private Dictionary<string, Employee> _employeeLookup = new();

    private string GetEmployeeFirstName(string senderId)
    {
        if (_employeeLookup.TryGetValue(senderId, out var emp))
        {
            return emp.FirstName ?? emp.FullName ?? "Unknown";
        }
        var sender = Employees.FirstOrDefault(e => e.Id == senderId);
        return sender?.FirstName ?? "Unknown";
    }

    private Employee? _currentUserObj => Employees.FirstOrDefault(e => e.Id == CurrentUserId);
    private bool CanCreateChannel => _currentUserObj is { IsActive: true, IsSuspended: false, IsBanned: false } u &&
                                     u.HasPermission(AppPermissions.Chat.Use) &&
                                     (u.HasPermission(AppPermissions.Chat.CreateChannels) || u.IsAdmin);
    private bool CanCreateTeamChannel => CanCreateChannel &&
                                         (_currentUserObj!.IsAdmin || ChatAuth.GetUserTeamIds(_currentUserObj).Count > 0);
    private bool CanReorder => _currentUserObj is { IsActive: true, IsSuspended: false, IsBanned: false } u &&
                               u.HasPermission(AppPermissions.Chat.Use) &&
                               (u.HasPermission(AppPermissions.Chat.EditAllPublicChannels) || u.IsAdmin);

    private bool _hasRenderedOnce;
    private bool _forceRender = true;
    private int _lastRenderFingerprint;
    private bool _suppressEventAutoRender;

    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem item, object? arg)
    {
        _suppressEventAutoRender = false;
        var task = item.InvokeAsync(arg);
        if (!task.IsCompletedSuccessfully)
        {
            await task;
        }
        if (!_suppressEventAutoRender)
        {
            StateHasChanged();
        }
    }

    private Task HandleChannelRowClickAsync(ChatChannel channel)
    {
        // Let the parent Chat/ShareModal push the updated SelectedChannelId in a single unified pass
        // instead of queuing a premature ChatSidebar render before OnParametersSet runs.
        _suppressEventAutoRender = true;

        if (string.Equals(SelectedChannelId, channel.Id, StringComparison.Ordinal))
        {
            // Disconnected voice channels and channels with unread badges still invoke parent selection.
            bool shouldReconnectVoice = channel.IsVoiceChannel && !VoiceService.IsInVoiceCall && !VoiceService.IsConnecting;
            bool hasUnread = ChatNotifications.GetUnreadCount(channel.Id) > 0;
            if (!shouldReconnectVoice && !hasUnread)
            {
                return Task.CompletedTask;
            }
        }

        return OnChannelSelected.InvokeAsync(channel.Id);
    }

    private int ComputeSidebarFingerprint()
    {
        var hash = new HashCode();
        hash.Add(SelectedChannelId, StringComparer.Ordinal);
        hash.Add(CurrentUserId, StringComparer.Ordinal);
        hash.Add(CanViewArchive);
        hash.Add(IsMobile);
        hash.Add(_searchTextInternal, StringComparer.Ordinal);
        hash.Add(_reorderMode);
        hash.Add(_publicCollapsed);
        hash.Add(_projectsCollapsed);
        hash.Add(_teamsCollapsed);
        hash.Add(_groupChatsCollapsed);
        hash.Add(_directCollapsed);
        hash.Add(_archiveCollapsed);
        hash.Add(ScopedKeystore.IsUnlocked);
        hash.Add(VoiceService.IsInVoiceCall);
        hash.Add(VoiceService.CurrentChannelId, StringComparer.Ordinal);
        hash.Add(VoiceService.IsMuted);

        var currentUser = _currentUserObj;
        var blockedUserIds = currentUser?.BlockedUserIds;
        hash.Add(currentUser?.UsesCustomSidebarOrder ?? false);
        hash.Add(blockedUserIds?.Count ?? 0);
        if (currentUser?.ChatCustomCategoriesCollapsed != null)
        {
            hash.Add(currentUser.ChatCustomCategoriesCollapsed.Count);
            foreach (var kvp in currentUser.ChatCustomCategoriesCollapsed)
            {
                hash.Add(kvp.Key, StringComparer.Ordinal);
                hash.Add(kvp.Value);
            }
        }

        var categories = Db.ChatCategories.GetAll();
        hash.Add(categories.Count);
        foreach (var cat in categories)
        {
            hash.Add(cat.Id, StringComparer.Ordinal);
            hash.Add(cat.Name, StringComparer.Ordinal);
            hash.Add(cat.DisplayOrder);
        }

        hash.Add(Channels.Count);
        foreach (var c in Channels)
        {
            hash.Add(c.Id, StringComparer.Ordinal);
            hash.Add(c.Name, StringComparer.Ordinal);
            hash.Add(c.Icon, StringComparer.Ordinal);
            hash.Add(c.CategoryId, StringComparer.Ordinal);
            hash.Add(c.ChannelType, StringComparer.Ordinal);
            hash.Add(c.DisplayOrder);
            hash.Add(c.IsArchived);
            hash.Add(c.IsEncrypted);
            hash.Add(c.IsAnnouncementOnly);
            hash.Add(c.IsVoiceChannel);
            hash.Add(c.LastActivityAt.Ticks);
            hash.Add(c.ParticipantIds.Count);
            hash.Add(ChatNotifications.GetUnreadCount(c.Id));

            var preview = Db.ChatMessages.GetChannelPreviewSummary(c.Id, blockedUserIds);
            hash.Add(preview?.MessageId, StringComparer.Ordinal);
            hash.Add(preview?.PreviewText, StringComparer.Ordinal);

            if (c.IsVoiceChannel)
            {
                int count = 0;
                foreach (var uid in VoiceState.GetVoiceParticipants(c.Id))
                {
                    hash.Add(uid, StringComparer.Ordinal);
                    count++;
                }
                hash.Add(count);

                count = 0;
                foreach (var uid in VoiceState.GetMutedUsers(c.Id))
                {
                    hash.Add(uid, StringComparer.Ordinal);
                    count++;
                }
                hash.Add(count);
            }
        }

        hash.Add(Employees.Count);
        foreach (var emp in Employees)
        {
            hash.Add(emp.Id, StringComparer.Ordinal);
            hash.Add(emp.FullName, StringComparer.Ordinal);
            hash.Add(emp.HasCustomAvatar);
            hash.Add(emp.AvatarVersion);
            hash.Add(emp.IsActive);
            hash.Add(emp.IsSuspended);
            hash.Add(emp.IsBanned);
        }

        return hash.ToHashCode();
    }

    protected override bool ShouldRender()
    {
        if (!_hasRenderedOnce)
        {
            _hasRenderedOnce = true;
            _forceRender = false;
            _lastRenderFingerprint = ComputeSidebarFingerprint();
            return true;
        }
        if (IsMobile && !string.IsNullOrEmpty(SelectedChannelId))
        {
            return false;
        }

        var fingerprint = ComputeSidebarFingerprint();
        if (_forceRender)
        {
            _forceRender = false;
            _lastRenderFingerprint = fingerprint;
            return true;
        }

        if (fingerprint == _lastRenderFingerprint)
        {
            return false;
        }

        _lastRenderFingerprint = fingerprint;
        return true;
    }

    protected override void OnParametersSet()
    {
        if (_hasRenderedOnce && IsMobile && !string.IsNullOrEmpty(SelectedChannelId))
        {
            return;
        }

        if (_hasRenderedOnce && !_forceRender && ComputeSidebarFingerprint() == _lastRenderFingerprint)
        {
            return;
        }

        var lookup = new Dictionary<string, Employee>();
        foreach (var emp in Employees)
        {
            if (!string.IsNullOrEmpty(emp.Id))
            {
                lookup[emp.Id] = emp;
            }
        }
        _employeeLookup = lookup;
        _cachedVisibleCategories = null;

        if (_currentUserObj != null && !_prefsLoaded)
        {
            _publicCollapsed = _currentUserObj.ChatPublicCollapsed;
            _projectsCollapsed = _currentUserObj.ChatProjectsCollapsed;
            _teamsCollapsed = _currentUserObj.ChatTeamsCollapsed;
            _groupChatsCollapsed = _currentUserObj.ChatGroupChatsCollapsed;
            _directCollapsed = _currentUserObj.ChatDirectCollapsed;
            _archiveCollapsed = _currentUserObj.ChatArchiveCollapsed;
            _prefsLoaded = true;
        }

        if (StartupTimings.IsChatProfilerEnabled)
        {
            StartupTimings.AddChatTransition($"Server: ChatSidebar[{_diagTag}] OnParametersSet Done (Channels: {Channels.Count}, Employees: {Employees.Count})");
        }
    }

    private void SaveLocalPrefs()
    {
        var user = _currentUserObj;
        if (user is { IsActive: true, IsSuspended: false, IsBanned: false })
        {
            user.ChatPublicCollapsed = _publicCollapsed;
            user.ChatProjectsCollapsed = _projectsCollapsed;
            user.ChatTeamsCollapsed = _teamsCollapsed;
            user.ChatGroupChatsCollapsed = _groupChatsCollapsed;
            user.ChatDirectCollapsed = _directCollapsed;
            user.ChatArchiveCollapsed = _archiveCollapsed;
            Db.Employees.Save(user);
        }
    }

    private string GetChannelDisplayName(ChatChannel channel)
    {
        return ChatChannelFormatter.GetDisplayName(channel, CurrentUserId, Employees);
    }

    private bool MatchesSearch(ChatChannel c)
    {
        if (string.IsNullOrWhiteSpace(_searchText))
            return true;

        var name = GetChannelDisplayName(c);
        if (!string.IsNullOrEmpty(name) && name.Contains(_searchText, StringComparison.OrdinalIgnoreCase))
            return true;

        return false;
    }

    private bool IsBlockedDM(ChatChannel c)
    {
        if (c.ChannelType != ChatChannelType.Direct || _currentUserObj == null || string.IsNullOrEmpty(CurrentUserId)) return false;
        var otherUserId = c.ParticipantIds.FirstOrDefault(id => id != CurrentUserId) ?? CurrentUserId;
        return otherUserId != CurrentUserId && !string.IsNullOrEmpty(otherUserId) && _currentUserObj.BlockedUserIds.Contains(otherUserId);
    }

    private IEnumerable<ChatChannel> FilteredChannels => Channels.Where(c => !c.IsArchived && MatchesSearch(c) && !IsBlockedDM(c));

    private IEnumerable<ChatChannel> ArchivedChannels => Channels.Where(c => c.IsArchived && MatchesSearch(c));

    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";

    protected override void OnInitialized()
    {
        StartupTimings.Add($"Server: ChatSidebar[{_diagTag}] OnInitialized"); // DIAG-TEMP tag
        // Subscribe to unread count changes to re-render badges
        ChatNotifications.OnUnreadCountChanged += RequestRefreshIfVisible;
        VoiceState.VoiceMemberJoined += OnVoicePresenceChanged;
        VoiceState.VoiceMemberLeft += OnVoicePresenceChanged;
        VoiceState.VoiceActiveSpeakersChanged += OnVoiceSpeakersChanged;
        VoiceState.VoiceUserMutedChanged += OnVoiceMutedChanged;
        VoiceService.OnChange += RequestRefreshIfVisible;
        ScopedKeystore.OnUnlocked += RequestRefreshIfVisible;
        ScopedKeystore.OnLocked += RequestRefreshIfVisible;
    }

    private bool IsHiddenOnMobile => IsMobile && !string.IsNullOrEmpty(SelectedChannelId);

    private void RequestRefreshIfVisible()
    {
        if (IsHiddenOnMobile) return;
        // Let ShouldRender()'s ComputeSidebarFingerprint() gate whether any sidebar-visible state
        // (unread badges, voice presence/speakers/mute, vault lock) actually changed.
        InvokeAsync(StateHasChanged);
    }

    private void OnVoicePresenceChanged(string channelId, string userId) => RequestRefreshIfVisible();

    private void OnVoiceSpeakersChanged(string channelId, string[] speakerIds)
    {
        if (IsHiddenOnMobile || string.IsNullOrEmpty(channelId))
        {
            return;
        }

        // GlobalVoiceService owns the authoritative (locally-filtered) speaker set for the active call channel.
        if (VoiceService.IsInVoiceCall && string.Equals(VoiceService.CurrentChannelId, channelId, StringComparison.Ordinal))
        {
            return;
        }

        if (!Channels.Any(c => c.IsVoiceChannel && string.Equals(c.Id, channelId, StringComparison.Ordinal)))
        {
            return;
        }

        _ = SyncSidebarChannelSpeakersAsync(channelId, speakerIds ?? Array.Empty<string>());
    }

    private async Task SyncSidebarChannelSpeakersAsync(string channelId, string[] speakerIds)
    {
        try
        {
            await InvokeAsync(async () =>
            {
                await JS.InvokeVoidAsync("spokesVoiceSpeaking.syncChannel", channelId, (object)speakerIds);
            });
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException) { }
    }

    private void OnVoiceMutedChanged(string channelId, string userId, bool isMuted) => RequestRefreshIfVisible();

    private readonly string _diagTag = Guid.NewGuid().ToString("N")[..4]; // DIAG-TEMP

    public void Dispose()
    {
        StartupTimings.AddChatTransition($"Server: ChatSidebar[{_diagTag}] Dispose"); // DIAG-TEMP
        ChatNotifications.OnUnreadCountChanged -= RequestRefreshIfVisible;
        VoiceState.VoiceMemberJoined -= OnVoicePresenceChanged;
        VoiceState.VoiceMemberLeft -= OnVoicePresenceChanged;
        VoiceState.VoiceActiveSpeakersChanged -= OnVoiceSpeakersChanged;
        VoiceState.VoiceUserMutedChanged -= OnVoiceMutedChanged;
        VoiceService.OnChange -= RequestRefreshIfVisible;
        ScopedKeystore.OnUnlocked -= RequestRefreshIfVisible;
        ScopedKeystore.OnLocked -= RequestRefreshIfVisible;
    }

    private string FormatPreviewContent(string? rawContent, System.Collections.Generic.List<ChatAttachment>? attachments = null)
    {
        return ChatPreviewFormatter.FormatAndTruncatePreview(rawContent, attachments, 30);
    }

    private readonly Dictionary<string, (string MessageId, string Text)> _decryptedPreviewCache = new();

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        _hasRenderedOnce = true;
        if (firstRender)
        {
            StartupTimings.Add($"Server: ChatSidebar[{_diagTag}] OnAfterRenderAsync Start"); // DIAG-TEMP tag
            Dictionary<string, string[]>? initialSpeakers = null;
            foreach (var c in Channels)
            {
                if (!c.IsVoiceChannel) continue;
                var speakers = VoiceState.GetActiveSpeakers(c.Id);
                if (speakers.Length > 0)
                {
                    (initialSpeakers ??= new Dictionary<string, string[]>(StringComparer.Ordinal))[c.Id] = speakers;
                }
            }
            if (initialSpeakers is { Count: > 0 })
            {
                try
                {
                    await JS.InvokeVoidAsync("spokesVoiceSpeaking.syncChannels", initialSpeakers);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or JSException) { }
            }
        }
    }

    private DateTime GetDirectChannelRecency(ChatChannel channel)
    {
        var preview = Db.ChatMessages.GetChannelPreviewSummary(channel.Id, _currentUserObj?.BlockedUserIds);
        if (preview != null && preview.SentAt != default)
        {
            return preview.SentAt > channel.LastActivityAt ? preview.SentAt : channel.LastActivityAt;
        }
        return channel.LastActivityAt != default ? channel.LastActivityAt : (channel.CreatedAt != default ? channel.CreatedAt : DateTime.MinValue);
    }

    private string? GetChannelPreview(string channelId)
    {
        var preview = Db.ChatMessages.GetChannelPreviewSummary(channelId, _currentUserObj?.BlockedUserIds);
        if (preview == null) return null;

        var senderName = GetEmployeeFirstName(preview.SenderId);

        if (preview.IsEncrypted)
        {
            if (ScopedKeystore.IsUnlocked && CurrentUserId != null)
            {
                if (_decryptedPreviewCache.TryGetValue(channelId, out var cached) && cached.MessageId == preview.MessageId)
                {
                    return $"{senderName}: {cached.Text}";
                }

                var channel = Channels.FirstOrDefault(c => c.Id == channelId) ?? Db.ChatChannels.GetById(channelId);
                var privKey = ScopedKeystore.GetPrivateKey();
                ChatMessage? fullMsg = null;
                int previewEpoch = 0;
                if (channel != null && channel.CurrentKeyEpoch > 0)
                {
                    fullMsg = Db.ChatMessages.GetById(preview.MessageId) ?? Db.ChatMessages.GetMessageFromDisk(channelId, preview.MessageId);
                    previewEpoch = fullMsg?.KeyEpoch ?? channel.CurrentKeyEpoch;
                }
                if (channel != null && privKey != null && channel.TryGetEncryptedKeyForEpoch(previewEpoch, CurrentUserId, out var cipherChannelKey))
                {
                    string? cipherContent = null;
                    try
                    {
                        cipherContent = preview.EncryptedContent;
                        if (cipherContent == null)
                        {
                            fullMsg ??= Db.ChatMessages.GetLatestInChannel(channelId);
                            cipherContent = fullMsg?.Content;
                        }

                        if (!string.IsNullOrEmpty(cipherContent))
                        {
                            var plainKey = Crypto.DecryptRsa(cipherChannelKey, privKey);
                            var plainContent = Crypto.DecryptAes(cipherContent, plainKey);
                            var formatted = FormatPreviewContent(plainContent, preview.Attachments);
                            _decryptedPreviewCache[channelId] = (preview.MessageId, formatted);
                            return $"{senderName}: {formatted}";
                        }
                    }
                    catch 
                    {
                        if (!string.IsNullOrEmpty(cipherContent) && !ChatSecurityService.IsPotentialBase64Cipher(cipherContent))
                        {
                            var formatted = FormatPreviewContent(cipherContent, preview.Attachments);
                            _decryptedPreviewCache[channelId] = (preview.MessageId, formatted);
                            return $"{senderName}: {formatted}";
                        }
                    }
                }
            }
            return $"{senderName}: 🔒 Locked Message";
        }

        var snippet = preview.PreviewText;
        return string.IsNullOrEmpty(snippet) ? null : $"{senderName}: {snippet}";
    }

    private async Task OpenCreateChannelDialog(string? initialAccessType = null, string? categoryId = null)
    {
