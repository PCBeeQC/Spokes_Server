                        <div style="flex: 1; min-width: 0;">
                            <div class="d-flex align-center gap-1">
                                <MudText Typo="Typo.body2" Class="text-truncate" Style="flex: 1;">
                                    @GetChannelDisplayName(channel)
                                    @if (channel.IsEncrypted)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-info);" />
                                    }
                                    @if (channel.IsAnnouncementOnly)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-success);" />
                                    }
                                </MudText>
                            </div>
                            @if (channel.IsVoiceChannel)
                            {
                                @RenderVoiceAvatars(channel.Id)
                            }
                            else if (!string.IsNullOrEmpty(preview))
                            {
                                <MudText Typo="Typo.caption" Color="@(unread > 0 ? Color.Secondary : Color.Default)" Class="@($"text-truncate {(unread > 0 ? "" : "mud-text-secondary")}")" Style="display: block;">@preview</MudText>
                            }
                        </div>
                    </div>
                    <div class="d-flex align-center gap-1">
                        @if (unread > 0)
                        {
                            <NotificationBadge Count="@unread" />
                        }
                        @if (_reorderMode != ReorderMode.None && spec.CanReorderChannels)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveChannelAsync(channel, sectionChannels, -1))" Class="pa-0" />
                            <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveChannelAsync(channel, sectionChannels, 1))" Class="pa-0" />
                        }
                    </div>
                </div>
            </div>
        </div>
    };

    private RenderFragment RenderVoiceAvatars(string channelId) => __builder =>
    {
        var activeUsers = VoiceState.GetVoiceParticipants(channelId);
        if (activeUsers.Any())
        {
            var mutedUsers = VoiceState.GetMutedUsers(channelId);
            <div class="voice-user-list" style="margin-top: 4px;">
                @foreach (var uid in activeUsers)
                {
                    var u = (_employeeLookup.TryGetValue(uid, out var cachedEmp) ? cachedEmp : null) ?? Db.Employees.GetById(uid);
                    if (u is { IsActive: true, IsBanned: false, IsSystem: false })
                    {
                        var isMuted = (uid == VoiceService.CurrentUserId && VoiceService.IsInVoiceCall && VoiceService.CurrentChannelId == channelId)
                            ? VoiceService.IsMuted
                            : mutedUsers.Contains(uid);
                        <div class="d-flex align-center gap-2 voice-sidebar-participant"
                             data-voice-speaker-channel="@channelId"
                             data-voice-speaker-user="@uid"
                             data-voice-muted="@(isMuted ? "true" : null)">
                            <div class="voice-sidebar-avatar-wrap">
                                <EmployeeAvatar Employee="@u" Size="Size.Small" Class="voice-sidebar-avatar" Style="width: 22px; height: 22px; flex-shrink: 0;" />
                                @if (isMuted)
                                {
                                    <div class="voice-sidebar-mute-badge">
                                        <MudIcon Icon="@Icons.Material.Filled.MicOff" Color="Color.Error" Style="font-size: 10px;" />
                                    </div>
                                }
                            </div>
                            <MudText Typo="Typo.caption" Class="text-truncate flex-grow-1 voice-sidebar-name">
                                @u.FullName
                            </MudText>
                        </div>
                    }
                }
            </div>
        }
    };
}
