@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Services
@using Spokes_Server.Core.Helpers
@inject Database Db
@inject IDialogService DialogService
@inject ChatNotificationService ChatNotifications
@inject ChatService ChatService
@inject ChatStateService ChatState
@inject ScopedKeystoreService ScopedKeystore
@inject ICryptoService Crypto
@inject ISnackbar Snackbar
@inject Spokes_Server.Core.Services.Core.AppLabelService AppLabels
@implements IDisposable

<MudPaper Elevation="0" Style="height: 100%; display: flex; flex-direction: column;">
    <!-- Search & Actions -->
    <div class="pa-3 d-flex flex-column gap-2">
        <div class="d-flex gap-2 align-center">
            <MudTextField @bind-Value="_searchText" Placeholder="Search channels..." Variant="Variant.Outlined"
                Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Immediate="true"
                Margin="Margin.Dense" Class="flex-grow-1" UserAttributes="@_inputAttributes" />
            <MudMenu Icon="@Icons.Material.Filled.Sort" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Color="@(_reorderMode != ReorderMode.None ? Color.Primary : Color.Default)">
                <MudMenuItem OnClick="() => SetReorderMode(ReorderMode.Personal)">Reorder Channels</MudMenuItem>
                
                @if (_currentUserObj?.UsesCustomSidebarOrder == true)
                {
                    <MudMenuItem OnClick="ReattachToDefault">Reattach to Default</MudMenuItem>
                }

                @if (CanReorder)
                {
                    <div class="d-flex align-center px-3 mt-1 mb-1 pointer-events-none">
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                        <MudText Typo="Typo.caption" Class="px-2 flex-shrink-0" Style="color: var(--mud-palette-text-secondary); font-size: 0.65rem; font-weight: bold; letter-spacing: 0.5px;">ADMIN</MudText>
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                    </div>
                    <MudMenuItem OnClick="() => SetReorderMode(ReorderMode.Global)">Modify Default Order</MudMenuItem>
                }
            </MudMenu>
            @if (CanCreateChannel)
            {
                <MudIconButton Icon="@Icons.Material.Filled.Add" Size="Size.Small" OnClick="@(() => OpenCreateChannelDialog())" />
            }
        </div>
        @if (_reorderMode != ReorderMode.None)
        {
            <div class="d-flex justify-center mt-1">
                <MudButton Variant="Variant.Filled" Color="@(_reorderMode == ReorderMode.Global ? Color.Secondary : Color.Primary)" 
                           OnClick="() => SetReorderMode(ReorderMode.None)" Size="Size.Small" FullWidth="true" Class="mx-2">
                    Save Order
                </MudButton>
            </div>
        }
    </div>

    <!-- Channel List -->
    <div class="flex-grow-1 overflow-auto mt-n2" style="min-height: 0;">
        @{ 
            RenderFragment<ChatCategory> publicBlock = cat => @<text>
        @* PUBLIC Channels (no team or user restrictions) *@
        @{
            var publicChannels = FilteredChannels.Where(c =>
            c.ChannelType == ChatChannelType.General &&
            !c.AllowedTeamIds.Any() &&
            !c.ParticipantIds.Any() &&
            (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id))
            .OrderBy(c => c.IsVoiceChannel ? 1 : 0)
            .ThenBy(c => GetChannelOrder(c))
            .ToList();
            bool publicVoiceShown = false;
        }
        @if (publicChannels.Any())
        {
            int publicUnread = publicChannels.Sum(c => ChatNotifications.GetUnreadCount(c.Id));
            <div class="d-flex align-center justify-space-between px-3 pt-2">
                <div class="d-flex align-center" style="cursor: pointer; flex-grow: 1; user-select: none;" @onclick="() => { _publicCollapsed = !_publicCollapsed; SaveLocalPrefs(); }">
                    <MudIcon Icon="@(_publicCollapsed ? Icons.Material.Filled.KeyboardArrowRight : Icons.Material.Filled.KeyboardArrowDown)" Size="Size.Small" Style="color: var(--mud-palette-text-secondary); width: 18px; height: 18px; margin-right: 4px;" />
                    <MudText Typo="Typo.overline" Style="color: var(--mud-palette-text-secondary);">
                        PUBLIC
                    </MudText>
                    @if (_publicCollapsed && publicUnread > 0)
                    {
                        <NotificationBadge Count="@publicUnread" Small="true" Class="ml-2" />
                    }
                </div>
                @if (_reorderMode != ReorderMode.None)
                {
                    <div class="d-flex align-center">
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveCategoryUp(cat))" Disabled="@IsFirstVisibleCategory(cat)" Class="pa-0" />
                        <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveCategoryDown(cat))" Disabled="@IsLastVisibleCategory(cat)" Class="pa-0" />
                    </div>
                }
            </div>
            @if (!_publicCollapsed)
            {
                @foreach (var channel in publicChannels)
                {
                    if (channel.IsVoiceChannel && !publicVoiceShown)
                {
                    <div class="d-flex align-center px-3 mt-1 mb-1">
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                        <MudText Typo="Typo.caption" Class="px-2 flex-shrink-0" Style="color: var(--mud-palette-text-secondary); font-size: 0.65rem; font-weight: bold; letter-spacing: 0.5px;">VOICE CHANNELS</MudText>
                        <MudDivider Style="flex: 1; min-width: 0; width: auto;" />
                    </div>
                    publicVoiceShown = true;
                }
                var unread = ChatNotifications.GetUnreadCount(channel.Id);
                var preview = GetChannelPreview(channel.Id);

                <MudListItem T="string" Dense="true" OnClick="@(() => OnChannelSelected.InvokeAsync(channel.Id))"
                    Class="@(SelectedChannelId == channel.Id ? "mud-primary-text" : "")">
                    <div class="d-flex gap-2 justify-space-between align-center" style="width: 100%;">
                        <div class="d-flex gap-2 flex-grow-1" style="min-width: 0; align-items: flex-start;">
                            <div style="padding-top: 2px;">
                            @if (!string.IsNullOrEmpty(channel.Icon))
                            {
                                <MudIcon Icon="@channel.Icon" Size="Size.Small" />
                            }
                            else if (channel.IsVoiceChannel)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.VolumeUp" Size="Size.Small" />
                            }
                            else
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Public" Size="Size.Small" />
                            }
                            </div>
                            <div style="flex: 1; min-width: 0;">
                                <div class="d-flex align-center gap-1">
                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="flex: 1;">
                                        @GetChannelDisplayName(channel)
                                        @if (channel.IsEncrypted)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-info);" />
                                        }
                                        @if (channel.IsAnnouncementOnly)
                                        {
                                            <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" Style="font-size: 14px; margin-left: 4px; vertical-align: text-top; color: var(--mud-palette-success);" />
                                        }
                                        
                                    </MudText>
                                </div>
                                @if (channel.IsVoiceChannel)
                                {
                                    @RenderVoiceAvatars(channel.Id)
                                }
                                else if (!string.IsNullOrEmpty(preview))
                                {
                                    <MudText Typo="Typo.caption" Color="@(unread > 0 ? Color.Secondary : Color.Default)" Class="@($"text-truncate {(unread > 0 ? "" : "mud-text-secondary")}")" Style="display: block;">@preview</MudText>
                                }
                            </div>
                        </div>
                        <div class="d-flex align-center gap-1">
                            @if (unread > 0)
                            {
                                <NotificationBadge Count="@unread" />
                            }
                            @if (_reorderMode != ReorderMode.None)
                            {
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowUp" Size="Size.Small" OnClick="@(() => MoveChannelUp(channel, publicChannels))" Class="pa-0" />
                                <MudIconButton Icon="@Icons.Material.Filled.KeyboardArrowDown" Size="Size.Small" OnClick="@(() => MoveChannelDown(channel, publicChannels))" Class="pa-0" />
                            }
                        </div>
                    </div>
                </MudListItem>
                }
            }
        }

            </text>;
            RenderFragment<ChatCategory> projectsBlock = cat => @<text>
        @* Project Channels *@
        @{
            var projectChannels = FilteredChannels.Where(c => c.ChannelType == ChatChannelType.Project && (string.IsNullOrEmpty(c.CategoryId) || c.CategoryId == cat.Id))
            .OrderBy(c => c.IsVoiceChannel ? 1 : 0)
            .ThenBy(c => GetChannelOrder(c)).ToList();
            bool projectVoiceShown = false;
        }
        @if (projectChannels.Any() && !IsFriendEdition)
        {
            int projectsUnread = projectChannels.Sum(c => ChatNotifications.GetUnreadCount(c.Id));
            <div class="d-flex align-center justify-space-between px-3 pt-3">
                <div class="d-flex align-center" style="cursor: pointer; flex-grow: 1; user-select: none;" @onclick="() => { _projectsCollapsed = !_projectsCollapsed; SaveLocalPrefs(); }">
