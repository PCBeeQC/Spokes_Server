    private RenderFragment RenderVoiceAvatars(string channelId) => __builder =>
    {
        var activeUsers = ChatState.GetVoiceParticipants(channelId);
        if (activeUsers.Any())
        {
            var speakers = ChatState.GetActiveSpeakers(channelId);
            <div class="voice-user-list" style="margin-top: 4px;">
                @foreach (var uid in activeUsers)
                {
                    var u = Employees.FirstOrDefault(e => e.Id == uid);
                    if (u != null)
                    {
                        var isSpeaking = speakers.Contains(uid);
                        var borderStyle = isSpeaking ? "border: 2px solid var(--mud-palette-success);" : "";
                        <div class="d-flex align-center gap-2" style="padding: 2px 0 2px 8px;">
                            <EmployeeAvatar Employee="@u" Size="Size.Small" Style="@($"width: 22px; height: 22px; flex-shrink: 0; {borderStyle}")" />
                            <MudText Typo="Typo.caption" Class="text-truncate" Style="@($"color: {(isSpeaking ? "var(--mud-palette-success)" : "var(--mud-palette-text-secondary)")}; line-height: 1.2;")">
                                @u.FullName
                            </MudText>
                        </div>
                    }
                }
            </div>
        }
    };
