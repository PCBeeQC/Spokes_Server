@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.Communication.Presence
@inject FileTokenService FileTokens
@inject UserCircuitContext CircuitContext

@{
    var thumbUrl = GetThumbnailTokenUrl();
    bool hasThumb = !string.IsNullOrEmpty(thumbUrl);
}

<div class="attachment-video @(hasThumb ? "" : "is-error")">
    @if (!_isPlaying)
    {
        <div class="attachment-video-trigger" @onclick="PlayVideo">
            @if (hasThumb)
            {
                <div class="attachment-skeleton"></div>
                <img data-media-src="@thumbUrl"
                     data-media-priority="chat"
                     data-media-order="@MediaOrder"
                     data-media-encrypted="@(!string.IsNullOrEmpty(ChannelKey) ? "true" : null)"
                     alt="@Attachment.FileName"
                     decoding="async"
                     class="needs-fade attachment-video-thumb" />
            }
            <div class="attachment-video-fallback">
                <MudIcon Icon="@Icons.Material.Filled.VideoFile" Size="Size.Large" Color="Color.Secondary" />
            </div>
            <div class="attachment-video-play-btn">
                <MudIcon Icon="@Icons.Material.Filled.PlayArrow" Size="Size.Large" Style="color: white;" />
            </div>
        </div>
    }
    else
    {
        <video @key="@($"{Attachment.FilePath}_{ChannelKey}")" src="@GetVideoTokenUrl()" playsinline webkit-playsinline controls autoplay poster="@(hasThumb ? thumbUrl : "")"
            onerror="console.error('[VideoPlayer] Playback Error on src: ' + this.src + ' | Code: ' + (this.error ? this.error.code : 'unknown') + ' | Message: ' + (this.error ? this.error.message : 'none'));" onstalled="console.warn('[VideoPlayer] Playback stalled on src: ' + this.src);"
            class="attachment-video-player">
            @Loc["BrowserDoesNotSupportVideo"]
        </video>
    }
</div>

@code {
    [Parameter, EditorRequired]
    public ChatAttachment Attachment { get; set; } = default!;

    [Parameter]
    public string CurrentUserId { get; set; } = "";

    [Parameter]
    public string ChannelId { get; set; } = "";

    [Parameter]
    public string? ChannelKey { get; set; }

    [Parameter]
    public string? SessionId { get; set; }

    [Parameter]
    public int MediaOrder { get; set; }

    private string? EffectiveSessionId => !string.IsNullOrWhiteSpace(SessionId) ? SessionId : CircuitContext?.SessionId;

    private bool _isPlaying;

    private void PlayVideo() => _isPlaying = true;

    private string GetVideoTokenUrl() =>
        FileTokens.BuildTokenizedUrl("chat", ChannelId, Attachment.FilePath, ChannelKey, CurrentUserId, EffectiveSessionId);

    private string GetThumbnailTokenUrl() =>
        (!Attachment.HasServerThumbnail || string.IsNullOrEmpty(Attachment.ThumbnailUrl))
            ? string.Empty
            : FileTokens.BuildTokenizedUrl("chat", ChannelId, Attachment.ThumbnailUrl, ChannelKey, CurrentUserId, EffectiveSessionId, isThumbnail: true);
}
