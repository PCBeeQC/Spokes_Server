<div class="scroll-to-bottom-anchor">
    <div class="scroll-to-bottom-wrapper @(Visible ? "visible" : "")"
         aria-hidden="@(Visible ? "false" : "true")">
        <MudFab Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.ArrowDownward"
                Size="Size.Small"
                OnClick="OnClick"
                tabindex="@(Visible ? 0 : -1)"
                aria-label="@Loc["Scroll to bottom"]" />
    </div>
</div>
@{
    _lastVisible = Visible;
    _hasRenderedOnce = true;
}

@code {
    [Parameter] public bool Visible { get; set; }
    [Parameter] public EventCallback OnClick { get; set; }

    private bool _lastVisible;
    private bool _hasRenderedOnce;

    protected override bool ShouldRender() => !_hasRenderedOnce || Visible != _lastVisible;
}
