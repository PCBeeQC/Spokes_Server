    .message-row .message-actions-stack .message-read-receipts {
        opacity: 1;
        transition: opacity 0s;
        pointer-events: auto;
    }

    @@media (min-width: 960px) {
        .message-row:hover .message-actions-stack .message-read-receipts,
        .message-actions-stack .message-read-receipts.force-hidden {
            opacity: 0;
            pointer-events: none;
        }
    }

    .attachment-image .needs-fade {
        opacity: 0;
        transition: opacity 0.3s ease-in-out;
    }
    .attachment-image.is-loaded .needs-fade {
        opacity: 1;
    }
    .attachment-image.is-loaded .attachment-skeleton {
        display: none !important;
    }
</style>

@code {
    [Parameter] public ChatMessage Message { get; set; } = new();
    [Parameter] public string DataFingerprint { get; set; } = string.Empty;
    [Parameter] public string? DecryptedContent { get; set; }
    [Parameter] public string? DecryptedReplyContent { get; set; }
    [Parameter] public Employee? Sender { get; set; }
    [Parameter] public bool IsOwnMessage { get; set; }
    [Parameter] public bool IsGrouped { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public List<Employee> Employees { get; set; } = new();
    [Parameter] public List<Team> Teams { get; set; } = new();
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback<(ChatMessage Message, string Content)> OnSaveEdit { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public ChatMessage? ReplyToMessage { get; set; }
    [Parameter] public Employee? ReplyToSender { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnEdit { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDelete { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnReply { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnViewReactions { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnViewReadReceipts { get; set; }
    [Parameter] public EventCallback<string> OnScrollToMessage { get; set; }
    [Parameter] public EventCallback<(string MessageId, string Emoji)> OnReact { get; set; }
    [Parameter] public EventCallback<(ChatMessage Message, List<ChatAttachment> Images, int Index)> OnOpenLightbox { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnJoinCall { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDeclineCall { get; set; }
    [Parameter] public EventCallback<Employee?> OnAvatarClicked { get; set; }
    [Parameter] public List<string> ReadReceiptUserIds { get; set; } = new();
    [Parameter] public List<string> CumulativeReadReceiptUserIds { get; set; } = new();
    [Parameter] public EventCallback<ChatMessage> OnBlockUser { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnReportMessage { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDownloadMedia { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnShareMedia { get; set; }
    [Parameter]
    public string? ChannelKey { get; set; }

    private bool _isExpanded = false;
    private const int MaxMessageLength = 1000;

    private bool _showEmojiPicker;
    private List<LinkPreview> _linkPreviews = new();
    private int _skeletonCount = 0;
    private bool _scrollAfterPreview;
    private string? _lastPreviewedFingerprint;

    private bool HasMediaAttachments => Message.Attachments?.Any(a => IsImageFile(a.FileName) || IsVideoFile(a.FileName)) ?? false;

    private async Task CopyMessageText()
    {
        var textToCopy = DecryptedContent ?? Message.Content ?? "";
        if (!string.IsNullOrWhiteSpace(textToCopy))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", textToCopy);
            Snackbar.Add("Message text copied to clipboard", Severity.Success);
        }
    }

    // Tracks whether the component needs to re-render.
    // Without this, every Chat.razor StateHasChanged() causes ALL MessageBubbles
    // to re-render, producing massive DOM diffs that saturate the SignalR connection.
    private string? _lastRenderFingerprint;
    private bool _forceRender = true; // always render on first pass

    protected override bool ShouldRender()
    {
        if (_forceRender)
        {
            _forceRender = false;
            return true;
        }

        // Build a fingerprint of everything that affects the visual output
        var readersKey = ReadReceiptUserIds == null || ReadReceiptUserIds.Count == 0 ? "0" : string.Join(",", ReadReceiptUserIds);
        var fingerprint = $"{DataFingerprint}|{IsEditing}|{IsGrouped}|{IsOwnMessage}|{DecryptedContent}|{readersKey}|{_linkPreviews.Count}|{_skeletonCount}|{_showEmojiPicker}|{_isExpanded}";

        if (fingerprint == _lastRenderFingerprint)
            return false;

        _lastRenderFingerprint = fingerprint;
        return true;
    }

    protected override void OnParametersSet()
    {
        // Only reload link previews when the message content actually changes.
        // This prevents re-creating LinkPreviewCard components (which resets
        // their _faviconFailed / _imageFailed error-suppression state).
        if (_lastPreviewedFingerprint != DataFingerprint)
        {
            _lastPreviewedFingerprint = DataFingerprint;
            _forceRender = true; // ensure we re-render after fetching
            _ = LoadLinkPreviewsAsync();
        }
    }

    private async Task LoadLinkPreviewsAsync()
    {
        await LoadLinkPreviews();
        _forceRender = true;
        await InvokeAsync(StateHasChanged);
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // No-op: CSS overflow-anchor handles scroll-after-preview natively.
        // Removed OnMediaLoaded.InvokeAsync() call because EventCallback.InvokeAsync()
        // implicitly triggers StateHasChanged on the parent, causing a cascade.
        _scrollAfterPreview = false;
        return Task.CompletedTask;
    }

    private async Task LoadLinkPreviews()
    {
        _linkPreviews.Clear();
        _skeletonCount = 0;
        var contentToPreview = DecryptedContent ?? Message.Content;
        if (string.IsNullOrWhiteSpace(contentToPreview)) return;

        var urls = LinkPreviews.ExtractUrls(contentToPreview);
        var urlsToFetch = new List<string>();
        foreach (var url in urls)
        {
            var preview = LinkPreviews.GetPreview(url);
            if (preview != null)
            {
                _linkPreviews.Add(preview);
            }
            else
            {
                urlsToFetch.Add(url);
            }
        }

        if (urlsToFetch.Any())
        {
            _skeletonCount = urlsToFetch.Count;
            // Force a render pass to show the skeletons immediately
            await InvokeAsync(StateHasChanged);

            foreach (var url in urlsToFetch)
            {
                var fetched = await LinkPreviews.FetchPreviewAsync(url);
                if (fetched != null)
                {
                    _linkPreviews.Add(fetched);
                }
            }
            
            _skeletonCount = 0;
            if (_linkPreviews.Any())
            {
                _scrollAfterPreview = true;
            }
        }
    }

    private RenderFragment RenderLinkPreviews() => __builder =>
    {
        foreach (var preview in _linkPreviews)
        {
            <LinkPreviewCard @key="preview.Url" Preview="preview" />
        }
        for (int i = 0; i < _skeletonCount; i++)
        {
            <LinkPreviewSkeleton />
        }
    };

    private RenderFragment RenderAttachment(ChatAttachment attachment) => __builder =>
    {
        if (IsImageFile(attachment.FileName))
        {
            var imageAttachments = Message.Attachments.Where(a => IsImageFile(a.FileName)).ToList();
            var imageIndex = imageAttachments.IndexOf(attachment);
            bool hasDimensions = attachment.ImageWidth.HasValue && attachment.ImageHeight.HasValue && attachment.ImageHeight.Value > 0;
            
            string dimensionStyle = "";
            if (hasDimensions)
            {
                var targetWidth = Math.Round(500.0 * attachment.ImageWidth!.Value / attachment.ImageHeight!.Value);
                dimensionStyle = $"width: {targetWidth}px; max-width: 100%; aspect-ratio: {attachment.ImageWidth} / {attachment.ImageHeight}; max-height: 500px;";
            }

            var token = FileTokens.GenerateAccessToken("chat", Message.ChannelId, attachment.FilePath, ChannelKey);
            var thumbUrl = attachment.ThumbnailUrl.Contains("?") ? $"{attachment.ThumbnailUrl}&t={token}" : $"{attachment.ThumbnailUrl}?t={token}";

            <div class="attachment-image" @onclick="@(() => OnOpenLightbox.InvokeAsync((Message, imageAttachments, imageIndex)))"
                style="cursor: pointer; position: relative; display: inline-block; @dimensionStyle">
                
                @if (hasDimensions)
                {
                    <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="100%" Height="100%" Class="attachment-skeleton" Style="position: absolute; top: 0; left: 0; border-radius: 8px;" Animation="Animation.Wave" />
                }
                
                <img src="@thumbUrl" alt="@attachment.FileName"
                    onload="this.parentElement.classList.add('is-loaded');"
                    class="@(hasDimensions ? "needs-fade" : "")"
                    style="max-width: 100%; max-height: 500px; width: auto; height: 100%; border-radius: 8px; display: block; object-fit: contain; -webkit-touch-callout: none; -webkit-user-select: none; user-select: none;" />
            </div>
        }
        else if (IsVideoFile(attachment.FileName))
        {
            <ChatVideoAttachment Attachment="attachment" CurrentUserId="@CurrentUserId" ChannelId="@Message.ChannelId" ChannelKey="@ChannelKey" />
        }
        else if (IsAudioFile(attachment.FileName) || (attachment.ContentType != null && attachment.ContentType.StartsWith("audio/")))
        {
            var token = FileTokens.GenerateAccessToken("chat", Message.ChannelId, attachment.FilePath, ChannelKey);
            var audioUrl = attachment.FilePath.Contains("?") ? $"{attachment.FilePath}&t={token}" : $"{attachment.FilePath}?t={token}";
            <VoiceMessagePlayer AudioUrl="@audioUrl" />
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-2 d-flex align-center gap-2" Style="border-radius: 8px;">
                <MudIcon Icon="@GetFileIcon(attachment.FileName)" Color="Color.Primary" />
                <div style="flex-grow: 1;" @onclick="@(() => DownloadOrOpenDocument(attachment))">
                    <MudText Typo="Typo.body2" Color="Color.Primary" Style="font-weight: 500; cursor: pointer;" Class="mud-link-underline-hover">
                        @attachment.FileName
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Style="cursor: pointer;">
                        @FormatFileSize(attachment.FileSizeBytes)
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => ShareDocument(attachment))" />
            </MudPaper>
        }
    };

    private RenderFragment RenderMessageActions() => __builder =>
    {
        var currentEmployee = Employees.FirstOrDefault(e => e.Id == CurrentUserId);
        var recentEmojis = currentEmployee?.RecentEmojis?.ToList() ?? new List<string>();
        
        var defaultEmojis = new[] { "👍", "❤️", "😂" };
        var top3Emojis = recentEmojis.Concat(defaultEmojis).Distinct().Take(3).ToList();

        foreach (var emoji in top3Emojis)
        {
            <MudIconButton Size="Size.Small" Style="font-size: 1.1rem; color: var(--mud-palette-text-primary);" OnClick="@(() => OnReact.InvokeAsync((Message.Id, emoji)))">
                @emoji
            </MudIconButton>
        }

        <div style="position: relative;">
            <MudIconButton Icon="@Icons.Material.Outlined.AddReaction" Size="Size.Small" Color="Color.Secondary"
                OnClick="@(() => _showEmojiPicker = !_showEmojiPicker)" />
            <MudPopover Open="@_showEmojiPicker" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight" OverflowBehavior="OverflowBehavior.FlipAlways">
                <EmojiPicker IsOpen="@true"
                    OnEmojiSelected="@(async (emoji) => { _showEmojiPicker = false; await OnReact.InvokeAsync((Message.Id, emoji)); })"
                    OnClose="@(() => _showEmojiPicker = false)"
                    DisableGifs="true"
                    ContainerStyle="position: relative; margin: 0; box-shadow: none;" />
            </MudPopover>
        </div>

        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Secondary"
            OnClick="@(() => OnReply.InvokeAsync(Message))" Style="transform: scaleX(-1);" />

        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" Dense="true" IconColor="Color.Secondary">
            @if (Message.Reactions.Any())
            {
                <MudMenuItem OnClick="@(() => OnViewReactions.InvokeAsync(Message))">
                    <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Class="mr-2" />
                    View Reactions
                </MudMenuItem>
            }
            @if (CumulativeReadReceiptUserIds.Any(id => id != Message.SenderId && id != CurrentUserId))
            {
                <MudMenuItem OnClick="@(() => OnViewReadReceipts.InvokeAsync(Message))">
                    <MudIcon Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" Class="mr-2" />
                    View Read Receipts
                </MudMenuItem>
            }
            <MudMenuItem OnClick="@CopyMessageText">
                <MudIcon Icon="@Icons.Material.Filled.ContentCopy" Size="Size.Small" Class="mr-2" />
                Copy Text
            </MudMenuItem>
            @if (Message.Attachments.Any())
            {
                <MudMenuItem OnClick="@(() => OnShareMedia.InvokeAsync(Message))">
                    <MudIcon Icon="@Icons.Material.Filled.Share" Size="Size.Small" Class="mr-2" />
                    Share
                </MudMenuItem>
            }
            @if (HasMediaAttachments)
            {
                <MudMenuItem OnClick="@(() => OnDownloadMedia.InvokeAsync(Message))">
                    <MudIcon Icon="@Icons.Material.Filled.Download" Size="Size.Small" Class="mr-2" />
                    Download
                </MudMenuItem>
            }
            @if (IsOwnMessage)
            {
                <MudMenuItem OnClick="@(() => OnEdit.InvokeAsync(Message))">
                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Class="mr-2" />
                    Edit
                </MudMenuItem>
                <MudMenuItem OnClick="@(() => OnDelete.InvokeAsync(Message))">
                    <MudIcon Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Class="mr-2" Color="Color.Error" />
                    Delete
                </MudMenuItem>
            }
            else
            {
                <MudMenuItem OnClick="@(() => OnBlockUser.InvokeAsync(Message))">
                    <MudIcon Icon="@Icons.Material.Filled.Block" Size="Size.Small" Class="mr-2" Color="Color.Error" />
                    Block User
                </MudMenuItem>
                @if (Message.ChannelType != Spokes_Server.Core.Models.Communication.ChatChannelType.Direct)
                {
                    <MudMenuItem OnClick="@(() => OnReportMessage.InvokeAsync(Message))">
                        <MudIcon Icon="@Icons.Material.Filled.Flag" Size="Size.Small" Class="mr-2" Color="Color.Warning" />
                        Report Message
                    </MudMenuItem>
                }
            }
        </MudMenu>
    };
    
    private RenderFragment RenderReadReceipts() => __builder =>
    {
        var readers = ReadReceiptUserIds.Where(id => id != Message.SenderId && id != CurrentUserId).ToList();
        foreach (var readerId in readers.Take(3))
        {
            var emp = Employees.FirstOrDefault(e => e.Id == readerId);
            if (emp != null)
            {
                <EmployeeAvatar Employee="emp" Size="Size.Small" ShowPresence="false" Style="width: 14px; height: 14px; min-width: 14px; min-height: 14px; font-size: 0.5rem;" />
            }
        }
        if (readers.Count > 3)
        {
            <div style="font-size: 0.65rem; color: var(--mud-palette-text-secondary); margin-left: 2px;">+@(readers.Count - 3)</div>
        }
    };

    private string GetTokenizedUrl(ChatAttachment attachment)
    {
        var token = FileTokens.GenerateAccessToken("chat", Message.ChannelId, attachment.FilePath, ChannelKey);
        return attachment.FilePath.Contains("?") ? $"{attachment.FilePath}&t={token}" : $"{attachment.FilePath}?t={token}";
    }

    private async Task ShareDocument(ChatAttachment attachment)
    {
        await JS.InvokeVoidAsync("shareFileFromUrl", attachment.FileName, GetTokenizedUrl(attachment));
    }

    private async Task DownloadOrOpenDocument(ChatAttachment attachment)
    {
        await JS.InvokeVoidAsync("downloadOrOpenDocument", attachment.FileName, GetTokenizedUrl(attachment));
    }

    private IEnumerable<(string Emoji, int Count, bool HasReacted)> GetReactionGroups()
    {
        return Message.Reactions
            .Select(r => r.Split(':'))
            .Where(parts => parts.Length >= 2)
            .GroupBy(parts => parts[0])
            .Select(g => (
                Emoji: g.Key,
                Count: g.Count(),
                HasReacted: g.Any(parts => parts[1] == CurrentUserId)
            ));
    }

    private string GetReactionTooltip(string emoji)
    {
        var userIds = Message.Reactions
            .Where(r => r.StartsWith(emoji + ":"))
            .Select(r => r.Split(':')[1])
            .ToList();

        var names = userIds.Select(id => Employees.FirstOrDefault(e => e.Id == id)?.FullName ?? "Unknown User").ToList();
        
        if (names.Count == 0) return "";
        if (names.Count <= 3) return $"Reacted by {string.Join(", ", names)}";
        return $"Reacted by {string.Join(", ", names.Take(3))} and {names.Count - 3} others";
    }

    private string GetReplyPreview(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        // Collapse newlines into spaces for clean single-line previewing
        var singleLine = content.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
        // Clean database-specific brackets so @[John Doe] displays cleanly as @John Doe (preserving the name)
        return System.Text.RegularExpressions.Regex.Replace(singleLine, @"@\[([^\]]+)\]", "@$1");
    }

    private string TruncateContent(string content, int maxLength)
    {
        if (string.IsNullOrEmpty(content)) return "";
        // Strip mention tokens for display
        var clean = System.Text.RegularExpressions.Regex.Replace(content, @"@\[([^\]]+)\]", "@$1");
        return clean.Length <= maxLength ? clean : clean[..maxLength] + "…";
    }

    private string FormatFileSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024.0:F1} KB";
        return $"{bytes / (1024.0 * 1024.0):F1} MB";
    }

    protected override void OnInitialized()
    {
        ImageRecovery.OnTokensWiped += HandleTokensWiped;
    }

    private void HandleTokensWiped()
    {
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        ImageRecovery.OnTokensWiped -= HandleTokensWiped;
    }
}
