    private RenderFragment RenderReadReceipts() => __builder =>
    {
        var readers = ReadReceiptUserIds.Where(id => id != Message.SenderId && id != CurrentUserId).ToList();
        if (HideReadReceipts)
        {
            if (readers.Count > 0)
            {
                <div class="d-inline-flex align-center gap-1" style="font-size: 0.65rem; color: var(--mud-palette-text-secondary);" title="@Loc["View Read Receipts"]">
                    <MudIcon Icon="@Icons.Material.Filled.DoneAll" Size="Size.Small" Style="font-size: 0.8rem;" />
                    <span>@readers.Count</span>
                </div>
            }
            return;
        }
        foreach (var readerId in readers.Take(3))
        {
            var emp = Employees.FirstOrDefault(e => e.Id == readerId);
            if (emp != null)
            {
                <EmployeeAvatar Employee="emp" Size="Size.Small" ShowPresence="false" Style="width: 14px; height: 14px; min-width: 14px; min-height: 14px;" />
            }
            else
            {
                <MudAvatar Size="Size.Small" Style="width: 14px; height: 14px; min-width: 14px; min-height: 14px; font-size: 0.5rem; background: var(--mud-palette-action-disabled-background); color: var(--mud-palette-text-secondary);">?</MudAvatar>
            }
        }
        if (readers.Count > 3)
        {
            <div style="font-size: 0.65rem; color: var(--mud-palette-text-secondary); margin-left: 2px;">+@(readers.Count - 3)</div>
        }
    };

    private string? EffectiveSessionId => !string.IsNullOrWhiteSpace(SessionId) ? SessionId : CircuitContext?.SessionId;

    private string GetTokenizedUrl(ChatAttachment attachment, bool isThumbnail = false, bool includeFileName = true)
    {
        var targetUrl = isThumbnail && attachment.CanUseServerThumbnail && !string.IsNullOrWhiteSpace(attachment.ThumbnailUrl)
            ? attachment.ThumbnailUrl
            : attachment.FilePath;

        return FileTokens.BuildTokenizedUrl(
            "chat",
            Message.ChannelId,
            targetUrl,
            ChannelKey,
            CurrentUserId,
            EffectiveSessionId,
            isThumbnail: isThumbnail,
            displayFileName: includeFileName ? attachment.FileName : null);
    }

    private async Task ShareDocument(ChatAttachment attachment)
    {
        await JS.InvokeVoidAsync("shareFileFromUrl", attachment.FileName, GetTokenizedUrl(attachment));
    }

    private async Task DownloadOrOpenDocument(ChatAttachment attachment)
    {
        await JS.InvokeVoidAsync("downloadOrOpenDocument", attachment.FileName, GetTokenizedUrl(attachment));
    }

    private IEnumerable<(string Emoji, int Count, bool HasReacted)> GetReactionGroups()
    {
        return Message.Reactions
            .Select(r => r.Split(':'))
            .Where(parts => parts.Length >= 2)
            .GroupBy(parts => parts[0])
            .Select(g => (
                Emoji: g.Key,
                Count: g.Count(),
                HasReacted: g.Any(parts => parts[1] == CurrentUserId)
            ));
    }

    private string GetReactionTooltip(string emoji)
    {
        var userIds = Message.Reactions
            .Where(r => r.StartsWith(emoji + ":"))
            .Select(r => r.Split(':')[1])
            .ToList();

        var names = userIds.Select(id => Employees.FirstOrDefault(e => e.Id == id)?.FullName ?? Loc["Unknown User"].Value).ToList();
        
        if (names.Count == 0) return "";
        if (AnonymizeReactions)
        {
            return userIds.Count == 1 
                ? Loc["1 person reacted"].Value 
                : string.Format(Loc["{0} people reacted"].Value, userIds.Count);
        }
        if (names.Count <= 3) return string.Format(Loc["Reacted by {0}"].Value, string.Join(", ", names));
        return string.Format(Loc["Reacted by {0} and {1} others"].Value, string.Join(", ", names.Take(3)), names.Count - 3);
    }

    private string GetReplyPreview(string content)
    {
        if (string.IsNullOrEmpty(content)) return "";
        // Collapse newlines into spaces for clean single-line previewing
        var singleLine = content.Replace("\r\n", " ").Replace("\n", " ").Replace("\r", " ");
        // Clean database-specific brackets so @[John Doe] displays cleanly as @John Doe (preserving the name)
        return System.Text.RegularExpressions.Regex.Replace(singleLine, @"@\[([^\]]+)\]", "@$1");
    }

    protected override void OnInitialized()
    {
        ImageRecovery.OnTokensWiped += HandleTokensWiped;
    }

    private void HandleTokensWiped()
    {
        _forceRender = true;
        InvokeAsync(StateHasChanged);
    }

    private void HandleVoiceChanged()
    {
        bool inCall = VoiceService.IsInVoiceCall;
        string? voiceChannelId = VoiceService.CurrentChannelId;
        bool connecting = VoiceService.IsConnecting;

        if (inCall == _lastVoiceInCall &&
            string.Equals(voiceChannelId, _lastVoiceChannelId, StringComparison.Ordinal) &&
            connecting == _lastVoiceConnecting)
        {
            return;
        }

        _lastVoiceInCall = inCall;
        _lastVoiceChannelId = voiceChannelId;
        _lastVoiceConnecting = connecting;
        _forceRender = true;
        InvokeAsync(StateHasChanged);
    }

    public void Dispose()
    {
        CancelPreviewFetch();
        ImageRecovery.OnTokensWiped -= HandleTokensWiped;
        if (_subscribedToVoice)
        {
            VoiceService.OnChange -= HandleVoiceChanged;
            _subscribedToVoice = false;
        }
    }
}
