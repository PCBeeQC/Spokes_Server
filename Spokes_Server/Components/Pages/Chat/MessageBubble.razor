@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.UI
@using Spokes_Server.Core.Services.Communication.Voice
@using Spokes_Server.Core.Services.Communication.Presence
@using static Spokes_Server.Core.Helpers.FileHelper
@using static Spokes_Server.Components.UI.FileUiHelper
@inject LinkPreviewService LinkPreviews
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject FileTokenService FileTokens
@inject ImageRecoveryService ImageRecovery
@inject GlobalVoiceService VoiceService
@inject UserCircuitContext CircuitContext
@implements IDisposable

<div class="w-100 @(!IsGrouped ? "mt-2" : "")">
@* Reply preview above message content (when this is a reply to another message) *@
@if (!string.IsNullOrEmpty(Message.ReplyToId) && ReplyToMessage != null)
{
    <div class="reply-preview-row" @onclick="@(() => OnScrollToMessage.InvokeAsync(Message.ReplyToId))">
        <div class="reply-spine @(IsGrouped ? "is-grouped" : "")"></div>
        <EmployeeAvatar Employee="ReplyToSender" Size="Size.Small" ShowPresence="false" Class="chat-reply-avatar" />
        <span class="mud-typography mud-typography-caption mt-1 reply-sender-name">
            @(ReplyToSender?.FullName ?? Loc["Unknown"].Value)
        </span>
        <span class="mud-typography mud-typography-caption reply-text mt-1">
            @GetReplyPreview(EffectiveDecryptedReplyContent ?? ReplyToMessage.Content)
        </span>
    </div>
}

@* When grouped (same sender within 5 min), collapse avatar/name and show compact layout *@
<div class="@GetMessageRowCssClass()" data-message-id="@Message.Id">
    @if (IsGrouped)
    {
        @* Invisible spacer matching avatar width for alignment *@
        <div class="message-avatar-spacer">
            <span class="mud-typography mud-typography-caption message-hover-time">
                @Message.SentAt.ToLocalTime().ToString("h:mm tt")
            </span>
        </div>
    }
    else
    {
        @* Avatar *@
        <div class="message-avatar-trigger" @onclick="@(() => OnAvatarClicked.InvokeAsync(Sender))">
            <EmployeeAvatar Employee="@Sender" Size="Size.Medium" Class="chat-msg-avatar" />
        </div>
    }

    @{
        var decryptedContent = EffectiveDecryptedContent;
        var txt = decryptedContent ?? Message.Content ?? "";
        bool isInlineMedia = txt.Contains("![") || txt.Contains(".gif") || txt.Contains("tenor.com") || txt.Contains("giphy.com");
        bool hasVisualMedia = HasMediaAttachments || _linkPreviews.Any() || isInlineMedia;
    }
    <div class="message-content-wrapper @(hasVisualMedia ? "has-media" : "")">
        @* Message Body *@
        <div class="message-body-col">
            @if (!IsGrouped)
            {
                @* Header: Name + Time *@
                <div class="d-flex align-center gap-2">
                    <span class="mud-typography mud-typography-subtitle2 message-sender-name" @onclick="@(() => OnAvatarClicked.InvokeAsync(Sender))">
                        @(Sender?.FullName ?? Loc["Unknown User"].Value)
                    </span>
                    <span class="mud-typography mud-typography-caption message-timestamp">
                        @{
                            var localTime = Message.SentAt.ToLocalTime();
                            var isToday = localTime.Date == DateTime.Now.Date;
                        }
                        @localTime.ToString(isToday ? "h:mm tt" : "MMM dd, h:mm tt")
                    </span>
                </div>
            }

            @if (IsEditing)
            {
                <div class="mt-2 mb-2 w-100">
                    <ChatComposer @key="@($"edit-{Message.Id}")"
                        ChannelId="@Message.ChannelId" 
                        CurrentUserId="@CurrentUserId" 
                        IsEditMode="true" 
                        IsMobile="@IsMobile"
                        InitialText="@(decryptedContent ?? Message.Content)" 
                        IdSuffix="@Message.Id"
                        Employees="@(ChannelEmployees ?? Employees)"
                        Teams="Teams"
                        ChannelKey="@ChannelKey"
                        OnSendMessage="@(async args => await OnSaveEdit.InvokeAsync((Message, args.Content)))"
                        OnCancelEdit="@(async () => await OnCancelEdit.InvokeAsync())" />
                </div>
            }
            else if (Message.MessageType == ChatMessageType.CallInvite)
            {
                <MudCard Class="pa-3 mt-1 mb-1 chat-call-invite-card">
                    <div class="d-flex align-center gap-3">
                        <MudIcon Icon="@Icons.Material.Filled.Phone" Color="Color.Info" Size="Size.Medium" />
                        <div>
                            <MudText Typo="Typo.subtitle2"><b>@Loc["Voice Call Started"]</b></MudText>
                            @if (Message.CallStatus == CallStatus.Declined)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Error">@Loc["Call was declined."]</MudText>
                            }
                            else if (Message.CallStatus == CallStatus.Ended)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Call ended."]</MudText>
                            }
                            else if (VoiceService.IsInVoiceCall && VoiceService.CurrentChannelId == Message.ChannelId)
                            {
                                <MudText Typo="Typo.body2" Color="Color.Success">@Loc["Call joined."]</MudText>
                            }
                            else
                            {
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Join the conversation!"]</MudText>
                            }
                        </div>
                    </div>
                    @if (Message.CallStatus != CallStatus.Declined && Message.CallStatus != CallStatus.Ended && !(VoiceService.IsInVoiceCall && VoiceService.CurrentChannelId == Message.ChannelId))
                    {
                        <div class="d-flex justify-end gap-2 mt-2">
                            @if (CurrentUserId != Message.SenderId)
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="@(() => OnDeclineCall.InvokeAsync(Message))">@Loc["Decline"]</MudButton>
                            }
                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Small" Disabled="@(VoiceService.IsConnecting || (VoiceService.IsInVoiceCall && VoiceService.CurrentChannelId == Message.ChannelId))" OnClick="@(() => OnJoinCall.InvokeAsync(Message))">@(VoiceService.IsConnecting ? Loc["Connecting..."].Value : Loc["Join Call"].Value)</MudButton>
                        </div>
                    }
                </MudCard>
            }
            else if (Message.IsEncrypted && decryptedContent == null && !string.IsNullOrEmpty(Message.Content))
            {
                <div class="d-flex align-center gap-2 chat-encrypted-msg-row">
                    <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" />
                    <MudText Typo="Typo.body2">@Loc["Encrypted message"]</MudText>
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(decryptedContent ?? Message.Content))
            {
                var rawContent = decryptedContent ?? Message.Content ?? "";
                var displayContent = GetDisplayContent(rawContent);
                var truncatedFullContent = (rawContent.Length > MaxMessageLength && !_isExpanded) ? new ChatTextRef(rawContent) : null;
                <ChatMarkdownRenderer Content="@displayContent" FullContentRef="@truncatedFullContent" MessageId="@Message.Id" CurrentUserId="@CurrentUserId" ChannelId="@Message.ChannelId" SessionId="@SessionId" Employees="Employees" IsEdited="@Message.EditedAt.HasValue" ChannelKey="@ChannelKey" />
                if (rawContent.Length > MaxMessageLength)
                {
                    <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" OnClick="() => { _isExpanded = !_isExpanded; _forceRender = true; }" Class="mt-1 px-1" Style="min-width: unset;">
                        @(_isExpanded ? Loc["Show Less"].Value : Loc["Read More"].Value)
                    </MudButton>
                }
            }
            @RenderLinkPreviews()
            @if (Message.Attachments.Any())
            {
                <div class="@(IsGrouped ? "d-flex flex-wrap gap-2 my-1" : "d-flex flex-wrap gap-2 mt-2")">
                    @foreach (var attachment in Message.Attachments)
                    {
                        @RenderAttachment(attachment)
                    }
                </div>
            }
            @RenderAlbumConversionPrompt()
            @if (Message.MentionedEventIds != null && Message.MentionedEventIds.Any())
            {
                <div class="@(IsGrouped ? "d-flex flex-wrap gap-2 mt-2 mb-1 w-100" : "d-flex flex-wrap gap-2 mt-2 w-100")">
                    @foreach (var eventId in Message.MentionedEventIds)
                    {
                        <EventMentionCard EventId="@eventId" CurrentUserId="@CurrentUserId" ChannelId="@Message.ChannelId" Employees="Employees" />
                    }
                </div>
            }
            @if (Message.MentionedAlbumIds != null && Message.MentionedAlbumIds.Any())
            {
                <div class="@(IsGrouped ? "d-flex flex-wrap gap-2 mt-2 mb-1 w-100" : "d-flex flex-wrap gap-2 mt-2 w-100")">
                    @foreach (var albumId in Message.MentionedAlbumIds)
                    {
                        <AlbumMentionCard AlbumId="@albumId" CurrentUserId="@CurrentUserId" SessionId="@SessionId" Employees="Employees" ChannelId="@Message.ChannelId" MessageIndex="@MessageIndex" />
                    }
                </div>
            }
            @if (Message.MentionedPollIds != null && Message.MentionedPollIds.Any())
            {
                <div class="@(IsGrouped ? "d-flex flex-wrap gap-2 mt-2 mb-1 w-100" : "d-flex flex-wrap gap-2 mt-2 w-100")">
                    @foreach (var pollId in Message.MentionedPollIds)
                    {
                        <PollMentionCard PollId="@pollId" CurrentUserId="@CurrentUserId" ChannelId="@Message.ChannelId" ChannelKey="@ChannelKey" Employees="Employees" />
                    }
                </div>
            }
            @if (Message.Reactions.Any() || ReadReceiptUserIds.Any(id => id != Message.SenderId && id != CurrentUserId))
            {
                <div class="d-flex justify-space-between align-center w-100 mt-1">
                    <div class="reactions-container">
                        @if (Message.Reactions.Any())
                        {
                            <div class="d-flex flex-wrap gap-1">
                                @foreach (var reactionGroup in GetReactionGroups())
                                {
                                    <button type="button"
                                            class="mud-chip mud-chip-outlined mud-chip-size-small @(reactionGroup.HasReacted ? "mud-chip-color-primary" : "mud-chip-color-default") message-reaction-pill"
                                            @onclick="@(() => { if (CanReact) OnReact.InvokeAsync((Message.Id, reactionGroup.Emoji)); })"
                                            title="@(!IsMobile ? GetReactionTooltip(reactionGroup.Emoji) : null)">
                                        @reactionGroup.Emoji <span class="ml-1">@reactionGroup.Count</span>
                                    </button>
                                }
                            </div>
                        }
                    </div>
                    
                    <div class="message-read-receipts d-flex align-center justify-end gap-1">
                        @if (ReadReceiptUserIds.Any(id => id != Message.SenderId && id != CurrentUserId))
                        {
                            @RenderReadReceipts()
                        }
                    </div>
                </div>
            }
        </div>

        @* Actions Stack (Desktop float right): idle rows emit a dedicated JS mount slot (.message-actions-slot) so Chat.razor.js never collides with Blazor's child diffing; Blazor atomically replaces the slot with popup markup for the single active row. *@
        @if (!IsMobile && !Message.IsDeleted && !IsEditing)
        {
            <div class="message-actions-stack ml-2">
                @if (ShowEmojiPicker || ShowMoreMenu)
                {
                    <div class="message-actions d-flex align-center force-visible">
                        @RenderMessageActions()
                    </div>
                }
                else
                {
                    <div class="message-actions-slot"></div>
                }
            </div>
        }
    </div>
</div>
</div>
@{
    _lastRenderFingerprint = ComputeRenderFingerprint();
    _forceRender = false;
}

@* Styles live in wwwroot/css/chat.css: this component renders once per message, so inline style blocks would be re-sent and re-inserted per instance (AGENTS.md §3). *@

@code {
    [Parameter] public ChatMessage Message { get; set; } = new();
    [Parameter] public int DataVersionHash { get; set; }
    [Parameter] public IReadOnlyDictionary<string, string>? DecryptedContents { get; set; }
    [Parameter] public Employee? Sender { get; set; }

    private string? EffectiveDecryptedContent =>
        DecryptedContents != null && !string.IsNullOrEmpty(Message.Id) && DecryptedContents.TryGetValue(Message.Id, out var val)
            ? val
            : null;

    private string? EffectiveDecryptedReplyContent =>
        DecryptedContents != null && ReplyToMessage != null && !string.IsNullOrEmpty(ReplyToMessage.Id) && DecryptedContents.TryGetValue(ReplyToMessage.Id, out var val)
            ? val
            : null;
    [Parameter] public bool IsOwnMessage { get; set; }
    [Parameter] public bool IsGrouped { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public List<Employee> Employees { get; set; } = [];
    [Parameter] public List<Team> Teams { get; set; } = [];
    [Parameter] public bool IsEditing { get; set; }
    [Parameter] public EventCallback<(ChatMessage Message, string Content)> OnSaveEdit { get; set; }
    [Parameter] public EventCallback OnCancelEdit { get; set; }
    [Parameter] public ChatMessage? ReplyToMessage { get; set; }
    [Parameter] public Employee? ReplyToSender { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnEdit { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDelete { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnReply { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnViewReactions { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnViewReadReceipts { get; set; }
    [Parameter] public EventCallback<string> OnScrollToMessage { get; set; }
    [Parameter] public EventCallback<(string MessageId, string Emoji)> OnReact { get; set; }
    [Parameter] public EventCallback<(ChatMessage Message, List<ChatAttachment> Images, int Index)> OnOpenLightbox { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnJoinCall { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDeclineCall { get; set; }
    [Parameter] public EventCallback<Employee?> OnAvatarClicked { get; set; }
    [Parameter] public List<string> ReadReceiptUserIds { get; set; } = [];
    [Parameter] public List<string> CumulativeReadReceiptUserIds { get; set; } = [];
    [Parameter] public EventCallback<ChatMessage> OnBlockUser { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnReportMessage { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnDownloadMedia { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnShareMedia { get; set; }
    [Parameter] public bool CanCreateAlbum { get; set; }
    [Parameter] public EventCallback<ChatMessage> OnCreateAlbumFromMessage { get; set; }
    [Parameter]
    public string? ChannelKey { get; set; }
    [Parameter] public bool CanReact { get; set; } = true;
    [Parameter] public bool AnonymizeReactions { get; set; } = false;
    [Parameter] public List<Employee>? ChannelEmployees { get; set; }
    [Parameter] public bool HideReadReceipts { get; set; } = false;
    [Parameter] public bool IsMobile { get; set; }
    [Parameter] public int MessageIndex { get; set; }
    [Parameter] public bool ShowEmojiPicker { get; set; }
    [Parameter] public bool ShowMoreMenu { get; set; }
    [Parameter] public bool IsActionSheetTarget { get; set; }
    [Parameter] public EventCallback OnCloseActionPopups { get; set; }
    [Parameter] public IReadOnlyList<string>? QuickReactEmojis { get; set; }

    private string GetMessageRowCssClass() => (IsGrouped, IsActionSheetTarget) switch
    {
        (true, true) => "py-0 pr-2 message-row message-row-grouped message-row-action-target",
        (true, false) => "py-0 pr-2 message-row message-row-grouped",
        (false, true) => "mb-0 py-1 pr-2 message-row message-row-action-target",
        (false, false) => "mb-0 py-1 pr-2 message-row",
    };

    private static readonly string[] DefaultQuickReactEmojis = ["👍", "❤️", "😂"];

    private bool _isExpanded;
    private const int MaxMessageLength = 1000;

    private string GetDisplayContent(string rawContent)
    {
        if (_isExpanded || rawContent.Length <= MaxMessageLength)
            return rawContent;

        int cutLength = MaxMessageLength;
        if (cutLength < rawContent.Length && char.IsHighSurrogate(rawContent[cutLength - 1]))
        {
            cutLength--;
        }

        var displayContent = rawContent[..cutLength] + "...";

        var codeStarts = System.Text.RegularExpressions.Regex.Matches(displayContent, @"\[code", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Count;
        var codeEnds = System.Text.RegularExpressions.Regex.Matches(displayContent, @"\[/code\]", System.Text.RegularExpressions.RegexOptions.IgnoreCase).Count;
        if (codeStarts > codeEnds)
        {
            displayContent += "\n[/code]";
        }

        var fenceCount = System.Text.RegularExpressions.Regex.Matches(displayContent, @"(?m)^```").Count;
        if (fenceCount % 2 == 1)
        {
            displayContent += "\n```";
        }

        return displayContent;
    }

    private List<LinkPreview> _linkPreviews = [];
    private int _skeletonCount;
    private string? _lastPreviewedContent;
    private CancellationTokenSource? _previewCts;
    private bool _subscribedToVoice;
    private bool _lastVoiceInCall;
    private string? _lastVoiceChannelId;
    private bool _lastVoiceConnecting;

    private bool HasMediaAttachments => Message.Attachments?.Any(a => IsImageFile(a.FileName) || IsVideoFile(a.FileName)) ?? false;
    private bool _dismissedAlbumPrompt;

    private int ImageAttachmentCount => Message.Attachments?.Count(a =>
        IsImageFile(a.FileName) || a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase)) ?? 0;

    private bool EligibleForAlbumConversion =>
        CanCreateAlbum &&
        IsOwnMessage &&
        !Message.IsDeleted &&
        !IsEditing &&
        (!Message.IsEncrypted || !string.IsNullOrEmpty(ChannelKey)) &&
        ImageAttachmentCount >= Spokes_Server.Core.Services.Communication.Chat.AlbumService.AlbumSuggestionPhotoThreshold &&
        (Message.MentionedAlbumIds == null || Message.MentionedAlbumIds.Count == 0);

    private void DismissAlbumPrompt()
    {
        _dismissedAlbumPrompt = true;
        _forceRender = true;
        StateHasChanged();
    }

    private RenderFragment RenderAlbumConversionPrompt() => __builder =>
    {
        if (!EligibleForAlbumConversion || _dismissedAlbumPrompt)
        {
            return;
        }

        <div class="chat-album-prompt d-flex align-center gap-2 mt-2 pa-2 rounded">
            <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Size="Size.Small" Color="Color.Primary" />
            <MudText Typo="Typo.caption" Style="flex: 1;">
                @string.Format(Loc["You posted {0} photos — organize them into an album?"].Value, ImageAttachmentCount)
            </MudText>
            <MudButton Variant="Variant.Filled"
                       Color="Color.Primary"
                       Size="Size.Small"
                       StartIcon="@Icons.Material.Filled.PhotoLibrary"
                       OnClick="@(() => OnCreateAlbumFromMessage.InvokeAsync(Message))">
                @Loc["Create Album"]
            </MudButton>
            <MudIconButton Icon="@Icons.Material.Filled.Close"
                           Size="Size.Small"
                           OnClick="DismissAlbumPrompt" />
        </div>
    };

    private async Task CopyMessageText()
    {
        var textToCopy = EffectiveDecryptedContent ?? Message.Content ?? "";
        if (!string.IsNullOrWhiteSpace(textToCopy))
        {
            await JS.InvokeVoidAsync("navigator.clipboard.writeText", textToCopy);
            Snackbar.Add(Loc["Message text copied to clipboard"].Value, Severity.Success);
        }
    }

    // Tracks whether the component needs to re-render.
    // Without this, every Chat.razor StateHasChanged() causes ALL MessageBubbles
    // to re-render, producing massive DOM diffs that saturate the SignalR connection.
    private string? _lastRenderFingerprint;
    private bool _forceRender = true; // always render on first pass

    internal static string BuildRenderFingerprint(
        int dataVersionHash,
        bool isEditing,
        bool isGrouped,
        bool isOwnMessage,
        string? decryptedContent,
        string? decryptedReplyContent,
        string? channelKey,
        IReadOnlyList<string>? readReceiptUserIds,
        int linkPreviewsCount,
        int skeletonCount,
        bool showEmojiPicker,
        bool isExpanded,
        bool? isInVoiceCall,
        string? currentVoiceChannelId,
        bool isMobile = false,
        bool showMoreMenu = false,
        bool? isVoiceConnecting = null,
        bool isActionSheetTarget = false)
    {
        var readersKey = readReceiptUserIds == null || readReceiptUserIds.Count == 0 ? "0" : string.Join(",", readReceiptUserIds);
        var decContentKey = decryptedContent == null
            ? "\0null"
            : $"{decryptedContent.Length}:{string.GetHashCode(decryptedContent, StringComparison.Ordinal):x8}";
        var decReplyKey = decryptedReplyContent == null
            ? "\0null"
            : $"{decryptedReplyContent.Length}:{string.GetHashCode(decryptedReplyContent, StringComparison.Ordinal):x8}";
        var key = channelKey ?? "\0null";

        return $"{dataVersionHash:x8}|{isEditing}|{isGrouped}|{isOwnMessage}|{decContentKey}|{decReplyKey}|{key}|{readersKey}|{linkPreviewsCount}|{skeletonCount}|{showEmojiPicker}|{showMoreMenu}|{isActionSheetTarget}|{isExpanded}|{isInVoiceCall}_{currentVoiceChannelId}_{isVoiceConnecting}|{isMobile}";
    }

    internal string ComputeRenderFingerprint()
    {
        bool isActiveCallInvite = Message.MessageType == ChatMessageType.CallInvite &&
                                  Message.CallStatus != CallStatus.Ended &&
                                  Message.CallStatus != CallStatus.Declined;
        return BuildRenderFingerprint(
            DataVersionHash,
            IsEditing,
            IsGrouped,
            IsOwnMessage,
            EffectiveDecryptedContent,
            EffectiveDecryptedReplyContent,
            ChannelKey,
            ReadReceiptUserIds,
            _linkPreviews.Count,
            _skeletonCount,
            ShowEmojiPicker,
            _isExpanded,
            isActiveCallInvite ? VoiceService?.IsInVoiceCall : null,
            isActiveCallInvite ? VoiceService?.CurrentChannelId : null,
            IsMobile,
            ShowMoreMenu,
            isActiveCallInvite ? VoiceService?.IsConnecting : null,
            IsActionSheetTarget) + $"|{CanCreateAlbum}|{_dismissedAlbumPrompt}|{ImageAttachmentCount}|{Message.MentionedAlbumIds?.Count ?? 0}|{HideReadReceipts}|{AnonymizeReactions}";
    }

    protected override bool ShouldRender()
    {
        var fingerprint = ComputeRenderFingerprint();

        if (_forceRender)
        {
            _forceRender = false;
            _lastRenderFingerprint = fingerprint;
            return true;
        }

        if (fingerprint == _lastRenderFingerprint)
            return false;

        _lastRenderFingerprint = fingerprint;
        return true;
    }

    protected override void OnParametersSet()
    {
        bool needsVoiceSubscription = Message.MessageType == ChatMessageType.CallInvite &&
                                      Message.CallStatus != CallStatus.Ended &&
                                      Message.CallStatus != CallStatus.Declined;
        if (needsVoiceSubscription && !_subscribedToVoice)
        {
            _lastVoiceInCall = VoiceService.IsInVoiceCall;
            _lastVoiceChannelId = VoiceService.CurrentChannelId;
            _lastVoiceConnecting = VoiceService.IsConnecting;
            VoiceService.OnChange += HandleVoiceChanged;
            _subscribedToVoice = true;
        }
        else if (!needsVoiceSubscription && _subscribedToVoice)
        {
            VoiceService.OnChange -= HandleVoiceChanged;
            _subscribedToVoice = false;
        }

        // Only reload link previews when the effective message text content actually changes.
        // Resolving cached and known-failed URLs synchronously here prevents post-mount
        // render storms (skeleton flash + individual StateHasChanged batches per message).
        var decryptedContent = EffectiveDecryptedContent;
        var effectiveContent = (Message.IsEncrypted && decryptedContent == null)
            ? "\0encrypted-locked"
            : (decryptedContent ?? Message.Content ?? string.Empty);

        if (!string.Equals(_lastPreviewedContent, effectiveContent, StringComparison.Ordinal))
        {
            _lastPreviewedContent = effectiveContent;
            CancelPreviewFetch();
            ResolveLinkPreviewsSynchronouslyOrStartFetch(effectiveContent);
        }
    }

    private void CancelPreviewFetch()
    {
        if (_previewCts != null)
        {
            try { _previewCts.Cancel(); } catch (ObjectDisposedException) { }
            _previewCts.Dispose();
            _previewCts = null;
        }
    }

    private void ResolveLinkPreviewsSynchronouslyOrStartFetch(string effectiveContent)
    {
        _linkPreviews.Clear();
        _skeletonCount = 0;

        if (Message.IsEncrypted && EffectiveDecryptedContent == null)
            return;

        if (string.IsNullOrWhiteSpace(effectiveContent))
            return;

        var urls = LinkPreviews.ExtractUrls(effectiveContent);
        if (urls.Count == 0)
            return;

        List<string>? urlsToFetch = null;
        foreach (var url in urls)
        {
            if (LinkPreviews.TryGetCachedPreview(url, out var cachedPreview))
            {
                if (cachedPreview != null)
                {
                    _linkPreviews.Add(cachedPreview);
                }
            }
            else
            {
                (urlsToFetch ??= []).Add(url);
            }
        }

        if (urlsToFetch is { Count: > 0 })
        {
            _skeletonCount = urlsToFetch.Count;
            _previewCts = new CancellationTokenSource();
            _ = FetchUncachedLinkPreviewsAsync(urlsToFetch, _previewCts.Token);
        }
    }

    private async Task FetchUncachedLinkPreviewsAsync(List<string> urlsToFetch, CancellationToken cancellationToken)
    {
        try
        {
            foreach (var url in urlsToFetch)
            {
                if (cancellationToken.IsCancellationRequested)
                    return;

                var fetched = await LinkPreviews.FetchPreviewAsync(url, cancellationToken);
                if (cancellationToken.IsCancellationRequested)
                    return;

                if (fetched != null)
                {
                    _linkPreviews.Add(fetched);
                }
            }

            _skeletonCount = 0;
            if (cancellationToken.IsCancellationRequested)
                return;

            _forceRender = true;
            await InvokeAsync(StateHasChanged);
        }
        catch (OperationCanceledException) when (cancellationToken.IsCancellationRequested)
        {
            // Component navigated away or content updated
        }
        catch (ObjectDisposedException)
        {
            // Component already disposed
        }
    }

    protected override Task OnAfterRenderAsync(bool firstRender)
    {
        // No-op: CSS overflow-anchor handles scroll-after-preview natively.
        return Task.CompletedTask;
    }

    private RenderFragment RenderLinkPreviews() => __builder =>
    {
        foreach (var preview in _linkPreviews)
        {
            <LinkPreviewCard @key="preview.Url" Preview="preview" />
        }
        for (int i = 0; i < _skeletonCount; i++)
        {
            <LinkPreviewSkeleton />
        }
    };

    private RenderFragment RenderAttachment(ChatAttachment attachment) => __builder =>
    {
        if (IsImageFile(attachment.FileName))
        {
            var imageAttachments = Message.Attachments.Where(a => IsImageFile(a.FileName)).ToList();
            var imageIndex = imageAttachments.IndexOf(attachment);
            bool hasDimensions = attachment.ImageWidth.HasValue && attachment.ImageHeight.HasValue && attachment.ImageHeight.Value > 0;
            
            string dimensionStyle = "min-width: 160px; min-height: 120px;";
            if (hasDimensions)
            {
                var targetWidth = Math.Round(500.0 * attachment.ImageWidth!.Value / attachment.ImageHeight!.Value);
                dimensionStyle = $"width: {targetWidth}px; max-width: 100%; aspect-ratio: {attachment.ImageWidth} / {attachment.ImageHeight}; max-height: 500px;";
            }

            var useThumbnail = attachment.CanUseServerThumbnail;
            var displayUrl = GetTokenizedUrl(attachment, isThumbnail: useThumbnail, includeFileName: false);

            <div class="attachment-image" @onclick="@(() => OnOpenLightbox.InvokeAsync((Message, imageAttachments, imageIndex)))"
                style="@dimensionStyle">
                <div class="attachment-skeleton"></div>
                <img data-media-src="@displayUrl"
                    data-media-priority="chat"
                    data-media-order="@(MessageIndex * 100 + imageIndex)"
                    data-media-encrypted="@(Message.IsEncrypted || !string.IsNullOrEmpty(ChannelKey) ? "true" : null)"
                    alt="@attachment.FileName"
                    decoding="async"
                    class="needs-fade attachment-image-el" />
            </div>
        }
        else if (IsVideoFile(attachment.FileName))
        {
            var videoIndex = Message.Attachments.IndexOf(attachment);
            <ChatVideoAttachment Attachment="attachment" CurrentUserId="@CurrentUserId" SessionId="@EffectiveSessionId" ChannelId="@Message.ChannelId" ChannelKey="@ChannelKey" MediaOrder="@(MessageIndex * 100 + Math.Max(0, videoIndex))" />
        }
        else if (IsAudioFile(attachment.FileName) || (attachment.ContentType != null && attachment.ContentType.StartsWith("audio/")))
        {
            var audioUrl = GetTokenizedUrl(attachment);
            <VoiceMessagePlayer AudioUrl="@audioUrl" />
        }
        else
        {
            <MudPaper Elevation="1" Class="pa-2 d-flex align-center gap-2 chat-file-card">
                <MudIcon Icon="@GetFileIcon(attachment.FileName)" Color="Color.Primary" />
                <div class="flex-grow-1" @onclick="@(() => DownloadOrOpenDocument(attachment))">
                    <MudText Typo="Typo.body2" Color="Color.Primary" Class="mud-link-underline-hover chat-file-card-name">
                        @attachment.FileName
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="cursor-pointer">
                        @FileHelper.FormatBytes(attachment.FileSizeBytes)
                    </MudText>
                </div>
                <MudIconButton Icon="@Icons.Material.Filled.Share" Size="Size.Small" Color="Color.Secondary" OnClick="@(() => ShareDocument(attachment))" />
            </MudPaper>
        }
    };

    private Task CloseActionPopupsAsync() =>
        OnCloseActionPopups.HasDelegate ? OnCloseActionPopups.InvokeAsync() : Task.CompletedTask;

    private IReadOnlyList<string> ResolveQuickReactEmojis()
    {
        if (QuickReactEmojis is { Count: > 0 })
        {
            return QuickReactEmojis;
        }
        var currentEmployee = Employees.FirstOrDefault(e => e.Id == CurrentUserId);
        var recentEmojis = currentEmployee?.RecentEmojis;
        if (recentEmojis == null || recentEmojis.Count == 0)
        {
            return DefaultQuickReactEmojis;
        }
        return recentEmojis.Concat(DefaultQuickReactEmojis).Distinct().Take(3).ToArray();
    }

