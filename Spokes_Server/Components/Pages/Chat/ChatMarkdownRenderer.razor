@using System.Text.RegularExpressions
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.Communication.Presence
@inject MarkdownSanitizerService MarkdownSanitizer
@inject FileTokenService FileTokens
@inject UserCircuitContext CircuitContext
@inject ILogger<ChatMarkdownRenderer> Logger

@* Render markdown content as sanitized HTML, with @mention support *@
<div class="chat-markdown">
    @((MarkupString)_cachedHtml)
</div>
@{
    _shouldRender = false;
}

@code {
    [Parameter] public string Content { get; set; } = "";
    [Parameter] public ChatTextRef? FullContentRef { get; set; }
    [Parameter] public string? MessageId { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public string? ChannelId { get; set; }
    [Parameter] public string? SessionId { get; set; }
    [Parameter] public List<Employee> Employees { get; set; } = [];
    [Parameter] public bool IsEdited { get; set; }
    [Parameter]
    public string? ChannelKey { get; set; }

    /// <summary>
    /// Maximum character length of truncated code block content inlined directly into the DOM's
    /// data-raw-code attribute. Larger collapsed blocks are fetched on demand on Copy click so
    /// multi-hundred-KB pasted logs never bloat SignalR RenderBatches on channel open.
    /// </summary>
    public const int MaxInlineRawCodeChars = 8192;

    private string _cachedHtml = "";
    private string _lastContent = "";
    private string? _lastFullContent;
    private string? _lastMessageId;
    private bool _lastIsEdited;
    private string? _lastChannelKey;
    private string? _lastChannelId;
    private string? _lastSessionId;
    private bool _shouldRender = true;

    protected override bool ShouldRender() => _shouldRender;

    protected override void OnParametersSet()
    {
        var fullContent = FullContentRef?.Value;
        // Re-render markdown only if the content, edit status, or channel/session signing context changes
        if (_lastContent != Content ||
            _lastFullContent != fullContent ||
            _lastMessageId != MessageId ||
            _lastIsEdited != IsEdited ||
            _lastChannelKey != ChannelKey ||
            _lastChannelId != ChannelId ||
            _lastSessionId != SessionId)
        {
            _cachedHtml = RenderMarkdown(Content);
            _lastContent = Content;
            _lastFullContent = fullContent;
            _lastMessageId = MessageId;
            _lastIsEdited = IsEdited;
            _lastChannelKey = ChannelKey;
            _lastChannelId = ChannelId;
            _lastSessionId = SessionId;
            _shouldRender = true;
        }
    }

    // Matches @[Display Name] mention tokens (simple format, no ID)
    private static readonly Regex MentionRegex = new(@"@\[([^\]]+)\]", RegexOptions.Compiled);
    // Matches @everyone
    private static readonly Regex EveryoneMentionRegex = new(@"@everyone\b", RegexOptions.Compiled);
    // Matches #[Title](type:Id)
    private static readonly Regex EntityTagRegex = new(@"#\[([^\]]+)\]\(([a-zA-Z0-9_-]+):[^\)]+\)", RegexOptions.Compiled);
    // Matches ANY image to parse optional #ar= fragment for skeleton loading, and checks for klipy
    private static readonly Regex ImgRegex = new(@"<img([^>]+)src=""([^""]+)""([^>]*)>", RegexOptions.Compiled | RegexOptions.IgnoreCase);
    // Strictly anchored same-origin relative chat file path: /spokesapi/files/chat/{contextId}/{fileName}
    private static readonly Regex SameOriginChatFilePathRegex = new(@"^/spokesapi/files/(chat)/([^/]+)/([^/?#]+)$", RegexOptions.Compiled);

    /// <summary>
    /// Appends a scoped file access token ONLY when <paramref name="rawUrl"/> is a strictly same-origin
    /// relative <c>/spokesapi/files/chat/{contextId}/{fileName}</c> URL whose <c>contextId</c> matches
    /// <paramref name="channelId"/>, and both <paramref name="currentUserId"/> and <paramref name="effectiveSessionId"/>
    /// are non-empty. Never signs external URLs or cross-channel file URLs.
    /// </summary>
    public static string TrySignChatFileUrl(
        string rawUrl,
        string? channelId,
        string? currentUserId,
        string? effectiveSessionId,
        string? channelKey,
        FileTokenService? fileTokens)
    {
        if (string.IsNullOrWhiteSpace(rawUrl) ||
            string.IsNullOrWhiteSpace(channelId) ||
            string.IsNullOrWhiteSpace(currentUserId) ||
            string.IsNullOrWhiteSpace(effectiveSessionId) ||
            fileTokens == null)
        {
            return rawUrl;
        }

        var trimmed = rawUrl.Trim();

        // Reject external origins, protocol-relative URLs, backslashes, or any scheme prefix before the leading '/'
        if (trimmed.StartsWith("http://", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("https://", StringComparison.OrdinalIgnoreCase) ||
            trimmed.StartsWith("//", StringComparison.Ordinal) ||
            trimmed.StartsWith(@"\\", StringComparison.Ordinal) ||
            trimmed.Contains('\\'))
        {
            return rawUrl;
        }

        int colonIndex = trimmed.IndexOf(':');
        int firstSlashIndex = trimmed.IndexOf('/');
        if (firstSlashIndex != 0 || (colonIndex >= 0 && colonIndex < firstSlashIndex))
        {
            return rawUrl;
        }

        if (!trimmed.StartsWith("/spokesapi/files/chat/", StringComparison.Ordinal))
        {
            return rawUrl;
        }

        string fragment = string.Empty;
        string withoutFragment = trimmed;
        int hashIdx = withoutFragment.IndexOf('#');
        if (hashIdx >= 0)
        {
            fragment = withoutFragment[hashIdx..];
            withoutFragment = withoutFragment[..hashIdx];
        }

        string query = string.Empty;
        string pathOnly = withoutFragment;
        int queryIdx = withoutFragment.IndexOf('?');
        if (queryIdx >= 0)
        {
            query = withoutFragment[queryIdx..];
            pathOnly = withoutFragment[..queryIdx];
        }

        var fileMatch = SameOriginChatFilePathRegex.Match(pathOnly);
        if (!fileMatch.Success)
        {
            return rawUrl;
        }

        var category = fileMatch.Groups[1].Value;
        var contextId = System.Net.WebUtility.UrlDecode(fileMatch.Groups[2].Value);
        var fileName = System.Net.WebUtility.UrlDecode(fileMatch.Groups[3].Value);

        if (string.IsNullOrWhiteSpace(fileName) ||
            fileName.Contains('/') ||
            fileName.Contains('\\') ||
            fileName is "." or "..")
        {
            return rawUrl;
        }

        if (!string.Equals(contextId, channelId, StringComparison.Ordinal))
        {
            return rawUrl;
        }

        var token = fileTokens.GenerateAccessToken(category, contextId, fileName, channelKey, currentUserId, effectiveSessionId);
        var signedQuery = string.IsNullOrEmpty(query) ? $"?t={token}" : $"{query}&t={token}";
        return $"{pathOnly}{signedQuery}{fragment}";
    }

    // Matches [code]...[/code] and [code=language]...[/code]
    public static readonly Regex CodeBlockRegex = new(@"\[code(?:=([^\]]+))?\](.*?)\[/code\]", RegexOptions.Compiled | RegexOptions.Singleline | RegexOptions.IgnoreCase);
    private static readonly Regex PreBlockRegex = new(@"<pre>(.*?)</pre>", RegexOptions.Compiled | RegexOptions.Singleline);
    private static readonly Regex SpokesMarkerRegex = new(@"SPOKES_MARKER_([a-zA-Z0-9]+)", RegexOptions.Compiled);

    private string RenderMarkdown(string content)
    {
        if (string.IsNullOrWhiteSpace(content))
            return string.Empty;

        try
        {
            Dictionary<string, (string Code, int BlockIndex)>? codeMap = null;
            var processed = content;

            if (processed.Contains("[code", StringComparison.OrdinalIgnoreCase))
            {
                codeMap = [];
                int matchIndex = 0;
                MatchCollection? fullMatches = null;
                var fullContent = FullContentRef?.Value;
                if (!string.IsNullOrEmpty(fullContent))
                {
                    fullMatches = CodeBlockRegex.Matches(fullContent);
                }

                // Replace [code]...[/code] with robust 10-backtick Markdown fences
                processed = CodeBlockRegex.Replace(processed, match =>
                {
                    var language = match.Groups[1].Success && !string.IsNullOrWhiteSpace(match.Groups[1].Value) ? match.Groups[1].Value : "csharp";
                    var displayedCode = match.Groups[2].Value;
                    int currentBlockIndex = matchIndex;
                    var fullCode = (fullMatches != null && currentBlockIndex < fullMatches.Count)
                        ? fullMatches[currentBlockIndex].Groups[2].Value
                        : displayedCode;
                    matchIndex++;

                    // Only store raw code in codeMap when the displayed code was truncated relative to FullContent
                    if (!string.Equals(fullCode, displayedCode, StringComparison.Ordinal))
                    {
                        var hashBytes = System.Security.Cryptography.MD5.HashData(System.Text.Encoding.UTF8.GetBytes(fullCode));
                        var id = Convert.ToHexString(hashBytes).ToLowerInvariant();
                        codeMap[id] = (fullCode, currentBlockIndex);
                        return $"\n``````````{language}\nSPOKES_MARKER_{id}\n{displayedCode}\n``````````\n";
                    }

                    return $"\n``````````{language}\n{displayedCode}\n``````````\n";
                });
            }

            // Replace @[Name] mention tokens with styled spans
            if (processed.Contains("@[", StringComparison.Ordinal))
            {
                processed = MentionRegex.Replace(processed, match =>
                {
                    var displayName = match.Groups[1].Value;
                    var employee = Employees.FirstOrDefault(e =>
                        e.FullName.Equals(displayName, StringComparison.OrdinalIgnoreCase));
                    var isSelf = employee != null && employee.Id == CurrentUserId;
                    var isTeam = employee == null;

                    string cssClass = isSelf ? "mention mention-self" : (isTeam ? "mention mention-team" : "mention");
                    return $"<span class=\"{cssClass}\">@{System.Net.WebUtility.HtmlEncode(displayName)}</span>";
                });
            }

            // Replace @everyone with highlighted span
            if (processed.Contains("@everyone", StringComparison.Ordinal))
            {
                processed = EveryoneMentionRegex.Replace(processed,
                    "<span class=\"mention mention-special\">@everyone</span>");
            }

            // Replace #[Title](type:Id) with styled pill
            if (processed.Contains("#[", StringComparison.Ordinal))
            {
                processed = EntityTagRegex.Replace(processed, match =>
                {
                    var title = System.Net.WebUtility.HtmlEncode(match.Groups[1].Value);
                    var type = match.Groups[2].Value.ToLowerInvariant();
                    
                    if (type == "album" || type == "event" || type == "poll")
                    {
                        return string.Empty;
                    }
                    
                    string icon = type switch
                    {
                        "project" => "📁",
                        "quote" => "📄",
                        "invoice" => "🧾",
                        _ => "📎"
                    };

                    return $"<span class=\"mention\" style=\"background-color: color-mix(in srgb, var(--mud-palette-info) 15%, transparent); color: var(--mud-palette-info);\">{icon} {title}</span>";
                });
            }

            var html = MarkdownSanitizer.RenderSanitizedHtml(processed);

            // Apply GIF Aspect Ratio Skeletons and Klipy Watermarks
            if (html.Contains("<img", StringComparison.OrdinalIgnoreCase))
            {
                html = ImgRegex.Replace(html, match =>
                {
                    var beforeSrc = match.Groups[1].Value;
                    var rawUrl = match.Groups[2].Value;
                    var afterSrc = match.Groups[3].Value;

                    var signedUrl = TrySignChatFileUrl(
                        rawUrl,
                        ChannelId,
                        CurrentUserId,
                        SessionId ?? CircuitContext?.SessionId,
                        ChannelKey,
                        FileTokens);

                    bool isSignedSameOriginChatFile = !string.Equals(signedUrl, rawUrl, StringComparison.Ordinal)
                        || (signedUrl.StartsWith("/spokesapi/files/chat/", StringComparison.Ordinal) && signedUrl.Contains("t=", StringComparison.Ordinal));
                    rawUrl = signedUrl;

                    bool isKlipy = rawUrl.Contains("klipy.com", StringComparison.OrdinalIgnoreCase) || rawUrl.Contains("klipy.co", StringComparison.OrdinalIgnoreCase);
                    string watermarkHtml = isKlipy ? @"<img src=""/Klipy/KLIPY Light with logo.svg"" class=""klipy-watermark"" alt=""Klipy Watermark"" />" : "";

                    var fragmentMatch = Regex.Match(rawUrl, @"#ar=([0-9.]+)");
                    if (fragmentMatch.Success)
                    {
                        var arStr = fragmentMatch.Groups[1].Value;
                        var cleanUrl = rawUrl.Replace(fragmentMatch.Value, "");
                        if (isSignedSameOriginChatFile)
                        {
                            var encAttr = !string.IsNullOrEmpty(ChannelKey) ? @" data-media-encrypted=""true""" : "";
                            return $@"<span class=""gif-container"" style=""aspect-ratio: {arStr};""><img{beforeSrc}data-media-src=""{cleanUrl}"" data-media-priority=""chat""{encAttr}{afterSrc} onload=""this.style.opacity='1'; this.parentElement.style.backgroundColor='transparent';"">{watermarkHtml}</span>";
                        }
                        return $@"<span class=""gif-container"" style=""aspect-ratio: {arStr};""><img{beforeSrc}src=""{cleanUrl}""{afterSrc} onload=""this.style.opacity='1'; this.parentElement.style.backgroundColor='transparent';"">{watermarkHtml}</span>";
                    }
                    else if (isKlipy)
                    {
                        // Fallback for legacy klipy GIFs without aspect ratio
                        return $@"<span class=""klipy-gif-container""><img{beforeSrc}src=""{rawUrl}""{afterSrc}>{watermarkHtml}</span>";
                    }

                    if (isSignedSameOriginChatFile)
                    {
                        var encAttr = !string.IsNullOrEmpty(ChannelKey) ? @" data-media-encrypted=""true""" : "";
                        return $@"<img{beforeSrc}data-media-src=""{rawUrl}"" data-media-priority=""chat""{encAttr}{afterSrc}>";
                    }

                    return $@"<img{beforeSrc}src=""{rawUrl}""{afterSrc}>";
                });
            }

            // Wrap <pre> blocks with a modern container and a declarative Copy button
            // (click handling is delegated globally by window.spokesCopyCodeButton in spokesbridge.js).
            if (html.Contains("<pre>", StringComparison.Ordinal))
            {
                var copyLabel = System.Net.WebUtility.HtmlEncode(Loc["Copy"].Value);
                var copiedLabel = System.Net.WebUtility.HtmlEncode(Loc["Copied"].Value);
                html = PreBlockRegex.Replace(html, match =>
                {
                    var preContent = match.Groups[1].Value;
                    string rawCodeAttr = "";
                    if (codeMap is { Count: > 0 } && preContent.Contains("SPOKES_MARKER_", StringComparison.Ordinal))
                    {
                        var markerMatch = SpokesMarkerRegex.Match(preContent);
                        if (markerMatch.Success)
                        {
                            var id = markerMatch.Groups[1].Value;
                            if (codeMap.TryGetValue(id, out var mappedEntry) && !string.IsNullOrEmpty(mappedEntry.Code))
                            {
                                if (mappedEntry.Code.Length <= MaxInlineRawCodeChars)
                                {
                                    rawCodeAttr = $@" data-raw-code=""{System.Net.WebUtility.HtmlEncode(mappedEntry.Code)}""";
                                }
                                else if (!string.IsNullOrEmpty(MessageId))
                                {
                                    rawCodeAttr = $@" data-copy-msg-id=""{System.Net.WebUtility.HtmlEncode(MessageId)}"" data-copy-code-idx=""{mappedEntry.BlockIndex}""";
                                }
                            }
                            preContent = Regex.Replace(preContent, $@"<span[^>]*>SPOKES_MARKER_{id}</span>\r?\n?", "");
                            preContent = Regex.Replace(preContent, $@"SPOKES_MARKER_{id}\r?\n?", "");
                        }
                    }

                    return $@"<div class=""code-block-wrapper""><button type=""button"" class=""copy-code-btn"" data-copied-label=""{copiedLabel}""{rawCodeAttr}><svg class=""copy-code-icon"" viewBox=""0 0 24 24"" aria-hidden=""true""><use href=""#spokes-icon-copy"" /></svg>{copyLabel}</button><pre>{preContent}</pre></div>";
                });
            }

            if (IsEdited)
            {
                var insertHtml = $@" <span class=""edited-tag"" style=""font-size: 0.65rem; color: var(--mud-palette-text-disabled); user-select: none; margin-left: 4px;"">({Loc["Edited"].Value.ToLowerInvariant()})</span>";
                html = html.TrimEnd();
                if (html.EndsWith("</p>"))
                {
                    html = html[..^4] + insertHtml + "</p>";
                }
                else
                {
                    html += insertHtml;
                }
            }

            return html;
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[ChatMarkdownRenderer] ERROR rendering markdown");
            return System.Net.WebUtility.HtmlEncode(content);
        }
    }
}
