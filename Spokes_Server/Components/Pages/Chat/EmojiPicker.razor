@inject IJSRuntime JSRuntime
@inject Database Db
@inject UserService UserService
@inject EmployeeRepository EmployeeRepo
@inject ChatStateService ChatState
@inject IGifSearchService GifSearchService
@inject StartupTimingService StartupTimings
@inject ILogger<EmojiPicker> Logger
@implements IDisposable

@if (IsOpen)
{
    @* Invisible backdrop for click-away *@
    <div data-spokes-back-dismiss="emoji-picker" style="position: fixed; inset: 0; z-index: 199;" @onclick="HandleBackdropClick" @onclick:stopPropagation="true"></div>

    <MudPaper Elevation="6" Class="@($"emoji-picker pa-2 d-flex flex-column {Class}")"
        Style="@($"{ContainerStyle}")">
        
        @if (_hasGifConfig && !DisableGifs)
        {
            <div class="d-flex justify-center mb-2 mt-1 flex-shrink-0">
                <MudToggleGroup T="string" Value="@ActiveTab" ValueChanged="OnTabChanged" SelectionMode="SelectionMode.SingleSelection" Size="Size.Small" Color="Color.Primary" Style="width: 100%;">
                    <MudToggleItem Value="@("Emoji")">@Loc["Emojis"]</MudToggleItem>
                    <MudToggleItem Value="@("Gif")">@Loc["GIFs"]</MudToggleItem>
                </MudToggleGroup>
            </div>
        }

        @* Unified Search *@
        <MudTextField @ref="_sharedSearchField"
            T="string"
            @bind-Value="_sharedSearchText"
            DebounceInterval="250"
            OnDebounceIntervalElapsed="OnSearchDebounced"
            OnKeyDown="OnSearchKeyDown"
            Clearable="true"
            OnClearButtonClick="OnSearchCleared"
            Placeholder="@(ActiveTab == "Emoji" ? Loc["Search emoji..."].Value : (_activeGifProvider == "Klipy" ? Loc["Search KLIPY"].Value : Loc["Search GIFs..."].Value))"
            Variant="Variant.Outlined"
            Margin="Margin.Dense"
            Adornment="Adornment.Start"
            AdornmentIcon="@Icons.Material.Filled.Search"
            Class="mb-2 flex-shrink-0"
            Style="font-size: 0.85rem;" />

        @if (ActiveTab == "Emoji")
        {
            @* Category Tabs *@
            @* @if (string.IsNullOrEmpty(_searchText))
            {
                <div class="d-flex gap-1 mb-2 px-1 flex-shrink-0" style="overflow-x: auto; scrollbar-width: thin;">
                    @if (_recentEmojis.Any())
                    {
                        var isRecentActive = "Recent" == _selectedCategory;
                        <MudIconButton Size="Size.Small"
                            Style="@(isRecentActive ? "background: var(--mud-palette-primary); color: white; border-radius: 8px;" : "border-radius: 8px;")"
                            OnClick="@(() => ScrollToCategory("Recent"))">
                            @GetCategoryIcon("Recent")
                        </MudIconButton>
                    }
                    @foreach (var cat in EmojiData.Categories.Keys)
                    {
                        var isActive = cat == _selectedCategory;
                        <MudIconButton Size="Size.Small"
                            Style="@(isActive ? "background: var(--mud-palette-primary); color: white; border-radius: 8px;" : "border-radius: 8px;")"
                            OnClick="@(() => ScrollToCategory(cat))">
                            @GetCategoryIcon(cat)
                        </MudIconButton>
                    }
                </div>
            } *@

            <div style="overflow-y: auto; flex-grow: 1; scrollbar-width: thin; width: 100%; display: flex; flex-direction: column; justify-content: flex-start; min-height: 0;">
                @{
                    var virtualizedItems = GetVirtualizedItems();
                }
                @if (!virtualizedItems.Any())
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-4">
                        @Loc["No emojis found"]
                    </MudText>
                }
                else
                {
                    <Virtualize Items="@virtualizedItems" Context="item" ItemSize="36">
                        @if (item.IsHeader)
                        {
                            <MudText id="@($"emoji-cat-{item.HeaderText}")" Typo="Typo.caption" Color="Color.Secondary" Class="px-1 mt-1 mb-1" Style="font-weight: 600;">
                                @GetLocalizedCategory(item.HeaderText)
                            </MudText>
                        }
                        else
                        {
                            <div class="d-flex justify-start align-start w-100" style="flex-wrap: nowrap;">
                                @foreach (var emoji in item.Emojis)
                                {
                                    <div class="emoji-item" @onclick="@(() => SelectEmoji(emoji))" title="@emoji">
                                        @emoji
                                    </div>
                                }
                            </div>
                        }
                    </Virtualize>
                }
            </div>
        }
        else if (ActiveTab == "Gif")
        {
            <div @ref="_gifScrollContainerRef" style="overflow-y: auto; flex-grow: 1; scrollbar-width: thin; width: 100%; display: flex; flex-direction: column; justify-content: flex-start; min-height: 0;">
                @if (_isSearchingGifs && !_gifResults.Any())
                {
                    <div class="w-100 d-flex justify-center mt-4">
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                    </div>
                }
                else if (!string.IsNullOrEmpty(_gifError) && !_gifResults.Any())
                {
                    <div class="d-flex flex-column align-center pa-4 w-100 gap-2">
                        <MudText Typo="Typo.caption" Color="Color.Error" Align="Align.Center">
                            @_gifError
                        </MudText>
                        <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="RetryInitialGifSearchAsync">
                            @Loc["Retry"]
                        </MudButton>
                    </div>
                }
                else if (_gifResults.Any())
                {
                    <div class="d-flex gap-1 px-1 w-100 align-start">
                        <div class="d-flex flex-column gap-1" style="flex: 1; min-width: 0;">
                            @for (int i = 0; i < _gifResults.Count; i += 2)
                            {
                                var gif = _gifResults[i];
                                <div @key="gif.Url" class="gif-picker-tile" style="@(gif.AspectRatio.HasValue ? $"aspect-ratio: {gif.AspectRatio.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)};" : "min-height: 100px;")">
                                    <img src="@gif.PreviewUrl" @onclick="@(() => SelectGif(gif.Url, gif.AspectRatio))" alt="GIF" loading="lazy" decoding="async"
                                        style="@(gif.AspectRatio.HasValue ? "height: 100%; object-fit: cover;" : "height: auto;")"
                                        class="gif-item" />
                                </div>
                            }
                        </div>
                        <div class="d-flex flex-column gap-1" style="flex: 1; min-width: 0;">
                            @for (int i = 1; i < _gifResults.Count; i += 2)
                            {
                                var gif = _gifResults[i];
                                <div @key="gif.Url" class="gif-picker-tile" style="@(gif.AspectRatio.HasValue ? $"aspect-ratio: {gif.AspectRatio.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)};" : "min-height: 100px;")">
                                    <img src="@gif.PreviewUrl" @onclick="@(() => SelectGif(gif.Url, gif.AspectRatio))" alt="GIF" loading="lazy" decoding="async"
                                        style="@(gif.AspectRatio.HasValue ? "height: 100%; object-fit: cover;" : "height: auto;")"
                                        class="gif-item" />
                                </div>
                            }
                        </div>
                    </div>
                    @if (_isSearchingGifs)
                    {
                        <div class="w-100 d-flex justify-center mt-2 mb-2 flex-shrink-0">
                            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
                        </div>
                    }
                    else if (!string.IsNullOrEmpty(_gifAppendError))
                    {
                        <div class="d-flex flex-column align-center py-2 px-3 w-100 gap-1 flex-shrink-0">
                            <MudText Typo="Typo.caption" Color="Color.Error" Align="Align.Center">
                                @_gifAppendError
                            </MudText>
                            <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Primary" OnClick="LoadMoreGifs">
                                @Loc["Retry"]
                            </MudButton>
                        </div>
                    }
                    else if (_hasMoreGifs)
                    {
                        <div @ref="_gifSentinelRef" class="gif-scroll-sentinel" style="height: 20px; width: 100%; flex-shrink: 0;"></div>
                    }
                }
                else if (!string.IsNullOrWhiteSpace(_sharedSearchText))
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-4 w-100 mt-4">
                        @Loc["No GIFs found"]
                    </MudText>
                }
                else if (_recentGifs.Any())
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="w-100 px-1 mt-1 mb-1" Style="font-weight: 600;">
                        @Loc["Recent"]
                    </MudText>
                    <div class="d-flex gap-1 px-1 w-100 align-start">
                        <div class="d-flex flex-column gap-1" style="flex: 1; min-width: 0;">
                            @for (int i = 0; i < _recentGifs.Count; i += 2)
                            {
                                var url = _recentGifs[i];
                                double? ar = null;
                                if (url.Contains("#ar=")) {
                                    var parts = url.Split("#ar=");
                                    if (double.TryParse(parts[1], System.Globalization.CultureInfo.InvariantCulture, out double parsedAr)) {
                                        ar = parsedAr;
                                    }
                                }
                                <div @key="url" class="gif-picker-tile" style="@(ar.HasValue ? $"aspect-ratio: {ar.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)};" : "min-height: 100px;")">
                                    <img src="@url" @onclick="@(() => SelectGif(url, ar))" alt="GIF" loading="lazy" decoding="async"
                                        style="@(ar.HasValue ? "height: 100%; object-fit: cover;" : "height: auto;")"
                                        class="gif-item" />
                                </div>
                            }
                        </div>
                        <div class="d-flex flex-column gap-1" style="flex: 1; min-width: 0;">
                            @for (int i = 1; i < _recentGifs.Count; i += 2)
                            {
                                var url = _recentGifs[i];
                                double? ar = null;
                                if (url.Contains("#ar=")) {
                                    var parts = url.Split("#ar=");
                                    if (double.TryParse(parts[1], System.Globalization.CultureInfo.InvariantCulture, out double parsedAr)) {
                                        ar = parsedAr;
                                    }
                                }
                                <div @key="url" class="gif-picker-tile" style="@(ar.HasValue ? $"aspect-ratio: {ar.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)};" : "min-height: 100px;")">
                                    <img src="@url" @onclick="@(() => SelectGif(url, ar))" alt="GIF" loading="lazy" decoding="async"
                                        style="@(ar.HasValue ? "height: 100%; object-fit: cover;" : "height: auto;")"
                                        class="gif-item" />
                                </div>
                            }
                        </div>
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Align="Align.Center" Class="pa-4 w-100 mt-4">
                        @Loc["Type to search GIFs"]
                    </MudText>
                }
            </div>
        }
    </MudPaper> 
}

<style>
    .emoji-picker {
        box-shadow: 0 8px 32px rgba(0, 0, 0, 0.25);
        width: 340px;
        max-width: calc(100vw - 16px);
        height: 420px;
        max-height: 75vh;
        z-index: 200;
        margin-bottom: 4px;
        border-radius: 12px;
    }

    @@media (max-width: 960px) {
        .emoji-picker {
            height: 420px;
            max-height: calc(var(--viewport-height, 100vh) - 150px);
            min-height: 250px;
        }
    }

    .emoji-item {
        width: 36px;
        height: 36px;
        display: flex;
        align-items: center;
        justify-content: center;
        font-size: 1.3rem;
        border-radius: 8px;
        cursor: pointer;
        transition: background-color 0.15s, transform 0.1s;
        user-select: none;
    }

    .emoji-item:hover {
        background-color: var(--mud-palette-action-default-hover);
        transform: scale(1.2);
    }
</style>

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback<string> OnEmojiSelected { get; set; }
    [Parameter] public EventCallback<string> OnGifSelected { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public string ContainerStyle { get; set; } = "position: absolute; bottom: 100%; right: 0;";
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public bool AutoFocusSearch { get; set; } = true;
    [Parameter] public bool DisableGifs { get; set; }

    private string ActiveTab { get; set; } = "Emoji";
    private string _sharedSearchText = "";
    private List<string> _recentEmojis = [];
    private Employee? _currentEmployee;
    
    private MudTextField<string>? _sharedSearchField;
    private bool _wasOpen;
    private string _previousTab = "Emoji";

    // GIF Integration
    private bool _hasGifConfig;
    private string _activeGifProvider = "";
    private List<string> _recentGifs = [];
    private bool _isSearchingGifs;
    private string _gifError = "";
    private string _gifAppendError = "";
    private string _lastSearchedQuery = "";
    private List<GifItem> _gifResults = [];
    private bool _hasMoreGifs = true;
    private int _gifOffset;
    private string _nextCursor = "";
    private DotNetObjectReference<EmojiPicker>? _objRef;
    private ElementReference _gifScrollContainerRef;
    private ElementReference _gifSentinelRef;
    private readonly string _scrollObserverKey = $"gif-scroll-{Guid.NewGuid():N}";
    private bool _observerAttached;
    private Guid _currentSearchId = Guid.Empty;
    private CancellationTokenSource? _searchCts;
    private bool _disposed;

    protected override async Task OnInitializedAsync()
    {
        StartupTimings.AddChatTransition("Server: EmojiPicker OnInitializedAsync Start");
        _currentEmployee = await UserService.GetEmployeeAsync();
        if (_currentEmployee != null)
        {
            _recentEmojis = _currentEmployee.RecentEmojis.ToList();
            _recentGifs = _currentEmployee.RecentGifs.ToList();
            _recentEmojisVersion++;
        }
        
        var profile = Db.CompanyProfile.Get();
        if (!string.IsNullOrEmpty(profile.GifProvider) && profile.GifProvider != "None" && (!string.IsNullOrEmpty(profile.GifApiKey) || profile.GifProvider == "Spokes Default Provider"))
        {
            _hasGifConfig = true;
            _activeGifProvider = profile.GifProvider == "Spokes Default Provider" ? "Klipy" : profile.GifProvider;
        }
        StartupTimings.AddChatTransition("Server: EmojiPicker OnInitializedAsync Done");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _objRef == null)
        {
            _objRef = DotNetObjectReference.Create(this);
        }

        bool shouldObserveSentinel = IsOpen
            && ActiveTab == "Gif"
            && _objRef != null
            && _gifResults.Any()
            && _hasMoreGifs
            && !_isSearchingGifs
            && string.IsNullOrEmpty(_gifAppendError);

        if (shouldObserveSentinel)
        {
            try
            {
                await JSRuntime.InvokeVoidAsync(
                    "spokesInfiniteScroll.observe",
                    _scrollObserverKey,
                    _gifScrollContainerRef,
                    _gifSentinelRef,
                    _objRef,
                    nameof(LoadMoreGifs),
                    "200px");
                _observerAttached = true;
            }
            catch { }
        }
        else if (_observerAttached)
        {
            _observerAttached = false;
            try
            {
                await JSRuntime.InvokeVoidAsync("spokesInfiniteScroll.disconnect", _scrollObserverKey);
            }
            catch { }
        }

        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            if (AutoFocusSearch) await FocusActiveSearchField();
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            CancelActiveSearch();
        }

        if (IsOpen && ActiveTab != _previousTab)
        {
            _previousTab = ActiveTab;
            if (AutoFocusSearch) await FocusActiveSearchField();
        }
    }

    private async Task FocusActiveSearchField()
    {
        try
        {
            if (_sharedSearchField != null)
            {
                await _sharedSearchField.FocusAsync();
            }
        }
        catch { }
    }

    [JSInvokable]
    public async Task LoadMoreGifs()
    {
        if (!_disposed && !_isSearchingGifs && _hasMoreGifs && _gifResults.Any())
        {
            await SearchGifsAsync(append: true);
        }
    }

    public void Dispose()
    {
        _disposed = true;
        CancelActiveSearch();
        if (_observerAttached)
        {
            _observerAttached = false;
            try { _ = JSRuntime.InvokeVoidAsync("spokesInfiniteScroll.disconnect", _scrollObserverKey); } catch { }
        }
        _objRef?.Dispose();
        _objRef = null;
    }

    private void CancelActiveSearch()
    {
        var cts = _searchCts;
        _searchCts = null;
        if (cts != null)
        {
            try { cts.Cancel(); } catch { }
            cts.Dispose();
        }
    }

    private async Task OnTabChanged(string newTab)
    {
        if (ActiveTab == "Gif" && newTab != "Gif")
        {
            CancelActiveSearch();
            _isSearchingGifs = false;
        }

        ActiveTab = newTab;
        if (newTab == "Gif")
        {
            var query = (_sharedSearchText ?? string.Empty).Trim();
            _sharedSearchText = query;
            if (!string.IsNullOrWhiteSpace(query) && (!_gifResults.Any() || !string.Equals(_lastSearchedQuery, query, StringComparison.OrdinalIgnoreCase)))
            {
                await SearchGifsAsync(append: false);
            }
        }
    }

    private async Task OnSearchDebounced(string text)
    {
        _sharedSearchText = text ?? string.Empty;

        if (ActiveTab != "Gif")
        {
            return;
        }

        if (!string.IsNullOrWhiteSpace(_sharedSearchText))
        {
            await SearchGifsAsync(append: false);
        }
        else
        {
            ResetGifSearchState();
        }
    }

    private async Task OnSearchKeyDown(KeyboardEventArgs e)
    {
        if (ActiveTab == "Gif" && e.Key == "Enter")
        {
            var currentText = _sharedSearchText ?? string.Empty;
            _sharedSearchText = currentText;
            if (!string.IsNullOrWhiteSpace(currentText))
            {
                await SearchGifsAsync(append: false);
            }
            else
            {
                ResetGifSearchState();
            }
        }
    }

    private void OnSearchCleared()
    {
        _sharedSearchText = string.Empty;
        ResetGifSearchState();
    }

    private Task RetryInitialGifSearchAsync() => SearchGifsAsync(append: false);

    private void ResetGifSearchState()
    {
        CancelActiveSearch();
        _currentSearchId = Guid.NewGuid();
        _isSearchingGifs = false;
        _gifResults.Clear();
        _gifError = string.Empty;
        _gifAppendError = string.Empty;
        _lastSearchedQuery = string.Empty;
        _hasMoreGifs = true;
        _gifOffset = 0;
        _nextCursor = string.Empty;
    }

    private async Task SearchGifsAsync(bool append = false)
    {
        var query = (_sharedSearchText ?? string.Empty).Trim();
        if (string.IsNullOrWhiteSpace(query))
        {
            ResetGifSearchState();
            StateHasChanged();
            return;
        }

        if (append && !_hasMoreGifs)
        {
            return;
        }

        Guid searchId;
        if (!append)
        {
            CancelActiveSearch();
            searchId = Guid.NewGuid();
            _currentSearchId = searchId;
            _lastSearchedQuery = query;
            _gifResults.Clear();
            _gifOffset = 0;
            _nextCursor = string.Empty;
            _hasMoreGifs = true;
            _gifError = string.Empty;
            _gifAppendError = string.Empty;
        }
        else
        {
            searchId = _currentSearchId;
            _gifAppendError = string.Empty;
        }

        var cts = new CancellationTokenSource();
        if (!append)
        {
            _searchCts = cts;
        }
        else
        {
            CancelActiveSearch();
            _searchCts = cts;
        }

        _isSearchingGifs = true;
        await InvokeAsync(StateHasChanged);

        try
        {
            var result = await GifSearchService.SearchGifsAsync(
                query,
                _gifOffset,
                _nextCursor,
                append,
                cts.Token);

            if (_disposed || _currentSearchId != searchId) return;

            if (!string.IsNullOrEmpty(result.ErrorMessage))
            {
                if (append && _gifResults.Any())
                {
                    _gifAppendError = result.ErrorMessage;
                }
                else
                {
                    _gifError = result.ErrorMessage;
                }
                return;
            }

            _hasMoreGifs = result.HasMore;
            _nextCursor = result.NextCursor;
            _gifOffset = result.NewOffset;

            int newlyAdded = 0;
            foreach (var item in result.Results)
            {
                if (!_gifResults.Any(g => g.Url == item.Url))
                {
                    _gifResults.Add(item);
                    newlyAdded++;
                }
            }

            if (append && newlyAdded == 0)
            {
                _hasMoreGifs = false;
            }
        }
        catch (OperationCanceledException)
        {
            // Superseded by a newer search, clear, tab switch, or component disposal.
        }
        catch (Exception ex)
        {
            if (!_disposed && _currentSearchId == searchId)
            {
                var fallbackMsg = Loc["Error fetching GIFs. Please check your connection."].Value;
                if (append && _gifResults.Any())
                {
                    _gifAppendError = fallbackMsg;
                }
                else
                {
                    _gifError = fallbackMsg;
                }
            }
            Logger.LogError(ex, "GIF Search Error");
        }
        finally
        {
            if (ReferenceEquals(_searchCts, cts))
            {
                _searchCts = null;
            }
            cts.Dispose();

            if (!_disposed && _currentSearchId == searchId)
            {
                _isSearchingGifs = false;
                await InvokeAsync(StateHasChanged);
            }
        }
    }

    private async Task HandleBackdropClick()
    {
        await OnClose.InvokeAsync();
    }

    private async Task SelectEmoji(string emoji)
    {
        _recentEmojis.Remove(emoji);
        _recentEmojis.Insert(0, emoji);
        if (_recentEmojis.Count > 27)
        {
            _recentEmojis = _recentEmojis.Take(27).ToList();
        }
        _recentEmojisVersion++;
        
        if (_currentEmployee != null)
        {
            _currentEmployee.RecentEmojis = _recentEmojis.ToList();
            EmployeeRepo.Save(_currentEmployee);
            ChatState.NotifyEmployeeProfileUpdated(_currentEmployee);
        }

        await OnEmojiSelected.InvokeAsync(emoji);
    }

    private async Task SelectGif(string url, double? aspectRatio = null)
    {
        var finalUrl = url;
        if (aspectRatio.HasValue && !url.Contains("#ar="))
        {
            finalUrl = $"{url}#ar={aspectRatio.Value.ToString(System.Globalization.CultureInfo.InvariantCulture)}";
        }

        _recentGifs.Remove(finalUrl);
        _recentGifs.Insert(0, finalUrl);
        if (_recentGifs.Count > 20)
        {
            _recentGifs = _recentGifs.Take(20).ToList();
        }
        
        if (_currentEmployee != null)
        {
            _currentEmployee.RecentGifs = _recentGifs.ToList();
            EmployeeRepo.Save(_currentEmployee);
            ChatState.NotifyEmployeeProfileUpdated(_currentEmployee);
        }

        await OnGifSelected.InvokeAsync(finalUrl);
        
        // Reset state for when picker is re-opened
        _sharedSearchText = string.Empty;
        ResetGifSearchState();
    }

    private class VirtualizeItem
    {
        public bool IsHeader { get; set; }
        public string HeaderText { get; set; } = "";
        public List<string> Emojis { get; set; } = [];
    }

    private List<VirtualizeItem>? _cachedVirtualizedItems;
    private string? _cachedVirtualizedSearch;
    private int _recentEmojisVersion;
    private int _cachedRecentEmojisVersion = -1;

    private List<VirtualizeItem> GetVirtualizedItems()
    {
        var searchKey = _sharedSearchText ?? string.Empty;
        if (_cachedVirtualizedItems != null &&
            _cachedRecentEmojisVersion == _recentEmojisVersion &&
            string.Equals(_cachedVirtualizedSearch, searchKey, StringComparison.Ordinal))
        {
            return _cachedVirtualizedItems;
        }

        List<VirtualizeItem> items = [];
        var emojisToShow = GetFilteredEmojis();
        int itemsPerRow = 8;

        foreach (var group in emojisToShow)
        {
            if (string.IsNullOrEmpty(searchKey))
            {
                items.Add(new VirtualizeItem { IsHeader = true, HeaderText = group.Key });
            }

            var emojisList = group.Value;
            for (int i = 0; i < emojisList.Count; i += itemsPerRow)
            {
                items.Add(new VirtualizeItem
                {
                    IsHeader = false,
                    Emojis = emojisList.Skip(i).Take(itemsPerRow).ToList()
                });
            }
        }

        _cachedVirtualizedItems = items;
        _cachedVirtualizedSearch = searchKey;
        _cachedRecentEmojisVersion = _recentEmojisVersion;
        return items;
    }

    private Dictionary<string, List<string>> GetFilteredEmojis()
    {
        if (!string.IsNullOrWhiteSpace(_sharedSearchText))
        {
            // Flat list of matching results
            List<string> matchedEmojis = [];
            foreach (var cat in EmojiData.Categories)
            {
                var matched = cat.Value.Where(e =>
                EmojiData.Keywords.TryGetValue(e, out var kw) &&
                kw.Contains(_sharedSearchText, StringComparison.OrdinalIgnoreCase)).ToList();
                
                if (matched.Any())
                    matchedEmojis.AddRange(matched);
            }
            Dictionary<string, List<string>> results = [];
            if (matchedEmojis.Any())
                results["Search Results"] = matchedEmojis;
            return results;
        }

        // Show all categories
        Dictionary<string, List<string>> result = [];
        
        if (_recentEmojis.Any())
        {
            result["Recent"] = _recentEmojis;
        }
        
        foreach(var c in EmojiData.Categories)
            result[c.Key] = c.Value;

        return result;
    }

    private string GetCategoryIcon(string category) => category switch
    {
        "Recent" => "🕒",
        "Smileys & Emotion" => "😀",
        "People & Body" => "👋",
        "Animals & Nature" => "🌿",
        "Food & Drink" => "🍕",
        "Activities" => "⚽",
        "Travel & Places" => "✈️",
        "Objects" => "💡",
        "Symbols" => "❤️",
        "Flags" => "🏁",
        _ => "❓"
    };

    private string GetLocalizedCategory(string category) => Loc[category].Value;
}
