    public async ValueTask DisposeAsync()
    {
        StartupTimings.AddChatTransition($"Server: ChatComposer[{_diagTag}] DisposeAsync"); // DIAG-TEMP
        ShareTargetStateService.OnPayloadReceived -= HandlePayloadReceived;
        if (_typingTimer != null && _typingTimer.Enabled && ChannelId != null && CurrentUserId != null)
        {
            _typingTimer.Stop();
            _ = ChatService.StopTypingAsync(CurrentUserId, ChannelId);
        }
        if (CurrentUserId != null)
        {
            UserClientStateService.FlushToDiskIfUnsent(CurrentUserId);
        }
        _typingTimer?.Dispose();
        _objRef?.Dispose();
        if (_jsModule != null)
        {
            try { await _jsModule.DisposeAsync(); } catch (Exception) { /* Silent ignore */ }
        }
    }

