    private async Task HandleApiUploadStarted()
    {
        _pendingFiles.Add(new PendingFile { FileName = "Uploading Files...", IsUploading = true, UploadProgress = 0 });
        StateHasChanged();

        if (_messageFieldDesktop != null)
        {
            await _messageFieldDesktop.FocusAsync();
        }
        else if (_messageField != null)
        {
            await _messageField.FocusAsync();
        }
    }

    private void HandleApiUploadCompleted(List<ApiFileUpload.UploadResult> results)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder != null) _pendingFiles.Remove(placeholder);

        foreach (var r in results)
        {
            var attachment = new ChatAttachment {
                Id = Guid.NewGuid().ToString(),
                FileName = r.FileName,
                FilePath = r.FilePath,
                ContentType = r.ContentType,
                FileSizeBytes = r.FileSizeBytes,
                HasServerThumbnail = r.HasThumbnail,
                ImageWidth = r.ImageWidth,
                ImageHeight = r.ImageHeight
            };
            _pendingFiles.Add(new PendingFile { FileName = r.FileName, IsUploading = false, Attachment = attachment });
        }
        StateHasChanged();
    }

    private void HandleVoiceUploadCompleted(List<ApiFileUpload.UploadResult> results)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder != null) _pendingFiles.Remove(placeholder);
        
        var voiceAttachments = new List<ChatAttachment>();

        foreach (var r in results)
        {
            var attachment = new ChatAttachment {
                Id = Guid.NewGuid().ToString(),
                FileName = r.FileName,
                FilePath = r.FilePath,
                ContentType = r.ContentType,
                FileSizeBytes = r.FileSizeBytes,
                HasServerThumbnail = r.HasThumbnail,
                ImageWidth = r.ImageWidth,
                ImageHeight = r.ImageHeight
            };
            voiceAttachments.Add(attachment);
        }
        
        StateHasChanged();

        _ = InvokeAsync(async () => {
            if (CurrentUserId == null || ChannelId == null) return;
            try
            {
                await OnSendMessage.InvokeAsync(("", voiceAttachments));
            }
            catch (Exception ex)
            {
                foreach (var v in voiceAttachments) {
                    _pendingFiles.Add(new PendingFile { FileName = v.FileName, IsUploading = false, Attachment = v });
                }
                StateHasChanged();
                Snackbar.Add($"Error sending voice message: {ex.Message}", Severity.Error);
            }
        });
    }

    private void HandleApiUploadError(string error)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder != null) _pendingFiles.Remove(placeholder);
        
        Snackbar.Add($"Upload failed: {error}", Severity.Error);
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPasteUploadStarted()
    {
        await HandleApiUploadStarted();
    }

    [JSInvokable]
    public void OnPasteCompressingUpdate(double progress)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder == null)
        {
            placeholder = new PendingFile { IsUploading = true };
            _pendingFiles.Add(placeholder);
        }
        
        placeholder.FileName = progress < 0 ? "Preparing..." : $"Compressing... {Math.Round(progress)}%";
        placeholder.UploadProgress = progress;
        _forceComposerRender = true;
        StateHasChanged();
    }

    [JSInvokable]
    public void OnPasteProgressUpdate(double progress)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder == null)
        {
            placeholder = new PendingFile { IsUploading = true };
            _pendingFiles.Add(placeholder);
        }
        
        placeholder.FileName = progress < 0 ? "Preparing..." : $"Uploading... {Math.Round(progress)}%";
        placeholder.UploadProgress = progress;
        _forceComposerRender = true;
        StateHasChanged();
    }

    private void OnDetailedProgressUpdateHandler((string State, double Progress) update)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder == null)
        {
            placeholder = new PendingFile { IsUploading = true };
            _pendingFiles.Add(placeholder);
        }

        if (update.State == "Preparing...") {
            placeholder.FileName = "Preparing...";
        } else if (update.State == "Downloading from iCloud...") {
            placeholder.FileName = $"Downloading from iCloud... {Math.Round(update.Progress)}%";
        } else if (update.State == "Compressing...") {
            placeholder.FileName = $"Compressing... {Math.Round(update.Progress)}%";
        } else if (update.State == "Finishing up...") {
            placeholder.FileName = "Finishing up...";
        } else {
            placeholder.FileName = $"Uploading... {Math.Round(update.Progress)}%";
        }
        
        placeholder.UploadProgress = update.Progress;
        _forceComposerRender = true;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task OnPasteUploadCompleted(string resultJson)
    {
        try
        {
            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
            var results = System.Text.Json.JsonSerializer.Deserialize<List<ApiFileUpload.UploadResult>>(resultJson, options);
            if (results != null) HandleApiUploadCompleted(results);
        }
        catch { }
    }

    [JSInvokable]
    public void OnPasteUploadError(string error)
    {
        HandleApiUploadError(error);
    }



    private async Task RemovePendingFile(PendingFile file)
    {
        _pendingFiles.Remove(file);
        StateHasChanged();

        if (file.IsUploading)
        {
            if (_mobilePictureUpload != null) await _mobilePictureUpload.AbortUpload();
            if (_mobileFileUpload != null) await _mobileFileUpload.AbortUpload();
            if (_mobileVoiceUpload != null) await _mobileVoiceUpload.AbortUpload();
            if (_desktopUpload != null) await _desktopUpload.AbortUpload();
        }

        // Clean up the orphaned file on the server if it finished uploading
        if (file.Attachment != null && !string.IsNullOrEmpty(file.Attachment.FilePath))
        {
            await FileService.DeleteAsync(file.Attachment.FilePath);
        }
    }

    private string TruncateContent(string content, int maxLength)
    {
        if (string.IsNullOrEmpty(content)) return "";
        var clean = System.Text.RegularExpressions.Regex.Replace(content, @"@\[([^\]]+)\]", "@$1");
        return clean.Length <= maxLength ? clean : clean[..maxLength] + "…";
    }

