    public void TriggerEventMobile(int index)
    {
        if (index >= 0 && index < _filteredHashTags.Count)
        {
            InsertHashTag(_filteredHashTags[index]);
            StateHasChanged();
        }
    }

    private void UpdateEmojiAutocompletePopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        var lastColonIndex = text.LastIndexOf(':');
        if (lastColonIndex < 0)
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        var afterColon = text[(lastColonIndex + 1)..];
        if (afterColon.Contains(' ') || afterColon.Contains('\n'))
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        if (lastColonIndex > 0 && text[lastColonIndex - 1] != ' ' && text[lastColonIndex - 1] != '\n')
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        _emojiSearchText = afterColon.ToLowerInvariant();

        if (_emojiSearchText.Length < 2)
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        _filteredEmojis = [];
        foreach (var cat in EmojiData.Categories)
        {
            var matched = cat.Value.Where(e =>
                EmojiData.Keywords.TryGetValue(e, out var kw) &&
                kw.Contains(_emojiSearchText, StringComparison.OrdinalIgnoreCase)).ToList();

            if (matched.Any())
                _filteredEmojis.AddRange(matched);
        }

        _filteredEmojis = _filteredEmojis.Distinct().Take(10).ToList();

        _showEmojiAutocompletePopover = _filteredEmojis.Any();
        _emojiSelectedIndex = 0;
    }

    private string GetEmojiDescription(string emoji)
    {
        if (EmojiData.Keywords.TryGetValue(emoji, out var kw))
        {
            var firstWord = kw.Split(' ').FirstOrDefault(w => w != emoji);
            if (!string.IsNullOrEmpty(firstWord))
            {
                return $":{firstWord}:";
            }
        }
        return "";
    }

    private void InsertEmojiAutocomplete(string emoji)
    {
        var lastColonIndex = _messageText.LastIndexOf(':');
        if (lastColonIndex >= 0)
        {
            var before = _messageText[..lastColonIndex];
            _messageText = before + emoji + " ";
        }

        _showEmojiAutocompletePopover = false;
        StateHasChanged();
    }

    private void UpdateSnippetPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showSnippetPopover = false;
            return;
        }

        var lastBracketIndex = text.LastIndexOf('[');
        if (lastBracketIndex < 0)
        {
            _showSnippetPopover = false;
            return;
        }

        var afterBracket = text[(lastBracketIndex + 1)..];
        if (afterBracket.Contains(' ') || afterBracket.Contains('\n') || afterBracket.Contains(']'))
        {
            _showSnippetPopover = false;
            return;
        }

        _snippetSearchText = afterBracket.ToLowerInvariant();

        List<string> availableSnippets = [ 
            "code=xml",
            "code=python", 
            "code=sql", 
            "code=json", 
            "code=css", 
            "code=html", 
            "code=ts", 
            "code=js", 
            "code=csharp", 
            "code"
        ];
        _filteredSnippets = availableSnippets.Where(s => s.StartsWith(_snippetSearchText)).ToList();
        
        _showSnippetPopover = _filteredSnippets.Any();
        _snippetSelectedIndex = _filteredSnippets.Count > 0 ? _filteredSnippets.Count - 1 : 0;

        if (_showSnippetPopover && _jsModule != null)
        {
            _ = _jsModule.InvokeVoidAsync("scrollSnippetPopoverToSelected", $"snippet-popover-container-{IdSuffix}");
        }
    }

    private async Task InsertSnippet(string snippet)
    {
        var lastBracketIndex = _messageText.LastIndexOf('[');
        if (lastBracketIndex >= 0)
        {
            var before = _messageText[..lastBracketIndex];
            _messageText = before;
            StateHasChanged();

            await Task.Delay(10); // Wait for Blazor to update the DOM

            if (snippet.StartsWith("code"))
            {
                await ApplyFormatting($"[{snippet}]\n", "\n[/code]");
            }
        }

        _showSnippetPopover = false;
        StateHasChanged();
    }

    [JSInvokable]
