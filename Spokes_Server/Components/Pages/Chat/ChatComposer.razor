    private bool _isRecordingVoice;
    private bool _isDesktopRecording;
    private string _recordingDurationText = "0:00";
    private DateTime _recordingStartTime;
    private System.Timers.Timer? _recordingTimer;

    private void StartVoiceRecording(bool isDesktop = false)
    {
        _ = InvokeAsync(async () => {
            _isDesktopRecording = isDesktop;
            var targetUpload = isDesktop ? _desktopVoiceUpload : _mobileVoiceUpload;
            if (targetUpload == null || targetUpload.ObjRef == null)
            {
                Snackbar.Add(Loc["Voice upload not initialized yet."].Value, Severity.Warning);
                return;
            }

            _isRecordingVoice = true;
            _recordingStartTime = DateTime.Now;
            _recordingDurationText = "0:00";
            StateHasChanged();
            await Task.Delay(50); // Yield to guarantee Blazor renders the recording UI before prompting for mic access
            
            _recordingTimer = new System.Timers.Timer(1000);
            _recordingTimer.Elapsed += (s, e) => {
                var diff = DateTime.Now - _recordingStartTime;
                _recordingDurationText = $"{(int)diff.TotalMinutes}:{diff.Seconds:D2}";
                InvokeAsync(StateHasChanged);
            };
            _recordingTimer.Start();
            
            var canvasId = isDesktop ? $"voice-soundwave-desktop-{IdSuffix}" : $"voice-soundwave-mobile-{IdSuffix}";
            var started = await JS.InvokeAsync<bool>("spokesVoiceRecorder.startRecording", targetUpload.ObjRef, canvasId);
            if (!started)
            {
                await CancelVoiceRecording();
                Snackbar.Add(Loc["Could not access microphone."].Value, Severity.Error);
            }
            StateHasChanged();
        });
    }

    private async Task CancelVoiceRecording()
    {
        _isRecordingVoice = false;
        StateHasChanged();
        if (_recordingTimer != null) { _recordingTimer.Stop(); _recordingTimer.Dispose(); }
        try { await JS.InvokeVoidAsync("spokesVoiceRecorder.cancelRecording"); } catch { }
    }

    private async Task SendVoiceRecording()
    {
        _isRecordingVoice = false;
        StateHasChanged();
        if (_recordingTimer != null) { _recordingTimer.Stop(); _recordingTimer.Dispose(); }
        
        var baseUri = NavigationManager.BaseUri;
        if (!baseUri.EndsWith("/")) baseUri += "/";
        var fallbackUploadUrl = $"{baseUri}spokesapi/files/chat/{ChannelId}";
        var uploadUrl = !string.IsNullOrEmpty(UploadUrl) 
            ? NavigationManager.ToAbsoluteUri(UploadUrl).ToString() 
            : fallbackUploadUrl;

        var targetUpload = _isDesktopRecording ? _desktopVoiceUpload : _mobileVoiceUpload;
        try { await JS.InvokeVoidAsync("spokesVoiceRecorder.stopAndUploadRecording", uploadUrl, targetUpload?.ObjRef); } catch { }
    }

