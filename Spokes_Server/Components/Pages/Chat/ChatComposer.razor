    private async Task OpenCreateAlbumFromPendingAsync()
    {
        if (string.IsNullOrEmpty(ChannelId) || string.IsNullOrEmpty(CurrentUserId) || !CanUserUseAlbums || !CanPost || Disabled || IsArchived)
            return;

        var pendingImages = CompletedPendingImages;
        if (pendingImages.Count == 0)
            return;

        var privateKey = ScopedKeystore.IsUnlocked ? ScopedKeystore.GetPrivateKey() : null;
        var existingAlbums = AlbumService.GetWritableAlbumsForChannel(CurrentUserId, ChannelId, privateKey);
        var defaultTitle = !string.IsNullOrWhiteSpace(ChannelDisplayName)
            ? $"{ChannelDisplayName} - {DateTime.Now:MMM d, yyyy}"
            : DateTime.Now.ToString("MMM d, yyyy");

        var parameters = new DialogParameters<Spokes_Server.Components.Dialogs.Communication.Chat.CreateAlbumFromChatDialog>
        {
            { x => x.PhotoCount, pendingImages.Count },
            { x => x.DefaultTitle, defaultTitle },
            { x => x.ExistingAlbums, existingAlbums },
            { x => x.IsPostSendConversion, false }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.Communication.Chat.CreateAlbumFromChatDialog>(
            Loc["Organize Photos into Album"].Value,
            parameters,
            options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: Spokes_Server.Components.Dialogs.Communication.Chat.CreateAlbumFromChatDialog.Result dialogResult })
        {
            if (!CanUserUseAlbums || !CanPost || Disabled || IsArchived)
                return;

            var attachmentsToImport = pendingImages
                .Where(f => f.Attachment != null)
                .Select(f => f.Attachment!)
                .ToList();

            var importResult = await AlbumService.ImportChatAttachmentsToAlbumAsync(
                CurrentUserId,
                ChannelId,
                attachmentsToImport,
                dialogResult.ExistingAlbumId,
                dialogResult.NewAlbumTitle,
                privateKey,
                ChannelKey,
                deleteSourceFiles: true);

            if (!importResult.IsSuccess || importResult.Value == null)
            {
                Snackbar.Add(importResult.ErrorMessage ?? Loc["Failed to create album."].Value, Severity.Error);
                return;
            }

            foreach (var imgFile in pendingImages)
            {
                _pendingFiles.Remove(imgFile);
            }
            _dismissedAlbumSuggestion = false;

            var album = importResult.Value;
            var cleanTitle = album.Title.Replace("[", "(").Replace("]", ")");
            var albumToken = $"#[{cleanTitle}](album:{album.Id})";
            _messageText = string.IsNullOrWhiteSpace(_messageText)
                ? albumToken
                : $"{_messageText.TrimEnd()} {albumToken}";

            _forceComposerRender = true;
            await SendMessage();
        }
    }

    private async Task OpenCreatePollDialog()
    {
        if (string.IsNullOrEmpty(ChannelId) || string.IsNullOrEmpty(CurrentUserId))
            return;

        var parameters = new DialogParameters<Spokes_Server.Components.Dialogs.Communication.Chat.ChatPollDialog>
        {
            { x => x.IsEditMode, false },
            { x => x.ChannelId, ChannelId },
            { x => x.CurrentUserId, CurrentUserId },
            { x => x.ChannelKey, ChannelKey }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.Communication.Chat.ChatPollDialog>(Loc["Create a Poll"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: ChatPoll createdPoll })
        {
            var displayPoll = PollService.DecryptPollForDisplay(createdPoll, ChannelKey);
            var cleanTitle = (displayPoll.Question ?? "Poll").Replace("[", "(").Replace("]", ")");
            var pollContent = $"#[{cleanTitle}](poll:{createdPoll.Id})";
            await OnSendMessage.InvokeAsync((pollContent, new List<ChatAttachment>()));
        }
    }

