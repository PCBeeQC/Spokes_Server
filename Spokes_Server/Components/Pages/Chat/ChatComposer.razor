@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Communication.Chat
@using static Spokes_Server.Core.Helpers.FileHelper
@using static Spokes_Server.Components.UI.FileUiHelper
@inject ChatService ChatService
@inject IChatChannelAccessService ChatAccess
@inject UserClientStateService UserClientStateService
@inject IFileService FileService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject Database Db
@inject ShareTargetStateService ShareTargetStateService
@inject NavigationManager NavigationManager
@inject StartupTimingService StartupTimings
@implements IAsyncDisposable

@* Archived Channel Notice *@
@if (IsArchived)
{
    <MudPaper Elevation="2" Class="pa-3 d-flex align-center justify-center"
        Style="border-top: 1px solid var(--mud-palette-divider);">
        <MudIcon Icon="@Icons.Material.Filled.Archive" Class="mr-2" Color="Color.Secondary" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Loc["This channel is archived and read-only."]
        </MudText>
    </MudPaper>
}
else if (IsAnnouncementOnly && !CanPost)
{
    <MudPaper Elevation="2" Class="pa-3 d-flex align-center justify-center"
        Style="border-top: 1px solid var(--mud-palette-divider);">
        <MudIcon Icon="@Icons.Material.Filled.Campaign" Class="mr-2" Color="Color.Secondary" />
        <MudText Typo="Typo.body2" Color="Color.Secondary">
            @Loc["This is an announcement channel. Only authorized users can post."]
        </MudText>
    </MudPaper>
}
else
{
    <MudPaper Elevation="2" Class="px-1 pt-1 pb-1 flex-shrink-0" Style="border-top: 1px solid var(--mud-palette-divider); position: relative; z-index: 100;">
        @if (Disabled)
        {
            <MudOverlay Visible="true" Absolute="true" DarkBackground="true" ZIndex="10" />
        }
        @* Reply Preview Strip *@
        @if (ReplyingTo != null)
        {
            <div class="d-flex align-center gap-2 mb-2 pa-2 rounded" 
                 style="background: var(--mud-palette-background-grey); border-left: 3px solid var(--mud-palette-primary);">
                <MudIcon Icon="@Icons.Material.Filled.Reply" Size="Size.Small" Color="Color.Primary" Style="transform: scaleX(-1);" />
                <MudText Typo="Typo.caption" Style="font-weight: 600; color: var(--mud-palette-primary);">
                    @string.Format(Loc["Replying to {0}"].Value, ReplyToSenderName ?? Loc["Unknown"].Value)
                </MudText>
                <MudText Typo="Typo.caption" Style="color: var(--mud-palette-text-secondary); overflow: hidden; text-overflow: ellipsis; white-space: nowrap; flex: 1;">
                    @TruncateContent(DecryptedReplyContent ?? ReplyingTo?.Content ?? "", 80)
                </MudText>
                <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" 
                               OnClick="@(() => OnCancelReply.InvokeAsync())" />
            </div>
        }

        @* Pending Attachments Preview *@
        @if (_pendingFiles.Any())
        {
            <div class="d-flex flex-wrap gap-2 mb-2">
                @foreach (var file in _pendingFiles)
                {
                    <FileAttachmentChip Attachment="@file.Attachment"
                                        FileName="@file.FileName"
                                        StageText="@file.StageText"
                                        IsUploading="@file.IsUploading"
                                        UploadProgress="@file.UploadProgress"
                                        OnRemove="@(async _ => await RemovePendingFile(file))"
                                        OnCancel="@(async () => await RemovePendingFile(file))" />
                }
            </div>
        }

        @* Mention Autocomplete Popover (shared) *@
        <MudPaper id="@($"mention-popover-container-{IdSuffix}")" Elevation="4" Class="pa-1" 
                      Style="@($"position: absolute; bottom: 100%; left: 0; right: 0; max-height: 200px; overflow-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; z-index: 100; margin-bottom: 4px; display: {(_showMentionPopover && _filteredMentions.Any() ? "block" : "none")};")">
                @if (_showMentionPopover && _filteredMentions.Any())
                {
                    @for (int i = 0; i < _filteredMentions.Count; i++)
                    {
                        var idx = i;
                        var mention = _filteredMentions[i];
                        <div class="mention-popover-item d-flex align-center gap-2 pa-2 rounded cursor-pointer"
                             data-index="@idx"
                             style="@(idx == _mentionSelectedIndex ? "background: var(--mud-palette-action-default-hover);" : "")"
                             @onclick="@(() => InsertMention(mention))">
                            @if (mention.IsSpecial)
                            {
                                <MudAvatar Size="Size.Small" Style="@($"background: {mention.ProfileColor ?? "var(--mud-palette-warning)"}; color: white;")">
                                    <MudIcon Icon="@Icons.Material.Filled.Group" Size="Size.Small" />
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@@@mention.DisplayName</MudText>
                            }
                            else if (mention.DisplayName == "everyone")
                            {
                                <MudAvatar Size="Size.Small" Style="background: var(--mud-palette-error); color: white;">
                                    <MudIcon Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" />
                                </MudAvatar>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@@everyone</MudText>
                            }
                            else
                            {
                                @if (mention.HasCustomAvatar)
                                {
                                    <MudAvatar Size="Size.Small">
                                        <MudImage Src="@($"/spokesapi/Media/Avatar/{mention.Id}?v={mention.AvatarVersion}")" ObjectFit="ObjectFit.Cover" />
                                    </MudAvatar>
                                }
                                else
                                {
                                    <MudAvatar Size="Size.Small" 
                                               Style="@($"background-color: {mention.ProfileColor ?? Colors.DeepPurple.Default}; color: white;")">
                                        @(mention.DisplayName.FirstOrDefault())
                                    </MudAvatar>
                                }
                                <div>
                                    <MudText Typo="Typo.body2" Style="font-weight: 600;">@mention.DisplayName</MudText>
                                    @if (!string.IsNullOrEmpty(mention.Position))
                                    {
                                        <MudText Typo="Typo.caption" Color="Color.Secondary">@mention.Position</MudText>
                                    }
                                </div>
                            }
                        </div>
                    }
                }
            </MudPaper>

            @* HashTag Autocomplete Popover (shared for Events and Albums) *@
            <MudPaper id="@($"event-popover-container-{IdSuffix}")" Elevation="4" Class="pa-1" 
                      Style="@($"position: absolute; bottom: 100%; left: 0; right: 0; max-height: 200px; overflow-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; z-index: 100; margin-bottom: 4px; display: {(_showEventPopover && _filteredHashTags.Any() ? "block" : "none")};")">
                @if (_showEventPopover && _filteredHashTags.Any())
                {
                    @for (int i = 0; i < _filteredHashTags.Count; i++)
                    {
                        var idx = i;
                        var tag = _filteredHashTags[i];
                        <div class="event-popover-item d-flex align-center gap-2 pa-2 rounded cursor-pointer"
                             data-index="@idx"
                             style="@(idx == _eventSelectedIndex ? "background: var(--mud-palette-action-default-hover);" : "")"
                             @onclick="@(() => InsertHashTag(tag))">
                            <MudAvatar Size="Size.Small" Style="@(tag.IsEvent ? "background: var(--mud-palette-info); color: white;" : "background: var(--mud-palette-success); color: white;")">
                                <MudIcon Icon="@(tag.IsEvent ? Icons.Material.Filled.Event : Icons.Material.Filled.PhotoAlbum)" Size="Size.Small" />
                            </MudAvatar>
                            <div style="overflow: hidden;">
                                <MudText Typo="Typo.body2" Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@tag.Title</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">
                                    @tag.Subtitle
                                </MudText>
                            </div>
                        </div>
                    }
                }
            </MudPaper>

            @* Snippet Autocomplete Popover *@
            <MudPaper id="@($"snippet-popover-container-{IdSuffix}")" Elevation="4" Class="pa-1" 
                      Style="@($"position: absolute; bottom: 100%; left: 0; right: 0; max-height: 200px; overflow-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; z-index: 100; margin-bottom: 4px; display: {(_showSnippetPopover && _filteredSnippets.Any() ? "block" : "none")};")">
                @if (_showSnippetPopover && _filteredSnippets.Any())
                {
                    @for (int i = 0; i < _filteredSnippets.Count; i++)
                    {
                        var idx = i;
                        var snippet = _filteredSnippets[i];
                        <div class="snippet-popover-item d-flex align-center gap-2 pa-2 rounded cursor-pointer"
                             data-index="@idx"
                             style="@(idx == _snippetSelectedIndex ? "background: var(--mud-palette-action-default-hover);" : "")"
                             @onclick="@(() => InsertSnippet(snippet))">
                            <MudAvatar Size="Size.Small" Style="background: var(--mud-palette-dark); color: white;">
                                <MudIcon Icon="@Icons.Material.Filled.Code" Size="Size.Small" />
                            </MudAvatar>
                            <div>
                                <MudText Typo="Typo.body2" Style="font-weight: 600;">@snippet</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Insert a code block"]</MudText>
                            </div>
                        </div>
                    }
                }
            </MudPaper>

            @* Emoji Autocomplete Popover *@
            <MudPaper id="@($"emoji-autocomplete-popover-container-{IdSuffix}")" Elevation="4" Class="pa-1" 
                      Style="@($"position: absolute; bottom: 100%; left: 0; right: 0; max-height: 200px; overflow-y: auto; -webkit-overflow-scrolling: touch; touch-action: pan-y; z-index: 100; margin-bottom: 4px; display: {(_showEmojiAutocompletePopover && _filteredEmojis.Any() ? "block" : "none")};")">
                @if (_showEmojiAutocompletePopover && _filteredEmojis.Any())
                {
                    @for (int i = 0; i < _filteredEmojis.Count; i++)
                    {
                        var idx = i;
                        var emoji = _filteredEmojis[i];
                        <div class="emoji-autocomplete-popover-item d-flex align-center gap-2 pa-2 rounded cursor-pointer"
                             data-index="@idx"
                             style="@(idx == _emojiSelectedIndex ? "background: var(--mud-palette-action-default-hover);" : "")"
                             @onclick="@(() => InsertEmojiAutocomplete(emoji))">
                            <MudText Typo="Typo.h5" Style="line-height: 1; margin-right: 8px;">@emoji</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">
                                @GetEmojiDescription(emoji)
                            </MudText>
                        </div>
                    }
                }
            </MudPaper>

            @* Emoji Picker (anchored above the composer via global popover portal) *@
            @if (_showEmojiPicker)
            {
                <MudPopover Open="@_showEmojiPicker" AnchorOrigin="Origin.TopRight" TransformOrigin="Origin.BottomRight" OverflowBehavior="OverflowBehavior.FlipAlways">
                    <EmojiPicker IsOpen="@true"
                                 AutoFocusSearch="_autoFocusEmojiSearch"
                                 OnEmojiSelected="InsertEmoji"
                                 OnGifSelected="InsertGif"
                                 OnClose="@(() => _showEmojiPicker = false)"
                                 ContainerStyle="position: relative;"
                                 Class="my-0 mx-0" />
                </MudPopover>
            }

            @if (IsMobile)
            {
                @* ═══════════════════════════════════════════════════════════════
                   MOBILE COMPOSER — compact single-row layout (Discord/Element style)
                   Visible on mobile layout (<960px, below md breakpoint)
                   ═══════════════════════════════════════════════════════════════ *@
                <div class="mobile-composer d-flex flex-row flex-grow-1 d-md-none align-center gap-1">
                    <div class="@(_isRecordingVoice && !_isDesktopRecording ? "d-flex" : "d-none") align-center flex-grow-1 px-2 rounded-pill" style="background: var(--mud-palette-error-hover); animation: pulse-bg 2s infinite;">
                        <MudIcon Icon="@Icons.Material.Filled.Mic" Color="Color.Error" Class="mr-2" Style="animation: pulse 1s infinite;" />
                        <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight: 600;">@_recordingDurationText</MudText>
                        <canvas id="@($"voice-soundwave-mobile-{IdSuffix}")" width="160" height="32" class="mx-2 flex-grow-1" style="width: 160px; max-width: 200px; opacity: 0.8;"></canvas>
                        <MudSpacer />
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Secondary" Size="Size.Small" OnClick="CancelVoiceRecording" />
                        <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Error" Size="Size.Medium" OnClick="SendVoiceRecording" />
                    </div>
                    
                    <div class="@(_isRecordingVoice && !_isDesktopRecording ? "d-none" : "d-flex") flex-row flex-grow-1 align-center gap-1 w-100">
                        @* + Attach button *@
                        @if (!IsEditMode)
                        {
                            <div style="margin-left: -4px;">
                                <MudFabMenu StartIcon="@Icons.Material.Filled.Add" DropShadow="false"  AlignItems="AlignItems.Start" Color="Color.Default" Size="Size.Small" DampenItemsBackgroundColor="false" UseCloseIcon="false">
                                    <MudFabMenuItem StartIcon="@Icons.Material.Filled.PhotoLibrary"  Color="Color.Primary" Size="Size.Small" Label="@Loc["Photo"]" OnClick="@(() => TriggerMobileUpload("chat-mobile-pic-upload"))" />
                                    <MudFabMenuItem StartIcon="@Icons.Material.Filled.AttachFile" Color="Color.Primary" Size="Size.Small" Label="@Loc["File"]" OnClick="@(() => TriggerMobileUpload("chat-mobile-file-upload"))" />
                                    <MudFabMenuItem StartIcon="@Icons.Material.Filled.Mic" Color="Color.Primary" Size="Size.Small" Label="@Loc["Memo"]" OnClick="@(() => StartVoiceRecording(false))" />
                                </MudFabMenu>
                            </div>
                        }
                        else
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.Close" 
                                           Size="Size.Medium"
                                           Class="pa-n2"
                                           Color="Color.Secondary" 
                                           OnClick="CancelEdit" />
                        }

                        @* Input box with inline emoji adornment *@
                        <MudTextField @ref="_messageField" id="@($"chat-message-input-{IdSuffix}")" @bind-Value="_messageText"
                            Placeholder="@Loc["Message..."]" Variant="Variant.Outlined" FullWidth="true"
                            Lines="1" MaxLines="10" Sizing="InputSizing.Auto"
                            Class="flex-grow-1 rounded-pill"
                            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.EmojiEmotions"
                            OnAdornmentClick="ToggleEmojiPickerMobile"
                            Immediate="true"
                            Margin="Margin.Dense"
                            TextChanged="HandleTextChanged" />

                        @* Send button (wrapped to prevent keyboard collapse on mobile) *@
                        <div id="@($"mobile-send-btn-{IdSuffix}")"
                             class="d-flex align-center cursor-pointer"
                             style="opacity: @(string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any() || ChannelId == null || _pendingFiles.Any(f => f.IsUploading) ? "0.5" : "1"); pointer-events: @(string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any() || ChannelId == null || _pendingFiles.Any(f => f.IsUploading) ? "none" : "auto");">
                            <MudIconButton Icon="@Icons.Material.Filled.Send" 
                                           Size="Size.Medium" 
                                           Class="pa-n2"
                                           Color="Color.Primary"
                                           Style="pointer-events: none;" />
                        </div>
                    </div>
                </div>
                
                @if (!IsEditMode)
                {
                    <div style="display:none;">
                        <ApiFileUpload @ref="_mobilePictureUpload" Id="chat-mobile-pic-upload" Category="chat" ContextId="@ChannelId" MaximumFileCount="5"
                            UploadUrl="@UploadUrl"
                            Accept="image/*,video/*"
                            Style="display:none;"
                            OnUploadStarted="HandleApiUploadStarted"
                            OnUploadCompleted="HandleApiUploadCompleted"
                            OnUploadError="HandleApiUploadError"
                            OnDetailedProgressUpdate="OnDetailedProgressUpdateHandler" />

                        <ApiFileUpload @ref="_mobileFileUpload" Id="chat-mobile-file-upload" Category="chat" ContextId="@ChannelId" MaximumFileCount="5"
                            UploadUrl="@UploadUrl"
                            Style="display:none;"
                            OnUploadStarted="HandleApiUploadStarted"
                            OnUploadCompleted="HandleApiUploadCompleted"
                            OnUploadError="HandleApiUploadError"
                            OnDetailedProgressUpdate="OnDetailedProgressUpdateHandler" />

                        <ApiFileUpload @ref="_mobileVoiceUpload" Id="chat-mobile-voice-upload" Category="chat" ContextId="@ChannelId" MaximumFileCount="1"
                            UploadUrl="@UploadUrl"
                            Style="display:none;"
                            OnUploadStarted="HandleApiUploadStarted"
                            OnUploadCompleted="HandleVoiceUploadCompleted"
                            OnUploadError="HandleApiUploadError"
                            OnDetailedProgressUpdate="OnDetailedProgressUpdateHandler" />
                    </div>
                }
            }
            else
            {
                @if (!IsEditMode)
                {
                    <div style="display:none;">
                        <ApiFileUpload @ref="_desktopVoiceUpload" Id="chat-desktop-voice-upload" Category="chat" ContextId="@ChannelId" MaximumFileCount="1"
                            UploadUrl="@UploadUrl"
                            Style="display:none;"
                            OnUploadStarted="HandleApiUploadStarted"
                            OnUploadCompleted="HandleVoiceUploadCompleted"
                            OnUploadError="HandleApiUploadError"
                            OnDetailedProgressUpdate="OnDetailedProgressUpdateHandler" />
                    </div>
                }

                @* ═══════════════════════════════════════════════════════════════
                   DESKTOP COMPOSER — full layout with formatting toolbar
                   Hidden on mobile layout (d-none d-md-block)
                   ═══════════════════════════════════════════════════════════════ *@
                <div class="d-none d-md-block">
                    <div class="composer-box">
                        <div class="@(_isRecordingVoice && _isDesktopRecording ? "d-none" : "d-block")">
                            @* Text input area *@
                            <div class="composer-textarea">
                                <MudTextField @ref="_messageFieldDesktop" id="@($"chat-message-input-desktop-{IdSuffix}")" @bind-Value="_messageText"
                                    Placeholder="@(IsEditMode ? Loc["Edit message..."].Value : Loc["Type a message..."].Value)" Variant="Variant.Text" FullWidth="true"
                                    Lines="2" MaxLines="10" Sizing="InputSizing.Auto"
                                    OnKeyDown="HandleKeyPress"
                                    Immediate="true"
                                    Underline="false" Class="px-2 py-1"
                                    TextChanged="HandleTextChanged" />
                            </div>

                            @* Formatting toolbar inside the box *@
                            <div class="composer-toolbar d-flex align-center">
                                <MudTooltip Text="@Loc["Bold"]" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.FormatBold" Size="Size.Small" 
                                                   Color="Color.Default" OnClick="@(() => ApplyFormatting("**", "**"))" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["Italic"]" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.FormatItalic" Size="Size.Small" 
                                                   Color="Color.Default" OnClick="@(() => ApplyFormatting("_", "_"))" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["Strikethrough"]" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.FormatStrikethrough" Size="Size.Small" 
                                                   Color="Color.Default" OnClick="@(() => ApplyFormatting("~~", "~~"))" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["Code (Type [ for more languages)"]" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.Code" Size="Size.Small" 
                                                   Color="Color.Default" OnClick="@(() => ApplyFormatting("[code]\n", "\n[/code]"))" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["Quote"]" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.FormatQuote" Size="Size.Small" 
                                                   Color="Color.Default" OnClick="@(() => ApplyLinePrefix("> "))" />
                                </MudTooltip>
                                <MudTooltip Text="@Loc["Bulleted list"]" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.FormatListBulleted" Size="Size.Small" 
                                                   Color="Color.Default" OnClick="@(() => ApplyLinePrefix("- "))" />
                                </MudTooltip>
                                <div style="width: 1px; height: 18px; background: var(--mud-palette-divider); margin: 0 2px;"></div>
                                <MudTooltip Text="@Loc["Emoji"]" Placement="Placement.Top">
                                    <MudIconButton Icon="@Icons.Material.Filled.EmojiEmotions" Size="Size.Small" 
                                                   Color="Color.Default" OnClick="@(() => { _autoFocusEmojiSearch = true; _showEmojiPicker = !_showEmojiPicker; })" />
                                </MudTooltip>

                                <div style="flex: 1;"></div>

                                @if (!IsEditMode)
                                {
                                    <MudTooltip Text="@Loc["Record Voice Memo"]" Placement="Placement.Top">
                                        <MudIconButton Icon="@Icons.Material.Filled.Mic" Size="Size.Small" Color="Color.Default" OnClick="@(() => StartVoiceRecording(true))" />
                                    </MudTooltip>

                                    <ApiFileUpload @ref="_desktopUpload" Id="chat-desktop-upload" Category="chat" ContextId="@ChannelId" MaximumFileCount="5"
                                        UploadUrl="@UploadUrl"
                                        OnUploadStarted="HandleApiUploadStarted"
                                        OnUploadCompleted="HandleApiUploadCompleted"
                                        OnUploadError="HandleApiUploadError"
                                        OnDetailedProgressUpdate="OnDetailedProgressUpdateHandler">
                                        <CustomContent>
                                            <MudTooltip Text="@Loc["Attach files"]" Placement="Placement.Top">
                                                <MudIconButton Icon="@Icons.Material.Filled.AttachFile" Size="Size.Small" Color="Color.Default" />
                                            </MudTooltip>
                                        </CustomContent>
                                    </ApiFileUpload>
                                }

                                <MudTooltip Text="@Loc["Send (Enter)"]" Placement="Placement.Left">
                                    <MudIconButton Icon="@Icons.Material.Filled.Send" Size="Size.Small" Color="Color.Primary" OnClick="SendMessage"
                                        Disabled="@(string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any() || ChannelId == null || _pendingFiles.Any(f => f.IsUploading))" />
                                </MudTooltip>
                                @if (IsEditMode)
                                {
                                    <MudButton Variant="Variant.Text" Size="Size.Small" Color="Color.Secondary" OnClick="CancelEdit">@Loc["Cancel"]</MudButton>
                                }
                            </div>
                        </div>
                        
                        <div class="@(_isRecordingVoice && _isDesktopRecording ? "d-flex" : "d-none") align-center flex-grow-1 px-4 py-2" style="background: var(--mud-palette-error-hover); animation: pulse-bg 2s infinite;">
                            <MudIcon Icon="@Icons.Material.Filled.Mic" Color="Color.Error" Class="mr-2" Style="animation: pulse 1s infinite;" />
                            <MudText Typo="Typo.body2" Color="Color.Error" Style="font-weight: 600;">@_recordingDurationText</MudText>
                            <canvas id="@($"voice-soundwave-desktop-{IdSuffix}")" width="200" height="32" class="mx-4 flex-grow-1" style="width: 200px; opacity: 0.8;"></canvas>
                            <MudSpacer />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Secondary" Size="Size.Small" OnClick="CancelVoiceRecording" />
                            <MudIconButton Icon="@Icons.Material.Filled.Send" Color="Color.Error" Size="Size.Medium" OnClick="SendVoiceRecording" />
                        </div>
                    </div>
                </div>
                @* Hide helper text on mobile *@
                <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-none d-md-block">
                    @Loc["Enter to send • Shift+Enter for new line • @ to mention • # for events and Albums"]
                </MudText>
            }
    </MudPaper>
}

<style>
    /* ─── Mobile Composer Override ─── */
    .mobile-composer {
        contain: layout; /* Fix InputSizing.Auto layout thrashing on fast typing */
    }

    .mobile-composer .rounded-pill .mud-input-outlined-border {
        border-radius: 16px !important;
    }

    /* ─── Desktop Composer ─── */
    .composer-box {
        border: 1px solid var(--mud-palette-lines-default);
        border-radius: 8px;
        overflow: hidden;
        transition: border-color 0.2s;
    }

    .composer-box:focus-within {
        border-color: var(--mud-palette-primary);
    }

    .composer-textarea {
        padding: 0 0 0 0;
    }

    .composer-textarea .mud-input-control {
        margin: 0 !important;
    }

    .composer-textarea textarea {
        font-size: 0.9rem;
        line-height: 1.4;
    }

    .composer-toolbar {
        padding: 2px 4px;
        border-top: 1px solid var(--mud-palette-lines-inputs);
        background: var(--mud-palette-background-grey);
    }

    /* ─── Mobile Composer ─── */
    .mobile-composer {
        padding: 4px 4px;
    }
</style>

@code {
    [Parameter] public string? ChannelId { get; set; }
    [Parameter] public string? CurrentUserId { get; set; }
    [Parameter] public bool IsArchived { get; set; }
    [Parameter] public bool IsAnnouncementOnly { get; set; }
    [Parameter] public bool CanPost { get; set; } = true;
