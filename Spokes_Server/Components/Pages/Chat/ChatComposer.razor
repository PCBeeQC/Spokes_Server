    private async Task InsertEmoji(string emoji)
    {
        if (_jsModule != null)
        {
            // Try mobile field first, then desktop
            // We pass false for focusAfterInsert to avoid stealing focus from EmojiPicker/showing keyboard on mobile
            try { await _jsModule.InvokeVoidAsync("insertAtCursor", $"chat-message-input-{IdSuffix}", emoji, false); return; } catch { }
            try { await _jsModule.InvokeVoidAsync("insertAtCursor", $"chat-message-input-desktop-{IdSuffix}", emoji, false); return; } catch { }
        }
        _messageText += emoji;
        _forceComposerRender = true;
        StateHasChanged();
    }

    private async Task InsertGif(string gifUrl)
    {
        _showEmojiPicker = false;
        var originalText = _messageText;
        _messageText = $"![GIF]({gifUrl})";
        await SendMessage();
        if (!string.IsNullOrEmpty(originalText))
        {
             // Restore text if there was any draft
             _messageText = originalText;
             _forceComposerRender = true;
             StateHasChanged();
        }
    }

