    private string? _lastComposerFingerprint;
    private bool _forceComposerRender = true;

    protected override bool ShouldRender()
    {
        if (_forceComposerRender)
        {
            _forceComposerRender = false;
            return true;
        }
        bool isTextEmpty = string.IsNullOrWhiteSpace(_messageText);
        int pendingCount = _pendingFiles.Count;
        bool isUploading = _pendingFiles.Any(f => f.IsUploading);
        var fingerprint = $"{ChannelId}|{UploadUrl}|{IsArchived}|{Disabled}|{ReplyingTo?.Id}|{IsEditMode}|{IsMobile}|{InitialText}|{isTextEmpty}|{pendingCount}|{isUploading}|{_showMentionPopover}|{_mentionSearchText}|{_mentionSelectedIndex}|{_showEventPopover}|{_eventSearchText}|{_eventSelectedIndex}|{_showEmojiAutocompletePopover}|{_emojiSearchText}|{_emojiSelectedIndex}|{_showSnippetPopover}|{_snippetSearchText}|{_snippetSelectedIndex}|{_showEmojiPicker}|{_isRecordingVoice}|{_isDesktopRecording}|{_recordingDurationText}";
        if (fingerprint == _lastComposerFingerprint) return false;
        _lastComposerFingerprint = fingerprint;
        return true;
    }

    private string? _previousChannelId;

    protected override void OnParametersSet()
    {
        base.OnParametersSet();
        if (_previousChannelId != ChannelId)
        {
            if (_previousChannelId != null && CurrentUserId != null && _typingTimer != null && _typingTimer.Enabled)
            {
                _typingTimer.Stop();
                _ = ChatService.StopTypingAsync(CurrentUserId, _previousChannelId);
            }

            // Restore draft for new channel if not in edit mode
            if (!IsEditMode && CurrentUserId != null && ChannelId != null)
            {
                var savedDraft = UserClientStateService.GetDraft(CurrentUserId, ChannelId);
                if (!string.IsNullOrEmpty(savedDraft))
                {
                    _messageText = savedDraft;
                }
                else if (_previousChannelId != null)
                {
                    _messageText = string.Empty;
                }
            }

            _previousChannelId = ChannelId;
        }
    }

    private readonly string _diagTag = Guid.NewGuid().ToString("N")[..4]; // DIAG-TEMP

    protected override void OnInitialized()
    {
        StartupTimings.AddChatTransition($"Server: ChatComposer[{_diagTag}] OnInitialized (IsEditMode={IsEditMode})"); // DIAG-TEMP
        if (IsEditMode && !string.IsNullOrEmpty(InitialText))
        {
            _messageText = InitialText;
        }
        else if (!IsEditMode && string.IsNullOrEmpty(_messageText) && CurrentUserId != null && ChannelId != null)
        {
            var savedDraft = UserClientStateService.GetDraft(CurrentUserId, ChannelId);
            if (!string.IsNullOrEmpty(savedDraft))
            {
                _messageText = savedDraft;
            }
        }
        ShareTargetStateService.OnPayloadReceived += HandlePayloadReceived;
    }

    private void HandlePayloadReceived()
    {
        _ = InvokeAsync(CheckPendingPayloadAsync);
    }

    private async Task CheckPendingPayloadAsync()
    {
        if (ShareTargetStateService.TargetChannelId == ChannelId && ShareTargetStateService.PendingPayload != null)
        {
            var payload = ShareTargetStateService.PendingPayload;
            
            if (payload.Files != null && payload.Files.Any())
            {
                if (_jsModule == null || _objRef == null)
                {
                    return; // Wait for OnAfterRenderAsync
                }
                
                var baseUri = NavigationManager.BaseUri;
                if (!baseUri.EndsWith("/")) baseUri += "/";
                
                var fallbackUploadUrl = $"{baseUri}spokesapi/files/chat/{ChannelId}";
                var uploadUrl = !string.IsNullOrEmpty(UploadUrl) 
                    ? NavigationManager.ToAbsoluteUri(UploadUrl).ToString() 
                    : fallbackUploadUrl;
                
                // Fire and forget the upload script!
                _ = _jsModule.InvokeVoidAsync("uploadSharedFilesToComposer", payload.Files, uploadUrl, _objRef);
            }

            ShareTargetStateService.Clear();
            
            var finalMessage = "";
            if (!string.IsNullOrEmpty(payload.Url)) finalMessage += payload.Url;
            if (!string.IsNullOrEmpty(payload.Text) && payload.Text != payload.Url)
            {
                if (finalMessage.Length > 0) finalMessage += "\n\n";
                finalMessage += payload.Text;
            }
            finalMessage = finalMessage.Trim();
            
            if (!string.IsNullOrEmpty(finalMessage))
            {
                _messageText = string.IsNullOrEmpty(_messageText) ? finalMessage : _messageText + "\n" + finalMessage;
                _forceComposerRender = true;
                StateHasChanged();
            }
        }
    }

