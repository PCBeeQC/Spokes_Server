    private void UpdateEventPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showEventPopover = false;
            return;
        }

        var lastHashIndex = text.LastIndexOf('#');
        if (lastHashIndex < 0)
        {
            _showEventPopover = false;
            return;
        }

        var afterHash = text[(lastHashIndex + 1)..];
        if (afterHash.Contains('[') && afterHash.Contains(']'))
        {
            _showEventPopover = false;
            return;
        }

        _eventSearchText = afterHash.TrimEnd();
        
        if (_eventSearchText.Length == 0)
        {
            _filteredHashTags = GetAllHashTagCandidates();
        }
        else
        {
            _filteredHashTags = GetAllHashTagCandidates()
                .Where(e => e.Title.Contains(_eventSearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        _showEventPopover = _filteredHashTags.Any();
        _eventSelectedIndex = 0;
    }

    private List<HashTagCandidate> GetAllHashTagCandidates()
    {
        if (CurrentUserId == null) return [];
        
        List<HashTagCandidate> candidates = [];

        // 1. Events
        var now = DateTime.UtcNow.Date;
        var myTeamId = Employees.FirstOrDefault(e => e.Id == CurrentUserId)?.TeamId;
        
        var events = Db.CalendarEvents.GetAll()
            .Where(e => (e.Start.Date >= now || e.End.Date >= now) &&
                       (e.IsCompanyWide || 
                        e.EmployeeId == CurrentUserId || 
                        (e.Attendees != null && e.Attendees.Contains(CurrentUserId)) ||
                        (!string.IsNullOrEmpty(myTeamId) && e.InvitedTeamIds != null && e.InvitedTeamIds.Contains(myTeamId))))
            .OrderBy(e => e.Start)
            .ToList();

        foreach (var e in events)
        {
            candidates.Add(new HashTagCandidate
            {
                Id = e.Id,
                Title = e.Title,
                Subtitle = e.IsAllDay ? e.Start.ToString("MMM d") : e.Start.ToString("MMM d, h:mm tt"),
                IsEvent = true
            });
        }

        // 2. Albums
        var currentUser = !string.IsNullOrEmpty(CurrentUserId) ? Db.Employees.GetById(CurrentUserId) : null;
        if (currentUser != null && currentUser.HasPermission(AppPermissions.Albums.View))
        {
            var albums = Db.Albums.GetAll()
                .Where(a => a.OwnerId == CurrentUserId || a.ContributorUserIds.Contains(CurrentUserId) || a.SharedWithChannelIds.Any(cId => ChatAccess.GetUsersForChannel(cId).Contains(CurrentUserId)))
                .OrderByDescending(a => a.CreatedAt)
                .ToList();
                
            foreach (var a in albums)
            {
                candidates.Add(new HashTagCandidate
                {
                    Id = a.Id,
                    Title = a.Title,
                    Subtitle = $"Album ({a.Media.Count} items)",
                    IsEvent = false
                });
            }
        }

        return candidates;
    }

    private void InsertHashTag(HashTagCandidate tag)
    {
        var lastHashIndex = _messageText.LastIndexOf('#');
        if (lastHashIndex >= 0)
        {
            var before = _messageText[..lastHashIndex];
            var type = tag.IsEvent ? "event" : "album";
            _messageText = before + $"#[{tag.Title}]({type}:{tag.Id}) ";
        }

        if (!IsEditMode && CurrentUserId != null && ChannelId != null)
        {
            UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, _messageText);
        }

        _showEventPopover = false;
        StateHasChanged();
    }

