    private void UpdateEventPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showEventPopover = false;
            return;
        }

        var lastHashIndex = text.LastIndexOf('#');
        if (lastHashIndex < 0)
        {
            _showEventPopover = false;
            return;
        }

        var afterHash = text[(lastHashIndex + 1)..];
        if (afterHash.Contains('[') && afterHash.Contains(']'))
        {
            _showEventPopover = false;
            return;
        }

        _eventSearchText = afterHash.TrimEnd();
        
        if (_eventSearchText.Length == 0)
        {
            _filteredHashTags = GetAllHashTagCandidates();
        }
        else
        {
            _filteredHashTags = GetAllHashTagCandidates()
                .Where(e => e.Title.Contains(_eventSearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        _showEventPopover = _filteredHashTags.Any();
        _eventSelectedIndex = 0;
    }

    private List<HashTagCandidate> GetAllHashTagCandidates()
    {
        if (CurrentUserId == null) return new List<HashTagCandidate>();
        
        var candidates = new List<HashTagCandidate>();

        // 1. Events
        var now = DateTime.UtcNow.Date;
        var myTeamId = Employees.FirstOrDefault(e => e.Id == CurrentUserId)?.TeamId;
        
        var events = Db.CalendarEvents.GetAll()
            .Where(e => (e.Start.Date >= now || e.End.Date >= now) &&
                       (e.IsCompanyWide || 
                        e.EmployeeId == CurrentUserId || 
                        (e.Attendees != null && e.Attendees.Contains(CurrentUserId)) ||
                        (!string.IsNullOrEmpty(myTeamId) && e.InvitedTeamIds != null && e.InvitedTeamIds.Contains(myTeamId))))
            .OrderBy(e => e.Start)
            .ToList();

        foreach (var e in events)
        {
            candidates.Add(new HashTagCandidate
            {
                Id = e.Id,
                Title = e.Title,
                Subtitle = e.IsAllDay ? e.Start.ToString("MMM d") : e.Start.ToString("MMM d, h:mm tt"),
                IsEvent = true
            });
        }

        // 2. Albums
        var currentUser = !string.IsNullOrEmpty(CurrentUserId) ? Db.Employees.GetById(CurrentUserId) : null;
        if (currentUser != null && currentUser.HasPermission(AppPermissions.Albums.View))
        {
            var albums = Db.Albums.GetAll()
                .Where(a => a.OwnerId == CurrentUserId || a.ContributorUserIds.Contains(CurrentUserId) || a.SharedWithChannelIds.Any(cId => ChatService.GetUsersForChannel(cId).Contains(CurrentUserId)))
                .OrderByDescending(a => a.CreatedAt)
                .ToList();
                
            foreach (var a in albums)
            {
                candidates.Add(new HashTagCandidate
                {
                    Id = a.Id,
                    Title = a.Title,
                    Subtitle = $"Album ({a.Media.Count} items)",
                    IsEvent = false
                });
            }
        }

        return candidates;
    }

    private void InsertHashTag(HashTagCandidate tag)
    {
        var lastHashIndex = _messageText.LastIndexOf('#');
        if (lastHashIndex >= 0)
        {
            var before = _messageText[..lastHashIndex];
            var type = tag.IsEvent ? "event" : "album";
            _messageText = before + $"#[{tag.Title}]({type}:{tag.Id}) ";
        }

        _showEventPopover = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void TriggerEventMobile(int index)
    {
        if (index >= 0 && index < _filteredHashTags.Count)
        {
            InsertHashTag(_filteredHashTags[index]);
            StateHasChanged();
        }
    }

    private void UpdateEmojiAutocompletePopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        var lastColonIndex = text.LastIndexOf(':');
        if (lastColonIndex < 0)
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        var afterColon = text[(lastColonIndex + 1)..];
        if (afterColon.Contains(' ') || afterColon.Contains('\n'))
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        if (lastColonIndex > 0 && text[lastColonIndex - 1] != ' ' && text[lastColonIndex - 1] != '\n')
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        _emojiSearchText = afterColon.ToLowerInvariant();

        if (_emojiSearchText.Length < 2)
        {
            _showEmojiAutocompletePopover = false;
            return;
        }

        _filteredEmojis = new List<string>();
        foreach (var cat in EmojiData.Categories)
        {
            var matched = cat.Value.Where(e =>
                EmojiData.Keywords.TryGetValue(e, out var kw) &&
                kw.Contains(_emojiSearchText, StringComparison.OrdinalIgnoreCase)).ToList();

            if (matched.Any())
                _filteredEmojis.AddRange(matched);
        }

        _filteredEmojis = _filteredEmojis.Distinct().Take(10).ToList();

        _showEmojiAutocompletePopover = _filteredEmojis.Any();
        _emojiSelectedIndex = 0;
    }

    private string GetEmojiDescription(string emoji)
    {
        if (EmojiData.Keywords.TryGetValue(emoji, out var kw))
        {
            var firstWord = kw.Split(' ').FirstOrDefault(w => w != emoji);
            if (!string.IsNullOrEmpty(firstWord))
            {
                return $":{firstWord}:";
            }
        }
        return "";
    }

    private void InsertEmojiAutocomplete(string emoji)
    {
        var lastColonIndex = _messageText.LastIndexOf(':');
        if (lastColonIndex >= 0)
        {
            var before = _messageText[..lastColonIndex];
            _messageText = before + emoji + " ";
        }

        _showEmojiAutocompletePopover = false;
        StateHasChanged();
    }

    private void UpdateSnippetPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showSnippetPopover = false;
            return;
        }

        var lastBracketIndex = text.LastIndexOf('[');
        if (lastBracketIndex < 0)
        {
            _showSnippetPopover = false;
            return;
        }

        var afterBracket = text[(lastBracketIndex + 1)..];
        if (afterBracket.Contains(' ') || afterBracket.Contains('\n') || afterBracket.Contains(']'))
        {
            _showSnippetPopover = false;
            return;
        }

        _snippetSearchText = afterBracket.ToLowerInvariant();

        var availableSnippets = new List<string> { 
            "code=xml",
            "code=python", 
            "code=sql", 
            "code=json", 
            "code=css", 
            "code=html", 
            "code=ts", 
            "code=js", 
            "code=csharp", 
            "code"
        };
        _filteredSnippets = availableSnippets.Where(s => s.StartsWith(_snippetSearchText)).ToList();
        
        _showSnippetPopover = _filteredSnippets.Any();
        _snippetSelectedIndex = _filteredSnippets.Count > 0 ? _filteredSnippets.Count - 1 : 0;

        if (_showSnippetPopover && _jsModule != null)
        {
            _ = _jsModule.InvokeVoidAsync("scrollSnippetPopoverToSelected", $"snippet-popover-container-{IdSuffix}");
        }
    }

    private async Task InsertSnippet(string snippet)
    {
        var lastBracketIndex = _messageText.LastIndexOf('[');
        if (lastBracketIndex >= 0)
        {
            var before = _messageText[..lastBracketIndex];
            _messageText = before;
            StateHasChanged();

            await Task.Delay(10); // Wait for Blazor to update the DOM

            if (snippet.StartsWith("code"))
            {
                await ApplyFormatting($"[{snippet}]\n", "\n[/code]");
            }
        }

        _showSnippetPopover = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void TriggerSnippetMobile(int index)
    {
        if (index >= 0 && index < _filteredSnippets.Count)
        {
            _ = InsertSnippet(_filteredSnippets[index]);
