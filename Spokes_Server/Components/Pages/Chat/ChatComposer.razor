    private async Task SendMessage()
    {
        if ((string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any()) || CurrentUserId == null || ChannelId == null)
            return;

        var contentToSend = _messageText;
        var attachmentsToSend = _pendingFiles.Where(f => !f.IsUploading && f.Attachment != null)
            .Select(f => f.Attachment!)
            .ToList();

        var pendingBackup = _pendingFiles.ToList();

        _messageText = string.Empty;
        if (_messageField != null)
        {
            _ = _messageField.ClearAsync();
        }
        _pendingFiles.Clear();
        _showMentionPopover = false;
        _showEventPopover = false;
        _showEmojiPicker = false;
        StateHasChanged();

        if (!IsEditMode)
        {
            UserClientStateService.ClearDraft(CurrentUserId, ChannelId);
        }

        try
        {
            await OnSendMessage.InvokeAsync((contentToSend, attachmentsToSend));
        }
        catch (Exception ex)
        {
            _messageText = contentToSend;
            _pendingFiles = pendingBackup;
            if (!IsEditMode)
            {
                UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, contentToSend);
            }
            StateHasChanged();
            Snackbar.Add($"{Loc["Error sending message"].Value}: {ex.Message}", Severity.Error);
        }

        // Stop typing indicator
        if (_typingTimer != null)
        {
            _typingTimer.Stop();
            await ChatService.StopTypingAsync(CurrentUserId, ChannelId);
        }
        if (!IsEditMode)
        {
            UserClientStateService.SetTyping(CurrentUserId, ChannelId, false);
        }
    }

    [JSInvokable]
    public async Task TriggerSendMobile(string? clientText = null)
    {
        if (!string.IsNullOrWhiteSpace(clientText) && string.IsNullOrWhiteSpace(_messageText))
        {
            _messageText = clientText;
        }
        bool disableSendMobile = string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any() || ChannelId == null || _pendingFiles.Any(f => f.IsUploading);
        if (!disableSendMobile)
        {
            await SendMessage();
        }
    }

    private bool HandleAutocompleteKeyNavigation<T>(
        KeyboardEventArgs e,
        bool isShown,
        IReadOnlyList<T> items,
        ref int selectedIndex,
        Action<T> onSelect,
        Action onClose,
        Action? onIndexChanged = null)
    {
        if (!isShown || items.Count == 0) return false;

        switch (e.Key)
        {
            case "ArrowDown":
                selectedIndex = Math.Min(selectedIndex + 1, items.Count - 1);
                onIndexChanged?.Invoke();
                return true;
            case "ArrowUp":
                selectedIndex = Math.Max(selectedIndex - 1, 0);
                onIndexChanged?.Invoke();
                return true;
            case "Enter" or "Tab":
                if (selectedIndex >= 0 && selectedIndex < items.Count)
                {
                    onSelect(items[selectedIndex]);
                }
                return true;
            case "Escape":
                onClose();
                return true;
            default:
                return false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (HandleAutocompleteKeyNavigation(e, _showMentionPopover, _filteredMentions, ref _mentionSelectedIndex,
            m => InsertMention(m), () => _showMentionPopover = false))
            return;

        if (HandleAutocompleteKeyNavigation(e, _showEventPopover, _filteredHashTags, ref _eventSelectedIndex,
            ev => InsertHashTag(ev), () => _showEventPopover = false))
            return;

        if (HandleAutocompleteKeyNavigation(e, _showEmojiAutocompletePopover, _filteredEmojis, ref _emojiSelectedIndex,
            em => InsertEmojiAutocomplete(em), () => _showEmojiAutocompletePopover = false))
            return;

        if (HandleAutocompleteKeyNavigation(e, _showSnippetPopover, _filteredSnippets, ref _snippetSelectedIndex,
            sn => _ = InsertSnippet(sn), () => _showSnippetPopover = false,
            () => { if (_jsModule != null) _ = _jsModule.InvokeVoidAsync("scrollSnippetPopoverToSelected", $"snippet-popover-container-{IdSuffix}"); }))
            return;

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            // Enter without Shift = send message
            // The JS interop prevents the default newline insertion
            await SendMessage();
        }
        else if (e.Key == "ArrowUp" && string.IsNullOrEmpty(_messageText) && !IsEditMode)
        {
            if (OnEditLastMessage.HasDelegate)
            {
                await OnEditLastMessage.InvokeAsync();
            }
        }
        else if (e.Key == "Escape" && IsEditMode)
        {
            await CancelEdit();
        }
    }

    private void HandleTextChanged(string newText)
    {
        _messageText = newText;
        UpdateMentionPopover(newText);
        UpdateEventPopover(newText);
        UpdateEmojiAutocompletePopover(newText);
        UpdateSnippetPopover(newText);

        if (!IsEditMode && ChannelId != null && CurrentUserId != null)
        {
            if (string.IsNullOrWhiteSpace(newText))
            {
                UserClientStateService.ClearDraft(CurrentUserId, ChannelId);
                UserClientStateService.SetTyping(CurrentUserId, ChannelId, false);
                if (_typingTimer != null && _typingTimer.Enabled)
                {
                    _typingTimer.Stop();
                    _ = ChatService.StopTypingAsync(CurrentUserId, ChannelId);
                }
            }
            else
            {
                UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, newText);
                UserClientStateService.SetTyping(CurrentUserId, ChannelId, true);

                if (_typingTimer == null || !_typingTimer.Enabled)
                {
                    _ = ChatService.StartTypingAsync(CurrentUserId, ChannelId);
                }

                var capturedChannelId = ChannelId;
                _typingTimer?.Stop();
                _typingTimer = new System.Timers.Timer(3000);
                _typingTimer.Elapsed += async (s, ev) =>
                {
                    if (capturedChannelId != null && CurrentUserId != null)
                    {
                        UserClientStateService.SetTyping(CurrentUserId, capturedChannelId, false);
                        await ChatService.StopTypingAsync(CurrentUserId, capturedChannelId);
                    }
                };
                _typingTimer.AutoReset = false;
                _typingTimer.Start();
            }
        }
        else if (ChannelId != null && CurrentUserId != null && !string.IsNullOrEmpty(newText))
        {
            if (_typingTimer == null || !_typingTimer.Enabled)
            {
                _ = ChatService.StartTypingAsync(CurrentUserId, ChannelId);
            }

            var capturedChannelId = ChannelId;
            _typingTimer?.Stop();
            _typingTimer = new System.Timers.Timer(3000);
            _typingTimer.Elapsed += async (s, ev) =>
            {
                if (capturedChannelId != null && CurrentUserId != null)
                {
                    await ChatService.StopTypingAsync(CurrentUserId, capturedChannelId);
                }
            };
            _typingTimer.AutoReset = false;
            _typingTimer.Start();
        }
    }

    private void UpdateMentionPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showMentionPopover = false;
            return;
        }

        var lastAtIndex = text.LastIndexOf('@');
        if (lastAtIndex < 0)
        {
            _showMentionPopover = false;
            return;
        }

        var afterAt = text[(lastAtIndex + 1)..];
        if (afterAt.Contains('[') && afterAt.Contains(']'))
        {
            _showMentionPopover = false;
            return;
        }

        _mentionSearchText = afterAt.TrimEnd();
        
        if (_mentionSearchText.Length == 0)
        {
            _filteredMentions = GetAllMentionCandidates();
        }
        else
        {
            _filteredMentions = GetAllMentionCandidates()
                .Where(m => m.DisplayName.Contains(_mentionSearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        _showMentionPopover = _filteredMentions.Any();
        _mentionSelectedIndex = 0;
    }

    private List<MentionCandidate> GetAllMentionCandidates()
    {
        List<MentionCandidate> candidates =
        [
            new() { DisplayName = "everyone", IsSpecial = false, IsEveryone = true }
        ];

        foreach (var team in Teams.OrderBy(t => t.Name))
        {
            candidates.Add(new MentionCandidate
            {
                DisplayName = team.Name,
                IsSpecial = true,
                ProfileColor = team.Color
            });
        }

        foreach (var emp in Employees.Where(e => e.Id != CurrentUserId).OrderBy(e => e.FullName))
        {
            candidates.Add(new MentionCandidate
            {
                Id = emp.Id,
                DisplayName = emp.FullName,
                HasCustomAvatar = emp.HasCustomAvatar,
                AvatarVersion = emp.AvatarVersion,
                ProfileColor = emp.ProfileColor,
                Position = emp.Position
            });
        }

        return candidates;
    }

    private void InsertMention(MentionCandidate mention)
    {
        var lastAtIndex = _messageText.LastIndexOf('@');
        if (lastAtIndex >= 0)
        {
            var before = _messageText[..lastAtIndex];
            if (mention.IsEveryone)
            {
                _messageText = before + "@everyone ";
            }
            else
            {
                _messageText = before + $"@[{mention.DisplayName}] ";
            }
        }

        if (!IsEditMode && CurrentUserId != null && ChannelId != null)
        {
            UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, _messageText);
        }

        _showMentionPopover = false;
        StateHasChanged();
    }

