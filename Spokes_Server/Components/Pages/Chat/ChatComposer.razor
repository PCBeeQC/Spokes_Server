    private async Task InsertEmoji(string emoji)
    {
        bool inserted = false;
        if (_jsModule != null)
        {
            try
            {
                inserted = await _jsModule.InvokeAsync<bool>("insertEmojiAtCursor", IdSuffix, emoji, false);
            }
            catch { }
        }

        if (!inserted)
        {
            _messageText += emoji;
            _forceComposerRender = true;
            StateHasChanged();
        }
    }

    private async Task InsertGif(string gifUrl)
    {
        _showEmojiPicker = false;
        var originalText = _messageText;
        _messageText = $"![GIF]({gifUrl})";
        await SendMessage();
        if (!string.IsNullOrEmpty(originalText))
        {
             // Restore text if there was any draft
             _messageText = originalText;
             _forceComposerRender = true;
             StateHasChanged();
        }
    }

