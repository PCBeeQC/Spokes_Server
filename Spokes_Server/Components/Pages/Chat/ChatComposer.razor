    private bool _isRecordingVoice;
    private bool _isDesktopRecording;
    private string _recordingDurationText = "0:00";
    private DateTime _recordingStartTime;
    private System.Timers.Timer? _recordingTimer;

    private void StartVoiceRecording(bool isDesktop = false)
    {
        _ = InvokeAsync(async () => {
            _isDesktopRecording = isDesktop;
            var targetUpload = isDesktop ? _desktopUpload : _mobileFileUpload;
            if (targetUpload == null || targetUpload.ObjRef == null)
            {
                Snackbar.Add(Loc["Voice upload not initialized yet."].Value, Severity.Warning);
                return;
            }

            _isRecordingVoice = true;
            _recordingStartTime = DateTime.Now;
            _recordingDurationText = "0:00";
            StateHasChanged();
            await Task.Delay(50); // Yield to guarantee Blazor renders the recording UI before prompting for mic access
            
            _recordingTimer = new System.Timers.Timer(1000);
            _recordingTimer.Elapsed += (s, e) => {
                var diff = DateTime.Now - _recordingStartTime;
                _recordingDurationText = $"{(int)diff.TotalMinutes}:{diff.Seconds:D2}";
                InvokeAsync(StateHasChanged);
            };
            _recordingTimer.Start();
            
            var canvasId = isDesktop ? $"voice-soundwave-desktop-{IdSuffix}" : $"voice-soundwave-mobile-{IdSuffix}";
            var started = await JS.InvokeAsync<bool>("spokesVoiceRecorder.startRecording", canvasId);
            if (!started)
            {
                await CancelVoiceRecording();
                Snackbar.Add(Loc["Could not access microphone."].Value, Severity.Error);
            }
            StateHasChanged();
        });
    }

    private async Task CancelVoiceRecording()
    {
        _isRecordingVoice = false;
        StateHasChanged();
        if (_recordingTimer != null) { _recordingTimer.Stop(); _recordingTimer.Dispose(); }
        try { await JS.InvokeVoidAsync("spokesVoiceRecorder.cancelRecording"); } catch { }
    }

    private async Task CompleteVoiceRecording()
    {
        _isRecordingVoice = false;
        StateHasChanged();
        if (_recordingTimer != null) { _recordingTimer.Stop(); _recordingTimer.Dispose(); }
        
        var baseUri = NavigationManager.BaseUri;
        if (!baseUri.EndsWith("/")) baseUri += "/";
        var fallbackUploadUrl = $"{baseUri}spokesapi/files/chat/{ChannelId}";
        var uploadUrl = !string.IsNullOrEmpty(UploadUrl) 
            ? NavigationManager.ToAbsoluteUri(UploadUrl).ToString() 
            : fallbackUploadUrl;

        var targetUpload = _isDesktopRecording ? _desktopUpload : _mobileFileUpload;
        try { await JS.InvokeVoidAsync("spokesVoiceRecorder.stopAndUploadRecording", uploadUrl, targetUpload?.ObjRef); } catch { }
    }

    private bool? _lastInitializedIsMobile;
    private bool _ownsJsModule;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender || _lastInitializedIsMobile != IsMobile)
        {
            _lastInitializedIsMobile = IsMobile;
            using var diagSpan = StartupTimings.Span($"Server: ChatComposer[{_diagTag}] Init chain (import + initComposerAll)"); // DIAG-TEMP
            try
            {
                _objRef ??= DotNetObjectReference.Create(this);
                if (_jsModule == null && PreloadedJsModuleTask != null)
                {
                    _jsModule = await PreloadedJsModuleTask;
                    _ownsJsModule = false;
                }
                if (_jsModule == null)
                {
                    _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                        "import", $"./{Assets.Bypassed("Components/Pages/Chat/ChatComposer.razor.js")}");
                    _ownsJsModule = true;
                }
                await _jsModule.InvokeVoidAsync("initComposerAll", IdSuffix, !Disabled, _objRef);
            }
            catch { /* ignore during prerender */ }
        }
        
        await CheckPendingPayloadAsync();
    }

    internal static string BuildMessageContentWithGifs(string? text, IReadOnlyList<string> gifs)
    {
        var baseText = text ?? string.Empty;
        if (gifs == null || gifs.Count == 0)
        {
            return baseText;
        }

        var gifTokens = string.Join("\n", gifs.Where(g => !string.IsNullOrWhiteSpace(g)).Select(g => $"![GIF]({g})"));
        if (string.IsNullOrWhiteSpace(gifTokens))
        {
            return baseText;
        }

        return string.IsNullOrWhiteSpace(baseText)
            ? gifTokens
            : $"{baseText.TrimEnd()}\n{gifTokens}";
    }

    private async Task SendMessage()
    {
        if ((string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any() && !_pendingGifs.Any()) ||
            CurrentUserId == null ||
            ChannelId == null ||
            _pendingFiles.Any(f => f.IsUploading))
            return;

        var originalText = _messageText;
        var pendingBackup = _pendingFiles.ToList();
        var pendingGifsBackup = _pendingGifs.ToList();

        var contentToSend = BuildMessageContentWithGifs(originalText, pendingGifsBackup);
        var attachmentsToSend = _pendingFiles.Where(f => !f.IsUploading && f.Attachment != null)
            .Select(f => f.Attachment!)
            .ToList();

        _messageText = string.Empty;
        if (_messageField != null)
        {
            _ = _messageField.ClearAsync();
        }
        _pendingFiles.Clear();
        _pendingGifs.Clear();
        _dismissedAlbumSuggestion = false;
        _showMentionPopover = false;
        _showEventPopover = false;
        _showEmojiPicker = false;
        _forceComposerRender = true;
        StateHasChanged();

        if (!IsEditMode)
        {
            UserClientStateService.ClearDraft(CurrentUserId, ChannelId);
        }

        try
        {
            await OnSendMessage.InvokeAsync((contentToSend, attachmentsToSend));
        }
        catch (Exception ex)
        {
            _messageText = originalText;
            _pendingFiles = pendingBackup;
            _pendingGifs = pendingGifsBackup;
            if (!IsEditMode)
            {
                UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, originalText);
            }
            _forceComposerRender = true;
            StateHasChanged();
            Snackbar.Add($"{Loc["Error sending message"].Value}: {ex.Message}", Severity.Error);
        }

        // Stop typing indicator
        if (_typingTimer != null)
        {
            _typingTimer.Stop();
            await ChatService.StopTypingAsync(CurrentUserId, ChannelId);
        }
        if (!IsEditMode)
        {
            UserClientStateService.SetTyping(CurrentUserId, ChannelId, false);
        }
    }

    [JSInvokable]
    public async Task TriggerSendMobile(string? clientText = null)
    {
        if (!string.IsNullOrWhiteSpace(clientText) && string.IsNullOrWhiteSpace(_messageText))
        {
            _messageText = clientText;
        }
        bool disableSendMobile = string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any() && !_pendingGifs.Any() || ChannelId == null || _pendingFiles.Any(f => f.IsUploading);
        if (!disableSendMobile)
        {
            await SendMessage();
        }
    }

    private bool HandleAutocompleteKeyNavigation<T>(
        KeyboardEventArgs e,
        bool isShown,
        IReadOnlyList<T> items,
        ref int selectedIndex,
        Action<T> onSelect,
        Action onClose,
        Action? onIndexChanged = null)
    {
        if (!isShown || items.Count == 0) return false;

        switch (e.Key)
        {
            case "ArrowDown":
                selectedIndex = Math.Min(selectedIndex + 1, items.Count - 1);
                onIndexChanged?.Invoke();
                return true;
            case "ArrowUp":
                selectedIndex = Math.Max(selectedIndex - 1, 0);
                onIndexChanged?.Invoke();
                return true;
            case "Enter" or "Tab":
                if (selectedIndex >= 0 && selectedIndex < items.Count)
                {
                    onSelect(items[selectedIndex]);
                }
                return true;
            case "Escape":
                onClose();
                return true;
            default:
                return false;
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        if (HandleAutocompleteKeyNavigation(e, _showMentionPopover, _filteredMentions, ref _mentionSelectedIndex,
            m => InsertMention(m), () => _showMentionPopover = false))
            return;

        if (HandleAutocompleteKeyNavigation(e, _showEventPopover, _filteredHashTags, ref _eventSelectedIndex,
            ev => InsertHashTag(ev), () => _showEventPopover = false))
            return;

        if (HandleAutocompleteKeyNavigation(e, _showEmojiAutocompletePopover, _filteredEmojis, ref _emojiSelectedIndex,
            em => InsertEmojiAutocomplete(em), () => _showEmojiAutocompletePopover = false))
            return;

        if (HandleAutocompleteKeyNavigation(e, _showSnippetPopover, _filteredSnippets, ref _snippetSelectedIndex,
            sn => _ = InsertSnippet(sn), () => _showSnippetPopover = false,
            () => { if (_jsModule != null) _ = _jsModule.InvokeVoidAsync("scrollSnippetPopoverToSelected", $"snippet-popover-container-{IdSuffix}"); }))
            return;

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            // Enter without Shift = send message
            // The JS interop prevents the default newline insertion
            await SendMessage();
        }
        else if (e.Key == "ArrowUp" && string.IsNullOrEmpty(_messageText) && !IsEditMode)
        {
            if (OnEditLastMessage.HasDelegate)
            {
                await OnEditLastMessage.InvokeAsync();
            }
        }
        else if (e.Key == "Escape" && IsEditMode)
        {
            await CancelEdit();
        }
    }

    private void HandleTextChanged(string newText)
    {
        _messageText = newText;
        UpdateMentionPopover(newText);
        UpdateEventPopover(newText);
        UpdateEmojiAutocompletePopover(newText);
        UpdateSnippetPopover(newText);

        if (!IsEditMode && ChannelId != null && CurrentUserId != null)
        {
            if (string.IsNullOrWhiteSpace(newText))
            {
                UserClientStateService.ClearDraft(CurrentUserId, ChannelId);
                UserClientStateService.SetTyping(CurrentUserId, ChannelId, false);
                if (_typingTimer != null && _typingTimer.Enabled)
                {
                    _typingTimer.Stop();
                    _ = ChatService.StopTypingAsync(CurrentUserId, ChannelId);
                }
            }
            else
            {
                UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, newText);
                UserClientStateService.SetTyping(CurrentUserId, ChannelId, true);

                if (_typingTimer == null || !_typingTimer.Enabled)
                {
                    _ = ChatService.StartTypingAsync(CurrentUserId, ChannelId);
                }

                var capturedChannelId = ChannelId;
                _typingTimer?.Stop();
                _typingTimer = new System.Timers.Timer(3000);
                _typingTimer.Elapsed += async (s, ev) =>
                {
                    if (capturedChannelId != null && CurrentUserId != null)
                    {
                        UserClientStateService.SetTyping(CurrentUserId, capturedChannelId, false);
                        await ChatService.StopTypingAsync(CurrentUserId, capturedChannelId);
                    }
                };
                _typingTimer.AutoReset = false;
                _typingTimer.Start();
            }
        }
        else if (ChannelId != null && CurrentUserId != null && !string.IsNullOrEmpty(newText))
        {
            if (_typingTimer == null || !_typingTimer.Enabled)
            {
                _ = ChatService.StartTypingAsync(CurrentUserId, ChannelId);
            }

            var capturedChannelId = ChannelId;
            _typingTimer?.Stop();
            _typingTimer = new System.Timers.Timer(3000);
            _typingTimer.Elapsed += async (s, ev) =>
            {
                if (capturedChannelId != null && CurrentUserId != null)
                {
                    await ChatService.StopTypingAsync(CurrentUserId, capturedChannelId);
                }
            };
            _typingTimer.AutoReset = false;
            _typingTimer.Start();
        }
    }

    private void UpdateMentionPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showMentionPopover = false;
            return;
        }

        var lastAtIndex = text.LastIndexOf('@');
        if (lastAtIndex < 0)
        {
            _showMentionPopover = false;
            return;
        }

        var afterAt = text[(lastAtIndex + 1)..];
        if (afterAt.Contains('[') && afterAt.Contains(']'))
        {
            _showMentionPopover = false;
            return;
        }

        _mentionSearchText = afterAt.TrimEnd();
        
        if (_mentionSearchText.Length == 0)
        {
            _filteredMentions = GetAllMentionCandidates();
        }
        else
        {
            _filteredMentions = GetAllMentionCandidates()
                .Where(m => m.DisplayName.Contains(_mentionSearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        _showMentionPopover = _filteredMentions.Any();
        _mentionSelectedIndex = 0;
    }

    private List<MentionCandidate> GetAllMentionCandidates()
    {
        List<MentionCandidate> candidates =
        [
            new() { DisplayName = "everyone", IsSpecial = false, IsEveryone = true }
        ];

        foreach (var team in Teams.OrderBy(t => t.Name))
        {
            candidates.Add(new MentionCandidate
            {
                DisplayName = team.Name,
                IsSpecial = true,
                ProfileColor = team.Color
            });
        }

        foreach (var emp in Employees.Where(e => e.Id != CurrentUserId).OrderBy(e => e.FullName))
        {
            candidates.Add(new MentionCandidate
            {
                Id = emp.Id,
                DisplayName = emp.FullName,
                HasCustomAvatar = emp.HasCustomAvatar,
                AvatarVersion = emp.AvatarVersion,
                ProfileColor = emp.ProfileColor,
                Position = emp.Position
            });
        }

        return candidates;
    }

    private void InsertMention(MentionCandidate mention)
    {
        var lastAtIndex = _messageText.LastIndexOf('@');
        if (lastAtIndex >= 0)
        {
            var before = _messageText[..lastAtIndex];
            if (mention.IsEveryone)
            {
                _messageText = before + "@everyone ";
            }
            else
            {
                _messageText = before + $"@[{mention.DisplayName}] ";
            }
        }

        if (!IsEditMode && CurrentUserId != null && ChannelId != null)
        {
            UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, _messageText);
        }

        _showMentionPopover = false;
        StateHasChanged();
    }

    [JSInvokable]
    public void TriggerMentionMobile(int index)
    {
        if (index >= 0 && index < _filteredMentions.Count)
        {
            InsertMention(_filteredMentions[index]);
            StateHasChanged(); // Ensure UI refreshes
        }
    }

    private void UpdateEventPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showEventPopover = false;
            return;
        }

        var lastHashIndex = text.LastIndexOf('#');
        if (lastHashIndex < 0)
        {
            _showEventPopover = false;
            return;
        }

        var afterHash = text[(lastHashIndex + 1)..];
        if (afterHash.Contains('[') && afterHash.Contains(']'))
        {
            _showEventPopover = false;
            return;
        }

        _eventSearchText = afterHash.TrimEnd();
        
        if (_eventSearchText.Length == 0)
        {
            _filteredHashTags = GetAllHashTagCandidates();
        }
        else
        {
            _filteredHashTags = GetAllHashTagCandidates()
                .Where(e => e.Title.Contains(_eventSearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        _showEventPopover = _filteredHashTags.Any();
        _eventSelectedIndex = 0;
    }

    private List<HashTagCandidate> GetAllHashTagCandidates()
    {
        if (CurrentUserId == null) return [];
        
        List<HashTagCandidate> candidates = [];

        // 1. Events
        var now = Spokes_Server.Core.Services.Maintenance.Time.SpokesClockService.Instance.Now.Date;
        if (DateTime.Today < now)
        {
            now = DateTime.Today;
        }
        var currentUser = !string.IsNullOrEmpty(CurrentUserId) ? Db.Employees.GetById(CurrentUserId) : null;
        var events = new List<CalendarEvent>();
        if (Spokes_Server.Core.Services.HR.CalendarService.HasCalendarViewAccess(currentUser)
            || Spokes_Server.Core.Services.HR.CalendarService.HasCalendarAdminOverride(currentUser))
        {
            var userTeamIds = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            if (!string.IsNullOrEmpty(currentUser?.TeamId))
            {
                userTeamIds.Add(currentUser.TeamId);
            }
            if (!string.IsNullOrEmpty(CurrentUserId))
            {
                foreach (var team in Db.Teams.GetAll().Where(t => string.Equals(t.LeaderId, CurrentUserId, StringComparison.OrdinalIgnoreCase)))
                {
                    if (!string.IsNullOrEmpty(team.Id))
                    {
                        userTeamIds.Add(team.Id);
                    }
                }
            }

            events = Db.CalendarEvents.GetAll()
                .Where(e => (e.Start.Date >= now || e.End.Date >= now)
                    && Spokes_Server.Core.Services.HR.CalendarService.CanUserViewEventCore(e, currentUser, userTeamIds))
                .OrderBy(e => e.Start)
                .ToList();
        }

        foreach (var e in events)
        {
            candidates.Add(new HashTagCandidate
            {
                Id = e.Id,
                Title = e.Title,
                Subtitle = e.IsAllDay ? e.Start.ToString("MMM d") : e.Start.ToString("MMM d, h:mm tt"),
                Type = "event"
            });
        }

        // 2. Albums
        if (currentUser != null && currentUser.HasPermission(AppPermissions.Albums.View))
        {
            var albums = Db.Albums.GetAll()
                .Where(a => a.OwnerId == CurrentUserId || (!string.IsNullOrEmpty(ChannelId) && a.SharedWithChannelIds != null && a.SharedWithChannelIds.Contains(ChannelId)))
                .OrderByDescending(a => a.CreatedAt)
                .ToList();
                
            foreach (var a in albums)
            {
                candidates.Add(new HashTagCandidate
                {
                    Id = a.Id,
                    Title = a.Title,
                    Subtitle = $"Album ({a.Media.Count} items)",
                    Type = "album"
                });
            }
        }

        // 3. Polls in current channel
        if (!string.IsNullOrEmpty(ChannelId) && !string.IsNullOrEmpty(CurrentUserId))
        {
            var polls = PollService.GetPollsForChannel(ChannelId, CurrentUserId);
            foreach (var p in polls)
            {
                var displayPoll = PollService.DecryptPollForDisplay(p, ChannelKey);
                candidates.Add(new HashTagCandidate
                {
                    Id = p.Id,
                    Title = displayPoll.Question,
                    Subtitle = $"{Loc["Poll"].Value} ({p.TotalVotes} {(p.TotalVotes == 1 ? Loc["vote"].Value : Loc["votes"].Value)})",
                    Type = "poll"
                });
            }
        }

        return candidates;
    }

    private void InsertHashTag(HashTagCandidate tag)
    {
        var lastHashIndex = _messageText.LastIndexOf('#');
        if (lastHashIndex >= 0)
        {
            var before = _messageText[..lastHashIndex];
            var type = tag.Type;
            _messageText = before + $"#[{tag.Title}]({type}:{tag.Id}) ";
        }

        if (!IsEditMode && CurrentUserId != null && ChannelId != null)
        {
            UserClientStateService.UpdateDraftInMemory(CurrentUserId, ChannelId, _messageText);
        }

        _showEventPopover = false;
        StateHasChanged();
    }

