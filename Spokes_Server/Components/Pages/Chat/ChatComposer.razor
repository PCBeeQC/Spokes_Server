    private async Task HandleApiUploadStarted()
    {
        _pendingFiles.Add(new PendingFile { FileName = "Uploading...", StageText = "Uploading...", IsUploading = true, UploadProgress = 0 });
        StateHasChanged();

        if (_messageFieldDesktop != null)
        {
            await _messageFieldDesktop.FocusAsync();
        }
        else if (_messageField != null)
        {
            await _messageField.FocusAsync();
        }
    }

    private void HandleApiUploadCompleted(List<ApiFileUpload.UploadResult> results)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder != null) _pendingFiles.Remove(placeholder);

        foreach (var r in results)
        {
            var attachment = new ChatAttachment {
                Id = Guid.NewGuid().ToString(),
                FileName = r.FileName,
                FilePath = r.FilePath,
                ContentType = r.ContentType,
                FileSizeBytes = r.FileSizeBytes,
                HasServerThumbnail = r.HasThumbnail,
                ImageWidth = r.ImageWidth,
                ImageHeight = r.ImageHeight
            };
            _pendingFiles.Add(new PendingFile { FileName = r.FileName, IsUploading = false, Attachment = attachment });
        }
        StateHasChanged();
    }

    private void HandleVoiceUploadCompleted(List<ApiFileUpload.UploadResult> results)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder != null) _pendingFiles.Remove(placeholder);
        
        List<ChatAttachment> voiceAttachments = [];

        foreach (var r in results)
        {
            var attachment = new ChatAttachment {
                Id = Guid.NewGuid().ToString(),
                FileName = r.FileName,
                FilePath = r.FilePath,
                ContentType = r.ContentType,
                FileSizeBytes = r.FileSizeBytes,
                HasServerThumbnail = r.HasThumbnail,
                ImageWidth = r.ImageWidth,
                ImageHeight = r.ImageHeight
            };
            voiceAttachments.Add(attachment);
        }
        
        StateHasChanged();

        _ = InvokeAsync(async () => {
            if (CurrentUserId == null || ChannelId == null) return;
            try
            {
                await OnSendMessage.InvokeAsync(("", voiceAttachments));
            }
            catch (Exception ex)
            {
                foreach (var v in voiceAttachments) {
                    _pendingFiles.Add(new PendingFile { FileName = v.FileName, IsUploading = false, Attachment = v });
                }
                StateHasChanged();
                Snackbar.Add($"{Loc["Error sending voice message"].Value}: {ex.Message}", Severity.Error);
            }
        });
    }

    private void HandleApiUploadError(string error)
    {
        var placeholder = _pendingFiles.FirstOrDefault(f => f.IsUploading);
        if (placeholder != null) _pendingFiles.Remove(placeholder);
        
        Snackbar.Add($"{Loc["Upload failed"].Value}: {error}", Severity.Error);
        StateHasChanged();
    }

