    private void StartVoiceRecording(bool isDesktop = false)
    {
        _ = InvokeAsync(async () => {
            _isDesktopRecording = isDesktop;
            var targetUpload = isDesktop ? _desktopVoiceUpload : _mobileVoiceUpload;
            if (targetUpload == null || targetUpload.ObjRef == null)
            {
                Snackbar.Add("Voice upload not initialized yet.", Severity.Warning);
                return;
            }

            _isRecordingVoice = true;
            _recordingStartTime = DateTime.Now;
            _recordingDurationText = "0:00";
            StateHasChanged();
            await Task.Delay(50); // Yield to guarantee Blazor renders the recording UI before prompting for mic access
            
            _recordingTimer = new System.Timers.Timer(1000);
            _recordingTimer.Elapsed += (s, e) => {
                var diff = DateTime.Now - _recordingStartTime;
                _recordingDurationText = $"{(int)diff.TotalMinutes}:{diff.Seconds:D2}";
                InvokeAsync(StateHasChanged);
            };
            _recordingTimer.Start();
            
            var canvasId = isDesktop ? $"voice-soundwave-desktop-{IdSuffix}" : $"voice-soundwave-mobile-{IdSuffix}";
            var started = await JS.InvokeAsync<bool>("spokesVoiceRecorder.startRecording", targetUpload.ObjRef, canvasId);
            if (!started)
            {
                await CancelVoiceRecording();
                Snackbar.Add("Could not access microphone.", Severity.Error);
            }
            StateHasChanged();
        });
    }

    private async Task CancelVoiceRecording()
    {
        _isRecordingVoice = false;
        StateHasChanged();
        if (_recordingTimer != null) { _recordingTimer.Stop(); _recordingTimer.Dispose(); }
        try { await JS.InvokeVoidAsync("spokesVoiceRecorder.cancelRecording"); } catch { }
    }

    private async Task SendVoiceRecording()
    {
        _isRecordingVoice = false;
        StateHasChanged();
        if (_recordingTimer != null) { _recordingTimer.Stop(); _recordingTimer.Dispose(); }
        
        var baseUri = NavigationManager.BaseUri;
        if (!baseUri.EndsWith("/")) baseUri += "/";
        var fallbackUploadUrl = $"{baseUri}spokesapi/files/chat/{ChannelId}";
        var uploadUrl = !string.IsNullOrEmpty(UploadUrl) 
            ? NavigationManager.ToAbsoluteUri(UploadUrl).ToString() 
            : fallbackUploadUrl;

        var targetUpload = _isDesktopRecording ? _desktopVoiceUpload : _mobileVoiceUpload;
        try { await JS.InvokeVoidAsync("spokesVoiceRecorder.stopAndUploadRecording", uploadUrl, targetUpload?.ObjRef); } catch { }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _objRef = DotNetObjectReference.Create(this);
                _jsModule = await JS.InvokeAsync<IJSObjectReference>(
                    "import", $"./{Assets.Bypassed("Components/Pages/Chat/ChatComposer.razor.js")}");
                // Initialize Enter key prevention and paste handling on BOTH fields
                // (only the one actually rendered in DOM will succeed)
                try { await _jsModule.InvokeVoidAsync("initComposer", $"chat-message-input-{IdSuffix}", false, !Disabled, _objRef); } catch { }
                try { await _jsModule.InvokeVoidAsync("initComposer", $"chat-message-input-desktop-{IdSuffix}", true, !Disabled, _objRef); } catch { }
                
                // Initialize the mobile send button with active (non-passive) touch listeners to permanently prevent keyboard drops
                // Initialize mobile send button touch listeners
                try { await _jsModule.InvokeVoidAsync("initMobileSendButton", $"mobile-send-btn-{IdSuffix}", _objRef); } catch { }
                
                // Initialize mention popover touch listeners to securely prevent focus loss
                try { await _jsModule.InvokeVoidAsync("initMentionPopover", $"mention-popover-container-{IdSuffix}", _objRef); } catch { }
                // Initialize event popover touch listeners
                try { await _jsModule.InvokeVoidAsync("initEventPopover", $"event-popover-container-{IdSuffix}", _objRef); } catch { }
                // Initialize emoji autocomplete popover touch listeners
                try { await _jsModule.InvokeVoidAsync("initEmojiAutocompletePopover", $"emoji-autocomplete-popover-container-{IdSuffix}", _objRef); } catch { }
                // Initialize snippet autocomplete popover touch listeners
                try { await _jsModule.InvokeVoidAsync("initSnippetPopover", $"snippet-popover-container-{IdSuffix}", _objRef); } catch { }
            }
            catch { /* ignore during prerender */ }
        }
        
        await CheckPendingPayloadAsync();
    }

    private async Task SendMessage()
    {
        if ((string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any()) || CurrentUserId == null || ChannelId == null)
            return;

        var contentToSend = _messageText;
        var attachmentsToSend = _pendingFiles.Where(f => !f.IsUploading && f.Attachment != null)
            .Select(f => f.Attachment!)
            .ToList();

        var pendingBackup = _pendingFiles.ToList();

        _messageText = string.Empty;
        _pendingFiles.Clear();
        _showMentionPopover = false;
        _showEventPopover = false;
        _showEmojiPicker = false;
        StateHasChanged();

        try
        {
            await OnSendMessage.InvokeAsync((contentToSend, attachmentsToSend));
        }
        catch (Exception ex)
        {
            _messageText = contentToSend;
            _pendingFiles = pendingBackup;
            StateHasChanged();
            Snackbar.Add($"Error sending message: {ex.Message}", Severity.Error);
        }

        // Stop typing indicator
        if (_typingTimer != null)
        {
            _typingTimer.Stop();
            await ChatService.StopTypingAsync(CurrentUserId, ChannelId);
        }
    }

    [JSInvokable]
    public async Task TriggerSendMobile()
    {
        bool disableSendMobile = string.IsNullOrWhiteSpace(_messageText) && !_pendingFiles.Any() || ChannelId == null || _pendingFiles.Any(f => f.IsUploading);
        if (!disableSendMobile)
        {
            await SendMessage();
        }
    }

    private async Task HandleKeyPress(KeyboardEventArgs e)
    {
        // Mention popup keyboard navigation
        if (_showMentionPopover && _filteredMentions.Any())
        {
            if (e.Key == "ArrowDown")
            {
                _mentionSelectedIndex = Math.Min(_mentionSelectedIndex + 1, _filteredMentions.Count - 1);
                return;
            }
            if (e.Key == "ArrowUp")
            {
                _mentionSelectedIndex = Math.Max(_mentionSelectedIndex - 1, 0);
                return;
            }
            if (e.Key == "Enter" || e.Key == "Tab")
            {
                InsertMention(_filteredMentions[_mentionSelectedIndex]);
                return;
            }
            if (e.Key == "Escape")
            {
                _showMentionPopover = false;
                return;
            }
        }

        // Event popup keyboard navigation
        if (_showEventPopover && _filteredHashTags.Any())
        {
            if (e.Key == "ArrowDown")
            {
                _eventSelectedIndex = Math.Min(_eventSelectedIndex + 1, _filteredHashTags.Count - 1);
                return;
            }
            if (e.Key == "ArrowUp")
            {
                _eventSelectedIndex = Math.Max(_eventSelectedIndex - 1, 0);
                return;
            }
            if (e.Key == "Enter" || e.Key == "Tab")
            {
                InsertHashTag(_filteredHashTags[_eventSelectedIndex]);
                return;
            }
            if (e.Key == "Escape")
            {
                _showEventPopover = false;
                return;
            }
        }

        // Emoji popup keyboard navigation
        if (_showEmojiAutocompletePopover && _filteredEmojis.Any())
        {
            if (e.Key == "ArrowDown")
            {
                _emojiSelectedIndex = Math.Min(_emojiSelectedIndex + 1, _filteredEmojis.Count - 1);
                return;
            }
            if (e.Key == "ArrowUp")
            {
                _emojiSelectedIndex = Math.Max(_emojiSelectedIndex - 1, 0);
                return;
            }
            if (e.Key == "Enter" || e.Key == "Tab")
            {
                InsertEmojiAutocomplete(_filteredEmojis[_emojiSelectedIndex]);
                return;
            }
            if (e.Key == "Escape")
            {
                _showEmojiAutocompletePopover = false;
                return;
            }
        }

        // Snippet popup keyboard navigation
        if (_showSnippetPopover && _filteredSnippets.Any())
        {
            if (e.Key == "ArrowDown")
            {
                _snippetSelectedIndex = Math.Min(_snippetSelectedIndex + 1, _filteredSnippets.Count - 1);
                if (_jsModule != null) _ = _jsModule.InvokeVoidAsync("scrollSnippetPopoverToSelected", $"snippet-popover-container-{IdSuffix}");
                return;
            }
            if (e.Key == "ArrowUp")
            {
                _snippetSelectedIndex = Math.Max(_snippetSelectedIndex - 1, 0);
                if (_jsModule != null) _ = _jsModule.InvokeVoidAsync("scrollSnippetPopoverToSelected", $"snippet-popover-container-{IdSuffix}");
                return;
            }
            if (e.Key == "Enter" || e.Key == "Tab")
            {
                _ = InsertSnippet(_filteredSnippets[_snippetSelectedIndex]);
                return;
            }
            if (e.Key == "Escape")
            {
                _showSnippetPopover = false;
                return;
            }
        }

        if (e.Key == "Enter" && !e.ShiftKey)
        {
            // Enter without Shift = send message
            // The JS interop prevents the default newline insertion
            await SendMessage();
        }
        else if (e.Key == "ArrowUp" && string.IsNullOrEmpty(_messageText) && !IsEditMode)
        {
            if (OnEditLastMessage.HasDelegate)
            {
                await OnEditLastMessage.InvokeAsync();
            }
        }
        else if (e.Key == "Escape" && IsEditMode)
        {
            await CancelEdit();
        }
    }

    private void HandleTextChanged(string newText)
    {
        _messageText = newText;
        UpdateMentionPopover(newText);
        UpdateEventPopover(newText);
        UpdateEmojiAutocompletePopover(newText);
        UpdateSnippetPopover(newText);

        if (ChannelId != null && CurrentUserId != null && !string.IsNullOrEmpty(newText))
        {
            if (_typingTimer == null || !_typingTimer.Enabled)
            {
                _ = ChatService.StartTypingAsync(CurrentUserId, ChannelId);
            }

            var capturedChannelId = ChannelId;
            _typingTimer?.Stop();
            _typingTimer = new System.Timers.Timer(3000);
            _typingTimer.Elapsed += async (s, ev) =>
            {
                if (capturedChannelId != null && CurrentUserId != null)
                {
                    await ChatService.StopTypingAsync(CurrentUserId, capturedChannelId);
                }
            };
            _typingTimer.AutoReset = false;
            _typingTimer.Start();
        }
    }

    private void UpdateMentionPopover(string text)
    {
        if (string.IsNullOrEmpty(text))
        {
            _showMentionPopover = false;
            return;
        }

        var lastAtIndex = text.LastIndexOf('@');
        if (lastAtIndex < 0)
        {
            _showMentionPopover = false;
            return;
        }

        var afterAt = text[(lastAtIndex + 1)..];
        if (afterAt.Contains('[') && afterAt.Contains(']'))
        {
            _showMentionPopover = false;
            return;
        }

        _mentionSearchText = afterAt.TrimEnd();
        
        if (_mentionSearchText.Length == 0)
        {
            _filteredMentions = GetAllMentionCandidates();
        }
        else
        {
            _filteredMentions = GetAllMentionCandidates()
                .Where(m => m.DisplayName.Contains(_mentionSearchText, StringComparison.OrdinalIgnoreCase))
                .ToList();
        }

        _showMentionPopover = _filteredMentions.Any();
        _mentionSelectedIndex = 0;
    }

    private List<MentionCandidate> GetAllMentionCandidates()
    {
        var candidates = new List<MentionCandidate>
        {
            new() { DisplayName = "everyone", IsSpecial = false, IsEveryone = true }
        };

        foreach (var team in Teams.OrderBy(t => t.Name))
        {
            candidates.Add(new MentionCandidate
            {
                DisplayName = team.Name,
                IsSpecial = true,
                ProfileColor = team.Color
            });
        }

        foreach (var emp in Employees.Where(e => e.Id != CurrentUserId).OrderBy(e => e.FullName))
        {
            candidates.Add(new MentionCandidate
            {
                Id = emp.Id,
                DisplayName = emp.FullName,
                HasCustomAvatar = emp.HasCustomAvatar,
                AvatarVersion = emp.AvatarVersion,
                ProfileColor = emp.ProfileColor,
                Position = emp.Position
            });
        }

        return candidates;
    }

    private void InsertMention(MentionCandidate mention)
    {
        var lastAtIndex = _messageText.LastIndexOf('@');
        if (lastAtIndex >= 0)
        {
            var before = _messageText[..lastAtIndex];
            if (mention.IsEveryone)
            {
                _messageText = before + "@everyone ";
            }
            else
            {
                _messageText = before + $"@[{mention.DisplayName}] ";
            }
        }

        _showMentionPopover = false;
        StateHasChanged();
    }

