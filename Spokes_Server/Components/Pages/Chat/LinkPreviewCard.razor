@using Spokes_Server.Core.Security
@* Link preview card — rendered below message content for each URL *@
@if (Preview != null && SafeExternalHttpHandler.IsSafeExternalUrl(Preview.Url) && (!string.IsNullOrEmpty(Preview.Title) || Preview.IsYouTube))
{
    <MudPaper Elevation="0" Class="mt-2 link-preview-card chat-link-preview-card">

        @if (Preview.IsYouTube)
        {
            @if (_playVideo && SafeExternalHttpHandler.IsSafeExternalUrl(Preview.VideoEmbedUrl, requireHttps: true))
            {
                <div class="chat-link-preview-yt-box">
                    <iframe src="@Preview.VideoEmbedUrl"
                            class="chat-link-preview-yt-iframe"
                            allow="autoplay; encrypted-media; picture-in-picture"
                            allowfullscreen>
                    </iframe>
                </div>
            }
            else
            {
                <div class="chat-link-preview-yt-box chat-link-preview-yt-thumb"
                     @onclick="() => _playVideo = true">
                    @if (!string.IsNullOrEmpty(Preview.ImageUrl) && SafeExternalHttpHandler.IsSafeExternalUrl(Preview.ImageUrl) && !_imageFailed)
                    {
                        <img src="@Preview.ImageUrl" alt="@Preview.Title"
                            referrerpolicy="no-referrer"
                            class="chat-link-preview-yt-img"
                            @onerror="@(() => _imageFailed = true)" />
                    }
                    <div class="yt-overlay chat-link-preview-yt-overlay">
                        <MudIcon Icon="@Icons.Custom.Brands.YouTube" Class="chat-link-preview-yt-icon" />
                    </div>
                </div>
            }
        }
        else
        {
            <a href="@Preview.Url" target="_blank" rel="noopener noreferrer" class="chat-link-preview-anchor">
                @if (!string.IsNullOrEmpty(Preview.ImageUrl) && SafeExternalHttpHandler.IsSafeExternalUrl(Preview.ImageUrl) && !_imageFailed)
                {
                    <div class="chat-link-preview-img-wrap">
                        <img src="@Preview.ImageUrl" alt="@Preview.Title"
                            referrerpolicy="no-referrer"
                            class="chat-link-preview-img"
                            @onerror="@(() => _imageFailed = true)" />
                    </div>
                }
            </a>
        }

        <a href="@Preview.Url" target="_blank" rel="noopener noreferrer" class="chat-link-preview-anchor">
            <div class="pa-3">
                @* Site name / domain *@
                <div class="d-flex align-center gap-1 mb-1">
                    @if (!string.IsNullOrEmpty(Preview.FaviconUrl) && SafeExternalHttpHandler.IsSafeExternalUrl(Preview.FaviconUrl) && !_faviconFailed)
                    {
                        <img src="@Preview.FaviconUrl" alt="" referrerpolicy="no-referrer" class="chat-link-preview-favicon"
                            @onerror="@(() => _faviconFailed = true)" />
                    }
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @(Preview.SiteName ?? LinkPreviewService.GetDomain(Preview.Url))
                    </MudText>
                </div>

                @* Title *@
                <MudText Typo="Typo.body2" Class="chat-link-preview-title">
                    @Preview.Title
                </MudText>

                @* Description *@
                @if (!string.IsNullOrEmpty(Preview.Description))
                {
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 chat-link-preview-desc">
                        @Preview.Description
                    </MudText>
                }
            </div>
        </a>
    </MudPaper>
}

@* Styles live in wwwroot/css/chat.css: this component renders once per link preview, so inline style blocks would be re-sent and re-inserted per instance (AGENTS.md §3). *@

@code {
    [Parameter] public LinkPreview? Preview { get; set; }

    private bool _imageFailed;
    private bool _faviconFailed;
    private bool _playVideo;
    private string? _currentUrl;
    private int _lastFingerprint;
    private bool _hasRenderedOnce;

    private int ComputeFingerprint() => HashCode.Combine(
        Preview?.Url,
        Preview?.Title,
        Preview?.Description,
        Preview?.ImageUrl,
        Preview?.FaviconUrl,
        Preview?.IsYouTube,
        _imageFailed,
        HashCode.Combine(_faviconFailed, _playVideo));

    protected override bool ShouldRender()
    {
        var fp = ComputeFingerprint();
        if (!_hasRenderedOnce || fp != _lastFingerprint)
        {
            _hasRenderedOnce = true;
            _lastFingerprint = fp;
            return true;
        }
        return false;
    }

    protected override void OnParametersSet()
    {
        if (Preview?.Url != _currentUrl)
        {
            _currentUrl = Preview?.Url;
            _imageFailed = false;
            _faviconFailed = false;
            _playVideo = false;
        }
    }
}
