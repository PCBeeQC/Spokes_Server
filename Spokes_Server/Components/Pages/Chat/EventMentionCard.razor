@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.HR
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Dialogs.Communication.Chat
@inject CalendarService CalendarService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IUserPrivacyService PrivacyService
@implements IDisposable

@if (_event == null)
{
    <MudCard Class="pa-3 chat-card-unavailable">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="chat-card-italic">@Loc["This event is no longer available."]</MudText>
        </div>
    </MudCard>
}
else
{
    <MudCard Class="pa-3 chat-event-card">
        <div class="d-flex align-center gap-3 mb-2 cursor-pointer" @onclick="OpenEventDetailsDialog" title="@Loc["Click to view event details"]">
            <MudAvatar Size="Size.Medium" Class="chat-event-avatar">
                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
            </MudAvatar>
            <div class="chat-overflow-hidden">
                <MudText Typo="Typo.subtitle2" Class="chat-event-title">@_event.Title</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(_event.IsAllDay ? _event.Start.ToString("MMMM d, yyyy") : $"{_event.Start.ToString("MMM d, h:mm tt")} - {_event.End.ToString("h:mm tt")}")
                </MudText>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_event.Location))
        {
            <MudText Typo="Typo.body2" Class="mb-3 d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary"/> @_event.Location
            </MudText>
        }
        @if (!string.IsNullOrWhiteSpace(_event.Description))
        {
            <MudText Typo="Typo.body2" Class="mb-3 chat-event-desc">
                @_event.Description
            </MudText>
        }
        <div class="d-flex justify-space-between align-center gap-2 w-100 mb-n1 chat-event-footer">
            <div class="d-flex align-center gap-1 attendee-row chat-event-attendee-row" @onclick="OpenAttendeesDialog" title="@Loc["Click to view all attendees"]">
                @if (_event.Attendees != null && _event.Attendees.Any())
                {
                    @if (!ShouldHideAttendeeIdentities())
                    {
                        <div class="d-flex align-center gap-1">
                            @foreach (var attendeeId in _event.Attendees.Take(5))
                            {
                                var emp = Employees.FirstOrDefault(e => e.Id == attendeeId);
                                if (emp != null && CanDiscoverEmployee(emp))
                                {
                                    <span title="@emp.FullName" class="chat-mini-avatar-wrap">
                                        <EmployeeAvatar Employee="emp" Size="Size.Small" ShowPresence="false" Class="chat-mini-avatar-16" />
                                    </span>
                                }
                                else
                                {
                                    <EmployeeAvatar Employee="@null" Size="Size.Small" ShowPresence="false" Class="chat-mini-avatar-16" />
                                }
                            }
                        </div>
                        @if (_event.Attendees.Count > 5)
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1 chat-event-count">
                                +@(_event.Attendees.Count - 5)
                            </MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1 chat-event-count">
                                (@_event.Attendees.Count)
                            </MudText>
                        }
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="ml-1 chat-event-count">
                            (@_event.Attendees.Count)
                        </MudText>
                    }
                }
            </div>
            <div class="d-flex justify-end flex-shrink-0 gap-2">
                @if (_event.Attendees != null && !string.IsNullOrEmpty(CurrentUserId) && _event.Attendees.Contains(CurrentUserId))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close"
                        OnClick="CancelRsvp" Disabled="@IsCurrentUserSuspended">@Loc["Cancel"]</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                        OnClick="Rsvp" Disabled="@IsCurrentUserSuspended">@Loc["I'm in!"]</MudButton>
                }
            </div>
        </div>
    </MudCard>
}

@* Styles live in wwwroot/css/chat.css: this component renders once per event mention, so inline style blocks would be re-sent and re-inserted per instance (AGENTS.md §3). *@

@code {
    [Parameter, EditorRequired]
    public string EventId { get; set; } = string.Empty;

    [Parameter]
    public string? CurrentUserId { get; set; }

    [Parameter]
    public string? ChannelId { get; set; }

    [Parameter, EditorRequired]
    public List<Employee> Employees { get; set; } = [];

    private CalendarEvent? _event;
    private int _lastRenderFingerprint;
    private bool _hasRenderedOnce;

    private int ComputeEventRenderFingerprint()
    {
        var hash = new HashCode();
        hash.Add(EventId, StringComparer.Ordinal);
        hash.Add(CurrentUserId, StringComparer.Ordinal);
        hash.Add(ChannelId, StringComparer.Ordinal);
        hash.Add(_event != null);
        if (_event != null)
        {
            hash.Add(_event.Title, StringComparer.Ordinal);
            hash.Add(_event.Start.Ticks);
            hash.Add(_event.End.Ticks);
            hash.Add(_event.IsAllDay);
            hash.Add(_event.Location, StringComparer.Ordinal);
            hash.Add(_event.Description, StringComparer.Ordinal);
            hash.Add(_event.Attendees?.Count ?? 0);
            if (_event.Attendees != null)
            {
                foreach (var a in _event.Attendees)
                {
                    hash.Add(a, StringComparer.Ordinal);
                }
            }
        }
        return hash.ToHashCode();
    }

    protected override bool ShouldRender()
    {
        var fp = ComputeEventRenderFingerprint();
        if (!_hasRenderedOnce || fp != _lastRenderFingerprint)
        {
            _hasRenderedOnce = true;
            _lastRenderFingerprint = fp;
            return true;
        }
        return false;
    }

    [Inject] private Database Db { get; set; } = default!;

    private Employee? ResolveLiveCurrentUser()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return null;
        return Db.Employees.GetById(CurrentUserId) ?? Employees.FirstOrDefault(e => e.Id == CurrentUserId);
    }

    private bool IsCurrentUserSuspended =>
        ResolveLiveCurrentUser()?.IsSuspended == true;

    private bool CanDiscoverEmployee(Employee? target)
        => target != null && PrivacyService.CanDiscoverUser(ResolveLiveCurrentUser(), target);

    private bool ShouldHideAttendeeIdentities()
    {
        if (string.IsNullOrEmpty(ChannelId)) return false;
        var channel = Db.ChatChannels.GetById(ChannelId);
        return channel != null && PrivacyService.ShouldHideMemberList(channel, ResolveLiveCurrentUser());
    }

    private CalendarEvent? ResolveAuthorizedEvent(CalendarEvent? evt)
    {
        if (evt == null) return null;
        var currentEmp = ResolveLiveCurrentUser();
        if (currentEmp == null || !CalendarService.CanUserViewEvent(evt, currentEmp))
        {
            return null;
        }
        return evt;
    }

    protected override void OnInitialized()
    {
        _event = ResolveAuthorizedEvent(CalendarService.GetEventById(EventId));
        CalendarService.EventUpdated += HandleCalendarEventUpdated;
    }

    protected override void OnParametersSet()
    {
        if (_event == null || _event.Id != EventId)
        {
            _event = ResolveAuthorizedEvent(CalendarService.GetEventById(EventId));
        }
    }

    private void HandleCalendarEventUpdated(CalendarEvent updatedEvent)
    {
        if (updatedEvent.Id == EventId)
        {
            _event = ResolveAuthorizedEvent(updatedEvent);
            InvokeAsync(StateHasChanged);
        }
    }

    private void Rsvp()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return;
        var currentEmp = ResolveLiveCurrentUser();
        if (currentEmp == null || (!CalendarService.CanCreateOrParticipateInCalendar(currentEmp) && !CalendarService.HasCalendarAdminOverride(currentEmp)))
        {
            Snackbar.Add(Loc["You do not have permission to RSVP to calendar events."].Value, Severity.Warning);
            return;
        }

        var result = CalendarService.RsvpToEvent(EventId, CurrentUserId);
        if (result.IsSuccess)
        {
            _event = ResolveAuthorizedEvent(CalendarService.GetEventById(EventId));
            Snackbar.Add(Loc["You're in! Event added to your calendar."].Value, Severity.Success);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to RSVP to event."].Value, Severity.Warning);
        }
    }

    private void CancelRsvp()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return;
        var result = CalendarService.CancelRsvpEvent(EventId, CurrentUserId);
        if (result.IsSuccess)
        {
            _event = ResolveAuthorizedEvent(CalendarService.GetEventById(EventId));
            Snackbar.Add(Loc["Attendance cancelled."].Value, Severity.Info);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to cancel RSVP."].Value, Severity.Warning);
        }
    }

    private async Task OpenAttendeesDialog()
    {
        if (_event?.Attendees == null || !_event.Attendees.Any()) return;
        bool anonymize = ShouldHideAttendeeIdentities();
        var safeAttendeeIds = new List<string>(_event.Attendees.Count);
        var discoverableEmployees = new List<Employee>();
        var addedEmployeeIds = new HashSet<string>(StringComparer.Ordinal);
        for (int i = 0; i < _event.Attendees.Count; i++)
        {
            var attendeeId = _event.Attendees[i];
            var emp = Employees.FirstOrDefault(e => e.Id == attendeeId);
            if (!anonymize && emp != null && CanDiscoverEmployee(emp))
            {
                safeAttendeeIds.Add(attendeeId);
                if (addedEmployeeIds.Add(emp.Id))
                {
                    discoverableEmployees.Add(emp);
                }
            }
            else
            {
                var anonId = $"__anon_{i}";
                safeAttendeeIds.Add(anonId);
                discoverableEmployees.Add(new Employee { Id = anonId, FirstName = Loc["Unknown User"].Value, LastName = string.Empty });
            }
        }
        var parameters = new DialogParameters<MessageReactionsDialog>
        {
            { x => x.IsAttendeesMode, true },
            { x => x.AttendeeUserIds, safeAttendeeIds },
            { x => x.Employees, discoverableEmployees },
            { x => x.AnonymizeUsers, anonymize },
            { x => x.CustomTitle, string.Format(Loc["{0} Attendees"].Value, _event.Title) }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<MessageReactionsDialog>(Loc["Event Attendees"].Value, parameters, options);
    }

    private async Task OpenEventDetailsDialog()
    {
        var currentEmp = ResolveLiveCurrentUser();
        var latestEvent = CalendarService.GetEventById(EventId) ?? _event;
        var authorized = ResolveAuthorizedEvent(latestEvent);
        if (authorized == null || currentEmp == null)
        {
            Snackbar.Add(Loc["You do not have permission to view this calendar event."].Value, Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Event"] = authorized, ["IsNew"] = false };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<CalendarEventDialog>(Loc["Event Details"].Value, parameters, options);
    }

    public void Dispose() => CalendarService.EventUpdated -= HandleCalendarEventUpdated;
}
