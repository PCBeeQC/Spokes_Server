@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.HR
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Dialogs.Communication.Chat
@inject CalendarService CalendarService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@implements IDisposable

@if (_event == null)
{
    <MudCard Class="pa-3" Style="width: 100%; max-width: 350px; border-radius: 8px; border: 1px dashed var(--mud-palette-divider); box-shadow: none; background: transparent;">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.EventBusy" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Style="font-style: italic;">@Loc["This event is no longer available."]</MudText>
        </div>
    </MudCard>
}
else
{
    <MudCard Class="pa-3" Style="width: 100%; max-width: 380px; border-radius: 8px; border: 1px solid var(--mud-palette-divider); box-shadow: none;">
        <div class="d-flex align-center gap-3 mb-2" style="cursor: pointer;" @onclick="OpenEventDetailsDialog" title="@Loc["Click to view event details"]">
            <MudAvatar Size="Size.Medium" Style="background: color-mix(in srgb, var(--mud-palette-info) 15%, transparent); color: var(--mud-palette-info);">
                <MudIcon Icon="@Icons.Material.Filled.Event" Size="Size.Small" />
            </MudAvatar>
            <div style="overflow: hidden;">
                <MudText Typo="Typo.subtitle2" Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@_event.Title</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    @(_event.IsAllDay ? _event.Start.ToString("MMMM d, yyyy") : $"{_event.Start.ToString("MMM d, h:mm tt")} - {_event.End.ToString("h:mm tt")}")
                </MudText>
            </div>
        </div>
        @if (!string.IsNullOrWhiteSpace(_event.Location))
        {
            <MudText Typo="Typo.body2" Class="mb-3 d-flex align-center gap-1">
                <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Secondary"/> @_event.Location
            </MudText>
        }
        @if (!string.IsNullOrWhiteSpace(_event.Description))
        {
            <MudText Typo="Typo.body2" Class="mb-3" Style="color: var(--mud-palette-text-secondary); display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden;">
                @_event.Description
            </MudText>
        }
        <div class="d-flex justify-space-between align-center gap-2 w-100 mb-n1" style="min-height: 36px;">
            <div class="d-flex align-center gap-1 attendee-row" @onclick="OpenAttendeesDialog" title="@Loc["Click to view all attendees"]" style="cursor: pointer; padding: 2px 4px; border-radius: 4px; transition: background-color 0.2s;">
                @if (_event.Attendees != null && _event.Attendees.Any())
                {
                    <div class="d-flex align-center gap-1">
                        @foreach (var attendeeId in _event.Attendees.Take(5))
                        {
                            var emp = Employees.FirstOrDefault(e => e.Id == attendeeId);
                            if (emp != null)
                            {
                                <MudTooltip Text="@emp.FullName" Placement="Placement.Top" RootStyle="display: inline-flex; align-items: center;">
                                    <EmployeeAvatar Employee="emp" Size="Size.Small" ShowPresence="false" Style="width: 16px; height: 16px; min-width: 16px; min-height: 16px; font-size: 0.55rem;" />
                                </MudTooltip>
                            }
                        }
                    </div>
                    @if (_event.Attendees.Count > 5)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem; font-weight: 600;" Class="ml-1">
                            +@(_event.Attendees.Count - 5)
                        </MudText>
                    }
                    else
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="font-size: 0.72rem; font-weight: 600;" Class="ml-1">
                            (@_event.Attendees.Count)
                        </MudText>
                    }
                }
            </div>
            <div class="d-flex justify-end flex-shrink-0 gap-2">
                @if (_event.Attendees != null && !string.IsNullOrEmpty(CurrentUserId) && _event.Attendees.Contains(CurrentUserId))
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Error" Size="Size.Small" StartIcon="@Icons.Material.Filled.Close"
                        OnClick="CancelRsvp" Disabled="@IsCurrentUserSuspended">@Loc["Cancel"]</MudButton>
                }
                else
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                        OnClick="Rsvp" Disabled="@IsCurrentUserSuspended">@Loc["I'm in!"]</MudButton>
                }
            </div>
        </div>
    </MudCard>
}

@* Styles live in wwwroot/css/chat.css: this component renders once per event mention, so inline style blocks would be re-sent and re-inserted per instance (AGENTS.md §3). *@

@code {
    [Parameter, EditorRequired]
    public string EventId { get; set; } = string.Empty;

    [Parameter]
    public string? CurrentUserId { get; set; }

    [Parameter, EditorRequired]
    public List<Employee> Employees { get; set; } = [];

    private CalendarEvent? _event;

    private bool IsCurrentUserSuspended =>
        Employees.FirstOrDefault(e => e.Id == CurrentUserId)?.IsSuspended == true;

    protected override void OnInitialized()
    {
        _event = CalendarService.GetEventById(EventId);
        CalendarService.EventUpdated += HandleCalendarEventUpdated;
    }

    protected override void OnParametersSet()
    {
        if (_event == null || _event.Id != EventId)
        {
            _event = CalendarService.GetEventById(EventId);
        }
    }

    private void HandleCalendarEventUpdated(CalendarEvent updatedEvent)
    {
        if (updatedEvent.Id == EventId)
        {
            _event = updatedEvent;
            InvokeAsync(StateHasChanged);
        }
    }

    private void Rsvp()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return;
        var result = CalendarService.RsvpToEvent(EventId, CurrentUserId);
        if (result.IsSuccess)
        {
            _event = CalendarService.GetEventById(EventId);
            Snackbar.Add(Loc["You're in! Event added to your calendar."].Value, Severity.Success);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to RSVP to event."].Value, Severity.Warning);
        }
    }

    private void CancelRsvp()
    {
        if (string.IsNullOrEmpty(CurrentUserId)) return;
        var result = CalendarService.CancelRsvpEvent(EventId, CurrentUserId);
        if (result.IsSuccess)
        {
            _event = CalendarService.GetEventById(EventId);
            Snackbar.Add(Loc["Attendance cancelled."].Value, Severity.Info);
            StateHasChanged();
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to cancel RSVP."].Value, Severity.Warning);
        }
    }

    private async Task OpenAttendeesDialog()
    {
        if (_event?.Attendees == null || !_event.Attendees.Any()) return;
        var parameters = new DialogParameters<MessageReactionsDialog>
        {
            { x => x.IsAttendeesMode, true },
            { x => x.AttendeeUserIds, _event.Attendees },
            { x => x.Employees, Employees },
            { x => x.CustomTitle, string.Format(Loc["{0} Attendees"].Value, _event.Title) }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<MessageReactionsDialog>(Loc["Event Attendees"].Value, parameters, options);
    }

    private async Task OpenEventDetailsDialog()
    {
        if (_event == null) return;
        var parameters = new DialogParameters { ["Event"] = _event, ["IsNew"] = false };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        await DialogService.ShowAsync<CalendarEventDialog>(Loc["Event Details"].Value, parameters, options);
    }

    public void Dispose() => CalendarService.EventUpdated -= HandleCalendarEventUpdated;
}
