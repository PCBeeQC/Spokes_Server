@* Horizontal date divider between message groups *@

<div class="chat-date-separator">
    <hr class="mud-divider" />
    <span class="mud-chip mud-chip-text mud-chip-size-small mud-chip-color-default chat-date-chip">
        @GetLabel()
    </span>
    <hr class="mud-divider" />
</div>
@{
    _lastRenderedDate = Date.ToLocalTime().Date;
    _lastToday = DateTime.Today;
    _hasRenderedOnce = true;
}

@code {
    [Parameter] public DateTime Date { get; set; }

    private DateTime _lastRenderedDate;
    private DateTime _lastToday;
    private bool _hasRenderedOnce;

    protected override bool ShouldRender() =>
        !_hasRenderedOnce ||
        Date.ToLocalTime().Date != _lastRenderedDate ||
        DateTime.Today != _lastToday;

    private string GetLabel()
    {
        var localDate = Date.ToLocalTime().Date;
        var today = DateTime.Today;

        if (localDate == today) return Loc["Today"].Value;
        if (localDate == today.AddDays(-1)) return Loc["Yesterday"].Value;
        return localDate.ToString("MMMM d, yyyy");
    }
}
