    private async Task CreateAlbumFromMessage(ChatMessage message)
    {
        var liveUser = _currentUser != null ? Db.Employees.GetById(_currentUser.Id) : null;
        if (liveUser == null || _selectedChannel == null || string.IsNullOrEmpty(ChannelId))
            return;
        _currentUser = liveUser;
        if (!CanConvertMessageToAlbum(message))
            return;

        if (_selectedChannel.IsEncrypted && !ScopedKeystore.IsUnlocked)
        {
            Snackbar.Add(Loc["Unlock secure chat to create an album in this channel."].Value, Severity.Warning);
            return;
        }

        var imageCount = message.Attachments.Count(a =>
            FileHelper.IsImageFile(a.FileName) || a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase));
        if (imageCount == 0)
            return;

        var privateKey = ScopedKeystore.IsUnlocked ? ScopedKeystore.GetPrivateKey() : null;
        var existingAlbums = AlbumService.GetWritableAlbumsForChannel(_currentUser.Id, ChannelId, privateKey);
        var channelName = GetChannelDisplayName(_selectedChannel);
        var defaultTitle = !string.IsNullOrWhiteSpace(channelName)
            ? $"{channelName} - {message.SentAt.ToLocalTime():MMM d, yyyy}"
            : message.SentAt.ToLocalTime().ToString("MMM d, yyyy");

        var parameters = new DialogParameters<Spokes_Server.Components.Dialogs.Communication.Chat.CreateAlbumFromChatDialog>
        {
            { x => x.PhotoCount, imageCount },
            { x => x.DefaultTitle, defaultTitle },
            { x => x.ExistingAlbums, existingAlbums },
            { x => x.IsPostSendConversion, true }
        };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.Communication.Chat.CreateAlbumFromChatDialog>(
            Loc["Organize Photos into Album"].Value,
            parameters,
            options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: Spokes_Server.Components.Dialogs.Communication.Chat.CreateAlbumFromChatDialog.Result dialogResult })
        {
            var refreshedUser = Db.Employees.GetById(_currentUser.Id);
            if (refreshedUser == null)
                return;
            _currentUser = refreshedUser;
            if (!CanConvertMessageToAlbum(message))
            {
                Snackbar.Add(Loc["Failed to create album."].Value, Severity.Error);
                return;
            }

            var convertResult = await ChatService.ConvertMessageImagesToAlbumAsync(
                _currentUser.Id,
                message.Id,
                dialogResult.ExistingAlbumId,
                dialogResult.NewAlbumTitle,
                privateKey);

            if (!convertResult.IsSuccess)
            {
                Snackbar.Add(convertResult.ErrorMessage ?? Loc["Failed to create album."].Value, Severity.Error);
                return;
            }

            Snackbar.Add(Loc["Photos organized into album."].Value, Severity.Success);
        }
    }

