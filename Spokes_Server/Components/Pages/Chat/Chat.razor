    private string? GetDecryptedKeyForEpoch(int epoch)
    {
        if (_currentUser == null || _selectedChannel == null || !_selectedChannel.IsEncrypted) return null;
        if (!ScopedKeystore.IsUnlocked) return null;

        var channel = _selectedChannel;
        var userId = _currentUser.Id;
        var cacheKey = $"ch:{channel.Id}:{epoch}:{userId}";
        return ScopedKeystore.GetOrDecryptKey(cacheKey, _ =>
        {
            if (!channel.TryGetEncryptedKeyForEpoch(epoch, userId, out var cipherKey))
                return null;

            try
            {
                return ScopedKeystore.DecryptRsaWithCachedKey(cipherKey);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Decrypting epoch {Epoch} channel key failed: {Message}", epoch, ex.Message);
                return null;
            }
        });
    }

    private string? GetDecryptedKeyForMessage(ChatMessage? msg) =>
        msg == null ? null : GetDecryptedKeyForEpoch(msg.KeyEpoch);

    private void TryDecryptMessages()
    {
        if (_currentUser == null || _selectedChannel == null || !_selectedChannel.IsEncrypted) return;

        if (!ScopedKeystore.IsUnlocked) return;

        var currentEpochKey = GetDecryptedKeyForEpoch(_selectedChannel.CurrentKeyEpoch);
        if (!string.IsNullOrEmpty(currentEpochKey))
        {
            _decryptedChannelKey = currentEpochKey;

            // Share the current epoch key with any newly setup/authorized users seamlessly once per channel session
            if (_currentUser.IsActiveUnsuspended && _opportunisticKeySharedChannels.Add(_selectedChannel.Id))
            {
                _ = ChatSecurityService.ShareKeyOpportunisticallyAsync(_selectedChannel.Id, currentEpochKey, _selectedChannel.CurrentKeyEpoch, _currentUser.Id);
            }
        }

        foreach (var msg in _messages.Where(m => m.IsEncrypted))
        {
            if (!_decryptedContents.ContainsKey(msg.Id))
            {
                var msgKey = GetDecryptedKeyForEpoch(msg.KeyEpoch);
                if (string.IsNullOrEmpty(msgKey)) continue;

                try
                {
                    _decryptedContents[msg.Id] = Crypto.DecryptAes(msg.Content, msgKey);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to decrypt message {MessageId}: {Message}", msg.Id, ex.Message);
                    if (!string.IsNullOrEmpty(msg.Content) && !ChatSecurityService.IsPotentialBase64Cipher(msg.Content))
                    {
                        _decryptedContents[msg.Id] = msg.Content;
                    }
                }
            }
        }
    }

    private string? EnsureDecryptedChannelKey()
    {
        if (string.IsNullOrEmpty(_decryptedChannelKey))
        {
            TryDecryptMessages();
        }
        return _decryptedChannelKey;
    }

    private void HandleVaultUnlockedInChat()
    {
        if (_currentUser != null)
        {
            _currentUser = Db.Employees.GetById(_currentUser.Id);
        }
        TryDecryptMessages();
        _isScrolledUp = false;
        _shouldScrollToBottomAndInitObserver = true;
        StateHasChanged();
    }

    private async Task OpenMemberProfile(Employee? employee)
    {
        if (employee == null || (_currentUser != null && !PrivacyService.CanDiscoverUser(_currentUser, employee))) return;
        var parameters = new DialogParameters { ["Employee"] = employee };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<MemberProfileDialog>(null, parameters, options);
        await dialog.Result;
        if (_currentUser != null)
        {
            var refreshed = Db.Employees.GetById(_currentUser.Id);
            if (refreshed != null && (refreshed.BlockedUserIds.Count != _currentUser.BlockedUserIds.Count || !refreshed.BlockedUserIds.SequenceEqual(_currentUser.BlockedUserIds)))
            {
                _currentUser.BlockedUserIds = refreshed.BlockedUserIds;
                if (_employeeLookup.TryGetValue(_currentUser.Id, out var currentEmp))
                {
                    currentEmp.BlockedUserIds = _currentUser.BlockedUserIds;
                }
                RecomputeSortedMessages();
                RecomputeLatestReadReceipts();
                StateHasChanged();
            }
        }
    }

    private bool _shouldScrollToBottomAndInitObserver = false;
    private bool _hasCompletedInitialRender = false;
    private bool _reportedPerfSettled = false;

