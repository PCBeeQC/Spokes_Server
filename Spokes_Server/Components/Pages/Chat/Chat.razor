    [Inject] private Spokes_Server.Core.Services.Security.FileTokenService FileTokens { get; set; } = default!;

    [JSInvokable]
    public string GetUploadUrl()
    {
        if (_selectedChannel?.IsEncrypted == true && ScopedKeystore.IsUnlocked && _currentUser != null)
        {
            var token = FileTokens.GenerateAccessToken("chat", ChannelId, "*", _decryptedChannelKey);
            return $"/spokesapi/files/chat/{ChannelId}?t={token}";
        }
        else if (_selectedChannel != null && _currentUser != null)
        {
            var token = FileTokens.GenerateAccessToken("chat", ChannelId, "*");
            return $"/spokesapi/files/chat/{ChannelId}?t={token}";
        }
        return $"/spokesapi/files/chat/{ChannelId}";
    }

    private string GetTokenizedFileUrl(string filePath, string fileName)
    {
        if (_selectedChannel == null || !_selectedChannel.IsEncrypted || string.IsNullOrEmpty(_decryptedChannelKey))
            return filePath;
        var token = FileTokens.GenerateAccessToken("chat", ChannelId, filePath, _decryptedChannelKey);
        return filePath.Contains("?") ? $"{filePath}&t={token}" : $"{filePath}?t={token}";
    }

