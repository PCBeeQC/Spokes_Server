    private void BlockUserForMessage(ChatMessage? msg)
    {
        if (_currentUser == null || !_currentUser.IsActive || _currentUser.IsSuspended || _currentUser.IsBanned || msg == null) return;
        if (msg.SenderId == _currentUser.Id) return;

        if (!_currentUser.BlockedUserIds.Contains(msg.SenderId))
        {
            _currentUser.BlockedUserIds.Add(msg.SenderId);
            Db.Employees.Save(_currentUser);

            if (_employeeLookup.TryGetValue(_currentUser.Id, out var currentEmp))
            {
                currentEmp.BlockedUserIds = _currentUser.BlockedUserIds;
            }

            RecomputeSortedMessages();
            RecomputeLatestReadReceipts();
            Snackbar.Add(Loc["User blocked. Their messages have been hidden."].Value, Severity.Info);
        }
        StateHasChanged();
    }

