    <div style="position: fixed; top: 0; left: 0; right: 0; height: var(--viewport-height, 100dvh); padding-top: var(--safe-area-top); padding-bottom: var(--safe-area-bottom); box-sizing: border-box; z-index: 10004; display: flex; align-items: center; justify-content: center;" @onclick="@(() => CloseMobileEmojiPickerAsync())" @onclick:stopPropagation="true">
        <div @onclick:stopPropagation="true" style="max-height: 100%; display: flex; flex-direction: column; min-height: 0;">
