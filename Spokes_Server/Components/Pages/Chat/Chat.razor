    private async Task SelectChannel(string channelId)
    {
        StartupTimings.EnsureTransition($"SelectChannel ({channelId})", $"Server: SelectChannel Clicked ({channelId})"); // DIAG-TEMP
        await SelectChannelInternal(channelId, updateUrl: true, autoJoinVoice: true);
    }

    private string? _previousChannelId;

    private async Task SelectChannelInternal(string channelId, bool updateUrl, bool autoJoinVoice = false)
    {
        StartupTimings.AddChatTransition($"Server: SelectChannelInternal Start (channelId={channelId}, updateUrl={updateUrl})");
        // Cancel any in-flight operations from the previous channel (StreamMessagesAsync, etc.)
        // Note: We intentionally do NOT Dispose() the old CTS here. Dispose() is optional for
        // CancellationTokenSource and calling it creates a race condition where concurrent code
        // (e.g. the Dispose pathway or LoadOlderMessages) can access a disposed CTS, throwing
        // ObjectDisposedException and crashing the Blazor circuit. Cancel() alone is sufficient.
        _channelCts?.Cancel();
        var newCts = new CancellationTokenSource();
        _channelCts = newCts;
        var token = newCts.Token;

        // Guard against race conditions where the user switches channels while loading
        var newChannelId = channelId;
        
        bool currentlyInChannel = !string.IsNullOrEmpty(ChannelId);
        
        // Prune the PREVIOUS channel logic in background - NEVER block UI transition
        if (_previousChannelId != null && _previousChannelId != newChannelId)
        {
             _ = Task.Run(() =>
             {
                 try
                 {
                     Db.ChatMessages.EnforceGlobalCacheSizeLimit();
                 }
                 catch (Exception ex)
                 {
                     Logger.LogWarning(ex, "Previous channel cleanup error: {Message}", ex.Message);
                 }
             });
        }
        _previousChannelId = newChannelId;
        ChannelId = newChannelId;
        CircuitContext.NotifyChatChannelOpenChanged(true);
        
        _selectedChannel = _channels.FirstOrDefault(c => c.Id == channelId);
        if (_selectedChannel == null)
        {
            LoadChannels();
            _selectedChannel = _channels.FirstOrDefault(c => c.Id == channelId);
        }
        
        // If the channel was not found (access denied / deleted), don't proceed
        if (_selectedChannel == null || (_currentUser != null && !ChatAuth.CanUserAccessChannel(_selectedChannel, _currentUser)))
        {
            _selectedChannel = null;
            _channelNotFound = true;
            StateHasChanged();
            return;
        }
        _channelNotFound = false;

        if (_currentUser != null)
        {
            UserClientStateService.UpdateActiveChannel(_currentUser.Id, newChannelId);
        }

        _channelTeams = GetChannelTeams();
        _channelEmployees = GetChannelEmployees();
        StartupTimings.AddChatTransition($"Server: GetChannelTeams & GetChannelEmployees Done ({_channelEmployees.Count} members)");

        _messages = Db.ChatMessages.GetByChannel(channelId, 40);
        var oldest = _messages.MinBy(m => m.SentAt);
        _hasMoreMessages = oldest != null && Db.ChatMessages.HasMessagesBefore(channelId, oldest.SentAt);
        StartupTimings.AddChatTransition($"Server: Db.ChatMessages.GetByChannel Done ({_messages.Count} msgs, hasMore={_hasMoreMessages})");
        _typingUsers.Clear();
        _sortedMessages = new();
        _decryptedChannelKey = null;
        _isLoadingMessages = false;

        TryDecryptMessages();
        StartupTimings.AddChatTransition($"Server: TryDecryptMessages Done ({_decryptedContents.Count} decrypted)");
        RecomputeSortedMessages();
        RecomputeLatestReadReceipts();
        StartupTimings.AddChatTransition("Server: RecomputeSortedMessages & ReadReceipts Done");

        _shouldScrollToBottomAndInitObserver = true;

        // Reset view states
        _showSecondaryChat = false;

        _ = SoundService.StopCallRingtoneAsync();

        // Auto-join Voice Channel if applicable
        if (autoJoinVoice && !VoiceService.IsInVoiceCall && !VoiceService.IsConnecting && _selectedChannel?.IsVoiceChannel == true)
        {
            _ = JoinVoiceChannelInternal(isInitiator: false);
        }

        if (updateUrl)
        {
            StartupTimings.AddChatTransition("Server: Calling Nav.NavigateTo");
            Nav.NavigateTo(PreserveMobileQuery($"/chat/{channelId}"), replace: currentlyInChannel);
        }

        StateHasChanged();
        StartupTimings.AddChatTransition("Server: SelectChannelInternal StateHasChanged Called");

        // Load notification level preference
        if (_currentUser != null && _selectedChannel != null)
        {
            _notificationLevel = Db.ChatReadStates.GetNotificationLevel(
                _currentUser.Id, channelId, _selectedChannel.ChannelType.ToString(), _selectedChannel.IsVoiceChannel);
        }

        // Push shortcuts to native OS in background (only on Capacitor native app, deferred after transition)
        if (CircuitContext.IsCapacitorApp)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(1500, token);
                    if (token.IsCancellationRequested || _selectedChannel == null) return;
                    var serverUrl = Configuration["ServerUrl"] ?? Nav.BaseUri;
                    var channelName = GetChannelDisplayName(_selectedChannel);
                    string? channelIconBase64 = null;
                    if (_selectedChannel.ChannelType == ChatChannelType.Direct && _currentUser != null)
                    {
                        var otherEmpId = _selectedChannel.ParticipantIds.FirstOrDefault(id => id != _currentUser.Id) ?? _currentUser.Id;
                        if (otherEmpId != null)
                        {
                            channelIconBase64 = ShortcutIconService.GetShortcutIconBase64(GetEmployee(otherEmpId));
                        }
                    }

                    if (string.IsNullOrEmpty(channelIconBase64))
                    {
                        var companyProfile = Db.CompanyProfile.Get();
                        channelIconBase64 = ShortcutIconService.GetCompanyLogoBase64(companyProfile?.LogoBase64);
                    }
                    
                    await InvokeAsync(async () =>
                    {
                        if (!token.IsCancellationRequested && _module != null)
                        {
                            await JS.InvokeVoidAsync("spokesPushDirectShareShortcut", serverUrl, channelId, channelName, channelIconBase64 ?? "");
                        }
                    });
                }
                catch (OperationCanceledException) { }
                catch (Exception e)
                {
                    Logger.LogWarning(e, "Failed to push shortcut for {ChannelId}: {Message}", channelId, e.Message);
                }
            });
        }
    }

