    private async Task JoinVoiceChannelInternal(bool isInitiator)
    {
        try
        {
            if (_currentUser == null || _selectedChannel == null) return;
            
            bool isDemo = Configuration.GetValue<bool>("Spokes_DemoMode");
            if (isDemo)
            {
                var demoConfig = Db.DemoConfigs.Get();
                var mockParticipants = demoConfig.AutoLoginEmployeeIds.ToHashSet();
                if (!mockParticipants.Contains(_currentUser.Id))
                {
                    mockParticipants.Add(_currentUser.Id);
                }
                
                if (_selectedChannel.ChannelType == ChatChannelType.Direct)
                {
                    mockParticipants.IntersectWith(_selectedChannel.ParticipantIds);
                }

                DemoVoiceAdapter.ConnectMock(_selectedChannel.Id, _currentUser.Id, mockParticipants);
                StateHasChanged();
                return;
            }

            try
            {
                var token = VoiceChannelService.GenerateJoinToken(_selectedChannel.Id, _currentUser.Id, _currentUser.FullName);
                var sysConfig = Db.SystemConfigs.Get();
                var baseUriString = !string.IsNullOrWhiteSpace(sysConfig.ServerPublicUrl) ? sysConfig.ServerPublicUrl : Nav.BaseUri;
                var baseUri = new Uri(baseUriString);
                var wsScheme = baseUri.Scheme == "https" ? "wss" : "ws";
                var defaultUrl = $"{wsScheme}://{baseUri.Authority}";
                var url = Configuration["LiveKit:ServerUrl"] ?? defaultUrl;
                var noiseSuppression = await JS.InvokeAsync<string>("localStorage.getItem", "spokes_noise_filter") ?? "rnnoise";
                var connectionOptions = new VoiceConnectionOptions
                {
                    Token = token,
                    Url = url,
                    ChannelId = _selectedChannel.Id,
                    UserId = _currentUser.Id,
                    AudioBitrateKbps = _selectedChannel.AudioBitrateKbps,
                    NoiseSuppression = noiseSuppression
                };
                await VoiceService.ConnectAsync(connectionOptions);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{Loc["Voice Configuration Error"].Value}: {ex.Message}", Severity.Error);
            }

            if (VoiceService.IsInVoiceCall)
            {
                 if (isInitiator && _selectedChannel.ChannelType == ChatChannelType.Direct)
                 {
                     var inviteResult = await VoiceChannelService.SendCallInviteAsync(_currentUser.Id, _selectedChannel.Id);
                     if (!inviteResult.IsSuccess && !string.IsNullOrEmpty(inviteResult.ErrorMessage))
                     {
                         Snackbar.Add(inviteResult.ErrorMessage, Severity.Warning);
                     }
                 }
            }
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["Error joining voice"].Value}: {ex.Message}", Severity.Error);
        }
    }
    
