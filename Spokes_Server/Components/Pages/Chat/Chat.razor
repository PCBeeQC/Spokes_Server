    {
        StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] DisposeAsync (live={Interlocked.Decrement(ref StartupTimings.ChatLiveInstances)})"); // DIAG-TEMP
        try
        {
            _typingCleanupTimer?.Stop();
