    [JSInvokable]
    public string? CopyMessageCodeBlockJS(string messageId, int codeBlockIndex)
    {
        if (string.IsNullOrEmpty(messageId) || codeBlockIndex < 0)
        {
            return null;
        }

        var msg = _messages.FirstOrDefault(m => string.Equals(m.Id, messageId, StringComparison.Ordinal));
        if (msg == null)
        {
            return null;
        }

        var rawContent = _decryptedContents.TryGetValue(msg.Id, out var dec) ? dec : (msg.Content ?? string.Empty);
        if (string.IsNullOrEmpty(rawContent))
        {
            return null;
        }

        var matches = ChatMarkdownRenderer.CodeBlockRegex.Matches(rawContent);
        if (codeBlockIndex < matches.Count)
        {
            return matches[codeBlockIndex].Groups[2].Value;
        }
        return null;
    }

