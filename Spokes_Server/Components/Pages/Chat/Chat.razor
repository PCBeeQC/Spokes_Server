    private int ComputeVoiceStageRenderFingerprint()
    {
        var hash = new HashCode();
        var channelId = _selectedChannel?.Id;
        bool isVoiceChannel = _selectedChannel?.IsVoiceChannel == true;
        bool showVideoGrid = isVoiceChannel ||
                             (VoiceService.IsInVoiceCall && string.Equals(VoiceService.CurrentChannelId, channelId, StringComparison.Ordinal));
        hash.Add(channelId, StringComparer.Ordinal);
        hash.Add(showVideoGrid);
        hash.Add(_showSecondaryChat);
        if (!showVideoGrid)
        {
            return hash.ToHashCode();
        }

        bool isConnectingStage = isVoiceChannel && VoiceService.IsConnecting;
        bool isDisconnectedVoiceChannel = isVoiceChannel &&
                                          (!VoiceService.IsInVoiceCall || !string.Equals(VoiceService.CurrentChannelId, channelId, StringComparison.Ordinal));
        bool showPipFab = VoiceService.IsInVoiceCall &&
                          string.Equals(VoiceService.CurrentChannelId, channelId, StringComparison.Ordinal) &&
                          !CircuitContext.IsCapacitorApp &&
                          !CircuitContext.IsMobile &&
                          !VoiceService.IsNativePlatform;

        hash.Add(isConnectingStage);
        hash.Add(isDisconnectedVoiceChannel);
        hash.Add(showPipFab);
        hash.Add(VoiceUiState.IsOsPipActive);

        if (isConnectingStage)
        {
            hash.Add(VoiceService.ConnectingStage);
            return hash.ToHashCode();
        }

        if (isDisconnectedVoiceChannel)
        {
            hash.Add(_currentUser?.IsActiveUnsuspended == true);
            return hash.ToHashCode();
        }

        var activeVoiceChannelId = !string.IsNullOrEmpty(VoiceService.CurrentChannelId) ? VoiceService.CurrentChannelId : channelId ?? string.Empty;
        var verifiedVoiceParticipants = !string.IsNullOrEmpty(activeVoiceChannelId)
            ? VoiceState.GetVoiceParticipants(activeVoiceChannelId).ToHashSet(StringComparer.Ordinal)
            : new HashSet<string>(StringComparer.Ordinal);
        var ringingCallee = GetRingingCalleeEmployee(verifiedVoiceParticipants);
        var stagePresentation = VoiceUiState.ComputeStagePresentationState(verifiedVoiceParticipants, ringingCallee?.Id);

        hash.Add(ringingCallee?.Id, StringComparer.Ordinal);
        hash.Add(stagePresentation.FocusedParticipantId, StringComparer.Ordinal);
        hash.Add(stagePresentation.IsFaceTimeLayout);
        hash.Add(stagePresentation.ActiveVideoCount);
        hash.Add(VoiceUiState.FullscreenParticipantId, StringComparer.Ordinal);
        hash.Add(_fullscreenZoomPercent);
        hash.Add(_fullscreenRotationDeg);
        hash.Add(_isFullscreenHudHidden);

        var channelRoomEnrollments = channelId != null
            ? PhysicalRoomService.GetParticipantRoomMap(channelId)
            : null;

        foreach (var pId in VoiceService.CallParticipants)
        {
            if (pId != VoiceService.CurrentUserId && !verifiedVoiceParticipants.Contains(pId)) continue;
            hash.Add(pId, StringComparer.Ordinal);
            hash.Add(VoiceService.IsParticipantMuted(pId));
            hash.Add(VoiceService.ActiveCameraParticipants.Contains(pId));
            hash.Add(VoiceService.ActiveScreenShareParticipants.Contains(pId));
            hash.Add(VoiceService.RemoteScreenAudioParticipants.Contains(pId));
            hash.Add(VoiceService.MutedRemoteScreenAudioParticipants.Contains(pId));
            if (channelRoomEnrollments != null && channelRoomEnrollments.TryGetValue(pId, out var roomEntry) && roomEntry.Room != null)
            {
                hash.Add(roomEntry.Room.Id, StringComparer.Ordinal);
                hash.Add(roomEntry.Room.Name, StringComparer.Ordinal);
            }
            else
            {
                hash.Add(0);
            }
        }

        return hash.ToHashCode();
    }

    private async Task HandleVoiceStateChangedAsync(string source = "manual")
    {
        try
        {
            if (!VoiceService.IsInVoiceCall)
            {
                _prevCameraCount = 0;
                _prevIsFaceTimeGlobal = false;
                _prevFocusedParticipantId = null;
            }

            SyncVoiceStageVisibility();

            bool isRelevant = IsVoiceStageRelevantToCurrentChannel;
            bool relevanceChanged = isRelevant != _wasVoiceStageRelevant;
            _wasVoiceStageRelevant = isRelevant;

            if (!isRelevant && !relevanceChanged)
            {
                return;
            }

            bool needsRefresh = false;
            if (isRelevant)
            {
                var stagePresentation = VoiceUiState.ComputeStagePresentationState();
                int activeCameras = stagePresentation.ActiveVideoCount;
                bool isFaceTimeLayoutGlobal = stagePresentation.IsFaceTimeLayout;
                string? effectiveFocusedId = stagePresentation.FocusedParticipantId;

                if (activeCameras != _prevCameraCount
                    || isFaceTimeLayoutGlobal != _prevIsFaceTimeGlobal
                    || effectiveFocusedId != _prevFocusedParticipantId)
                {
                    needsRefresh = true;
                }

                _prevCameraCount = activeCameras;
                _prevIsFaceTimeGlobal = isFaceTimeLayoutGlobal;
                _prevFocusedParticipantId = effectiveFocusedId;
            }

            int nextFingerprint = ComputeVoiceStageRenderFingerprint();
            if (!relevanceChanged &&
                _lastVoiceStageRenderFingerprint.HasValue &&
                _lastVoiceStageRenderFingerprint.Value == nextFingerprint)
            {
                if (needsRefresh && isRelevant)
                {
                    await Task.Delay(120);
                    await DebouncedRefreshVideoLayoutsAsync();
                }
                return;
            }

            // Record the queued visual fingerprint immediately so back-to-back events (e.g.
            // PhysicalRoomsChanged + VoiceService.OnChange within 1ms) coalesce into a single render.
            _lastVoiceStageRenderFingerprint = nextFingerprint;
            if (StartupTimings.IsChatProfilerEnabled)
            {
                StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] VoiceState QueueRender ({source}, connecting={VoiceService.IsConnecting}, inCall={VoiceService.IsInVoiceCall}, stage={VoiceService.ConnectingStage})");
            }
            await InvokeAsync(StateHasChanged);

            if (needsRefresh && isRelevant)
            {
                await Task.Delay(120);
                await DebouncedRefreshVideoLayoutsAsync();
            }
        }
        catch (Exception ex) when (ex is ObjectDisposedException or JSDisconnectedException or TaskCanceledException)
        {
            // Circuit disposed or navigated away
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "HandleVoiceStateChangedAsync error: {Message}", ex.Message);
        }
    }

    private int _refreshVideoLayoutsVersion = 0;
    private async Task DebouncedRefreshVideoLayoutsAsync()
    {
        int myVersion = ++_refreshVideoLayoutsVersion;
        await Task.Delay(80);
        if (myVersion != _refreshVideoLayoutsVersion)
        {
            return;
        }
        try
        {
            await VoiceDeviceService.RefreshVideoLayoutsAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Failed to refresh video layouts: {Message}", ex.Message);
        }
    }

