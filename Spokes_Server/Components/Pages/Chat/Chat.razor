    private async Task DownloadMedia(ChatMessage message)
    {
        if (message == null) return;
        ChatAttachment? media = message.Attachments.FirstOrDefault(a => {
            var ext = System.IO.Path.GetExtension(a.FileName).ToLowerInvariant();
            return ext is ".jpg" or ".jpeg" or ".png" or ".gif" or ".webp" or ".bmp" or ".mp4" or ".webm" or ".ogg" or ".mov";
        });

        if (media != null)
