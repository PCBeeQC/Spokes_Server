    private async Task LoadOlderMessages()
    {
        if (ChannelId == null || _isLoadingOlder) return;

        _isLoadingOlder = true;

        if (_module != null)
        {
            try { await _module.InvokeVoidAsync("captureScrollAnchor", _messagesContainer); }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Failed to capture scroll anchor"); }
        }

        StateHasChanged();

        // Allow UI to paint the loading spinner
        await Task.Delay(50);

        try
        {
            // Capture the CTS reference locally to avoid races where _channelCts is swapped
            // between the null-check and the .Token access.
            var cts = _channelCts;
            var token = cts?.Token ?? CancellationToken.None;
            await StreamMessagesAsync(ChannelId, 50, 10, token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading older messages: {Message}", ex.Message);
        }
        finally
        {
            _isLoadingOlder = false;
            StateHasChanged();

            if (_module != null)
            {
                try
                {
                    await _module.InvokeVoidAsync("restoreScrollAnchor", _messagesContainer);
                    await _module.InvokeVoidAsync("notifyOlderMessagesLoaded");
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
                catch (Exception ex) { Logger.LogDebug(ex, "Failed to restore scroll anchor"); }
            }
        }
    }

    private async Task StreamMessagesAsync(string channelId, int totalToLoad, int chunkSize = 50, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrEmpty(channelId) || cancellationToken.IsCancellationRequested || ChannelId != channelId) return;

        // Guaranteed oldest message: use _sortedMessages.LastOrDefault() or fallback to min SentAt
        var oldestDisplayed = _sortedMessages.LastOrDefault() ?? _messages.MinBy(m => m.SentAt);
        List<ChatMessage> chunk;

        if (oldestDisplayed != null)
        {
            chunk = Db.ChatMessages.GetByChannelBefore(channelId, oldestDisplayed.SentAt, totalToLoad);
        }
        else if (_messages.Count == 0)
        {
            chunk = Db.ChatMessages.GetByChannel(channelId, totalToLoad);
        }
        else
        {
            chunk = [];
        }

        if (!chunk.Any() || cancellationToken.IsCancellationRequested || ChannelId != channelId)
        {
            _hasMoreMessages = false;
            return;
        }

        await InvokeAsync(() =>
        {
            if (cancellationToken.IsCancellationRequested || ChannelId != channelId) return;

            var existingIds = _messages.Select(m => m.Id).ToHashSet();
            var newUnique = chunk.Where(m => existingIds.Add(m.Id)).ToList();
            if (newUnique.Count > 0)
            {
                _messages.AddRange(newUnique);
                TryDecryptMessages(); 
                RecomputeSortedMessages();
                RecomputeLatestReadReceipts();
            }

            var oldest = _sortedMessages.LastOrDefault() ?? _messages.MinBy(m => m.SentAt);
            _hasMoreMessages = oldest != null && Db.ChatMessages.HasMessagesBefore(channelId, oldest.SentAt);

            StateHasChanged();
        });
    }

