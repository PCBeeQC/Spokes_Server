    [JSInvokable]
    public async Task<bool> FillViewportMessagesJS(string expectedChannelId)
    {
        if (string.IsNullOrEmpty(expectedChannelId) ||
            !string.Equals(ChannelId, expectedChannelId, StringComparison.Ordinal) ||
            !_hasMoreMessages ||
            _isLoadingOlder ||
            _isFillingViewport)
        {
            return false;
        }

        _isFillingViewport = true;
        try
        {
            var cts = _channelCts;
            var token = cts?.Token ?? CancellationToken.None;
            await StreamMessagesAsync(expectedChannelId, ViewportFillBatchSize, token);
            return _hasMoreMessages && !token.IsCancellationRequested && string.Equals(ChannelId, expectedChannelId, StringComparison.Ordinal);
        }
        catch (OperationCanceledException)
        {
            return false;
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Viewport auto-fill skipped for channel {ChannelId}", expectedChannelId);
            return false;
        }
        finally
        {
            _isFillingViewport = false;
        }
    }

    private async Task LoadOlderMessages()
    {
        if (ChannelId == null || _isLoadingOlder) return;

        _isLoadingOlder = true;

        if (_module != null)
        {
            try { await _module.InvokeVoidAsync("captureScrollAnchor", _messagesContainer); }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
            catch (Exception ex) { Logger.LogDebug(ex, "Failed to capture scroll anchor"); }
        }

        StateHasChanged();

        // Allow UI to paint the loading spinner
        await Task.Delay(50);

        try
        {
            // Capture the CTS reference locally to avoid races where _channelCts is swapped
            // between the null-check and the .Token access.
            var cts = _channelCts;
            var token = cts?.Token ?? CancellationToken.None;
            await StreamMessagesAsync(ChannelId, 50, token);
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading older messages: {Message}", ex.Message);
        }
        finally
        {
            _isLoadingOlder = false;
            StateHasChanged();

            if (_module != null)
            {
                try
                {
                    await _module.InvokeVoidAsync("restoreScrollAnchor", _messagesContainer);
                    await _module.InvokeVoidAsync("notifyOlderMessagesLoaded");
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
                catch (Exception ex) { Logger.LogDebug(ex, "Failed to restore scroll anchor"); }
            }
        }
    }

    private async Task StreamMessagesAsync(string channelId, int totalToLoad, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrEmpty(channelId) || cancellationToken.IsCancellationRequested || ChannelId != channelId) return;

        var accessOk = false;
        await InvokeAsync(async () =>
        {
            if (cancellationToken.IsCancellationRequested || ChannelId != channelId) return;
            var liveChannel = Db.ChatChannels.GetById(channelId);
            if (!await RevalidateCurrentSessionAndChannelAccessAsync(liveChannel)) return;
            _selectedChannel = liveChannel;
            accessOk = true;
        });
        if (!accessOk) return;

        // Guaranteed oldest message: use _sortedMessages.LastOrDefault() or fallback to min SentAt
        var oldestDisplayed = _sortedMessages.LastOrDefault() ?? _messages.MinBy(m => m.SentAt);
        Spokes_Server.Core.Data.Repositories.Communication.ChannelMessageLoadResult loadResult;

        if (oldestDisplayed != null)
        {
            loadResult = await Db.ChatMessages.GetByChannelBeforeWithStatsAsync(channelId, oldestDisplayed.SentAt, totalToLoad, cancellationToken);
        }
        else if (_messages.Count == 0)
        {
            loadResult = await Db.ChatMessages.GetByChannelWithStatsAsync(channelId, totalToLoad, cancellationToken);
        }
        else
        {
            loadResult = new Spokes_Server.Core.Data.Repositories.Communication.ChannelMessageLoadResult([], 0, 0, 0, 0, false);
        }

        var chunk = loadResult.Messages;
        if (!chunk.Any() || cancellationToken.IsCancellationRequested || ChannelId != channelId)
        {
            _hasMoreMessages = false;
            return;
        }

        await InvokeAsync(() =>
        {
            if (cancellationToken.IsCancellationRequested || ChannelId != channelId) return;

            var existingIds = _messages.Select(m => m.Id).ToHashSet();
            var newUnique = chunk.Where(m => existingIds.Add(m.Id)).ToList();
            if (newUnique.Count > 0)
            {
                _messages.AddRange(newUnique);
                TryDecryptMessages(); 
                RecomputeSortedMessages();
                RecomputeLatestReadReceipts();
            }

            _hasMoreMessages = loadResult.HasMore;
            StartupTimings.AddChatTransition(
                $"Server: StreamMessagesAsync Done (+{newUnique.Count} msgs, total={_messages.Count}, cache={loadResult.CacheHits}, disk={loadResult.DiskReads}, diskMs={loadResult.DiskReadMs:F1}ms, hasMore={_hasMoreMessages})");

            StateHasChanged();
        });
    }

