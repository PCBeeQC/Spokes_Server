    private Task<IJSObjectReference?> EnsureChatModuleLoadedAsync()
    {
        if (_module != null) return Task.FromResult<IJSObjectReference?>(_module);
        return _moduleLoadTask ??= LoadChatModuleCoreAsync();
    }

    private Task<IJSObjectReference?> EnsureComposerModuleLoadedAsync()
    {
        if (_composerModule != null) return Task.FromResult<IJSObjectReference?>(_composerModule);
        return _composerModuleLoadTask ??= LoadComposerModuleCoreAsync();
    }

    private async Task<IJSObjectReference?> LoadComposerModuleCoreAsync()
    {
        try
        {
            _composerModule = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets.Bypassed("Components/Pages/Chat/ChatComposer.razor.js")}");
            return _composerModule;
        }
        catch
        {
            _composerModuleLoadTask = null;
            return null;
        }
    }

    private async Task<IJSObjectReference?> LoadChatModuleCoreAsync()
    {
        try
        {
            _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets.Bypassed("Components/Pages/Chat/Chat.razor.js")}");
            return _module;
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            _moduleLoadTask = null;
            return null;
        }
        catch (Exception ex)
        {
            _moduleLoadTask = null;
            Logger.LogWarning(ex, "Failed to import Chat.razor.js: {Message}", ex.Message);
            return null;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartupTimings.Add("Server: Chat OnAfterRenderAsync Start");
            var diagTid = StartupTimings.CurrentTransitionId; // DIAG-TEMP
            using var diagFirstRenderSpan = StartupTimings.Span($"Server: Chat[{_diagTag}] FirstRender path", diagTid); // DIAG-TEMP
            bool wasChecking = _isCheckingKeystoreCookie;
            bool wasUnlockedBefore = ScopedKeystore.IsUnlocked;
            try
            {
                _objRef = DotNetObjectReference.Create(this);
                _ = EnsureComposerModuleLoadedAsync();
                if (_selectedChannel != null)
                {
                    using (StartupTimings.Span($"Server: Chat[{_diagTag}] import Chat.razor.js", diagTid)) // DIAG-TEMP
                    {
                        await EnsureChatModuleLoadedAsync();
                    }
                }
                else
                {
                    // ChatList (/chat or /) has no open channel; warm Chat.razor.js in the background
                    // without blocking initial route settlement on a no-store module fetch round-trip.
                    _ = EnsureChatModuleLoadedAsync();
                }

                if (_currentUser is { IsActiveUnsuspended: true } && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey) && !ScopedKeystore.IsUnlocked)
                {
                    using (StartupTimings.Span($"Server: Chat[{_diagTag}] ScopedKeystore.InitializeFromDeviceCookieAsync", diagTid)) // DIAG-TEMP
                    {
                        await ScopedKeystore.InitializeFromDeviceCookieAsync(JS, _currentUser.Id, _currentUser.EncryptedPrivateKey);
                    }
                    if (ScopedKeystore.IsUnlocked)
                    {
                        // GlobalKeystore is unlocked inside InitializeFromDeviceCookieAsync
                        // when the device-stored password is successfully decrypted.
                        TryDecryptMessages();
                    }
                }

                // If the user is in an active voice call and navigated back to this channel,
                // re-attach all LiveKit tracks to the freshly created DOM containers.
                if (VoiceService.IsInVoiceCall)
                {
                    using (StartupTimings.Span($"Server: Chat[{_diagTag}] VoiceDeviceService.ReattachTracksAsync", diagTid)) // DIAG-TEMP
                    {
                        await VoiceDeviceService.ReattachTracksAsync();
                    }
                }

                // Note: We do NOT init scroll observer here yet. We let the block below handle it.
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Chat.razor OnAfterRenderAsync failed: {Message}", ex.Message);
            }
            finally
            {
                _isCheckingKeystoreCookie = false;
                if (_selectedChannel != null)
                {
                    _shouldScrollToBottomAndInitObserver = true;
                }
            }

            // Only defer settlement to a second render pass if the rendered DOM actually changed:
            // either the vault unlocked during firstRender (decrypting sidebar previews / channel messages)
            // or an encrypted channel's VaultLockView was displaying the "Unlocking Secure Channel..." spinner.
            bool unlockedDuringFirstRender = !wasUnlockedBefore && ScopedKeystore.IsUnlocked;
            bool encryptedChannelLockViewVisible = _selectedChannel is { IsEncrypted: true };
            if (wasChecking && (unlockedDuringFirstRender || encryptedChannelLockViewVisible))
            {
                StartupTimings.Mark($"Server: Chat[{_diagTag}] wasChecking -> StateHasChanged + return (observers deferred to next render)", diagTid); // DIAG-TEMP
                StateHasChanged();
                return;
            }
        }



        if (_pendingVoiceTrackReattach && !firstRender && VoiceService.IsInVoiceCall && !VoiceService.IsConnecting)
        {
            _pendingVoiceTrackReattach = false;
            try
            {
                await VoiceDeviceService.ReattachTracksAsync();
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "ReattachTracksAsync on channel switch skipped");
            }
        }
        else if (firstRender)
        {
            _pendingVoiceTrackReattach = false;
        }

        // Check if we need to scroll and/or init observer when a channel is actively open.
        if (_selectedChannel != null && (_shouldScrollToBottomAndInitObserver || firstRender))
        {
            var openedChannelId = _selectedChannel.Id;
            _shouldScrollToBottomAndInitObserver = false;
            var chainTid = StartupTimings.CurrentTransitionId; // DIAG-TEMP
            using var chainSpan = StartupTimings.Span($"Server: Chat[{_diagTag}] Scroll & Observers chain", chainTid); // DIAG-TEMP
            
            _isScrolledUp = false;
            var module = _module ?? await EnsureChatModuleLoadedAsync();
            if (module != null && _objRef != null)
            {
                try
                {
                    var maxAllowedSize = Db.CompanyProfile.Get()?.MaxFileUploadSizeBytes ?? WebUiExtensions.DefaultMaxFileUploadSizeBytes;
                    bool attachScrollObserver = _hasMoreMessages && _messages.Count > 0;
                    await module.InvokeVoidAsync("initChatChannelView", _messagesContainer, _topSentinel, _objRef, maxAllowedSize, attachScrollObserver, openedChannelId);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to init chat channel view: {Message}", ex.Message);
                }
            }
            else
            {
                await ScrollToBottom();
            }
            StartupTimings.Mark("Server: Chat JS Observers Init Done", chainTid); // DIAG-TEMP

            // Confirm read state once for passive/route-driven channel opens; explicit sidebar
            // clicks already confirmed read state in SelectChannelInternal before render.
            if (string.Equals(_pendingReadConfirmationChannelId, openedChannelId, StringComparison.Ordinal))
            {
                _pendingReadConfirmationChannelId = null;
                if (string.Equals(ChannelId, openedChannelId, StringComparison.Ordinal))
                {
                    _ = ConfirmChannelViewedAndReadAsync(openedChannelId);
                }
            }
        }

        // Launch deferred voice auto-join AFTER channel view & JS observers mount so LiveKit
        // script/WASM initialization never stalls Chat/ChatComposer initial interactivity, while
        // remaining decoupled from _shouldScrollToBottomAndInitObserver so an interleaved render
        // pass can never strand a pending voice auto-join.
        if (_selectedChannel != null &&
            !string.IsNullOrEmpty(_pendingAutoJoinVoiceChannelId) &&
            string.Equals(_pendingAutoJoinVoiceChannelId, _selectedChannel.Id, StringComparison.Ordinal))
        {
            _pendingAutoJoinVoiceChannelId = null;
            if (!VoiceService.IsInVoiceCall && !VoiceService.IsConnecting && _selectedChannel.IsVoiceChannel)
            {
                _ = JoinVoiceChannelInternal(isInitiator: false);
            }
        }

        _hasCompletedInitialRender = true;
        if (!_reportedPerfSettled && !_isCheckingKeystoreCookie)
        {
            _reportedPerfSettled = true;
            var chatRouteKey = string.IsNullOrEmpty(ChannelId) ? "ChatList" : "ChatChannel";
            StartupTimings.TryMarkRouteSettled(chatRouteKey);
            try
            {
                await JS.InvokeVoidAsync("startupDiagnostics.reportRouteSettled", chatRouteKey);
            }
            catch
            {
                // Ignore disconnected circuit during teardown
            }
        }
        StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] OnAfterRenderAsync End (firstRender={firstRender}, ChannelId={ChannelId ?? "null"}, selected={_selectedChannel?.Id ?? "null"})"); // DIAG-TEMP
    }

    // --- Event Subscriptions ---

    private void SubscribeToLocalEvents()
    {
        ChatState.MessageReceived += OnMessageReceived;
        ChatState.UserTyping += OnUserTyping;
        ChatState.UserStoppedTyping += OnUserStoppedTyping;
        ChatState.MessageEdited += OnMessageEdited;
        ChatState.MessageDeleted += OnMessageDeleted;
        ChatState.ReactionAdded += OnReactionAdded;
        ChatState.ReactionRemoved += OnReactionRemoved;
        ChatState.ChannelCreated += OnChannelCreated;
        ChatState.ChannelUpdated += OnChannelCreated;
        ChatState.MessageRead += OnMessageRead;
        ChatState.EmployeeProfileUpdated += OnEmployeeProfileUpdated;
        VoiceState.VoiceUserMutedChanged += OnVoiceUserMutedChanged;
        ScopedKeystore.OnUnlocked += HandleKeystoreUnlocked;
        ScopedKeystore.OnLocked += HandleKeystoreLocked;
        SessionService.OnSessionRevoked += HandleChatSessionRevoked;
        SessionService.OnSessionBanned += HandleChatSessionBanned;
    }

    private void UnsubscribeFromLocalEvents()
    {
        ChatState.MessageReceived -= OnMessageReceived;
        ChatState.UserTyping -= OnUserTyping;
        ChatState.UserStoppedTyping -= OnUserStoppedTyping;
        ChatState.MessageEdited -= OnMessageEdited;
        ChatState.MessageDeleted -= OnMessageDeleted;
        ChatState.ReactionAdded -= OnReactionAdded;
        ChatState.ReactionRemoved -= OnReactionRemoved;
        ChatState.ChannelCreated -= OnChannelCreated;
        ChatState.ChannelUpdated -= OnChannelCreated;
        ChatState.MessageRead -= OnMessageRead;
        ChatState.EmployeeProfileUpdated -= OnEmployeeProfileUpdated;
        VoiceState.VoiceUserMutedChanged -= OnVoiceUserMutedChanged;
        ScopedKeystore.OnUnlocked -= HandleKeystoreUnlocked;
        ScopedKeystore.OnLocked -= HandleKeystoreLocked;
        SessionService.OnSessionRevoked -= HandleChatSessionRevoked;
        SessionService.OnSessionBanned -= HandleChatSessionBanned;
    }

    private void HandleChatSessionRevoked(string sessionId) => HandleChatSessionTerminated(sessionId, isBanned: false);
    private void HandleChatSessionBanned(string sessionId) => HandleChatSessionTerminated(sessionId, isBanned: true);

    private void HandleChatSessionTerminated(string sessionId, bool isBanned)
    {
        if (string.IsNullOrEmpty(_sessionId) || !string.Equals(_sessionId, sessionId, StringComparison.Ordinal))
        {
            return;
        }

        UnsubscribeFromLocalEvents();
        _channelCts?.Cancel();
        if (!string.IsNullOrEmpty(_currentUser?.Id))
        {
            ScopedKeystore.Lock(_currentUser.Id);
        }
        UserService.ClearCache();
        _ = InvokeAsync(() => EvictCurrentChannelView(navigateToBanned: isBanned));
    }

    // --- Local Event Handlers ---

    private async void HandleKeystoreUnlocked()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _isCheckingKeystoreCookie = false;
                if (_currentUser == null) return;
                TryDecryptMessages();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async void HandleKeystoreLocked()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _decryptedChannelKey = null;
                _decryptedContents.Clear();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private void OnVoiceUserMutedChanged(string channelId, string userId, bool isMuted)
    {
        if (_selectedChannel == null ||
            !string.Equals(_selectedChannel.Id, channelId, StringComparison.Ordinal) ||
            !IsVoiceStageRelevantToCurrentChannel)
        {
            return;
        }

        HandleVoiceStateChanged();
    }

    private void OnEmployeeProfileUpdated(Employee updatedEmployee)
    {
        InvokeAsync(() =>
        {
            var existingIndex = _employees.FindIndex(e => e.Id == updatedEmployee.Id);
            if (existingIndex >= 0)
            {
                // Create a new list reference so Blazor's parameter tracking sees the change
                var newEmployees = new List<Employee>(_employees);
                newEmployees[existingIndex] = updatedEmployee;
                _employees = newEmployees;
                
                _employeeLookup[updatedEmployee.Id] = updatedEmployee;
                
                if (_currentUser?.Id == updatedEmployee.Id)
                {
                    _currentUser = updatedEmployee;
                }

                RecomputeDiscoverableEmployees();
                
                // Recompute channel employees so discoverability and channel membership stay accurate
                if (_selectedChannel != null)
                {
                    _channelEmployees = GetChannelEmployees();
                }

                StateHasChanged();
            }
        });
    }

    private void OnMessageReceived(ChatMessage msg)
    {
        InvokeAsync(async () =>
        {
            if (msg.ChannelId == ChannelId)
            {
                var liveChannel = _selectedChannel != null ? Db.ChatChannels.GetById(_selectedChannel.Id) : null;
                if (!await RevalidateCurrentSessionAndChannelAccessAsync(liveChannel))
                {
                    return;
                }
            }
            else if (!await RevalidateCurrentSessionAndChannelAccessAsync(null, requireTargetChannel: false))
            {
                return;
            }

            var channelToUpdate = _channels.FirstOrDefault(c => c.Id == msg.ChannelId);
            if (channelToUpdate != null)
            {
                channelToUpdate.LastActivityAt = msg.SentAt;
                _channels = _channels.OrderByDescending(c => c.LastActivityAt).ToList();
            }
            else 
            {
                LoadChannels();
            }

            if (msg.ChannelId == ChannelId)
            {
                // Clear typing indicator immediately — the sender has sent their message
                _typingUsers.Remove(msg.SenderId);

                if (!_messages.Any(m => m.Id == msg.Id))
                {
                    _messages.Add(msg);
                    
                    if (msg.IsEncrypted) TryDecryptMessages();
                    
                    // Mark as read so the database knows we've seen this real-time message if actively viewing
                    await ConfirmChannelViewedAndReadAsync(ChannelId);
                    
                    RecomputeSortedMessages();
                    RecomputeLatestReadReceipts();
                    
                    bool isOwnMessage = msg.SenderId == (_currentUser?.Id);
                    StateHasChanged();
                    
                    if (isOwnMessage)
                    {
                        await Task.Delay(50);
                        await ScrollToBottom();
                    }
                }
            }
            else
            {
                // Message is for another channel — re-sort sidebar only.
                // Don't call StateHasChanged() here to avoid a full re-render of the
                // message list just to update sidebar order. The next user interaction
                // (e.g., clicking a channel) will pick up the new order.
            }
        });
    }

