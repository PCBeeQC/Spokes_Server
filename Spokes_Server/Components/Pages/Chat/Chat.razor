    private void CloseDesktopMessagePopups()
    {
        if (_activeEmojiPickerMessageId == null && _activeMoreMenuMessageId == null) return;
        _activeEmojiPickerMessageId = null;
        _activeMoreMenuMessageId = null;
        StateHasChanged();
    }

    [JSInvokable]
    public async Task HandleDesktopMessageActionJS(string messageId, string action, string? payload)
    {
        if (string.IsNullOrEmpty(messageId) || string.IsNullOrEmpty(action)) return;

        var msg = _messages.FirstOrDefault(m => m.Id == messageId);
        if (msg == null || msg.IsDeleted) return;

        switch (action)
        {
            case "react":
                if (!string.IsNullOrEmpty(payload) && PrivacyService.CanReactInChannel(_selectedChannel, _currentUser))
                {
                    bool hadPopup = _activeEmojiPickerMessageId != null || _activeMoreMenuMessageId != null;
                    _activeEmojiPickerMessageId = null;
                    _activeMoreMenuMessageId = null;
                    await AddReaction((messageId, payload));
                    if (hadPopup) StateHasChanged();
                }
                break;
            case "emoji-picker":
                if (PrivacyService.CanReactInChannel(_selectedChannel, _currentUser))
                {
                    _activeMoreMenuMessageId = null;
                    _activeEmojiPickerMessageId = string.Equals(_activeEmojiPickerMessageId, messageId, StringComparison.Ordinal)
                        ? null
                        : messageId;
                    StateHasChanged();
                }
                break;
            case "reply":
                _activeEmojiPickerMessageId = null;
                _activeMoreMenuMessageId = null;
                await StartReply(msg);
                break;
            case "more":
                _activeEmojiPickerMessageId = null;
                _activeMoreMenuMessageId = string.Equals(_activeMoreMenuMessageId, messageId, StringComparison.Ordinal)
                    ? null
                    : messageId;
                StateHasChanged();
                break;
        }
    }

