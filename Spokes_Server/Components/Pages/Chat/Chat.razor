    private async Task LoadOlderMessages()
    {
        if (ChannelId == null || _isLoadingOlder) return;

        _isLoadingOlder = true;
        StateHasChanged();

        // Allow UI to paint the loading spinner
        await Task.Delay(50);

        try
        {
            // Capture the CTS reference locally to avoid races where _channelCts is swapped
            // between the null-check and the .Token access.
            var cts = _channelCts;
            var token = cts?.Token ?? CancellationToken.None;
            await StreamMessagesAsync(ChannelId, 50, 10, token);
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Chat] Error loading older messages: {ex}");
        }
        finally
        {
            _isLoadingOlder = false;
            StateHasChanged();
        }
    }

    private async Task StreamMessagesAsync(string channelId, int totalToLoad, int chunkSize = 10, CancellationToken cancellationToken = default)
    {
        if (string.IsNullOrEmpty(channelId)) return;

        int loadedCount = 0;
        
        while (loadedCount < totalToLoad)
        {
            if (cancellationToken.IsCancellationRequested || ChannelId != channelId) return;

            int currentChunkSize = Math.Min(chunkSize, totalToLoad - loadedCount);
            
            // Wait a brief moment to allow UI thread to render the previous chunk
            try { await Task.Delay(50, cancellationToken); } catch (TaskCanceledException) { return; }
            if (cancellationToken.IsCancellationRequested || ChannelId != channelId) return;

            var oldestDisplayed = _messages.LastOrDefault(); // Newest-first sorting
            List<ChatMessage> chunk = new();
            
            if (oldestDisplayed != null)
            {
                chunk = Db.ChatMessages.GetByChannelBefore(channelId, oldestDisplayed.SentAt, currentChunkSize);
            }
            else if (_messages.Count == 0)
            {
                chunk = Db.ChatMessages.GetByChannel(channelId, currentChunkSize);
            }
            
            if (!chunk.Any()) break;

            await InvokeAsync(() =>
            {
                if (cancellationToken.IsCancellationRequested || ChannelId != channelId) return;
                
                _messages.AddRange(chunk);
                TryDecryptMessages(); 
                RecomputeSortedMessages();
                RecomputeLatestReadReceipts();
                
                var cachedCount = Db.ChatMessages.GetMessageCount(channelId);
                _hasMoreMessages = cachedCount > _messages.Count;
                
                StateHasChanged();
            });
            
            loadedCount += chunk.Count;
            
            if (chunk.Count < currentChunkSize) break; // Exhausted available messages
        }
    }

