    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        bool isFriendEdition = Db.CompanyProfile.Get()?.Edition == "Family";
        if (!MainLayout.IsChatPageUrl(e.Location, isFriendEdition))
        {
            _routeTransitionGuard.Reset(e.Location);
        }
        else
        {
            var urlChannelId = MainLayout.ExtractChatChannelId(e.Location);
            if (_routeTransitionGuard.ShouldIgnoreStaleUpdate(e.Location, urlChannelId, urlChannelId))
            {
                StartupTimings.AddChatTransition(
                    $"Server: Chat[{_diagTag}].HandleLocationChanged ignored superseded self-nav (location={e.Location}, target={_routeTransitionGuard.LatestTargetRouteKey ?? "null"})");
                return;
            }
        }

        if (_selectedChannel != null && !MainLayout.IsChatChannelUrl(e.Location))
        {
            StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}].HandleLocationChanged Clearing channel (location={e.Location})");
            _channelCts?.Cancel();
            _previousChannelId = null;
            _pendingAutoJoinVoiceChannelId = null;
            ChannelId = null;
            _selectedChannel = null;
            _channelNotFound = false;
            ClearMessageActionOverlays();
            _messages.Clear();
            _sortedMessages.Clear();
            _isScrolledUp = false;
            _shouldScrollToBottomAndInitObserver = false;
            _pendingReadConfirmationChannelId = null;
            CircuitContext.NotifyChatChannelOpenChanged(false);
            SyncVoiceStageVisibility();
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private string? _pendingReadConfirmationChannelId;

    private async Task ConfirmChannelViewedAndReadAsync(string? channelId, bool userInitiated = false)
    {
        if (string.IsNullOrEmpty(channelId))
            return;

        if (userInitiated)
        {
            if (!CircuitContext.CanRegisterPresence)
                return;

            CircuitContext.IsIdle = false;
            if (!string.IsNullOrEmpty(CircuitContext.SubscriptionId))
            {
                PresenceState.PingDeviceActive(CircuitContext.SubscriptionId);
            }
        }
        else if (!IsConnectionActivelyViewed())
        {
            return;
        }

        try
        {
            await ChatNotifications.MarkChannelAsReadAsync(channelId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ConfirmChannelViewedAndRead error: {Message}", ex.Message);
        }
    }

