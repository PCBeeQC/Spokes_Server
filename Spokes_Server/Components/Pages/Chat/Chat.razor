    private List<Employee> GetChannelEmployees()
    {
        if (_selectedChannel == null || PrivacyService.ShouldHideMemberList(_selectedChannel, _currentUser))
        {
            return new List<Employee>();
        }

        switch (_selectedChannel.ChannelType)
        {
            case ChatChannelType.Direct:
            case ChatChannelType.Group:
                return PrivacyService.FilterDiscoverableEmployees(_currentUser,
                    _employees.Where(e => e.IsActive && !e.IsSystem && !e.IsBanned && _selectedChannel.ParticipantIds.Contains(e.Id)));

            case ChatChannelType.Team:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return PrivacyService.FilterDiscoverableEmployees(_currentUser,
                        _employees.Where(e => e.IsActive && !e.IsSystem && !e.IsBanned && _selectedChannel.ParticipantIds.Contains(e.Id)));
                }
                else if (!string.IsNullOrEmpty(_selectedChannel.LinkedEntityId))
                {
                    var team = Db.Teams.GetById(_selectedChannel.LinkedEntityId);
                    if (team != null)
                    {
                        return PrivacyService.FilterDiscoverableEmployees(_currentUser,
                            _employees.Where(e => e.IsActive && !e.IsSystem && !e.IsBanned && (e.TeamId == team.Id || e.Id == team.LeaderId)));
                    }
                }
                return new List<Employee>();

            case ChatChannelType.Project:
                var proj = !string.IsNullOrEmpty(_selectedChannel.LinkedEntityId)
                    ? Db.Projects.GetById(_selectedChannel.LinkedEntityId)
                    : null;
                IEnumerable<Employee> projectCandidates;
                if (_selectedChannel.ParticipantIds.Any())
                {
                    projectCandidates = _employees.Where(e =>
                        e.IsActive && !e.IsSystem && !e.IsBanned &&
                        _selectedChannel.ParticipantIds.Contains(e.Id) &&
                        (proj == null || ProjectAccessHelper.CanAccess(e, proj, Db.Teams)));
                }
                else
                {
                    projectCandidates = proj != null
                        ? _employees.Where(e => e.IsActive && !e.IsSystem && !e.IsBanned && ProjectAccessHelper.CanAccess(e, proj, Db.Teams))
                        : [];
                }
                return PrivacyService.FilterDiscoverableEmployees(_currentUser, projectCandidates);

            default:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return PrivacyService.FilterDiscoverableEmployees(_currentUser,
                        _employees.Where(e => e.IsActive && !e.IsSystem && !e.IsBanned && _selectedChannel.ParticipantIds.Contains(e.Id)));
                }
                else if (_selectedChannel.AllowedTeamIds.Any())
                {
                    var teamEmployees = _employees.Where(e =>
                        e.IsActive && !e.IsSystem && !e.IsBanned &&
                        (_selectedChannel.AllowedTeamIds.Contains(e.TeamId) ||
                         Db.Teams.GetAll().Any(t => _selectedChannel.AllowedTeamIds.Contains(t.Id) && t.LeaderId == e.Id))
                    );
                    return PrivacyService.FilterDiscoverableEmployees(_currentUser, teamEmployees);
                }
                return PrivacyService.FilterDiscoverableEmployees(_currentUser, _employees.Where(e => e.IsActive && !e.IsSystem && !e.IsBanned));
        }
    }

    private List<Team> GetChannelTeams()
    {
        if (_selectedChannel == null) return new List<Team>();
        
        if (_selectedChannel.AllowedTeamIds.Any())
        {
             var allowedTeams = Db.Teams.GetAll().Where(t => _selectedChannel.AllowedTeamIds.Contains(t.Id));
             return PrivacyService.FilterDiscoverableTeams(_currentUser, allowedTeams);
        }
        
        if (_selectedChannel.ChannelType == ChatChannelType.Direct || _selectedChannel.ChannelType == ChatChannelType.Group)
             return new List<Team>(); 

        return PrivacyService.FilterDiscoverableTeams(_currentUser, Db.Teams.GetAll());
    }

    protected override async Task OnParametersSetAsync()
    {
        StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}].OnParametersSetAsync (ChannelId={ChannelId ?? "null"}, selected={_selectedChannel?.Id ?? "null"}, initialRenderDone={_hasCompletedInitialRender})"); // DIAG-TEMP
        if (ChannelId != _selectedChannel?.Id)
        {
             if (string.IsNullOrEmpty(ChannelId))
             {
                 if (_hasCompletedInitialRender)
                 {
                     StartupTimings.EnsureTransition("GoBack (PopState)", $"Server: Chat[{_diagTag}].OnParametersSetAsync Clearing _selectedChannel"); // DIAG-TEMP
                 }
                 _previousChannelId = null;
                 _pendingAutoJoinVoiceChannelId = null;
                 _selectedChannel = null;
                 _channelNotFound = false;
                 ClearMessageActionOverlays();
                 _messages.Clear();
                 _sortedMessages.Clear();
                 _isScrolledUp = false;
                 _shouldScrollToBottomAndInitObserver = false;
                 _pendingReadConfirmationChannelId = null;
                 CircuitContext.NotifyChatChannelOpenChanged(false);
                 SyncVoiceStageVisibility();
                 StateHasChanged();
             }
             else
             {
                 if (_hasCompletedInitialRender)
                 {
                     StartupTimings.EnsureTransition($"SelectChannel ({ChannelId})", $"Server: Chat[{_diagTag}].OnParametersSetAsync Selecting ({ChannelId})"); // DIAG-TEMP
                 }
                 await SelectChannelInternal(ChannelId, updateUrl: false);
             }
        }
    }

    public async ValueTask DisposeAsync()
    {
        StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] DisposeAsync (live={Interlocked.Decrement(ref StartupTimings.ChatLiveInstances)})"); // DIAG-TEMP
        try
        {
            if (!string.IsNullOrEmpty(VoiceUiState.FullscreenParticipantId))
            {
                try { await VoiceUiState.ExitParticipantFullscreenAsync(goBack: false); } catch { }
            }
            await UnregisterMobileEmojiPickerBackAsync(popHistory: false);
            try { _outgoingRingExpiryCts?.Cancel(); _outgoingRingExpiryCts?.Dispose(); } catch { }
            _typingCleanupTimer?.Stop();
            _typingCleanupTimer?.Dispose();

            _objRef?.Dispose();
            
            if (_module != null)
            {
                 try { await _module.InvokeVoidAsync("dispose"); }
                 catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
                 catch (Exception ex) { Logger.LogDebug(ex, "Failed to invoke JS dispose"); }
                 await _module.DisposeAsync();
            }

            if (_composerModule != null)
            {
                try { await _composerModule.DisposeAsync(); }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
                catch { }
            }
        }
        catch (JSDisconnectedException)
        {
            // Expected when the circuit is lost
        }
        catch (TaskCanceledException)
        {
            // Also expected during disposal
        }
        catch (InvalidOperationException)
        {
            // Expected when prerendering
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error disposing Chat component: {Message}", ex.Message);
        }
        
        // Prune the cache to free up memory
        if (ChannelId != null)
        {
            Db.ChatMessages.EnforceGlobalCacheSizeLimit();
        }
        
        _channelCts?.Cancel();
        
        VoiceService.OnChange -= HandleVoiceServiceChanged;
        VoiceState.PhysicalRoomsChanged -= HandlePhysicalRoomsChanged;
        CircuitContext.OnFocusChanged -= HandleFocusChanged;
        CircuitContext.OnDeviceTypeChanged -= HandleDeviceTypeChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        VoiceUiState.OnReturnToCallStageRequested -= HandleReturnToCallStageRequested;
        VoiceUiState.OnPipStateChanged -= HandleVoicePipStateChanged;
        VoiceUiState.SetCallStageVisible(false);
        UnsubscribeFromLocalEvents();
    }

    // ──────── Channel Info Panel Handlers ────────

    private async Task<bool> RevalidateCurrentSessionAndChannelAccessAsync(ChatChannel? targetChannel, bool requireTargetChannel = true)
    {
        var liveEmp = await UserService.GetEmployeeAsync();
        if (liveEmp == null || !liveEmp.IsActive || liveEmp.IsBanned)
        {
            if (_currentUser != null)
            {
                ScopedKeystore.Lock(_currentUser.Id);
            }
            EvictCurrentChannelView(navigateToBanned: liveEmp?.IsBanned == true);
            return false;
        }

        _currentUser = liveEmp;

        if (requireTargetChannel && (targetChannel == null || !ChatAuth.CanUserAccessChannel(targetChannel, liveEmp)))
        {
            EvictCurrentChannelView();
            return false;
        }

        return true;
    }

    private void EvictCurrentChannelView(bool navigateToBanned = false)
    {
        var evictedChannelId = _selectedChannel?.Id ?? ChannelId;
        if (!string.IsNullOrEmpty(evictedChannelId))
        {
            _ = InvokeAsync(async () =>
            {
                try { await JS.InvokeVoidAsync("spokesMediaLoader.evictContext", "chat", evictedChannelId); }
                catch { }
            });
        }
        _channelCts?.Cancel();
        ChannelId = null;
        _previousChannelId = null;
        _pendingAutoJoinVoiceChannelId = null;
        _selectedChannel = null;
        _showInfoPanel = false;
        ClearMessageActionOverlays();
        _decryptedChannelKey = null;
        _decryptedContents.Clear();
        _messages.Clear();
        _sortedMessages.Clear();
        _typingUsers.Clear();
        CircuitContext.NotifyChatChannelOpenChanged(false);
        LoadChannels();
        if (navigateToBanned)
        {
            _routeTransitionGuard.Reset();
            Nav.NavigateTo("/banned", replace: true);
        }
        else
        {
            NavigateSelfToChatRoute(PreserveMobileQuery("/chat"), targetChannelId: null, replace: false);
        }
        StateHasChanged();
    }

    private async Task HandleChannelUpdated()
    {
        // Refresh the channel from DB to pick up name/icon/member changes
        if (_selectedChannel != null)
        {
            var refreshed = Db.ChatChannels.GetById(_selectedChannel.Id);
            if (!await RevalidateCurrentSessionAndChannelAccessAsync(refreshed))
            {
                return;
            }

            _selectedChannel = refreshed;
            _channelTeams = GetChannelTeams();
            _channelEmployees = GetChannelEmployees();
            var refreshCount = Math.Max(InitialChannelMessageCount, _messages.Count);
            _messages = await Db.ChatMessages.GetByChannelAsync(_selectedChannel!.Id, refreshCount);
            var oldest = _messages.MinBy(m => m.SentAt);
            _hasMoreMessages = oldest != null && Db.ChatMessages.HasMessagesBefore(_selectedChannel.Id, oldest.SentAt);
            _decryptedChannelKey = null;
            _decryptedContents.Clear();
            TryDecryptMessages();
            RecomputeSortedMessages();
            RecomputeLatestReadReceipts();
        }
        LoadChannels();
        StateHasChanged();
    }

    private async Task RemovePwaShortcutAsync(string channelId)
    {
        try
        {
            await JS.InvokeVoidAsync("spokesRemoveShortcut", Configuration["ServerUrl"] ?? Nav.BaseUri, channelId);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // Circuit disconnected or cancelled
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to remove PWA shortcut for channel {ChannelId}", channelId);
        }
    }

    private async Task HandleLeaveGroup()
    {
        if (ChannelId != null)
        {
            await RemovePwaShortcutAsync(ChannelId);
        }
        _channelCts?.Cancel();
        _showInfoPanel = false;
        ChannelId = null;
        _previousChannelId = null;
        _pendingAutoJoinVoiceChannelId = null;
        _selectedChannel = null;
        ClearMessageActionOverlays();
        _messages.Clear();
        _sortedMessages.Clear();
        CircuitContext.NotifyChatChannelOpenChanged(false);
        SyncVoiceStageVisibility();
        LoadChannels();
        NavigateSelfToChatRoute(PreserveMobileQuery("/chat"), targetChannelId: null, replace: false);
        StateHasChanged();
    }

    private bool IsAdminOrCreator(ChatChannel channel)
    {
        return ChatAuth.CanUserManageChannel(channel, _currentUser, isSessionUnlocked: true);
    }

    private async Task HandleArchiveChannel()
    {
        if (_selectedChannel != null && _currentUser != null && IsAdminOrCreator(_selectedChannel))
        {
            if (_selectedChannel.IsEncrypted && !ScopedKeystore.IsUnlocked)
            {
                Snackbar.Add(Loc["Unlock secure chat to modify this channel."].Value, Severity.Warning);
                return;
            }
            var result = ChatService.ArchiveChannel(_selectedChannel.Id, true, _currentUser.Id, ScopedKeystore.IsUnlocked);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
                return;
            }
            await RemovePwaShortcutAsync(_selectedChannel.Id);
            _channelCts?.Cancel();
            _showInfoPanel = false;
            ChannelId = null;
            _previousChannelId = null;
            _pendingAutoJoinVoiceChannelId = null;
            _selectedChannel = null;
            ClearMessageActionOverlays();
            _messages.Clear();
            _sortedMessages.Clear();
            CircuitContext.NotifyChatChannelOpenChanged(false);
            SyncVoiceStageVisibility();
            LoadChannels();
            NavigateSelfToChatRoute(PreserveMobileQuery("/chat"), targetChannelId: null, replace: false);
            StateHasChanged();
            Snackbar.Add(Loc["Channel archived"].Value, Severity.Warning);
        }
    }

    private async Task HandleDeleteChannel()
    {
        if (_selectedChannel != null && _currentUser != null && ChatAuth.CanUserDeleteChannel(_selectedChannel, _currentUser, isSessionUnlocked: true))
        {
            if (_selectedChannel.IsEncrypted && !ScopedKeystore.IsUnlocked)
            {
                Snackbar.Add(Loc["Unlock secure chat to modify this channel."].Value, Severity.Warning);
                return;
            }
            var channelId = _selectedChannel.Id;
            var result = ChatService.DeleteChannel(channelId, _currentUser.Id, ScopedKeystore.IsUnlocked);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? Loc["Failed to delete channel"].Value, Severity.Error);
                return;
            }
            await RemovePwaShortcutAsync(channelId);

            _channelCts?.Cancel();
            _showInfoPanel = false;
            ChannelId = null;
            _previousChannelId = null;
            _pendingAutoJoinVoiceChannelId = null;
            _selectedChannel = null;
            ClearMessageActionOverlays();
            _messages.Clear();
            _sortedMessages.Clear();
            CircuitContext.NotifyChatChannelOpenChanged(false);
            SyncVoiceStageVisibility();
            LoadChannels();
            NavigateSelfToChatRoute(PreserveMobileQuery("/chat"), targetChannelId: null, replace: false);
            StateHasChanged();
            Snackbar.Add(Loc["Channel permanently deleted"].Value, Severity.Error);
        }
    }

    private async Task HandleRemoveMember(string memberId)
    {
        // Refresh channel state after member removal
        if (_selectedChannel != null)
        {
            var refreshed = Db.ChatChannels.GetById(_selectedChannel.Id);
            if (refreshed != null)
            {
                _selectedChannel = refreshed;
                _channelTeams = GetChannelTeams();
                _channelEmployees = GetChannelEmployees();
                if (!string.IsNullOrEmpty(memberId) && !ChatAuth.CanUserAccessChannel(refreshed.Id, memberId))
                {
                    await VoiceChannelService.LeaveVoiceAsync(refreshed.Id, memberId, evictFromLiveKit: true);
                }
            }
        }
        LoadChannels();
        StateHasChanged();
    }
