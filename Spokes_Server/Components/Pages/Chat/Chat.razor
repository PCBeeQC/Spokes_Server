    private async Task JoinVoiceChannelInternal(bool isInitiator)
    {
        var targetChannel = _selectedChannel;
        if (targetChannel == null)
        {
            return;
        }
        if (!VoiceService.TryBeginConnecting(targetChannel.Id))
        {
            return;
        }

        bool enteredConnectAsync = false;
        try
        {
            _currentUser = await UserService.GetEmployeeAsync();
            if (_currentUser == null || _selectedChannel == null) return;
            if (!_currentUser.IsActiveUnsuspended || !_currentUser.HasPermission(AppPermissions.Chat.Use))
            {
                Snackbar.Add(Loc["Your account is in read-only mode."].Value, Severity.Warning);
                return;
            }
            
            bool isDemo = Configuration.GetValue<bool>("Spokes_DemoMode");
            if (isDemo)
            {
                var demoConfig = Db.DemoConfigs.Get();
                var mockParticipants = demoConfig.AutoLoginEmployeeIds.ToHashSet();
                if (!mockParticipants.Contains(_currentUser.Id))
                {
                    mockParticipants.Add(_currentUser.Id);
                }
                
                if (_selectedChannel.ChannelType == ChatChannelType.Direct)
                {
                    mockParticipants.IntersectWith(_selectedChannel.ParticipantIds);
                }

                 DemoVoiceAdapter.ConnectMock(_selectedChannel.Id, _currentUser.Id, mockParticipants);
                 SyncVoiceStageVisibility();
                 StateHasChanged();
                return;
            }

            try
            {
                var voiceSessionId = Guid.NewGuid().ToString("N");
                var url = LiveKitService.ResolveClientWebSocketUrl(Configuration, Db.SystemConfigs.Get(), Nav.BaseUri);

                var loadSettingsTask = !VoiceUiState.HasLoadedVoiceSettings
                    ? VoiceUiState.LoadDeviceVoiceSettingsAsync()
                    : Task.CompletedTask;
                var initModuleTask = VoiceService.EnsureModuleInitializedAsync();
                var identityTask = VoiceService.GetOrCreatePhysicalDeviceIdentityAsync();
                await Task.WhenAll(loadSettingsTask, initModuleTask, identityTask);

                var noiseSuppression = !string.IsNullOrWhiteSpace(VoiceService.SavedNoiseFilter)
                    ? VoiceService.SavedNoiseFilter
                    : "rnnoise";
                var (deviceId, deviceName) = identityTask.Result;
                if (string.IsNullOrWhiteSpace(deviceId) && !string.IsNullOrWhiteSpace(_sessionId))
                {
                    var devSession = Db.DeviceSessions.GetById(_sessionId);
                    if (devSession != null && !string.IsNullOrWhiteSpace(devSession.DeviceId))
                    {
                        deviceId = devSession.DeviceId;
                        deviceName = string.IsNullOrWhiteSpace(devSession.DeviceName) ? "This Device" : devSession.DeviceName;
                    }
                }
                var avatarUrl = _currentUser.HasCustomAvatar
                    ? $"/spokesapi/Media/Avatar/{_currentUser.Id}?v={_currentUser.AvatarVersion}"
                    : string.Empty;
                var platform = VoiceService.GetLocalPlatformTag();
                var token = VoiceChannelService.GenerateJoinToken(
                    _selectedChannel.Id,
                    _currentUser.Id,
                    _currentUser.FullName,
                    avatarUrl,
                    voiceSessionId,
                    deviceId,
                    deviceName,
                    platform);

                var connectionOptions = new VoiceConnectionOptions
                {
                    Token = token,
                    Url = url,
                    ChannelId = _selectedChannel.Id,
                    UserId = _currentUser.Id,
                    AudioBitrateKbps = _selectedChannel.AudioBitrateKbps,
                    NoiseSuppression = noiseSuppression,
                    VoiceSettings = VoiceUiState.VoiceSettings,
                    DeviceId = deviceId,
                    DeviceName = deviceName,
                    VoiceSessionId = voiceSessionId,
                    PreferredMicDeviceId = VoiceUiState.ActiveMicrophoneDeviceId
                };
                enteredConnectAsync = true;
                await VoiceService.ConnectAsync(connectionOptions);
            }
            catch (Exception ex)
            {
                Snackbar.Add($"{Loc["Voice Configuration Error"].Value}: {ex.Message}", Severity.Error);
            }

            if (VoiceService.IsInVoiceCall)
            {
                 if (isInitiator && _selectedChannel.ChannelType == ChatChannelType.Direct)
                 {
                     var inviteResult = await VoiceChannelService.SendCallInviteAsync(_currentUser.Id, _selectedChannel.Id);
                     if (!inviteResult.IsSuccess && !string.IsNullOrEmpty(inviteResult.ErrorMessage))
                     {
                         Snackbar.Add(inviteResult.ErrorMessage, Severity.Warning);
                     }
                     else if (inviteResult.IsSuccess && inviteResult.Value != null)
                     {
                         if (!_messages.Any(m => m.Id == inviteResult.Value.Id))
                         {
                             _messages.Add(inviteResult.Value);
                             RecomputeSortedMessages();
                             StateHasChanged();
                         }
                         ScheduleOutgoingRingExpiryRefresh();
                     }
                 }
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{Loc["Error joining voice"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            if (!enteredConnectAsync)
            {
                VoiceService.CancelPreparingConnect(targetChannel.Id);
            }
        }
    }

    private CancellationTokenSource? _outgoingRingExpiryCts;

    private void ScheduleOutgoingRingExpiryRefresh()
    {
        try { _outgoingRingExpiryCts?.Cancel(); _outgoingRingExpiryCts?.Dispose(); } catch { }
        var cts = new CancellationTokenSource();
        _outgoingRingExpiryCts = cts;
        _ = Task.Run(async () =>
        {
            try
            {
                await Task.Delay(TimeSpan.FromSeconds(60.2), cts.Token);
                if (!cts.IsCancellationRequested)
                {
                    await InvokeAsync(StateHasChanged);
                }
            }
            catch (OperationCanceledException) { }
            catch (ObjectDisposedException) { }
        });
    }

    private Employee? GetRingingCalleeEmployee(IReadOnlySet<string> verifiedVoiceParticipants)
    {
        if (_selectedChannel == null ||
            _currentUser == null ||
            !VoiceService.IsInVoiceCall ||
            !string.Equals(VoiceService.CurrentChannelId, _selectedChannel.Id, StringComparison.Ordinal) ||
            !string.Equals(_selectedChannel.ChannelType, ChatChannelType.Direct, StringComparison.OrdinalIgnoreCase))
        {
            return null;
        }

        bool hasRemoteInCall = VoiceService.CallParticipants.Any(pId =>
            !string.IsNullOrEmpty(pId) &&
            !string.Equals(pId, VoiceService.CurrentUserId, StringComparison.Ordinal) &&
            verifiedVoiceParticipants.Contains(pId));
        if (hasRemoteInCall)
        {
            return null;
        }

        var activeInvite = _messages
            .Where(m => m.MessageType == ChatMessageType.CallInvite)
            .OrderByDescending(m => m.SentAt)
            .FirstOrDefault();

        if (activeInvite == null ||
            !string.Equals(activeInvite.CallStatus, CallStatus.Active, StringComparison.OrdinalIgnoreCase) ||
            (DateTime.UtcNow - activeInvite.SentAt).TotalSeconds >= 60)
        {
            return null;
        }

        var calleeId = _selectedChannel.ParticipantIds
            .FirstOrDefault(id => !string.Equals(id, _currentUser.Id, StringComparison.Ordinal));
        if (string.IsNullOrEmpty(calleeId))
        {
            return null;
        }

        return GetVoiceParticipantEmployee(calleeId);
    }
    
