    private void ArchiveChannel(ChatChannel channel)
    {
        if (channel.IsEncrypted && !ScopedKeystore.IsUnlocked)
        {
            Snackbar.Add(Loc["Unlock secure chat to modify this channel."].Value, Severity.Warning);
            return;
        }
        var result = ChatService.ArchiveChannel(channel.Id, true, _currentUser?.Id, ScopedKeystore.IsUnlocked);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
            return;
        }
        LoadChannels();
        StateHasChanged();
    }

    private void UnarchiveChannel(ChatChannel channel)
    {
        if (channel.IsEncrypted && !ScopedKeystore.IsUnlocked)
        {
            Snackbar.Add(Loc["Unlock secure chat to modify this channel."].Value, Severity.Warning);
            return;
        }
        var result = ChatService.ArchiveChannel(channel.Id, false, _currentUser?.Id, ScopedKeystore.IsUnlocked);
        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
            return;
        }
        LoadChannels();
        StateHasChanged();
    }

