    private List<Employee> GetChannelEmployees()
    {
        if (_selectedChannel == null) return new List<Employee>();

        switch (_selectedChannel.ChannelType)
        {
            case ChatChannelType.Direct:
            case ChatChannelType.Group:
                return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();

            case ChatChannelType.Team:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();
                }
                else if (!string.IsNullOrEmpty(_selectedChannel.LinkedEntityId))
                {
                    var team = Db.Teams.GetById(_selectedChannel.LinkedEntityId);
                    if (team != null)
                    {
                        return _employees.Where(e => e.TeamId == team.Id || e.Id == team.LeaderId).ToList();
                    }
                }
                return new List<Employee>();

            case ChatChannelType.Project:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();
                }
                return _employees.Where(e => e.IsActive).ToList();

            default:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();
                }
                else if (_selectedChannel.AllowedTeamIds.Any())
                {
                    var teamEmployees = _employees.Where(e =>
                        _selectedChannel.AllowedTeamIds.Contains(e.TeamId) ||
                        Db.Teams.GetAll().Any(t => _selectedChannel.AllowedTeamIds.Contains(t.Id) && t.LeaderId == e.Id)
                    );
                    return PrivacyService.FilterDiscoverableEmployees(_currentUser, teamEmployees);
                }
                return PrivacyService.FilterDiscoverableEmployees(_currentUser, _employees.Where(e => e.IsActive));
        }
    }

    private List<Team> GetChannelTeams()
    {
        if (_selectedChannel == null) return new List<Team>();
        
        if (_selectedChannel.AllowedTeamIds.Any())
        {
             var allowedTeams = Db.Teams.GetAll().Where(t => _selectedChannel.AllowedTeamIds.Contains(t.Id));
             return PrivacyService.FilterDiscoverableTeams(_currentUser, allowedTeams);
        }
        
        if (_selectedChannel.ChannelType == ChatChannelType.Direct || _selectedChannel.ChannelType == ChatChannelType.Group)
             return new List<Team>(); 

        return PrivacyService.FilterDiscoverableTeams(_currentUser, Db.Teams.GetAll());
    }

