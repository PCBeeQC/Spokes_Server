    [Inject] private Spokes_Server.Core.Services.Security.FileTokenService FileTokens { get; set; } = default!;

    [JSInvokable]
    public string GetUploadUrl()
    {
        if (string.IsNullOrEmpty(ChannelId))
            return "/spokesapi/files/chat";

        if (string.IsNullOrWhiteSpace(_currentUser?.Id) || string.IsNullOrWhiteSpace(CircuitContext?.SessionId))
            return $"/spokesapi/files/chat/{ChannelId}";

        if (_selectedChannel?.IsEncrypted == true)
        {
            var channelKey = EnsureDecryptedChannelKey();
            if (!string.IsNullOrEmpty(channelKey))
            {
                var token = FileTokens.GenerateAccessToken("chat", ChannelId, "*", channelKey, _currentUser.Id, CircuitContext.SessionId);
                return $"/spokesapi/files/chat/{ChannelId}?t={token}";
            }
            return $"/spokesapi/files/chat/{ChannelId}";
        }
        else if (_selectedChannel != null)
        {
            var token = FileTokens.GenerateAccessToken("chat", ChannelId, "*", null, _currentUser.Id, CircuitContext.SessionId);
            return $"/spokesapi/files/chat/{ChannelId}?t={token}";
        }
        return $"/spokesapi/files/chat/{ChannelId}";
    }

    private string GetTokenizedFileUrl(string filePath, string fileName, ChatMessage? message = null, bool isThumbnail = false)
    {
        var effectiveChannelId = message?.ChannelId ?? _selectedChannel?.Id ?? ChannelId;
        if (string.IsNullOrEmpty(effectiveChannelId) || _selectedChannel == null)
            return filePath;

        string? channelKey = null;
        if (_selectedChannel.IsEncrypted)
        {
            channelKey = GetDecryptedKeyForMessage(message) ?? EnsureDecryptedChannelKey();
            if (string.IsNullOrEmpty(channelKey))
                return filePath;
        }

        var effectiveSessionId = !string.IsNullOrWhiteSpace(_sessionId) ? _sessionId : CircuitContext?.SessionId;

        return FileTokens.BuildTokenizedUrl(
            "chat",
            effectiveChannelId,
            filePath,
            channelKey,
            _currentUser?.Id,
            effectiveSessionId,
            isThumbnail: isThumbnail);
    }

