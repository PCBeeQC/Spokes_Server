    internal static int ComputeMessageDataVersionHash(ChatMessage message, string? decryptedContent)
    {
        var hash = new HashCode();
        hash.Add(message.Content, StringComparer.Ordinal);
        hash.Add(decryptedContent != null);
        hash.Add(decryptedContent, StringComparer.Ordinal);
        hash.Add(message.EditedAt?.Ticks ?? 0L);
        hash.Add(message.CallStatus);
        hash.Add(message.IsDeleted);
        hash.Add(message.Attachments.Count);
        foreach (var reaction in message.Reactions)
        {
            hash.Add(reaction, StringComparer.Ordinal);
        }
        if (message.MentionedAlbumIds != null)
        {
            hash.Add(message.MentionedAlbumIds.Count);
            foreach (var albumId in message.MentionedAlbumIds)
            {
                hash.Add(albumId, StringComparer.Ordinal);
            }
        }
        if (message.MentionedEventIds != null)
        {
            hash.Add(message.MentionedEventIds.Count);
            foreach (var eventId in message.MentionedEventIds)
            {
                hash.Add(eventId, StringComparer.Ordinal);
            }
        }
        if (message.MentionedPollIds != null)
        {
            hash.Add(message.MentionedPollIds.Count);
            foreach (var pollId in message.MentionedPollIds)
            {
                hash.Add(pollId, StringComparer.Ordinal);
            }
        }
        return hash.ToHashCode();
    }

    // --- Channel Selection ---

    private async Task SelectChannel(string channelId)
    {
        if (string.Equals(ChannelId, channelId, StringComparison.Ordinal) &&
            _selectedChannel != null &&
            string.Equals(_selectedChannel.Id, channelId, StringComparison.Ordinal) &&
            !_channelNotFound &&
            !_isLoadingMessages)
        {
            await ConfirmChannelViewedAndReadAsync(channelId, userInitiated: true);
            if (_selectedChannel.IsVoiceChannel && !VoiceService.IsInVoiceCall && !VoiceService.IsConnecting)
            {
                _ = JoinVoiceChannelInternal(isInitiator: false);
            }
            if (_isScrolledUp)
            {
                await ScrollToBottom();
            }
            return;
        }

        StartupTimings.EnsureTransition($"SelectChannel ({channelId})", $"Server: SelectChannel Clicked ({channelId})"); // DIAG-TEMP
        await SelectChannelInternal(channelId, updateUrl: true, autoJoinVoice: true, userInitiated: true);
    }

    private string? _previousChannelId;
    private string? _pendingAutoJoinVoiceChannelId;

    private async Task SelectChannelInternal(string channelId, bool updateUrl, bool autoJoinVoice = false, bool userInitiated = false)
    {
        StartupTimings.AddChatTransition($"Server: SelectChannelInternal Start (channelId={channelId}, updateUrl={updateUrl})");
        // Cancel any in-flight operations from the previous channel (StreamMessagesAsync, etc.)
        // Note: We intentionally do NOT Dispose() the old CTS here. Dispose() is optional for
        // CancellationTokenSource and calling it creates a race condition where concurrent code
        // (e.g. the Dispose pathway or LoadOlderMessages) can access a disposed CTS, throwing
        // ObjectDisposedException and crashing the Blazor circuit. Cancel() alone is sufficient.
        _channelCts?.Cancel();
        var newCts = new CancellationTokenSource();
        _channelCts = newCts;
        var token = newCts.Token;

        // Guard against race conditions where the user switches channels while loading
        var newChannelId = channelId;
        
        bool currentlyInChannel = !string.IsNullOrEmpty(ChannelId);
        
        // Prune the PREVIOUS channel logic in background - NEVER block UI transition
        if (_previousChannelId != null && _previousChannelId != newChannelId)
        {
             _ = Task.Run(() =>
             {
                 try
                 {
                     Db.ChatMessages.EnforceGlobalCacheSizeLimit();
                 }
                 catch (Exception ex)
                 {
                     Logger.LogWarning(ex, "Previous channel cleanup error: {Message}", ex.Message);
                 }
             });
        }
        _previousChannelId = newChannelId;
        ChannelId = newChannelId;
        
        _selectedChannel = _channels.FirstOrDefault(c => c.Id == channelId);
        if (_selectedChannel == null)
        {
            LoadChannels();
            _selectedChannel = _channels.FirstOrDefault(c => c.Id == channelId);
        }
        
        // If the channel was not found (access denied / deleted), don't proceed
        if (_selectedChannel == null || (_currentUser != null && !ChatAuth.CanUserAccessChannel(_selectedChannel, _currentUser)))
        {
            _selectedChannel = null;
            _pendingAutoJoinVoiceChannelId = null;
            _channelNotFound = true;
            ClearMessageActionOverlays();
            StateHasChanged();
            return;
        }
        _channelNotFound = false;
        ClearMessageActionOverlays();

        // Sync layout state and browser URL atomically BEFORE any async disk I/O so the URL,
        // Android back stack, and AppBar state never drift during cold channel loads.
        CircuitContext.NotifyChatChannelOpenChanged(true);
        if (updateUrl)
        {
            StartupTimings.AddChatTransition("Server: Calling Nav.NavigateTo");
            NavigateSelfToChatRoute(PreserveMobileQuery($"/chat/{channelId}"), newChannelId, replace: currentlyInChannel);
        }

        if (_currentUser != null)
        {
            UserClientStateService.UpdateActiveChannel(_currentUser.Id, newChannelId);
        }

        _channelTeams = GetChannelTeams();
        _channelEmployees = GetChannelEmployees();
        StartupTimings.AddChatTransition($"Server: GetChannelTeams & GetChannelEmployees Done ({_channelEmployees.Count} members)");

        // Stage 1: Load only the newest 12 messages asynchronously for instant first paint;
        // Chat.razor.js automatically fills the remaining viewport height in Stage 2 (FillViewportMessagesJS).
        var loadTask = Db.ChatMessages.GetByChannelWithStatsAsync(channelId, InitialChannelMessageCount, token);
        Spokes_Server.Core.Data.Repositories.Communication.ChannelMessageLoadResult loadResult;
        if (loadTask.IsCompletedSuccessfully)
        {
            loadResult = loadTask.Result;
        }
        else
        {
            // Cold channel hitting disk: clear previous channel's messages and show loading indicator
            // rather than flashing "No messages yet" while background disk reads complete off-circuit.
            _messages.Clear();
            _sortedMessages = new();
            _decryptedContents.Clear();
            _isLoadingMessages = true;
            using (StartupTimings.Span($"Server: Db.ChatMessages.GetByChannelAsync ({channelId})"))
            {
                loadResult = await loadTask;
            }
        }
        if (token.IsCancellationRequested || ChannelId != newChannelId) return;

        _messages = loadResult.Messages;
        _hasMoreMessages = loadResult.HasMore;
        StartupTimings.AddChatTransition(
            $"Server: Db.ChatMessages.GetByChannelAsync Done ({_messages.Count} msgs, cache={loadResult.CacheHits}, disk={loadResult.DiskReads}, index={loadResult.IndexLookupMs:F1}ms, disk={loadResult.DiskReadMs:F1}ms, hasMore={_hasMoreMessages})");
        _typingUsers.Clear();
        _sortedMessages = new();
        _decryptedChannelKey = null;
        _decryptedContents.Clear();
        ClearMessageActionOverlays();
        _isLoadingMessages = false;
        _isFillingViewport = false;

        var decryptSw = System.Diagnostics.Stopwatch.StartNew();
        TryDecryptMessages();
        decryptSw.Stop();
        StartupTimings.AddChatTransition($"Server: TryDecryptMessages Done ({_decryptedContents.Count} decrypted, +{decryptSw.Elapsed.TotalMilliseconds:F1}ms)");
        RecomputeSortedMessages();
        RecomputeLatestReadReceipts();
        StartupTimings.AddChatTransition("Server: RecomputeSortedMessages & ReadReceipts Done");

        if (StartupTimings.IsChatProfilerEnabled)
        {
            int totalTextChars = 0;
            int maxMsgChars = 0;
            int totalImages = 0;
            int totalVideos = 0;
            int totalAudio = 0;
            int totalFiles = 0;
            int totalAlbumCards = 0;
            int totalPollCards = 0;
            int totalEventCards = 0;
            int totalLinkPreviewMsgs = 0;
            int totalCallInvites = 0;
            int totalCodeBlocks = 0;
            foreach (var m in _messages)
            {
                var eff = _decryptedContents.TryGetValue(m.Id, out var dec) ? dec : (m.Content ?? string.Empty);
                int len = eff.Length;
                totalTextChars += len;
                if (len > maxMsgChars) maxMsgChars = len;
                if (m.MessageType == ChatMessageType.CallInvite) totalCallInvites++;
                if (eff.Contains("http://", StringComparison.OrdinalIgnoreCase) || eff.Contains("https://", StringComparison.OrdinalIgnoreCase)) totalLinkPreviewMsgs++;
                if (eff.Contains("```", StringComparison.Ordinal) || eff.Contains("[code", StringComparison.OrdinalIgnoreCase)) totalCodeBlocks++;
                if (m.Attachments != null)
                {
                    foreach (var a in m.Attachments)
                    {
                        if (FileHelper.IsImageFile(a.FileName)) totalImages++;
                        else if (FileHelper.IsVideoFile(a.FileName)) totalVideos++;
                        else if (FileHelper.IsAudioFile(a.FileName) || (a.ContentType != null && a.ContentType.StartsWith("audio/", StringComparison.OrdinalIgnoreCase))) totalAudio++;
                        else totalFiles++;
                    }
                }
                totalAlbumCards += m.MentionedAlbumIds?.Count ?? 0;
                totalPollCards += m.MentionedPollIds?.Count ?? 0;
                totalEventCards += m.MentionedEventIds?.Count ?? 0;
            }
            StartupTimings.AddChatTransition(
                $"Server: Channel Payload Stats (msgs={_messages.Count}, textChars={totalTextChars}, maxMsgChars={maxMsgChars}, img={totalImages}, vid={totalVideos}, aud={totalAudio}, file={totalFiles}, albums={totalAlbumCards}, polls={totalPollCards}, events={totalEventCards}, links={totalLinkPreviewMsgs}, invites={totalCallInvites}, code={totalCodeBlocks})");
        }

        _isScrolledUp = false;
        _shouldScrollToBottomAndInitObserver = true;

        // Reset view states
        _showSecondaryChat = false;
        SyncVoiceStageVisibility();

        if (SoundService.IsCallRingtonePlaying || _outgoingRingExpiryCts != null)
        {
            _ = SoundService.StopCallRingtoneAsync();
        }

        // Load notification level preference before rendering
        if (_currentUser != null && _selectedChannel != null)
        {
            _notificationLevel = Db.ChatReadStates.GetNotificationLevel(
                _currentUser.Id, channelId, _selectedChannel.ChannelType.ToString(), _selectedChannel.IsVoiceChannel);
        }

        // Clear unread state immediately on explicit user channel clicks so the sidebar and nav
        // render with updated badges in the same pass; defer passive/route-driven opens to OnAfterRenderAsync.
        if (userInitiated)
        {
            _pendingReadConfirmationChannelId = null;
            await ConfirmChannelViewedAndReadAsync(newChannelId, userInitiated: true);
        }
        else
        {
            _pendingReadConfirmationChannelId = newChannelId;
        }

        // Defer auto-join until OnAfterRenderAsync finishes mounting the channel view & composer
        // so LiveKit/denoiser initialization never stalls initial channel interactivity.
        _pendingAutoJoinVoiceChannelId =
            (autoJoinVoice && !VoiceService.IsInVoiceCall && !VoiceService.IsConnecting && _selectedChannel?.IsVoiceChannel == true)
                ? _selectedChannel.Id
                : null;

        // All callers (SelectChannel EventCallback, OnInitializedAsync, OnParametersSetAsync) are
        // Blazor lifecycle/callback entry points that automatically render on completion; calling
        // StateHasChanged() explicitly here caused a duplicate RenderTree pass right after cold loads.
        StartupTimings.AddChatTransition("Server: SelectChannelInternal Ready For Render");

        // Push shortcuts to native OS in background (only on Capacitor native app, deferred after transition)
        if (CircuitContext.IsCapacitorApp)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await Task.Delay(1500, token);
                    if (token.IsCancellationRequested || _selectedChannel == null) return;
                    var serverUrl = Configuration["ServerUrl"] ?? Nav.BaseUri;
                    var channelName = GetChannelDisplayName(_selectedChannel);
                    Employee? dmTarget = null;
                    if (_selectedChannel.ChannelType == ChatChannelType.Direct && _currentUser != null)
                    {
                        var otherEmpId = _selectedChannel.ParticipantIds.FirstOrDefault(id => id != _currentUser.Id) ?? _currentUser.Id;
                        if (otherEmpId != null)
                        {
                            dmTarget = GetEmployee(otherEmpId);
                        }
                    }

                    var companyProfile = dmTarget == null ? Db.CompanyProfile.Get() : null;
                    string iconKey = dmTarget != null
                        ? ShortcutIconService.GetEmployeeIconCacheKey(dmTarget)
                        : ShortcutIconService.GetCompanyLogoCacheKey(companyProfile?.LogoBase64, companyProfile?.LogoVersion ?? 0);
                    string shortcutSignature = $"{channelName}|{iconKey}";

                    await InvokeAsync(async () =>
                    {
                        if (token.IsCancellationRequested || _module == null) return;

                        if (_pushedShortcutSignatures.TryGetValue(channelId, out var existingSig) &&
                            string.Equals(existingSig, shortcutSignature, StringComparison.Ordinal))
                        {
                            return;
                        }

                        string iconPayload = string.Empty;
                        bool hasIconKey = !string.IsNullOrEmpty(iconKey);
                        if (!hasIconKey || !_sentShortcutIconKeys.Contains(iconKey))
                        {
                            iconPayload = dmTarget != null
                                ? ShortcutIconService.GetShortcutIconBase64(dmTarget)
                                : ShortcutIconService.GetCompanyLogoBase64(companyProfile?.LogoBase64);

                            if (string.IsNullOrEmpty(iconPayload) && dmTarget != null)
                            {
                                var fallbackProfile = Db.CompanyProfile.Get();
                                iconKey = ShortcutIconService.GetCompanyLogoCacheKey(fallbackProfile?.LogoBase64, fallbackProfile?.LogoVersion ?? 0);
                                shortcutSignature = $"{channelName}|{iconKey}";
                                hasIconKey = !string.IsNullOrEmpty(iconKey);
                                if (!hasIconKey || !_sentShortcutIconKeys.Contains(iconKey))
                                {
                                    iconPayload = ShortcutIconService.GetCompanyLogoBase64(fallbackProfile?.LogoBase64);
                                }
                            }
                        }

                        await JS.InvokeVoidAsync("spokesPushDirectShareShortcut", serverUrl, channelId, channelName, iconPayload, iconKey);

                        if (hasIconKey && !string.IsNullOrEmpty(iconPayload))
                        {
                            _sentShortcutIconKeys.Add(iconKey);
                        }
                        _pushedShortcutSignatures[channelId] = shortcutSignature;
                    });
                }
                catch (OperationCanceledException) { }
                catch (Exception e)
                {
                    Logger.LogWarning(e, "Failed to push shortcut for {ChannelId}: {Message}", channelId, e.Message);
                }
            });
        }
    }

    // --- Message Actions ---

    private async Task HandleSendMessage((string Content, List<ChatAttachment> Attachments) args)
    {
        if (_currentUser == null || ChannelId == null) return;
        bool hadReply = _replyingTo != null;
        var result = await ChatService.SendMessageAsync(new SendMessageOptions
        {
            SenderId = _currentUser.Id,
            ChannelId = ChannelId,
            Content = args.Content,
            Attachments = args.Attachments,
            ReplyToId = _replyingTo?.Id,
            PrivateKey = ScopedKeystore.GetPrivateKey()
        });

        if (!result.IsSuccess)
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to send message."].Value, Severity.Error);
            return;
        }

        _replyingTo = null;
        // OnMessageReceived already added the message and triggered StateHasChanged() during SendMessageAsync.
        // Suppress Blazor's post-EventCallback auto-render when no reply strip needs to be cleared.
        if (!hadReply)
        {
            _suppressEventAutoRender = true;
        }
    }

    private async Task StartReply(ChatMessage message)
    {
        _replyingTo = message;
        StateHasChanged();
        
        await Task.Delay(10);
        if (_composer != null)
        {
            await _composer.FocusInputAsync();
        }
    }

    private void CancelReply()
    {
        _replyingTo = null;
        StateHasChanged();
    }

    private void HandleNotificationLevelChanged(string level)
    {
        if (_currentUser == null || ChannelId == null) return;
        _notificationLevel = level;
        Db.ChatReadStates.SetNotificationLevel(_currentUser.Id, ChannelId, level);
        StateHasChanged();
    }

