    // ──────── Channel Info Panel Handlers ────────

    private void HandleChannelUpdated()
    {
        // Refresh the channel from DB to pick up name/icon/member changes
        if (_selectedChannel != null)
        {
            var refreshed = Db.ChatChannels.GetById(_selectedChannel.Id);
            if (refreshed != null)
                _selectedChannel = refreshed;

            _messages = Db.ChatMessages.GetByChannel(_selectedChannel.Id, 40);
            var oldest = _messages.MinBy(m => m.SentAt);
            _hasMoreMessages = oldest != null && Db.ChatMessages.HasMessagesBefore(_selectedChannel.Id, oldest.SentAt);
            _decryptedChannelKey = null;
            _decryptedContents.Clear();
            TryDecryptMessages();
            RecomputeSortedMessages();
            RecomputeLatestReadReceipts();
        }
        LoadChannels();
        StateHasChanged();
    }

    private async Task RemovePwaShortcutAsync(string channelId)
    {
        try
        {
            await JS.InvokeVoidAsync("spokesRemoveShortcut", Configuration["ServerUrl"] ?? Nav.BaseUri, channelId);
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // Circuit disconnected or cancelled
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to remove PWA shortcut for channel {ChannelId}", channelId);
        }
    }

    private async Task HandleLeaveGroup()
    {
        if (ChannelId != null)
        {
            await RemovePwaShortcutAsync(ChannelId);
        }
        _showInfoPanel = false;
        _selectedChannel = null;
        LoadChannels();
        Nav.NavigateTo("/chat");
    }

    private bool IsAdminOrCreator(ChatChannel channel)
    {
        if (_currentUser == null) return false;
        if (_currentUser.IsAdmin) return true;
        
        if (channel.ChannelType == ChatChannelType.Team)
        {
            var teams = Db.Teams.GetAll().Where(t => channel.AllowedTeamIds.Contains(t.Id)).ToList();
            return teams.Any(t => t.LeaderId == _currentUser.Id);
        }
        
        return channel.CreatedById == _currentUser.Id;
    }

    private async Task HandleArchiveChannel()
    {
        if (_selectedChannel != null && IsAdminOrCreator(_selectedChannel))
        {
            if (_selectedChannel.IsEncrypted && !ScopedKeystore.IsUnlocked)
            {
                Snackbar.Add(Loc["Unlock secure chat to modify this channel."].Value, Severity.Warning);
                return;
            }
            var result = ChatService.ArchiveChannel(_selectedChannel.Id, true, _currentUser?.Id, ScopedKeystore.IsUnlocked);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? Loc["Failed to update channel"].Value, Severity.Error);
                return;
            }
            await RemovePwaShortcutAsync(_selectedChannel.Id);
            _showInfoPanel = false;
            _selectedChannel = null;
            LoadChannels();
            Nav.NavigateTo("/chat");
            Snackbar.Add(Loc["Channel archived"].Value, Severity.Warning);
        }
    }

    private async Task HandleDeleteChannel()
    {
        if (_selectedChannel != null && IsAdminOrCreator(_selectedChannel))
        {
            if (_selectedChannel.IsEncrypted && !ScopedKeystore.IsUnlocked)
            {
                Snackbar.Add(Loc["Unlock secure chat to modify this channel."].Value, Severity.Warning);
                return;
            }
            var channelId = _selectedChannel.Id;
            var result = ChatService.DeleteChannel(channelId, _currentUser?.Id, ScopedKeystore.IsUnlocked);
            if (!result.IsSuccess)
            {
                Snackbar.Add(result.ErrorMessage ?? Loc["Failed to delete channel"].Value, Severity.Error);
                return;
            }
            await RemovePwaShortcutAsync(channelId);

            _showInfoPanel = false;
            _selectedChannel = null;
            LoadChannels();
            Nav.NavigateTo("/chat");
            Snackbar.Add(Loc["Channel permanently deleted"].Value, Severity.Error);
        }
    }

    private void HandleRemoveMember(string memberId)
    {
        // Refresh channel state after member removal
        if (_selectedChannel != null)
        {
            var refreshed = Db.ChatChannels.GetById(_selectedChannel.Id);
            if (refreshed != null)
                _selectedChannel = refreshed;
        }
        LoadChannels();
        StateHasChanged();
    }
