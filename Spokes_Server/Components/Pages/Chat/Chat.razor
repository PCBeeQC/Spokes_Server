    private bool _userDisabledAutoFaceTime = false;
    private bool _prevShouldAutoFaceTime = false;
    private int _prevCameraCount = 0;
    private bool _prevIsFaceTimeGlobal = false;

    private async void HandleVoiceStateChanged()
    {
        bool isTwoPersonCall = VoiceService.CallParticipants.Count == 2;
        bool hasAnyCamera = VoiceService.CallParticipants.Any(p => 
            (p == VoiceService.CurrentUserId && VoiceService.IsVideoOn) || 
            (VoiceService.RemoteVideoHeights.GetValueOrDefault(p, 0) > 0)
        );
        bool shouldAuto = isTwoPersonCall && hasAnyCamera;

        if (shouldAuto && !_prevShouldAutoFaceTime && !_userDisabledAutoFaceTime)
        {
            var otherPerson = VoiceService.CallParticipants.FirstOrDefault(p => p != VoiceService.CurrentUserId);
            if (otherPerson != null)
            {
                _focusedParticipantId = otherPerson;
            }
        }
        else if (!shouldAuto && _prevShouldAutoFaceTime)
        {
            if (VoiceService.CallParticipants.Count != 2 || !hasAnyCamera)
            {
                _focusedParticipantId = null;
                _userDisabledAutoFaceTime = false;
            }
        }

        int activeCameras = VoiceService.CallParticipants.Count(p => 
            (p == VoiceService.CurrentUserId && VoiceService.IsVideoOn) || 
            (VoiceService.RemoteVideoHeights.GetValueOrDefault(p, 0) > 0));
            
        bool isFaceTimeLayoutGlobal = shouldAuto && _focusedParticipantId != null;
        
        bool needsRefresh = false;
        if (activeCameras != _prevCameraCount || isFaceTimeLayoutGlobal != _prevIsFaceTimeGlobal)
        {
            needsRefresh = true;
        }
        
        _prevCameraCount = activeCameras;
        _prevIsFaceTimeGlobal = isFaceTimeLayoutGlobal;
        _prevShouldAutoFaceTime = shouldAuto;

        await InvokeAsync(StateHasChanged);
        
        if (needsRefresh)
        {
            await Task.Delay(300);
            try
            {
                await VoiceService.RefreshVideoLayoutsAsync();
            }
            catch (Exception ex)
            {
                Console.WriteLine($"[Voice] Failed to refresh video layouts: {ex.Message}");
            }
        }
    }

    private async Task ToggleFocusParticipant(string participantId)
    {
        if (_focusedParticipantId == participantId)
        {
            _focusedParticipantId = null;
            if (VoiceService.CallParticipants.Count == 2)
            {
                _userDisabledAutoFaceTime = true;
            }
        }
        else
        {
            _focusedParticipantId = participantId;
            _userDisabledAutoFaceTime = false;
        }
            
        StateHasChanged();
        
        await Task.Delay(300);
        try
        {
            await VoiceService.RefreshVideoLayoutsAsync();
        }
        catch (Exception ex)
        {
            Console.WriteLine($"[Voice] Failed to refresh video layouts: {ex.Message}");
        }
    }

