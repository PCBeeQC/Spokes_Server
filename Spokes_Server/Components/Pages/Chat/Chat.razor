    private List<Employee> GetChannelEmployees()
    {
        if (_selectedChannel == null) return new List<Employee>();

        switch (_selectedChannel.ChannelType)
        {
            case ChatChannelType.Direct:
            case ChatChannelType.Group:
                return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();

            case ChatChannelType.Team:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();
                }
                else if (!string.IsNullOrEmpty(_selectedChannel.LinkedEntityId))
                {
                    var team = Db.Teams.GetById(_selectedChannel.LinkedEntityId);
                    if (team != null)
                    {
                        return _employees.Where(e => e.TeamId == team.Id || e.Id == team.LeaderId).ToList();
                    }
                }
                return new List<Employee>();

            case ChatChannelType.Project:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();
                }
                return _employees.Where(e => e.IsActive).ToList();

            default:
                if (_selectedChannel.ParticipantIds.Any())
                {
                    return _employees.Where(e => _selectedChannel.ParticipantIds.Contains(e.Id)).ToList();
                }
                else if (_selectedChannel.AllowedTeamIds.Any())
                {
                    return _employees.Where(e =>
                        _selectedChannel.AllowedTeamIds.Contains(e.TeamId) ||
                        Db.Teams.GetAll().Any(t => _selectedChannel.AllowedTeamIds.Contains(t.Id) && t.LeaderId == e.Id)
                    ).ToList();
                }
                return _employees.Where(e => e.IsActive).ToList();
        }
    }

    private List<Team> GetChannelTeams()
    {
        if (_selectedChannel == null) return new List<Team>();
        
        if (_selectedChannel.AllowedTeamIds.Any())
        {
             return Db.Teams.GetAll().Where(t => _selectedChannel.AllowedTeamIds.Contains(t.Id)).ToList();
        }
        
        if (_selectedChannel.ChannelType == ChatChannelType.Direct || _selectedChannel.ChannelType == ChatChannelType.Group)
             return new List<Team>(); 

        return Db.Teams.GetAll();
    }

    protected override async Task OnParametersSetAsync()
    {
        if (ChannelId != _selectedChannel?.Id)
        {
             if (string.IsNullOrEmpty(ChannelId))
             {
                 _selectedChannel = null;
                 _channelNotFound = false;
                 _messages.Clear();
                 _sortedMessages.Clear();
                 StateHasChanged();
             }
             else
             {
                 await SelectChannelInternal(ChannelId, updateUrl: false);
             }
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (!string.IsNullOrEmpty(ChannelId))
            {
                await ChatNotifications.MarkChannelAsReadAsync(ChannelId);
            }

            _typingCleanupTimer?.Stop();
            _typingCleanupTimer?.Dispose();

            _objRef?.Dispose();
            
            if (_module != null)
            {
                 try { await _module.InvokeVoidAsync("dispose"); } catch { }
                 await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Expected when the circuit is lost
        }
        catch (TaskCanceledException)
        {
            // Also expected during disposal
        }
        catch (InvalidOperationException)
        {
            // Expected when prerendering
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error disposing Chat component: {ex.Message}");
        }
        
        // Prune the cache to free up memory
        if (ChannelId != null)
        {
            Db.ChatMessages.EnforceGlobalCacheSizeLimit();
        }
        
        _channelCts?.Cancel();
        
        VoiceService.OnChange -= HandleVoiceStateChanged;
        UnsubscribeFromLocalEvents();
    }

