@page "/chat/{ChannelId?}"
@attribute [Authorize(Policy = AppPermissions.Chat.Use)]
@using Microsoft.AspNetCore.Authorization
@using Spokes_Server.Core.Constants
@using Microsoft.AspNetCore.Http
@using Spokes_Server.Core.Helpers
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.Communication.Notifications
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Layout
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.Communication.Presence
@inject Database Db
@inject ChatService ChatService
@inject AlbumService AlbumService
@inject IChatAuthorizationService ChatAuth
@inject IChatChannelAccessService ChatAccess
@inject PresenceStateService PresenceState
@inject UserCircuitContext CircuitContext
@inject UserClientStateService UserClientStateService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject IConfiguration Configuration
@inject ChatNotificationService ChatNotifications
@inject UserService UserService
@inject SessionService SessionService
@inject IUserPrivacyService PrivacyService
@inject VoiceChannelService VoiceChannelService
@inject ChatSecurityService ChatSecurityService
@inject GlobalVoiceService VoiceService
@inject IVoiceDeviceService VoiceDeviceService
@inject IVoiceUiStateService VoiceUiState
@inject PhysicalVoiceRoomService PhysicalRoomService
@inject IDemoVoiceAdapter DemoVoiceAdapter
@inject ICryptoService Crypto
@inject ScopedKeystoreService ScopedKeystore
@inject IModerationReportService ModerationReports
@inject ShortcutIconService ShortcutIconService
@inject StartupTimingService StartupTimings
@inject ChatStateService ChatState
@inject VoiceStateService VoiceState
@inject IHttpContextAccessor HttpContextAccessor
@inject ISoundService SoundService
@inject ILogger<Chat> Logger
@implements IAsyncDisposable
@implements IHandleEvent

<PageTitle>@Loc["Chat"]</PageTitle>

@if (StartupTimings.IsChatProfilerEnabled)
{
    StartupTimings.AddChatTransition($"Server: RenderTree Chat[{_diagTag}] Markup Start");
}
<MudContainer MaxWidth="MaxWidth.False" Class="pa-0 flex-grow-1 d-flex flex-column chat-page-container">
@* Chat page styles live in wwwroot/css/chat.css so they are HTTP-cached rather than streamed over SignalR. *@
    <MudGrid Style="height: 100%;" Spacing="0">
        <!-- Channel Sidebar -->
        <MudItem xs="12" md="3" Class="@(ChannelId != null ? "d-none d-md-block" : "")" Style="height: 100%; border-right: 1px solid var(--mud-palette-divider);">
            <ChatSidebar Channels="_channels" 
                         SelectedChannelId="@ChannelId" 
                         IsMobile="@CircuitContext.IsMobileLayout"
                         OnChannelSelected="SelectChannel"
                         CurrentUserId="@_currentUser?.Id"
                         Employees="_discoverableEmployees"
                         CanViewArchive="@CanViewArchivedChannels()"
                         OnUnarchiveChannel="UnarchiveChannel"
                         OnChannelOrdersChanged="HandleChannelOrdersChanged" />
        </MudItem>
        
        <!-- Chat Area -->
        <MudItem xs="12" md="9" Class="@(ChannelId == null ? "d-none d-md-block" : "")" Style="height: 100%;">
            @if (_selectedChannel == null && !string.IsNullOrEmpty(ChannelId) && !_channelNotFound)
            {
                <div style="height: 100%; display: flex; flex-direction: column;">
                    <!-- Header Skeleton -->
                    <div class="d-flex align-center pa-4" style="border-bottom: 1px solid var(--mud-palette-divider);">
                        <MudSkeleton SkeletonType="SkeletonType.Text" Width="200px" Height="32px" />
                        <MudSpacer />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" Class="mr-2" />
                        <MudSkeleton SkeletonType="SkeletonType.Circle" Width="32px" Height="32px" />
                    </div>
                    
                    <!-- Messages Skeleton -->
                    <div class="flex-grow-1 pa-4 d-flex flex-column justify-end">
                        <div class="d-flex flex-column align-start mb-6">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="250px" Height="60px" Style="border-radius: 16px;" Animation="Animation.Wave" />
                        </div>
                        <div class="d-flex flex-column align-end mb-6">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="300px" Height="80px" Style="border-radius: 16px;" Animation="Animation.Wave" />
                        </div>
                        <div class="d-flex flex-column align-start mb-6">
                            <MudSkeleton SkeletonType="SkeletonType.Rectangle" Width="200px" Height="60px" Style="border-radius: 16px;" Animation="Animation.Wave" />
                        </div>
                    </div>
                    
                    <!-- Input Skeleton -->
                    <div class="pa-4">
                        <MudSkeleton SkeletonType="SkeletonType.Rectangle" Height="56px" Style="border-radius: 28px;" Animation="Animation.Wave" />
                    </div>
                </div>
            }
            else
            {
                <svg style="position: absolute; width: 0; height: 0; overflow: hidden;" aria-hidden="true" focusable="false">
                    <defs>
                        <symbol id="spokes-icon-add-reaction" viewBox="0 0 24 24">@((MarkupString)Icons.Material.Outlined.AddReaction)</symbol>
                        <symbol id="spokes-icon-reply" viewBox="0 0 24 24">@((MarkupString)Icons.Material.Filled.Reply)</symbol>
                        <symbol id="spokes-icon-more-vert" viewBox="0 0 24 24">@((MarkupString)Icons.Material.Filled.MoreVert)</symbol>
                        <symbol id="spokes-icon-copy" viewBox="0 0 24 24">@((MarkupString)Icons.Material.Filled.ContentCopy)</symbol>
                        <symbol id="spokes-icon-check" viewBox="0 0 24 24">@((MarkupString)Icons.Material.Filled.Check)</symbol>
                    </defs>
                </svg>
                @if (!CircuitContext.IsMobileLayout && _selectedChannel != null)
                {
                    var desktopCanReact = PrivacyService.CanReactInChannel(_selectedChannel, _currentUser);
                    var desktopQuickReactEmojis = GetDesktopQuickReactEmojis();
                    var desktopTemplateKey = $"{(desktopCanReact ? '1' : '0')}|{string.Join(',', desktopQuickReactEmojis)}|{Loc["Add Reaction"].Value}|{Loc["Reply"].Value}";
                    <div id="spokes-desktop-message-actions-template" class="d-none" hidden aria-hidden="true" data-template-key="@desktopTemplateKey">
                        <div class="message-actions d-flex align-center" data-spokes-shared-actions="1">
                            @if (desktopCanReact)
                            {
                                @foreach (var emoji in desktopQuickReactEmojis)
                                {
                                    <button type="button" class="message-action-btn message-action-btn-emoji" data-msg-action="react" data-emoji="@emoji">@emoji</button>
                                }
                                <div class="p-rel">
                                    <button type="button" class="message-action-btn" data-msg-action="emoji-picker"
                                            title="@Loc["Add Reaction"]" aria-label="@Loc["Add Reaction"]">
                                        <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#spokes-icon-add-reaction" /></svg>
                                    </button>
                                </div>
                            }
                            <button type="button" class="message-action-btn" data-msg-action="reply"
                                    title="@Loc["Reply"]" aria-label="@Loc["Reply"]">
                                <svg viewBox="0 0 24 24" aria-hidden="true" class="icon-flip-x"><use href="#spokes-icon-reply" /></svg>
                            </button>
                            <div class="p-rel">
                                <button type="button" class="message-action-btn" data-msg-action="more">
                                    <svg viewBox="0 0 24 24" aria-hidden="true"><use href="#spokes-icon-more-vert" /></svg>
                                </button>
                            </div>
                        </div>
                    </div>
                }
                <div style="height: 100%; display: flex; flex-direction: row;">
                    @* Main chat area *@
                    <div id="chat-drop-zone" style="flex: 1; min-width: 0; display: flex; flex-direction: column; position: relative;">
                
                        @if (_isDraggingFiles)
                        {
                            <MudOverlay Visible="true" DarkBackground="true" Absolute="true" ZIndex="1000">
                                <div class="d-flex flex-column align-center pa-6" style="border: 3px dashed rgba(255,255,255,0.5); border-radius: 16px; background: rgba(255,255,255,0.1);">
                                    <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Style="font-size: 4rem; color: white;" />
                                    <MudText Typo="Typo.h5" Style="color: white; margin-top: 0.5rem;">@Loc["Drop files to upload"]</MudText>
                                </div>
                            </MudOverlay>
                        }

                    @if (_selectedChannel != null)
                {
                    <!-- Channel Header -->
                    <ChatHeader Channel="_selectedChannel"
                                DisplayName="@GetChannelDisplayName(_selectedChannel)"
                                CurrentUserId="@_currentUser?.Id"
                                OnGoBack="GoBack"
                                NotificationLevel="@_notificationLevel"
                                OnNotificationLevelChanged="HandleNotificationLevelChanged"
                                Employees="_discoverableEmployees"
                                SuggestionEmployees="@(PrivacyService.ShouldHideMemberList(_selectedChannel, _currentUser) ? new List<Employee>() : _channelEmployees)"
                                OnSearchResultSelected="ScrollToMessage"
                                OnToggleInfo="ToggleInfoPanel"
                                ShowInfoPanel="_showInfoPanel"
                                CanJoinVoice="@(_currentUser?.IsActiveUnsuspended == true && _currentUser.HasPermission(AppPermissions.Chat.Use))"
                                OnJoinVoice="JoinVoiceChannel"
                                IsMobile="@CircuitContext.IsMobileLayout" />
                    
                    <!-- Global Voice Bar is now rendered in MainLayout -->

                    <div class="d-flex flex-grow-1 @((((_selectedChannel?.IsVoiceChannel == true) || (VoiceService.IsInVoiceCall && VoiceService.CurrentChannelId == _selectedChannel?.Id)) && _showSecondaryChat) ? "voice-chat-open" : "")" style="min-height: 0; position: relative;">
                        @{
                            bool showVideoGrid = (_selectedChannel?.IsVoiceChannel == true) || (VoiceService.IsInVoiceCall && VoiceService.CurrentChannelId == _selectedChannel?.Id);
                        }
                        <!-- VOICE VIDEO GRID -->
                        @if (showVideoGrid)
                        {
                            <div class="flex-grow-1 d-flex flex-column voice-video-area" style="background: #1e1e1e; position: relative; min-height: 0; overflow: hidden;">
                                @{
                                    bool isConnectingStage = _selectedChannel?.IsVoiceChannel == true && VoiceService.IsConnecting;
                                    bool isDisconnectedVoiceChannel = _selectedChannel?.IsVoiceChannel == true && (!VoiceService.IsInVoiceCall || VoiceService.CurrentChannelId != _selectedChannel?.Id);
                                    var activeVoiceChannelId = !string.IsNullOrEmpty(VoiceService.CurrentChannelId) ? VoiceService.CurrentChannelId : _selectedChannel?.Id ?? string.Empty;
                                    var verifiedVoiceParticipants = !string.IsNullOrEmpty(activeVoiceChannelId)
                                        ? VoiceState.GetVoiceParticipants(activeVoiceChannelId).ToHashSet(StringComparer.Ordinal)
                                        : new HashSet<string>(StringComparer.Ordinal);
                                    var ringingCallee = (!isConnectingStage && !isDisconnectedVoiceChannel)
                                        ? GetRingingCalleeEmployee(verifiedVoiceParticipants)
                                        : null;
                                    var stagePresentation = VoiceUiState.ComputeStagePresentationState(verifiedVoiceParticipants, ringingCallee?.Id);
                                    var focusedParticipantId = stagePresentation.FocusedParticipantId;
                                    bool isFaceTimeLayoutGlobal = !isConnectingStage && !isDisconnectedVoiceChannel && !VoiceUiState.IsOsPipActive && stagePresentation.IsFaceTimeLayout;
                                    bool isGridFocusedGlobal = !isConnectingStage && !isDisconnectedVoiceChannel && !VoiceUiState.IsOsPipActive && !isFaceTimeLayoutGlobal && !string.IsNullOrEmpty(focusedParticipantId);
                                }
                                <div id="voice-video-container" class="voice-stage-grid flex-grow-1 @(isFaceTimeLayoutGlobal ? "is-facetime-layout" : (isGridFocusedGlobal ? "has-grid-focus" : ""))">
                                    @if (isConnectingStage)
                                    {
                                        <div class="d-flex flex-column align-center justify-center w-100 h-100" style="min-height: 300px;">
                                            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" Class="mb-4" />
                                            <MudText Typo="Typo.h6" Style="color: white;">@Loc["Connecting to voice..."]</MudText>
                                            <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.68);" Class="mt-1">@VoiceService.ConnectingStage.GetLocalizedStageText(Loc)</MudText>
                                        </div>
                                    }
                                    else if (isDisconnectedVoiceChannel)
                                    {
                                        <div class="d-flex flex-column align-center justify-center w-100 h-100" style="min-height: 300px;">
                                            <MudButton Variant="Variant.Filled" Color="Color.Success" Size="Size.Large" OnClick="JoinVoiceChannel"
                                                       Disabled="@(_currentUser?.IsActiveUnsuspended != true)"
                                                       StartIcon="@Icons.Material.Filled.Call">
                                                @Loc["Connect to Voice"]
                                            </MudButton>
                                        </div>
                                    }
                                    else
                                    {
                                        @if (VoiceUiState.IsOsPipActive)
                                        {
                                            <div class="d-flex flex-column align-center justify-center w-100 h-100 pa-6 text-center" style="min-height: 300px; max-width: 420px;">
                                                <MudAvatar Style="width: 64px; height: 64px; background: rgba(255,255,255,0.08); color: rgba(255,255,255,0.85);" Class="mb-4">
                                                    <MudIcon Icon="@Icons.Material.Filled.PictureInPictureAlt" Size="Size.Large" />
                                                </MudAvatar>
                                                <MudText Typo="Typo.h6" Style="color: white; font-weight: 600;" Class="mb-1">
                                                    @Loc["Call is in Picture in Picture"]
                                                </MudText>
                                                <MudText Typo="Typo.body2" Style="color: rgba(255,255,255,0.65);" Class="mb-5">
                                                    @Loc["Video playback is active in the floating window."]
                                                </MudText>
                                                <MudButton Variant="Variant.Outlined"
                                                           Color="Color.Primary"
                                                           StartIcon="@Icons.Material.Filled.CallReceived"
                                                           OnClick="@(() => VoiceUiState.ToggleOsPipAsync())">
                                                    @Loc["Bring back to stage"]
                                                </MudButton>
                                            </div>
                                        }

                                        var channelRoomEnrollments = _selectedChannel != null
                                            ? PhysicalRoomService.GetParticipantRoomMap(_selectedChannel.Id)
                                            : new Dictionary<string, (PhysicalVoiceRoom Room, PhysicalRoomDeviceEnrollment Enrollment)>();
                                        string? viewerPhysicalRoomId = !string.IsNullOrEmpty(VoiceService.CurrentUserId) &&
                                                                       channelRoomEnrollments.TryGetValue(VoiceService.CurrentUserId, out var viewerRoomEntry)
                                            ? viewerRoomEntry.Room?.Id
                                            : null;
                                        bool canManageAllPhysicalRooms = PhysicalRoomService.CanUserManagePhysicalRooms(VoiceService.CurrentUserId);

                                        foreach (var pId in VoiceService.CallParticipants)
                                        {
                                            if (pId != VoiceService.CurrentUserId && !verifiedVoiceParticipants.Contains(pId)) continue;
                                            var emp = GetVoiceParticipantEmployee(pId);
                                            if (emp == null) continue;
                                            bool isSelf = pId == VoiceService.CurrentUserId;
                                            bool isMuted = VoiceService.IsParticipantMuted(pId);
                                            bool isFocused = focusedParticipantId == pId;
                                            bool isFullscreenStage = !isSelf && VoiceUiState.FullscreenParticipantId == pId;
                                            bool hasActiveRemoteStream = !isSelf && (VoiceService.ActiveScreenShareParticipants.Contains(pId) || VoiceService.ActiveCameraParticipants.Contains(pId));
                                            channelRoomEnrollments.TryGetValue(pId, out var physicalRoomEntry);

                                            string focusLayoutClass = isFaceTimeLayoutGlobal
                                                ? (isFocused ? "is-facetime-focused" : "is-facetime-corner")
                                                : (focusedParticipantId == null
                                                    ? ""
                                                    : (isFocused ? "is-grid-focused" : "is-grid-unfocused"));

                                            bool showPhysicalRoomBadge = physicalRoomEntry.Room != null && (
                                                isSelf ||
                                                canManageAllPhysicalRooms ||
                                                (!string.IsNullOrEmpty(viewerPhysicalRoomId) &&
                                                 string.Equals(viewerPhysicalRoomId, physicalRoomEntry.Room.Id, StringComparison.Ordinal)) ||
                                                (_currentUser != null &&
                                                 PrivacyService.CanDiscoverUser(_currentUser, emp) &&
                                                 PhysicalRoomService.CanUserDiscoverPhysicalRoom(physicalRoomEntry.Room, _currentUser)));

                                            <MudPaper Elevation="4" @key="pId"
                                                      id="@($"participant-rect-{pId}")"
                                                      data-voice-speaker-channel="@_selectedChannel?.Id"
                                                      data-voice-speaker-user="@pId"
                                                      data-voice-muted="@(isMuted ? "true" : null)"
                                                      @onclick="@(() => OnParticipantTileClickedAsync(pId, isFullscreenStage))"
                                                      Class="@($"participant-rect {focusLayoutClass} {(isFullscreenStage ? "is-fullscreen-stage" : "")} {(isFullscreenStage && _fullscreenRotationDeg == 90 ? "is-rotated-90" : "")} {(VoiceUiState.IsOsPipActive ? "d-none" : "")}")">
                                                
                                                <div class="participant-large-avatar">
                                                     <div class="participant-avatar-wrap">
                                                         <EmployeeAvatar Employee="@emp" Class="participant-tile-avatar" />
                                                         @if (isMuted)
                                                         {
                                                             <div class="participant-mute-badge">
                                                                 <MudIcon Icon="@Icons.Material.Filled.MicOff" Class="participant-mute-badge-icon" />
                                                             </div>
                                                         }
                                                     </div>
                                                     <div class="participant-name-row">
                                                         <MudText Typo="@(isFocused ? Typo.h6 : Typo.subtitle2)" Class="participant-name-text">@emp.FullName</MudText>
                                                         @if (pId != VoiceService.CurrentUserId && VoiceService.RemoteScreenAudioParticipants.Contains(pId))
                                                         {
                                                             var isScreenAudioMuted = VoiceService.MutedRemoteScreenAudioParticipants.Contains(pId);
                                                             var streamAudioTitle = isScreenAudioMuted ? Loc["Unmute Stream Audio"].Value : Loc["Mute Stream Audio"].Value;
                                                             <span @onclick:stopPropagation="true" style="display: inline-flex; flex-shrink: 0;">
                                                                 <MudIconButton Icon="@(isScreenAudioMuted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                                                                                Color="@(isScreenAudioMuted ? Color.Error : Color.Inherit)"
                                                                                Size="Size.Small"
                                                                                Style="padding: 2px; color: white;"
                                                                                title="@streamAudioTitle"
                                                                                aria-label="@streamAudioTitle"
                                                                                OnClick="@(() => VoiceService.ToggleRemoteScreenAudioMuteAsync(pId))" />
                                                             </span>
                                                         }
                                                     </div>
                                                </div>

                                                @if (showPhysicalRoomBadge)
                                                {
                                                    <div class="participant-room-chip" title="@physicalRoomEntry.Room!.Name">
                                                        <MudIcon Icon="@Icons.Material.Filled.MeetingRoom" Class="participant-room-chip-icon" />
                                                        <span class="participant-room-chip-label">@physicalRoomEntry.Room!.Name</span>
                                                    </div>
                                                }

                                                <ParticipantVideoSlot ParticipantId="@pId" />
                                                
                                                <div class="participant-small-overlay">
                                                    <div class="participant-overlay-avatar-wrap">
                                                        <EmployeeAvatar Employee="@emp" Size="Size.Small" Class="participant-overlay-avatar" />
                                                        @if (isMuted)
                                                        {
                                                            <div class="participant-overlay-mute-badge">
                                                                <MudIcon Icon="@Icons.Material.Filled.MicOff" Color="Color.Error" Class="participant-overlay-mute-icon" />
                                                            </div>
                                                        }
                                                    </div>
                                                    <MudText Typo="Typo.caption" Class="participant-overlay-name">@emp.FullName</MudText>
                                                    @if (pId != VoiceService.CurrentUserId && VoiceService.RemoteScreenAudioParticipants.Contains(pId))
                                                    {
                                                        var isScreenAudioMuted = VoiceService.MutedRemoteScreenAudioParticipants.Contains(pId);
                                                        var streamAudioTitle = isScreenAudioMuted ? Loc["Unmute Stream Audio"].Value : Loc["Mute Stream Audio"].Value;
                                                        <span @onclick:stopPropagation="true" style="display: inline-flex; flex-shrink: 0;">
                                                            <MudIconButton Icon="@(isScreenAudioMuted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                                                                           Color="@(isScreenAudioMuted ? Color.Error : Color.Inherit)"
                                                                           Size="Size.Small"
                                                                           Style="padding: 2px; color: white;"
                                                                           title="@streamAudioTitle"
                                                                           aria-label="@streamAudioTitle"
                                                                           OnClick="@(() => VoiceService.ToggleRemoteScreenAudioMuteAsync(pId))" />
                                                        </span>
                                                    }
                                                </div>

                                                @if (!isSelf)
                                                {
                                                    <button type="button"
                                                            class="participant-fullscreen-btn @(hasActiveRemoteStream ? "has-active-stream" : "")"
                                                            title="@Loc["Fullscreen"]"
                                                            aria-label="@Loc["Fullscreen"]"
                                                            @onclick:stopPropagation="true"
                                                            @onclick="@(() => EnterParticipantFullscreenAsync(pId))">
                                                        <MudIcon Icon="@Icons.Material.Filled.Fullscreen" Size="Size.Small" Style="color: white;" />
                                                    </button>
                                                }

                                                @if (isFullscreenStage)
                                                {
                                                    <div class="participant-fullscreen-hud @(_isFullscreenHudHidden ? "is-hud-hidden" : "")"
                                                         @onclick:stopPropagation="true">
                                                        <div class="participant-fullscreen-hud-pill">
                                                            <div style="position: relative; display: inline-flex;">
                                                                <EmployeeAvatar Employee="@emp" Style="height: 26px; width: 26px;" />
                                                                @if (isMuted)
                                                                {
                                                                    <div style="position: absolute; bottom: -2px; right: -2px; background: rgba(0,0,0,0.85); border-radius: 50%; padding: 1px; display: flex; align-items: center; justify-content: center;">
                                                                        <MudIcon Icon="@Icons.Material.Filled.MicOff" Color="Color.Error" Style="font-size: 10px;" />
                                                                    </div>
                                                                }
                                                            </div>
                                                            <MudText Typo="Typo.caption" Style="color: white; font-weight: 700;">@emp.FullName</MudText>
                                                            @if (VoiceService.RemoteScreenAudioParticipants.Contains(pId))
                                                            {
                                                                var isScreenAudioMuted = VoiceService.MutedRemoteScreenAudioParticipants.Contains(pId);
                                                                <MudIconButton Icon="@(isScreenAudioMuted ? Icons.Material.Filled.VolumeOff : Icons.Material.Filled.VolumeUp)"
                                                                               Color="@(isScreenAudioMuted ? Color.Error : Color.Inherit)"
                                                                               Size="Size.Small"
                                                                               Style="padding: 4px; color: white;"
                                                                               title="@(isScreenAudioMuted ? Loc["Unmute Stream Audio"] : Loc["Mute Stream Audio"])"
                                                                               OnClick="@(() => VoiceService.ToggleRemoteScreenAudioMuteAsync(pId))" />
                                                            }
                                                        </div>

                                                        <div class="participant-fullscreen-hud-actions">
                                                            @if (_fullscreenZoomPercent > 100)
                                                            {
                                                                <MudButton Variant="Variant.Text"
                                                                           Size="Size.Small"
                                                                           StartIcon="@Icons.Material.Filled.RestartAlt"
                                                                           OnClick="ResetParticipantFullscreenZoomAsync"
                                                                           Style="color: white; font-weight: 600; min-width: 0; padding: 2px 8px; font-size: 0.78rem;">
                                                                    @($"{_fullscreenZoomPercent}%")
                                                                </MudButton>
                                                            }
                                                            <MudIconButton Icon="@Icons.Material.Filled.ScreenRotation"
                                                                           Color="@(_fullscreenRotationDeg == 90 ? Color.Primary : Color.Inherit)"
                                                                           Size="Size.Small"
                                                                           Style="padding: 6px; color: white;"
                                                                           title="@Loc["Rotate 90°"]"
                                                                           aria-label="@Loc["Rotate 90°"]"
                                                                           OnClick="ToggleParticipantFullscreenRotationAsync" />
                                                            <MudIconButton Icon="@Icons.Material.Filled.FullscreenExit"
                                                                           Color="Color.Inherit"
                                                                           Size="Size.Small"
                                                                           Style="padding: 6px; color: white;"
                                                                           title="@Loc["Exit fullscreen"]"
                                                                           aria-label="@Loc["Exit fullscreen"]"
                                                                           OnClick="@(() => ExitParticipantFullscreenAsync(true))" />
                                                        </div>
                                                    </div>
                                                }


                                            </MudPaper>
                                        }

                                        if (ringingCallee != null)
                                        {
                                            bool isRingingFocused = focusedParticipantId == ringingCallee.Id;
                                            string ringingLayoutClass = isFaceTimeLayoutGlobal
                                                ? (isRingingFocused ? "is-facetime-focused" : "is-facetime-corner")
                                                : (focusedParticipantId != null ? "is-grid-unfocused" : "");
                                            <MudPaper Elevation="4" @key="@($"ringing-{ringingCallee.Id}")"
                                                      id="@($"participant-rect-{ringingCallee.Id}")"
                                                      Class="@($"participant-rect is-ringing {ringingLayoutClass} {(VoiceUiState.IsOsPipActive ? "d-none" : "")}")">
                                                <div class="participant-large-avatar">
                                                    <div class="participant-avatar-wrap ringing-avatar-wrapper">
                                                        <EmployeeAvatar Employee="@ringingCallee" Class="participant-tile-avatar" />
                                                        <div class="ringing-phone-badge">
                                                            <MudIcon Icon="@Icons.Material.Filled.RingVolume" Class="ringing-phone-badge-icon" />
                                                        </div>
                                                    </div>
                                                    <div class="participant-name-row">
                                                        <MudText Typo="@(isRingingFocused ? Typo.h6 : Typo.subtitle2)" Class="participant-name-text">@ringingCallee.FullName</MudText>
                                                    </div>
                                                    <div class="ringing-status-pill">
                                                        <span>@Loc["Ringing..."]</span>
                                                    </div>
                                                </div>
                                            </MudPaper>
                                        }
                                    }
                                </div>

                                <div class="d-flex align-center gap-2 voice-stage-fab-actions">
                                    @if (VoiceService.IsInVoiceCall && VoiceService.CurrentChannelId == _selectedChannel?.Id && !CircuitContext.IsCapacitorApp && !CircuitContext.IsMobile && !VoiceService.IsNativePlatform)
                                    {
                                        var pipLabel = VoiceUiState.IsOsPipActive ? Loc["Exit Picture in Picture"].Value : Loc["Picture in Picture"].Value;
                                        <MudFab Color="@(VoiceUiState.IsOsPipActive ? Color.Success : Color.Dark)"
                                                Size="Size.Small"
                                                StartIcon="@Icons.Material.Filled.PictureInPictureAlt"
                                                title="@pipLabel"
                                                aria-label="@pipLabel"
                                                OnClick="@(() => VoiceUiState.ToggleOsPipAsync())" />
                                    }
                                    @if (!_showSecondaryChat)
                                    {
                                        <MudFab Color="Color.Primary" StartIcon="@Icons.Material.Filled.Chat"
                                                OnClick="@(() => SetSecondaryChatVisible(true))" />
                                    }
                                </div>
                            </div>
                        }
                    
                        <div class="flex-column voice-chat-area @((showVideoGrid && !_showSecondaryChat) ? "d-none" : "d-flex")">
                            
                            @if (showVideoGrid && _showSecondaryChat)
                            {
                                <div class="pa-2 d-flex d-md-none justify-space-between align-center border-b" style="background: var(--mud-palette-surface);">
                                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" OnClick="@(() => SetSecondaryChatVisible(false))" />
                                    <MudText Typo="Typo.subtitle2">@Loc["Text Chat"]</MudText>
                                    <div style="width: 36px;"></div> <!-- Spacer -->
                                </div>
                                <div class="pa-2 d-none d-md-flex justify-space-between align-center border-b" style="background: var(--mud-palette-surface);">
                                    <MudText Typo="Typo.subtitle2">@Loc["Text Chat"]</MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="@(() => SetSecondaryChatVisible(false))" />
                                </div>
                            }

                            <!-- Messages Area -->
                        @if (_selectedChannel is { IsEncrypted: true } && (!ScopedKeystore.IsUnlocked || !_selectedChannel.HasAnyEpochKey(_currentUser?.Id ?? "")))
                        {
                            <VaultLockView Title="@Loc["Secure Channel"]"
                                           Description="@Loc["This channel uses channel Encryption. Enter your vault password to unlock your vault and read messages."]"
                                           ButtonText="@Loc["Unlock Channel"]"
                                           SetupText="@Loc["This channel is encrypted. You must set up your secure Chat Vault password before you can view these messages."]"
                                           IsNotOnAccessList="@(!_selectedChannel.HasAnyEpochKey(_currentUser?.Id ?? ""))"
                                           NotOnAccessListText="@Loc["This channel is encrypted and you are not on the access list to view its contents."]"
                                           IsCheckingKeystoreCookie="@_isCheckingKeystoreCookie"
                                           CheckingText="@Loc["Unlocking Secure Channel..."]"
                                           CurrentUser="@_currentUser"
                                           OnUnlocked="HandleVaultUnlockedInChat"
                                           OnSetupCompleted="HandleVaultUnlockedInChat" />
                        }
                        else
                        {
                            <div id="chat-messages-container" data-channel-id="@(_selectedChannel?.Id ?? "")" @key="@("chat-messages-" + (_selectedChannel?.Id ?? ""))" @ref="_messagesContainer" class="flex-grow-1 overflow-auto pa-4 d-flex flex-column" style="background: var(--mud-palette-background-grey); will-change: transform; min-height: 0; overflow-anchor: none; -webkit-overflow-scrolling: touch;">
                        
                        @if (_typingUsers.Any())
                        {
                            <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">
                                <em>@GetTypingText()</em>
                            </MudText>
                        }

                        @if (_isLoadingMessages)
                        {
                            <div class="d-flex justify-center pa-4">
                                <MudProgressCircular Indeterminate="true" />
                            </div>
                        }
                        else if (_messages.Count == 0)
                        {
                            <div class="d-flex flex-column align-center justify-center pa-4" style="height: 100%;">
                                <MudIcon Icon="@Icons.Material.Filled.ChatBubbleOutline" Size="Size.Large" Color="Color.Surface" Style="font-size: 64px; opacity: 0.5;" />
                                <MudText Typo="Typo.h6" Color="Color.Surface" Class="mt-2" Style="opacity: 0.7;">@Loc["No messages yet"]</MudText>
                                <MudText Typo="Typo.body2" Color="Color.Surface" Style="opacity: 0.7;">@Loc["Be the first to say hello!"]</MudText>
                            </div>
                        }
                        else
                        {
                                var sorted = _sortedMessages;
                                var desktopQuickReactEmojis = GetDesktopQuickReactEmojis();
                                for (int i = 0; i < sorted.Count; i++)
                                {
                                    var message = sorted[i];
                                    var nextOlderMessage = (i + 1 < sorted.Count) ? sorted[i + 1] : null;

                                    // Grouping: same sender within 5 minutes
                                    // Reset grouping if this message is a reply (show full header for replies)
                                    var isGrouped = nextOlderMessage != null
                                        && nextOlderMessage.SenderId == message.SenderId
                                        && (message.SentAt - nextOlderMessage.SentAt).TotalMinutes <= 5
                                        && message.SentAt.ToLocalTime().Date == nextOlderMessage.SentAt.ToLocalTime().Date
                                        && string.IsNullOrEmpty(message.ReplyToId);

                                    var replyToMsg = !string.IsNullOrEmpty(message.ReplyToId) 
                                        ? _messages.FirstOrDefault(m => m.Id == message.ReplyToId) : null;

                                     var decContent = _decryptedContents.GetValueOrDefault(message.Id);

                                     <MessageBubble @key="@message.Id"
                                                   Message="@message"
                                                   DataVersionHash="@ComputeMessageDataVersionHash(message, decContent)"
                                                   DecryptedContents="_decryptedContents"
                                                   Sender="@GetEmployee(message.SenderId)"
                                                   IsOwnMessage="@(message.SenderId == (_currentUser?.Id))"
                                                   IsGrouped="@isGrouped"
                                                   CurrentUserId="@_currentUser?.Id"
                                                   SessionId="@_sessionId"
                                                   Employees="_discoverableEmployees"
                                                   Teams="_channelTeams"
                                                   ReplyToMessage="replyToMsg"
                                                   ReplyToSender="@(replyToMsg != null ? GetEmployee(replyToMsg.SenderId) : null)"
                                                   IsEditing="@(_editingMessageId == message.Id)"
                                                   OnEdit="EditMessage"
                                                   OnSaveEdit="SaveEditMessage"
                                                   OnCancelEdit="CancelEditMessage"
                                                   OnDelete="DeleteMessage"
                                                   OnReply="StartReply"
                                                   OnViewReactions="OpenReactionsDialog"
                                                   OnViewReadReceipts="OpenReadReceiptsDialog"
                                                   OnScrollToMessage="ScrollToMessage"
                                                   OnReact="AddReaction"
                                                   OnOpenLightbox="@(OpenLightbox)"
                                                   OnJoinCall="JoinCallFromInvite"
                                                   OnDeclineCall="DeclineCallInvite"
                                                   OnAvatarClicked="OpenMemberProfile"
                                                   OnBlockUser="BlockUserForMessage"
                                                   OnReportMessage="ReportMessageAsync"
                                                   OnDownloadMedia="DownloadMedia"
                                                   OnShareMedia="ShareAttachment"
                                                   CanCreateAlbum="@(_currentUser is { IsActive: true, IsSuspended: false, IsBanned: false } && _currentUser.HasPermission(AppPermissions.Albums.View) && _selectedChannel is { IsArchived: false } && ChatAuth.CanUserPostToChannel(_selectedChannel, _currentUser))"
                                                   OnCreateAlbumFromMessage="CreateAlbumFromMessage"
                                                   ReadReceiptUserIds="@(!PrivacyService.ShouldHideMemberList(_selectedChannel, _currentUser) && _latestReadReceipts.TryGetValue(message.Id, out var readers) ? readers : _emptyReaders)"
                                                   CumulativeReadReceiptUserIds="@(!PrivacyService.ShouldHideMemberList(_selectedChannel, _currentUser) && _cumulativeReadReceipts.TryGetValue(message.Id, out var cumulativeReaders) ? cumulativeReaders : _emptyReaders)"
                                                   ChannelKey="@GetDecryptedKeyForMessage(message)"
                                                   CanReact="@(PrivacyService.CanReactInChannel(_selectedChannel, _currentUser))"
                                                   AnonymizeReactions="@(PrivacyService.ShouldAnonymizeReactions(_selectedChannel, _currentUser))"
                                                   ChannelEmployees="_channelEmployees"
                                                   HideReadReceipts="@(PrivacyService.ShouldHideMemberList(_selectedChannel, _currentUser))"
                                                   IsMobile="@CircuitContext.IsMobileLayout"
                                                   MessageIndex="@i"
                                                   ShowEmojiPicker="@(_activeEmojiPickerMessageId == message.Id)"
                                                   ShowMoreMenu="@(_activeMoreMenuMessageId == message.Id)"
                                                   IsActionSheetTarget="@(_actionSheetMessage?.Id == message.Id)"
                                                   OnCloseActionPopups="CloseDesktopMessagePopups"
                                                   QuickReactEmojis="desktopQuickReactEmojis" />

                                    // Date separator: insert when the date changes
                                    // Rendered AFTER the message in DOM, meaning it sits visually ABOVE the message
                                    if (nextOlderMessage == null || message.SentAt.ToLocalTime().Date != nextOlderMessage.SentAt.ToLocalTime().Date)
                                    {
                                        <DateSeparator @key="@($"date-{message.SentAt.ToLocalTime().Date:yyyyMMdd}")" Date="message.SentAt" />
                                    }
                                 }
                                 
                            @* Load older messages sentinel (now at the bottom of DOM = visual top) *@
                            @if (_hasMoreMessages)
                            {
                                <div id="chat-top-sentinel" @key="@("chat-top-sentinel")" @ref="_topSentinel" style="height: 1px; width: 100%;"></div>
                                
                                @if (_isLoadingOlder)
                                {
                                    <div class="d-flex justify-center my-2">
                                        <MudProgressCircular Size="Size.Small" Indeterminate="true" />
                                    </div>
                                }
                            }
                        }
                            </div>

                            <ChatScrollToBottomButton Visible="_isScrolledUp" OnClick="ScrollToBottom" />
                        }
                    
                            <!-- Message Composer -->
                            <ChatComposer @ref="_composer"
                                          ChannelId="@ChannelId"
                                          CurrentUserId="@_currentUser?.Id"
                                          IsMobile="@CircuitContext.IsMobileLayout"
                                          IsArchived="@(_selectedChannel?.IsArchived == true)"
                                          IsAnnouncementOnly="@(_selectedChannel?.IsAnnouncementOnly == true)"
                                          CanPost="@CanCurrentUserPostToChannel()"
                                          Employees="_channelEmployees"
                                          Teams="_channelTeams"
                                          ReplyingTo="_replyingTo"
                                          DecryptedReplyContent="@(_replyingTo != null ? _decryptedContents.GetValueOrDefault(_replyingTo.Id) : null)"
                                          ReplyToSenderName="@(_replyingTo != null ? GetEmployee(_replyingTo.SenderId)?.FullName : null)"
                                          OnSendMessage="HandleSendMessage"
                                          OnCancelReply="CancelReply"
                                          Disabled="@((_selectedChannel?.IsEncrypted == true && (!ScopedKeystore.IsUnlocked || string.IsNullOrEmpty(_decryptedChannelKey))) || _currentUser?.IsSuspended == true)"
                                          OnEditLastMessage="HandleEditLastMessage"
                                          ChannelKey="@_decryptedChannelKey"
                                          ChannelDisplayName="@(_selectedChannel != null ? GetChannelDisplayName(_selectedChannel) : null)"
                                          UploadUrl="@GetUploadUrl()"
                                          PreloadedJsModuleTask="@_composerModuleLoadTask" />
                        </div> @* Close flex-column wrapping text chat *@
                    </div> @* Close d-flex flex-grow-1 row container *@
                }
                else
                {
                    <div class="d-flex flex-column align-center justify-center flex-grow-1" style="height: 100%; background: var(--mud-palette-background-grey);">
                        @if (_channelNotFound)
                        {
                            <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Surface" Style="font-size: 80px; opacity: 0.3;" />
                            <MudText Typo="Typo.h5" Color="Color.Surface" Class="mt-4" Style="opacity: 0.5;">@Loc["Channel Not Found"]</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Surface" Class="mt-1" Style="opacity: 0.5;">@Loc["This channel does not exist or you do not have permission to view it."]</MudText>
                        }
                        else
                        {
                            <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Large" Color="Color.Surface" Style="font-size: 80px; opacity: 0.3;" />
                            <MudText Typo="Typo.h5" Color="Color.Surface" Class="mt-4" Style="opacity: 0.5;">@Loc["Select a Channel"]</MudText>
                            <MudText Typo="Typo.body1" Color="Color.Surface" Class="mt-1" Style="opacity: 0.5;">@Loc["Choose a channel from the sidebar to start chatting."]</MudText>
                        }
                    </div>
                }
                </div> @* Close chat-drop-zone div *@

                @* Channel Info Panel *@
                @if (_showInfoPanel && _selectedChannel != null)
                {
                    <div style="width: 300px; flex-shrink: 0; height: 100%; overflow-y: auto;">
                        <ChannelInfoPanel Channel="_selectedChannel"
                                         DisplayName="@GetChannelDisplayName(_selectedChannel)"
                                         Employees="_discoverableEmployees"
                                         CurrentUserId="@_currentUser?.Id"
                                         OnClose="ToggleInfoPanel"
                                         OnPinnedMessageClicked="ScrollToMessage"
                                         OnChannelUpdated="HandleChannelUpdated"
                                         OnLeaveGroup="HandleLeaveGroup"
                                         OnArchiveChannel="HandleArchiveChannel"
                                         OnDeleteChannel="HandleDeleteChannel"
                                         OnRemoveMember="HandleRemoveMember"
                                         NotificationLevel="@_notificationLevel"
                                         OnNotificationLevelChanged="HandleNotificationLevelChanged"
                                         DecryptedContents="_decryptedContents" />
                    </div>
                }
            </div> @* Close flex row *@
            }
        </MudItem>
    </MudGrid>

@* ═══════════════════════════════════════════════════════════════
   MOBILE ACTION SHEET — shown on long-press of a message
   ═══════════════════════════════════════════════════════════════ *@
@if (CircuitContext.IsMobileLayout || _actionSheetMessage != null)
{
<MobileActionSheet IsOpen="@(_actionSheetMessage != null)" OnClose="CloseActionSheet">
    @* Quick-react emoji row *@
    <div class="action-sheet-emoji-row">
        @{
            var recentReacts = (_currentUser?.RecentEmojis?.Any() == true) 
