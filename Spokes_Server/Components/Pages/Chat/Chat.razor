    /// <summary>
    /// Recompute the cached sorted message list. Call this whenever _messages is mutated.
    /// </summary>
    private void RecomputeSortedMessages()
    {
        _sortedMessages = _messages
            .DistinctBy(m => m.Id)
            .Where(m => _currentUser?.BlockedUserIds.Contains(m.SenderId) != true)
            .OrderByDescending(m => m.SentAt)
            .ToList();
