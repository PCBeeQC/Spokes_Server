            _objRef?.Dispose();
            
            if (_module != null)
            {
                 try { await _module.InvokeVoidAsync("dispose"); }
                 catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or InvalidOperationException) { }
                 catch (Exception ex) { Logger.LogDebug(ex, "Failed to invoke JS dispose"); }
                 await _module.DisposeAsync();
            }
        }
        catch (JSDisconnectedException)
        {
            // Expected when the circuit is lost
        }
        catch (TaskCanceledException)
        {
            // Also expected during disposal
        }
        catch (InvalidOperationException)
        {
            // Expected when prerendering
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error disposing Chat component: {Message}", ex.Message);
        }
        
        // Prune the cache to free up memory
        if (ChannelId != null)
        {
            Db.ChatMessages.EnforceGlobalCacheSizeLimit();
        }
        
        _channelCts?.Cancel();
        
        VoiceService.OnChange -= HandleVoiceStateChanged;
        CircuitContext.OnFocusChanged -= HandleFocusChanged;
        CircuitContext.OnDeviceTypeChanged -= HandleDeviceTypeChanged;
        Nav.LocationChanged -= HandleLocationChanged;
        UnsubscribeFromLocalEvents();
    }

