    [Inject] private Spokes_Server.Core.Services.Security.FileTokenService FileTokens { get; set; } = default!;

    [JSInvokable]
    public string GetUploadUrl()
    {
        if (string.IsNullOrEmpty(ChannelId))
            return "/spokesapi/files/chat";

        if (_selectedChannel?.IsEncrypted == true)
        {
            var channelKey = EnsureDecryptedChannelKey();
            if (!string.IsNullOrEmpty(channelKey) && _currentUser != null)
            {
                var token = FileTokens.GenerateAccessToken("chat", ChannelId, "*", channelKey, _currentUser.Id, CircuitContext.SessionId);
                return $"/spokesapi/files/chat/{ChannelId}?t={token}";
            }
            return $"/spokesapi/files/chat/{ChannelId}";
        }
        else if (_selectedChannel != null && _currentUser != null)
        {
            var token = FileTokens.GenerateAccessToken("chat", ChannelId, "*", null, _currentUser.Id, CircuitContext.SessionId);
            return $"/spokesapi/files/chat/{ChannelId}?t={token}";
        }
        return $"/spokesapi/files/chat/{ChannelId}";
    }

    private string GetTokenizedFileUrl(string filePath, string fileName)
    {
        if (string.IsNullOrEmpty(ChannelId) || _selectedChannel == null || !_selectedChannel.IsEncrypted)
            return filePath;
        var channelKey = EnsureDecryptedChannelKey();
        if (string.IsNullOrEmpty(channelKey))
            return filePath;
        var token = FileTokens.GenerateAccessToken("chat", ChannelId, filePath, channelKey, _currentUser?.Id, CircuitContext.SessionId);
        return filePath.Contains("?") ? $"{filePath}&t={token}" : $"{filePath}?t={token}";
    }

