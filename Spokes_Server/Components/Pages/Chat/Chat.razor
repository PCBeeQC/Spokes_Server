                @if (_actionSheetMessage.SenderId == _currentUser?.Id)
                {
                    <MudListItem OnClick="ActionSheetEdit" Icon="@Icons.Material.Filled.Edit">
                        <MudText Typo="Typo.body1" >@Loc["Edit"]</MudText>
                    </MudListItem>
                }
            </MudList>
        </MudPaper>

        @* Group 3: Moderation/Danger *@
        <MudPaper Elevation="0" Class="mb-4 overflow-hidden" Style="border-radius: 16px;">
                <MudList T="string" Dense="false" Padding="false" ReadOnly="false">
