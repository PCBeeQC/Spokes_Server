@code {
    private bool _suppressEventAutoRender;

    async Task IHandleEvent.HandleEventAsync(EventCallbackWorkItem item, object? arg)
    {
        _suppressEventAutoRender = false;
        var task = item.InvokeAsync(arg);
        if (!task.IsCompletedSuccessfully)
        {
            await task;
        }
        if (!_suppressEventAutoRender)
        {
            StateHasChanged();
        }
    }
    private bool _channelNotFound;

    [Parameter]
    public string? ChannelId { get; set; }

    private Employee? _currentUser;
    private List<ChatChannel> _channels = [];
    private List<Employee> _employees = [];
    private List<Team> _teams = [];
    private static readonly List<string> _emptyReaders = [];
    private ChatChannel? _selectedChannel;
    private List<ChatMessage> _messages = [];
    private bool _isLoadingMessages;
    private Dictionary<string, (string UserName, DateTime LastPing)> _typingUsers = [];

    private string GetTypingText()
    {
        var count = _typingUsers.Count;
        if (count == 0) return string.Empty;
        
        var users = _typingUsers.Values.Select(v => v.UserName).ToList();
        
        if (count == 1) return string.Format(Loc["{0} is typing..."].Value, users[0]);
        if (count == 2) return string.Format(Loc["{0} and {1} are typing..."].Value, users[0], users[1]);
        if (count == 3) return string.Format(Loc["{0}, {1}, and {2} are typing..."].Value, users[0], users[1], users[2]);
        
        return Loc["Several people are typing..."].Value;
    }
    
    private ChatComposer? _composer;
    private ElementReference _messagesContainer;
    private ElementReference _topSentinel;
    
    private const int InitialChannelMessageCount = 12;
    private const int ViewportFillBatchSize = 20;

    private Dictionary<string, string> _decryptedContents = [];
    private string? _decryptedChannelKey;
    private bool _isCheckingKeystoreCookie = true;

    private bool _hasMoreMessages;
    private Dictionary<string, List<string>> _latestReadReceipts = [];
    private Dictionary<string, List<string>> _cumulativeReadReceipts = [];
    private List<Team> _channelTeams = [];
    private bool _isLoadingOlder;
    private bool _isFillingViewport;
    private bool _isScrolledUp;
    private System.Timers.Timer? _typingCleanupTimer;

    // --- Render batch optimization fields ---
    private List<ChatMessage> _sortedMessages = [];
    private List<Employee> _discoverableEmployees = [];
    private List<Employee> _channelEmployees = [];
    private Dictionary<string, Employee> _employeeLookup = [];
    private Dictionary<string, Employee> _discoverableEmployeeLookup = [];
    private CancellationTokenSource? _channelCts;
    private string? _sessionId;
    private readonly Dictionary<string, string> _pushedShortcutSignatures = [];
    private readonly HashSet<string> _sentShortcutIconKeys = [];

    [JSInvokable]
    public void OnScrollPositionChanged(bool isScrolledUp)
    {
        if (_isScrolledUp != isScrolledUp)
        {
            _isScrolledUp = isScrolledUp;
            InvokeAsync(StateHasChanged);
        }
    }
    private bool _isDraggingFiles;
    private ChatMessage? _replyingTo;
    private string? _editingMessageId;
    
    private string _notificationLevel = "All";
    private bool _showInfoPanel;
    private bool _showSecondaryChat;
    
    // Voice Call state
    private bool _wasActiveVoiceStageVisible;
    private bool _wasVoiceStageRelevant;
    private bool _isSyncingVoiceStageVisibility;
    private bool _pendingVoiceTrackReattach;
    private int? _lastVoiceStageRenderFingerprint;
    private int _fullscreenZoomPercent = 100;
    private int _fullscreenRotationDeg = 0;
    private bool _isFullscreenHudHidden = false;

    private bool IsVoiceStageRelevantToCurrentChannel =>
        _selectedChannel != null &&
        (_selectedChannel.IsVoiceChannel ||
         string.Equals(_selectedChannel.Id, VoiceService.CurrentChannelId, StringComparison.Ordinal) ||
         string.Equals(_selectedChannel.Id, VoiceService.ConnectingChannelId, StringComparison.Ordinal));

    private void SyncVoiceStageVisibility()
    {
        bool isCurrentVoiceChannelSelected = !string.IsNullOrEmpty(VoiceService.CurrentChannelId)
            && _selectedChannel?.Id == VoiceService.CurrentChannelId
            && !(_showSecondaryChat && CircuitContext.IsMobileLayout);

        bool isActiveStage = VoiceService.IsInVoiceCall
            && !VoiceService.IsConnecting
            && isCurrentVoiceChannelSelected;

        if (!isActiveStage && !string.IsNullOrEmpty(VoiceUiState.FullscreenParticipantId))
        {
            _fullscreenZoomPercent = 100;
            _fullscreenRotationDeg = 0;
            _isFullscreenHudHidden = false;
            _ = VoiceUiState.ExitParticipantFullscreenAsync(goBack: false);
        }

        if (isActiveStage && !_wasActiveVoiceStageVisible)
        {
            _pendingVoiceTrackReattach = true;
        }
        _wasActiveVoiceStageVisible = isActiveStage;
        _isSyncingVoiceStageVisibility = true;
        try
        {
            VoiceUiState.SetCallStageVisible((VoiceService.IsInVoiceCall || VoiceService.IsConnecting) && isCurrentVoiceChannelSelected);
        }
        finally
        {
            _isSyncingVoiceStageVisibility = false;
        }
    }

    private void SetSecondaryChatVisible(bool visible)
    {
        _showSecondaryChat = visible;
        SyncVoiceStageVisibility();
    }

    private void HandleReturnToCallStageRequested()
    {
        _showSecondaryChat = false;
        SyncVoiceStageVisibility();
        _ = InvokeAsync(StateHasChanged);
    }


    // Desktop message action popups (single active instance across all visible bubbles)
    private string? _activeEmojiPickerMessageId;
    private string? _activeMoreMenuMessageId;
    private static readonly string[] _defaultDesktopQuickReactEmojis = ["👍", "❤️", "😂"];

    // Mobile action sheet state
    private ChatMessage? _actionSheetMessage;
    private static readonly string[] _quickReactEmojis = ["👍", "❤️", "😂", "😮", "😢", "🔥"];
    private bool _showMobileEmojiPicker;
    private bool _mobileEmojiPickerRegistered;
    
    // JS Interop reference
    private IJSObjectReference? _module;
    private Task<IJSObjectReference?>? _moduleLoadTask;
    private IJSObjectReference? _composerModule;
    private Task<IJSObjectReference?>? _composerModuleLoadTask;
    private DotNetObjectReference<Chat>? _objRef;
    private bool _isInitialized;
    
    // Composer reference
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    // DIAG-TEMP: instance tag to detect page remounts (live count is tracked per circuit in StartupTimings)
    private readonly string _diagTag = Guid.NewGuid().ToString("N")[..4];
    private readonly OptimisticRouteTransitionGuard _routeTransitionGuard = new();

    private void NavigateSelfToChatRoute(string relativeUrl, string? targetChannelId, bool replace = false)
    {
        var targetAbsoluteUri = Nav.ToAbsoluteUri(relativeUrl).AbsoluteUri;
        if (_routeTransitionGuard.TryBeginSelfNavigation(Nav.Uri, targetAbsoluteUri, targetChannelId))
        {
            Nav.NavigateTo(relativeUrl, replace: replace);
        }
    }

    public override Task SetParametersAsync(ParameterView parameters)
    {
        var previousChannelId = ChannelId;
        bool hasChannelIdParam = parameters.TryGetValue<string?>(nameof(ChannelId), out var incomingChannelId);
        if (!hasChannelIdParam)
        {
            incomingChannelId = null;
        }

        _routeTransitionGuard.SyncInitialUri(Nav.Uri);

        if (_isInitialized)
        {
            var currentUrlChannelId = MainLayout.ExtractChatChannelId(Nav.Uri);
            if (_routeTransitionGuard.ShouldIgnoreStaleUpdate(Nav.Uri, currentUrlChannelId, incomingChannelId))
            {
                StartupTimings.AddChatTransition(
                    $"Server: Chat[{_diagTag}] SetParametersAsync ignored superseded self-nav update (incoming={incomingChannelId ?? "null"}, target={_routeTransitionGuard.LatestTargetRouteKey ?? "null"}, selected={_selectedChannel?.Id ?? "null"})"); // DIAG-TEMP
                return Task.CompletedTask;
            }
        }

        parameters.SetParameterProperties(this);
        if (!hasChannelIdParam)
        {
            ChannelId = null;
        }
        StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] SetParametersAsync (incoming ChannelId={incomingChannelId ?? "null"}, current={previousChannelId ?? "null"}, selected={_selectedChannel?.Id ?? "null"})"); // DIAG-TEMP

        // Short-circuit router OnLocationChanged echo when SelectChannelInternal or GoBack
        // already applied the channel transition and rendered Pass 1.
        if (_isInitialized &&
            !_channelNotFound &&
            string.Equals(ChannelId, _selectedChannel?.Id, StringComparison.Ordinal))
        {
            return Task.CompletedTask;
        }

        return base.SetParametersAsync(ParameterView.Empty);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            StartupTimings.Add("Server: Chat OnInitializedAsync Start");
            StartupTimings.RegisterPendingRouteGate("Chat");
            StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] OnInitializedAsync (live={Interlocked.Increment(ref StartupTimings.ChatLiveInstances)})"); // DIAG-TEMP
            var sw = System.Diagnostics.Stopwatch.StartNew();

            // Synchronous fast-path: resolve identity directly from HttpContext before any async yield
            if (HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true)
            {
                _currentUser = UserService.GetEmployee(HttpContextAccessor.HttpContext.User);
                _sessionId = HttpContextAccessor.HttpContext.User.FindFirst("SessionId")?.Value;
            }

            if (_currentUser == null)
            {
                _currentUser = await UserService.GetEmployeeAsync();
            }
            StartupTimings.Add($"Server: Chat GetEmployee Done (+{sw.ElapsedMilliseconds}ms)");
            sw.Restart();

            if (string.IsNullOrEmpty(_sessionId))
            {
                _sessionId = await UserService.GetSessionIdAsync();
            }
            _employees = Db.Employees.GetAll();
            _employeeLookup = _employees.ToDictionary(e => e.Id, e => e);
            RecomputeDiscoverableEmployees();
            _teams = Db.Teams.GetAll();
            StartupTimings.Add($"Server: Chat Load DB Entities Done (+{sw.ElapsedMilliseconds}ms)");
            sw.Restart();

            LoadChannels();
            StartupTimings.Add($"Server: Chat LoadChannels Done ({_channels.Count} channels) (+{sw.ElapsedMilliseconds}ms)");
            sw.Restart();

            SubscribeToLocalEvents();

            // Server-side vault unlock: read the HttpOnly cookie directly from HttpContext
            // before the circuit switches to WebSocket (after which HttpContext becomes null).
            // This is more reliable than a JS fetch round-trip and avoids timing issues.
            if (_currentUser is { IsActiveUnsuspended: true } && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey) && !ScopedKeystore.IsUnlocked)
            {
                try
                {
                    ScopedKeystore.TryInitializeFromVaultCookie(
                        HttpContextAccessor.HttpContext, _currentUser.Id, _currentUser.EncryptedPrivateKey);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[Chat] Failed to initialize Keystore from vault cookie");
                }
            }
            _isCheckingKeystoreCookie = _currentUser is { IsActiveUnsuspended: true }
                && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey)
                && !ScopedKeystore.IsUnlocked;
            
            VoiceService.OnChange += HandleVoiceServiceChanged;
            VoiceState.PhysicalRoomsChanged += HandlePhysicalRoomsChanged;
            CircuitContext.OnFocusChanged += HandleFocusChanged;
            CircuitContext.OnDeviceTypeChanged += HandleDeviceTypeChanged;
            Nav.LocationChanged += HandleLocationChanged;
            VoiceUiState.OnReturnToCallStageRequested += HandleReturnToCallStageRequested;
            VoiceUiState.OnPipStateChanged += HandleVoicePipStateChanged;

            if (!string.IsNullOrEmpty(ChannelId))
            {
                await SelectChannelInternal(ChannelId, updateUrl: false);
            }

            _typingCleanupTimer = new System.Timers.Timer(2000);
            _typingCleanupTimer.Elapsed += (s, ev) =>
            {
                var now = DateTime.UtcNow;
                var staleUsers = _typingUsers.Where(kvp => (now - kvp.Value.LastPing).TotalSeconds > 5).Select(kvp => kvp.Key).ToList();
                if (staleUsers.Any())
                {
                    InvokeAsync(() =>
                    {
                        foreach (var userId in staleUsers)
                        {
                            _typingUsers.Remove(userId);
                        }
                        StateHasChanged();
                    });
                }
            };
            _typingCleanupTimer.Start();
            _isInitialized = true;

            StartupTimings.Add($"Server: Chat OnInitializedAsync Done (+{sw.ElapsedMilliseconds}ms)");
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            Logger.LogError(ex, "Chat.razor OnInitializedAsync failed: {Message}", ex.Message);
        }
    }

    private bool IsConnectionActivelyViewed()
    {
        if (!CircuitContext.IsActivelyViewed) return false;
        if (!string.IsNullOrEmpty(CircuitContext.SubscriptionId))
        {
            return PresenceState.IsConnectionActivelyViewed(CircuitContext.SubscriptionId);
        }
        return true;
    }

    private void HandleFocusChanged()
    {
        if (IsConnectionActivelyViewed() && !string.IsNullOrEmpty(ChannelId))
        {
            _ = ConfirmChannelViewedAndReadAsync(ChannelId);
