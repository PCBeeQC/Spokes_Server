    private bool CanConvertMessageToAlbum(ChatMessage? message)
    {
        if (message == null || _currentUser == null || !_currentUser.IsActiveUnsuspended || _currentUser.IsBanned || message.SenderId != _currentUser.Id || message.IsDeleted)
            return false;
        if (_selectedChannel == null || _selectedChannel.IsArchived || !ChatAuth.CanUserPostToChannel(_selectedChannel, _currentUser))
            return false;
        if (!_currentUser.HasPermission(AppPermissions.Albums.View))
            return false;
        if (message.IsEncrypted && string.IsNullOrEmpty(GetDecryptedKeyForMessage(message) ?? _decryptedChannelKey))
            return false;
        if (message.MentionedAlbumIds != null && message.MentionedAlbumIds.Count > 0)
            return false;

        var imageCount = message.Attachments.Count(a =>
            FileHelper.IsImageFile(a.FileName) || a.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase));
        return imageCount >= AlbumService.AlbumSuggestionPhotoThreshold;
    }

