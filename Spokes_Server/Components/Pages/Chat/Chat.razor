@code {
    private bool _channelNotFound;

    [Parameter]
    public string? ChannelId { get; set; }

    private Employee? _currentUser;
    private List<ChatChannel> _channels = [];
    private List<Employee> _employees = [];
    private List<Team> _teams = [];
    private static readonly List<string> _emptyReaders = [];
    private ChatChannel? _selectedChannel;
    private List<ChatMessage> _messages = [];
    private bool _isLoadingMessages;
    private Dictionary<string, (string UserName, DateTime LastPing)> _typingUsers = [];

    private string GetTypingText()
    {
        var count = _typingUsers.Count;
        if (count == 0) return string.Empty;
        
        var users = _typingUsers.Values.Select(v => v.UserName).ToList();
        
        if (count == 1) return string.Format(Loc["{0} is typing..."].Value, users[0]);
        if (count == 2) return string.Format(Loc["{0} and {1} are typing..."].Value, users[0], users[1]);
        if (count == 3) return string.Format(Loc["{0}, {1}, and {2} are typing..."].Value, users[0], users[1], users[2]);
        
        return Loc["Several people are typing..."].Value;
    }
    
    private ChatComposer? _composer;
    private ElementReference _messagesContainer;
    private ElementReference _topSentinel;
    
    private Dictionary<string, string> _decryptedContents = [];
    private string? _decryptedChannelKey;
    private bool _isCheckingKeystoreCookie = true;

    private bool _hasMoreMessages;
    private Dictionary<string, List<string>> _latestReadReceipts = [];
    private Dictionary<string, List<string>> _cumulativeReadReceipts = [];
    private List<Team> _channelTeams = [];
    private bool _isLoadingOlder;
    private bool _isScrolledUp;
    private System.Timers.Timer? _typingCleanupTimer;

    // --- Render batch optimization fields ---
    private List<ChatMessage> _sortedMessages = [];
    private List<Employee> _channelEmployees = [];
    private Dictionary<string, Employee> _employeeLookup = [];
    private CancellationTokenSource? _channelCts;
    private string? _sessionId;

    [JSInvokable]
    public void OnScrollPositionChanged(bool isScrolledUp)
    {
        if (_isScrolledUp != isScrolledUp)
        {
            _isScrolledUp = isScrolledUp;
            InvokeAsync(StateHasChanged);
        }
    }
    private bool _isDraggingFiles;
    private ChatMessage? _replyingTo;
    private string? _editingMessageId;
    
    private string _notificationLevel = "All";
    private bool _showInfoPanel;
    private bool _showSecondaryChat;
    
    // Voice Call state
    private string? _focusedParticipantId;


    // Mobile action sheet state
    private ChatMessage? _actionSheetMessage;
    private static readonly string[] _quickReactEmojis = ["👍", "❤️", "😂", "😮", "😢", "🔥"];
    private bool _showMobileEmojiPicker;
    
    // JS Interop reference
    private IJSObjectReference? _module;
    private DotNetObjectReference<Chat>? _objRef;
    
    // Composer reference
    [Inject] private ISnackbar Snackbar { get; set; } = default!;

    // DIAG-TEMP: instance tag to detect page remounts (live count is tracked per circuit in StartupTimings)
    private readonly string _diagTag = Guid.NewGuid().ToString("N")[..4];

    public override Task SetParametersAsync(ParameterView parameters)
    {
        if (!parameters.TryGetValue<string?>(nameof(ChannelId), out var incomingChannelId))
        {
            ChannelId = null;
        }
        StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] SetParametersAsync (incoming ChannelId={incomingChannelId ?? "null"}, current={ChannelId ?? "null"})"); // DIAG-TEMP
        return base.SetParametersAsync(parameters);
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            StartupTimings.Add("Server: Chat OnInitializedAsync Start");
            StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] OnInitializedAsync (live={Interlocked.Increment(ref StartupTimings.ChatLiveInstances)})"); // DIAG-TEMP
            var sw = System.Diagnostics.Stopwatch.StartNew();

            // Synchronous fast-path: resolve identity directly from HttpContext before any async yield
            if (HttpContextAccessor.HttpContext?.User?.Identity?.IsAuthenticated == true)
            {
                _currentUser = UserService.GetEmployee(HttpContextAccessor.HttpContext.User);
                _sessionId = HttpContextAccessor.HttpContext.User.FindFirst("SessionId")?.Value;
            }

            if (_currentUser == null)
            {
                _currentUser = await UserService.GetEmployeeAsync();
            }
            StartupTimings.Add($"Server: Chat GetEmployee Done (+{sw.ElapsedMilliseconds}ms)");
            sw.Restart();

            if (string.IsNullOrEmpty(_sessionId))
            {
                _sessionId = await UserService.GetSessionIdAsync();
            }
            _employees = Db.Employees.GetAll();
            _employeeLookup = _employees.ToDictionary(e => e.Id, e => e);
            _teams = Db.Teams.GetAll();
            StartupTimings.Add($"Server: Chat Load DB Entities Done (+{sw.ElapsedMilliseconds}ms)");
            sw.Restart();

            LoadChannels();
            StartupTimings.Add($"Server: Chat LoadChannels Done ({_channels.Count} channels) (+{sw.ElapsedMilliseconds}ms)");
            sw.Restart();

            SubscribeToLocalEvents();

            // Server-side vault unlock: read the HttpOnly cookie directly from HttpContext
            // before the circuit switches to WebSocket (after which HttpContext becomes null).
            // This is more reliable than a JS fetch round-trip and avoids timing issues.
            if (_currentUser != null && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey) && !ScopedKeystore.IsUnlocked)
            {
                ScopedKeystore.TryInitializeFromVaultCookie(
                    HttpContextAccessor.HttpContext, _currentUser.Id, _currentUser.EncryptedPrivateKey);
            }
            if (ScopedKeystore.IsUnlocked)
            {
                _isCheckingKeystoreCookie = false;
            }
            
            VoiceService.OnChange += HandleVoiceStateChanged;
            CircuitContext.OnFocusChanged += HandleFocusChanged;
            CircuitContext.OnDeviceTypeChanged += HandleDeviceTypeChanged;
            Nav.LocationChanged += HandleLocationChanged;

            if (!string.IsNullOrEmpty(ChannelId))
            {
                await SelectChannelInternal(ChannelId, updateUrl: false);
            }

            _typingCleanupTimer = new System.Timers.Timer(2000);
            _typingCleanupTimer.Elapsed += (s, ev) =>
            {
                var now = DateTime.UtcNow;
                var staleUsers = _typingUsers.Where(kvp => (now - kvp.Value.LastPing).TotalSeconds > 5).Select(kvp => kvp.Key).ToList();
                if (staleUsers.Any())
                {
                    InvokeAsync(() =>
                    {
                        foreach (var userId in staleUsers)
                        {
                            _typingUsers.Remove(userId);
                        }
                        StateHasChanged();
                    });
                }
            };
            _typingCleanupTimer.Start();

            StartupTimings.Add($"Server: Chat OnInitializedAsync Done (+{sw.ElapsedMilliseconds}ms)");
        }
        catch (Exception ex) when (ex is not NavigationException)
        {
            Logger.LogError(ex, "Chat.razor OnInitializedAsync failed: {Message}", ex.Message);
        }
    }

    private bool IsConnectionActivelyViewed()
    {
        if (!CircuitContext.IsActivelyViewed) return false;
        if (!string.IsNullOrEmpty(CircuitContext.SubscriptionId))
        {
            return PresenceState.IsConnectionActivelyViewed(CircuitContext.SubscriptionId);
        }
        return true;
    }

    private void HandleFocusChanged()
    {
        if (IsConnectionActivelyViewed() && !string.IsNullOrEmpty(ChannelId))
        {
            _ = ConfirmChannelViewedAndReadAsync(ChannelId);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void HandleDeviceTypeChanged()
    {
        _ = InvokeAsync(StateHasChanged);
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        if (_selectedChannel != null && !MainLayout.IsChatChannelUrl(e.Location))
        {
            StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}].HandleLocationChanged Clearing channel (location={e.Location})");
            _channelCts?.Cancel();
            _previousChannelId = null;
            ChannelId = null;
            _selectedChannel = null;
            _channelNotFound = false;
            _messages.Clear();
            _sortedMessages.Clear();
            _shouldScrollToBottomAndInitObserver = false;
            CircuitContext.NotifyChatChannelOpenChanged(false);
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async Task ConfirmChannelViewedAndReadAsync(string? channelId)
    {
        if (string.IsNullOrEmpty(channelId) || !IsConnectionActivelyViewed())
            return;

        try
        {
            await ChatNotifications.MarkChannelAsReadAsync(channelId);
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "ConfirmChannelViewedAndRead error: {Message}", ex.Message);
        }
    }

    private readonly HashSet<string> _opportunisticKeySharedChannels = new();

    private void TryDecryptMessages()
    {
        if (_currentUser == null || _selectedChannel == null || !_selectedChannel.IsEncrypted) return;
        
        if (ScopedKeystore.IsUnlocked)
        {
            var privateKey = ScopedKeystore.GetPrivateKey();
            if (privateKey != null && _selectedChannel.EncryptedChannelKeys.TryGetValue(_currentUser.Id, out var cipherKey))
            {
                try
                {
                    var channelKey = Crypto.DecryptRsa(cipherKey, privateKey);
                    _decryptedChannelKey = channelKey;
                    
                    // Share the key with any newly setup/authorized users seamlessly in the background once per channel session
                    if (_opportunisticKeySharedChannels.Add(_selectedChannel.Id))
                    {
                        _ = ChatSecurityService.ShareKeyOpportunisticallyAsync(_selectedChannel.Id, channelKey);
                    }
                    
                    foreach (var msg in _messages.Where(m => m.IsEncrypted))
                    {
                        if (!_decryptedContents.ContainsKey(msg.Id))
                        {
                            try
                            {
                                _decryptedContents[msg.Id] = Crypto.DecryptAes(msg.Content, channelKey);
                            }
                            catch (Exception ex)
                            {
                                Logger.LogError(ex, "Failed to decrypt message {MessageId}: {Message}", msg.Id, ex.Message);
                                if (!string.IsNullOrEmpty(msg.Content) && !ChatSecurityService.IsPotentialBase64Cipher(msg.Content))
                                {
                                    _decryptedContents[msg.Id] = msg.Content;
                                }
                            }
                        }
                    }
                }
                catch (Exception ex)
                { 
                    Logger.LogError(ex, "Decrypting messages failed: {Message}", ex.Message);
                }
            }
        }
    }

    private string? EnsureDecryptedChannelKey()
    {
        if (string.IsNullOrEmpty(_decryptedChannelKey))
        {
            TryDecryptMessages();
        }
        return _decryptedChannelKey;
    }

    private void HandleVaultUnlockedInChat()
    {
        if (_currentUser != null)
        {
            _currentUser = Db.Employees.GetById(_currentUser.Id);
        }
        TryDecryptMessages();
        _shouldScrollToBottomAndInitObserver = true;
        StateHasChanged();
    }

    private async Task OpenMemberProfile(Employee? employee)
    {
        if (employee == null) return;
        var parameters = new DialogParameters { ["Employee"] = employee };
        var options = new DialogOptions { CloseButton = true, MaxWidth = MaxWidth.Small, FullWidth = true, CloseOnEscapeKey = true };
        var dialog = await DialogService.ShowAsync<MemberProfileDialog>(null, parameters, options);
        await dialog.Result;
        if (_currentUser != null)
        {
            var refreshed = Db.Employees.GetById(_currentUser.Id);
            if (refreshed != null && (refreshed.BlockedUserIds.Count != _currentUser.BlockedUserIds.Count || !refreshed.BlockedUserIds.SequenceEqual(_currentUser.BlockedUserIds)))
            {
                _currentUser.BlockedUserIds = refreshed.BlockedUserIds;
                if (_employeeLookup.TryGetValue(_currentUser.Id, out var currentEmp))
                {
                    currentEmp.BlockedUserIds = _currentUser.BlockedUserIds;
                }
                RecomputeSortedMessages();
                RecomputeLatestReadReceipts();
                StateHasChanged();
            }
        }
    }

    private bool _shouldScrollToBottomAndInitObserver = false;
    private bool _hasCompletedInitialRender = false;

    // ...

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartupTimings.Add("Server: Chat OnAfterRenderAsync Start");
            var diagTid = StartupTimings.CurrentTransitionId; // DIAG-TEMP
            using var diagFirstRenderSpan = StartupTimings.Span($"Server: Chat[{_diagTag}] FirstRender path", diagTid); // DIAG-TEMP
            bool wasChecking = _isCheckingKeystoreCookie;
            try
            {
                _objRef = DotNetObjectReference.Create(this);
                using (StartupTimings.Span($"Server: Chat[{_diagTag}] import Chat.razor.js", diagTid)) // DIAG-TEMP
                {
                    _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets.Bypassed("Components/Pages/Chat/Chat.razor.js")}");
                }

                if (_currentUser != null && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey))
                {
                    using (StartupTimings.Span($"Server: Chat[{_diagTag}] ScopedKeystore.InitializeFromDeviceCookieAsync", diagTid)) // DIAG-TEMP
                    {
                        await ScopedKeystore.InitializeFromDeviceCookieAsync(JS, _currentUser.Id, _currentUser.EncryptedPrivateKey);
                    }
                    if (ScopedKeystore.IsUnlocked)
                    {
                        // GlobalKeystore is unlocked inside InitializeFromDeviceCookieAsync
                        // when the device-stored password is successfully decrypted.
                        TryDecryptMessages();
                        StateHasChanged(); // Force re-render so components (like ChatComposer) get the populated UploadUrl!
                    }
                }

                // If the user is in an active voice call and navigated back to this channel,
                // re-attach all LiveKit tracks to the freshly created DOM containers.
                if (VoiceService.IsInVoiceCall)
                {
                    using (StartupTimings.Span($"Server: Chat[{_diagTag}] VoiceDeviceService.ReattachTracksAsync", diagTid)) // DIAG-TEMP
                    {
                        await VoiceDeviceService.ReattachTracksAsync();
                    }
                }

                // Note: We do NOT init scroll observer here yet. We let the block below handle it.
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Chat.razor OnAfterRenderAsync failed: {Message}", ex.Message);
            }
            finally
            {
                _isCheckingKeystoreCookie = false;
                _shouldScrollToBottomAndInitObserver = true;
            }

            // Since this might have unlocked the keystore in the background on mobile,
            // we must re-render so that child components (like ChatSidebar) update their
            // UI (e.g. replacing 'Locked message' with decrypted previews), and let the
            // next render pass initialize observers once #chat-messages-container is mounted.
            if (wasChecking)
            {
                StartupTimings.Mark($"Server: Chat[{_diagTag}] wasChecking -> StateHasChanged + return (observers deferred to next render)", diagTid); // DIAG-TEMP
                StateHasChanged();
                return;
            }
        }



        // Check if we need to scroll and/or init observer.
        // This runs on first render (if flag set by OnInitialized) AND on subsequent updates (when switching channels or loading).
        if (_shouldScrollToBottomAndInitObserver || (firstRender && _selectedChannel != null))
        {
            _shouldScrollToBottomAndInitObserver = false;
            var chainTid = StartupTimings.CurrentTransitionId; // DIAG-TEMP
            using var chainSpan = StartupTimings.Span($"Server: Chat[{_diagTag}] Scroll & Observers chain", chainTid); // DIAG-TEMP
            
            _isScrolledUp = false;
            if (_module != null && _objRef != null)
            {
                try
                {
                    var maxAllowedSize = Db.CompanyProfile.Get()?.MaxFileUploadSizeBytes ?? WebUiExtensions.DefaultMaxFileUploadSizeBytes;
                    bool attachScrollObserver = _hasMoreMessages && _messages.Count > 0;
                    await _module.InvokeVoidAsync("initChatChannelView", _messagesContainer, _topSentinel, _objRef, maxAllowedSize, attachScrollObserver);
                }
                catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException) { }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to init chat channel view: {Message}", ex.Message);
                }
            }
            else
            {
                await ScrollToBottom();
            }
            StartupTimings.Mark("Server: Chat JS Observers Init Done", chainTid); // DIAG-TEMP

            using (StartupTimings.Span($"Server: Chat[{_diagTag}] ConfirmChannelViewedAndReadAsync", chainTid)) // DIAG-TEMP
            {
                await ConfirmChannelViewedAndReadAsync(ChannelId);
            }
        }

        _hasCompletedInitialRender = true;
        StartupTimings.AddChatTransition($"Server: Chat[{_diagTag}] OnAfterRenderAsync End (firstRender={firstRender}, ChannelId={ChannelId ?? "null"}, selected={_selectedChannel?.Id ?? "null"})"); // DIAG-TEMP
    }

    // --- Event Subscriptions ---

    private void SubscribeToLocalEvents()
    {
        ChatState.MessageReceived += OnMessageReceived;
        ChatState.UserTyping += OnUserTyping;
        ChatState.UserStoppedTyping += OnUserStoppedTyping;
        ChatState.MessageEdited += OnMessageEdited;
        ChatState.MessageDeleted += OnMessageDeleted;
        ChatState.ReactionAdded += OnReactionAdded;
        ChatState.ReactionRemoved += OnReactionRemoved;
        ChatState.ChannelCreated += OnChannelCreated;
        ChatState.MessageRead += OnMessageRead;
        ChatState.EmployeeProfileUpdated += OnEmployeeProfileUpdated;
        ChatState.VoiceUserMutedChanged += OnVoiceUserMutedChanged;
        ScopedKeystore.OnUnlocked += HandleKeystoreUnlocked;
        ScopedKeystore.OnLocked += HandleKeystoreLocked;
    }

    private void UnsubscribeFromLocalEvents()
    {
        ChatState.MessageReceived -= OnMessageReceived;
        ChatState.UserTyping -= OnUserTyping;
        ChatState.UserStoppedTyping -= OnUserStoppedTyping;
        ChatState.MessageEdited -= OnMessageEdited;
        ChatState.MessageDeleted -= OnMessageDeleted;
        ChatState.ReactionAdded -= OnReactionAdded;
        ChatState.ReactionRemoved -= OnReactionRemoved;
        ChatState.ChannelCreated -= OnChannelCreated;
        ChatState.MessageRead -= OnMessageRead;
        ChatState.EmployeeProfileUpdated -= OnEmployeeProfileUpdated;
        ChatState.VoiceUserMutedChanged -= OnVoiceUserMutedChanged;
        ScopedKeystore.OnUnlocked -= HandleKeystoreUnlocked;
        ScopedKeystore.OnLocked -= HandleKeystoreLocked;
    }

    // --- Local Event Handlers ---

    private async void HandleKeystoreUnlocked()
    {
        try
        {
            await InvokeAsync(() =>
            {
                if (_currentUser == null) return;
                TryDecryptMessages();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private async void HandleKeystoreLocked()
    {
        try
        {
            await InvokeAsync(() =>
            {
                _decryptedChannelKey = null;
                _decryptedContents.Clear();
                StateHasChanged();
            });
        }
        catch (ObjectDisposedException) { }
    }

    private void OnVoiceUserMutedChanged(string channelId, string userId, bool isMuted)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnEmployeeProfileUpdated(Employee updatedEmployee)
    {
        InvokeAsync(() =>
        {
            var existingIndex = _employees.FindIndex(e => e.Id == updatedEmployee.Id);
            if (existingIndex >= 0)
            {
                // Create a new list reference so Blazor's parameter tracking sees the change
                var newEmployees = new List<Employee>(_employees);
                newEmployees[existingIndex] = updatedEmployee;
                _employees = newEmployees;
                
                _employeeLookup[updatedEmployee.Id] = updatedEmployee;
                
                if (_currentUser?.Id == updatedEmployee.Id)
                {
                    _currentUser = updatedEmployee;
                }
                
                // Recompute channel employees to ensure correct rendering if the updated employee is in the current channel
                if (_channelEmployees.Any(e => e.Id == updatedEmployee.Id))
                {
                    _channelEmployees = GetChannelEmployees();
                }

                StateHasChanged();
            }
        });
    }

    private void OnMessageReceived(ChatMessage msg)
    {
        InvokeAsync(async () =>
        {
            var channelToUpdate = _channels.FirstOrDefault(c => c.Id == msg.ChannelId);
            if (channelToUpdate != null)
            {
                channelToUpdate.LastActivityAt = msg.SentAt;
                _channels = _channels.OrderByDescending(c => c.LastActivityAt).ToList();
            }
            else 
            {
                LoadChannels();
            }

            if (msg.ChannelId == ChannelId)
            {
                // Clear typing indicator immediately — the sender has sent their message
                _typingUsers.Remove(msg.SenderId);

                if (!_messages.Any(m => m.Id == msg.Id))
                {
                    _messages.Add(msg);
                    
                    if (msg.IsEncrypted) TryDecryptMessages();
                    
                    // Mark as read so the database knows we've seen this real-time message if actively viewing
                    if (IsConnectionActivelyViewed())
                    {
                        await ChatNotifications.MarkChannelAsReadAsync(ChannelId);
                    }
                    
                    RecomputeSortedMessages();
                    RecomputeLatestReadReceipts();
                    
                    bool isOwnMessage = msg.SenderId == (_currentUser?.Id);
                    StateHasChanged();
                    
                    if (isOwnMessage)
                    {
                        await Task.Delay(50);
                        await ScrollToBottom();
                    }
                }
            }
            else
            {
                // Message is for another channel — re-sort sidebar only.
                // Don't call StateHasChanged() here to avoid a full re-render of the
                // message list just to update sidebar order. The next user interaction
                // (e.g., clicking a channel) will pick up the new order.
            }
        });
    }

    private void OnUserTyping(string channelId, string userId, string userName)
    {
        InvokeAsync(() =>
        {
            if (channelId == ChannelId && userId != _currentUser?.Id)
            {
                _typingUsers[userId] = (userName, DateTime.UtcNow);
                StateHasChanged();
            }
        });
    }

    private void OnUserStoppedTyping(string channelId, string userId)
    {
        InvokeAsync(() =>
        {
            if (channelId == ChannelId)
            {
                _typingUsers.Remove(userId);
                StateHasChanged();
            }
        });
    }

    private void OnMessageEdited(ChatMessage edited)
    {
        InvokeAsync(() =>
        {
            if (edited.ChannelId == ChannelId)
            {
                var msg = _messages.FirstOrDefault(m => m.Id == edited.Id);
                if (msg != null)
                {
                    msg.Content = edited.Content;
                    msg.EditedAt = edited.EditedAt;
                    msg.CallStatus = edited.CallStatus;
                    msg.MentionedAlbumIds = edited.MentionedAlbumIds?.ToList() ?? new List<string>();
                    msg.MentionedUserIds = edited.MentionedUserIds?.ToList() ?? new List<string>();
                    msg.MentionedEventIds = edited.MentionedEventIds?.ToList() ?? new List<string>();
                    msg.MentionsTeam = edited.MentionsTeam;
                    msg.MentionsEveryone = edited.MentionsEveryone;


                    if (msg.IsEncrypted && !string.IsNullOrEmpty(_decryptedChannelKey))
                    {
                        try
                        {
                            _decryptedContents[msg.Id] = Crypto.DecryptAes(msg.Content, _decryptedChannelKey);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogError(ex, "Decrypting edited message {MessageId} failed: {Message}", msg.Id, ex.Message);
                            if (!string.IsNullOrEmpty(msg.Content) && !ChatSecurityService.IsPotentialBase64Cipher(msg.Content))
                            {
                                _decryptedContents[msg.Id] = msg.Content;
                            }
                        }
                    }

                    StateHasChanged();
                }
            }
        });
    }

    private void OnMessageDeleted(string channelId, string messageId)
    {
        InvokeAsync(() =>
        {
            if (channelId == ChannelId)
            {
                _messages.RemoveAll(m => m.Id == messageId);
                RecomputeSortedMessages();
                RecomputeLatestReadReceipts();
                StateHasChanged();
            }
        });
    }

    private void OnReactionAdded(string channelId, string messageId, string emoji, string userId, string userName)
    {
        InvokeAsync(() =>
        {
            if (channelId == ChannelId)
            {
                var msg = _messages.FirstOrDefault(m => m.Id == messageId);
                if (msg != null)
                {
                    var reactionKey = $"{emoji}:{userId}";
                    if (!msg.Reactions.Contains(reactionKey))
                    {
                        msg.Reactions.Add(reactionKey);
                    }
                    StateHasChanged();
                }
            }
        });
    }

    private void OnReactionRemoved(string channelId, string messageId, string emoji, string userId)
    {
        InvokeAsync(() =>
        {
            if (channelId == ChannelId)
            {
                var msg = _messages.FirstOrDefault(m => m.Id == messageId);
                if (msg != null)
                {
                    var reactionKey = $"{emoji}:{userId}";
                    msg.Reactions.Remove(reactionKey);
                    StateHasChanged();
                }
            }
        });
    }

    private void OnChannelCreated(ChatChannel channel)
    {
        InvokeAsync(() =>
        {
            LoadChannels();
            if (_selectedChannel != null && _selectedChannel.Id == channel.Id)
            {
                HandleChannelUpdated();
            }
            // Only re-render if this new channel is visible to the current user
            else if (_channels.Any(c => c.Id == channel.Id))
            {
                StateHasChanged();
            }
        });
    }

    private void OnMessageRead(string channelId, string messageId, List<string> readBy)
    {
        InvokeAsync(() =>
        {
            if (channelId == ChannelId)
            {
                var msg = _messages.FirstOrDefault(m => m.Id == messageId);
                if (msg != null)
                {
                    msg.ReadBy = readBy;
                    RecomputeLatestReadReceipts();
                    StateHasChanged();
                }
            }
        });
    }
    
    private void RecomputeLatestReadReceipts()
    {
        var (latest, cumulative) = ChatReadReceiptHelper.CalculateReadReceipts(_selectedChannel, _messages);
        _latestReadReceipts = latest;
        _cumulativeReadReceipts = cumulative;
    }

    [JSInvokable]
    public Task HandleMessageSeen(string messageId)
        => string.IsNullOrWhiteSpace(messageId) ? Task.CompletedTask : HandleMessagesSeen([messageId]);

    [JSInvokable]
    public async Task HandleMessagesSeen(string[]? messageIds)
    {
        if (messageIds == null || messageIds.Length == 0 || !IsConnectionActivelyViewed())
        {
            return;
        }

        if (ChannelId != null && _currentUser != null && _selectedChannel != null)
        {
            var unreadIds = new List<string>();
            foreach (var messageId in messageIds)
            {
                if (string.IsNullOrWhiteSpace(messageId)) continue;
                var msg = _messages.FirstOrDefault(m => m.Id == messageId);
                if (msg != null && (msg.SenderId == _currentUser.Id || (msg.ReadBy != null && msg.ReadBy.Contains(_currentUser.Id))))
                {
                    continue; // Already seen, no server call needed
                }
                unreadIds.Add(messageId);
            }

            if (unreadIds.Count > 0)
            {
                await ChatService.MarkMessagesAsReadAsync(_currentUser.Id, ChannelId, unreadIds);
            }
            await ConfirmChannelViewedAndReadAsync(ChannelId);
        }
    }

