    }

    private bool IsAdminOrCreator(ChatChannel channel)
    {
        if (_currentUser == null) return false;
        if (_currentUser.IsAdmin) return true;
        
        if (channel.ChannelType == ChatChannelType.Team)
        {
            var teams = Db.Teams.GetAll().Where(t => channel.AllowedTeamIds.Contains(t.Id)).ToList();
            return teams.Any(t => t.LeaderId == _currentUser.Id);
        }
        
        return channel.CreatedById == _currentUser.Id;
    }

    private async Task HandleArchiveChannel()
    {
        if (_selectedChannel != null && IsAdminOrCreator(_selectedChannel))
        {
            try { await JS.InvokeVoidAsync("spokesRemoveShortcut", Configuration["ServerUrl"] ?? Nav.BaseUri, _selectedChannel.Id); } catch {}
            _selectedChannel.IsArchived = true;
            await ChatService.UpdateChannelAsync(_selectedChannel);
            _showInfoPanel = false;
            _selectedChannel = null;
            LoadChannels();
            Nav.NavigateTo("/chat");
            Snackbar.Add("Channel archived", Severity.Warning);
        }
    }

    private async Task HandleDeleteChannel()
    {
        if (_selectedChannel != null && IsAdminOrCreator(_selectedChannel))
        {
            var channelId = _selectedChannel.Id;
            try { await JS.InvokeVoidAsync("spokesRemoveShortcut", Configuration["ServerUrl"] ?? Nav.BaseUri, channelId); } catch {}
            
            Db.ChatChannels.Delete(channelId);
            
            var msgs = Db.ChatMessages.GetAll().Where(m => m.ChannelId == channelId).ToList();
            foreach (var m in msgs) Db.ChatMessages.Delete(m.Id);

            var readStates = Db.ChatReadStates.GetAll().Where(rs => rs.ChannelId == channelId).ToList();
            foreach (var rs in readStates) Db.ChatReadStates.Delete(rs.Id);

            _showInfoPanel = false;
            _selectedChannel = null;
            LoadChannels();
            Nav.NavigateTo("/chat");
            Snackbar.Add("Channel permanently deleted", Severity.Error);
        }
    }

    private async Task HandleRemoveMember(string memberId)
    {
        // Refresh channel state after member removal
        if (_selectedChannel != null)
        {
            var refreshed = Db.ChatChannels.GetById(_selectedChannel.Id);
            if (refreshed != null)
                _selectedChannel = refreshed;
        }
        LoadChannels();
        StateHasChanged();
    }
