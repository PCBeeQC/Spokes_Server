    private async Task ScrollToMessage(string messageId)
    {
        if (ChannelId == null) return;
        
        bool requiresRender = false;
        if (!_messages.Any(m => m.Id == messageId))
        {
            // Find how far back this message is in the channel index
            int pos = Db.ChatMessages.GetIndexPosition(ChannelId, messageId);
            
            // Load messages up to this position + 50 buffer
            _messages = Db.ChatMessages.GetByChannel(ChannelId, pos + 50);
            
            TryDecryptMessages();
            RecomputeSortedMessages();
            requiresRender = true;
            
            // Recalculate lazy loading state
            var cachedCount = Db.ChatMessages.GetMessageCount(ChannelId);
            _hasMoreMessages = cachedCount > _messages.Count;
        }

        if (requiresRender)
        {
            StateHasChanged();
            // Give the DOM a moment to render the newly populated list
            await Task.Delay(100);
        }

        // Scroll the message into view using JS interop
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("scrollToMessage", messageId);
            }
        }
        catch { /* ignore */ }
    }

