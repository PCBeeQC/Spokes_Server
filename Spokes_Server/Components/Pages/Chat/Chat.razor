    private async Task ScrollToMessage(string messageId)
    {
        if (ChannelId == null) return;

        var liveChannel = Db.ChatChannels.GetById(ChannelId);
        if (!await RevalidateCurrentSessionAndChannelAccessAsync(liveChannel)) return;
        _selectedChannel = liveChannel;

        bool requiresRender = false;
        if (!_messages.Any(m => m.Id == messageId))
        {
            // Find how far back this message is in the channel index
            int pos = Db.ChatMessages.GetIndexPosition(ChannelId, messageId);
            
            // Load messages up to this position + 50 buffer
            _messages = await Db.ChatMessages.GetByChannelAsync(ChannelId, pos + 50);
            
            TryDecryptMessages();
            RecomputeSortedMessages();
            requiresRender = true;
            
            // Recalculate lazy loading state
            var oldest = _sortedMessages.LastOrDefault() ?? _messages.MinBy(m => m.SentAt);
            _hasMoreMessages = oldest != null && Db.ChatMessages.HasMessagesBefore(ChannelId, oldest.SentAt);
        }

        if (requiresRender)
        {
            StateHasChanged();
            // Give the DOM a moment to render the newly populated list
            await Task.Delay(100);
        }

        // Scroll the message into view using JS interop
        try
        {
            if (_module != null)
            {
                await _module.InvokeVoidAsync("scrollToMessage", messageId);
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException)
        {
            // Circuit disconnected or cancelled during scroll
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "Failed to scroll message {MessageId} into view", messageId);
        }
    }

