    private async Task ActionSheetBlockUser()
    {
        if (_currentUser == null || _actionSheetMessage == null) return;
        if (_actionSheetMessage.SenderId == _currentUser.Id) return;

        if (!_currentUser.BlockedUserIds.Contains(_actionSheetMessage.SenderId))
        {
            _currentUser.BlockedUserIds.Add(_actionSheetMessage.SenderId);
            Db.Employees.Save(_currentUser);
        }
        CloseActionSheet();
        StateHasChanged();
    }

    private async Task ActionSheetReportMessage()
    {
        if (_actionSheetMessage == null || _currentUser == null) return;
        if (_actionSheetMessage.SenderId == _currentUser.Id) return;

        var msg = _actionSheetMessage;
        CloseActionSheet();
        
        var decContent = _decryptedContents.GetValueOrDefault(msg.Id) ?? msg.Content;
        
        var parameters = new DialogParameters<Spokes_Server.Components.Dialogs.ReportMessageDialog>
        {
            { x => x.Message, msg },
            { x => x.SnapshotContent, decContent }
        };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.ReportMessageDialog>("Report Message", parameters);
        var result = await dialog.Result;
        if (!result.Canceled && result.Data is ReportedMessage report)
        {
            report.ReporterId = _currentUser?.Id ?? "";
            Db.ReportedMessages.Save(report);
            Snackbar.Add("Message reported successfully.", Severity.Success);
            await NotificationRoutingService.RouteModerationNotificationAsync(report);
            ChatState.NotifyModerationAlert(report);
        }
    }

