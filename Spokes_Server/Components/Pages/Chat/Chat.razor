        </MudPaper>

        @* Group 2: Content *@
        <MudPaper Elevation="0" Class="mb-4 overflow-hidden" Style="border-radius: 16px;">
            <MudList T="string" Dense="false" Padding="false" ReadOnly="false">
                <MudListItem OnClick="ActionSheetCopy" Icon="@Icons.Material.Filled.ContentCopy">
                    <MudText Typo="Typo.body1" >@Loc["Copy Text"]</MudText>
                </MudListItem>
                @if (_actionSheetMessage.Attachments.Any())
                {
                    <MudListItem OnClick="ActionSheetShareAttachment" Icon="@Icons.Material.Filled.Share">
                        <MudText Typo="Typo.body1" >@Loc["Share"]</MudText>
