    private void RecomputeDiscoverableEmployees()
    {
        var filtered = PrivacyService.FilterDiscoverableEmployees(_currentUser, _employees).ToList();
        if (_currentUser != null &&
            _currentUser.IsActive &&
            !_currentUser.IsBanned &&
            !_currentUser.IsSystem &&
            !filtered.Any(e => e.Id == _currentUser.Id))
        {
            filtered.Insert(0, _currentUser);
        }
        _discoverableEmployees = filtered;
        _discoverableEmployeeLookup = _discoverableEmployees.ToDictionary(e => e.Id, e => e);
    }

    private Employee? GetEmployee(string employeeId)
    {
        if (string.IsNullOrEmpty(employeeId)) return null;
        return _discoverableEmployeeLookup.GetValueOrDefault(employeeId);
    }

    private Employee? GetVoiceParticipantEmployee(string employeeId)
    {
        if (string.IsNullOrEmpty(employeeId)) return null;
        if (_discoverableEmployeeLookup.TryGetValue(employeeId, out var discoverable))
        {
            return discoverable;
        }
        if (_employeeLookup.TryGetValue(employeeId, out var emp) && emp is { IsActive: true, IsBanned: false, IsSystem: false })
        {
            return emp;
        }
        var fromDb = Db.Employees.GetById(employeeId);
        if (fromDb is { IsActive: true, IsBanned: false, IsSystem: false })
        {
            _employeeLookup[employeeId] = fromDb;
            return fromDb;
        }
        return null;
    }

    /// <summary>
