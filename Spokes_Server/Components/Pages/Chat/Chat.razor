                    }
                    @if (_actionSheetMessage.SenderId != _currentUser?.Id)
                    {
                        <MudListItem OnClick="ActionSheetBlockUser" Icon="@Icons.Material.Filled.Block" IconColor="Color.Error">
                            <MudText Typo="Typo.body1" Color="Color.Error" >@Loc["Block User"]</MudText>
                        </MudListItem>
                        @if (_currentUser is { IsActive: true, IsSuspended: false, IsBanned: false } && _currentUser.HasPermission(AppPermissions.Chat.Use))
                        {
                            <MudListItem OnClick="ActionSheetReportMessage" Icon="@Icons.Material.Filled.Flag" IconColor="Color.Warning">
                                <MudText Typo="Typo.body1" Color="Color.Warning" >@Loc["Report Message"]</MudText>
                            </MudListItem>
