    {
        if (msg == null || _currentUser == null || !_currentUser.IsActive || _currentUser.IsSuspended || _currentUser.IsBanned || !_currentUser.HasPermission(AppPermissions.Chat.Use)) return;
        if (msg.SenderId == _currentUser.Id) return;

        var decContent = _decryptedContents.GetValueOrDefault(msg.Id) ?? msg.Content;

        var parameters = new DialogParameters<ReportMessageDialog>
        {
            { x => x.Message, msg },
            { x => x.SnapshotContent, decContent }
