@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.Communication.Presence
@using Spokes_Server.Core.Services.UI
@inject Database Db
@inject NavigationManager NavManager
@inject FileTokenService FileTokenService
@inject UserCircuitContext CircuitContext
@inject ScopedKeystoreService ScopedKeystoreService
@inject AlbumService AlbumService
@inject IUserPrivacyService PrivacyService
@inject AppLabelService AppLabels
@implements IDisposable

@if (_album == null || !_isAvailableInContext)
{
    <MudCard Class="pa-3 chat-card-unavailable">
        <div class="d-flex align-center gap-3">
            <MudIcon Icon="@Icons.Material.Filled.BrokenImage" Color="Color.Secondary" />
            <MudText Typo="Typo.body2" Color="Color.Secondary" Class="chat-card-italic">@Loc["This album is no longer available."]</MudText>
        </div>
    </MudCard>
}
else
{
    <MudCard Class="pa-3 cursor-pointer chat-album-card" @onclick="NavigateToAlbum">
        <div class="d-flex align-center justify-space-between gap-2 mb-2">
            <div class="d-flex align-center gap-3 chat-overflow-hidden">
                <MudAvatar Size="Size.Medium" Class="chat-album-avatar">
                    <MudIcon Icon="@(_isLocked ? Icons.Material.Filled.Lock : Icons.Material.Filled.PhotoAlbum)" Size="Size.Small" />
                </MudAvatar>
                <div class="chat-overflow-hidden">
                    <MudText Typo="Typo.subtitle2" Class="chat-album-title">@_album.Title</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">
                        @GetOwnerDisplayName()
                    </MudText>
                </div>
            </div>
            <MudButton OnClick="NavigateToAlbum" Variant="Variant.Outlined" Color="Color.Primary" Size="Size.Small" Class="flex-shrink-0 py-1 px-2 chat-album-cta">@Loc["Go to album"]</MudButton>
        </div>
        @if (_album.Media.Any() && !_isLocked)
        {
            var previewMedia = _album.Media.TakeLast(9).Reverse().ToList();
            <div class="mt-2 chat-album-grid">
                @for (int idx = 0; idx < previewMedia.Count; idx++)
                {
                    var media = previewMedia[idx];
                    <div class="media-tile chat-album-tile">
                        @if (media.ContentType.StartsWith("image/"))
                        {
                            <div class="media-tile-skeleton"></div>
                            <img data-media-src="@GetTokenizedUrl(media, smallThumb: true)"
                                 data-media-priority="album-preview"
                                 data-media-order="@(MessageIndex * 100 + idx)"
                                 data-media-encrypted="@(_album.IsEncrypted ? "true" : null)"
                                 alt="@media.FileName"
                                 decoding="async"
                                 class="needs-fade chat-album-tile-img" />
                        }
                        else if (media.ContentType.StartsWith("video/"))
                        {
                            <div class="d-flex align-center justify-center chat-album-tile-video">
                                <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Color="Color.Surface" Size="Size.Large" />
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </MudCard>
}

@code {
    [Parameter, EditorRequired]
    public string AlbumId { get; set; } = "";

    [Parameter]
    public string? CurrentUserId { get; set; }

    [Parameter]
    public string? SessionId { get; set; }

    [Parameter]
    public string? ChannelId { get; set; }

    [Parameter, EditorRequired]
    public List<Employee> Employees { get; set; } = [];

    [Parameter]
    public int MessageIndex { get; set; }

    private Album? _album;
    private bool _canViewAlbums;
    private bool _isAvailableInContext;
    private bool _isLocked;
    private string? _cachedPlainAlbumKey;
    private string? _lastStateKey;
    private string? _lastRenderKey;
    private bool _forceRender = true;

    protected override void OnInitialized()
    {
        ScopedKeystoreService.OnUnlocked += HandleVaultStateChanged;
        ScopedKeystoreService.OnLocked += HandleVaultStateChanged;
    }

    protected override void OnParametersSet()
    {
        var stateKey = $"{AlbumId}|{CurrentUserId}|{EffectiveSessionId}|{ChannelId}|{ScopedKeystoreService.IsUnlocked}";
        if (!string.Equals(_lastStateKey, stateKey, StringComparison.Ordinal) || _album == null)
        {
            _lastStateKey = stateKey;
            RefreshAlbumState();
        }
    }

    protected override bool ShouldRender()
    {
        var renderKey = $"{_lastStateKey}|{_canViewAlbums}|{_isAvailableInContext}|{_isLocked}|{_album?.Title}|{_album?.Media.Count}|{_album?.Media.LastOrDefault()?.Id}|{MessageIndex}";
        if (_forceRender)
        {
            _forceRender = false;
            _lastRenderKey = renderKey;
            return true;
        }
        if (string.Equals(_lastRenderKey, renderKey, StringComparison.Ordinal))
        {
            return false;
        }
        _lastRenderKey = renderKey;
        return true;
    }

    private void RefreshAlbumState()
    {
        _album = Db.Albums.GetById(AlbumId);
        var currentUser = !string.IsNullOrEmpty(CurrentUserId) ? Db.Employees.GetById(CurrentUserId) : null;
        _canViewAlbums = _album != null &&
                         currentUser != null &&
                         currentUser.HasEffectivePermission(AppPermissions.Albums.View, allowSuspended: true) &&
                         AlbumService.CanUserViewAlbum(_album, CurrentUserId);

        if (_album != null && _canViewAlbums)
        {
            if (!string.IsNullOrEmpty(ChannelId))
            {
                _isAvailableInContext = _album.SharedWithChannelIds.Contains(ChannelId);
            }
            else
            {
                _isAvailableInContext = _album.OwnerId == CurrentUserId || _album.ContributorUserIds.Contains(CurrentUserId ?? "");
            }

            if (_isAvailableInContext)
            {
                if (!_album.IsEncrypted)
                {
                    _isLocked = false;
                    _cachedPlainAlbumKey = null;
                }
                else
                {
                    var cacheKey = $"alb:{_album.Id}:{CurrentUserId}";
                    var albumRef = _album;
                    var userId = CurrentUserId!;
                    _cachedPlainAlbumKey = ScopedKeystoreService.GetOrDecryptKey(cacheKey, privateKey =>
                        AlbumService.GetPlainAlbumKey(albumRef, userId, privateKey));
                    _isLocked = string.IsNullOrEmpty(_cachedPlainAlbumKey);
                }
            }
            else
            {
                ScopedKeystoreService.InvalidateCachedKey($"alb:{_album.Id}:{CurrentUserId}");
                _isLocked = true;
                _cachedPlainAlbumKey = null;
            }
        }
        else
        {
            if (!string.IsNullOrEmpty(AlbumId) && !string.IsNullOrEmpty(CurrentUserId))
            {
                ScopedKeystoreService.InvalidateCachedKey($"alb:{AlbumId}:{CurrentUserId}");
            }
            _isAvailableInContext = false;
            _isLocked = _album != null;
            _cachedPlainAlbumKey = null;
        }
    }

    private void HandleVaultStateChanged()
    {
        InvokeAsync(() =>
        {
            _lastStateKey = null;
            _forceRender = true;
            RefreshAlbumState();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        ScopedKeystoreService.OnUnlocked -= HandleVaultStateChanged;
        ScopedKeystoreService.OnLocked -= HandleVaultStateChanged;
    }

    private string GetOwnerDisplayName()
    {
        if (_album == null || string.IsNullOrEmpty(_album.OwnerId))
        {
            return Loc["Unknown"].Value;
        }

        var viewer = !string.IsNullOrEmpty(CurrentUserId)
            ? (Employees.FirstOrDefault(e => e.Id == CurrentUserId) ?? Db.Employees.GetById(CurrentUserId))
            : null;
        var owner = Employees.FirstOrDefault(e => e.Id == _album.OwnerId) ?? Db.Employees.GetById(_album.OwnerId);
        if (owner == null)
        {
            return Loc["Unknown"].Value;
        }

        if (owner.IsSystem)
        {
            return Loc["System"].Value;
        }

        var channel = !string.IsNullOrEmpty(ChannelId) ? Db.ChatChannels.GetById(ChannelId) : null;
        if (PrivacyService.ShouldRestrictAlbumAudience(_album, viewer) ||
            (channel != null && PrivacyService.ShouldHideMemberList(channel, viewer)) ||
            !PrivacyService.CanDiscoverUser(viewer, owner))
        {
            return AppLabels.Employee;
        }

        return owner.FullName;
    }

    private void NavigateToAlbum()
    {
        if (_canViewAlbums && _isAvailableInContext)
        {
            if (!string.IsNullOrEmpty(ChannelId))
            {
                NavManager.NavigateTo($"/albums/{AlbumId}?fromChannel={ChannelId}");
            }
            else
            {
                NavManager.NavigateTo($"/albums/{AlbumId}");
            }
        }
    }

    private string? EffectiveSessionId => !string.IsNullOrWhiteSpace(SessionId) ? SessionId : CircuitContext?.SessionId;

    private string GetTokenizedUrl(AlbumMedia media, bool isThumbnail = true, bool smallThumb = false)
    {
        if (!_canViewAlbums || !_isAvailableInContext || _album == null ||
            string.IsNullOrWhiteSpace(CurrentUserId) || string.IsNullOrWhiteSpace(EffectiveSessionId))
        {
            return string.Empty;
        }

        if (string.IsNullOrWhiteSpace(media.FilePath) || !media.FilePath.StartsWith("/spokesapi/files/", StringComparison.OrdinalIgnoreCase))
        {
            return media.FilePath;
        }

        // AlbumMentionCard only ever displays thumbnail previews and must never mint original-media tokens.
        string thumbUrl = media.FilePath.Replace("/spokesapi/files/", "/spokesapi/files/thumb/", StringComparison.OrdinalIgnoreCase);
        return FileTokenService.BuildTokenizedUrl(
            "albums",
            _album.Id,
            thumbUrl,
            _cachedPlainAlbumKey,
            CurrentUserId,
            EffectiveSessionId,
            isThumbnail: true,
            smallThumbnail: smallThumb);
    }
}
