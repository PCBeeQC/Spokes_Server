@if (IsOpen)
{
    <div class="action-sheet-backdrop" @onclick="OnClose"></div>
    <div id="@_sheetId" class="action-sheet">
        <div class="action-sheet-handle"></div>
        <div class="action-sheet-content">
            @ChildContent
        </div>
    </div>
}
@{
    _lastRenderedOpen = IsOpen;
    _hasRenderedOnce = true;
}

@implements IAsyncDisposable
@inject IJSRuntime JS
@inject ILogger<MobileActionSheet> Logger

@code {
    [Parameter] public bool IsOpen { get; set; }
    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private IJSObjectReference? _module;
    private DotNetObjectReference<MobileActionSheet>? _objRef;
    private bool _wasOpen;
    private bool _closedByBack;
    private bool _isRegisteredOnBackStack;
    private bool _lastRenderedOpen;
    private bool _hasRenderedOnce;
    private string _sheetId = "action-sheet-" + Guid.NewGuid().ToString("N");

    protected override bool ShouldRender() => !_hasRenderedOnce || IsOpen || _lastRenderedOpen;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (IsOpen && !_wasOpen)
        {
            _wasOpen = true;
            _closedByBack = false;
            _objRef ??= DotNetObjectReference.Create(this);

            // Register on the unified back stack immediately (before the 50ms swipe-init delay)
            // so even rapid Back swipes dismiss the action sheet cleanly.
            await RegisterBackStackAsync();

            if (_module == null)
            {
                try
                {
                    _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets.Bypassed("Components/Pages/Chat/MobileActionSheet.razor.js")}");
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[MobileActionSheet] Error loading JS");
                }
            }

            if (_module != null && IsOpen)
            {
                // Slight delay to allow DOM to render the element before querying it
                await Task.Delay(50);
                if (IsOpen)
                {
                    try
                    {
                        await _module.InvokeVoidAsync("initSwipeToDismiss", _sheetId, _objRef);
                    }
                    catch (JSDisconnectedException) { }
                    catch (TaskCanceledException) { }
                    catch (ObjectDisposedException) { }
                }
            }
        }
        else if (!IsOpen && _wasOpen)
        {
            _wasOpen = false;
            var popHistory = !_closedByBack;
            _closedByBack = false;
            await UnregisterBackStackAsync(popHistory);
        }
    }

    [JSInvokable]
    public async Task CloseSheet()
    {
        _closedByBack = false;
        await UnregisterBackStackAsync(popHistory: true);
        await OnClose.InvokeAsync();
    }

    [JSInvokable]
    public async Task<bool> HandleBack()
    {
        _closedByBack = true;
        await UnregisterBackStackAsync(popHistory: false);
        await OnClose.InvokeAsync();
        return true;
    }

    private async Task RegisterBackStackAsync()
    {
        if (_objRef == null) return;
        _isRegisteredOnBackStack = true;
        try
        {
            await JS.InvokeVoidAsync(
                "SpokesBridge.backStack.registerServerEntry",
                "mobileActionSheet",
                _objRef,
                nameof(HandleBack),
                new { useHistoryGuard = true, source = "action-sheet", keepUntilRemoved = true });
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { }
    }

    private async Task UnregisterBackStackAsync(bool popHistory)
    {
        if (!_isRegisteredOnBackStack) return;
        _isRegisteredOnBackStack = false;
        try
        {
            await JS.InvokeVoidAsync(
                "SpokesBridge.backStack.remove",
                "mobileActionSheet",
                new { popHistory });
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }
        catch (JSException) { }
    }

    public async ValueTask DisposeAsync()
    {
        await UnregisterBackStackAsync(popHistory: false);
        _objRef?.Dispose();
        if (_module != null)
        {
            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException) { /* Circuit already gone */ }
            catch (TaskCanceledException) { }
        }
    }
}
