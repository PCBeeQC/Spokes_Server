@code {
    [Parameter] public string? Id { get; set; }
    [Parameter] [SupplyParameterFromQuery(Name = "tab")] public string? Tab { get; set; }
    [SupplyParameterFromQuery] public string? FromChannel { get; set; }

    private IJSObjectReference? _jsModule;
    private DotNetObjectReference<Albums>? _objRef;
    private bool _isDraggingFiles;
    private bool _dropZoneInitialized;

    private Employee? _currentUser;
    private string? _sessionId;
    private List<Employee> _employees = [];
    
    private List<Album> _myAlbums = [];
    private List<Album> _sharedAlbums = [];
    private Album? _selectedAlbum;
    private bool _isEditingTitle;
    private string _editingTitle = "";
    private string? _cachedPlainAlbumKey;
    private Dictionary<string, string?> _albumKeyCache = [];
    private int activeTabIndex;
    private string searchString = "";
    
    private bool _isSelectionMode;
    private HashSet<string> _selectedMediaIds = [];
    
    private bool _accessDenied;
    
    private bool _isExternalDisplayConnected;
    private bool _isStartingPresentation;
    
    private ApiFileUpload? _fileUpload;
    
    private UploadProgressState _activeUploadState = new();
    private Snackbar? _activeSnackbar;
    private string _originalUploadText = "";

    private bool IsOwner(Album? album) => album != null && _currentUser?.Id is { } userId && album.OwnerId == userId;
    private bool CanContribute(Album? album) => album != null && _currentUser?.Id is { } userId && (album.OwnerId == userId || album.ContributorUserIds.Contains(userId));
    private bool CanDeleteMedia(Album? album, AlbumMedia media) => album != null && _currentUser?.Id is { } userId && (album.OwnerId == userId || (album.ContributorUserIds.Contains(userId) && media.AddedByUserId == userId));

    protected override async Task OnInitializedAsync()
    {
        AlbumService.OnAlbumUpdated += HandleAlbumUpdated;
        ScopedKeystoreService.OnUnlocked += HandleVaultUnlocked;
        ScopedKeystoreService.OnLocked += HandleVaultLockedInAlbums;

        _currentUser = await UserService.GetEmployeeAsync();
        _sessionId = await UserService.GetSessionIdAsync();
        if (_currentUser != null)
        {
            _employees = Db.Employees.GetAll();
            LoadAlbums();
            ResolveSelectedAlbum();
        }
    }

    private bool _isAlbumLocked => IsAlbumLocked(_selectedAlbum, out _cachedPlainAlbumKey);

    private bool IsAlbumLocked(Album? album, out string? plainAlbumKey)
    {
        plainAlbumKey = null;
        if (album == null) return false;
        if (!album.IsEncrypted) return false;
        if (_currentUser == null) return true;

        if (_albumKeyCache.TryGetValue(album.Id, out var cachedKey))
        {
            plainAlbumKey = cachedKey;
            return string.IsNullOrEmpty(plainAlbumKey);
        }

        bool isLocked = AlbumService.IsAlbumLocked(album, _currentUser.Id, ScopedKeystoreService.GetPrivateKey(), out plainAlbumKey);
        _albumKeyCache[album.Id] = plainAlbumKey;
        return isLocked;
    }

    private void HandleVaultUnlockedInAlbums()
    {
        if (_currentUser != null)
        {
            _currentUser = Db.Employees.GetById(_currentUser.Id);
        }
        _albumKeyCache.Clear();
        LoadAlbums();
        ResolveSelectedAlbum();
        StateHasChanged();
    }

    private async void HandleVaultUnlocked()
    {
        await InvokeAsync(() =>
        {
            if (_currentUser == null) return;
            _currentUser = Db.Employees.GetById(_currentUser.Id);
            _albumKeyCache.Clear();
            LoadAlbums();
            ResolveSelectedAlbum();
            StateHasChanged();
        });
    }

    private async void HandleVaultLockedInAlbums()
    {
        await InvokeAsync(() =>
        {
            _albumKeyCache.Clear();
            _cachedPlainAlbumKey = null;
            ResolveSelectedAlbum();
            StateHasChanged();
        });
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _objRef = DotNetObjectReference.Create(this);
                _jsModule = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets.Bypassed("Components/Pages/Albums/Albums.razor.js")}");
                _isExternalDisplayConnected = await JS.InvokeAsync<bool>("spokesExternalDisplay.checkAvailability");
                await JS.InvokeVoidAsync("spokesExternalDisplay.initListener", _objRef);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error initializing Albums JS module: {Message}", ex.Message);
            }
        }

        if (_selectedAlbum != null && !_dropZoneInitialized && _jsModule != null)
        {
            try
            {
                var maxAllowedSize = Db.CompanyProfile.Get()?.MaxFileUploadSizeBytes ?? WebUiExtensions.DefaultMaxFileUploadSizeBytes;
                await _jsModule.InvokeVoidAsync("initFileHandlers", "album-drop-zone", _objRef, maxAllowedSize);
                _dropZoneInitialized = true;
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "Error initializing Albums drag and drop: {Message}", ex.Message);
            }
        }
        else if (_selectedAlbum == null && _dropZoneInitialized)
        {
            _dropZoneInitialized = false;
        }
    }

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Tab))
        {
            activeTabIndex = Tab.ToLower() switch
            {
                "all" => 0,
                "my" => 1,
                "shared" => 2,
                _ => 0
            };
        }
        ResolveSelectedAlbum();
    }

    public void Dispose()
    {
        AlbumService.OnAlbumUpdated -= HandleAlbumUpdated;
        ScopedKeystoreService.OnUnlocked -= HandleVaultUnlocked;
        ScopedKeystoreService.OnLocked -= HandleVaultLockedInAlbums;
    }

    public async ValueTask DisposeAsync()
    {
        if (_jsModule != null)
        {
            try { await _jsModule.DisposeAsync(); } catch { }
        }
        _objRef?.Dispose();
    }

    [JSInvokable]
    public void SetDraggingState(bool isDragging)
    {
        if (_isDraggingFiles != isDragging)
        {
            _isDraggingFiles = isDragging;
            StateHasChanged();
        }
    }

    [JSInvokable]
    public string GetUploadUrl()
    {
        if (_selectedAlbum == null) return string.Empty;
        string baseUrl = $"/spokesapi/files/albums/{_selectedAlbum.Id}";
        if (_selectedAlbum.IsEncrypted && !IsAlbumLocked(_selectedAlbum, out var albumKey) && !string.IsNullOrEmpty(albumKey))
        {
            var token = FileTokenService.GenerateAccessToken("albums", _selectedAlbum.Id, "*", albumKey, _currentUser?.Id, CircuitContext?.SessionId);
            return $"{baseUrl}?t={token}";
        }
        else if (_selectedAlbum.IsEncrypted)
        {
             var token = FileTokenService.GenerateAccessToken("albums", _selectedAlbum.Id, "*", null, _currentUser?.Id, CircuitContext?.SessionId);
             return $"{baseUrl}?t={token}";
        }
        return baseUrl;
    }

    [JSInvokable]
    public async Task OnPasteUploadStarted()
    {
        await HandleUploadStarted(1);
    }

    [JSInvokable]
    public void OnPasteProgressUpdate(double progress)
    {
        HandleDetailedProgressUpdate((_originalUploadText, progress));
    }

    [JSInvokable]
    public void OnPasteProcessingUpdate(string status)
    {
        HandleDetailedProgressUpdate((status, 100));
    }

    [JSInvokable]
    public async Task OnPasteUploadCompleted(string jsonResult)
    {
        var results = System.Text.Json.JsonSerializer.Deserialize<List<ApiFileUpload.UploadResult>>(
            jsonResult,
            new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true }
        );
        if (results != null)
        {
            if (_selectedAlbum != null)
            {
                foreach (var r in results) r.ContextId = _selectedAlbum.Id;
            }
            HandleUploadCompleted(results);
        }
    }

    [JSInvokable]
    public void OnPasteUploadError(string error)
    {
        Snackbar.Add(string.Format(Loc["Upload failed: {0}"].Value, error), Severity.Error);
    }

    private async void HandleAlbumUpdated(string albumId)
    {
        await InvokeAsync(() =>
        {
            if (_currentUser == null) return;
            
            _albumKeyCache.Remove(albumId);
            LoadAlbums();
            
            if (_selectedAlbum?.Id == albumId)
            {
                ResolveSelectedAlbum();
            }
            
            StateHasChanged();
        });
    }

    private void UpdateActiveTab(int index)
    {
        activeTabIndex = index;
        var tabName = index switch
        {
            0 => "all",
            1 => "my",
            2 => "shared",
            _ => "all"
        };
        try
        {
            NavManager.NavigateTo(NavManager.GetUriWithQueryParameter("tab", tabName), replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException) { }
    }

    private IEnumerable<Album> FilteredAlbums
    {
        get
        {
            List<Album> baseList = activeTabIndex switch
            {
                1 => _myAlbums,
                2 => _sharedAlbums,
                _ => _myAlbums.Concat(_sharedAlbums).GroupBy(a => a.Id).Select(g => g.First()).OrderByDescending(a => a.CreatedAt).ToList()
            };

            if (string.IsNullOrWhiteSpace(searchString))
                return baseList;

            return baseList.Where(a =>
                a.Title.Contains(searchString, StringComparison.OrdinalIgnoreCase) ||
                GetOwnerName(a.OwnerId).Contains(searchString, StringComparison.OrdinalIgnoreCase));
        }
    }

    private string GetOwnerName(string ownerId)
    {
        if (_currentUser != null && ownerId == _currentUser.Id) return Loc["You"].Value;
        var emp = _employees.FirstOrDefault(e => e.Id == ownerId);
        return emp?.FullName ?? Loc["Unknown"].Value;
    }

    private void ResolveSelectedAlbum()
    {
        if (_currentUser == null) return;

        _accessDenied = false;

        if (!string.IsNullOrEmpty(Id))
        {
            if (_selectedAlbum?.Id != Id)
            {
                _isSelectionMode = false;
                _isEditingTitle = false;
                _selectedMediaIds.Clear();
            }

            var requestedAlbum = Db.Albums.GetById(Id);
            if (requestedAlbum != null && (requestedAlbum.OwnerId == _currentUser.Id || requestedAlbum.ContributorUserIds.Contains(_currentUser.Id) || requestedAlbum.SharedWithChannelIds.Any(cId => ChatAccess.GetUsersForChannel(cId).Contains(_currentUser.Id))))
            {
                _selectedAlbum = requestedAlbum;
                _albumKeyCache.Remove(_selectedAlbum.Id);
                if (!IsAlbumLocked(_selectedAlbum, out _cachedPlainAlbumKey))
                {
                    var privateKey = ScopedKeystoreService.GetPrivateKey();
                    if (_selectedAlbum.OwnerId == _currentUser.Id && privateKey != null)
                    {
                        AlbumService.TrySelfHealContributorKeys(_selectedAlbum.Id, _currentUser.Id, privateKey);
                    }
                }
            }
            else 
            {
                _selectedAlbum = null;
                _accessDenied = true;
            }
        }
        else
        {
            if (_selectedAlbum != null)
            {
                _isSelectionMode = false;
                _isEditingTitle = false;
                _selectedMediaIds.Clear();
            }
            _selectedAlbum = null;
            _cachedPlainAlbumKey = null;
        }
    }

    private List<string> GetDynamicSharedUserIds(Album? album)
    {
        if (album == null) return new List<string>();
        var userIds = album.SharedWithChannelIds
            .SelectMany(cId => ChatAccess.GetUsersForChannel(cId))
            .Distinct();

        if (PrivacyService.ShouldRestrictAlbumAudience(album, _currentUser))
        {
            var caller = _currentUser;
            return userIds.Where(id =>
            {
                var emp = _employees.FirstOrDefault(e => e.Id == id);
                return emp != null && PrivacyService.CanDiscoverUser(caller, emp);
            }).ToList();
        }

        return userIds.ToList();
    }

    private void LoadAlbums()
    {
        if (_currentUser == null) return;
        
        var allAlbums = Db.Albums.GetAll();
        _myAlbums = allAlbums.Where(a => a.OwnerId == _currentUser.Id).OrderByDescending(a => a.CreatedAt).ToList();
        _sharedAlbums = allAlbums.Where(a => a.OwnerId != _currentUser.Id && (a.ContributorUserIds.Contains(_currentUser.Id) || a.SharedWithChannelIds.Any(cId => ChatAccess.GetUsersForChannel(cId).Contains(_currentUser.Id)))).OrderByDescending(a => a.CreatedAt).ToList();
    }

    private void SelectAlbum(Album album)
    {
        NavManager.NavigateTo($"/albums/{album.Id}", replace: false);
    }

    private void CloseAlbum()
    {
        _isSelectionMode = false;
        _isEditingTitle = false;
        _selectedMediaIds.Clear();
        if (!string.IsNullOrEmpty(FromChannel))
        {
            NavManager.NavigateTo($"/chat/{FromChannel}", replace: false);
        }
        else
        {
            NavManager.NavigateTo("/albums", replace: false);
        }
    }

    private void StartEditingTitle()
    {
        if (_selectedAlbum == null || _currentUser == null || _selectedAlbum.OwnerId != _currentUser.Id) return;
        _editingTitle = _selectedAlbum.Title;
        _isEditingTitle = true;
    }

    private void CancelEditingTitle()
    {
        _isEditingTitle = false;
        _editingTitle = "";
    }

    private async Task SaveTitle()
    {
        if (_selectedAlbum == null || _currentUser == null || _selectedAlbum.OwnerId != _currentUser.Id) return;
        var trimmed = _editingTitle?.Trim();
        if (string.IsNullOrWhiteSpace(trimmed))
        {
            Snackbar.Add(Loc["Album title cannot be empty."].Value, Severity.Warning);
            return;
        }

        if (trimmed == _selectedAlbum.Title)
        {
            _isEditingTitle = false;
            return;
        }

        var result = AlbumService.RenameAlbum(_selectedAlbum.Id, _currentUser.Id, trimmed);
        if (result.IsSuccess)
        {
            _selectedAlbum.Title = trimmed;
            _isEditingTitle = false;
            LoadAlbums();
            Snackbar.Add(Loc["Album title updated."].Value, Severity.Success);
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? Loc["Failed to rename album."].Value, Severity.Error);
        }
    }

    private void ToggleSelectionMode()
    {
        _isSelectionMode = !_isSelectionMode;
        _selectedMediaIds.Clear();
    }
    
    private void HandleMediaClick(int index, AlbumMedia media)
    {
        if (_isSelectionMode)
        {
            if (_selectedMediaIds.Contains(media.Id))
            {
                _selectedMediaIds.Remove(media.Id);
            }
            else
            {
                _selectedMediaIds.Add(media.Id);
            }
        }
        else
        {
            _ = OpenLightbox(index);
        }
    }
    
    private async Task DeleteSelectedMediaAction()
    {
        if (_selectedAlbum == null || _currentUser == null || !_selectedMediaIds.Any()) return;
        
        bool isOwner = _selectedAlbum.OwnerId == _currentUser.Id;
        bool isContributor = _selectedAlbum.ContributorUserIds.Contains(_currentUser.Id);
        
        if (!isOwner && !isContributor) return;

        var mediaToDelete = _selectedAlbum.Media.Where(m => _selectedMediaIds.Contains(m.Id)).ToList();
        if (!isOwner)
        {
            mediaToDelete = mediaToDelete.Where(m => m.AddedByUserId == _currentUser.Id).ToList();
        }
        
        if (!mediaToDelete.Any())
        {
            Snackbar.Add(Loc["You can only delete your own media."].Value, Severity.Warning);
            return;
        }

        bool? result = await DialogService.ShowMessageBoxAsync(
            Loc["Delete Selected Media"].Value, 
            string.Format(Loc["Are you sure you want to delete {0} items? This action cannot be undone."].Value, mediaToDelete.Count), 
            yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value);
            
        if (result == true)
        {
            try
            {
                var removeResult = AlbumService.RemoveMediaBulk(_selectedAlbum.Id, _currentUser.Id, mediaToDelete.Select(m => m.Id));
                if (!removeResult.IsSuccess)
                {
                    Snackbar.Add(removeResult.ErrorMessage ?? Loc["Failed to delete media items."].Value, Severity.Error);
                    ToggleSelectionMode();
                    return;
                }

                var removedMedia = removeResult.Value ?? [];
                
                foreach (var media in removedMedia)
                {
                    if (media.FilePath.StartsWith($"/spokesapi/files/albums/{_selectedAlbum.Id}/"))
                    {
                        try 
                        {
                            await FileService.DeleteAsync(media.FilePath);
                        }
                        catch (Exception ex)
                        {
                            Logger.LogWarning(ex, "Failed to delete physical file {FilePath}: {Message}", media.FilePath, ex.Message);
                        }
                    }
                }
                
                ToggleSelectionMode();
                Snackbar.Add(string.Format(Loc["Deleted {0} items"].Value, removedMedia.Count), Severity.Success);
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(Loc["Failed to process deletion: {0}"].Value, ex.Message), Severity.Error);
                ToggleSelectionMode();
            }
        }
    }

    private async Task OpenManageContributorsDialog()
    {
        if (_selectedAlbum == null || _currentUser == null || _selectedAlbum.OwnerId != _currentUser.Id) return;

        var parameters = new DialogParameters
        {
            { "Employees", _employees.Where(e => e.Id != _currentUser.Id).ToList() },
            { "InitialSelectedUserIds", new HashSet<string>(_selectedAlbum.ContributorUserIds) },
            { "IsEncrypted", _selectedAlbum.IsEncrypted }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<ManageContributorsDialog>(Loc["Manage Contributors"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: List<string> newContributors })
        {
            var existingContributors = new HashSet<string>(_selectedAlbum.ContributorUserIds);
            var removedContributors = existingContributors.Where(e => !newContributors.Contains(e)).ToList();

            if (removedContributors.Any())
            {
                bool? confirm = await DialogService.ShowMessageBoxAsync(
                    Loc["Remove Contributors"].Value, 
                    Loc["Removing contributors will permanently delete all photos they have uploaded to this album. Are you sure you want to proceed?"].Value, 
                    yesText: Loc["Remove"].Value, cancelText: Loc["Cancel"].Value);

                if (confirm != true)
                {
                    return; // Cancel the operation
                }
            }

            var privateKey = ScopedKeystoreService.GetPrivateKey();
            var updateResult = AlbumService.UpdateContributors(_selectedAlbum.Id, _currentUser.Id, newContributors, privateKey);
            if (!updateResult.IsSuccess)
            {
                Snackbar.Add(updateResult.ErrorMessage ?? Loc["Failed to update contributors."].Value, Severity.Error);
                return;
            }

            var removedMedia = updateResult.Value ?? [];
            
            foreach(var media in removedMedia)
            {
                if (media.FilePath.StartsWith($"/spokesapi/files/albums/{_selectedAlbum.Id}/"))
                {
                    try
                    {
                        await FileService.DeleteAsync(media.FilePath);
                    }
                    catch (Exception ex)
                    {
                        Logger.LogWarning(ex, "Failed to delete file {FilePath}: {Message}", media.FilePath, ex.Message);
                    }
                }
            }
            
            Snackbar.Add(Loc["Contributors updated"].Value, Severity.Success);
            StateHasChanged();
        }
    }

