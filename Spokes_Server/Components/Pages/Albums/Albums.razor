    private async Task OpenShareDialogFor(Album album)
    {
        if (album == null || _currentUser == null) return;
        
        var sharedText = $"#[{album.Title}](album:{album.Id})";
        var parameters = new DialogParameters
        {
            { "SharedText", sharedText }
        };
        var dialog = await DialogService.ShowAsync<ShareModal>(Loc["Share Album"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ShareModal.ShareResult shareResult)
        {
            if (!string.IsNullOrEmpty(shareResult.ChannelId))
            {
                var payload = new SharePayload
                {
                    Text = sharedText
                };
                ShareTargetStateService.SetPayload(payload, shareResult.ChannelId);
                NavManager.NavigateTo($"/chat/{shareResult.ChannelId}");
            }
        }
    }

    private string GetTokenizedUrl(AlbumMedia media, bool isThumbnail = true)
    {
        return GetTokenizedUrl(_selectedAlbum, media, isThumbnail);
    }

    private string GetTokenizedUrl(Album? album, AlbumMedia media, bool isThumbnail = true)
    {
        if (album == null || _currentUser == null) return isThumbnail ? media.ThumbnailUrl : media.FilePath;
        
        string baseUrl = isThumbnail ? media.ThumbnailUrl : media.FilePath;
        IsAlbumLocked(album, out var albumKey);
        string token = FileTokenService.GenerateAccessToken("albums", album.Id, baseUrl, albumKey, _currentUser?.Id, CircuitContext?.SessionId);
        return $"{baseUrl}?t={token}";
    }
