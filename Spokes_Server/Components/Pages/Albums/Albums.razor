    private async Task OpenCreateAlbumDialog()
    {
        if (_currentUser == null) return;

        if (_currentUser.HasVaultPassword && !ScopedKeystoreService.IsUnlocked)
        {
            var unlockDialog = await DialogService.ShowAsync<UnlockVaultDialog>(
                Loc["Unlock Vault"].Value,
                new DialogParameters { ["Employee"] = _currentUser },
                new DialogOptions { MaxWidth = MaxWidth.ExtraSmall, FullWidth = true });
            var unlockResult = await unlockDialog.Result;
            if (unlockResult == null || unlockResult.Canceled || !ScopedKeystoreService.IsUnlocked)
            {
                return;
            }
        }

        var parameters = new DialogParameters { { "CurrentFolderName", "" }, { "SubmitText", Loc["Create Album"].Value } };
        var dialog = await DialogService.ShowAsync<FolderManageDialog>(Loc["New Album"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });
        var result = await dialog.Result;
        if (result is { Canceled: false, Data: string title } && !string.IsNullOrWhiteSpace(title))
        {
            var privateKey = ScopedKeystoreService.GetPrivateKey();
            var createResult = AlbumService.CreateAlbum(new Album
            {
                OwnerId = _currentUser!.Id,
                Title = title,
                CreatedAt = DateTime.UtcNow
            }, _currentUser!.Id, privateKey);
            if (createResult.IsSuccess && createResult.Value != null)
            {
                LoadAlbums();
                var newAlbum = createResult.Value;
                IsAlbumLocked(newAlbum, out _cachedPlainAlbumKey);
                SelectAlbum(newAlbum);
                Snackbar.Add(Loc["Album created successfully"].Value, Severity.Success);
            }
            else
            {
                Snackbar.Add(createResult.ErrorMessage ?? Loc["Failed to create album"].Value, Severity.Error);
            }
        }
    }

    private async Task HandleUploadStarted(int fileCount)
    {
        _originalUploadText = fileCount > 0 
            ? (fileCount == 1 ? string.Format(Loc["Uploading {0} file..."].Value, fileCount) : string.Format(Loc["Uploading {0} files..."].Value, fileCount))
            : Loc["Uploading files..."].Value;
        _activeUploadState.Progress = 0;
        _activeUploadState.StatusText = _originalUploadText;
        _activeUploadState.IsUploading = true;

        if (_activeSnackbar != null)
        {
            Snackbar.Remove(_activeSnackbar);
        }

        _activeSnackbar = Snackbar.Add<UploadProgressSnackbar>(
            new Dictionary<string, object> { { "UploadState", _activeUploadState } },
            Severity.Info,
            config =>
            {
                config.RequireInteraction = true;
                config.ShowCloseIcon = false;
            }
        );

        StateHasChanged();
    }

    private void HandleDetailedProgressUpdate((string State, double Progress) update)
    {
        _activeUploadState.StatusText = update.State;
        _activeUploadState.Progress = update.Progress;
        
        StateHasChanged();
    }

    private void HandleUploadError(string errorMessage)
    {
        if (_activeSnackbar != null)
        {
            Snackbar.Remove(_activeSnackbar);
            _activeSnackbar = null;
        }
        _activeUploadState.IsUploading = false;
        Snackbar.Add(errorMessage, Severity.Error);
        StateHasChanged();
    }

    private void HandleUploadCompleted(List<ApiFileUpload.UploadResult> results)
    {
        if (_activeSnackbar != null)
        {
            Snackbar.Remove(_activeSnackbar);
            _activeSnackbar = null;
        }
        _activeUploadState.IsUploading = false;
        StateHasChanged();

        if (_selectedAlbum == null || _currentUser == null) return;
        
        List<AlbumMedia> newMedia = [];
        foreach (var r in results)
        {
            if (r.ContextId != _selectedAlbum.Id)
                continue;

            newMedia.Add(new AlbumMedia
            {
                FileName = r.FileName,
                FilePath = r.FilePath,
                FileSizeBytes = r.FileSizeBytes,
                ContentType = r.ContentType,
                HasServerThumbnail = r.HasThumbnail,
                ImageWidth = r.ImageWidth,
                ImageHeight = r.ImageHeight,
                DurationSeconds = r.DurationSeconds,
                AddedAt = DateTime.UtcNow,
                AddedByUserId = _currentUser.Id
            });
        }
        
        var addResult = AlbumService.AddMedia(_selectedAlbum.Id, _currentUser.Id, newMedia);
        if (!addResult.IsSuccess)
        {
            Snackbar.Add(addResult.ErrorMessage ?? Loc["Failed to add media to album"].Value, Severity.Error);
            return;
        }
        Snackbar.Add(string.Format(Loc["Added {0} items to album"].Value, newMedia.Count), Severity.Success);
        StateHasChanged();
    }

