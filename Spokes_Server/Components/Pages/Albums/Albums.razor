    private async Task StartExternalDisplayPresentation()
    {
        if (_selectedAlbum == null || _currentUser == null || !_selectedAlbum.Media.Any()) return;

        _isStartingPresentation = true;
        StateHasChanged();

        try
        {
            // Derive plain album key if encrypted
            IsAlbumLocked(_selectedAlbum, out string? plainAlbumKey);

            string hostConnectionId = $"blazor_host_{_currentUser.Id}_{Guid.NewGuid():N}";
            var allowedMedia = _selectedAlbum.Media.ToDictionary(m => m.Id, m => System.IO.Path.GetFileName(m.FilePath));
            var bridge = new UserScopedSlideshowBridge(ServiceProvider, _currentUser, _selectedAlbum.Id, plainAlbumKey, allowedMedia);

            var session = SessionService.CreateDirectSession(_currentUser.Id, hostConnectionId, _selectedAlbum.Id, bridge);

            // Prepare slideshow media items routed to dedicated SlideshowMediaController
            var items = new List<SlideshowMediaItem>();
            var allEmployees = Db.Employees.GetAll();

            foreach (var media in _selectedAlbum.Media)
            {
                string url = $"/spokesapi/slideshow/{session.SessionId}/media/{media.Id}";

                var uploader = allEmployees.FirstOrDefault(e => e.Id == media.AddedByUserId);
                string uploaderName = uploader != null ? $"{uploader.FirstName} {uploader.LastName}".Trim() : string.Empty;

                items.Add(new SlideshowMediaItem
                {
                    Id = media.Id,
                    FileName = media.FileName,
                    Url = url,
                    ThumbnailUrl = $"{url}/thumb",
                    ContentType = media.ContentType,
                    ImageWidth = media.ImageWidth,
                    ImageHeight = media.ImageHeight,
                    DurationSeconds = media.DurationSeconds,
                    AddedAt = media.AddedAt,
                    AddedByUserName = uploaderName,
                    FileSizeBytes = media.FileSizeBytes
                });
            }

            var stagePayload = new SlideshowStagePayload
            {
                SessionId = session.SessionId,
                AlbumId = _selectedAlbum.Id,
                AlbumTitle = _selectedAlbum.Title,
                InitialIndex = 0,
                Items = items
            };

            // Notify in-memory TV Stage
            SessionService.NotifySessionStarted(session.SessionId, stagePayload);

            string stageUrl = $"{NavManager.BaseUri.TrimEnd('/')}/slideshow/stage/{session.SessionId}";
            await JS.InvokeVoidAsync("spokesExternalDisplay.startPresentation", stageUrl);

            NavManager.NavigateTo($"/albums/{_selectedAlbum.Id}/remote/{session.SessionId}");
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to start external display presentation for album {AlbumId}", _selectedAlbum?.Id);
            Snackbar.Add(Loc["Failed to start slideshow on TV."].Value, Severity.Error);
        }
        finally
        {
            _isStartingPresentation = false;
            StateHasChanged();
        }
    }
    
    private async Task DeleteMediaAction(AlbumMedia media)
    {
        if (_selectedAlbum == null || _currentUser == null) return;
        
        bool isOwner = _selectedAlbum.OwnerId == _currentUser.Id;
        bool isContributor = _selectedAlbum.ContributorUserIds.Contains(_currentUser.Id);
        
        if (isOwner || (isContributor && media.AddedByUserId == _currentUser.Id))
        {
            try
            {
                if (!media.FilePath.StartsWith($"/spokesapi/files/albums/{_selectedAlbum.Id}/"))
                    throw new InvalidOperationException("Invalid file path");

                var removeResult = AlbumService.RemoveMedia(_selectedAlbum.Id, _currentUser.Id, media);
                if (!removeResult.IsSuccess)
                {
                    Snackbar.Add(removeResult.ErrorMessage ?? Loc["Failed to delete media"].Value, Severity.Error);
                    return;
                }
                
                try
                {
                    await FileService.DeleteAsync(media.FilePath);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "Failed to delete physical file {FilePath}: {Message}", media.FilePath, ex.Message);
                }
                
                Snackbar.Add(Loc["Media removed"].Value, Severity.Info);
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(Loc["Failed to delete media: {0}"].Value, ex.Message), Severity.Error);
            }
        }
    }

    private async Task DeleteAlbumAction()
    {
        if (_selectedAlbum == null) return;
        await DeleteSpecificAlbumAction(_selectedAlbum);
    }

    private async Task DeleteSpecificAlbumAction(Album album)
    {
        if (album == null || _currentUser == null || album.OwnerId != _currentUser.Id) return;
        
        bool? result = await DialogService.ShowMessageBoxAsync(
            Loc["Delete Album"].Value, 
            string.Format(Loc["Are you sure you want to delete '{0}'? This action cannot be undone."].Value, album.Title), 
            yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value);
            
        if (result == true)
        {
            try
            {
                foreach (var media in album.Media)
                {
                    await FileService.DeleteAsync(media.FilePath);
                }

                bool wasSelected = _selectedAlbum?.Id == album.Id;

                var deleteResult = AlbumService.DeleteAlbum(album.Id, _currentUser.Id);
                if (!deleteResult.IsSuccess)
                {
                    Snackbar.Add(deleteResult.ErrorMessage ?? Loc["Failed to delete album"].Value, Severity.Error);
                    return;
                }
                Snackbar.Add(Loc["Album deleted"].Value, Severity.Success);
                
                if (wasSelected)
                {
                    CloseAlbum();
                }
                else
                {
                    LoadAlbums();
                }
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(Loc["Failed to delete album: {0}"].Value, ex.Message), Severity.Error);
            }
        }
    }

