@page "/albums"
@page "/albums/{Id}"
@attribute [Authorize(Policy = AppPermissions.Albums.View)]
@implements IDisposable
@implements IAsyncDisposable
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Dialogs.Common
@using Spokes_Server.Components.Dialogs.Communication.Chat
@using Spokes_Server.Components.Shared
@inject Database Db
@inject NavigationManager NavManager
@inject UserService UserService
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject IFileService FileService
@inject AlbumService AlbumService
@inject ScopedKeystoreService ScopedKeystoreService
@inject ShareTargetStateService ShareTargetStateService
@inject IChatChannelAccessService ChatAccess
@inject FileTokenService FileTokenService
@inject UserCircuitContext CircuitContext
@inject IUserPrivacyService PrivacyService
@inject ISlideshowSessionService SessionService
@inject IServiceProvider ServiceProvider
@inject ILogger<Albums> Logger
@using Microsoft.Extensions.Logging
@using Spokes_Server.Core.Services.Communication.Presence

<PageTitle>@Loc["Albums"]</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-4 pb-6">

@if (_currentUser == null)
{
    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="rounded-lg my-4">@Loc["Your user profile could not be loaded. Please contact an administrator."]</MudAlert>
}
else if (_accessDenied)
{
    <MudPaper Class="d-flex flex-column align-center justify-center pa-10 text-center my-6" Style="min-height: 400px; border-radius: 16px;" Elevation="0" Outlined="true">
        <MudIcon Icon="@Icons.Material.Filled.Lock" Color="Color.Error" Style="font-size: 4rem; opacity: 0.7;" Class="mb-4" />
        <MudText Typo="Typo.h5" Style="font-weight: 700;">@Loc["Access Denied"]</MudText>
        <MudText Typo="Typo.body1" Color="Color.Secondary" Class="mt-2 mb-6" Style="max-width: 400px;">
            @Loc["You don't have permission to view this album, or it doesn't exist."]
        </MudText>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@(() => NavManager.NavigateTo("/albums"))" Class="rounded-lg px-6 py-2">
            @Loc["Back to Albums"]
        </MudButton>
    </MudPaper>
}
else if (_selectedAlbum != null)
{
    @* --- SELECTED ALBUM VIEW --- *@
    <div id="album-drop-zone" style="position: relative; min-height: 100%;">
        <MudOverlay Visible="_isDraggingFiles" DarkBackground="true" Absolute="true" ZIndex="1000">
            <div class="d-flex flex-column align-center pa-6" style="border: 3px dashed rgba(255,255,255,0.5); border-radius: 16px; background: rgba(255,255,255,0.1);">
                <MudIcon Icon="@Icons.Material.Filled.CloudUpload" Size="Size.Large" Style="font-size: 4rem; color: white;" />
                <MudText Typo="Typo.h5" Style="color: white; margin-top: 0.5rem;">@Loc["Drop files to upload"]</MudText>
            </div>
        </MudOverlay>
        
        <div class="mb-6">
            <div class="d-flex flex-wrap align-center justify-space-between gap-4">
                <div class="d-flex align-center gap-3">
                    <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" OnClick="CloseAlbum" Color="Color.Default" Size="Size.Medium" title="@Loc["Back to Albums"]" />
                    <div class="d-flex align-center gap-2">
                        @if (_isEditingTitle && _selectedAlbum.OwnerId == _currentUser?.Id)
                        {
                            <MudTextField @bind-Value="_editingTitle" Variant="Variant.Outlined" Margin="Margin.Dense"
                                Placeholder="@Loc["Album title"]" Immediate="true" Class="ma-0"
                                Style="font-size: calc(1.1rem + 0.4vw); font-weight: 700;"
                                OnKeyDown="@(async (e) => { if (e.Key == "Enter" || e.Key == "NumpadEnter") await SaveTitle(); else if (e.Key == "Escape") CancelEditingTitle(); })"
                                Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Check"
                                OnAdornmentClick="SaveTitle" />
                            <MudIconButton Icon="@Icons.Material.Filled.Close" Size="Size.Small" OnClick="CancelEditingTitle" />
                        }
                        else if (_selectedAlbum.OwnerId == _currentUser?.Id)
                        {
                            <div class="d-flex align-center gap-2" style="cursor: pointer;" @onclick="StartEditingTitle">
                                <MudText Typo="Typo.h4" Style="font-weight: 700; font-size: calc(1.3rem + 0.6vw);">@_selectedAlbum.Title</MudText>
                                <MudTooltip Text="@Loc["Edit title"]">
                                    <MudIcon Icon="@Icons.Material.Filled.Edit" Size="Size.Small" Style="opacity: 0.4; font-size: 1.2rem;" />
                                </MudTooltip>
                            </div>
                        }
                        else
                        {
                            <MudText Typo="Typo.h4" Style="font-weight: 700; font-size: calc(1.3rem + 0.6vw);">@_selectedAlbum.Title</MudText>
                            <MudChip T="string" Color="Color.Info" Size="Size.Small" Variant="Variant.Outlined">@Loc["Shared with you"]</MudChip>
                        }
                    </div>
                </div>
                
                <div class="d-flex align-center gap-2 flex-wrap">
                    @if (_isAlbumLocked)
                    {
                        @if (_selectedAlbum.OwnerId == _currentUser?.Id)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAlbumAction" Class="rounded-lg">@Loc["Delete Album"]</MudButton>
                        }
                    }
                    else if (_isSelectionMode)
                    {
                        <MudButton Variant="Variant.Text" OnClick="ToggleSelectionMode">@Loc["Cancel"]</MudButton>
                        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteSelectedMediaAction" Disabled="@(!_selectedMediaIds.Any())" Class="rounded-lg">@string.Format(Loc["Delete Selected ({0})"].Value, _selectedMediaIds.Count)</MudButton>
                    }
                    else
                    {
                        @if (_selectedAlbum.Media.Any())
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Tv" OnClick="OpenSlideshowPairDialog" Class="rounded-lg">@Loc["Present to TV"]</MudButton>
                        }
                        @if (CanContribute(_selectedAlbum) && _selectedAlbum.Media.Any())
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Default" StartIcon="@Icons.Material.Filled.Checklist" OnClick="ToggleSelectionMode" Class="rounded-lg">@Loc["Select"]</MudButton>
                        }
                        @if (CanContribute(_selectedAlbum))
                        {
                                    <ApiFileUpload @ref="_fileUpload" Category="albums" ContextId="@_selectedAlbum.Id" MaximumFileCount="50"
                                UploadUrl="@GetUploadUrl()"
                                Accept="image/*,video/*"
                                CompressionMaxDim="3840" CompressionQuality="0.9"
                                OnUploadStartedWithCount="HandleUploadStarted"
                                OnDetailedProgressUpdate="HandleDetailedProgressUpdate"
                                OnUploadCompleted="HandleUploadCompleted"
                                OnUploadError="HandleUploadError">
                                <CustomContent>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" Class="rounded-lg">@Loc["Upload"]</MudButton>
                                </CustomContent>
                            </ApiFileUpload>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Chat" OnClick="OpenShareDialog" Class="rounded-lg">@Loc["Share"]</MudButton>
                        }
                        @if (_selectedAlbum.OwnerId == _currentUser?.Id)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Delete" OnClick="DeleteAlbumAction" Class="rounded-lg">@Loc["Delete Album"]</MudButton>
                        }
                    }
                </div>
            </div>

            <!-- Metadata Row -->
            <div class="d-flex flex-wrap align-center gap-2 mt-2 album-meta-row" style="margin-left: 52px;">
                <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(Loc["Created {0}"].Value, _selectedAlbum.CreatedAt.ToString("MMM dd, yyyy"))</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">•</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(Loc["By {0}"].Value, GetOwnerName(_selectedAlbum.OwnerId))</MudText>
                
                <MudDivider Vertical="true" FlexItem="true" Class="mx-1" Style="height: 16px; align-self: center;" />
                <MudText Typo="Typo.body2" Color="Color.Secondary">@string.Format(Loc["{0} items"].Value, _selectedAlbum.Media.Count)</MudText>
                
                @{
                    var dynamicSharedUserIds = GetDynamicSharedUserIds(_selectedAlbum);
                    bool isAudienceRestricted = PrivacyService.ShouldRestrictAlbumAudience(_selectedAlbum, _currentUser);
                    bool hasPublicAudience = isAudienceRestricted && _selectedAlbum.SharedWithChannelIds.Any(cId => {
                        var ch = Db.ChatChannels.GetById(cId);
                        return ch != null && (ch.IsPublicChannel || ch.IsAnnouncementOnly);
                    });
                }
                @* album-sharing-row: wraps as a unit on mobile (flex-nowrap) so Shared with and Contributors stay on one line *@
                <div class="album-sharing-row">
                    @* Always visible — every viewer benefits from seeing who has access *@
                    @if (true)
                    {
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1 d-none d-sm-flex" Style="height: 16px; align-self: center;" />
                        <div class="d-flex align-center gap-2" @onclick="OpenSharedWithDialog" style="cursor: pointer;" title="@Loc["View shared users"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Shared with"]</MudText>
                            @if (hasPublicAudience)
                            {
                                <MudChip T="string" Icon="@Icons.Material.Filled.Campaign" Size="Size.Small" Color="Color.Primary" Variant="Variant.Outlined" Class="ma-0">
                                    @Loc["Public Audience"]
                                </MudChip>
                            }
                            else
                            {
                                <MudAvatarGroup Max="3" Spacing="3" MaxColor="Color.Primary" Class="avatar-group-small avatar-group-xs">
                                    @if (dynamicSharedUserIds.Any())
                                    {
                                        @foreach(var userId in dynamicSharedUserIds)
                                        {
                                            var emp = _employees.FirstOrDefault(e => e.Id == userId);
                                            if (emp != null)
                                            {
                                                <EmployeeAvatar Employee="@emp" Size="Size.Small" />
                                            }
                                        }
                                    }
                                    else
                                    {
                                        <MudAvatar Size="Size.Small" Color="Color.Primary">
                                            <MudIcon Icon="@Icons.Material.Filled.Forum" Size="Size.Small" />
                                        </MudAvatar>
                                    }
                                </MudAvatarGroup>
                            }
                        </div>
                    }
                    @if (_selectedAlbum.ContributorUserIds.Any() || IsOwner(_selectedAlbum))
                    {
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-1" Style="height: 16px; align-self: center;" />
                        <div class="d-flex align-center gap-2" @onclick="OpenManageContributorsDialog" style="cursor: pointer;" title="@Loc["Manage contributors"]">
                            <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["Contributors"]</MudText>
                            @if (_selectedAlbum.ContributorUserIds.Any())
                            {
                                <MudAvatarGroup Max="3" Spacing="3" MaxColor="Color.Info" Class="avatar-group-small avatar-group-xs">
                                    @foreach(var userId in _selectedAlbum.ContributorUserIds)
                                    {
                                        var emp = _employees.FirstOrDefault(e => e.Id == userId);
                                        if (emp != null)
                                        {
                                            <EmployeeAvatar Employee="@emp" Size="Size.Small" />
                                        }
                                    }
                                </MudAvatarGroup>
                            }
                            else if (_selectedAlbum.OwnerId == _currentUser?.Id)
                            {
                                <MudIcon Icon="@Icons.Material.Filled.Add" Size="Size.Small" Color="Color.Secondary" />
                            }
                        </div>
                    }
                </div>
            </div>
        </div>
        
        @if (_isExternalDisplayConnected && _selectedAlbum.Media.Any())
        {
            <MudPaper Class="pa-3 mb-4 rounded-lg d-flex flex-column gap-2" Elevation="0" Outlined="true" 
                      Style="background: rgba(var(--mud-palette-primary-rgb), 0.05); border-color: rgba(var(--mud-palette-primary-rgb), 0.25);">
                <div class="d-flex align-center gap-2">
                    <MudIcon Icon="@Icons.Material.Filled.Tv" Color="Color.Primary" Size="Size.Medium" />
                    <div>
                        <MudText Typo="Typo.subtitle2" Style="font-weight: 700;">@Loc["External Screen Connected (Apple TV / AirPlay)"]</MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @Loc["Screen mirroring is active. Start the slideshow to present full-screen on the TV with phone remote control."]
                        </MudText>
                    </div>
                </div>

                <MudButton Variant="Variant.Filled"
                           Color="Color.Primary"
                           StartIcon="@Icons.Material.Filled.PlayArrow"
                           OnClick="StartExternalDisplayPresentation"
                           Disabled="@_isStartingPresentation"
                           Class="rounded-lg mt-1 py-2"
                           FullWidth="true">
                    @if (_isStartingPresentation)
                    {
                        <MudProgressCircular Indeterminate="true" Size="Size.Small" Class="mr-2" />
                        <span>@Loc["Starting Slideshow on TV..."]</span>
                    }
                    else
                    {
                        <span>@Loc["Start Slideshow on TV"]</span>
                    }
                </MudButton>
            </MudPaper>
        }

        @if (_isAlbumLocked)
        {
            bool isNotOnAccessList = !_selectedAlbum.EncryptedAlbumKeys.ContainsKey(_currentUser?.Id ?? "") 
                && !_selectedAlbum.EncryptedAlbumKeys.ContainsKey("Escrow")
                && !_selectedAlbum.SharedWithChannelIds.Any(cId => {
                    var ch = Db.ChatChannels.GetById(cId);
                    return ch != null && ch.EncryptedChannelKeys.ContainsKey(_currentUser?.Id ?? "");
                });

            <VaultLockView Title="@Loc["Secure Album"]"
                           Description="@Loc["This album is end-to-end encrypted. Enter your vault password to unlock your vault and view photos."]"
                           ButtonText="@Loc["Unlock Album"]"
                           SetupText="@Loc["This album is end-to-end encrypted. You must set up your secure Chat Vault password before you can view photos."]"
                           IsNotOnAccessList="@isNotOnAccessList"
                           NotOnAccessListText="@Loc["You are a contributor on this album, but your encryption key has not been generated yet. The album owner must open the album to provision your key."]"
                           MinHeight="360px"
                           CurrentUser="@_currentUser"
                           OnUnlocked="HandleVaultUnlockedInAlbums"
                           OnSetupCompleted="HandleVaultUnlockedInAlbums" />
        }
        else if (_selectedAlbum.Media.Any())
        {
            <MudGrid Spacing="3">
                @for (int i = 0; i < _selectedAlbum.Media.Count; i++)
                {
                    var index = i;
                    var media = _selectedAlbum.Media[i];
                    <MudItem xs="6" sm="4" md="3" lg="2" xl="2">
                        <MudCard Elevation="1" Class="album-media-card relative overflow-hidden cursor-pointer" Style="@($"{(_selectedMediaIds.Contains(media.Id) ? "border: 2px solid var(--mud-palette-primary); padding: 2px;" : "border: 2px solid transparent;")} height: 180px; border-radius: 12px; background: var(--mud-palette-background-grey);")" @onclick="() => HandleMediaClick(index, media)">
                            @if (media.ContentType.StartsWith("image/"))
                            {
                                <MudImage Src="@GetTokenizedUrl(media, true)" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%; object-fit: cover;" />
                            }
                            else if (media.ContentType.StartsWith("video/"))
                            {
                                if (media.HasServerThumbnail)
                                {
                                    <div style="position: relative; width: 100%; height: 100%;">
                                        <MudImage Src="@GetTokenizedUrl(media, true)" ObjectFit="ObjectFit.Cover" Style="width: 100%; height: 100%; object-fit: cover;" />
                                        <div class="d-flex flex-column align-center justify-center" style="position: absolute; inset: 0; background: rgba(0,0,0,0.4);">
                                            <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" Color="Color.Surface" Style="font-size: 3rem; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));" />
                                        </div>
                                    </div>
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-center justify-center h-100 w-100" style="background: #111; color: white;">
                                        <MudIcon Icon="@Icons.Material.Filled.PlayCircle" Size="Size.Large" Color="Color.Surface" Style="font-size: 3rem; filter: drop-shadow(0 2px 8px rgba(0,0,0,0.5));" />
                                        <MudText Typo="Typo.caption" Class="mt-1" Style="color: rgba(255,255,255,0.8);">@Loc["VIDEO"]</MudText>
                                    </div>
                                }
                            }
                            else
                            {
                                <div class="d-flex flex-column align-center justify-center h-100 w-100">
                                    <MudIcon Icon="@Icons.Material.Filled.InsertDriveFile" Size="Size.Large" Color="Color.Secondary" />
                                    <MudText Typo="Typo.caption" Class="mt-1">@media.FileName</MudText>
                                </div>
                            }

                            @if (_isSelectionMode)
                            {
                                <div class="d-flex align-center justify-center" style="position: absolute; top: 8px; right: 8px; width: 24px; height: 24px; border-radius: 50%; border: 2px solid white; background: @(_selectedMediaIds.Contains(media.Id) ? "var(--mud-palette-primary)" : "rgba(0,0,0,0.3)"); z-index: 10;">
                                    @if (_selectedMediaIds.Contains(media.Id))
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Size="Size.Small" Style="color: white; font-size: 16px;" />
                                    }
                                </div>
                            }

                            @if (!_isSelectionMode)
                            {
                                @* Hover Dark Gradient & Zoom Overlay *@
                                <div class="media-hover-overlay d-flex align-center justify-center desktop-only-hover">
                                    <MudIcon Icon="@Icons.Material.Filled.ZoomIn" Color="Color.Surface" Size="Size.Medium" />
                                </div>

                                @if (CanDeleteMedia(_selectedAlbum, media))
                                {
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" 
                                        Class="media-delete-btn desktop-only-hover"
                                        Style="position: absolute; top: 6px; right: 6px; background: rgba(0,0,0,0.6); color: white; transition: opacity 0.2s;"
                                        OnClick="@((e) => DeleteMediaAction(media))" title="@Loc["Delete media"]" />
                                }
                            }
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudPaper Class="d-flex flex-column align-center justify-center pa-10 text-center my-6" Style="min-height: 320px; border-radius: 16px; border: 2px dashed var(--mud-palette-lines-default);" Elevation="0" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Primary" Class="mb-3" Style="font-size: 4rem; opacity: 0.7;" />
                <MudText Typo="Typo.h6" Style="font-weight: 600;">@Loc["This album is empty"]</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4" Style="max-width: 400px;">
                    @Loc["Upload photos and videos to start building your collection."]
                </MudText>
                @if (CanContribute(_selectedAlbum))
                {
                    <ApiFileUpload @ref="_fileUpload" Category="albums" ContextId="@_selectedAlbum.Id" MaximumFileCount="50"
                                UploadUrl="@GetUploadUrl()"
                                Accept="image/*,video/*"
                                CompressionMaxDim="3840" CompressionQuality="0.9"
                        OnUploadStartedWithCount="HandleUploadStarted"
                        OnDetailedProgressUpdate="HandleDetailedProgressUpdate"
                        OnUploadCompleted="HandleUploadCompleted"
                        OnUploadError="HandleUploadError">
                        <CustomContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Upload" Class="rounded-lg">@Loc["Upload"]</MudButton>
                        </CustomContent>
                    </ApiFileUpload>
                }
            </MudPaper>
        }
    </div>
}
else
{
    @* --- ALBUMS LIST / DASHBOARD VIEW --- *@
    <div>
        <!-- Page Header -->
        <div class="d-flex flex-wrap justify-space-between align-start mb-6 gap-4">
            <div class="d-none d-sm-block">
                <MudText Typo="Typo.h4" Style="font-weight: 700;">@Loc["Albums"]</MudText>
                <MudText Typo="Typo.body1" Color="Color.Secondary">@Loc["Share your photos and videos with other users of the server."]</MudText>
            </div>
            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAlbumDialog" Class="rounded-lg py-2 px-4 d-none d-sm-flex" Style="font-weight: 600;">@Loc["New Album"]</MudButton>
        </div>

        <!-- Toolbar & Filter Controls -->
        <div class="d-flex flex-wrap align-center justify-space-between gap-4 mb-6">
            <MudToggleGroup T="int" Value="activeTabIndex" ValueChanged="UpdateActiveTab" Outlined="true" Delimiters="true" CheckMark="false" Class="flex-wrap" >
                <MudToggleItem Value="0" Text="@Loc["All"]" UnselectedIcon="@Icons.Material.Filled.PhotoLibrary" SelectedIcon="@Icons.Material.Filled.PhotoLibrary" />
                <MudToggleItem Value="1" Text="@Loc["My Albums"]" UnselectedIcon="@Icons.Material.Filled.Collections" SelectedIcon="@Icons.Material.Filled.Collections" />
                <MudToggleItem Value="2" Text="@Loc["Shared"]" UnselectedIcon="@Icons.Material.Filled.People" SelectedIcon="@Icons.Material.Filled.People" />
            </MudToggleGroup>

            <MudTextField @bind-Value="searchString" Placeholder="@Loc["Search albums..."]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" Class="flex-grow-1" Style="max-width: 420px; background-color: var(--mud-palette-surface); border-radius: 8px;" Clearable="true" DebounceInterval="500" />
        </div>

        <!-- Album Cards Grid -->
        @if (FilteredAlbums.Any())
        {
            <MudGrid Spacing="3">
                @foreach (var album in FilteredAlbums)
                {
                    var isOwner = IsOwner(album);
                    var ownerName = GetOwnerName(album.OwnerId);
                    <MudItem xs="12" sm="6" md="4" lg="3" xl="2">
                        <MudCard Elevation="1" Class="album-card cursor-pointer h-100 d-flex flex-column" Style="border-radius: 16px; overflow: hidden; border: 1px solid var(--mud-palette-lines-default);" @onclick="() => SelectAlbum(album)">
                            <MudPaper Class="relative overflow-hidden flex-shrink-0 d-flex align-center justify-center" Style="height: 180px; background: var(--mud-palette-background-grey);" Elevation="0">
                                @{
                                    bool isCoverLocked = IsAlbumLocked(album, out _);
                                }
                                @if (album.Media.Any())
                                {
                                    @if (isCoverLocked)
                                    {
                                        <div class="d-flex flex-column align-center justify-center h-100 w-100 text-secondary">
                                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Style="font-size: 3rem; color: var(--mud-palette-primary);" />
                                        </div>
                                    }
                                    else
                                    {
                                        <MudImage Src="@GetTokenizedUrl(album, album.Media.First(), true)" ObjectFit="ObjectFit.Cover" Class="album-cover-img" Style="width: 100%; height: 100%; object-fit: cover; transition: transform 0.3s ease;" />
                                    }
                                }
                                else
                                {
                                    <div class="d-flex flex-column align-center justify-center text-secondary">
                                        <MudIcon Icon="@(isCoverLocked ? Icons.Material.Filled.Lock : Icons.Material.Filled.PhotoAlbum)" Size="Size.Large" Style="@(isCoverLocked ? "font-size: 3rem; color: var(--mud-palette-primary);" : "font-size: 3.5rem; opacity: 0.4;")" />
                                    </div>
                                }
                                
                                @* Item count badge *@
                                <div style="position: absolute; bottom: 8px; right: 8px; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); color: white; padding: 3px 10px; border-radius: 12px; font-size: 0.75rem; font-weight: 600;">
                                    @(album.Media.Count == 1 ? string.Format(Loc["{0} item"].Value, album.Media.Count) : string.Format(Loc["{0} items"].Value, album.Media.Count))
                                </div>

                                @* Shared indicator badge *@
                                @if (!isOwner)
                                {
                                    <div style="position: absolute; top: 8px; left: 8px; background: var(--mud-palette-info); color: white; padding: 2px 8px; border-radius: 8px; font-size: 0.7rem; font-weight: 600;" class="d-flex align-center gap-1">
                                        <MudIcon Icon="@Icons.Material.Filled.People" Size="Size.Small" Style="font-size: 12px;" />
                                        @Loc["Shared"]
                                    </div>
                                }

                                @if (isCoverLocked)
                                {
                                    <div style="position: absolute; top: 8px; right: 8px; background: rgba(0,0,0,0.65); backdrop-filter: blur(4px); color: white; padding: 2px 8px; border-radius: 8px; font-size: 0.7rem; font-weight: 600;" class="d-flex align-center gap-1">
                                        <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Small" Style="font-size: 12px;" />
                                        @Loc["Locked"]
                                    </div>
                                }
                            </MudPaper>
                            
                            <MudCardContent Class="pa-4 flex-grow-1 d-flex flex-column justify-space-between">
                                <div>
                                    <div class="d-flex align-start justify-space-between gap-1">
                                        <MudText Typo="Typo.subtitle1" Style="font-weight: 700; line-height: 1.3;" Class="text-truncate">@album.Title</MudText>
                                        <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Small" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Dense="true" @onclick:stopPropagation="true">
                                            <MudMenuItem Icon="@Icons.Material.Filled.FolderOpen" OnClick="() => SelectAlbum(album)">@Loc["Open"]</MudMenuItem>
                                            @if (CanContribute(album))
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Share" OnClick="() => OpenShareDialogFor(album)">@Loc["Share to Chat"]</MudMenuItem>
                                            }
                                            @if (isOwner)
                                            {
                                                <MudMenuItem Icon="@Icons.Material.Filled.Delete" IconColor="Color.Error" OnClick="() => DeleteSpecificAlbumAction(album)">@Loc["Delete"]</MudMenuItem>
                                            }
                                        </MudMenu>
                                    </div>
                                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">
                                        @if (isOwner)
                                        {
                                            <span>@string.Format(Loc["Created {0}"].Value, album.CreatedAt.ToString("MMM dd, yyyy"))</span>
                                        }
                                        else
                                        {
                                            <span>@string.Format(Loc["By {0}"].Value, ownerName)</span>
                                        }
                                    </MudText>
                                </div>
                            </MudCardContent>
                        </MudCard>
                    </MudItem>
                }
            </MudGrid>
        }
        else
        {
            <MudPaper Class="d-flex flex-column align-center justify-center pa-10 text-center mt-4" Style="min-height: 280px; border-radius: 16px;" Elevation="0" Outlined="true">
                <MudIcon Icon="@Icons.Material.Filled.PhotoLibrary" Color="Color.Secondary" Style="font-size: 3.5rem; opacity: 0.5;" Class="mb-3" />
                @if (!string.IsNullOrWhiteSpace(searchString))
                {
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@Loc["No matching albums found"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Loc["Try adjusting your search query or clear filters."]</MudText>
                }
                else if (activeTabIndex == 1)
                {
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@Loc["You haven't created any albums yet"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-4">@Loc["Create your first album to start organizing photos and videos."]</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAlbumDialog" Class="rounded-lg">@Loc["Create Album"]</MudButton>
                }
                else if (activeTabIndex == 2)
                {
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@Loc["No shared albums yet"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1">@Loc["Albums shared with you by other members will appear here."]</MudText>
                }
                else
                {
                    <MudText Typo="Typo.h6" Style="font-weight: 600;">@Loc["No albums available"]</MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mt-1 mb-4">@Loc["Get started by creating your first album."]</MudText>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add" OnClick="OpenCreateAlbumDialog" Class="rounded-lg">@Loc["Create Album"]</MudButton>
                }
            </MudPaper>
        }

        @* Mobile-only FAB — fixed bottom-right, hidden on sm+ *@
        <MudFab Color="Color.Primary"
                StartIcon="@Icons.Material.Filled.Add"
                Label="@Loc["New Album"]"
                OnClick="OpenCreateAlbumDialog"
                Class="album-fab d-sm-none" />
    </div>
}

</MudContainer>

