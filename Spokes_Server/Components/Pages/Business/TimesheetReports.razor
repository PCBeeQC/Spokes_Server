@page "/business/timesheet-reports"
@attribute [Authorize(Policy = AppPermissions.Timesheets.ViewReport)]
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Helpers
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Reports
@using Spokes_Server.Core.Services.Reports
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Pages.Business.Reports

@inject Database Db
@inject ITimesheetReportService ReportService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject IDialogService DialogService
@inject NavigationManager NavManager
@inject AuthenticationStateProvider AuthStateProvider

<style>
    @@media print {
        .d-print-none,
        .mud-tabs-tabbar,
        .mud-table-pagination,
        .mud-table-toolbar {
            display: none !important;
        }

        #printable-area {
            padding: 10mm 12mm !important;
            background: white !important;
            color: black !important;
        }

        #printable-area .mud-table-container {
            height: auto !important;
            max-height: none !important;
            overflow: visible !important;
        }

        #printable-area .mud-paper {
            border: 1px solid #ddd !important;
            box-shadow: none !important;
            background: white !important;
            color: black !important;
        }

        #printable-area .border-r {
            border-right: 1px solid #ccc !important;
        }
    }
</style>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="mt-6 mb-16 pb-16">
    @if (_loading)
    {
        <div class="d-flex justify-center align-center py-16">
            <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
        </div>
    }
    else
    {
        <!-- Page Header & Global Report Toolbar -->
        <MudStack Row="true" Justify="Justify.SpaceBetween" AlignItems="AlignItems.Center" Class="mb-4 flex-wrap gap-4 d-print-none">
            <div>
                <MudText Typo="Typo.h4" Style="font-weight: 700;">Timesheet Reports</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">Track team productivity, billability, project allocation, and financial performance.</MudText>
            </div>

            <!-- Action Controls Matching Clockify Toolbar -->
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="2" Class="flex-wrap">
                <MudIconButton Icon="@Icons.Material.Filled.Print" Variant="Variant.Outlined" Title="Print Report" OnClick="PrintReport" Size="Size.Small" />

                <MudMenu Icon="@Icons.Material.Filled.FileDownload" Variant="Variant.Outlined" Title="Export" Size="Size.Small" Dense="true">
                    <MudMenuItem Icon="@Icons.Material.Filled.TableChart" OnClick="ExportSummaryCsv">Export Summary (CSV)</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.ListAlt" OnClick="ExportDetailedCsv">Export Detailed (CSV)</MudMenuItem>
                    <MudMenuItem Icon="@Icons.Material.Filled.CalendarViewWeek" OnClick="ExportWeeklyCsv">Export Weekly Matrix (CSV)</MudMenuItem>
                </MudMenu>

                <MudDivider Vertical="true" FlexItem="true" Class="mx-1 my-2" />

                <!-- Dynamic Rounding Toggle -->
                <MudTooltip Text="Dynamically round logged hours based on company timesheet settings">
                    <MudSwitch T="bool" Value="_applyRounding" ValueChanged="OnRoundingToggled" Label="Rounding" Color="Color.Primary" />
                </MudTooltip>

                <!-- Duration Format Toggle (hh:mm vs 0.00h) -->
                <MudButton Variant="Variant.Outlined" Color="Color.Default" Size="Size.Small" OnClick="ToggleFormat">
                    @(_format == TimeDisplayFormat.Duration_HHMM ? "hh:mm" : "0.00h")
                </MudButton>

                <!-- Amount Display Dropdown -->
                <MudMenu Label="@GetAmountModeLabel()" Variant="Variant.Outlined" Size="Size.Small" EndIcon="@Icons.Material.Filled.ArrowDropDown">
                    <MudMenuItem OnClick="@(() => SetAmountMode(AmountDisplayMode.BillableAmount))">Billable Amount ($)</MudMenuItem>
                    <MudMenuItem OnClick="@(() => SetAmountMode(AmountDisplayMode.CostAmount))">Labor Cost ($)</MudMenuItem>
                    <MudMenuItem OnClick="@(() => SetAmountMode(AmountDisplayMode.ProfitMargin))">Profit Margin ($)</MudMenuItem>
                    <MudMenuItem OnClick="@(() => SetAmountMode(AmountDisplayMode.HideAmounts))">Hide Financials</MudMenuItem>
                </MudMenu>
            </MudStack>
        </MudStack>

        <!-- Filter Bar -->
        <TimesheetFilterBar Criteria="@_criteria" DateRange="@_dateRange" DateRangeChanged="@(r => _dateRange = r)" OnFiltersApplied="ApplyFilters" OnPresetSelected="HandlePresetSelected" OnShiftDate="HandleShiftDate" AllEmployees="@_allEmployees" AllTeams="@_allTeams" AllProjects="@_allProjects" AllProjectGroups="@_allProjectGroups" AllClients="@_allClients" AllTasks="@_allTasks" />

        <div id="printable-area">
            <!-- Print-Only Header -->
            <div class="d-none d-print-block mb-4">
                <div class="d-flex justify-space-between align-center mb-2">
                    <div>
                        @if (_companyProfile?.HasCustomLogo == true)
                        {
                            <img src="/spokesapi/Media/Logo?v=@_companyProfile.LogoVersion" style="max-height: 48px; object-fit: contain; margin-bottom: 6px; display: block;" />
                        }
                        <MudText Typo="Typo.h5" Style="font-weight: 700; color: #111;">@(_companyProfile?.CompanyName ?? "Spokes")</MudText>
                        <MudText Typo="Typo.subtitle1" Style="font-weight: 600; color: #444;">Timesheet Report &mdash; @GetActiveTabTitle()</MudText>
                    </div>
                    <div style="text-align: right;">
                        <MudText Typo="Typo.body2" Style="color: #222;"><b>Period:</b> @(_dateRange.Start?.ToString("dd MMM yyyy") ?? "-") &ndash; @(_dateRange.End?.ToString("dd MMM yyyy") ?? "-")</MudText>
                        <MudText Typo="Typo.caption" Style="color: #666;">Generated on @DateTime.Now.ToString("yyyy-MM-dd HH:mm")</MudText>
                    </div>
                </div>
                <hr style="border: 0; border-top: 2px solid #222; margin: 8px 0 16px 0;" />
            </div>

            <!-- KPI Metrics Banner (Matching Clockify Summary Row) -->
            <MudPaper Elevation="0" Outlined="true" Class="pa-4 mb-4 rounded-lg" Style="background: var(--mud-palette-surface);">
                <MudGrid Class="align-center">
                    <MudItem xs="12" sm="6" md="3" Class="border-r">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600;">Total Duration</MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--mud-palette-text-primary);">
                            @ReportService.FormatDuration(_kpiSummary.TotalHours, _format)
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Across @_kpiSummary.EntriesCount entries</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3" Class="border-r">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600;">Billable Duration</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Baseline" Spacing="2">
                            <MudText Typo="Typo.h4" Style="font-weight: 800; color: #10B981;">
                                @ReportService.FormatDuration(_kpiSummary.BillableHours, _format)
                            </MudText>
                            <MudChip T="string" Color="Color.Success" Size="Size.Small" Variant="Variant.Text" Style="font-weight: 700;">
                                @_kpiSummary.BillablePercentage%
                            </MudChip>
                        </MudStack>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">Non-billable: @ReportService.FormatDuration(_kpiSummary.NonBillableHours, _format)</MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3" Class="border-r">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600;">
                            @(_amountMode == AmountDisplayMode.CostAmount ? "Total Labor Cost" : _amountMode == AmountDisplayMode.ProfitMargin ? "Net Profit" : "Billable Revenue")
                        </MudText>
                        <MudText Typo="Typo.h4" Style="font-weight: 800; color: var(--mud-palette-primary);">
                            @if (_amountMode == AmountDisplayMode.CostAmount)
                            {
                                @ReportService.FormatCurrency(_kpiSummary.CostAmount)
                            }
                            else if (_amountMode == AmountDisplayMode.ProfitMargin)
                            {
                                <span>@ReportService.FormatCurrency(_kpiSummary.ProfitAmount)</span>
                            }
                            else
                            {
                                @ReportService.FormatCurrency(_kpiSummary.BillableAmount)
                            }
                        </MudText>
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @if (_amountMode == AmountDisplayMode.ProfitMargin)
                            {
                                <span>Margin: @_kpiSummary.ProfitMarginPercentage%</span>
                            }
                            else
                            {
                                <span>Based on project & work type rates</span>
                            }
                        </MudText>
                    </MudItem>

                    <MudItem xs="12" sm="6" md="3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Style="text-transform: uppercase; font-weight: 600;">Active Scopes</MudText>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3" Class="mt-1">
                            <div>
                                <MudText Typo="Typo.h5" Style="font-weight: 700;">@_kpiSummary.ActiveProjectsCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Projects</MudText>
                            </div>
                            <MudDivider Vertical="true" FlexItem="true" Style="height: 28px;" />
                            <div>
                                <MudText Typo="Typo.h5" Style="font-weight: 700;">@_kpiSummary.ActiveEmployeesCount</MudText>
                                <MudText Typo="Typo.caption" Color="Color.Secondary">Employees</MudText>
                            </div>
                        </MudStack>
                    </MudItem>
                </MudGrid>
            </MudPaper>

            <!-- Report Tabs: Summary, Detailed, Weekly -->
            <MudTabs @bind-ActivePanelIndex="_activeTabIndex" ApplyEffectsToContainer="true" Elevation="0" Rounded="true" PanelClass="pt-4" HeaderClass="d-print-none">
                <MudTabPanel Text="Summary" Icon="@Icons.Material.Filled.PieChart">
                    <TimesheetSummaryTab Entries="@_filteredEntries" Format="@_format" AmountMode="@_amountMode" ApplyRounding="@_applyRounding" />
                </MudTabPanel>

                <MudTabPanel Text="Detailed" Icon="@Icons.Material.Filled.List">
                    <TimesheetDetailedTab Entries="@_filteredEntries" Format="@_format" AmountMode="@_amountMode" />
                </MudTabPanel>

                <MudTabPanel Text="Weekly" Icon="@Icons.Material.Filled.CalendarViewWeek">
                    <TimesheetWeeklyTab Entries="@_filteredEntries" Format="@_format" AmountMode="@_amountMode" CurrentWeekDate="@(_dateRange.Start ?? DateTime.Now)" />
                </MudTabPanel>
            </MudTabs>
        </div>
    }
</MudContainer>

@code {
    private bool _loading = true;
    private int _activeTabIndex = 0;
    private CompanyProfile? _companyProfile;

    private DateRange _dateRange = new();
    private TimesheetReportFilterCriteria _criteria = new();
    private bool _applyRounding = false;
    private TimeDisplayFormat _format = TimeDisplayFormat.Duration_HHMM;
    private AmountDisplayMode _amountMode = AmountDisplayMode.BillableAmount;

    private List<TimesheetReportEntry> _allEntries = [];
    private List<TimesheetReportEntry> _filteredEntries = [];
    private TimesheetKPISummary _kpiSummary = new();

    private List<Employee> _allEmployees = [];
    private List<Team> _allTeams = [];
    private List<Project> _allProjects = [];
    private List<ProjectGroup> _allProjectGroups = [];
    private List<string> _allClients = [];
    private List<WorkType> _allTasks = [];

    protected override async Task OnInitializedAsync()
    {
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        if (!authState.User.Identity?.IsAuthenticated ?? false)
        {
            NavManager.NavigateTo("/", true);
            return;
        }

        _companyProfile = Db.CompanyProfile.Get();
        _allEmployees = Db.Employees.GetAll();
        _allTeams = Db.Teams.GetAll();
        _allProjects = Db.Projects.GetAll();
        _allProjectGroups = Db.ProjectGroups.GetAll();
        _allTasks = Db.WorkTypes.GetAll();

        _allClients = _allProjects
            .Where(p => p.Client != null && !string.IsNullOrWhiteSpace(p.Client.BusinessName))
            .Select(p => p.Client!.BusinessName)
            .Distinct(StringComparer.OrdinalIgnoreCase)
            .ToList();

        // Default to current month
        _dateRange = ReportService.GetPresetDateRange("This Month");
        _criteria.StartDate = _dateRange.Start;
        _criteria.EndDate = _dateRange.End;

        // Select all entities by default
        _criteria.SelectedEmployees = _allEmployees.Select(e => e.Id).ToList();
        _criteria.TotalEmployeesCount = _allEmployees.Count;
        _criteria.SelectedTeams = _allTeams.Select(t => t.Id).ToList();
        _criteria.TotalTeamsCount = _allTeams.Count;
        _criteria.SelectedProjects = _allProjects.Select(p => p.Id).ToList();
        _criteria.TotalProjectsCount = _allProjects.Count;
        _criteria.SelectedClients = _allClients.ToList();
        _criteria.TotalClientsCount = _allClients.Count;
        _criteria.SelectedTasks = _allTasks.Select(t => t.Id).ToList();
        _criteria.TotalTasksCount = _allTasks.Count;
        _criteria.BillableStatus = BillableFilterStatus.All;

        _allEntries = await ReportService.LoadAllEntriesAsync();
        ApplyFilters();

        _loading = false;
    }

    private void ApplyFilters()
    {
        _criteria.StartDate = _dateRange.Start;
        _criteria.EndDate = _dateRange.End;

        _filteredEntries = ReportService.ApplyFiltersAndRounding(_allEntries, _criteria, _applyRounding);
        _kpiSummary = ReportService.CalculateKPISummary(_filteredEntries);

        StateHasChanged();
    }

    private void HandlePresetSelected(string preset)
    {
        _dateRange = ReportService.GetPresetDateRange(preset);
        ApplyFilters();
    }

    private void HandleShiftDate(int direction)
    {
        _dateRange = ReportService.ShiftDateRange(_dateRange, direction);
        ApplyFilters();
    }

    private void OnRoundingToggled(bool value)
    {
        _applyRounding = value;
        ApplyFilters();
    }

    private void ToggleFormat()
    {
        _format = _format == TimeDisplayFormat.Duration_HHMM
            ? TimeDisplayFormat.Decimal_Hours
            : TimeDisplayFormat.Duration_HHMM;
    }

    private void SetAmountMode(AmountDisplayMode mode)
    {
        _amountMode = mode;
    }

    private string GetAmountModeLabel() => _amountMode switch
    {
        AmountDisplayMode.BillableAmount => "Billable Amount",
        AmountDisplayMode.CostAmount => "Labor Cost",
        AmountDisplayMode.ProfitMargin => "Profit Margin",
        AmountDisplayMode.HideAmounts => "Hide Financials",
        _ => "Amount"
    };

    private string GetActiveTabTitle() => _activeTabIndex switch
    {
        0 => "Summary",
        1 => "Detailed",
        2 => "Weekly Matrix",
        _ => "Summary"
    };

    private async Task PrintReport()
    {
        await JS.InvokeVoidAsync("window.print");
    }

    private async Task ExportSummaryCsv()
    {
        var groups = ReportService.BuildSummaryGroups(_filteredEntries, ReportGroupBy.Project, ReportSubGroupBy.Description);
        var csv = ReportService.GenerateSummaryCsv(groups, _format);
        var fileName = $"timesheet_summary_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv", csv);
        Snackbar.Add("Summary CSV exported", Severity.Success);
    }

    private async Task ExportDetailedCsv()
    {
        var csv = ReportService.GenerateDetailedCsv(_filteredEntries, _format);
        var fileName = $"timesheet_detailed_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv", csv);
        Snackbar.Add("Detailed CSV exported", Severity.Success);
    }

    private async Task ExportWeeklyCsv()
    {
        var matrix = ReportService.BuildWeeklyMatrix(_filteredEntries, _dateRange.Start ?? DateTime.Now, WeeklyGroupBy.Employee);
        var csv = ReportService.GenerateWeeklyCsv(matrix, _format);
        var fileName = $"timesheet_weekly_{DateTime.Now:yyyyMMdd_HHmmss}.csv";
        await JS.InvokeVoidAsync("downloadFile", fileName, "text/csv", csv);
        Snackbar.Add("Weekly matrix CSV exported", Severity.Success);
    }
}
