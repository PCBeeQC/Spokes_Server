    private async Task OpenItem(AccountingItem item)
    {
        if (item.Type == "Expense")
        {
            var r = (ExpenseReport)item.OriginalItem;
            var parameters = new DialogParameters { ["Report"] = r, ["IsReadOnly"] = true };
            await DialogService.ShowAsync<ExpenseReportDialog>("Expense Report", parameters, new DialogOptions
                {
                    MaxWidth =
                MaxWidth.Medium,
                    FullWidth = true
                });
        }
        else if (item.Type == "Bill")
        {
            var b = (Bill)item.OriginalItem;
            var parameters = new DialogParameters { ["Bill"] = b };
            var dialog = await DialogService.ShowAsync<BillEditorDialog>("Bill Details", parameters, new DialogOptions
                {
                    MaxWidth = MaxWidth.ExtraExtraLarge,
                    FullWidth = true,
                    CloseButton = true
                });
            var result = await dialog.Result;
            if (result != null && !result.Canceled && result.Data is Bill bResult) { Db.Bills.Save(bResult); Refresh(); }
        }
        else if (item.Type == "PO")
        {
            var b = (Bill)item.OriginalItem;
            Nav.NavigateTo($"/purchases/{b.PurchaseOrderId}");
        }
        else if (item.Type == "Invoice")
        {
            // Invoices need ProjectID to construct URL
            var inv = (Invoice)item.OriginalItem;
            Nav.NavigateTo($"/projects/{inv.ProjectId}/invoices/{inv.Id}");
        }
        else if (item.Type == "Commission" || item.Type == "Clawback")
        {
            var record = (CommissionLedgerRecord)item.OriginalItem;
            Nav.NavigateTo($"/projects/{record.ProjectId}");
        }
    }

    private async Task MarkPaid(AccountingItem item)
    {
        if (item.Type == "Expense" || item.Type == "Commission" || item.Type == "Clawback")
        {
            var parameters = new DialogParameters<ConfirmPaymentDateDialog>
            {
                { x => x.Message, $"Are you sure you want to mark this {item.Type} ({item.Number}) as paid?" }
            };
            var dialog = await DialogService.ShowAsync<ConfirmPaymentDateDialog>("Confirm Payment", parameters);
            var result = await dialog.Result;

            if (!result.Canceled && result.Data is DateTime datePaid)
            {
                if (item.Type == "Expense")
                {
                    var r = (ExpenseReport)item.OriginalItem;
                    r.DatePaid = datePaid;
                    Db.ExpenseReports.Save(r);
                }
                else
                {
                    var record = (CommissionLedgerRecord)item.OriginalItem;
                    record.Status = "Paid";
                    record.DatePaid = datePaid;
                    Db.CommissionLedgerRecords.Save(record);
                }
                Snackbar.Add($"{item.Type} marked as paid on {datePaid.ToShortDateString()}", Severity.Success);
                Refresh();
            }
        }
        else
        {
            List<PaymentRecord>? existingPayments = null;
            if (item.OriginalItem is Bill b) existingPayments = b.Payments;
            else if (item.OriginalItem is Invoice inv) existingPayments = inv.Payments;

            var parameters = new DialogParameters<RecordPaymentDialog>
            {
                { x => x.Message, $"Record payment for {item.Type} ({item.Number})" },
                { x => x.MaxAmount, item.Balance },
                { x => x.ExistingPayments, existingPayments }
            };
            var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Payment", parameters);
            var result = await dialog.Result;

            if (!result.Canceled && result.Data is PaymentRecord payment)
            {
                if (item.Type == "Bill" || item.Type == "PO")
                {
                    var bill = (Bill)item.OriginalItem;
                    bill.Payments.Add(payment);
                    if (bill.BalanceDue <= 0)
                    {
                        bill.Status = "Paid";
                        bill.DatePaid = payment.Date;
                    }
                    Db.Bills.Save(bill);
                }
                else if (item.Type == "Invoice")
                {
                    var inv = (Invoice)item.OriginalItem;
                    var oldStatus = inv.Status;
                    inv.Payments.Add(payment);
                    if (inv.BalanceDue <= 0)
                    {
                        inv.Status = "Paid";
                        inv.DatePaid = payment.Date;
                    }
                    Db.Invoices.Save(inv);
                    if (inv.Status == "Paid" && oldStatus != "Paid")
                    {
                        Spokes_Server.Core.Services.Projects.TimelineEventHelper.ProcessInvoiceStatusChange(Db, inv, oldStatus, "Paid", null);
                    }
                }
                Snackbar.Add($"Payment of {payment.Amount:C} recorded on {payment.Date.ToShortDateString()}", Severity.Success);
                Refresh();
            }
        }
    }

    private bool FilterFuncPayables(AccountingItem element) => FilterFunc(element, searchPayables);
    private bool FilterFuncReceivables(AccountingItem element) => FilterFunc(element, searchReceivables);
    private bool FilterFuncHistory(AccountingItem element) => FilterFunc(element, searchHistory);

    private bool FilterFunc(AccountingItem element, string searchString)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.Number?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (element.Entity?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (element.ClientName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        if (element.ProjectName?.Contains(searchString, StringComparison.OrdinalIgnoreCase) ?? false) return true;
        return false;
    }

    // --- Recurring Expense Helpers ---
    private DateTime GetCurrentPeriodStart(RecurringExpense expense)
    {
        var start = expense.CreatedDate;
        var today = DateTime.Today;
        var current = start;

        while (true)
        {
            var next = GetNextPeriodDate(expense, current);
            if (next > today) return current;
            current = next;
        }
    }

    private DateTime GetNextPeriodDate(RecurringExpense expense, DateTime current) => expense.Frequency switch
    {
        RecurringExpenseFrequency.Weekly => current.AddDays(7),
        RecurringExpenseFrequency.BiWeekly => current.AddDays(14),
        RecurringExpenseFrequency.Monthly => current.AddMonths(1),
        RecurringExpenseFrequency.Yearly => current.AddYears(1),
        _ => current.AddMonths(1)
    };

    private async Task UploadRecurringBill(AccountingItem item)
    {
        if (item.OriginalItem is not RecurringExpense expense) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var parameters = new DialogParameters<Spokes_Server.Components.Pages.BusinessExpenses.RecurringExpenseDialog>
{
{ x => x.Expense, expense },
{ x => x.IsNew, false },
{ x => x.ActiveTabIndex, 1 }
};

        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Pages.BusinessExpenses.RecurringExpenseDialog>(
        "Upload Bill - " + expense.Name, parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is RecurringExpense updated)
        {
            Db.RecurringExpenses.Save(updated);
            Snackbar.Add("Bill uploaded", Severity.Success);
            Refresh();
        }
    }

    private async Task MarkRecurringPaid(AccountingItem item)
    {
        if (item.OriginalItem is not RecurringExpense expense || item.RecurringRecord == null) return;

        var parameters = new DialogParameters<RecordPaymentDialog>
        {
            { x => x.Message, $"Record payment for recurring bill '{expense.Name}'?" },
            { x => x.MaxAmount, item.Balance },
            { x => x.ExistingPayments, item.RecurringRecord.Payments }
        };
        var dialog = await DialogService.ShowAsync<RecordPaymentDialog>("Record Payment", parameters);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is PaymentRecord payment)
        {
            item.RecurringRecord.Payments.Add(payment);
            if (item.RecurringRecord.BalanceDue <= 0)
            {
                item.RecurringRecord.IsPaid = true;
                item.RecurringRecord.DatePaid = payment.Date;
            }

            Db.RecurringExpenses.Save(expense);
            Snackbar.Add($"Payment of {payment.Amount:C} recorded", Severity.Success);
            Refresh();
        }
    }



    private void HandleBillUploadCompleted(AccountingItem item, List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0 || item.OriginalItem is not RecurringExpense expense || item.RecurringRecord == null) return;
        
        try
        {
            var result = results.First();
            item.RecurringRecord.AttachmentPath = $"/spokesapi/files/download/{result.FilePath}";
            item.RecurringRecord.AttachmentName = result.FileName;
            
            Db.RecurringExpenses.Save(expense);
            Snackbar.Add("File uploaded successfully", Severity.Success);
            Refresh();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
    }

    [SupplyParameterFromQuery] public string? Tab { get; set; }
    private int activeTabIndex = 0;

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Tab))
        {
            activeTabIndex = Tab.ToLower() switch
            {
                "manage" => 0,
                "payables" => 1,
                "receivables" => 2,
                "history" => 3,
                _ => 1 // Default to payables if unknown or empty
            };
        }
    }

    private bool _isDisposed;

    public void Dispose()
    {
        _isDisposed = true;
    }

    private void UpdateActiveTab(int index)
    {
        if (_isDisposed) return;

        activeTabIndex = index;

        if (!Nav.Uri.Contains("/business/accounting", StringComparison.OrdinalIgnoreCase))
            return;

        var tabName = index switch
        {
            0 => "manage",
            1 => "payables",
            2 => "receivables",
            3 => "history",
            _ => "payables"
        };
        
        try
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", tabName), replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
        }
    }
