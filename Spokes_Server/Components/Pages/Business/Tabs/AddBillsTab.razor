@using Spokes_Server.Core.Data
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Accounting
@inject Database Db
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@using Spokes_Server.Components.Pages.BusinessExpenses
@using Spokes_Server.Components.Pages.BusinessExpenses.Tabs

<MudPaper Class="pa-4 mb-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-3">Manage Actual Bills</MudText>
    
    <div class="d-flex mb-4 gap-4">
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            OnClick="AddBill">Add Recurring Bill</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
            OnClick="AddOneTimeBill">Add One-Time Bill</MudButton>
        <MudButton Variant="Variant.Filled" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.ImportExport"
            OnClick="ImportEstimates">Import from Estimates</MudButton>
    </div>
</MudPaper>

<MudTable Items="@ActualBills" Elevation="0" Outlined="true" Dense="true" Hover="true" Striped="true">
    <HeaderContent>
        <MudTh>Name</MudTh>
        <MudTh>Supplier</MudTh>
        <MudTh>Amount</MudTh>
        <MudTh>Frequency</MudTh>
        <MudTh>Status</MudTh>
        <MudTh>Actions</MudTh>
    </HeaderContent>
    <RowTemplate>
        <MudTd DataLabel="Name">@context.Name</MudTd>
        <MudTd DataLabel="Supplier">
            @if (!string.IsNullOrEmpty(context.Supplier))
            {
                @context.Supplier
            }
            else
            {
                <MudText Typo="Typo.caption" Class="mud-text-secondary">-</MudText>
            }
        </MudTd>
        <MudTd DataLabel="Amount">@context.Amount.ToString("C2")</MudTd>
        <MudTd DataLabel="Frequency">@context.Frequency</MudTd>
        <MudTd DataLabel="Status">
            @if (context.History.Any())
            {
                var last = context.History.OrderByDescending(h => h.Date).First();
                <MudChip T="string" Size="Size.Small" Color="@(last.IsPaid ? Color.Success : Color.Warning)">
                    @(last.IsPaid ? "Paid" : "Pending")
                </MudChip>
            }
            else
            {
                <MudChip T="string" Size="Size.Small" Color="Color.Default">No bills</MudChip>
            }
        </MudTd>
        <MudTd DataLabel="Actions">
            <MudButton Variant="Variant.Outlined" Color="Color.Info" Size="Size.Small" Class="mr-2"
                OnClick="@(() => UploadBill(context))">Add Bill</MudButton>

            <MudTooltip Text="Edit Bill">
                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Primary" Size="Size.Small"
                               OnClick="@(() => EditExpense(context))" />
            </MudTooltip>
            
            <MudTooltip Text="Delete Bill">
                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                               OnClick="@(() => DeleteExpense(context))" />
            </MudTooltip>
            
        </MudTd>
    </RowTemplate>
</MudTable>

@code {
    [Parameter] public EventCallback OnChanged { get; set; }

    private List<RecurringExpense> ActualBills = new();

    protected override void OnInitialized()
    {
        RefreshList();
    }

    private void RefreshList()
    {
        // Only get actual bills (not estimates)
        ActualBills = Db.RecurringExpenses.GetAll().Where(e => !e.IsEstimate).ToList();
        StateHasChanged();
    }

    private async Task NotifyChangedAsync()
    {
        RefreshList();
        if (OnChanged.HasDelegate)
        {
            await OnChanged.InvokeAsync();
        }
    }

    private async Task AddBill()
    {
        var parameters = new DialogParameters<RecurringExpenseDialog>
        {
            { x => x.Expense, new RecurringExpense { IsEstimate = false } }, // Ensure it's not an estimate
            { x => x.IsNew, true }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RecurringExpenseDialog>("Add Actual Recurring Bill", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is RecurringExpense expense)
        {
            expense.IsEstimate = false; // Double check
            Db.RecurringExpenses.Save(expense);
            await NotifyChangedAsync();
            Snackbar.Add("Actual bill profile added", Severity.Success);
        }
    }

    private async Task AddOneTimeBill()
    {
        var parameters = new DialogParameters<RecurringExpenseDialog>
        {
            { x => x.Expense, new RecurringExpense { IsEstimate = false, Frequency = RecurringExpenseFrequency.OneTime } },
            { x => x.IsNew, true }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RecurringExpenseDialog>("Add Actual One-Time Bill", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is RecurringExpense expense)
        {
            expense.IsEstimate = false; // Double check
            Db.RecurringExpenses.Save(expense);
            await NotifyChangedAsync();
            Snackbar.Add("Actual one-time bill added", Severity.Success);
        }
    }

    private async Task EditExpense(RecurringExpense expense)
    {
        var parameters = new DialogParameters<RecurringExpenseDialog>
        {
            { x => x.Expense, expense },
            { x => x.IsNew, false }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RecurringExpenseDialog>("Edit Actual Bill Profile", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is RecurringExpense updated)
        {
            Db.RecurringExpenses.Save(updated);
            await NotifyChangedAsync();
            Snackbar.Add("Bill profile updated", Severity.Success);
        }
    }
    
    private async Task UploadBill(RecurringExpense expense)
    {
        // Same as Edit but might start on the history tab in future enhancement
        var parameters = new DialogParameters<RecurringExpenseDialog>
        {
            { x => x.Expense, expense },
            { x => x.IsNew, false },
            { x => x.ActiveTabIndex, 1 }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<RecurringExpenseDialog>("Upload Bill", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled && result.Data is RecurringExpense updated)
        {
            Db.RecurringExpenses.Save(updated);
            await NotifyChangedAsync();
        }
    }

    private async Task DeleteExpense(RecurringExpense expense)
    {
        var confirm = await DialogService.ShowMessageBoxAsync("Delete", "Are you sure you want to delete this bill profile?", yesText: "Delete", cancelText: "Cancel");
        if (confirm == true)
        {
            Db.RecurringExpenses.Delete(expense.Id);
            await NotifyChangedAsync();
        }
    }
    
    // Quick import dialog for estimates
    private async Task ImportEstimates()
    {
        var parameters = new DialogParameters<ImportEstimatesDialog>();
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ImportEstimatesDialog>("Import Estimates", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            await NotifyChangedAsync();
        }
    }
}
