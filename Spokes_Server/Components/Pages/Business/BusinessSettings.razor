        1 => BizLoc["Documents & Templates"].Value,
        2 => BizLoc["Project Statuses"].Value,
        3 => BizLoc["Timesheets & Overtime"].Value,
        4 => BizLoc["Accounting, Tax & Jurisdiction"].Value,
        5 => BizLoc["Banking & Financial Accounts"].Value,
        _ => BizLoc["Tasks & Rate Cards"].Value
    };

    private string GetActiveTabIcon() => activeTabIndex switch
    {
        0 => Icons.Material.Filled.ListAlt,
        1 => Icons.Material.Filled.Description,
        2 => Icons.Material.Filled.Palette,
        3 => Icons.Material.Filled.Schedule,
        4 => Icons.Material.Filled.AccountBalance,
