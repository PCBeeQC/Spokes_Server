    private void RefreshTermsList() => TermsList = Db.TermsAndConditions.GetAll().OrderBy(t => t.Name).ToList();

    private async Task CreateTermsAndConditions()
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        var item = new TermsAndConditions { Name = "New Terms & Conditions" };
        var parameters = new DialogParameters { ["Item"] = item, ["IsNew"] = true };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<TermsAndConditionsDialog>(BizLoc["New Terms & Conditions"].Value, parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            RefreshTermsList();
        }
    }

    private async Task EditTermsAndConditions(TermsAndConditions terms)
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        var cloned = new TermsAndConditions
        {
            Id = terms.Id,
            Name = terms.Name,
            Content = terms.Content,
            IsDefault = terms.IsDefault,
            CreatedAt = terms.CreatedAt,
            UpdatedAt = terms.UpdatedAt
        };
        var parameters = new DialogParameters { ["Item"] = cloned, ["IsNew"] = false };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var title = string.Format(BizLoc["Edit {0}"].Value, terms.Name);
        var dialog = await DialogService.ShowAsync<TermsAndConditionsDialog>(title, parameters, options);
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            RefreshTermsList();
        }
    }

    private async Task DeleteTermsAndConditions(TermsAndConditions terms)
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        var inUse = Templates.Where(t => t.DefaultTermsAndConditionsId == terms.Id).ToList();
        string message = inUse.Any()
            ? $"This preset is used by {inUse.Count} template(s) ({string.Join(", ", inUse.Select(x => x.Name))}). Are you sure you want to delete '{terms.Name}'?"
            : $"Are you sure you want to delete '{terms.Name}'?";
        var confirm = await DialogService.ShowMessageBoxAsync(
            "Delete Terms & Conditions",
            message,
            yesText: "Delete",
            cancelText: "Cancel");

        if (confirm == true)
        {
            if (!await AuthorizeSettingsMutationAsync()) return;
            Db.TermsAndConditions.Delete(terms.Id);
            foreach (var t in inUse)
            {
                t.DefaultTermsAndConditionsId = string.Empty;
                Db.DocumentTemplates.Save(t);
            }
            RefreshTermsList();
            Snackbar.Add("Terms & Conditions deleted", Severity.Success);
        }
    }

    private string GetTermsPreview(string? markdown)
    {
        if (string.IsNullOrWhiteSpace(markdown)) return string.Empty;
        var flat = System.Text.RegularExpressions.Regex.Replace(markdown, @"[#*_\[\]\(\)\n\r]", " ").Trim();
        return flat.Length > 100 ? flat.Substring(0, 100) + "..." : flat;
    }

