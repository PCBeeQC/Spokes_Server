    private string GetTaxRegistrationNumber(string code)
    {
        Profile.Accounting ??= new();
        Profile.Accounting.TaxRegistrationNumbersByCode ??= new(StringComparer.OrdinalIgnoreCase);
        return Profile.Accounting.TaxRegistrationNumbersByCode.TryGetValue(code, out var val) ? val : string.Empty;
    }

    private void SetTaxRegistrationNumber(string code, string? value)
    {
        if (string.IsNullOrWhiteSpace(code)) return;
        Profile.Accounting ??= new();
        Profile.Accounting.TaxRegistrationNumbersByCode ??= new(StringComparer.OrdinalIgnoreCase);
        Profile.Accounting.TaxRegistrationNumbersByCode[code] = value?.Trim() ?? string.Empty;
    }

    private async Task SaveAndActivateTemplate()
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        try
        {
            var saved = TemplateService.SaveTemplate(_editingTemplate, activateImmediately: true, actor: _currentUser);
            PayrollEngine.SyncJurisdictionEmployerContributionsToRepository(saved, actor: _currentUser);
            Db.CompanyProfile.Save(Profile);

            _availableTemplates = TemplateService.GetAvailableTemplates().ToList();
            _selectedTemplateKey = $"{saved.JurisdictionId}:{saved.TaxYear}";
            Snackbar.Add(BizLoc["Jurisdiction template saved, activated, and synchronized with Chart of Accounts & Payroll."].Value, Severity.Success);
            if (OnSaved.HasDelegate)
            {
                await OnSaved.InvokeAsync();
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task ExportCurrentTemplate()
    {
        var json = TemplateService.ExportTemplateJson(_editingTemplate);
        var safeId = (_editingTemplate.JurisdictionId ?? "jurisdiction").ToLowerInvariant();
        var fileName = $"{safeId}-{_editingTemplate.TaxYear}.spokes-jurisdiction.json";
        await JS.InvokeVoidAsync("downloadFile", fileName, "application/json", json);
    }

    private async Task OnTemplateFileUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        if (!await AuthorizeSettingsMutationAsync())
        {
            FileService.CleanTempContext(_templateTempCtx);
            return;
        }
        var result = results.First();
        if (!FileService.TryResolveScopedFileName(result.FilePath, "temp", _templateTempCtx, out var safeName))
        {
            return;
        }

        try
        {
            using var stream = FileService.OpenRead("temp", _templateTempCtx, safeName);
            if (stream == null) return;
            using var reader = new StreamReader(stream);
            var json = await reader.ReadToEndAsync();
            var saved = TemplateService.SaveCustomTemplate(json, actor: _currentUser);
            TemplateService.ActivateTemplate(saved.JurisdictionId, saved.TaxYear, syncChartOfAccounts: true, actor: _currentUser);
            PayrollEngine.SyncJurisdictionEmployerContributionsToRepository(saved, actor: _currentUser);
            RefreshTemplates();
            Snackbar.Add(BizLoc["Jurisdiction template imported and activated."].Value, Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Import Failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            FileService.CleanTempContext(_templateTempCtx);
            StateHasChanged();
        }
    }

    private static JurisdictionTemplate CloneTemplate(JurisdictionTemplate src) =>
        src.DeepClone();
}
