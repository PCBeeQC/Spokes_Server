@using System.IO
@using System.Text.Json
@using Spokes_Server.Components.Shared
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.HR
@inject Database Db
@inject IJurisdictionTemplateService TemplateService
@inject IPayrollCalculationEngine PayrollEngine
@inject IFileService FileService
@inject ISnackbar Snackbar
@inject IJSRuntime JS
@inject NavigationManager Nav
@inject UserService UserService

<MudStack Spacing="4">
    @* 1. Active Jurisdiction & Visual Template Editor Card *@
    <SettingsCard Title="@BizLoc["Jurisdiction Template & Rules Builder"]"
                  Icon="@Icons.Material.Filled.Public"
                  Description="@BizLoc["Select a jurisdiction preset or build your own tax, mileage, payroll, and Chart of Accounts template from the ground up."]">
        <HeaderActions>
            <div class="d-flex align-center flex-wrap gap-2">
                @if (_canEditJurisdiction)
                {
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Primary"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Add"
                               OnClick="CreateNewBlankTemplate">
                        @BizLoc["New Blank Template"]
                    </MudButton>
                    <MudButton Variant="Variant.Outlined"
                               Color="Color.Info"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.ContentCopy"
                               OnClick="CloneCurrentTemplate">
                        @BizLoc["Clone & Customize"]
                    </MudButton>
                    <ApiFileUpload Category="temp"
                                   ContextId="@_templateTempCtx"
                                   OnUploadCompleted="OnTemplateFileUploaded">
                        <CustomContent>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Secondary"
                                       Size="Size.Small"
                                       StartIcon="@Icons.Material.Filled.UploadFile">
                                @Loc["Import"]
                            </MudButton>
                        </CustomContent>
                    </ApiFileUpload>
                }
                <MudButton Variant="Variant.Outlined"
                           Color="Color.Default"
                           Size="Size.Small"
                           StartIcon="@Icons.Material.Filled.Download"
                           OnClick="ExportCurrentTemplate">
                    @BizLoc["Export JSON"]
                </MudButton>
                @if (_canEditJurisdiction)
                {
                    <MudButton Variant="Variant.Filled"
                               Color="Color.Success"
                               Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.Save"
                               OnClick="SaveAndActivateTemplate">
                        @BizLoc["Save & Activate Template"]
                    </MudButton>
                }
            </div>
        </HeaderActions>
        <ChildContent>
            <MudGrid Spacing="2" Class="mb-4 align-center">
                <MudItem xs="12" md="7">
                    <MudSelect T="string"
                               Value="@_selectedTemplateKey"
                               ValueChanged="OnSelectedTemplateChanged"
                               Label="@BizLoc["Loaded Jurisdiction Template"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Dense="true">
                        @foreach (var tmpl in _availableTemplates)
                        {
                            var key = $"{tmpl.JurisdictionId}:{tmpl.TaxYear}";
                            <MudSelectItem Value="@key">
                                @tmpl.Name (@tmpl.JurisdictionId · @tmpl.TaxYear · @tmpl.DefaultCurrency)
                            </MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" md="5" Class="d-flex justify-end align-center gap-2 flex-wrap">
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Size="Size.Small">
                        @BizLoc["Combined Sales Tax:"] @FinancialCalculationEngine.FormatTaxRatePercent(_editingTemplate.CombinedSalesTaxRate)%
                    </MudChip>
                    <MudChip T="string" Color="Color.Info" Variant="Variant.Outlined" Size="Size.Small">
                        @_editingTemplate.PayrollRules.Contributions.Count @BizLoc["Contributions"] · @_editingTemplate.PayrollRules.IncomeTaxTables.Count @BizLoc["Tax Tables"]
                    </MudChip>
                </MudItem>
            </MudGrid>

            <MudTabs Elevation="0" Outlined="true" Border="true" Rounded="true" ApplyEffectsToContainer="true" TabPanelsClass="pa-4">
                @* TAB 1: METADATA, MILEAGE & VACATION *@
                <MudTabPanel Text="@BizLoc["General, Mileage & Vacation"]" Icon="@Icons.Material.Filled.Tune">
                    <MudGrid Spacing="2">
                        <MudItem xs="12" sm="3">
                            <MudTextField T="string"
                                          @bind-Value="_editingTemplate.JurisdictionId"
                                          Label="@BizLoc["Jurisdiction Code (e.g. CA-QC)"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true" />
                        </MudItem>
                        <MudItem xs="12" sm="5">
                            <MudTextField T="string"
                                          @bind-Value="_editingTemplate.Name"
                                          Label="@BizLoc["Jurisdiction Display Name"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense"
                                          Required="true" />
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudNumericField T="int"
                                             @bind-Value="_editingTemplate.TaxYear"
                                             Label="@BizLoc["Tax Year"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="2000"
                                             Max="2100" />
                        </MudItem>
                        <MudItem xs="6" sm="2">
                            <MudTextField T="string"
                                          @bind-Value="_editingTemplate.DefaultCurrency"
                                          Label="@BizLoc["Currency"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudTextField T="string"
                                          @bind-Value="_editingTemplate.CountryCode"
                                          Label="@BizLoc["Country Code"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="6" sm="3">
                            <MudTextField T="string"
                                          @bind-Value="_editingTemplate.RegionCode"
                                          Label="@BizLoc["Region / State / Province"]"
                                          Variant="Variant.Outlined"
                                          Margin="Margin.Dense" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudSelect T="string"
                                       @bind-Value="_editingTemplate.TaxMappingStandard"
                                       Label="@BizLoc["CPA Account Mapping Standard"]"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       Dense="true">
                                <MudSelectItem Value="@("GIFI")">GIFI (Canada — T2 / CO-17)</MudSelectItem>
                                <MudSelectItem Value="@("PCG")">PCG / FEC (France / Europe)</MudSelectItem>
                                <MudSelectItem Value="@("IRS")">IRS Schedule C / 1120 (United States)</MudSelectItem>
                                <MudSelectItem Value="@("NONE")">@BizLoc["Custom / Standard Account Codes Only"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2"><b>@BizLoc["Mileage / Kilometrage Allowance Rules"]</b></MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="_editingTemplate.MileageRules.PrimaryRatePerKm"
                                             Label="@BizLoc["Primary Rate ($/km)"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Format="N2" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal?"
                                             @bind-Value="_editingTemplate.MileageRules.TierThresholdKm"
                                             Label="@BizLoc["Annual Tier Threshold (km, optional)"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Format="N0" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal"
                                             @bind-Value="_editingTemplate.MileageRules.SecondaryRatePerKm"
                                             Label="@BizLoc["Secondary Rate Above Threshold ($/km)"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Format="N2" />
                        </MudItem>

                        <MudItem xs="12"><MudDivider Class="my-2" /></MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2"><b>@BizLoc["Statutory Vacation Accrual Defaults"]</b></MudText>
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal"
                                             Value="@(Math.Round(_editingTemplate.PayrollRules.DefaultVacationRate * 100m, 2))"
                                             ValueChanged="@((decimal v) => _editingTemplate.PayrollRules.DefaultVacationRate = Math.Round(v / 100m, 4))"
                                             Label="@BizLoc["Default Vacation Rate (%)"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Format="N2"
                                             Adornment="Adornment.End"
                                             AdornmentText="%" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="decimal"
                                             Value="@(Math.Round(_editingTemplate.PayrollRules.SeniorVacationRate * 100m, 2))"
                                             ValueChanged="@((decimal v) => _editingTemplate.PayrollRules.SeniorVacationRate = Math.Round(v / 100m, 4))"
                                             Label="@BizLoc["Seniority Vacation Rate (%)"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Format="N2"
                                             Adornment="Adornment.End"
                                             AdornmentText="%" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField T="int"
                                             @bind-Value="_editingTemplate.PayrollRules.SeniorityYearsForEnhancedVacation"
                                             Label="@BizLoc["Years of Service for Senior Rate"]"
                                             Variant="Variant.Outlined"
                                             Margin="Margin.Dense"
                                             Min="0"
                                             Max="50" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                @* TAB 2: SALES TAXES *@
                <MudTabPanel Text="@($"{BizLoc["Sales Taxes"].Value} ({_editingTemplate.SalesTaxes.Count})")" Icon="@Icons.Material.Filled.RequestQuote">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @BizLoc["Add 0, 1, 2, or more sales taxes. Each tax automatically appears on Invoices, Bills, Expense Reports, and Sales Tax Returns."]
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddSalesTaxRule">
                            @BizLoc["Add Sales Tax"]
                        </MudButton>
                    </div>

                    <MudTable Items="@_editingTemplate.SalesTaxes" Dense="true" Hover="true" Outlined="true" Elevation="0">
                        <HeaderContent>
                            <MudTh>@BizLoc["Code"]</MudTh>
                            <MudTh>@Loc["Name"]</MudTh>
                            <MudTh>@BizLoc["Rate (%)"]</MudTh>
                            <MudTh>@BizLoc["Tax Authority"]</MudTh>
                            <MudTh>@BizLoc["Registration # Label"]</MudTh>
                            <MudTh>@BizLoc["Recoverable (ITC)"]</MudTh>
                            <MudTh>@BizLoc["Collected GL"]</MudTh>
                            <MudTh>@BizLoc["ITC / Asset GL"]</MudTh>
                            <MudTh></MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudTextField T="string" @bind-Value="context.Code" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 90px;" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string" @bind-Value="context.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudNumericField T="decimal"
                                                 Value="@(Math.Round(context.Rate * 100m, 4))"
                                                 ValueChanged="@((decimal v) => context.Rate = Math.Round(v / 100m, 6))"
                                                 Variant="Variant.Outlined"
                                                 Margin="Margin.Dense"
                                                 Format="@FinancialCalculationEngine.TaxRatePercentFormat"
                                                 Style="max-width: 110px;" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string" @bind-Value="context.AuthorityName" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string" @bind-Value="context.RegistrationNumberLabel" Placeholder="e.g. GST / TPS #" Variant="Variant.Outlined" Margin="Margin.Dense" />
                            </MudTd>
                            <MudTd>
                                <MudCheckBox T="bool" @bind-Value="context.IsRecoverable" Dense="true" Color="Color.Primary" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string" @bind-Value="context.CollectedLiabilityGlCode" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 85px;" />
                            </MudTd>
                            <MudTd>
                                <MudTextField T="string" @bind-Value="context.RecoverableAssetGlCode" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 85px;" />
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                               Color="Color.Error"
                                               Size="Size.Small"
                                               OnClick="@(() => { _editingTemplate.SalesTaxes.Remove(context); })" />
                            </MudTd>
                        </RowTemplate>
                    </MudTable>

                    @if (_editingTemplate.SalesTaxes.Count > 0)
                    {
                        <MudDivider Class="my-4" />
                        <MudText Typo="Typo.subtitle2" Class="mb-2"><b>@BizLoc["Company Tax Registration Numbers (Printed on Invoices)"]</b></MudText>
                        <MudGrid Spacing="2">
                            @foreach (var tax in _editingTemplate.SalesTaxes.Where(t => !string.IsNullOrWhiteSpace(t.Code)))
                            {
                                var label = !string.IsNullOrWhiteSpace(tax.RegistrationNumberLabel)
                                    ? tax.RegistrationNumberLabel
                                    : $"{tax.Name} ({tax.Code}) Registration #";
                                <MudItem xs="12" sm="6">
                                    <MudTextField T="string"
                                                  Value="@GetTaxRegistrationNumber(tax.Code)"
                                                  ValueChanged="@((string v) => SetTaxRegistrationNumber(tax.Code, v))"
                                                  Label="@label"
                                                  Variant="Variant.Outlined"
                                                  Margin="Margin.Dense" />
                                </MudItem>
                            }
                        </MudGrid>
                    }
                </MudTabPanel>

                @* TAB 3: EMPLOYEE PARAMETERS *@
                <MudTabPanel Text="@($"{BizLoc["Employee Parameters"].Value} ({_editingTemplate.PayrollRules.EmployeeParameters.Count})")" Icon="@Icons.Material.Filled.Tune">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @BizLoc["Declare per-employee payroll parameters rendered in Employee Payroll Profiles (credits, filing status choices, personalized rates, or extra withholding)."]
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddEmployeeParameter">
                            @BizLoc["Add Parameter"]
                        </MudButton>
                    </div>

                    @if (_editingTemplate.PayrollRules.EmployeeParameters.Count == 0)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Dense="true">
                            @BizLoc["No per-employee parameters declared yet."]
                        </MudAlert>
                    }
                    else
                    {
                        <MudStack Spacing="2">
                            @foreach (var param in _editingTemplate.PayrollRules.EmployeeParameters)
                            {
                                <MudPaper Class="pa-3" Outlined="true" Elevation="0">
                                    <MudGrid Spacing="2" Class="align-center">
                                        <MudItem xs="12" sm="2">
                                            <MudTextField T="string" @bind-Value="param.Key" Label="@BizLoc["Key"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="12" sm="3">
                                            <MudTextField T="string" @bind-Value="param.Label" Label="@Loc["Label"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="6" sm="2">
                                            <MudSelect T="string" @bind-Value="param.DataType" Label="@BizLoc["Type"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                @foreach (var dt in EmployeeRuleParameterType.All)
                                                {
                                                    <MudSelectItem Value="@dt">@dt</MudSelectItem>
                                                }
                                            </MudSelect>
                                        </MudItem>
                                        <MudItem xs="6" sm="2">
                                            <MudTextField T="string" @bind-Value="param.DefaultValue" Label="@BizLoc["Default Value"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="10" sm="2">
                                            <MudTextField T="string" @bind-Value="param.HelpText" Label="@BizLoc["Help Text"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                        <MudItem xs="2" sm="1" Class="d-flex justify-end">
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                           Color="Color.Error"
                                                           Size="Size.Small"
                                                           OnClick="@(() => { _editingTemplate.PayrollRules.EmployeeParameters.Remove(param); })" />
                                        </MudItem>
                                    </MudGrid>

                                    @if (param.DataType == EmployeeRuleParameterType.Choice)
                                    {
                                        <div class="mt-2 pt-2" style="border-top: 1px dashed var(--mud-palette-lines-default);">
                                            <div class="d-flex justify-space-between align-center mb-1">
                                                <MudText Typo="Typo.caption"><b>@BizLoc["Choice Options"]</b></MudText>
                                                <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                                           OnClick="@(() => param.Options.Add(new EmployeeRuleParameterOption { Key = $"OPT_{param.Options.Count + 1}", Label = "Option" }))">
                                                    @BizLoc["Add Option"]
                                                </MudButton>
                                            </div>
                                            <MudGrid Spacing="1">
                                                @foreach (var opt in param.Options)
                                                {
                                                    <MudItem xs="12" sm="6" Class="d-flex align-center gap-1">
                                                        <MudTextField T="string" @bind-Value="opt.Key" Label="@BizLoc["Option Key"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                        <MudTextField T="string" @bind-Value="opt.Label" Label="@Loc["Label"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small"
                                                                       OnClick="@(() => param.Options.Remove(opt))" />
                                                    </MudItem>
                                                }
                                            </MudGrid>
                                        </div>
                                    }
                                </MudPaper>
                            }
                        </MudStack>
                    }
                </MudTabPanel>

                @* TAB 4: PAYROLL CONTRIBUTIONS *@
                <MudTabPanel Text="@($"{BizLoc["Payroll Contributions"].Value} ({_editingTemplate.PayrollRules.Contributions.Count})")" Icon="@Icons.Material.Filled.AccountBalance">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @BizLoc["Configure statutory employee deductions and employer payroll levies (with base multipliers, exemptions, floors, and ceilings)."]
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddContributionRule">
                            @BizLoc["Add Contribution Rule"]
                        </MudButton>
                    </div>

                    <div class="overflow-x-auto">
                        <MudTable Items="@_editingTemplate.PayrollRules.Contributions" Dense="true" Hover="true" Outlined="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>@BizLoc["Code"]</MudTh>
                                <MudTh>@Loc["Name"]</MudTh>
                                <MudTh>@BizLoc["Authority"]</MudTh>
                                <MudTh>@BizLoc["Base %"]</MudTh>
                                <MudTh>@BizLoc["Emp %"]</MudTh>
                                <MudTh>@BizLoc["Employer %"]</MudTh>
                                <MudTh>@BizLoc["Exemption ($)"]</MudTh>
                                <MudTh>@BizLoc["Ceiling ($)"]</MudTh>
                                <MudTh>@BizLoc["Deductible"]</MudTh>
                                <MudTh>@BizLoc["Credit"]</MudTh>
                                <MudTh>@BizLoc["Slip Box"]</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudTextField T="string" @bind-Value="context.Code" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 85px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField T="string" @bind-Value="context.Name" Variant="Variant.Outlined" Margin="Margin.Dense" Style="min-width: 170px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField T="string" @bind-Value="context.Authority" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 120px;" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal"
                                                     Value="@(Math.Round((context.BaseMultiplier > 0m ? context.BaseMultiplier : 1.0m) * 100m, 2))"
                                                     ValueChanged="@((decimal v) => context.BaseMultiplier = v > 0m ? Math.Round(v / 100m, 5) : 1.0m)"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Format="N2"
                                                     Style="max-width: 85px;" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal"
                                                     Value="@(Math.Round(context.EmployeeRate * 100m, 4))"
                                                     ValueChanged="@((decimal v) => context.EmployeeRate = Math.Round(v / 100m, 6))"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Format="N3"
                                                     Style="max-width: 90px;" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal"
                                                     Value="@(Math.Round(context.EmployerRate * 100m, 4))"
                                                     ValueChanged="@((decimal v) => context.EmployerRate = Math.Round(v / 100m, 6))"
                                                     Variant="Variant.Outlined"
                                                     Margin="Margin.Dense"
                                                     Format="N3"
                                                     Style="max-width: 90px;" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal" @bind-Value="context.AnnualExemption" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Style="max-width: 95px;" />
                                </MudTd>
                                <MudTd>
                                    <MudNumericField T="decimal?" @bind-Value="context.AnnualMaxInsurableEarnings" Placeholder="Uncapped" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Style="max-width: 105px;" />
                                </MudTd>
                                <MudTd>
                                    <MudCheckBox T="bool" @bind-Value="context.IsTaxDeductibleFromGross" Dense="true" Color="Color.Primary" />
                                </MudTd>
                                <MudTd>
                                    <MudCheckBox T="bool" @bind-Value="context.GrantsBasicTaxCredit" Dense="true" Color="Color.Primary" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField T="string" @bind-Value="context.SlipBoxCode" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 110px;" />
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => { _editingTemplate.PayrollRules.Contributions.Remove(context); })" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </MudTabPanel>

                @* TAB 5: INCOME TAX TABLES & COMPOSABLE PIPELINE *@
                <MudTabPanel Text="@($"{BizLoc["Income Tax Tables"].Value} ({_editingTemplate.PayrollRules.IncomeTaxTables.Count})")" Icon="@Icons.Material.Filled.Layers">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @BizLoc["Define income tax calculation pipelines for each tax authority (progressive brackets, filing-status bracket sets, employee rate overrides, pre-bracket deductions, and post-tax steps)."]
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddIncomeTaxTable">
                            @BizLoc["Add Income Tax Table"]
                        </MudButton>
                    </div>

                    <MudStack Spacing="3">
                        @foreach (var table in _editingTemplate.PayrollRules.IncomeTaxTables)
                        {
                            <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                                <div class="d-flex justify-space-between align-center mb-3">
                                    <MudText Typo="Typo.subtitle1"><b>@table.Name (@table.Code)</b></MudText>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => { _editingTemplate.PayrollRules.IncomeTaxTables.Remove(table); })" />
                                </div>

                                <MudGrid Spacing="2" Class="mb-3">
                                    <MudItem xs="12" sm="2">
                                        <MudTextField T="string" @bind-Value="table.Code" Label="@BizLoc["Code"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="4">
                                        <MudTextField T="string" @bind-Value="table.Name" Label="@Loc["Name"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField T="string" @bind-Value="table.Authority" Label="@BizLoc["Authority"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField T="string" @bind-Value="table.SlipBoxCode" Label="@BizLoc["Slip Box Code"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>

                                    <MudItem xs="12" sm="4">
                                        <MudSelect T="string" @bind-Value="table.Method" Label="@BizLoc["Computation Method"]" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                            @foreach (var m in TaxComputationMethod.All)
                                            {
                                                <MudSelectItem Value="@m">@m</MudSelectItem>
                                            }
                                        </MudSelect>
                                    </MudItem>
                                    <MudItem xs="6" sm="2">
                                        <MudNumericField T="decimal"
                                                         Value="@(Math.Round((table.BaseMultiplier > 0m ? table.BaseMultiplier : 1.0m) * 100m, 2))"
                                                         ValueChanged="@((decimal v) => table.BaseMultiplier = v > 0m ? Math.Round(v / 100m, 5) : 1.0m)"
                                                         Label="@BizLoc["Base Multiplier (%)"]"
                                                         Variant="Variant.Outlined"
                                                         Margin="Margin.Dense"
                                                         Format="N2" />
                                    </MudItem>
                                    <MudItem xs="6" sm="3">
                                        <MudNumericField T="decimal" @bind-Value="table.PreBracketStandardDeduction" Label="@BizLoc["Pre-Bracket Std. Deduction ($)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" />
                                    </MudItem>
                                    <MudItem xs="12" sm="3">
                                        <MudTextField T="string" @bind-Value="table.PreBracketDeductionParameterKey" Label="@BizLoc["Pre-Bracket Deduction Param Key"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                    </MudItem>

                                    @if (table.Method == TaxComputationMethod.BracketSetByParameter)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudTextField T="string" @bind-Value="table.BracketSetSelectorParameterKey" Label="@BizLoc["Selector Choice Param Key (e.g. W4_FILING_STATUS)"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                    }
                                    else if (table.Method == TaxComputationMethod.ParameterRateOrBracketFallback)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudTextField T="string" @bind-Value="table.RateOverrideParameterKey" Label="@BizLoc["Rate Override Param Key (e.g. FR_PAS_RATE)"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                        </MudItem>
                                    }
                                    else if (table.Method == TaxComputationMethod.FlatRate)
                                    {
                                        <MudItem xs="12" sm="6">
                                            <MudNumericField T="decimal"
                                                             Value="@(Math.Round(table.FlatRate * 100m, 3))"
                                                             ValueChanged="@((decimal v) => table.FlatRate = Math.Round(v / 100m, 5))"
                                                             Label="@BizLoc["Flat Rate (%)"]"
                                                             Variant="Variant.Outlined"
                                                             Margin="Margin.Dense"
                                                             Format="N2" />
                                        </MudItem>
                                    }
                                </MudGrid>

                                @if (table.Method == TaxComputationMethod.BracketSetByParameter)
                                {
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <MudText Typo="Typo.caption"><b>@BizLoc["Conditional Bracket Sets (e.g. by Filing Status)"]</b></MudText>
                                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="@(() => table.BracketSets.Add(new TaxBracketSet { OptionKey = $"SET_{table.BracketSets.Count + 1}", Label = "Bracket Set", Brackets = [new TaxBracketRule { Rate = 0.15m }] }))">
                                            @BizLoc["Add Bracket Set"]
                                        </MudButton>
                                    </div>
                                    <MudStack Spacing="2" Class="mb-3">
                                        @foreach (var bset in table.BracketSets)
                                        {
                                            <MudPaper Class="pa-3" Outlined="true" Elevation="0">
                                                <div class="d-flex justify-space-between align-center gap-2 mb-2">
                                                    <MudTextField T="string" @bind-Value="bset.OptionKey" Label="@BizLoc["Option Key"]" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 180px;" />
                                                    <MudTextField T="string" @bind-Value="bset.Label" Label="@Loc["Label"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                                    <MudNumericField T="decimal" @bind-Value="bset.StandardDeduction" Label="@BizLoc["Std. Deduction ($)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Style="max-width: 170px;" />
                                                    <MudButton Variant="Variant.Text" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add"
                                                               OnClick="@(() => bset.Brackets.Add(new TaxBracketRule { Rate = 0.15m }))">@BizLoc["Bracket"]</MudButton>
                                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                                                   OnClick="@(() => table.BracketSets.Remove(bset))" />
                                                </div>
                                                <MudSimpleTable Elevation="0" Dense="true" Outlined="true">
                                                    <thead>
                                                        <tr>
                                                            <th>@BizLoc["Up To Annual Taxable Income ($)"]</th>
                                                            <th>@BizLoc["Rate (%)"]</th>
                                                            <th style="width: 50px;"></th>
                                                        </tr>
                                                    </thead>
                                                    <tbody>
                                                        @foreach (var br in bset.Brackets)
                                                        {
                                                            <tr>
                                                                <td><MudNumericField T="decimal?" @bind-Value="br.UpToAnnualIncome" Placeholder="@BizLoc["Top Bracket"]" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" /></td>
                                                                <td><MudNumericField T="decimal" Value="@(Math.Round(br.Rate * 100m, 3))" ValueChanged="@((decimal v) => br.Rate = Math.Round(v / 100m, 5))" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" /></td>
                                                                <td><MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => bset.Brackets.Remove(br))" /></td>
                                                            </tr>
                                                        }
                                                    </tbody>
                                                </MudSimpleTable>
                                            </MudPaper>
                                        }
                                    </MudStack>
                                }
                                else if (table.Method != TaxComputationMethod.FlatRate)
                                {
                                    <div class="d-flex justify-space-between align-center mb-2">
                                        <MudText Typo="Typo.caption"><b>@BizLoc["Progressive Annual Tax Brackets"]</b></MudText>
                                        <MudButton Variant="Variant.Text"
                                                   Color="Color.Primary"
                                                   Size="Size.Small"
                                                   StartIcon="@Icons.Material.Filled.Add"
                                                   OnClick="@(() => table.Brackets.Add(new TaxBracketRule { Rate = 0.15m }))">
                                            @BizLoc["Add Bracket"]
                                        </MudButton>
                                    </div>

                                    <MudSimpleTable Elevation="0" Dense="true" Outlined="true" Class="mb-3">
                                        <thead>
                                            <tr>
                                                <th>@BizLoc["Up To Annual Taxable Income ($ — leave blank for top bracket)"]</th>
                                                <th>@BizLoc["Marginal Tax Rate (%)"]</th>
                                                <th style="width: 60px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var bracket in table.Brackets)
                                            {
                                                <tr>
                                                    <td>
                                                        <MudNumericField T="decimal?"
                                                                         @bind-Value="bracket.UpToAnnualIncome"
                                                                         Placeholder="@BizLoc["No upper limit (Top Bracket)"]"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Format="N0" />
                                                    </td>
                                                    <td>
                                                        <MudNumericField T="decimal"
                                                                         Value="@(Math.Round(bracket.Rate * 100m, 3))"
                                                                         ValueChanged="@((decimal v) => bracket.Rate = Math.Round(v / 100m, 5))"
                                                                         Variant="Variant.Outlined"
                                                                         Margin="Margin.Dense"
                                                                         Format="N2"
                                                                         Adornment="Adornment.End"
                                                                         AdornmentText="%" />
                                                    </td>
                                                    <td>
                                                        <MudIconButton Icon="@Icons.Material.Filled.Close"
                                                                       Color="Color.Error"
                                                                       Size="Size.Small"
                                                                       OnClick="@(() => { table.Brackets.Remove(bracket); })" />
                                                    </td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }

                                @* Post-Calculation Adjustment Pipeline *@
                                <div class="d-flex justify-space-between align-center mb-2">
                                    <MudText Typo="Typo.caption"><b>@BizLoc["Post-Calculation Pipeline Steps (Credits, Abatements, Surtaxes, Extra Withholding)"]</b></MudText>
                                    <MudButton Variant="Variant.Text"
                                               Color="Color.Primary"
                                               Size="Size.Small"
                                               StartIcon="@Icons.Material.Filled.Add"
                                               OnClick="@(() => table.PostSteps.Add(new TaxAdjustmentStep { StepType = TaxAdjustmentStepType.SubtractNonRefundableCredit, Label = "Tax Credit", RateOrFactor = 0.145m }))">
                                        @BizLoc["Add Step"]
                                    </MudButton>
                                </div>

                                @if (table.PostSteps.Count == 0)
                                {
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@BizLoc["No post-calculation steps (tax comes directly from brackets/rate)."]</MudText>
                                }
                                else
                                {
                                    <MudSimpleTable Elevation="0" Dense="true" Outlined="true">
                                        <thead>
                                            <tr>
                                                <th>@BizLoc["Step Type"]</th>
                                                <th>@Loc["Label"]</th>
                                                <th>@BizLoc["Param Key"]</th>
                                                <th>@BizLoc["Default ($)"]</th>
                                                <th>@BizLoc["Rate / Factor (%)"]</th>
                                                <th>@BizLoc["+ Contribs"]</th>
                                                <th style="width: 50px;"></th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            @foreach (var step in table.PostSteps)
                                            {
                                                <tr>
                                                    <td>
                                                        <MudSelect T="string" @bind-Value="step.StepType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                                                            @foreach (var st in TaxAdjustmentStepType.All)
                                                            {
                                                                <MudSelectItem Value="@st">@st</MudSelectItem>
                                                            }
                                                        </MudSelect>
                                                    </td>
                                                    <td><MudTextField T="string" @bind-Value="step.Label" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                                                    <td><MudTextField T="string" @bind-Value="step.ParameterKey" Variant="Variant.Outlined" Margin="Margin.Dense" /></td>
                                                    <td><MudNumericField T="decimal" @bind-Value="step.DefaultAmount" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N0" Style="max-width: 110px;" /></td>
                                                    <td><MudNumericField T="decimal" Value="@(Math.Round(step.RateOrFactor * 100m, 3))" ValueChanged="@((decimal v) => step.RateOrFactor = Math.Round(v / 100m, 5))" Variant="Variant.Outlined" Margin="Margin.Dense" Format="N2" Style="max-width: 110px;" /></td>
                                                    <td><MudCheckBox T="bool" @bind-Value="step.IncludeCreditableContributions" Dense="true" Color="Color.Primary" /></td>
                                                    <td><MudIconButton Icon="@Icons.Material.Filled.Close" Color="Color.Error" Size="Size.Small" OnClick="@(() => table.PostSteps.Remove(step))" /></td>
                                                </tr>
                                            }
                                        </tbody>
                                    </MudSimpleTable>
                                }
                            </MudPaper>
                        }
                    </MudStack>
                </MudTabPanel>

                @* TAB 6: CHART OF ACCOUNTS TEMPLATE *@
                <MudTabPanel Text="@($"{BizLoc["Chart of Accounts"].Value} ({_editingTemplate.ChartOfAccounts.Count})")" Icon="@Icons.Material.Filled.FormatListNumbered">
                    <div class="d-flex justify-space-between align-center mb-3">
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @BizLoc["Default GL accounts and CPA tax mapping codes seeded when this template is activated."]
                        </MudText>
                        <MudButton Variant="Variant.Outlined"
                                   Color="Color.Primary"
                                   Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Add"
                                   OnClick="AddGlAccountTemplateItem">
                            @BizLoc["Add GL Account"]
                        </MudButton>
                    </div>

                    <div style="max-height: 420px; overflow-y: auto;">
                        <MudTable Items="@_editingTemplate.ChartOfAccounts" Dense="true" Hover="true" Outlined="true" Elevation="0">
                            <HeaderContent>
                                <MudTh>@BizLoc["GL Code"]</MudTh>
                                <MudTh>@Loc["Name"]</MudTh>
                                <MudTh>@BizLoc["Type"]</MudTh>
                                <MudTh>@BizLoc["Sub-Type"]</MudTh>
                                <MudTh>@BizLoc["Tax / GIFI Code"]</MudTh>
                                <MudTh>@BizLoc["System Role"]</MudTh>
                                <MudTh></MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>
                                    <MudTextField T="string" @bind-Value="context.Code" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 90px;" />
                                </MudTd>
                                <MudTd>
                                    <MudTextField T="string" @bind-Value="context.Name" Variant="Variant.Outlined" Margin="Margin.Dense" />
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string"
                                               Value="context.Type"
                                               ValueChanged="@((string t) => { context.Type = t; context.SubType = GlAccountSubType.GetDefaultForAccountType(t); })"
                                               Variant="Variant.Outlined"
                                               Margin="Margin.Dense"
                                               Dense="true"
                                               Style="max-width: 120px;">
                                        @foreach (var t in GlAccountType.All)
                                        {
                                            <MudSelectItem Value="@t">@t</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" @bind-Value="context.SubType" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width: 170px;">
                                        @foreach (var st in GlAccountSubType.GetForAccountType(context.Type))
                                        {
                                            <MudSelectItem Value="@st">@st</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudTextField T="string" @bind-Value="context.StandardTaxCode" Variant="Variant.Outlined" Margin="Margin.Dense" Style="max-width: 100px;" />
                                </MudTd>
                                <MudTd>
                                    <MudSelect T="string" @bind-Value="context.SystemRole" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true" Style="max-width: 190px;">
                                        @foreach (var role in GlSystemRole.All)
                                        {
                                            <MudSelectItem T="string" Value="@(string.IsNullOrEmpty(role) ? null : role)">@(string.IsNullOrEmpty(role) ? "—" : role)</MudSelectItem>
                                        }
                                    </MudSelect>
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete"
                                                   Color="Color.Error"
                                                   Size="Size.Small"
                                                   OnClick="@(() => { _editingTemplate.ChartOfAccounts.Remove(context); })" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </MudTabPanel>
            </MudTabs>
        </ChildContent>
    </SettingsCard>

    @* 2. Financial Defaults & Commissions Card (Moved from Server Settings) *@
    <SettingsCard Title="@BizLoc["Financial Defaults & Fiscal Period"]"
                  Icon="@Icons.Material.Filled.Payments"
                  Description="@BizLoc["Configure fiscal year start, book-closing lock date, commission defaults, and supported billing currencies."]">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudSelect T="int"
                           @bind-Value="Profile.Accounting.FiscalYearStartMonth"
                           Label="@BizLoc["Fiscal Year Start Month"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    @for (int m = 1; m <= 12; m++)
                    {
                        var monthNum = m;
                        <MudSelectItem Value="@monthNum">@(new DateTime(2026, monthNum, 1).ToString("MMMM"))</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudSelect T="string"
                           @bind-Value="Profile.Accounting.DefaultSalesTaxFilingFrequency"
                           Label="@BizLoc["Sales Tax Filing Frequency"]"
                           Variant="Variant.Outlined"
                           Margin="Margin.Dense"
                           Dense="true">
                    <MudSelectItem Value="@("Monthly")">@BizLoc["Monthly"]</MudSelectItem>
                    <MudSelectItem Value="@("Quarterly")">@BizLoc["Quarterly"]</MudSelectItem>
                    <MudSelectItem Value="@("Annual")">@BizLoc["Annual"]</MudSelectItem>
                </MudSelect>
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudDatePicker @bind-Date="Profile.Accounting.PeriodLockDate"
                               Disabled="@(!_canWriteAccounting)"
                               Label="@BizLoc["Book-Closing Lock Date (Optional)"]"
                               Variant="Variant.Outlined"
                               Margin="Margin.Dense"
                               Clearable="true"
                               HelperText="@BizLoc["Prompts for an audit reason when editing documents on or before this date"]" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 ShrinkLabel="true"
                                 @bind-Value="Profile.DefaultInternalCommission"
                                 Label="@BizLoc["Default Internal Commission (%)"]"
                                 Adornment="Adornment.End"
                                 AdornmentIcon="@Icons.Material.Filled.Percent" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudNumericField Variant="Variant.Outlined"
                                 Margin="Margin.Dense"
                                 ShrinkLabel="true"
                                 @bind-Value="Profile.DefaultExternalCommission"
                                 Label="@BizLoc["Default External Commission (%)"]"
                                 Adornment="Adornment.End"
                                 AdornmentIcon="@Icons.Material.Filled.Percent" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ShrinkLabel="true"
                              @bind-Value="Profile.CurrencySymbol"
                              Label="@BizLoc["Currency Symbol"]"
                              HelperText="e.g. $, £, €" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudTextField Variant="Variant.Outlined"
                              Margin="Margin.Dense"
                              ShrinkLabel="true"
                              Value="@(string.Join(", ", Profile.SupportedCurrencies))"
                              ValueChanged="@((string v) => Profile.SupportedCurrencies = v.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries).Select(w => w.Trim()).ToList())"
                              Label="@BizLoc["Supported Currencies"]"
                              HelperText="@BizLoc["Enter currency codes separated by commas (e.g. CAD, USD, EUR)"]" />
            </MudItem>
            <MudItem xs="12" sm="6">
                <MudSelect ShrinkLabel="true"
                           @bind-Value="Profile.DateFormat"
                           Margin="Margin.Dense"
                           Label="@BizLoc["Date Format"]"
                           Variant="Variant.Outlined">
                    @foreach (var (fmt, label) in DateDisplayFormats.AvailableFormats)
                    {
                        <MudSelectItem Value="@fmt">@label</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>
        </MudGrid>
    </SettingsCard>

    @* 3. Document Numbering Card (Moved from Server Settings) *@
    <SettingsCard Title="@BizLoc["Document Numbering"]"
                  Icon="@Icons.Material.Filled.Pin"
                  Description="@BizLoc["Configure standard prefix codes for quotes, invoices, purchase orders, bills, pay runs, and project reports."]">
        <MudGrid Spacing="2">
            <MudItem xs="12" sm="4">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.QuotePrefix" Label="@BizLoc["Quote Prefix"]" HelperText="e.g. Q" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.InvoicePrefix" Label="@BizLoc["Invoice Prefix"]" HelperText="e.g. INV" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.DocumentNumbering.PurchaseOrderPrefix" Label="@BizLoc["Purchase Order Prefix"]" HelperText="e.g. PO" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.DocumentNumbering.BillPrefix" Label="@BizLoc["Bill Prefix"]" HelperText="e.g. BILL" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.DocumentNumbering.PayRunPrefix" Label="@BizLoc["Pay Run Prefix"]" HelperText="e.g. PAY" />
            </MudItem>
            <MudItem xs="12" sm="4">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.ReportPrefix" Label="@BizLoc["Project Report Prefix"]" HelperText="e.g. RPT" />
            </MudItem>
        </MudGrid>
    </SettingsCard>

    <SettingsCard Title="@BizLoc["Accounting Cutover & Migration (Sage 50 / CSV)"]"
                  Icon="@Icons.Material.Filled.SwapHoriz"
                  Description="@BizLoc["Importing from Sage 50, Sage Business Cloud, or CSV? Run the guided cutover wizard to match accounts, clients, suppliers, open AR/AP, and payroll YTD balances."]">
        <MudButton Variant="Variant.Outlined"
                   Color="Color.Primary"
                   StartIcon="@Icons.Material.Filled.OpenInNew"
                   OnClick="@(() => Nav.NavigateTo("/business/accounting?tab=ledger&subtab=migration"))">
            @BizLoc["Open Accounting Migration Wizard"]
        </MudButton>
    </SettingsCard>
</MudStack>

@code {
    [Parameter] public CompanyProfile Profile { get; set; } = new();
    [Parameter] public EventCallback OnSaved { get; set; }

    private List<JurisdictionTemplate> _availableTemplates = [];
    private JurisdictionTemplate _editingTemplate = new();
    private string _selectedTemplateKey = string.Empty;
    private readonly string _templateTempCtx = Guid.NewGuid().ToString("N");

    private Employee? _currentUser;
    private bool _canManageSettings;
    private bool _canWriteAccounting;
    private bool _canManageSalaries;
    private bool _canEditJurisdiction => _canManageSettings && _canWriteAccounting && _canManageSalaries;

    protected override async Task OnInitializedAsync()
    {
        await RefreshPermissionsAsync();
        RefreshTemplates();
    }

    private async Task RefreshPermissionsAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync();
        _canManageSettings = _currentUser is { IsActiveUnsuspended: true }
            && _currentUser.HasPermission(AppPermissions.Business.ManageSettings);
        _canWriteAccounting = _currentUser is { IsActiveUnsuspended: true }
            && _currentUser.HasPermission(AppPermissions.Finance.AccessAccounting);
        _canManageSalaries = _currentUser is { IsActiveUnsuspended: true }
            && _currentUser.HasPermission(AppPermissions.Hr.ManageSalaries);
    }

    private async Task<bool> AuthorizeSettingsMutationAsync()
    {
        await RefreshPermissionsAsync();
        if (_canEditJurisdiction)
            return true;

        Snackbar.Add(BizLoc["Active Business.ManageSettings, Finance.AccessAccounting, and Hr.ManageSalaries permissions are required to modify jurisdiction templates."].Value, Severity.Error);
        return false;
    }

    private void RefreshTemplates()
    {
        _availableTemplates = TemplateService.GetAvailableTemplates().ToList();
        var active = TemplateService.GetActiveTemplate();
        _editingTemplate = CloneTemplate(active);
        _selectedTemplateKey = $"{_editingTemplate.JurisdictionId}:{_editingTemplate.TaxYear}";
    }

    private void OnSelectedTemplateChanged(string key)
    {
        if (string.IsNullOrWhiteSpace(key)) return;
        _selectedTemplateKey = key;
        var parts = key.Split(':');
        var id = parts[0];
        int? year = parts.Length > 1 && int.TryParse(parts[1], out var y) ? y : null;

        var found = TemplateService.GetTemplateById(id, year);
        if (found != null)
        {
            _editingTemplate = CloneTemplate(found);
        }
    }

    private async Task CreateNewBlankTemplate()
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        _editingTemplate = new JurisdictionTemplate
        {
            JurisdictionId = "CUSTOM-JURISDICTION",
            Name = "Custom Jurisdiction",
            CountryCode = "US",
            RegionCode = "GEN",
            TaxYear = DateTime.Today.Year,
            DefaultCurrency = "USD",
            TaxMappingStandard = "NONE",
            ChartOfAccounts = CloneTemplate(TemplateService.GetActiveTemplate()).ChartOfAccounts,
            SalesTaxes = [],
            MileageRules = new MileageAllowanceRule { PrimaryRatePerKm = 0.67m },
            PayrollRules = new JurisdictionPayrollRules { DefaultVacationRate = 0.04m }
        };
    }

    private async Task CloneCurrentTemplate()
    {
        if (!await AuthorizeSettingsMutationAsync()) return;
        var copy = CloneTemplate(_editingTemplate);
        copy.JurisdictionId = $"{copy.JurisdictionId}-CUSTOM";
        copy.Name = $"{copy.Name} (Company Adapted)";
        _editingTemplate = copy;
        Snackbar.Add(BizLoc["Cloned template. Edit any rules below and click 'Save & Activate Template'."].Value, Severity.Info);
    }

