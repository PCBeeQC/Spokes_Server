@namespace Spokes_Server.Components.Pages.Admin.Features
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Maintenance.Destinations
@using Spokes_Server.Core.Services.Licensing
@using Spokes_Server.Core.Services.Security
@implements IDisposable
@inject Database Db
@inject BackupDestinationCoordinator DestinationCoordinator
@inject LicenseValidationService LicenseValidationService
@inject UserService UserService
@inject OAuthStateNonceService OAuthStateNonce
@inject NavigationManager Nav
@inject ISnackbar Snackbar

@if (!_isEffectiveAdmin)
{
    <SettingsCard Title="@Loc["Remote Backup Destinations"]"
                  Icon="@Icons.Material.Filled.CloudSync"
                  Description="@Loc["Administrator access is required to view or manage remote backup destinations."]">
        <MudAlert Severity="Severity.Warning" Dense="true">
            @Loc["Only an active Global Administrator can view or modify remote backup destination credentials."]
        </MudAlert>
    </SettingsCard>
}
else
{
@* --- Card 2: Remote Backup Destinations --- *@
<SettingsCard Title="@Loc["Remote Backup Destinations"]"
              Icon="@Icons.Material.Filled.CloudSync"
              Description="@Loc["Automatically mirror backup archives to external cloud, network storage, or local mount destinations."]">

    @* Testing hint alert banner *@
    <div class="d-flex align-center gap-2 mb-4 pa-3 rounded-lg" style="background-color: var(--mud-palette-background-grey);">
        <MudIcon Icon="@Icons.Material.Filled.Info" Size="Size.Small" Color="Color.Info" />
        <MudText Typo="Typo.caption" Color="Color.Secondary">
            @Loc["To test a remote backup upload, simply click Backup Now above. Enabled destinations will show live upload progress below."]
        </MudText>
    </div>

    <MudStack Spacing="3">
        @* --- 1. Local / NAS Mount --- *@
        @{
            var mountTest = GetTestState(BackupDestinationType.LocalMount);
        }
        <BackupDestinationCard Title="@Loc["Local / NAS Mount"]"
                               Subtitle="@Loc["Attached volume, secondary disk, or mounted NFS/SMB share."]"
                               ExpandedDescription="@Loc["Copy backup archives to an attached volume, secondary disk, or mounted NFS/SMB share."]"
                               Icon="@Icons.Material.Filled.FolderShared"
                               Status="@DestinationCoordinator.GetStatus(BackupDestinationType.LocalMount)"
                               IsEnabled="@Profile.Backup.SecondaryMount.IsEnabled"
                               IsEnabledChanged="@((bool v) => ToggleDestination(BackupDestinationType.LocalMount, v))"
                               IsExpanded="@IsExpanded(BackupDestinationType.LocalMount)"
                               OnToggleExpanded="@(() => ToggleOpenAsync(BackupDestinationType.LocalMount))"
                               TestButtonLabel="@Loc["Test Mount Access"]"
                               IsTesting="@mountTest.IsTesting"
                               TestMessage="@mountTest.Message"
                               TestSuccess="@mountTest.Success"
                               OnTestConnection="@(() => TestConnectionAsync(BackupDestinationType.LocalMount))">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="8">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.SecondaryMount.MountPath"
                                  Label="@Loc["Mount / Directory Path"]"
                                  HelperText="@Loc["e.g. /mnt/nas/backups or \\\\nas\\backups"]" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     @bind-Value="Profile.Backup.SecondaryMount.RetentionCount"
                                     Label="@Loc["Backups to Keep"]" Min="1" Max="100" />
                </MudItem>
            </MudGrid>
        </BackupDestinationCard>

        @* --- 2. Google Drive --- *@
        @{
            var gDriveLicense = LicenseValidationService.ValidateLicense(Profile.LicensePayload, Db.ServerConfigs.GetOrCreateGlobalConfig());
            bool isGDrivePassActive = LicenseValidationService.IsLicenseActive(gDriveLicense.Status);
            bool hasExistingGDriveSetup = !string.IsNullOrEmpty(Profile.Backup.GoogleDrive.RefreshToken);
            var gdriveTest = GetTestState(BackupDestinationType.GoogleDrive);
        }
        <BackupDestinationCard Title="@Loc["Google Drive"]"
                               Subtitle="@Loc["Upload backups directly to your Google Drive. Requires an active Spokes Pass."]"
                               ExpandedDescription="@Loc["Upload backups directly to your Google Drive. Requires an active Spokes Pass."]"
                               Icon="@Icons.Custom.Brands.Google"
                               Status="@DestinationCoordinator.GetStatus(BackupDestinationType.GoogleDrive)"
                               IsEnabled="@Profile.Backup.GoogleDrive.IsEnabled"
                               IsEnabledChanged="@((bool v) => ToggleDestination(BackupDestinationType.GoogleDrive, v))"
                               SwitchDisabled="@(!isGDrivePassActive && !hasExistingGDriveSetup)"
                               ShowConnectedDisabledBadge="@hasExistingGDriveSetup"
                               IsExpanded="@IsExpanded(BackupDestinationType.GoogleDrive)"
                               OnToggleExpanded="@(() => ToggleOpenAsync(BackupDestinationType.GoogleDrive))"
                               ShowFooter="@(isGDrivePassActive || hasExistingGDriveSetup)"
                               ShowTestButton="@hasExistingGDriveSetup"
                               TestButtonLabel="@Loc["Test Connection"]"
                               IsTesting="@gdriveTest.IsTesting"
                               TestMessage="@gdriveTest.Message"
                               TestSuccess="@gdriveTest.Success"
                               OnTestConnection="@(() => TestConnectionAsync(BackupDestinationType.GoogleDrive))">
            <ChildContent>
                @if (hasExistingGDriveSetup && !Profile.Backup.GoogleDrive.IsEnabled)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        @Loc["Google Drive is connected, but this backup destination is currently disabled. Enable the switch above to include it in backups."]
                    </MudAlert>
                }

                @if (!isGDrivePassActive)
                {
                    @if (hasExistingGDriveSetup)
                    {
                        <MudAlert Severity="Severity.Info" Variant="Variant.Outlined" Class="mt-3">
                            @Loc["Your Spokes Pass has expired. Setting up a new account is disabled, but your current Google Drive backup will keep working."]
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mt-3">
                            <b>@Loc["Spokes Pass Required:"]</b> @Loc["Google Drive backup is a Spokes Pass feature. Upload your .spokes-license in Licensing settings or enjoy your 2-month trial."]
                        </MudAlert>
                    }
                }

                @if (isGDrivePassActive || hasExistingGDriveSetup)
                {
                    <MudGrid Spacing="3" Class="mt-1">
                        <MudItem xs="12" sm="8">
                            <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          @bind-Value="Profile.Backup.GoogleDrive.TargetFolderName"
                                          Label="@Loc["Target Folder Name"]"
                                          HelperText="@Loc["Folder will be created automatically in your Google Drive"]" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                             @bind-Value="Profile.Backup.GoogleDrive.RetentionCount"
                                             Label="@Loc["Backups to Keep"]" Min="1" Max="100" />
                        </MudItem>
                    </MudGrid>
                }
            </ChildContent>
            <ExtraFooterActions>
                @if (!hasExistingGDriveSetup)
                {
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                               StartIcon="@Icons.Custom.Brands.Google"
                               Disabled="@(!isGDrivePassActive)"
                               OnClick="ConnectGoogleDrive">
                        @Loc["Connect Google Drive"]
                    </MudButton>
                }
                else
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                        @Loc["Connected to Google Drive"]
                    </MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               OnClick="DisconnectGoogleDrive">
                        @Loc["Disconnect"]
                    </MudButton>
                }
            </ExtraFooterActions>
        </BackupDestinationCard>

        @* --- 3. GitHub --- *@
        @{
            bool isGitHubConnected = !string.IsNullOrWhiteSpace(Profile.Backup.GitHub.PersonalAccessToken);
            var githubTest = GetTestState(BackupDestinationType.GitHub);
        }
        <BackupDestinationCard Title="@Loc["GitHub"]"
                               Subtitle="@Loc["Sync individual server data files to a GitHub repository folder so Git tracks file changes."]"
                               ExpandedDescription="@Loc["Copy all server data files directly into a GitHub repository folder so Git can track individual file changes across commits."]"
                               UploadingText="@Loc["Syncing backup files to GitHub repository..."]"
                               Icon="@Icons.Custom.Brands.GitHub"
                               Status="@DestinationCoordinator.GetStatus(BackupDestinationType.GitHub)"
                               IsEnabled="@Profile.Backup.GitHub.IsEnabled"
                               IsEnabledChanged="@((bool v) => ToggleDestination(BackupDestinationType.GitHub, v))"
                               ShowConnectedDisabledBadge="@isGitHubConnected"
                               IsExpanded="@IsExpanded(BackupDestinationType.GitHub)"
                               OnToggleExpanded="@(() => ToggleOpenAsync(BackupDestinationType.GitHub))"
                               ShowTestButton="@isGitHubConnected"
                               TestButtonLabel="@Loc["Test Connection"]"
                               IsTesting="@githubTest.IsTesting"
                               TestMessage="@githubTest.Message"
                               TestSuccess="@githubTest.Success"
                               OnTestConnection="@(() => TestConnectionAsync(BackupDestinationType.GitHub))">
            <ChildContent>
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Dense="true" Class="mb-3">
                    @Loc["GitHub backups store individual data files directly in the repository for version tracking and external tool access. Files synced to GitHub are not encrypted with the backup archive password, regardless of the backup encryption setting."]
                </MudAlert>

                @if (isGitHubConnected && !Profile.Backup.GitHub.IsEnabled)
                {
                    <MudAlert Severity="Severity.Warning" Dense="true" Variant="Variant.Outlined" Class="mb-3">
                        @Loc["GitHub is connected, but this backup destination is currently disabled. Enable the switch above to include it in backups."]
                    </MudAlert>
                }

                @if (!isGitHubConnected)
                {
                    <MudGrid Spacing="3" Class="mt-1">
                        <MudItem xs="12" sm="8">
                            <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                          @bind-Value="_githubTokenInput"
                                          InputType="InputType.Password"
                                          Label="@Loc["Personal Access Token (PAT)"]"
                                          HelperText="@Loc["Requires 'repo' scope (classic) or 'Contents: Read and write' permission (fine-grained)."]" />
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="d-flex align-center">
                            <MudButton Class="mt-n3" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                       StartIcon="@Icons.Custom.Brands.GitHub"
                                       Disabled="@(_isConnectingGitHub || string.IsNullOrWhiteSpace(_githubTokenInput))"
                                       OnClick="ConnectGitHub">
                                @if (_isConnectingGitHub)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                    <span>@Loc["Connecting..."]</span>
                                }
                                else
                                {
                                    <span>@Loc["Connect GitHub"]</span>
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>
                }

                <MudGrid Spacing="3" Class="mt-1">
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="string" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Value="@Profile.Backup.GitHub.Repository"
                                         ValueChanged="OnGitHubRepositoryChanged"
                                         SearchFunc="SearchGitHubRepositories"
                                         CoerceText="false" CoerceValue="true" ResetValueOnEmptyText="true" Clearable="true" MaxItems="100"
                                         Label="@Loc["Repository"]"
                                         Placeholder="owner/repo"
                                         HelperText="@(_isLoadingGitHubRepos ? Loc["Loading repositories..."].Value : Loc["Select a repository or enter owner/repo"])"
                                         Adornment="@(isGitHubConnected ? Adornment.End : Adornment.None)"
                                         AdornmentIcon="@Icons.Material.Filled.Refresh"
                                         OnAdornmentClick="RefreshGitHubRepositoriesAsync" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudAutocomplete T="string" @ref="_githubFolderAutocomplete" ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                         Value="@Profile.Backup.GitHub.TargetFolder"
                                         ValueChanged="OnGitHubFolderChanged"
                                         SearchFunc="SearchGitHubFolders"
                                         CoerceText="false" CoerceValue="true" ResetValueOnEmptyText="true" Clearable="true" MaxItems="100"
                                         Label="@Loc["Target Folder in Repository"]"
                                         HelperText="@(_isLoadingGitHubFolders ? Loc["Loading folders from repository..."].Value : Loc["Select an existing folder or type a new folder path (created automatically)"])" />
                    </MudItem>
                </MudGrid>
            </ChildContent>
            <ExtraFooterActions>
                @if (isGitHubConnected)
                {
                    <MudChip T="string" Color="Color.Success" Size="Size.Small" Icon="@Icons.Material.Filled.CheckCircle">
                        @(string.IsNullOrWhiteSpace(Profile.Backup.GitHub.AccountUsername)
                            ? Loc["Connected to GitHub"].Value
                            : $"{Loc["Connected to GitHub"].Value} (@{Profile.Backup.GitHub.AccountUsername})")
                    </MudChip>
                    <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small"
                               OnClick="DisconnectGitHub">
                        @Loc["Disconnect"]
                    </MudButton>
                }
            </ExtraFooterActions>
        </BackupDestinationCard>

        @* --- 4. S3 / Compatible --- *@
        @{
            var s3Test = GetTestState(BackupDestinationType.S3);
        }
        <BackupDestinationCard Title="@Loc["S3 / Compatible"]"
                               Subtitle="@Loc["Cloudflare R2, MinIO, Backblaze B2, AWS S3, or Wasabi."]"
                               ExpandedDescription="@Loc["Upload backups to Cloudflare R2, MinIO, Backblaze B2, AWS S3, or Wasabi."]"
                               Icon="@Icons.Material.Filled.CloudUpload"
                               Status="@DestinationCoordinator.GetStatus(BackupDestinationType.S3)"
                               IsEnabled="@Profile.Backup.S3.IsEnabled"
                               IsEnabledChanged="@((bool v) => ToggleDestination(BackupDestinationType.S3, v))"
                               IsExpanded="@IsExpanded(BackupDestinationType.S3)"
                               OnToggleExpanded="@(() => ToggleOpenAsync(BackupDestinationType.S3))"
                               TestButtonLabel="@Loc["Test S3 Connection"]"
                               IsTesting="@s3Test.IsTesting"
                               TestMessage="@s3Test.Message"
                               TestSuccess="@s3Test.Success"
                               OnTestConnection="@(() => TestConnectionAsync(BackupDestinationType.S3))">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="8">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.S3.Endpoint"
                                  Label="@Loc["Endpoint URL"]"
                                  HelperText="@Loc["e.g. https://<accountid>.r2.cloudflarestorage.com or http://minio:9000 (leave empty for AWS S3)"]" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.S3.BucketName"
                                  Label="@Loc["Bucket Name"]" Required="true" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.S3.Region"
                                  Label="@Loc["Region"]" HelperText="@Loc["e.g. auto, us-east-1"]" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.S3.Prefix"
                                  Label="@Loc["Object Prefix / Folder"]" HelperText="@Loc["e.g. spokes-backups"]" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     @bind-Value="Profile.Backup.S3.RetentionCount"
                                     Label="@Loc["Backups to Keep"]" Min="1" Max="100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.S3.AccessKey"
                                  Label="@Loc["Access Key ID"]" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.S3.SecretKey"
                                  Label="@Loc["Secret Access Key"]" InputType="InputType.Password" />
                </MudItem>
                <MudItem xs="12">
                    <MudSwitch @bind-Value="Profile.Backup.S3.ForcePathStyle" Color="Color.Primary"
                               Label="@Loc["Force Path Style (Required for MinIO and self-hosted S3)"]" />
                </MudItem>
            </MudGrid>
        </BackupDestinationCard>

        @* --- 5. WebDAV --- *@
        @{
            var webdavTest = GetTestState(BackupDestinationType.WebDav);
        }
        <BackupDestinationCard Title="@Loc["WebDAV"]"
                               Subtitle="@Loc["Nextcloud, ownCloud, Synology, or Hetzner Storage Box."]"
                               ExpandedDescription="@Loc["Upload backups to Nextcloud, ownCloud, Synology, or Hetzner Storage Box."]"
                               Icon="@Icons.Material.Filled.Http"
                               Status="@DestinationCoordinator.GetStatus(BackupDestinationType.WebDav)"
                               IsEnabled="@Profile.Backup.WebDav.IsEnabled"
                               IsEnabledChanged="@((bool v) => ToggleDestination(BackupDestinationType.WebDav, v))"
                               IsExpanded="@IsExpanded(BackupDestinationType.WebDav)"
                               OnToggleExpanded="@(() => ToggleOpenAsync(BackupDestinationType.WebDav))"
                               TestButtonLabel="@Loc["Test WebDAV Connection"]"
                               IsTesting="@webdavTest.IsTesting"
                               TestMessage="@webdavTest.Message"
                               TestSuccess="@webdavTest.Success"
                               OnTestConnection="@(() => TestConnectionAsync(BackupDestinationType.WebDav))">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="8">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.WebDav.ServerUrl"
                                  Label="@Loc["WebDAV Target URL"]"
                                  HelperText="@Loc["e.g. https://nextcloud.example.com/remote.php/dav/files/user/backups/"]" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     @bind-Value="Profile.Backup.WebDav.RetentionCount"
                                     Label="@Loc["Backups to Keep"]" Min="1" Max="100" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.WebDav.Username"
                                  Label="@Loc["Username"]" />
                </MudItem>
                <MudItem xs="12" sm="6">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.WebDav.Password"
                                  Label="@Loc["Password / App Token"]" InputType="InputType.Password" />
                </MudItem>
            </MudGrid>
        </BackupDestinationCard>

        @* --- 6. SFTP (SSH) --- *@
        @{
            var sftpTest = GetTestState(BackupDestinationType.Sftp);
        }
        <BackupDestinationCard Title="@Loc["SFTP (SSH)"]"
                               Subtitle="@Loc["Upload backups to any remote Linux host or NAS over SSH/SFTP."]"
                               ExpandedDescription="@Loc["Upload backups to any remote Linux host or NAS over SSH/SFTP."]"
                               Icon="@Icons.Material.Filled.Terminal"
                               Status="@DestinationCoordinator.GetStatus(BackupDestinationType.Sftp)"
                               IsEnabled="@Profile.Backup.Sftp.IsEnabled"
                               IsEnabledChanged="@((bool v) => ToggleDestination(BackupDestinationType.Sftp, v))"
                               IsExpanded="@IsExpanded(BackupDestinationType.Sftp)"
                               OnToggleExpanded="@(() => ToggleOpenAsync(BackupDestinationType.Sftp))"
                               TestButtonLabel="@Loc["Test SFTP Connection"]"
                               IsTesting="@sftpTest.IsTesting"
                               TestMessage="@sftpTest.Message"
                               TestSuccess="@sftpTest.Success"
                               OnTestConnection="@(() => TestConnectionAsync(BackupDestinationType.Sftp))">
            <MudGrid Spacing="3">
                <MudItem xs="12" sm="6">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.Sftp.Host"
                                  Label="@Loc["Host / IP Address"]" />
                </MudItem>
                <MudItem xs="12" sm="2">
                    <MudNumericField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     @bind-Value="Profile.Backup.Sftp.Port"
                                     Label="@Loc["Port"]" Min="1" Max="65535" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                     @bind-Value="Profile.Backup.Sftp.RetentionCount"
                                     Label="@Loc["Backups to Keep"]" Min="1" Max="100" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.Sftp.Username"
                                  Label="@Loc["Username"]" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.Sftp.Password"
                                  Label="@Loc["Password"]" InputType="InputType.Password" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.Sftp.RemotePath"
                                  Label="@Loc["Remote Directory"]" HelperText="@Loc["e.g. /backups"]" />
                </MudItem>
                <MudItem xs="12" sm="8">
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  @bind-Value="Profile.Backup.Sftp.TrustedHostKeyFingerprint"
                                  Placeholder="SHA256:..."
                                  Label="@Loc["Trusted SSH Host Key Fingerprint"]"
                                  HelperText="@Loc["Pinned automatically on first connection (TOFU), or enter an expected SHA256:... fingerprint manually."]" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="d-flex align-start pt-4">
                    <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Small"
                               StartIcon="@Icons.Material.Filled.RestartAlt"
                               Disabled="@(sftpTest.IsTesting || string.IsNullOrWhiteSpace(Profile.Backup.Sftp.TrustedHostKeyFingerprint))"
                               OnClick="ResetSftpHostKey">
                        @Loc["Reset / Re-trust Host Key"]
                    </MudButton>
                </MudItem>
            </MudGrid>
        </BackupDestinationCard>
    </MudStack>
</SettingsCard>
}

@code {
    [Parameter] public CompanyProfile Profile { get; set; } = default!;

    private sealed class DestinationTestState
    {
        public bool IsTesting { get; set; }
        public bool Success { get; set; }
        public string? Message { get; set; }
    }

    private bool _isEffectiveAdmin;
    private readonly Dictionary<BackupDestinationType, bool> _expanded = new();
    private readonly Dictionary<BackupDestinationType, DestinationTestState> _testStates = new();

    private bool _isConnectingGitHub;
    private string _githubTokenInput = string.Empty;
    private bool _isLoadingGitHubRepos;
    private bool _isLoadingGitHubFolders;
    private bool _githubReposLoaded;
    private List<GitHubRepoItem> _githubRepos = new();
    private List<string> _githubFolders = new();
    private MudAutocomplete<string>? _githubFolderAutocomplete;

    private bool IsExpanded(BackupDestinationType type) => _expanded.GetValueOrDefault(type, false);

    private DestinationTestState GetTestState(BackupDestinationType type)
    {
        if (!_testStates.TryGetValue(type, out var state))
        {
            state = new DestinationTestState();
            _testStates[type] = state;
        }
        return state;
    }

    protected override async Task OnInitializedAsync()
    {
        var caller = await UserService.GetEmployeeAsync();
        _isEffectiveAdmin = caller is { IsActiveUnsuspended: true } && caller.IsEffectiveAdmin;
        if (!_isEffectiveAdmin)
        {
            return;
        }

        // Initial state: Collapsed if disabled, open if enabled
        foreach (var type in Enum.GetValues<BackupDestinationType>())
        {
            _expanded[type] = Profile?.Backup.GetDestinationConfig(type).IsEnabled ?? false;
        }

        DestinationCoordinator.OnDestinationStatusChanged += HandleDestinationStatusChanged;
    }

    private async Task<Employee?> RequireEffectiveAdminAsync()
    {
        var caller = await UserService.GetEmployeeAsync();
        _isEffectiveAdmin = caller is { IsActiveUnsuspended: true } && caller.IsEffectiveAdmin;
        if (!_isEffectiveAdmin)
        {
            Snackbar.Add(Loc["Only an active Global Administrator can perform remote backup operations."].Value, Severity.Error);
            return null;
        }

        return caller;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isEffectiveAdmin)
        {
            return;
        }

        if (firstRender && IsExpanded(BackupDestinationType.GitHub) &&
            !string.IsNullOrWhiteSpace(Profile?.Backup.GitHub.PersonalAccessToken))
        {
            await EnsureGitHubMetadataLoadedAsync();
        }
    }

    private void HandleDestinationStatusChanged(BackupDestinationType type, DestinationUploadStatus status)
    {
        if (!_isEffectiveAdmin) return;
        SyncPersistedBackupSecrets(type);
        _ = InvokeAsync(StateHasChanged);
    }

    private void SyncPersistedBackupSecrets(BackupDestinationType type)
    {
        var persisted = Db.CompanyProfile.Get();
        if (persisted == null || Profile == null)
        {
            return;
        }

        if (type == BackupDestinationType.Sftp && !string.IsNullOrWhiteSpace(persisted.Backup.Sftp.TrustedHostKeyFingerprint))
        {
            Profile.Backup.Sftp.TrustedHostKeyFingerprint = persisted.Backup.Sftp.TrustedHostKeyFingerprint;
        }
    }

    public void Dispose()
    {
        DestinationCoordinator.OnDestinationStatusChanged -= HandleDestinationStatusChanged;
    }

    private async Task ToggleOpenAsync(BackupDestinationType type)
    {
        if (type == BackupDestinationType.GitHub)
        {
            if (await RequireEffectiveAdminAsync() == null) return;
        }
        else if (!_isEffectiveAdmin)
        {
            return;
        }

        bool newState = !IsExpanded(type);
        _expanded[type] = newState;

        if (type == BackupDestinationType.GitHub && newState && !string.IsNullOrWhiteSpace(Profile.Backup.GitHub.PersonalAccessToken))
        {
            await EnsureGitHubMetadataLoadedAsync();
        }
    }

    private async Task ToggleDestination(BackupDestinationType type, bool isEnabled)
    {
        if (await RequireEffectiveAdminAsync() == null) return;

        Profile.Backup.GetDestinationConfig(type).IsEnabled = isEnabled;

        // Turning ON opens the card, turning OFF collapses it
        _expanded[type] = isEnabled;

        Db.CompanyProfile.Save(Profile);

        if (type == BackupDestinationType.GitHub && isEnabled && !string.IsNullOrWhiteSpace(Profile.Backup.GitHub.PersonalAccessToken))
        {
            await EnsureGitHubMetadataLoadedAsync();
        }
    }

    private async Task TestConnectionAsync(BackupDestinationType type)
    {
        if (await RequireEffectiveAdminAsync() == null) return;

        var testState = GetTestState(type);
        testState.IsTesting = true;
        testState.Message = Loc["Testing connection..."].Value;
        Db.CompanyProfile.Save(Profile);
        StateHasChanged();

        try
        {
            var res = await DestinationCoordinator.TestConnectionAsync(type);
            testState.Success = res.Success;
            testState.Message = res.Message;
        }
        finally
        {
            SyncPersistedBackupSecrets(type);
            testState.IsTesting = false;
            StateHasChanged();
        }
    }

    private async Task ResetSftpHostKey()
    {
        if (await RequireEffectiveAdminAsync() == null) return;
        Profile.Backup.Sftp.TrustedHostKeyFingerprint = string.Empty;
        Db.CompanyProfile.Save(Profile);
        GetTestState(BackupDestinationType.Sftp).Message = null;
        Snackbar.Add(Loc["Pinned SSH host key cleared. The next SFTP connection will trust and pin the host key."].Value, Severity.Info);
        if (Profile != null)
        {
            StateHasChanged();
        }
    }

    private async Task ConnectGoogleDrive()
    {
        var adminEmp = await RequireEffectiveAdminAsync();
        if (adminEmp == null) return;

        var gDriveLicense = LicenseValidationService.ValidateLicense(Profile.LicensePayload, Db.ServerConfigs.GetOrCreateGlobalConfig());
        if (!LicenseValidationService.IsLicenseActive(gDriveLicense.Status))
        {
            Snackbar.Add(Loc["A valid Spokes Pass is required to connect a Google Drive account."].Value, Severity.Warning);
            return;
        }

        var sessionId = await UserService.GetSessionIdAsync();
        if (string.IsNullOrWhiteSpace(sessionId))
        {
            Snackbar.Add(Loc["An active authenticated session is required to connect Google Drive."].Value, Severity.Error);
            return;
        }

        var nonce = OAuthStateNonce.IssueNonce(adminEmp.Id, sessionId, "gdrive");
        Db.CompanyProfile.Save(Profile);
        var callbackUrl = Nav.ToAbsoluteUri($"/admin/settings?tab=backups&gdrive_state={Uri.EscapeDataString(nonce)}").ToString();
        var authUrl = await DestinationCoordinator.GetGoogleDriveAuthUrlAsync(callbackUrl);
        if (!string.IsNullOrEmpty(authUrl))
        {
            Nav.NavigateTo(authUrl, forceLoad: true);
        }
        else
        {
            Snackbar.Add(Loc["Failed to initiate Google Drive authorization. Check your Spokes Pass or relay settings."].Value, Severity.Error);
        }
    }

    private async Task DisconnectGoogleDrive()
    {
        if (await RequireEffectiveAdminAsync() == null) return;
        Profile.Backup.GoogleDrive.RefreshToken = string.Empty;
        Profile.Backup.GoogleDrive.IsEnabled = false;
        _expanded[BackupDestinationType.GoogleDrive] = false;
        Db.CompanyProfile.Save(Profile);
        GetTestState(BackupDestinationType.GoogleDrive).Message = null;
        Snackbar.Add(Loc["Disconnected from Google Drive."].Value, Severity.Info);
        StateHasChanged();
    }

    private async Task ConnectGitHub()
    {
        if (await RequireEffectiveAdminAsync() == null) return;
        if (string.IsNullOrWhiteSpace(_githubTokenInput))
        {
            return;
        }

        var githubTest = GetTestState(BackupDestinationType.GitHub);
        _isConnectingGitHub = true;
        githubTest.Message = null;
        StateHasChanged();

        try
        {
            var token = _githubTokenInput.Trim();
            var verify = await DestinationCoordinator.VerifyGitHubTokenAsync(token);
            if (!verify.Success)
            {
                githubTest.Success = false;
                githubTest.Message = verify.ErrorMessage ?? Loc["GitHub authentication failed."].Value;
                return;
            }

            Profile.Backup.GitHub.PersonalAccessToken = token;
            Profile.Backup.GitHub.IsEnabled = true;
            _expanded[BackupDestinationType.GitHub] = true;
            Profile.Backup.GitHub.AccountUsername = verify.Username;
            _githubTokenInput = string.Empty;
            Db.CompanyProfile.Save(Profile);

            Snackbar.Add(Loc["GitHub connected successfully!"].Value, Severity.Success);
            await RefreshGitHubRepositoriesAsync();
        }
        finally
        {
            _isConnectingGitHub = false;
            StateHasChanged();
        }
    }

    private async Task DisconnectGitHub()
    {
        if (await RequireEffectiveAdminAsync() == null) return;
        Profile.Backup.GitHub.PersonalAccessToken = string.Empty;
        Profile.Backup.GitHub.AccountUsername = null;
        Profile.Backup.GitHub.IsEnabled = false;
        _githubRepos.Clear();
        _githubFolders.Clear();
        _githubReposLoaded = false;
        GetTestState(BackupDestinationType.GitHub).Message = null;
        _expanded[BackupDestinationType.GitHub] = false;
        Db.CompanyProfile.Save(Profile);
        Snackbar.Add(Loc["Disconnected from GitHub."].Value, Severity.Info);
        StateHasChanged();
    }

    private async Task EnsureGitHubMetadataLoadedAsync()
    {
        if (_githubReposLoaded || _isLoadingGitHubRepos)
        {
            return;
        }

        await RefreshGitHubRepositoriesAsync();
    }

    private async Task RefreshGitHubRepositoriesAsync()
    {
        if (string.IsNullOrWhiteSpace(Profile.Backup.GitHub.PersonalAccessToken))
        {
            return;
        }

        _isLoadingGitHubRepos = true;
        StateHasChanged();

        try
        {
            _githubRepos = await DestinationCoordinator.ListGitHubRepositoriesAsync();
            _githubReposLoaded = true;

            if (!string.IsNullOrWhiteSpace(Profile.Backup.GitHub.Repository))
            {
                await LoadGitHubFoldersAsync(Profile.Backup.GitHub.Repository);
            }
        }
        finally
        {
            _isLoadingGitHubRepos = false;
            StateHasChanged();
        }
    }

    private async Task LoadGitHubFoldersAsync(string repository)
    {
        if (string.IsNullOrWhiteSpace(repository) || string.IsNullOrWhiteSpace(Profile.Backup.GitHub.PersonalAccessToken))
        {
            _githubFolders.Clear();
            return;
        }

        _isLoadingGitHubFolders = true;
        StateHasChanged();

        try
        {
            _githubFolders = await DestinationCoordinator.ListGitHubFoldersAsync(repository);
        }
        finally
        {
            _isLoadingGitHubFolders = false;
            StateHasChanged();
        }
    }

    private async Task OnGitHubRepositoryChanged(string value)
    {
        if (await RequireEffectiveAdminAsync() == null) return;
        var newRepo = value ?? string.Empty;
        bool repoChanged = !string.Equals(Profile.Backup.GitHub.Repository, newRepo, StringComparison.Ordinal);

        Profile.Backup.GitHub.Repository = newRepo;
        if (repoChanged)
        {
            Profile.Backup.GitHub.TargetFolder = string.Empty;
            _githubFolders.Clear();
            if (_githubFolderAutocomplete != null)
            {
                await _githubFolderAutocomplete.ClearAsync();
            }
        }

        Db.CompanyProfile.Save(Profile);

        if (!string.IsNullOrWhiteSpace(Profile.Backup.GitHub.Repository))
        {
            await LoadGitHubFoldersAsync(Profile.Backup.GitHub.Repository);
        }
        else
        {
            _githubFolders.Clear();
        }
    }

    private async Task OnGitHubFolderChanged(string value)
    {
        if (await RequireEffectiveAdminAsync() == null) return;
        Profile.Backup.GitHub.TargetFolder = value ?? string.Empty;
        Db.CompanyProfile.Save(Profile);
    }

    private Task<IEnumerable<string>> SearchGitHubRepositories(string value, CancellationToken token)
    {
        var allNames = _githubRepos.Select(r => r.FullName).ToList();
        if (!string.IsNullOrWhiteSpace(Profile.Backup.GitHub.Repository) &&
            !allNames.Contains(Profile.Backup.GitHub.Repository, StringComparer.OrdinalIgnoreCase))
        {
            allNames.Insert(0, Profile.Backup.GitHub.Repository);
        }

        if (string.IsNullOrWhiteSpace(value) ||
            string.Equals(value.Trim(), Profile.Backup.GitHub.Repository, StringComparison.OrdinalIgnoreCase))
        {
            return Task.FromResult<IEnumerable<string>>(allNames);
        }

        var filtered = allNames
            .Where(r => r.Contains(value.Trim(), StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!filtered.Contains(value.Trim(), StringComparer.OrdinalIgnoreCase) && value.Contains('/'))
        {
            filtered.Add(value.Trim());
        }

        return Task.FromResult<IEnumerable<string>>(filtered);
    }

    private Task<IEnumerable<string>> SearchGitHubFolders(string value, CancellationToken token)
    {
        var options = new List<string>(_githubFolders);
        if (!string.IsNullOrWhiteSpace(Profile.Backup.GitHub.TargetFolder) &&
            !options.Contains(Profile.Backup.GitHub.TargetFolder, StringComparer.OrdinalIgnoreCase))
        {
            options.Insert(0, Profile.Backup.GitHub.TargetFolder);
        }

        if (string.IsNullOrWhiteSpace(value) ||
            string.Equals(value.Trim(), Profile.Backup.GitHub.TargetFolder, StringComparison.OrdinalIgnoreCase))
        {
            return Task.FromResult<IEnumerable<string>>(options);
        }

        var trimmed = value.Trim();
        var filtered = options
            .Where(f => f.Contains(trimmed, StringComparison.OrdinalIgnoreCase))
            .ToList();

        if (!filtered.Contains(trimmed, StringComparer.OrdinalIgnoreCase))
        {
            filtered.Insert(0, trimmed);
        }

        return Task.FromResult<IEnumerable<string>>(filtered);
    }
}
