@using Spokes_Server.Aggregate.Contexts
@inject HrContext Hr
@inject NavigationManager Nav

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-4">Organization Chart</MudText>
    
    @if (TreeItems.Any())
    {
         <MudTreeView T="Employee" Items="TreeItems" SelectionMode="SelectionMode.SingleSelection">
            <ItemTemplate>
                <MudTreeViewItem T="Employee" @bind-Expanded="@context.Expanded" Items="@context.Children" Value="@context.Value">
                    <Content>
                        <MudTreeViewItemToggleButton @bind-Expanded="@context.Expanded" Visible="@context.HasChildren" />
                        @if (context.Value is { } emp)
                        {
                            <MudPaper Elevation="0" Class="d-flex flex-wrap align-center gap-3 pa-2 my-1 border-solid border-1 mud-border-primary" Style="width: 100%; border-radius: 8px;">
                                 @if (emp.HasCustomAvatar)
                                 {
                                     <MudAvatar Size="Size.Medium">
                                         <MudImage Src="@($"/spokesapi/Media/Avatar/{emp.Id}?v={emp.AvatarVersion}")" ObjectFit="ObjectFit.Cover" />
                                     </MudAvatar>
                                 }
                                 else
                                 {
                                     <MudAvatar Size="Size.Medium" Style="@($"background-color: {emp.ProfileColor ?? Colors.DeepPurple.Default}; color: {Colors.Shades.White};")">
                                         @emp.FirstName?.FirstOrDefault()@emp.LastName?.FirstOrDefault()
                                     </MudAvatar>
                                 }
                                 <div class="d-flex flex-column">
                                     <MudText Typo="Typo.body1"><b>@emp.FullName</b></MudText>
                                     <div class="d-flex align-center gap-2 flex-wrap">
                                         <MudText Typo="Typo.caption" Color="Color.Secondary">@emp.Position</MudText>
                                         @if (!string.IsNullOrEmpty(GetTeamName(emp.TeamId)))
                                         {
                                             <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ml-2">@GetTeamName(emp.TeamId)</MudChip>
                                         }
                                         @foreach(var ledTeam in GetTeamsLedBy(emp.Id))
                                         {
                                              <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.Star" Class="ml-2">Lead of @ledTeam.Name</MudChip>
                                         }
                                     </div>
                                 </div>
                                 <MudSpacer />
                                 <MudTooltip Text="Edit Timesheet">
                                    <MudIconButton Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" Color="Color.Default" 
                                                   OnClick="@(() => OpenTimesheet(emp.Id))" />
                                 </MudTooltip>
                            </MudPaper>
                        }
                    </Content>
                </MudTreeViewItem>
            </ItemTemplate>
        </MudTreeView>
    }
    else
    {
        <MudText>No employees found.</MudText>
    }

</MudPaper>

@code {
    private List<TreeItemData<Employee>> TreeItems = [];
    private List<Employee> AllEmployees = [];
    private List<Team> AllTeams = [];

    protected override void OnInitialized()
    {
        AllEmployees = Hr.Employees.GetAll().Where(e => e.IsActive).ToList();
        AllTeams = Hr.Teams.GetAll();
        BuildTree();
    }

    private void BuildTree()
    {
        TreeItems.Clear();
        
        // 1. Find Roots (Employees who effectively have no manager in the Team structure)
        // Manager Definition: If in a Team, and NOT the leader, your Manager is the Team Leader.
        // If not in a team, or ARE the leader, you are a root (for now).
        
        var roots = AllEmployees.Where(e => GetderivedManagerId(e) == null).ToList();
        
        foreach (var root in roots)
        {
            TreeItems.Add(CreateNode(root));
        }
    }

    private string? GetderivedManagerId(Employee e)
    {
        if (string.IsNullOrEmpty(e.TeamId)) return null; // No Team -> No Manager (Root)
        
        var team = AllTeams.FirstOrDefault(t => t.Id == e.TeamId);
        if (team == null) return null; // Invalid Team
        
        if (team.LeaderId == e.Id) return null; // I am the Leader -> No Manager (Root)
        
        return team.LeaderId;
    }

    private TreeItemData<Employee> CreateNode(Employee emp)
    {
        return new TreeItemData<Employee>
        {
            Value = emp,
            Expanded = true,
            Children = AllEmployees.Where(e => GetderivedManagerId(e) == emp.Id).Select(CreateNode).ToList()
        };
    }

    private string GetTeamName(string teamId)
    {
        if (string.IsNullOrEmpty(teamId)) return "";
        return AllTeams.FirstOrDefault(t => t.Id == teamId)?.Name ?? "";
    }

    private void OpenTimesheet(string employeeId) => Nav.NavigateTo($"/timesheet/{employeeId}");

    private IEnumerable<Team> GetTeamsLedBy(string employeeId) => AllTeams.Where(t => t.LeaderId == employeeId);
}

