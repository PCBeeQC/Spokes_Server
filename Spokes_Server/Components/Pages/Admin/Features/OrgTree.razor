@using Spokes_Server.Aggregate.Contexts
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Security
@inject HrContext Hr
@inject UserService UserService
@inject IUserPrivacyService PrivacyService
@inject NavigationManager Nav

<MudPaper Class="pa-4" Elevation="0" Outlined="true">
    <MudText Typo="Typo.h6" Class="mb-4">Organization Chart</MudText>
    
    @if (TreeItems.Any())
    {
         <MudTreeView T="Employee" Items="TreeItems" SelectionMode="SelectionMode.SingleSelection">
            <ItemTemplate>
                <MudTreeViewItem T="Employee" @bind-Expanded="@context.Expanded" Items="@context.Children" Value="@context.Value">
                    <Content>
                        <MudTreeViewItemToggleButton @bind-Expanded="@context.Expanded" Visible="@context.HasChildren" />
                        @if (context.Value is { } emp)
                        {
                            <MudPaper Elevation="0" Class="d-flex flex-wrap align-center gap-3 pa-2 my-1 border-solid border-1 mud-border-primary" Style="width: 100%; border-radius: 8px;">
                                 @if (emp.HasCustomAvatar)
                                 {
                                     <MudAvatar Size="Size.Medium">
                                         <MudImage Src="@($"/spokesapi/Media/Avatar/{emp.Id}?v={emp.AvatarVersion}")" ObjectFit="ObjectFit.Cover" />
                                     </MudAvatar>
                                 }
                                 else
                                 {
                                     <MudAvatar Size="Size.Medium" Style="@($"background-color: {emp.ProfileColor ?? Colors.DeepPurple.Default}; color: {Colors.Shades.White};")">
                                         @emp.FirstName?.FirstOrDefault()@emp.LastName?.FirstOrDefault()
                                     </MudAvatar>
                                 }
                                 <div class="d-flex flex-column">
                                     <MudText Typo="Typo.body1"><b>@emp.FullName</b></MudText>
                                     <div class="d-flex align-center gap-2 flex-wrap">
                                         <MudText Typo="Typo.caption" Color="Color.Secondary">@emp.Position</MudText>
                                         @if (!string.IsNullOrEmpty(GetTeamName(emp.TeamId)))
                                         {
                                             <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Color="Color.Info" Class="ml-2">@GetTeamName(emp.TeamId)</MudChip>
                                         }
                                         @foreach(var ledTeam in GetTeamsLedBy(emp.Id))
                                         {
                                              <MudChip T="string" Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary" Icon="@Icons.Material.Filled.Star" Class="ml-2">Lead of @ledTeam.Name</MudChip>
                                         }
                                     </div>
                                 </div>
                                 <MudSpacer />
                                 @if (!ReadOnly && _currentUser?.IsActiveUnsuspended == true)
                                 {
                                     <MudTooltip Text="Edit Timesheet">
                                        <MudIconButton Icon="@Icons.Material.Filled.EditCalendar" Size="Size.Small" Color="Color.Default" 
                                                       OnClick="@(() => OpenTimesheet(emp.Id))" />
                                     </MudTooltip>
                                 }
                            </MudPaper>
                        }
                    </Content>
                </MudTreeViewItem>
            </ItemTemplate>
        </MudTreeView>
    }
    else
    {
        <MudText>No employees found.</MudText>
    }

</MudPaper>

@code {
    [Parameter] public bool ReadOnly { get; set; } = false;

    private List<TreeItemData<Employee>> TreeItems = [];
    private List<Employee> AllEmployees = [];
    private List<Team> AllTeams = [];
    private Employee? _currentUser;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync(allowSuspended: true);
        if (_currentUser == null || !PrivacyService.CanViewDirectory(_currentUser))
        {
            AllEmployees = [];
            AllTeams = [];
            TreeItems = [];
            return;
        }

        var candidates = Hr.Employees.GetAll()
            .Where(e => e.IsActive && !e.IsBanned && !e.IsSystem && e.Id != AccountDeletionService.SystemDeletedUserId);
        AllEmployees = PrivacyService.FilterDiscoverableEmployees(_currentUser, candidates);
        AllTeams = PrivacyService.FilterDiscoverableTeams(_currentUser, Hr.Teams.GetAll());
        BuildTree();
    }

    private void BuildTree()
    {
        TreeItems.Clear();

        var visibleIds = AllEmployees.Select(e => e.Id).ToHashSet(StringComparer.Ordinal);
        var visited = new HashSet<string>(StringComparer.Ordinal);

        // 1. Find Roots (Employees who effectively have no manager in the visible Team structure)
        // Manager Definition: If in a Team, and NOT the leader, your Manager is the Team Leader.
        // If not in a team, ARE the leader, or the leader is outside your privacy scope, you become a root.
        var roots = AllEmployees.Where(e => GetderivedManagerId(e, visibleIds) == null).ToList();

        foreach (var root in roots)
        {
            if (visited.Add(root.Id))
            {
                TreeItems.Add(CreateNode(root, visibleIds, visited));
            }
        }

        // Guard against leader cycles among remaining visible employees.
        foreach (var emp in AllEmployees)
        {
            if (visited.Add(emp.Id))
            {
                TreeItems.Add(CreateNode(emp, visibleIds, visited));
            }
        }
    }

    private string? GetderivedManagerId(Employee e, HashSet<string>? visibleIds = null)
    {
        if (string.IsNullOrEmpty(e.TeamId)) return null; // No Team -> No Manager (Root)

        var team = AllTeams.FirstOrDefault(t => t.Id == e.TeamId);
        if (team == null) return null; // Invalid or undiscoverable Team

        if (string.IsNullOrEmpty(team.LeaderId) || team.LeaderId == e.Id) return null; // I am the Leader -> No Manager (Root)

        if (visibleIds != null && !visibleIds.Contains(team.LeaderId)) return null; // Undiscoverable leader -> promote to Root

        return team.LeaderId;
    }

    private TreeItemData<Employee> CreateNode(Employee emp, HashSet<string> visibleIds, HashSet<string> visited)
    {
        var children = new List<TreeItemData<Employee>>();
        foreach (var child in AllEmployees.Where(e => GetderivedManagerId(e, visibleIds) == emp.Id))
        {
            if (visited.Add(child.Id))
            {
                children.Add(CreateNode(child, visibleIds, visited));
            }
        }

        return new TreeItemData<Employee>
        {
            Value = emp,
            Expanded = true,
            Children = children
        };
    }

    private string GetTeamName(string teamId)
    {
        if (string.IsNullOrEmpty(teamId)) return "";
        return AllTeams.FirstOrDefault(t => t.Id == teamId)?.Name ?? "";
    }

    private void OpenTimesheet(string employeeId) => Nav.NavigateTo($"/timesheet/{employeeId}");

    private IEnumerable<Team> GetTeamsLedBy(string employeeId) => AllTeams.Where(t => t.LeaderId == employeeId);
}

