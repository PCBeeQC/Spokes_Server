@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Components.Pages.HR
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Shared
@using Spokes_Server.Core.Services
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Security
@implements IDisposable

@inject Database Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ChatService ChatService
@inject NavigationManager Nav
@inject IServiceScopeFactory ScopeFactory
@inject AppLabelService AppLabels
@inject PresenceStateService PresenceState
@inject UserService UserService
@inject IUserPrivacyService PrivacyService

<div class="d-flex flex-wrap gap-4 align-center mb-6">
    <MudTextField @bind-Value="searchString" Placeholder="@Loc["Search Directory..."]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="flex-grow-1" Style="max-width: 600px; background-color: var(--mud-palette-surface);" />
    @if (_isAdminOrManager)
    {
        <MudSwitch T="bool" Value="_showInactive" ValueChanged="OnShowInactiveChanged" Color="Color.Primary" Label="@Loc["Show Inactive"]" />
    }
    <MudSpacer />
    @if (_isAdminOrManager && isDev)
    {
        <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.PersonAdd" OnClick="CreateNewEmployee">@string.Format(Loc["New {0}"].Value, AppLabels.Employee)</MudButton>
    }
</div>

<MudGrid Spacing="3">
    @foreach (var context in EmployeeList.Where(FilterFunc))
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <UserDirectoryCard Employee="@context"
                               CurrentUser="@_currentUser"
                               ShowManageMenu="@_isAdminOrManager"
                               OnEdit="@OpenEditDialog"
                               OnDelete="@ConfirmDeleteEmployee" />
        </MudItem>
    }
</MudGrid>

    @code {
    private List<Employee> EmployeeList = new();
    private string searchString = "";
    private bool _showInactive = false;
    private Employee? _currentUser;
    private bool _isAdminOrManager => _currentUser?.IsAdmin == true || _currentUser?.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Admin.ManageUsers) == true;
    private bool isDev = false;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync();
        RefreshList();

        // Subscribe to presence changes so last seen updates live if possible
        if (PresenceState != null)
        {
            PresenceState.OnUserPresenceChanged += HandlePresenceChanged;
        }
    }

    private void HandlePresenceChanged(string userId)
    {
        InvokeAsync(StateHasChanged);
    }

    private void OnShowInactiveChanged(bool val)
    {
        _showInactive = val;
        RefreshList();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (PresenceState != null)
        {
            PresenceState.OnUserPresenceChanged -= HandlePresenceChanged;
        }
    }

    private void RefreshList()
    {
        var query = Db.Employees.GetAll().AsEnumerable();
        if (!_showInactive || !_isAdminOrManager)
        {
            query = query.Where(e => e.IsActive);
        }

        // Active users sorted by presence snapshot, inactive users at the bottom
        var rawList = query
            .OrderByDescending(e => e.IsActive)
            .ThenByDescending(e => PresenceState.HasActiveConnection(e.Id)) // Connection pushes up
            .ThenBy(e => PresenceState.IsGloballyAway(e.Id)) // But false (Active) goes above true (Away)
            .ThenByDescending(e => PresenceState.GetLastSeen(e.Id) ?? DateTime.MinValue)
            .ThenBy(e => e.FullName);

        EmployeeList = PrivacyService.FilterDiscoverableEmployees(_currentUser, rawList);
    }

    private async Task CreateNewEmployee()
    {
        var newEmployee = new Employee { FirstName = "", LastName = "", IsActive = true };
        var allOpenIdAccounts = _currentUser?.IsAdmin == true ? Db.OpenIdAccounts.GetAll().ToList() : new List<OpenIdAccount>();
        var parameters = new DialogParameters
        {
            ["Employee"] = newEmployee,
            ["AllEmployees"] = EmployeeList,
            ["AllTeams"] = Db.Teams.GetAll().OrderBy(t => t.Name).ToList(),
            ["AllOpenIdAccounts"] = allOpenIdAccounts
        };
        
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<EmployeeDialog>(string.Format(Loc["Create New {0}"].Value, AppLabels.Employee), parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: Employee createdEmp })
        {
            Db.Employees.Save(createdEmp);
            
            if (_currentUser?.IsAdmin == true)
            {
                foreach (var account in allOpenIdAccounts) Db.OpenIdAccounts.Save(account);
            }

            _ = Task.Run(async () =>
            {
                using var scope = ScopeFactory.CreateScope();
                var syncService = scope.ServiceProvider.GetRequiredService<IEmailSyncService>();
                await syncService.SyncEmployeeAsync(createdEmp.Id);
            });

            Snackbar.Add(string.Format(Loc["{0} '{1}' created"].Value, AppLabels.Employee, createdEmp.FullName), Severity.Success);
            RefreshList();
        }
    }

    private async Task OpenEditDialog(Employee emp)
    {
        var clone = System.Text.Json.JsonSerializer.Deserialize<Employee>(System.Text.Json.JsonSerializer.Serialize(emp));
        var allOpenIdAccounts = _currentUser?.IsAdmin == true ? Db.OpenIdAccounts.GetAll().ToList() : new List<OpenIdAccount>();
        var parameters = new DialogParameters
        {
            ["Employee"] = clone,
            ["AllEmployees"] = EmployeeList,
            ["AllTeams"] = Db.Teams.GetAll().OrderBy(t => t.Name).ToList(),
            ["AllOpenIdAccounts"] = allOpenIdAccounts
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<EmployeeDialog>(string.Format(Loc["Edit {0}"].Value, AppLabels.Employee), parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: Employee updatedEmp })
        {
            Db.Employees.Save(updatedEmp);
            if (_currentUser?.IsAdmin == true)
            {
                foreach (var account in allOpenIdAccounts) Db.OpenIdAccounts.Save(account);
            }

            _ = Task.Run(async () =>
            {
                using var scope = ScopeFactory.CreateScope();
                var syncService = scope.ServiceProvider.GetRequiredService<IEmailSyncService>();
                await syncService.SyncEmployeeAsync(updatedEmp.Id);
            });

            Snackbar.Add(string.Format(Loc["{0} updated"].Value, AppLabels.Employee), Severity.Success);
            RefreshList();
        }
    }

    private bool FilterFunc(Employee element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (element.Position.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task ConfirmDeleteEmployee(Employee emp)
    {
        var parameters = new DialogParameters
        {
            ["ContentText"] = string.Format(Loc["Are you sure you want to delete the {0} '{1}'? This action cannot be undone. Any OpenID accounts linked to this {0} will be unlinked."].Value, AppLabels.Employee.ToLowerInvariant(), emp.FullName),
            ["ButtonText"] = Loc["Delete"].Value,
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(Loc["Confirm Delete"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            var linkedAccounts = Db.OpenIdAccounts.GetByEmployeeId(emp.Id);
            foreach (var account in linkedAccounts)
            {
                account.LinkedEmployeeId = string.Empty;
                Db.OpenIdAccounts.Save(account);
            }

            Db.Employees.Delete(emp.Id);
            Snackbar.Add(string.Format(Loc["{0} '{1}' deleted"].Value, AppLabels.Employee, emp.FullName), Severity.Warning);
            RefreshList();
        }
    }
}


