@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Components.Pages.HR
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Shared
@using Spokes_Server.Core.Services
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Communication.Voice
@using Spokes_Server.Core.Services.Security
@implements IDisposable

@inject Database Db
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject VoiceChannelService VoiceChannelService
@inject AppLabelService AppLabels
@inject PresenceStateService PresenceState
@inject UserService UserService
@inject IUserPrivacyService PrivacyService
@inject SessionService SessionService

<div class="d-flex flex-wrap gap-4 align-center mb-6">
    <MudTextField @bind-Value="searchString" Immediate="true" Clearable="true" Placeholder="@Loc["Search Directory..."]" Variant="Variant.Outlined" Margin="Margin.Dense" Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="flex-grow-1" Style="max-width: 600px; background-color: var(--mud-palette-surface);" />
    @if (_isAdminOrManager)
    {
        <MudSwitch T="bool" Value="_showInactive" ValueChanged="OnShowInactiveChanged" Color="Color.Primary" Label="@Loc["Show Inactive"]" />
    }
    <MudSpacer />
</div>

<MudGrid Spacing="3">
    @foreach (var context in EmployeeList.Where(FilterFunc))
    {
        <MudItem xs="12" sm="6" md="4" lg="3">
            <UserDirectoryCard Employee="@context"
                               CurrentUser="@_currentUser"
                               ShowManageMenu="@_isAdminOrManager"
                               OnEdit="@OpenEditDialog"
                               OnDelete="@ConfirmDeleteEmployee" />
        </MudItem>
    }
</MudGrid>

    @code {
    [Parameter] public bool ReadOnly { get; set; } = false;

    private List<Employee> EmployeeList = new();
    private string searchString = "";
    private bool _showInactive = false;
    private Employee? _currentUser;
    private bool _isAdminOrManager => !ReadOnly && _currentUser != null && _currentUser.IsActiveUnsuspended && (_currentUser.IsEffectiveAdmin || _currentUser.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Hr.ManageEmployees) || _currentUser.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Admin.ManageUsers));

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync(allowSuspended: true);
        RefreshList();

        // Subscribe to presence changes so last seen updates live if possible
        if (PresenceState != null)
        {
            PresenceState.OnUserPresenceChanged += HandlePresenceChanged;
        }
    }

    private void HandlePresenceChanged(string userId)
    {
        InvokeAsync(() =>
        {
            RefreshList();
            StateHasChanged();
        });
    }

    private void OnShowInactiveChanged(bool val)
    {
        _showInactive = val;
        RefreshList();
        StateHasChanged();
    }

    public void Dispose()
    {
        if (PresenceState != null)
        {
            PresenceState.OnUserPresenceChanged -= HandlePresenceChanged;
        }
    }

    private void RefreshList()
    {
        var query = Db.Employees.GetAll().AsEnumerable();
        if (!_showInactive || !_isAdminOrManager)
        {
            query = query.Where(e => e.IsActive);
        }

        // Active users sorted by presence snapshot, inactive users at the bottom
        var rawList = query
            .OrderByDescending(e => e.IsActive)
            .ThenByDescending(e => PresenceState.HasActiveConnection(e.Id)) // Connection pushes up
            .ThenBy(e => PresenceState.IsGloballyAway(e.Id)) // But false (Active) goes above true (Away)
            .ThenByDescending(e => PresenceState.GetLastSeen(e.Id) ?? DateTime.MinValue)
            .ThenBy(e => e.FullName);

        EmployeeList = PrivacyService.FilterDiscoverableEmployees(_currentUser, rawList);
    }

    private async Task OpenEditDialog(Employee emp)
    {
        _currentUser = await UserService.GetEmployeeAsync();
        var latestBefore = Db.Employees.GetById(emp.Id) ?? emp;
        if (!_isAdminOrManager || !UserService.CanManageEmployeeTarget(_currentUser, latestBefore))
        {
            Snackbar.Add(Loc["You cannot modify or delete an Administrator account."].Value, Severity.Error);
            StateHasChanged();
            return;
        }

        var clone = latestBefore.DeepClone();
        var allOpenIdAccounts = _currentUser?.IsEffectiveAdmin == true ? Db.OpenIdAccounts.GetAll().ToList() : new List<OpenIdAccount>();
        var parameters = new DialogParameters
        {
            ["Employee"] = clone,
            ["AllEmployees"] = EmployeeList,
            ["AllTeams"] = Db.Teams.GetAll().OrderBy(t => t.Name).ToList(),
            ["AllOpenIdAccounts"] = allOpenIdAccounts
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large };
        var dialog = await DialogService.ShowAsync<EmployeeDialog>(string.Format(Loc["Edit {0}"].Value, AppLabels.Employee), parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: Employee updatedEmp })
        {
            _currentUser = await UserService.GetEmployeeAsync();
            var latestTarget = Db.Employees.GetById(emp.Id) ?? emp;
            if (!_isAdminOrManager || !UserService.CanManageEmployeeTarget(_currentUser, latestTarget))
            {
                Snackbar.Add(Loc["You cannot modify or delete an Administrator account."].Value, Severity.Error);
                StateHasChanged();
                return;
            }

            if (_currentUser?.IsEffectiveAdmin != true && _currentUser?.HasPermission(Spokes_Server.Core.Constants.AppPermissions.Admin.ManageUsers) != true)
            {
                updatedEmp.IsActive = latestTarget.IsActive;
                updatedEmp.IsAdmin = latestTarget.IsAdmin;
                updatedEmp.IsSuspended = latestTarget.IsSuspended;
                updatedEmp.IsBanned = latestTarget.IsBanned;
                updatedEmp.Permissions = latestTarget.Permissions;
                updatedEmp.PermissionGroupIds = latestTarget.PermissionGroupIds;
            }
            else if (_currentUser?.IsEffectiveAdmin != true)
            {
                updatedEmp.IsAdmin = false;
                var allowed = UserService.FilterAllowedPermissions(_currentUser, updatedEmp.Permissions);
                foreach (var existing in latestTarget.Permissions)
                {
                    if (updatedEmp.Permissions.Contains(existing) && !allowed.Contains(existing, StringComparer.OrdinalIgnoreCase))
                    {
                        allowed.Add(existing);
                    }
                }
                updatedEmp.Permissions = allowed;

                var allGroups = Db.CompanyProfile.Get()?.PermissionGroups ?? [];
                updatedEmp.PermissionGroupIds = updatedEmp.PermissionGroupIds
                    .Where(gid => latestTarget.PermissionGroupIds.Contains(gid) ||
                                  (allGroups.FirstOrDefault(g => g.Id == gid) is { } grp &&
                                   UserService.CanAssignPermissionGroup(_currentUser, grp)))
                    .ToList();
            }

            if (updatedEmp.IsAdmin)
            {
                updatedEmp.IsSuspended = false;
            }

            if (UserService.IsSoleActiveAdmin(Db.Employees, emp.Id) && (!updatedEmp.IsActive || !updatedEmp.IsAdmin))
            {
                Snackbar.Add(Loc["Cannot deactivate or demote the sole active administrator account."].Value, Severity.Error);
                return;
            }

            bool suspensionChanged = latestTarget.IsSuspended != updatedEmp.IsSuspended;
            Db.Employees.Save(updatedEmp);
            if (!updatedEmp.IsActive)
            {
                SessionService.RevokeAllUserSessions(updatedEmp.Id);
                await VoiceChannelService.EvictUserFromAllVoiceChannelsAsync(updatedEmp.Id);
            }
            else if (updatedEmp.IsBanned)
            {
                SessionService.QuarantineUserSessionsForBan(updatedEmp.Id);
                await VoiceChannelService.EvictUserFromAllVoiceChannelsAsync(updatedEmp.Id);
            }
            else if (updatedEmp.IsSuspended)
            {
                await VoiceChannelService.EvictUserFromAllVoiceChannelsAsync(updatedEmp.Id);
            }

            if (suspensionChanged)
            {
                SessionService.NotifyUserSuspensionChanged(updatedEmp.Id, updatedEmp.IsSuspended);
            }

            if (_currentUser?.IsEffectiveAdmin == true)
            {
                foreach (var account in allOpenIdAccounts) Db.OpenIdAccounts.Save(account);
            }

            Snackbar.Add(string.Format(Loc["{0} updated"].Value, AppLabels.Employee), Severity.Success);
            RefreshList();
        }
    }

    private bool FilterFunc(Employee element)
    {
        if (string.IsNullOrWhiteSpace(searchString)) return true;
        if (element.FullName.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (PrivacyService.CanViewUserEmail(_currentUser, element) &&
            !string.IsNullOrEmpty(element.Email) &&
            element.Email.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        if (!string.IsNullOrEmpty(element.Position) &&
            element.Position.Contains(searchString, StringComparison.OrdinalIgnoreCase)) return true;
        return false;
    }

    private async Task ConfirmDeleteEmployee(Employee emp)
    {
        _currentUser = await UserService.GetEmployeeAsync();
        var latestBefore = Db.Employees.GetById(emp.Id) ?? emp;
        if (!_isAdminOrManager || !UserService.CanManageEmployeeTarget(_currentUser, latestBefore))
        {
            Snackbar.Add(Loc["You cannot modify or delete an Administrator account."].Value, Severity.Error);
            StateHasChanged();
            return;
        }

        if (UserService.IsSoleActiveAdmin(Db.Employees, emp.Id))
        {
            Snackbar.Add(Loc["Cannot delete the sole active administrator account. Promote another administrator first."].Value, Severity.Error);
            return;
        }

        var parameters = new DialogParameters
        {
            ["ContentText"] = string.Format(Loc["Are you sure you want to delete the {0} '{1}'? This action cannot be undone. Any OpenID accounts linked to this {0} will be unlinked."].Value, AppLabels.Employee.ToLowerInvariant(), emp.FullName),
            ["ButtonText"] = Loc["Delete"].Value,
            ["Color"] = Color.Error
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small };
        var dialog = await DialogService.ShowAsync<ConfirmDialog>(Loc["Confirm Delete"].Value, parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false })
        {
            _currentUser = await UserService.GetEmployeeAsync();
            var latestTarget = Db.Employees.GetById(emp.Id) ?? emp;
            if (!_isAdminOrManager || !UserService.CanManageEmployeeTarget(_currentUser, latestTarget))
            {
                Snackbar.Add(Loc["You cannot modify or delete an Administrator account."].Value, Severity.Error);
                StateHasChanged();
                return;
            }

            if (UserService.IsSoleActiveAdmin(Db.Employees, emp.Id))
            {
                Snackbar.Add(Loc["Cannot delete the sole active administrator account. Promote another administrator first."].Value, Severity.Error);
                return;
            }

            var linkedAccounts = Db.OpenIdAccounts.GetByEmployeeId(emp.Id);
            foreach (var account in linkedAccounts)
            {
                account.LinkedEmployeeId = string.Empty;
                Db.OpenIdAccounts.Save(account);
            }

            await VoiceChannelService.EvictUserFromAllVoiceChannelsAsync(emp.Id);
            SessionService.RevokeAllUserSessions(emp.Id);
            Db.Employees.Delete(emp.Id);
            Snackbar.Add(string.Format(Loc["{0} '{1}' deleted"].Value, AppLabels.Employee, emp.FullName), Severity.Warning);
            RefreshList();
        }
    }
}
