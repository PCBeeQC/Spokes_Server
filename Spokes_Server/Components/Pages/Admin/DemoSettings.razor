@page "/admin/demo-settings"
@using Microsoft.Extensions.Configuration
@using SkiaSharp
@using Spokes_Server.Core.Constants
@inject IConfiguration Config
@inject Database Db
@inject BackupService BackupService
@inject ISnackbar Snackbar
@inject NavigationManager Nav
@inject UserService UserService
@attribute [Authorize(Policy = AppPermissions.Admin.PolicyName)]

<PageTitle>Demo Settings</PageTitle>

<MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
    <MudText Typo="Typo.h4" GutterBottom="true">Demo Mode Setup</MudText>

    @if (!_isDemoSetup)
    {
        <MudAlert Severity="Severity.Error">
            Demo Setup is not active. Please set Spokes_DemoSetup=true in your environment variables to use this page.
        </MudAlert>
    }
    else
    {
        <MudGrid>
            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Auto-Login User Pool</MudText>
                            <MudText Typo="Typo.body2">Select which users random visitors will be logged in as during the public demo.</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @foreach (var emp in _activeEmployees)
                        {
                            <MudCheckBox @bind-Value="_selectedIds[emp.Id]" Label="@emp.FullName" Color="Color.Primary" />
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12" md="6">
                <MudCard Elevation="2">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Sample Media Library</MudText>
                            <MudText Typo="Typo.body2">Upload sample images that users can pick from during the demo (since real uploads are blocked).</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        <MudFileUpload T="IReadOnlyList<IBrowserFile>" Accept=".jpg,.jpeg,.png,.gif" FilesChanged="UploadSampleMedia" MaximumFileCount="10">
                            <CustomContent>
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           OnClick="@context.OpenFilePickerAsync"
                                           StartIcon="@Icons.Material.Filled.CloudUpload">
                                    Upload Sample Media
                                </MudButton>
                            </CustomContent>
                            <SelectedTemplate></SelectedTemplate>
                        </MudFileUpload>

                        @if (_sampleMedia.Any())
                        {
                            <MudList T="string" Class="mt-4">
                                @foreach (var file in _sampleMedia)
                                {
                                    var f = file;
                                    <MudListItem T="string" Icon="@Icons.Material.Filled.Image">
                                        <div class="d-flex align-center justify-space-between w-100">
                                            <span>@Path.GetFileName(f)</span>
                                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => DeleteMedia(f))" />
                                        </div>
                                    </MudListItem>
                                }
                            </MudList>
                        }
                    </MudCardContent>
                </MudCard>
            </MudItem>

            <MudItem xs="12">
                <MudCard Elevation="2" Class="mt-4">
                    <MudCardHeader>
                        <CardHeaderContent>
                            <MudText Typo="Typo.h6">Golden Snapshot</MudText>
                            <MudText Typo="Typo.body2">When you are finished setting up the demo environment, save the state. The Demo Reset Service will automatically restore this snapshot every hour.</MudText>
                        </CardHeaderContent>
                    </MudCardHeader>
                    <MudCardContent>
                        @if (_lastSnapshotTime.HasValue)
                        {
                            <MudAlert Severity="Severity.Success" Class="mb-4">
                                Golden snapshot is ready! Created at: @_lastSnapshotTime.Value.ToLocalTime().ToString("g")
                            </MudAlert>
                        }
                        
                        <div class="d-flex gap-4">
                            <MudButton Variant="Variant.Filled" Color="Color.Secondary" Size="Size.Large" OnClick="SaveSnapshot" Disabled="@_isSaving">
                                @if (_isSaving)
                                {
                                    <MudProgressCircular Class="ms-n1" Size="Size.Small" Indeterminate="true"/>
                                    <MudText Class="ms-2">Saving Snapshot...</MudText>
                                }
                                else
                                {
                                    <MudText>Save Current State as Golden Snapshot</MudText>
                                }
                            </MudButton>
                            
                            @if (_lastSnapshotTime.HasValue)
                            {
                                <MudButton Variant="Variant.Outlined" Color="Color.Warning" Size="Size.Large" OnClick="RestoreSnapshot">
                                    Restore Golden State Now
                                </MudButton>
                            }
                        </div>
                    </MudCardContent>
                </MudCard>
            </MudItem>
        </MudGrid>
    }
</MudContainer>

@code {
    private static readonly HashSet<string> AllowedDemoMediaExtensions = new(StringComparer.OrdinalIgnoreCase)
    {
        ".jpg", ".jpeg", ".png", ".gif"
    };

    private bool _isDemoSetup;
    private List<Employee> _activeEmployees = [];
    private Dictionary<string, bool> _selectedIds = [];
    private List<string> _sampleMedia = [];
    private bool _isSaving;
    private DateTime? _lastSnapshotTime;
    private string _demoMediaPath = "";

    protected override async Task OnInitializedAsync()
    {
        if (!await UserService.IsAdminAsync())
        {
            _isDemoSetup = false;
            return;
        }

        _isDemoSetup = Config.GetValue<bool>("Spokes_DemoSetup");

        if (_isDemoSetup)
        {
            _activeEmployees = Db.Employees.GetAll()
                .Where(e => e.IsSelectable && !e.IsAdmin)
                .ToList();
            var config = Db.DemoConfigs.Get();

            foreach (var emp in _activeEmployees)
            {
                _selectedIds[emp.Id] = config.AutoLoginEmployeeIds.Contains(emp.Id);
            }

            var dataPath = Config["DataPath"] ?? "Data";
            _demoMediaPath = Path.GetFullPath(Path.Combine(dataPath, "DemoMedia"));
            if (Directory.Exists(_demoMediaPath))
            {
                _sampleMedia = Directory.GetFiles(_demoMediaPath)
                    .Where(f => AllowedDemoMediaExtensions.Contains(Path.GetExtension(f)))
                    .ToList();
            }

            var snapshotPath = Path.Combine(dataPath, "Backups", "demo_golden_snapshot.zip");
            if (File.Exists(snapshotPath))
            {
                _lastSnapshotTime = File.GetCreationTimeUtc(snapshotPath);
            }
        }
    }

    private async Task<bool> EnsureAuthorizedDemoSetupMutationAsync()
    {
        if (!Config.GetValue<bool>("Spokes_DemoSetup"))
        {
            _isDemoSetup = false;
            Snackbar.Add("Demo Setup is not active.", Severity.Error);
            return false;
        }

        if (!await UserService.IsAdminAsync())
        {
            Snackbar.Add("Global administrator privileges are required.", Severity.Error);
            return false;
        }

        return true;
    }

    private bool TryResolveSafeSampleMediaTargetPath(string? rawFileName, out string fullPath)
    {
        fullPath = string.Empty;
        if (string.IsNullOrWhiteSpace(rawFileName) || string.IsNullOrWhiteSpace(_demoMediaPath))
        {
            return false;
        }

        if (!string.Equals(rawFileName, Path.GetFileName(rawFileName), StringComparison.Ordinal) ||
            rawFileName.Contains("..", StringComparison.Ordinal) ||
            rawFileName.Contains('/') ||
            rawFileName.Contains('\\') ||
            rawFileName.IndexOfAny(Path.GetInvalidFileNameChars()) >= 0)
        {
            return false;
        }

        var ext = Path.GetExtension(rawFileName);
        if (!AllowedDemoMediaExtensions.Contains(ext))
        {
            return false;
        }

        var rootFull = Path.TrimEndingDirectorySeparator(Path.GetFullPath(_demoMediaPath)) + Path.DirectorySeparatorChar;
        var candidateFull = Path.GetFullPath(Path.Combine(rootFull, rawFileName));
        if (!candidateFull.StartsWith(rootFull, StringComparison.OrdinalIgnoreCase))
        {
            return false;
        }

        fullPath = candidateFull;
        return true;
    }

    private async Task UploadSampleMedia(IReadOnlyList<IBrowserFile> files)
    {
        if (!await EnsureAuthorizedDemoSetupMutationAsync()) return;

        try
        {
            if (!Directory.Exists(_demoMediaPath))
            {
                Directory.CreateDirectory(_demoMediaPath);
            }

            foreach (var file in files)
            {
                if (!TryResolveSafeSampleMediaTargetPath(file.Name, out var path))
                {
                    throw new InvalidOperationException($"Invalid or disallowed sample media filename '{file.Name}'. Allowed formats: .jpg, .jpeg, .png, .gif.");
                }

                await using var readStream = file.OpenReadStream(1024 * 1024 * 10);
                using var ms = new MemoryStream();
                await readStream.CopyToAsync(ms);
                var bytes = ms.ToArray();

                using var codecStream = new MemoryStream(bytes, writable: false);
                using var codec = SKCodec.Create(codecStream);
                if (codec == null ||
                    codec.Info.Width <= 0 ||
                    codec.Info.Height <= 0 ||
                    codec.EncodedFormat is not (SKEncodedImageFormat.Jpeg or SKEncodedImageFormat.Png or SKEncodedImageFormat.Gif))
                {
                    throw new InvalidOperationException($"File '{file.Name}' is not a valid raster image (.jpg, .png, .gif).");
                }

                await File.WriteAllBytesAsync(path, bytes);
            }
            Snackbar.Add("Media uploaded successfully.", Severity.Success);
            _sampleMedia = Directory.GetFiles(_demoMediaPath)
                .Where(f => AllowedDemoMediaExtensions.Contains(Path.GetExtension(f)))
                .ToList();
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Upload failed: {ex.Message}", Severity.Error);
        }
    }

    private async Task SaveSnapshot()
    {
        if (!await EnsureAuthorizedDemoSetupMutationAsync()) return;

        _isSaving = true;
        StateHasChanged();

        try
        {
            // 1. Save Config (never allow IsAdmin or non-selectable accounts in demo auto-login pool)
            var eligibleIds = Db.Employees.GetAll()
                .Where(e => e.IsSelectable && !e.IsAdmin)
                .Select(e => e.Id)
                .ToHashSet(StringComparer.Ordinal);
            var config = Db.DemoConfigs.GetOrCreate();
            config.AutoLoginEmployeeIds = _selectedIds
                .Where(kv => kv.Value && eligibleIds.Contains(kv.Key))
                .Select(kv => kv.Key)
                .ToList();
            Db.DemoConfigs.Save(config);

            // 2. Run Backup
            var result = await BackupService.RunBackupNowAsync();
            if (!result.Success || string.IsNullOrEmpty(result.ZipPath))
            {
                Snackbar.Add(result.ErrorMessage ?? "Backup failed", result.IsBusy ? Severity.Warning : Severity.Error);
                return;
            }

            var zipPath = result.ZipPath;

            // 3. Rename to Golden Snapshot
            var dataPath = Config["DataPath"] ?? "Data";
            var goldenPath = Path.Combine(dataPath, "Backups", "demo_golden_snapshot.zip");

            if (File.Exists(goldenPath))
            {
                File.Delete(goldenPath);
            }
            File.Move(zipPath, goldenPath);

            _lastSnapshotTime = File.GetCreationTimeUtc(goldenPath);
            Snackbar.Add("Golden snapshot saved successfully!", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Error saving snapshot: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task DeleteMedia(string filePath)
    {
        if (!await EnsureAuthorizedDemoSetupMutationAsync()) return;

        try
        {
            var rootFull = Path.TrimEndingDirectorySeparator(Path.GetFullPath(_demoMediaPath)) + Path.DirectorySeparatorChar;
            var candidateFull = Path.GetFullPath(filePath);
            if (!candidateFull.StartsWith(rootFull, StringComparison.OrdinalIgnoreCase) ||
                !AllowedDemoMediaExtensions.Contains(Path.GetExtension(candidateFull)))
            {
                Snackbar.Add("Invalid sample media path.", Severity.Error);
                return;
            }

            if (File.Exists(candidateFull)) File.Delete(candidateFull);
            _sampleMedia.RemoveAll(p => string.Equals(Path.GetFullPath(p), candidateFull, StringComparison.OrdinalIgnoreCase));
            Snackbar.Add("Media deleted", Severity.Success);
            StateHasChanged();
        }
        catch (Exception ex)
        {
            Snackbar.Add(ex.Message, Severity.Error);
        }
    }

    private async Task RestoreSnapshot()
    {
        if (!await EnsureAuthorizedDemoSetupMutationAsync()) return;

        var dataPath = Config["DataPath"] ?? "Data";
        var goldenPath = Path.Combine(dataPath, "Backups", "demo_golden_snapshot.zip");
        if (File.Exists(goldenPath))
        {
            var result = await BackupService.RestoreBackupAsync(goldenPath, null);
            if (result.Success)
            {
                Nav.NavigateTo("/", true);
            }
            else
            {
                Snackbar.Add($"Restore failed: {result.ErrorMessage}", Severity.Error);
            }
        }
        else
        {
            Snackbar.Add("Snapshot file not found", Severity.Warning);
        }
    }
}
