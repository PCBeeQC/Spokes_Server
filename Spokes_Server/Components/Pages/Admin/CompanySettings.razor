    private async Task SaveProfile()
    {
        var liveUser = await UserService.GetEmployeeAsync();
        _currentUser = liveUser;
        if (liveUser is not { IsActiveUnsuspended: true } ||
            (!liveUser.IsEffectiveAdmin && !liveUser.HasPermission(AppPermissions.Admin.ManageSettings)))
        {
            Snackbar.Add(Loc["You do not have permission to save settings."].Value, Severity.Error);
            return;
        }

        if (!liveUser.IsEffectiveAdmin)
        {
            var persisted = Db.CompanyProfile.Get();
            PreserveRestrictedProfileFields(Profile, persisted);

            if (!string.IsNullOrEmpty(Profile.DefaultPermissionGroupId) &&
                !string.Equals(Profile.DefaultPermissionGroupId, persisted.DefaultPermissionGroupId, StringComparison.OrdinalIgnoreCase))
            {
                var selectedGroup = Profile.PermissionGroups.FirstOrDefault(g => g.Id == Profile.DefaultPermissionGroupId);
                if (selectedGroup == null || !UserService.CanAssignPermissionGroup(liveUser, selectedGroup, persisted.DefaultPermissionGroupId))
                {
                    Profile.DefaultPermissionGroupId = persisted.DefaultPermissionGroupId;
                    Snackbar.Add(Loc["You cannot set a default permission group containing permissions you do not hold."].Value, Severity.Warning);
                }
            }
        }

        Profile.PrimaryColor = _primaryColor;
        Profile.SecondaryColor = _secondaryColor;
        BrandingService.SaveWithOptimizedBranding(Profile);
        CultureCircuitHandler.ApplyDateFormat(Profile.DateFormat);
        
        // Sync branding to Casdoor
        try
        {
            await CasdoorProvisioning.SyncBrandingAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[CompanySettings] Failed to sync branding to Casdoor during profile save");
        }

        Snackbar.Add(string.Format(Loc["{0} Profile Saved"].Value, AppLabels.Company), Severity.Success);
    }

