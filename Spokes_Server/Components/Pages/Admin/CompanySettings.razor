    private async Task OnProviderTypeChanged(IdpType newType)
    {
        if (!await RequireEffectiveAdminAsync()) return;
        if (_systemConfig.ProviderType == newType) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<IdpWarningDialog>("", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            _systemConfig.ProviderType = newType;
            StateHasChanged();
        }
        else
        {
            // Force Blazor to sync the old value back to the component
            var old = _systemConfig.ProviderType;
            _systemConfig.ProviderType = newType;
            await Task.Yield();
            _systemConfig.ProviderType = old;
            StateHasChanged();
        }
    }

    private async Task SaveSystemSetup()
    {
        var liveUser = await UserService.GetEmployeeAsync();
        _currentUser = liveUser;
        if (liveUser is not { IsActiveUnsuspended: true } ||
            (!liveUser.IsEffectiveAdmin && !liveUser.HasPermission(AppPermissions.Admin.ManageSettings)))
        {
            Snackbar.Add(Loc["You do not have permission to save system settings."].Value, Severity.Error);
            return;
        }

        if (!liveUser.IsEffectiveAdmin)
        {
            var persistedConfig = Db.SystemConfigs.Get();
            _systemConfig.ProviderType = persistedConfig.ProviderType;
            _systemConfig.Authority = persistedConfig.Authority;
            _systemConfig.ClientId = persistedConfig.ClientId;
            _systemConfig.ClientSecret = persistedConfig.ClientSecret;

            PreserveRestrictedProfileFields(Profile, Db.CompanyProfile.Get());
        }

        if (!string.IsNullOrWhiteSpace(_systemConfig.Authority))
        {
            var authUrl = _systemConfig.Authority.Trim();
            if (authUrl.EndsWith("/.well-known/openid-configuration", StringComparison.OrdinalIgnoreCase))
            {
                authUrl = authUrl.Substring(0, authUrl.Length - "/.well-known/openid-configuration".Length);
            }
            _systemConfig.Authority = authUrl;
        }

        bool idpChanged = _systemConfig.ProviderType != _initialSystemConfig.ProviderType ||
                          _systemConfig.Authority != _initialSystemConfig.Authority ||
                          _systemConfig.ClientId != _initialSystemConfig.ClientId ||
                          _systemConfig.ClientSecret != _initialSystemConfig.ClientSecret;

        bool livekitChanged = _systemConfig.LiveKitFallbackPort != _initialSystemConfig.LiveKitFallbackPort ||
                              _systemConfig.LiveKitUdpStartPort != _initialSystemConfig.LiveKitUdpStartPort ||
                              _systemConfig.LiveKitUdpEndPort != _initialSystemConfig.LiveKitUdpEndPort;

        if (livekitChanged && Environment.GetEnvironmentVariable("SPOKES_HOSTING_PROVIDER") != "digitalocean")
        {
            var portError = ValidateLiveKitSettingsPorts();
            if (!string.IsNullOrEmpty(portError))
            {
                Snackbar.Add(portError, Severity.Error);
                return;
            }
        }

        bool publicUrlChanged = _systemConfig.ServerPublicUrl != _initialSystemConfig.ServerPublicUrl;

        // 1. Save both configs
        Db.SystemConfigs.Save(_systemConfig);
        Db.CompanyProfile.Save(Profile);

        if (Profile.Time?.TimeSource == TimeConfig.SourceNtp)
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await SpokesClock.SyncWithNtpAsync(Profile.Time.NtpServer);
                }
                catch { }
            });
        }

        // 2. Update initial snapshot
        _initialSystemConfig = _systemConfig.DeepClone();

        // 3. If LiveKit ports changed, hot-reload LiveKit via supervisorctl
        if (livekitChanged)
        {
            LiveKitService.ApplyPortConfiguration(_systemConfig);
        }

        // 4. Sync Casdoor if public URL changed
        if (publicUrlChanged)
        {
            try
            {
                await CasdoorProvisioning.SyncBrandingAsync();
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "[CompanySettings] Failed to sync branding to Casdoor after public URL change");
            }
        }

        // 5. Check if IdP requires server restart
        if (idpChanged)
        {
            bool? result = await DialogService.ShowMessageBoxAsync(
                Loc["Identity Provider Update"].Value,
                Loc["Identity Provider settings were saved. The server must restart to apply these changes. Restart now?"].Value,
                yesText: Loc["Restart Server"].Value, cancelText: Loc["Later"].Value);

            if (result == true)
            {
                var targetUrl = !string.IsNullOrWhiteSpace(_systemConfig.ServerPublicUrl)
                    ? $"{_systemConfig.ServerPublicUrl.TrimEnd('/')}/admin/settings"
                    : "/admin/settings";

                try
                {
                    await JS.InvokeVoidAsync("spokesTriggerServerRestart", targetUrl);
                    await Task.Delay(2000);
                    AppLifetime.StopApplication();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error during server restart");
                    Environment.Exit(0);
                }
            }
            else
            {
                Snackbar.Add(Loc["Identity Provider settings saved. A server restart is required for changes to take effect."].Value, Severity.Warning);
            }
        }
        else
        {
            string message = livekitChanged
                ? Loc["Settings saved. Voice server reloaded."].Value
                : Loc["Settings saved successfully."].Value;
            Snackbar.Add(message, Severity.Success);
        }
    }

    private bool _isNtpSyncing;
    private async Task SyncNtpNowAsync()
    {
        _isNtpSyncing = true;
        try
        {
            var server = Profile.Time?.NtpServer?.Trim();
            if (string.IsNullOrWhiteSpace(server))
            {
                server = "time.cloudflare.com";
                if (Profile.Time != null) Profile.Time.NtpServer = server;
            }

            var result = await SpokesClock.SyncWithNtpAsync(server);
            if (result.Success)
            {
                Snackbar.Add(string.Format(Loc["NTP synchronized successfully! Offset: {0:F1}ms"].Value, result.Offset.TotalMilliseconds), Severity.Success);
            }
            else
            {
                Snackbar.Add(string.Format(Loc["NTP sync failed: {0}"].Value, result.ErrorMessage ?? Loc["Unknown error"].Value), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["NTP sync error: {0}"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _isNtpSyncing = false;
            StateHasChanged();
        }
    }

