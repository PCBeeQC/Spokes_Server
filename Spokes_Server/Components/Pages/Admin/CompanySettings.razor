    private async Task OnProviderTypeChanged(IdpType newType)
    {
        if (_systemConfig.ProviderType == newType) return;

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Small, FullWidth = true };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.IdpWarningDialog>("", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            _systemConfig.ProviderType = newType;
            StateHasChanged();
        }
        else
        {
            // Force Blazor to sync the old value back to the component
            var old = _systemConfig.ProviderType;
            _systemConfig.ProviderType = newType;
            await Task.Yield();
            _systemConfig.ProviderType = old;
            StateHasChanged();
        }
    }

    private async Task SaveSystemSetup()
    {
        if (!string.IsNullOrWhiteSpace(_systemConfig.Authority))
        {
            var authUrl = _systemConfig.Authority.Trim();
            if (authUrl.EndsWith("/.well-known/openid-configuration", StringComparison.OrdinalIgnoreCase))
            {
                authUrl = authUrl.Substring(0, authUrl.Length - "/.well-known/openid-configuration".Length);
            }
            _systemConfig.Authority = authUrl;
        }

        bool idpChanged = _systemConfig.ProviderType != _initialSystemConfig.ProviderType ||
                          _systemConfig.Authority != _initialSystemConfig.Authority ||
                          _systemConfig.ClientId != _initialSystemConfig.ClientId ||
                          _systemConfig.ClientSecret != _initialSystemConfig.ClientSecret;

        bool livekitChanged = _systemConfig.LiveKitFallbackPort != _initialSystemConfig.LiveKitFallbackPort ||
                              _systemConfig.LiveKitUdpStartPort != _initialSystemConfig.LiveKitUdpStartPort ||
                              _systemConfig.LiveKitUdpEndPort != _initialSystemConfig.LiveKitUdpEndPort;

        bool publicUrlChanged = _systemConfig.ServerPublicUrl != _initialSystemConfig.ServerPublicUrl;

        // 1. Save both configs
        Db.SystemConfigs.Save(_systemConfig);
        Db.CompanyProfile.Save(Profile);

        // 2. Update initial snapshot
        _initialSystemConfig = System.Text.Json.JsonSerializer.Deserialize<SystemConfig>(
            System.Text.Json.JsonSerializer.Serialize(_systemConfig)) ?? new();

        // 3. If LiveKit ports changed, hot-reload LiveKit via supervisorctl
        if (livekitChanged)
        {
            LiveKitService.ApplyPortConfiguration(_systemConfig);
        }

        // 4. Sync Casdoor if public URL changed
        if (publicUrlChanged)
        {
            _ = CasdoorProvisioning.SyncBrandingAsync();
        }

        // 5. Check if IdP requires server restart
        if (idpChanged)
        {
            bool? result = await DialogService.ShowMessageBoxAsync(
                "Identity Provider Update",
                "Identity Provider settings were saved. The server must restart to apply these changes. Restart now?",
                yesText: "Restart Server", cancelText: "Later");

            if (result == true)
            {
                var targetUrl = !string.IsNullOrWhiteSpace(_systemConfig.ServerPublicUrl)
                    ? $"{_systemConfig.ServerPublicUrl.TrimEnd('/')}/admin/settings"
                    : "/admin/settings";

                try
                {
                    await JS.InvokeVoidAsync("spokesTriggerServerRestart", targetUrl);
                    await Task.Delay(2000);
                    AppLifetime.StopApplication();
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error during server restart");
                    Environment.Exit(0);
                }
            }
            else
            {
                Snackbar.Add("Identity Provider settings saved. A server restart is required for changes to take effect.", Severity.Warning);
            }
        }
        else
        {
            string message = livekitChanged
                ? "Settings saved. Voice server reloaded."
                : "Settings saved successfully.";
            Snackbar.Add(message, Severity.Success);
        }
    }
