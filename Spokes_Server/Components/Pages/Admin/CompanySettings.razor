    private async Task LoadDefaultPermissionGroupsAsync(List<PermissionGroup> defaults, string dialogTitle, string dialogMessage)
    {
        var liveUser = await UserService.GetEmployeeAsync();
        _currentUser = liveUser;
        if (liveUser is not { IsActiveUnsuspended: true } ||
            (!liveUser.IsEffectiveAdmin && !liveUser.HasPermission(AppPermissions.Admin.ManageSettings)))
        {
            return;
        }

        var existingIds = Profile.PermissionGroups.Select(g => g.Id).ToHashSet();
        var existingNames = Profile.PermissionGroups.Select(g => g.Name.Trim().ToLowerInvariant()).ToHashSet();

        var toAdd = defaults
            .Where(d => !existingIds.Contains(d.Id) && !existingNames.Contains(d.Name.Trim().ToLowerInvariant()))
            .ToList();

        if (toAdd.Count == 0)
        {
            Snackbar.Add(Loc["All default permission groups are already present."].Value, Severity.Info);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            dialogTitle,
            dialogMessage,
            yesText: Loc["Load"].Value, cancelText: Loc["Cancel"].Value);
        if (confirmed == true)
        {
            liveUser = await UserService.GetEmployeeAsync();
            _currentUser = liveUser;
            if (liveUser is not { IsActiveUnsuspended: true } ||
                (!liveUser.IsEffectiveAdmin && !liveUser.HasPermission(AppPermissions.Admin.ManageSettings)))
            {
                return;
            }
            if (!liveUser.IsEffectiveAdmin)
            {
                foreach (var g in toAdd)
                {
                    g.Permissions = UserService.FilterAllowedPermissions(liveUser, g.Permissions);
                }
            }
            Profile.PermissionGroups.AddRange(toAdd);
            await SaveProfile();
            Snackbar.Add(string.Format(Loc["Added {0} default group(s)."].Value, toAdd.Count), Severity.Success);
        }
    }

    [Inject] private IFileService FileService { get; set; } = default!;
    [Inject] private ImageProcessingService ImageService { get; set; } = default!;

    private void HandleLogoUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;

        var result = results.First();
        if (!FileService.TryResolveScopedFileName(result.FilePath, "temp", _logoTempCtx, out var safeName))
        {
            return;
        }

        try
        {
            using var stream = FileService.OpenRead("temp", _logoTempCtx, safeName);
            if (stream == null) return;
            using var ms = new MemoryStream();
            stream.CopyTo(ms);
            var (optimizedBytes, mimeType) = ImageService.OptimizeImage(ms.ToArray(), maxDimension: 1024);
            var base64 = Convert.ToBase64String(optimizedBytes);
            Profile.LogoBase64 = $"data:{mimeType};base64,{base64}";
            Profile.LogoVersion++;
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Error processing logo: {0}"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            FileService.CleanTempContext(_logoTempCtx);
            StateHasChanged();
        }
    }

