    private async Task RegenerateVapidKeys()
    {
        var result = await DialogService.ShowMessageBoxAsync(
            Loc["Regenerate VAPID Keys?"].Value,
            Loc["This will invalidate all existing push subscriptions. Users will need to re-enable notifications in their browser."].Value,
            yesText: Loc["Regenerate"].Value, cancelText: Loc["Cancel"].Value);

        if (result == true)
        {
            // Delete all existing subscriptions
            var allSessionsWithPush = Db.DeviceSessions.GetAll().Where(s => s.HasPush).ToList();
            foreach (var session in allSessionsWithPush)
            {
                Db.DeviceSessions.ClearPushFields(session);
            }

            GenerateVapidKeys();
            Snackbar.Add(Loc["Keys regenerated. All existing subscriptions have been cleared."].Value, Severity.Warning);
        }
    }

