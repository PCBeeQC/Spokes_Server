@inject CasdoorProvisioningService CasdoorProvisioning

@code {
    private CompanyProfile Profile = default!;
    private SystemConfig _systemConfig = new();
    private SystemConfig _initialSystemConfig = new();
    private List<DocumentTemplate> Templates = new();
    private string _primaryColor = string.Empty;
    private string _secondaryColor = string.Empty;
    private string MaskedPrivateKey => string.IsNullOrEmpty(Profile?.VapidPrivateKey) ? "" : new string('�', 20);
    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";
    [Inject] private IWebPushService WebPush { get; set; } = default!;
    [Inject] private Spokes_Server.Core.Services.Licensing.LicenseValidationService LicenseService { get; set; } = default!;
    [Inject] private Spokes_Server.Core.Services.Logging.ISystemLogService SystemLog { get; set; } = default!;

    [SupplyParameterFromQuery] public string? Tab { get; set; }
    [SupplyParameterFromQuery] public bool Restored { get; set; }
    [SupplyParameterFromQuery] public bool CasdoorRestarted { get; set; }
    [SupplyParameterFromQuery(Name = "spokes_gdrive_token")] public string? GDriveTokenParam { get; set; }
    [SupplyParameterFromQuery(Name = "gdrive_error")] public string? GDriveErrorParam { get; set; }
    private bool _pendingUrlClean;
    private int activeTabIndex = 0;
    private int _previousActiveTabIndex = -1;

    private HashSet<DateTime> _availableLogDates = new();
    private DateTime _selectedLogDate = DateTime.Today;
    private List<Spokes_Server.Core.Services.Logging.SystemLogEntry> _currentLogs = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Tab))
        {
            var newIndex = Tab.ToLower() switch
            {
                "profile" => 0,
                "templates" => 1,
                "statuses" => 2,
                "categories" => 3,
                "backups" => 4,
                "permissions" => 5,
                "email" => 6,
                "chat" => 7,
                "setup" or "licensing" => 8,
                "logs" => 9,
                "timesheets" => 10,
                "albums" or "album" => 11,
                _ => 0
            };

            if (newIndex == 9 && _previousActiveTabIndex != 9)
            {
                _selectedLogDate = DateTime.Today;
                _availableLogDates = SystemLog.GetAvailableLogDates().Select(d => d.Date).ToHashSet();
                _ = LoadLogsForDate(_selectedLogDate);
            }
            activeTabIndex = newIndex;
            _previousActiveTabIndex = newIndex;
        }
    }

    private bool _isDisposed;

    public void Dispose()
    {
        _isDisposed = true;
        BackupSvc.OnLocalBackupStateChanged -= HandleLocalBackupStateChanged;
    }

    private void HandleLocalBackupStateChanged()
    {
        if (_isDisposed) return;
        _ = InvokeAsync(() =>
        {
            if (!BackupSvc.IsLocalBackupInProgress)
            {
                RefreshBackups();
            }
            StateHasChanged();
        });
    }

    private string GetLocalBackupStageLabel(LocalBackupStage stage) => stage switch
    {
        LocalBackupStage.Preparing => Loc["Preparing backup..."].Value,
        LocalBackupStage.Archiving => Loc["Archiving files..."].Value,
        LocalBackupStage.Encrypting => Loc["Encrypting backup archive..."].Value,
        LocalBackupStage.Finalizing => Loc["Finalizing backup..."].Value,
        LocalBackupStage.Completed => Loc["Backup complete"].Value,
        LocalBackupStage.Failed => Loc["Backup failed"].Value,
        _ => Loc["Creating Backup..."].Value
    };

    private void UpdateActiveTab(int index)
    {
        if (_isDisposed) return;
        
        activeTabIndex = index;
        
        if (index == 9)
        {
            _selectedLogDate = DateTime.Today;
            _availableLogDates = SystemLog.GetAvailableLogDates().Select(d => d.Date).ToHashSet();
            _ = LoadLogsForDate(_selectedLogDate);
        }

        // Prevent navigation if the component is being disposed due to navigating to another page
        if (!Nav.Uri.Contains("/admin/settings", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var tabName = index switch
        {
            0 => "profile",
            1 => "templates",
            2 => "statuses",
            3 => "categories",
            4 => "backups",
            5 => "permissions",
            6 => "email",
            7 => "chat",
            8 => "setup",
            9 => "logs",
            10 => "timesheets",
            11 => "albums",
            _ => "profile"
        };
        
        try
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", tabName), replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            // Ignore expected exception during component disposal
        }
    }

    protected override async Task OnInitializedAsync()
    {
        Profile = Db.CompanyProfile.Get();
        Profile.Time ??= new TimeConfig();
        if (string.IsNullOrWhiteSpace(Profile.Time.NtpServer))
        {
            Profile.Time.NtpServer = "time.cloudflare.com";
        }
        if (string.IsNullOrWhiteSpace(Profile.Time.TimeSource))
        {
            Profile.Time.TimeSource = TimeConfig.SourceHost;
        }
        _systemConfig = Db.SystemConfigs.Get();
        _initialSystemConfig = System.Text.Json.JsonSerializer.Deserialize<SystemConfig>(
            System.Text.Json.JsonSerializer.Serialize(_systemConfig)) ?? new();
        _primaryColor = Profile.PrimaryColor;
        _secondaryColor = Profile.SecondaryColor;
        RefreshTemplates();
        RefreshBackups();
        BackupSvc.OnLocalBackupStateChanged += HandleLocalBackupStateChanged;

        _availableLogDates = SystemLog.GetAvailableLogDates().Select(d => d.Date).ToHashSet();
        _selectedLogDate = DateTime.Today;
        await LoadLogsForDate(_selectedLogDate);

        _activeAdmins = Db.Employees.GetAll().Where(e => e.IsAdmin && e.IsActive).ToList();

        if (!string.IsNullOrEmpty(GDriveTokenParam))
        {
            Profile.Backup.GoogleDrive.RefreshToken = GDriveTokenParam;
            Profile.Backup.GoogleDrive.IsEnabled = true;
            Db.CompanyProfile.Save(Profile);
            Snackbar.Add(Loc["Google Drive connected successfully!"].Value, Severity.Success);
            _pendingUrlClean = true;
            activeTabIndex = 4;
            _previousActiveTabIndex = 4;
        }
        else if (!string.IsNullOrEmpty(GDriveErrorParam))
        {
            Snackbar.Add(string.Format(Loc["Google Drive connection failed: {0}"].Value, GDriveErrorParam), Severity.Error);
            _pendingUrlClean = true;
            activeTabIndex = 4;
            _previousActiveTabIndex = 4;
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _pendingUrlClean)
        {
            _pendingUrlClean = false;
            try
            {
                var cleanUri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
                {
                    { "spokes_gdrive_token", null },
                    { "gdrive_error", null },
                    { "tab", "backups" }
                });
                await JS.InvokeVoidAsync("history.replaceState", null, "", cleanUri);
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "Failed to clean URL via history.replaceState");
            }
        }

        if (firstRender && Restored)
        {
            await DialogService.ShowAsync<RestoreCompleteDialog>("", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
            
            if (CasdoorRestarted)
            {
                Snackbar.Add(Loc["Builtin Casdoor instance restarted."].Value, Severity.Info);
            }

            var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                { "restored", null },
                { "casdoorRestarted", null }
            });
            Nav.NavigateTo(uri, forceLoad: false, replace: true);
        }
    }

    private async Task TriggerManualUpdate()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync(
            Loc["Update Server?"].Value,
            string.Format(Loc["Are you sure you want to update Spokes to v{0}?\n\nThe server will be temporarily unavailable for a few minutes while the update is applied."].Value, ServerUpdateService.LatestVersion),
            yesText: Loc["Update Now"].Value, cancelText: Loc["Cancel"].Value);

        if (confirmed == true)
        {
            Snackbar.Add(Loc["Update triggered. The server will restart shortly."].Value, Severity.Success);
            _ = ServerUpdateService.TriggerWatchtowerUpdateAsync();
        }
    }

    private void RefreshTemplates() => Templates = Db.DocumentTemplates.GetAll().OrderBy(t => t.Name).ToList();

    // --- Logs Logic ---
    private async Task OnLogDateChanged(DateTime newDate)
    {
        _selectedLogDate = newDate.Date;
        await LoadLogsForDate(_selectedLogDate);
    }

    private async Task OnLogDateChangedNullable(DateTime? date)
    {
        if (date.HasValue)
        {
            await OnLogDateChanged(date.Value);
        }
    }

    private string GetLogDateClasses(DateTime date)
    {
        if (_availableLogDates.Contains(date.Date))
            return "log-date-has-logs border border-2 border-solid mud-border-primary";
        return string.Empty;
    }

    private async Task LoadLogsForDate(DateTime date)
    {
        _currentLogs = await SystemLog.GetLogsAsync(date);
        StateHasChanged();
    }

    private async Task CopyLogsToClipboard()
    {
        if (_currentLogs.Count == 0) return;
        var sb = new System.Text.StringBuilder();
        foreach (var log in _currentLogs)
        {
            sb.AppendLine($"[{log.TimestampUtc:yyyy-MM-dd HH:mm:ss}] [{log.Severity.ToUpper()}] [{log.Category}] {log.Message}");
            if (!string.IsNullOrEmpty(log.Details))
            {
                sb.AppendLine(log.Details);
            }
        }
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        Snackbar.Add(Loc["Logs copied to clipboard."].Value, Severity.Success);
    }

    private Task OnDetailedCircuitErrorsChanged(bool enabled)
    {
        _systemConfig.EnableDetailedCircuitErrors = enabled;
        Db.SystemConfigs.Save(_systemConfig);
        _initialSystemConfig.EnableDetailedCircuitErrors = enabled;
        Snackbar.Add(Loc["Diagnostic settings updated."].Value, Severity.Success);
        return Task.CompletedTask;
    }

    // --- Backup Logic ---
    [Inject] private BackupService BackupSvc { get; set; } = default!;
    private List<BackupFileInfo> _backupFiles = new();
    private bool _isBackingUp;

    private void RefreshBackups() => _backupFiles = BackupSvc.GetBackups();

    private async Task RunBackupNow()
    {
        if (BackupSvc.IsRunning)
        {
            Snackbar.Add(Loc["A backup is already in progress"].Value, Severity.Warning);
            return;
        }

        _isBackingUp = true;
        StateHasChanged();
        try
        {
            var result = await BackupSvc.RunBackupNowAsync();
            if (result.Success)
            {
                RefreshBackups();
                Snackbar.Add(Loc["Backup created successfully"].Value, Severity.Success);
            }
            else if (result.IsBusy)
            {
                Snackbar.Add(result.ErrorMessage ?? Loc["A backup is already in progress"].Value, Severity.Warning);
            }
            else
            {
                Snackbar.Add(string.Format(Loc["Backup failed: {0}"].Value, result.ErrorMessage), Severity.Error);
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add(string.Format(Loc["Backup failed: {0}"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _isBackingUp = false;
            RefreshBackups();
            StateHasChanged();
        }
    }

    private async Task DownloadBackup(BackupFileInfo backup)
    {
        var url = $"/spokesapi/backups/{Uri.EscapeDataString(backup.FileName)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

