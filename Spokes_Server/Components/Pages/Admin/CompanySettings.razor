    private bool _isTestingVoiceBot;
    private VoiceBotSelfTestResult? _voiceBotTestResult;

    private bool HasUnsavedLiveKitPortChanges =>
        _systemConfig.LiveKitFallbackPort != _initialSystemConfig.LiveKitFallbackPort ||
        _systemConfig.LiveKitUdpStartPort != _initialSystemConfig.LiveKitUdpStartPort ||
        _systemConfig.LiveKitUdpEndPort != _initialSystemConfig.LiveKitUdpEndPort;

    private string? ValidateLiveKitSettingsPorts()
    {
        if (_systemConfig.LiveKitFallbackPort < LiveKitService.MinValidPort ||
            _systemConfig.LiveKitFallbackPort > LiveKitService.MaxValidPort)
        {
            return Loc["TCP Fallback Port must be between 1024 and 65535."].Value;
        }

        return LiveKitService.ValidateUdpMuxRange(_systemConfig.LiveKitUdpStartPort, _systemConfig.LiveKitUdpEndPort) switch
        {
            UdpPortRangeValidationError.InvalidStartPort => Loc["UDP Start Port must be between 1024 and 65535."].Value,
            UdpPortRangeValidationError.InvalidEndPort => Loc["UDP End Port must be between 1024 and 65535."].Value,
            UdpPortRangeValidationError.EndBeforeStart => Loc["UDP End Port must be greater than or equal to UDP Start Port."].Value,
            UdpPortRangeValidationError.ExceedsMaxMuxPorts => string.Format(Loc["UDP Mux supports between 1 and {0} ports."].Value, LiveKitService.MaxUdpMuxPortCount),
            _ => null
        };
    }

