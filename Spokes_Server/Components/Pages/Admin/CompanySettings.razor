@page "/admin/settings"
@page "/settings"
@attribute [Authorize(Policy = AppPermissions.Admin.ManageSettings)]
@implements IDisposable
<PageTitle>@(string.Format(Loc["{0} Settings"].Value, AppLabels.Company))</PageTitle>
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Configuration
@using Spokes_Server.Core.Services.Licensing
@using Spokes_Server.Core.Services.Content
@using Spokes_Server.Components.Pages.Admin.Features
@using Microsoft.Extensions.Hosting
@using Microsoft.Extensions.Configuration
@using Spokes_Server.Core.Services.UI

@inject Database Db
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject IHostApplicationLifetime AppLifetime
@inject ILogger<CompanySettings> Logger
@inject IConfiguration Config
@inject LicenseValidationService LicenseValidationService
@inject AppLabelService AppLabels
@inject ServerUpdateService ServerUpdateService
@inject LiveKitService LiveKitService
@inject ICompanyBrandingService BrandingService
@inject ISpokesClock SpokesClock
@using Spokes_Server.Core.Services.Maintenance
@using Spokes_Server.Core.Services.Maintenance.Destinations
@using Spokes_Server.Core.Services.Maintenance.Time



    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-2 pb-16">
    <MudText Typo="Typo.h4" GutterBottom="true">@(string.Format(Loc["{0} Settings"].Value, AppLabels.Company))</MudText>
    <div class="mb-6">
        <MudMenu Label="@GetActiveTabName()" StartIcon="@GetActiveTabIcon()" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" MaxHeight="800">
            <MudMenuItem OnClick="@(() => UpdateActiveTab(0))" Icon="@Icons.Material.Filled.Business">@(string.Format(Loc["{0} Profile"].Value, AppLabels.Company))</MudMenuItem>
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(1))" Icon="@Icons.Material.Filled.Description">@BizLoc["Document Templates"]</MudMenuItem>
            }
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(2))" Icon="@Icons.Material.Filled.Palette">@BizLoc["Project Statuses"]</MudMenuItem>
            }
            <MudMenuItem OnClick="@(() => UpdateActiveTab(3))" Icon="@Icons.Material.Filled.Category">@Loc["Default Calendar Categories"]</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(4))" Icon="@Icons.Material.Filled.Backup">@Loc["Backups & Restore"]</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(5))" Icon="@Icons.Material.Filled.Security">@Loc["Permission Groups"]</MudMenuItem>
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(6))" Icon="@Icons.Material.Filled.Email">@BizLoc["Email Server"]</MudMenuItem>
            }
            <MudMenuItem OnClick="@(() => UpdateActiveTab(7))" Icon="@Icons.Material.Filled.Chat">@Loc["Chat Settings"]</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(11))" Icon="@Icons.Material.Filled.PhotoLibrary">@Loc["Album Settings"]</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(8))" Icon="@Icons.Material.Filled.SettingsApplications">@Loc["System Setup"]</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(9))" Icon="@Icons.Material.Filled.Terminal">@Loc["Server Logs"]</MudMenuItem>
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(10))" Icon="@Icons.Material.Filled.Schedule">@BizLoc["Timesheets"]</MudMenuItem>
            }
        </MudMenu>
    </div>

    @if (activeTabIndex == 0)
    {
        <MudStack Spacing="4">
            @if (ServerUpdateService.IsUpdateAvailable)
            {
                var valResult = LicenseValidationService.ValidateLicense(Profile.LicensePayload, Db.ServerConfigs.GetOrCreateGlobalConfig());
                string maxVer = valResult.MaxAllowedVersion ?? "";
                bool latestExceedsAllowed = false;

                if (Version.TryParse(ServerUpdateService.LatestVersion?.TrimStart('v'), out Version? lv) && 
                    Version.TryParse(maxVer.TrimStart('v'), out Version? mv))
                {
                    latestExceedsAllowed = lv > mv;
                }

                if (latestExceedsAllowed)
                {
                    bool isDemo = string.IsNullOrEmpty(Profile.LicensePayload);
                    <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Icon="@Icons.Material.Filled.Warning">
                        @if (isDemo)
                        {
                            <MudText Typo="Typo.body2">Updating to the latest version will lock up your server. Your demo server does not allow updates pass <b>@maxVer</b>. You can either stay on <b>@maxVer</b> for as long as you like or you can purchase a license at <MudLink Href="https://www.spokes.sh" Target="_blank" Style="color: white; text-decoration: underline;"><b>www.spokes.sh</b></MudLink>.</MudText>
                        }
                        else
                        {
                            <MudText Typo="Typo.body2">Updating to the latest version will lock up your server. Your current license does not allow updates pass <b>@maxVer</b>. You can either stay on <b>@maxVer</b> for as long as you like or you can purchase a new license at <MudLink Href="https://www.spokes.sh" Target="_blank" Style="color: white; text-decoration: underline;"><b>www.spokes.sh</b></MudLink>.</MudText>
                        }
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Info" Variant="Variant.Filled">
                        <div class="d-flex flex-column flex-sm-row align-start align-sm-center justify-space-between gap-2 w-100" style="width: 100%;">
                            <MudText Typo="Typo.body2">@Loc["A new server update is available:"] <b>v@(ServerUpdateService.LatestVersion)</b>. @Loc["Your current version is"] <b>@(ServerUpdateService.CurrentVersion)</b>.</MudText>
                            @if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("WATCHTOWER_HTTP_API_TOKEN")))
                            {
                                <MudButton Variant="Variant.Filled" Color="Color.Surface" Size="Size.Small" OnClick="TriggerManualUpdate" Class="flex-shrink-0">@Loc["Update Now"]</MudButton>
                            }
                        </div>
                    </MudAlert>
                }
            }

            @* --- Card 1: Branding & Identity --- *@
            <SettingsCard Title="@(string.Format(Loc["{0} Identity & Branding"].Value, AppLabels.Company))"
                          Icon="@Icons.Material.Filled.Badge"
                          Description="@Loc["Customize company name, logo, app icon, and brand colors."]">
                <MudGrid>
                    <MudItem xs="12" sm="6" Class="d-flex flex-column align-center justify-center pa-4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@Loc["Header & Desktop Logo"]</MudText>
                        @if (!string.IsNullOrEmpty(Profile.LogoBase64))
                        {
                            <MudImage Src="@Profile.LogoBase64" Alt="Logo" Height="90" Class="mb-3" ObjectFit="ObjectFit.Contain" />
                        }
                        else
                        {
                            <MudPaper Class="d-flex align-center justify-center mb-3" Width="140px" Height="90px" Outlined="true">
                                <MudText Typo="Typo.caption">@Loc["No Logo"]</MudText>
                            </MudPaper>
                        }
                        <div class="d-inline-flex align-center gap-2">
                            <ApiFileUpload Category="temp" ContextId="@Guid.NewGuid().ToString()" OnUploadCompleted="HandleLogoUploaded">
                                <CustomContent>
                                    <MudButton Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload">
                                        @Loc["Upload Logo"]
                                    </MudButton>
                                </CustomContent>
                            </ApiFileUpload>
                            @if (!string.IsNullOrEmpty(Profile.LogoBase64))
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ClearLogo">
                                    @Loc["Remove"]
                                </MudButton>
                            }
                        </div>
                    </MudItem>

                    <MudItem xs="12" sm="6" Class="d-flex flex-column align-center justify-center pa-4">
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mb-2">@Loc["Mobile App & Favicon"]</MudText>
                        @if (!string.IsNullOrEmpty(Profile.IconBase64))
                        {
                            <MudImage Src="@Profile.IconBase64" Alt="Icon" Height="60" Class="mb-3" ObjectFit="ObjectFit.Contain" />
                        }
                        else
                        {
                            <MudPaper Class="d-flex align-center justify-center mb-3" Width="60px" Height="60px" Outlined="true">
                                <MudText Typo="Typo.caption">@Loc["No Icon"]</MudText>
                            </MudPaper>
                        }
                        <div class="d-inline-flex align-center gap-2">
                            <ApiFileUpload Category="temp" ContextId="@Guid.NewGuid().ToString()" OnUploadCompleted="HandleIconUploaded">
                                <CustomContent>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.CloudUpload">
                                        @Loc["Upload Icon"]
                                    </MudButton>
                                </CustomContent>
                            </ApiFileUpload>
                            @if (!string.IsNullOrEmpty(Profile.IconBase64))
                            {
                                <MudButton Variant="Variant.Text" Color="Color.Error" Size="Size.Small" OnClick="ClearIcon">
                                    @Loc["Remove"]
                                </MudButton>
                            }
                        </div>
                    </MudItem>

                    <MudItem xs="12">
                        <MudDivider Class="my-1" />
                    </MudItem>

                    <MudItem xs="12" sm="6">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.CompanyName" Label="@(string.Format(Loc["{0} Name"].Value, AppLabels.Company))" Required="true" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.PrivacyPolicyUrl" Label="@Loc["Privacy Policy URL"]" HelperText="@Loc["This URL will be shown to users in their Settings to comply with App Store guidelines."]" />
                    </MudItem>
                    @if (!IsFriendEdition)
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.Website" Label="Website" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.PhoneNumber" Label="Phone" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudColorPicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Label="Primary Brand Color" @bind-Text="_primaryColor" Style="width: 100%;" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudColorPicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Label="Secondary Brand Color" @bind-Text="_secondaryColor" Style="width: 100%;" />
                        </MudItem>
                    }
                </MudGrid>
            </SettingsCard>

            @* --- Card 2: File Storage & Uploads --- *@
            <SettingsCard Title="@Loc["File Storage & Uploads"]"
                          Icon="@Icons.Material.Filled.CloudUpload"
                          Description="@Loc["Set maximum file upload limits for attachments, documents, and media."]">
                <MudGrid>
                    <MudItem xs="12" sm="8" md="6">
                        <MudNumericField T="long" ShrinkLabel="true" Value="@(Profile.MaxFileUploadSizeBytes / 1024L / 1024L)" ValueChanged="@((long v) => Profile.MaxFileUploadSizeBytes = v * 1024L * 1024L)" Label="@Loc["Max Upload Size (MB)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="1048576" HelperText="@Loc["Maximum allowed size per file (requires server restart to fully apply to Kestrel)"]" />
                    </MudItem>
                </MudGrid>
            </SettingsCard>

            @* --- Card 3: User Privacy & Discovery --- *@
            <PrivacyDiscoverySettings Profile="@Profile" ActiveAdmins="@_activeAdmins" OnSaved="SaveProfile" IsFriendEdition="@IsFriendEdition" />

            @if (!IsFriendEdition)
            {
                @* --- Card 4: Document Numbering --- *@
                <SettingsCard Title="@BizLoc["Document Numbering"]"
                              Icon="@Icons.Material.Filled.Pin"
                              Description="@BizLoc["Set standard prefix codes for generated quotes and invoices."]">
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.QuotePrefix" Label="Quote Prefix" HelperText="e.g. Q-001" />
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.InvoicePrefix" Label="Invoice Prefix" HelperText="e.g. INV-001" />
                        </MudItem>
                    </MudGrid>
                </SettingsCard>

                @* --- Card 5: Financial Defaults --- *@
                <SettingsCard Title="@BizLoc["Financial Defaults"]"
                              Icon="@Icons.Material.Filled.Payments"
                              Description="@BizLoc["Configure default rates, tax percentages, and supported billing currencies."]">
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.KilometrageRate" Label="Kilometrage Rate ($/km)" Format="N2"
                                             Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.DefaultInternalCommission" Label="Default Internal Commission (%)"
                                             Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.DefaultExternalCommission" Label="Default External Commission (%)"
                                             Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Value="@(Profile.DefaultTaxRate * 100)"
                                             ValueChanged="@((decimal v) => Profile.DefaultTaxRate = v / 100)" Label="Default Tax Rate (%)"
                                             Format="N3" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.CurrencySymbol" Label="Currency Symbol" HelperText="e.g. $, £, €" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudSelect ShrinkLabel="true" @bind-Value="Profile.DateFormat" Margin="Margin.Dense"
                                       Label="@BizLoc["Date Format"]" Variant="Variant.Outlined"
                                       HelperText="@BizLoc["System-wide date display format"]">
                                @foreach (var (fmt, label) in DateDisplayFormats.AvailableFormats)
                                {
                                    <MudSelectItem Value="@fmt">@label</MudSelectItem>
                                }
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" 
                                          Value='@(string.Join(", ", Profile.SupportedCurrencies))'
                                          ValueChanged="@((string v) => Profile.SupportedCurrencies = v.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries).Select(w => w.Trim()).ToList())"
                                          Label="Supported Currencies" HelperText="Enter currency codes separated by commas (e.g. CAD, USD, EUR)" />
                        </MudItem>
                    </MudGrid>
                </SettingsCard>

                @* --- Card 6: Business Address --- *@
                <SettingsCard Title="@BizLoc["Business Address"]"
                              Icon="@Icons.Material.Filled.LocationOn"
                              Description="@BizLoc["Official postal address printed on invoices and billing documents."]">
                    <MudGrid>
                        <MudItem xs="12" sm="8">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressStreet" Label="Street Address" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressZip" Label="Zip/Postal" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressCity" Label="City" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressState" Label="State/Province" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressCountry" Label="Country" />
                        </MudItem>
                    </MudGrid>
                </SettingsCard>
            }

        </MudStack>
    }
    else if (activeTabIndex == 1)
    {
        <MudStack Spacing="4">
            <SettingsCard Title="@BizLoc["Document Templates"]"
                          Icon="@Icons.Material.Filled.Description"
                          Description="@BizLoc["Create templates for different languages (e.g. French Invoice, English PO)."]">
                <HeaderActions>
                    <div class="d-flex align-center gap-2">
                        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary" Size="Size.Small"
                                   OnClick="CreateTemplate">@BizLoc["New Template"]</MudButton>
                        <ApiFileUpload 
                            Category="temp" 
                            ContextId="@Guid.NewGuid().ToString()" 
                            OnUploadCompleted="HandleTemplateUploaded">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined" Color="Color.Secondary" Size="Size.Small" StartIcon="@Icons.Material.Filled.UploadFile">
                                    @Loc["Import"]
                                </MudButton>
                            </CustomContent>
                        </ApiFileUpload>
                    </div>
                </HeaderActions>
                <ChildContent>
                    <div class="overflow-x-auto">
                        <MudTable Items="@Templates" Breakpoint="Breakpoint.None" Hover="true" Elevation="0" Outlined="true" Bordered="true" Striped="true" Class="mt-2">
                            <HeaderContent>
                                <MudTh Style="min-width: 250px;">Name</MudTh>
                                <MudTh Style="min-width: 150px;">Language</MudTh>
                                <MudTh Style="width: 100px;">Default</MudTh>
                                <MudTh Style="width: 160px;">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.Name</MudTd>
                                <MudTd>@context.LanguageCode.ToUpper()</MudTd>
                                <MudTd>
                                    @if (context.IsDefault)
                                    {
                                        <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                                    }
                                </MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditTemplate(context))" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Info" title="Export JSON"
                                                   OnClick="@(() => ExportTemplate(context))" />
                                    @if (!context.IsDefault)
                                    {
                                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                                       OnClick="@(() => DeleteTemplate(context))" />
                                    }
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                </ChildContent>
            </SettingsCard>
        </MudStack>
    }
    else if (activeTabIndex == 2)
    {
        <MudStack Spacing="4">
            <SettingsCard Title="@BizLoc["Project Statuses"]"
                          Icon="@Icons.Material.Filled.Palette"
                          Description="@BizLoc["Configure the statuses available for projects and their display colors."]">
                <div class="overflow-x-auto">
                    <MudTable Items="@Profile.ProjectStatuses" Breakpoint="Breakpoint.None" Hover="true" Dense="true" Outlined="true" Bordered="true" Striped="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="min-width: 220px;">Status Name</MudTh>
                            <MudTh Style="min-width: 150px;">Color</MudTh>
                            <MudTh Style="min-width: 150px;">System Mapping</MudTh>
                            <MudTh Style="width: 120px;">Preview</MudTh>
                            <MudTh Style="width: 80px;">Actions</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.Name" Label="Name" Margin="Margin.Dense"
                                              Required="true" />
                            </MudTd>
                            <MudTd>
                                <MudSelect ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.Color" Label="Color" Dense="true" Margin="Margin.Dense"
                                           Style="width: 150px;">
                                    @foreach (var colorName in Enum.GetNames(typeof(Color)))
                                    {
                                        <MudSelectItem Value="@colorName">@colorName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                <MudSelect ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.SystemMapping" Label="System Type" Dense="true" Margin="Margin.Dense"
                                           Style="width: 150px;">
                                    @foreach (var type in SystemStatusMappings.All)
                                    {
                                        <MudSelectItem Value="@type">@type</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                @{
                                    Color chipColor = Color.Default;
                                    Enum.TryParse(context.Color, out chipColor);
                                }
                                <MudChip T="string" Color="@chipColor" Size="Size.Small">@context.Name</MudChip>
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => RemoveStatus(context))" />
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="5">
                                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddStatus" Color="Color.Primary">
                                    Add Status</MudButton>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                </div>

            </SettingsCard>
        </MudStack>
    }
    else if (activeTabIndex == 3)
    {
        <MudStack Spacing="4">
            <SettingsCard Title="@Loc["Default Calendar Categories"]"
                          Icon="@Icons.Material.Filled.Category"
                          Description="@Loc["Configure the default calendar categories assigned to new users upon account creation. Each user has full control to customize their own personal categories independently."]">
                <div class="overflow-x-auto">
                    <MudTable Items="@Profile.CalendarCategories" Breakpoint="Breakpoint.None" Dense="true" Elevation="0" Outlined="true" Bordered="true">
                        <HeaderContent>
                            <MudTh Style="min-width: 220px;">@Loc["Category Name"]</MudTh>
                            <MudTh Style="min-width: 150px;">@Loc["Color"]</MudTh>
                            <MudTh Style="width: 120px;">@Loc["Preview"]</MudTh>
                            <MudTh Style="width: 80px;">@Loc["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>
                                <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="context.Name" Label="@Loc["Name"]"
                                              Required="true" />
                            </MudTd>
                            <MudTd>
                                <MudSelect ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.Color" Label="@Loc["Color"]" Dense="true" Margin="Margin.Dense"
                                           Style="width: 150px;">
                                    @foreach (var colorName in Enum.GetNames(typeof(Color)))
                                    {
                                        <MudSelectItem Value="@colorName">@colorName</MudSelectItem>
                                    }
                                </MudSelect>
                            </MudTd>
                            <MudTd>
                                @{
                                    Color chipColor = Color.Default;
                                    Enum.TryParse(context.Color, out chipColor);
                                }
                                <MudChip T="string" Color="@chipColor" Size="Size.Small">@context.Name</MudChip>
                            </MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                               OnClick="@(() => RemoveCategory(context))" />
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="4">
                                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddCategory"
                                           Color="Color.Primary">@Loc["Add Category"]</MudButton>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                </div>

            </SettingsCard>
        </MudStack>
    }
    else if (activeTabIndex == 4)
    {
        <MudStack Spacing="4">
            @* --- Card 1: Automated Backups --- *@
            <SettingsCard Title="@Loc["Automated Backups"]"
                          Icon="@Icons.Material.Filled.Schedule"
                          Description="@Loc["Configure automatic backups of your Spokes data. Backups are stored as ZIP or encrypted SPKBACKUP archives."]">
                <SettingsSwitchRow Title="@Loc["Enable Automatic Backups"]"
                                   Description="@Loc["Automatically generate daily backup archives of all system data."]"
                                   Value="Profile.BackupsEnabled"
                                   ValueChanged="@((bool v) => Profile.BackupsEnabled = v)" />

                <MudDivider Class="my-2" />
                <SettingsSwitchRow Title="@Loc["Encrypt Backups with Master Password"]"
                                   Description="@Loc["The encrypted backup key is the server's master password (SPOKES_MASTER_PASSWORD). When restoring, the target server must have the same master password."]"
                                   Value="Profile.EncryptBackupsWithMasterPassword"
                                   ValueChanged="@((bool v) => Profile.EncryptBackupsWithMasterPassword = v)" />

                @if (!IsFriendEdition)
                {
                    <MudDivider Class="my-2" />
                    <SettingsSwitchRow Title="Include Employee Emails in Backup"
                                       Description="Store mailbox contents and messages inside backup archives."
                                       Value="Profile.BackupEmployeeEmails"
                                       ValueChanged="@((bool v) => Profile.BackupEmployeeEmails = v)" />
                }

                <MudGrid Class="mt-2">
                    <MudItem xs="12" sm="6">
                        <MudNumericField ShrinkLabel="true" @bind-Value="Profile.BackupRetentionCount" Margin="Margin.Dense" Label="@Loc["Backups to Keep"]" Min="1" Max="100"
                                         Variant="Variant.Outlined" HelperText="@Loc["Older backups are automatically deleted"]" />
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.BackupTimeLocal" Label="@Loc["Scheduled Time (Local)"]"
                                      HelperText="@Loc["24-hour format, e.g. 03:00"]" />
                    </MudItem>
                </MudGrid>

                <div class="d-flex flex-column flex-sm-row align-start align-sm-center justify-space-between gap-3 mt-4 pt-3">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary"
                               StartIcon="@(BackupSvc.IsRunning && !BackupSvc.IsLocalBackupInProgress ? Icons.Material.Filled.CloudUpload : Icons.Material.Filled.Backup)"
                               OnClick="RunBackupNow" Disabled="@(BackupSvc.IsRunning || _isBackingUp)">
                        @if (BackupSvc.IsLocalBackupInProgress)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="false" Value="@BackupSvc.CurrentProgress.Percent" Class="mr-2" />
                            <span>@Loc["Creating Backup..."]</span>
                        }
                        else if (BackupSvc.IsRunning)
                        {
                            <span>@Loc["Uploading to Remote..."]</span>
                        }
                        else
                        {
                            <span>@Loc["Backup Now"]</span>
                        }
                    </MudButton>

                    @if (BackupSvc.LastBackupAt.HasValue)
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary">
                            @Loc["Last backup:"] @BackupSvc.LastBackupAt.Value.ToLocalTime().ToString("g") • @BackupSvc.LastBackupStatus
                        </MudText>
                    }
                </div>

                @if (BackupSvc.IsLocalBackupInProgress)
                {
                    <div class="mt-3">
                        <div class="d-flex justify-space-between align-center mb-1">
                            <MudText Typo="Typo.caption" Color="Color.Primary" Style="font-weight: 600;">
                                @GetLocalBackupStageLabel(BackupSvc.CurrentProgress.Stage)
                            </MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                @BackupSvc.CurrentProgress.FormattedProgress
                            </MudText>
                        </div>
                        <MudProgressLinear Color="Color.Primary" Value="@BackupSvc.CurrentProgress.Percent" Rounded="true" Size="Size.Medium" />
                    </div>
                }
            </SettingsCard>

            @* --- Card 2: Remote Backup Destinations --- *@
            <RemoteBackupDestinations Profile="@Profile" />

            @* --- Card 3: Restore Backup --- *@
            <SettingsCard Title="@Loc["Restore Backup"]"
                          Icon="@Icons.Material.Filled.RestorePage"
                          Description="@Loc["Upload a backup file (.zip or .spkbackup) to restore the system state."]">
                <MudAlert Severity="Severity.Warning" Variant="Variant.Outlined" Class="mb-3" Icon="@Icons.Material.Filled.Warning">
                    <b>@Loc["WARNING:"]</b> @Loc["Restoring a backup will overwrite all current data. Encrypted .spkbackup archives will be decrypted using the server's configured master password."]
                </MudAlert>

                <MudFileUpload T="IBrowserFile" Accept=".zip,.spkbackup" FilesChanged="UploadAndRestoreBackup">
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@context.OpenFilePickerAsync" 
                                    StartIcon="@Icons.Material.Filled.RestorePage">
                            @Loc["Upload & Restore"]
                        </MudButton>
                    </CustomContent>
                    <SelectedTemplate></SelectedTemplate>
                </MudFileUpload>
            </SettingsCard>

            @* --- Card 4: Existing Backups --- *@
            <SettingsCard Title="@Loc["Existing Backups"]"
                          Icon="@Icons.Material.Filled.Archive"
                          Description="@Loc["View, download, restore, or delete backup archives stored on disk."]">
                @if (_backupFiles.Any())
                {
                    <div class="overflow-x-auto">
                        <MudTable Items="@_backupFiles" Breakpoint="Breakpoint.None" Dense="true" Hover="true" Elevation="0" Bordered="true" Outlined="true">
                            <HeaderContent>
                                <MudTh Style="min-width: 200px;">@Loc["File"]</MudTh>
                                <MudTh Style="width: 100px;">@Loc["Size"]</MudTh>
                                <MudTh Style="width: 100px;">@Loc["Type"]</MudTh>
                                <MudTh Style="width: 120px;">@Loc["Security"]</MudTh>
                                <MudTh Style="min-width: 150px;">@Loc["Created"]</MudTh>
                                <MudTh Style="width:160px">@Loc["Actions"]</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.FileName</MudTd>
                                <MudTd>@context.FormattedSize</MudTd>
                                <MudTd DataLabel="Type">
                                    @if (context.IsManual)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">@Loc["Manual"]</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">@Loc["Auto"]</MudChip>
                                    }
                                </MudTd>
                                <MudTd DataLabel="Security">
                                    @if (context.IsEncrypted)
                                    {
                                        <MudChip T="string" Color="Color.Primary" Size="Size.Small" Icon="@Icons.Material.Filled.Lock">@Loc["Encrypted"]</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Default" Size="Size.Small">@Loc["Standard"]</MudChip>
                                    }
                                </MudTd>
                                <MudTd>@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                                   OnClick="@(() => DownloadBackup(context))" title="@Loc["Download"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small" Color="Color.Warning"
                                                   OnClick="@(() => RestoreBackup(context))" title="@Loc["Restore"]" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                                   OnClick="@(() => DeleteBackup(context))" title="@Loc["Delete"]" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                    </div>
                }
                else
                {
                    <MudText Typo="Typo.body2" Color="Color.Secondary">@Loc["No backups found."]</MudText>
                }
            </SettingsCard>

            @* --- Card 5: Storage Optimization & Orphan Cleanup --- *@
            <SettingsCard Title="@Loc["Storage Optimization"]"
                          Icon="@Icons.Material.Filled.CleaningServices"
                          Description="@Loc["Permanently purge unreferenced orphaned files from the server's storage."]">
                <div class="d-flex flex-column flex-sm-row align-start align-sm-center justify-space-between gap-3">
                    <div>
                        <MudText Typo="Typo.body2">
                            @Loc["Over time, abandoned uploads and deleted attachments can accumulate on disk. This scans all database entities and removes files that are no longer referenced anywhere."]
                        </MudText>
                    </div>
                    <MudButton Variant="Variant.Outlined" Color="Color.Default"
                               StartIcon="@Icons.Material.Filled.CleaningServices"
                               OnClick="CleanOrphanedFilesAsync"
                               Disabled="@(_isCleaningOrphans || BackupSvc.IsRunning)">
                        @if (_isCleaningOrphans)
                        {
                            <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                            <span>@Loc["Cleaning..."]</span>
                        }
                        else
                        {
                            <span>@Loc["Clean Orphaned Files"]</span>
                        }
                    </MudButton>
                </div>
            </SettingsCard>

        </MudStack>
    }
    else if (activeTabIndex == 6)
    {
        <MudStack Spacing="4">
            @* --- Card 1: Incoming Mail (IMAP) --- *@
            <SettingsCard Title="Incoming Mail (IMAP)"
                          Icon="@Icons.Material.Filled.MoveToInbox"
                          Description="Configure the IMAP server settings used to retrieve incoming employee emails.">
                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.EmailSettings.ImapHost" Label="IMAP Host" HelperText="e.g. imap.gmail.com" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField ShrinkLabel="true" @bind-Value="Profile.EmailSettings.ImapPort" Margin="Margin.Dense" Label="Port" Variant="Variant.Outlined" HelperText="e.g. 993" />
                    </MudItem>
                    <MudItem xs="12">
                        <SettingsSwitchRow Title="Use SSL / TLS Encryption"
                                           Description="Encrypt connection with IMAP server using TLS/SSL."
                                           Value="Profile.EmailSettings.ImapSsl"
                                           ValueChanged="@((bool v) => Profile.EmailSettings.ImapSsl = v)" />
                    </MudItem>
                </MudGrid>
            </SettingsCard>

            @* --- Card 2: Outgoing Mail (SMTP) --- *@
            <SettingsCard Title="Outgoing Mail (SMTP)"
                          Icon="@Icons.Material.Filled.Send"
                          Description="Configure the SMTP server settings used to send notifications and outgoing emails.">
                <MudGrid>
                    <MudItem xs="12" sm="8">
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.EmailSettings.SmtpHost" Label="SMTP Host" HelperText="e.g. smtp.gmail.com" />
                    </MudItem>
                    <MudItem xs="12" sm="4">
                        <MudNumericField ShrinkLabel="true" @bind-Value="Profile.EmailSettings.SmtpPort" Margin="Margin.Dense" Label="Port" HelperText="e.g. 465" Variant="Variant.Outlined" />
                    </MudItem>
                    <MudItem xs="12">
                        <SettingsSwitchRow Title="Use SSL / TLS Encryption"
                                           Description="Encrypt connection with SMTP server using TLS/SSL."
                                           Value="Profile.EmailSettings.SmtpSsl"
                                           ValueChanged="@((bool v) => Profile.EmailSettings.SmtpSsl = v)" />
                    </MudItem>
                </MudGrid>
            </SettingsCard>

        </MudStack>
    }
    else if (activeTabIndex == 5)
    {
        <MudStack Spacing="4">
            <SettingsCard Title="@Loc["Permission Groups & Roles"]"
                          Icon="@Icons.Material.Filled.Security"
                          Description="@Loc["Create roles and permission groups for your users. Select a default group for new users."]">
                <MudGrid Class="mb-3">
                    <MudItem xs="12" sm="7" md="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.DefaultPermissionGroupId" 
                                   ToStringFunc="@(id => string.IsNullOrEmpty(id) ? Loc["-- None (Chat Only) --"].Value : Profile.PermissionGroups.FirstOrDefault(g => g.Id == id)?.Name ?? id)"
                                   Label="@Loc["Default New User Role"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@string.Empty">@Loc["-- None (Chat Only) --"]</MudSelectItem>
                            @foreach (var g in Profile.PermissionGroups)
                            {
                                <MudSelectItem Value="@g.Id">@g.Name</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" sm="5" md="6" Class="d-flex align-center">
                        @if (!IsFriendEdition)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadBusinessDefaults">Load Business Edition Defaults</MudButton>
                        }
                        @if (IsFriendEdition)
                        {
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadFriendDefaults">@Loc["Load Defaults"]</MudButton>
                        }
                    </MudItem>
                </MudGrid>

                <div class="overflow-x-auto">
                    <MudTable Items="@Profile.PermissionGroups" Breakpoint="Breakpoint.None" Hover="true" Dense="true" Outlined="true" Bordered="true" Elevation="0">
                        <HeaderContent>
                            <MudTh Style="min-width: 250px;">@Loc["Group Name"]</MudTh>
                            <MudTh Style="min-width: 200px;">@Loc["Permissions Count"]</MudTh>
                            <MudTh Style="width: 160px;">@Loc["Actions"]</MudTh>
                        </HeaderContent>
                        <RowTemplate>
                            <MudTd>@context.Name</MudTd>
                            <MudTd>@(string.Format(Loc["{0} permission(s)"].Value, context.Permissions.Count))</MudTd>
                            <MudTd>
                                <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditPermissionGroup(context))" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemovePermissionGroup(context))" />
                            </MudTd>
                        </RowTemplate>
                        <FooterContent>
                            <MudTd colspan="3">
                                <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddPermissionGroup" Color="Color.Primary">@Loc["Add Group"]</MudButton>
                            </MudTd>
                        </FooterContent>
                    </MudTable>
                </div>

            </SettingsCard>
        </MudStack>
    }
    else if (activeTabIndex == 7)
    {
        <MudStack Spacing="4">
            @* --- Card 1: Channel Security & Notifications --- *@
            <SettingsCard Title="@Loc["Channel Security & Notifications"]"
                          Icon="@Icons.Material.Filled.Security"
                          Description="@Loc["Global settings for public channel recovery, notifications, and cache limits."]">
                @if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("SPOKES_MASTER_PASSWORD")))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4">
                        <b>@Loc["Master Password Configured via Environment:"]</b> @Loc["Public channel messages are securely escrowed."]
                    </MudAlert>
                }
                else if (!string.IsNullOrEmpty(Profile.PublicChannelMasterPassword))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <b>@Loc["Insecure Legacy Master Password Found:"]</b> @Loc["Please copy this password and add it to your docker-compose.yml as `SPOKES_MASTER_PASSWORD` to secure your server. Restart the server after setting the variable."]
                        <MudTextField Value="@Profile.PublicChannelMasterPassword" ReadOnly="true" Margin="Margin.Dense" Class="mt-2" />
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <b>@Loc["Master Password Missing:"]</b> @Loc["Set the `SPOKES_MASTER_PASSWORD` environment variable to enable Server-assisted message recovery for public channels."]
                    </MudAlert>
                }

                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.DefaultPublicChannelSubscription" Label="@Loc["Default Public Channel Notifications (for new users)"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Mentions")">@Loc["Mentions Only"]</MudSelectItem>
                            <MudSelectItem Value="@("All")">@Loc["All Messages"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudNumericField ShrinkLabel="true" @bind-Value="Profile.MaxChatCacheSizeMb" Label="@Loc["Max Global Chat Cache Size (MB)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="10" Max="5000" Step="100" HelperText="@Loc["Limits the amount of RAM the server will allocate for caching chat messages globally. At least 500MB is recommended."]" />
                    </MudItem>
                </MudGrid>
            </SettingsCard>

            @* --- Card 2: GIF Integration --- *@
            <SettingsCard Title="@Loc["GIF Integration"]"
                          Icon="@Icons.Material.Filled.Gif"
                          Description="@Loc["Configure external GIF provider integration for chat messages."]">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.GifProvider" Label="@Loc["GIF Provider"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Spokes Default Provider")">@Loc["Spokes Default Provider"]</MudSelectItem>
                            <MudSelectItem Value="@("Klipy")">Klipy</MudSelectItem>
                            <MudSelectItem Value="@("None")">@Loc["None (Disabled)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (Profile.GifProvider != "Spokes Default Provider")
                    {
                        <MudItem xs="12" sm="6">
                            <MudTextField ShrinkLabel="true" @bind-Value="Profile.GifApiKey" Label="@Loc["API Key"]" Variant="Variant.Outlined" Margin="Margin.Dense" />
                        </MudItem>
                    }
                </MudGrid>
            </SettingsCard>

            @* --- Card 3: Content Moderation --- *@
            <SettingsCard Title="@Loc["Content Moderation"]"
                          Icon="@Icons.Material.Filled.Shield"
                          Description="@Loc["Filter inappropriate content and manage blocked words in discussions."]">
                <SettingsSwitchRow Title="@Loc["Enable Text Moderation Filter"]"
                                   Description="@Loc["Automatically block or sanitize messages containing forbidden words."]"
                                   @bind-Value="Profile.Moderation.EnableTextFilter" />
                @if (Profile.Moderation.EnableTextFilter)
                {
                    <MudDivider Class="my-3" />
                    <MudGrid>
                        <MudItem xs="12" sm="6">
                            <MudSelect ShrinkLabel="true" @bind-Value="Profile.Moderation.TextAction" Label="@Loc["Action on Violation"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                                <MudSelectItem Value="TextModerationAction.Block">@Loc["Block Message"]</MudSelectItem>
                                <MudSelectItem Value="TextModerationAction.Sanitize">@Loc["Sanitize Message (replace with random letters)"]</MudSelectItem>
                            </MudSelect>
                        </MudItem>
                        <MudItem xs="12">
                            <MudText Typo="Typo.subtitle2">@Loc["Blocked Words"]</MudText>
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Enter words to block, separated by commas."]</MudText>
                            <MudTextField Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mt-1"
                                          Value='@(string.Join(", ", Profile.Moderation.BlockedWords))'
                                          ValueChanged="@((string v) => Profile.Moderation.BlockedWords = v.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries).Select(w => w.Trim()).ToList())"
                                          Placeholder="@Loc["e.g. badword, awfulword"]" />
                        </MudItem>
                    </MudGrid>
                }
            </SettingsCard>

            @* --- Card 4: Media & Compression Settings --- *@
            <SettingsCard Title="@Loc["Media & Compression Settings"]"
                          Icon="@Icons.Material.Filled.PermMedia"
                          Description="@Loc["Configure automatic photo and video compression for chat uploads."]">
                <MudAlert Severity="Severity.Info" Dense="true" Class="mb-4">
                    @Loc["Mobile devices capture very large photos and videos (10MB–50MB+ each). Compressing media on mobile saves cellular data and speeds up messaging, while desktop users on high-speed connections can retain higher fidelity."]
                </MudAlert>

                <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["Mobile Uploads"]</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.Chat.MobilePhotoMaxDimension" Label="@Loc["Photo Resolution Limit"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="0">@Loc["Original (No Resizing)"]</MudSelectItem>
                            <MudSelectItem Value="3840">@Loc["4K UHD (3840px)"]</MudSelectItem>
                            <MudSelectItem Value="2560">@Loc["2K QHD (2560px)"]</MudSelectItem>
                            <MudSelectItem Value="1920">@Loc["Full HD (1080px)"]</MudSelectItem>
                            <MudSelectItem Value="1280">@Loc["HD (720px)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.Chat.MobilePhotoQuality" Label="@Loc["Photo Compression Quality"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Profile.Chat.MobilePhotoMaxDimension == 0)" HelperText="@(Profile.Chat.MobilePhotoMaxDimension == 0 ? Loc["Disabled when keeping original resolution."].Value : null)">
                            <MudSelectItem Value="100">@Loc["Maximum Fidelity (100%)"]</MudSelectItem>
                            <MudSelectItem Value="90">@Loc["High Quality (90%)"]</MudSelectItem>
                            <MudSelectItem Value="85">@Loc["Standard Quality (85%)"]</MudSelectItem>
                            <MudSelectItem Value="80">@Loc["Balanced (80%)"]</MudSelectItem>
                            <MudSelectItem Value="70">@Loc["Compact (70%)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.Chat.MobileVideoMaxDimension" Label="@Loc["Video Resolution Limit"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="0">@Loc["Original (No Transcoding)"]</MudSelectItem>
                            <MudSelectItem Value="2160">@Loc["4K UHD (2160p)"]</MudSelectItem>
                            <MudSelectItem Value="1080">@Loc["Full HD (1080p)"]</MudSelectItem>
                            <MudSelectItem Value="720">@Loc["HD (720p)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.Chat.MobileVideoBitrate" Label="@Loc["Video Bitrate Target"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Profile.Chat.MobileVideoMaxDimension == 0)" HelperText="@(Profile.Chat.MobileVideoMaxDimension == 0 ? Loc["Disabled when keeping original video."].Value : null)">
                            <MudSelectItem Value="0">@Loc["Original Pass-through"]</MudSelectItem>
                            <MudSelectItem Value="10000000">@Loc["High Bitrate (10 Mbps)"]</MudSelectItem>
                            <MudSelectItem Value="5000000">@Loc["Standard Bitrate (5 Mbps)"]</MudSelectItem>
                            <MudSelectItem Value="2500000">@Loc["Data Saver (2.5 Mbps)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                <MudDivider Class="my-4" />

                <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["Desktop & Browser Uploads"]</MudText>
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.Chat.DesktopPhotoMaxDimension" Label="@Loc["Photo Resolution Limit"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="0">@Loc["Original (No Resizing)"]</MudSelectItem>
                            <MudSelectItem Value="3840">@Loc["4K UHD (3840px)"]</MudSelectItem>
                            <MudSelectItem Value="2560">@Loc["2K QHD (2560px)"]</MudSelectItem>
                            <MudSelectItem Value="1920">@Loc["Full HD (1080px)"]</MudSelectItem>
                            <MudSelectItem Value="1280">@Loc["HD (720px)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.Chat.DesktopPhotoQuality" Label="@Loc["Photo Compression Quality"]" Variant="Variant.Outlined" Margin="Margin.Dense" Disabled="@(Profile.Chat.DesktopPhotoMaxDimension == 0)" HelperText="@(Profile.Chat.DesktopPhotoMaxDimension == 0 ? Loc["Disabled when keeping original resolution."].Value : null)">
                            <MudSelectItem Value="100">@Loc["Maximum Fidelity (100%)"]</MudSelectItem>
                            <MudSelectItem Value="90">@Loc["High Quality (90%)"]</MudSelectItem>
                            <MudSelectItem Value="85">@Loc["Standard Quality (85%)"]</MudSelectItem>
                            <MudSelectItem Value="80">@Loc["Balanced (80%)"]</MudSelectItem>
                            <MudSelectItem Value="70">@Loc["Compact (70%)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                </MudGrid>
            </SettingsCard>

        </MudStack>
    }
    else if (activeTabIndex == 8)
    {
        <MudStack Spacing="4">
            @* --- Card 1: Licensing & Telemetry --- *@
            <SettingsCard Title="@Loc["Licensing & Telemetry"]"
                          Icon="@Icons.Material.Filled.VerifiedUser"
                          Description="@Loc["Manage your Spokes license and usage statistics preferences."]">
                @if (GetAvailableEditions().Count > 1)
                {
                    <div class="mb-4">
                        <MudSelect ShrinkLabel="true" @bind-Value="Profile.Edition" Label="@Loc["Active Edition"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            @foreach (var edition in GetAvailableEditions())
                            {
                                <MudSelectItem Value="@edition">@(string.Format(Loc["{0} Edition"].Value, edition))</MudSelectItem>
                            }
                        </MudSelect>
                    </div>
                }

                @{
                    var currentConfig = Db.ServerConfigs.GetOrCreateGlobalConfig();
                    var activeValidation = LicenseService.ValidateLicense(Profile.LicensePayload, currentConfig);
                }
                @if (string.IsNullOrEmpty(Profile.LicensePayload))
                {
                    @if (activeValidation.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid)
                    {
                        <MudAlert Severity="Severity.Info" Class="mb-4">
                            <b>@Loc["Free Trial:"]</b> @activeValidation.Message
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-4">
                            <b>@Loc["Native Push Notifications Disabled:"]</b> @Loc["Your free trial for native push notifications has expired, or you do not have a license installed."]
                            <br/>
                            <MudText Typo="Typo.caption">@Loc["The Spokes server continues to function normally, but native push notifications for desktop and mobile apps (iOS & Android) require an active Spokes license."]</MudText>
                        </MudAlert>
                    }
                }
                else
                {
                    @if (activeValidation.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid)
                    {
                        <MudAlert Severity="Severity.Success" Class="mb-4">
                            <b>@Loc["License Active:"]</b> @Loc["Your Spokes instance is licensed for Native Push Notifications (Desktop & Mobile)."]
                        </MudAlert>
                    }
                    else if (activeValidation.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired)
                    {
                        <MudAlert Severity="Severity.Warning" Class="mb-4">
                            <b>@Loc["License Expired:"]</b> @activeValidation.Message @Loc["Native push notifications for desktop and mobile apps are disabled until renewed."]
                        </MudAlert>
                    }
                    else
                    {
                        <MudAlert Severity="Severity.Error" Class="mb-4">
                            <b>@Loc["License Invalid:"]</b> @activeValidation.Message
                        </MudAlert>
                    }

                    Spokes_Server.Core.Services.Licensing.SpokesLicenseFile? license = activeValidation.ParsedLicense;
                    if (license == null)
                    {
                        try 
                        { 
                            var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                            license = System.Text.Json.JsonSerializer.Deserialize<Spokes_Server.Core.Services.Licensing.SpokesLicenseFile>(Profile.LicensePayload, options); 
                        } 
                        catch { }
                    }
                    
                    if (license != null)
                    {
                        <MudPaper Class="pa-4 mb-4 rounded-lg" Elevation="0" Outlined="true">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["License Details"]</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Registered Email"]</MudText>
                                    <MudText Typo="Typo.body2">@license.Email</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Push Notifications Expiry Date"]</MudText>
                                    <MudText Typo="Typo.body2">@license.ValidForUpdatesUntil.ToString("yyyy-MM-dd")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Time Until Expiry"]</MudText>
                                    <MudText Typo="Typo.body2" Color="@((license.ValidForUpdatesUntil - DateTime.UtcNow).TotalDays > 0 ? Color.Success : Color.Error)">
                                        @GetTimeUntilExpiry(license.ValidForUpdatesUntil)
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                }

                <div class="mb-4">
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@Loc["Upload Spokes Pass (.spokes-license)"]</MudText>
                    <div class="d-inline-flex mt-1">
                        <ApiFileUpload 
                            Category="temp" 
                            Accept=".spokes-license"
                            ContextId="@Guid.NewGuid().ToString()" 
                            OnUploadCompleted="HandleLicenseUploaded">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile">
                                    @Loc["Upload Spokes Pass"]
                                </MudButton>
                            </CustomContent>
                        </ApiFileUpload>
                    </div>
                </div>

                <MudDivider Class="my-3" />

                <SettingsSwitchRow Title="@Loc["Send Anonymous Usage Statistics (Soft Ping)"]"
                                   Description="@Loc["We collect a secure hash of your license key along with basic system stats to ensure fair usage and help us improve Spokes. You may disable this at any time."]"
                                   Value="Profile.SendUsageStatistics"
                                   ValueChanged="@(async (bool val) => {
                                       Profile.SendUsageStatistics = val;
                                       Db.CompanyProfile.Save(Profile);
                                       Snackbar.Add(val ? Loc["Anonymous usage statistics enabled."].Value : Loc["Anonymous usage statistics disabled."].Value, Severity.Info);
                                   })" />
            </SettingsCard>

            @* --- Card 2: Server & Network Setup --- *@
            <SettingsCard Title="@Loc["Server & Network Setup"]"
                          Icon="@Icons.Material.Filled.Dns"
                          Description="@Loc["Configure core system settings such as public URLs and LiveKit WebRTC routing ports."]">
                <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.ServerPublicUrl" Label="@Loc["Server Public URL"]" HelperText="@Loc["The base URL where this server is accessible (e.g. https://spokes.example.com)"]" Class="mb-3" />

                @if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("WATCHTOWER_HTTP_API_TOKEN")))
                {
                    <MudDivider Class="my-3" />
                    <SettingsSwitchRow Title="@Loc["Enable Automatic DigitalOcean Updates"]"
                                       Description="@Loc["When enabled, the server will automatically pull and apply updates via Watchtower when a new version is released."]"
                                       @bind-Value="_systemConfig.EnableAutoUpdate" />
                }

                @if (Environment.GetEnvironmentVariable("SPOKES_HOSTING_PROVIDER") != "digitalocean")
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-1">@Loc["LiveKit Ports"]</MudText>
                    <MudAlert Severity="Severity.Warning" Class="mb-3">@Loc["If you modify these ports, you MUST ensure your <b>docker-compose.yml</b> and router are updated to match precisely. These must be mapped 1-to-1-to-1 across your network."]</MudAlert>
                    
                    <MudGrid>
                        <MudItem xs="12" sm="4">
                            <MudNumericField ShrinkLabel="true" @bind-Value="_systemConfig.LiveKitFallbackPort" Margin="Margin.Dense" Label="@Loc["TCP Fallback Port"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField ShrinkLabel="true" @bind-Value="_systemConfig.LiveKitUdpStartPort" Margin="Margin.Dense" Label="@Loc["UDP Start Port"]" Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4">
                            <MudNumericField ShrinkLabel="true" @bind-Value="_systemConfig.LiveKitUdpEndPort" Margin="Margin.Dense" Label="@Loc["UDP End Port"]" Variant="Variant.Outlined" />
                        </MudItem>
                    </MudGrid>
                }
            </SettingsCard>

            @* --- Card: Server Time & Time Zone --- *@
            <SettingsCard Title="@Loc["Server Time & Time Zone"]"
                          Icon="@Icons.Material.Filled.AccessTime"
                          Description="@Loc["Configure how the server determines authoritative time and select the system time zone for scheduled jobs, logs, and dates."]">
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true"
                                   @bind-Value="Profile.Time.TimeSource"
                                   Margin="Margin.Dense"
                                   Label="@Loc["Time Source"]"
                                   Variant="Variant.Outlined">
                            <MudSelectItem Value="@("Host")">@Loc["Host System Clock (Default)"]</MudSelectItem>
                            <MudSelectItem Value="@("Ntp")">@Loc["Network Time Protocol (NTP)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    <MudItem xs="12" sm="6">
                        <MudSelect ShrinkLabel="true"
                                   @bind-Value="Profile.TimeZoneId"
                                   Margin="Margin.Dense"
                                   Label="@Loc["System Time Zone"]"
                                   Variant="Variant.Outlined">
                            <MudSelectItem Value="@string.Empty">@Loc["Server Local Time (Default)"]</MudSelectItem>
                            @foreach (var tz in TimeZoneInfo.GetSystemTimeZones())
                            {
                                <MudSelectItem Value="@tz.Id">@tz.DisplayName</MudSelectItem>
                            }
                        </MudSelect>
                    </MudItem>
                </MudGrid>

                @if (Profile.Time?.TimeSource == "Ntp")
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-2">@Loc["NTP Configuration"]</MudText>
                    <MudGrid>
                        <MudItem xs="12" sm="8">
                            <MudTextField ShrinkLabel="true"
                                          @bind-Value="Profile.Time.NtpServer"
                                          Margin="Margin.Dense"
                                          Label="@Loc["NTP Server Address"]"
                                          Placeholder="time.cloudflare.com"
                                          HelperText="@Loc["Recommended servers: time.cloudflare.com, time.google.com, pool.ntp.org"]"
                                          Variant="Variant.Outlined" />
                        </MudItem>
                        <MudItem xs="12" sm="4" Class="d-flex align-center">
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.Sync"
                                       Disabled="_isNtpSyncing"
                                       OnClick="SyncNtpNowAsync">
                                @if (_isNtpSyncing)
                                {
                                    <MudProgressCircular Class="ms-n1 me-2" Size="Size.Small" Indeterminate="true" />
                                    @Loc["Syncing..."]
                                }
                                else
                                {
                                    @Loc["Sync Now"]
                                }
                            </MudButton>
                        </MudItem>
                    </MudGrid>

                    @if (Profile.Time?.LastNtpSyncUtc.HasValue == true)
                    {
                        <div class="mt-3 d-flex flex-wrap gap-4 align-center">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                <b>@Loc["Last Synchronized:"]</b> @Profile.Time.LastNtpSyncUtc.Value.ToString("yyyy-MM-dd HH:mm:ss") UTC
                            </MudText>
                            <MudText Typo="Typo.caption" Color="@(Math.Abs(Profile.Time.LastDriftOffsetSeconds) > 2 ? Color.Warning : Color.Success)">
                                <b>@Loc["Measured Clock Offset:"]</b> @(Profile.Time.LastDriftOffsetSeconds >= 0 ? $"+{Profile.Time.LastDriftOffsetSeconds:F3}s" : $"{Profile.Time.LastDriftOffsetSeconds:F3}s")
                            </MudText>
                        </div>
                    }

                    @if (!string.IsNullOrEmpty(Profile.Time?.LastSyncError))
                    {
                        <MudAlert Severity="Severity.Warning" Dense="true" Class="mt-2">
                            <b>@Loc["Last Sync Error:"]</b> @Profile.Time.LastSyncError
                        </MudAlert>
                    }
                }

                <div class="mt-4 pa-3 rounded-lg" style="background-color: var(--mud-palette-background-grey);">
                    <MudGrid Spacing="1">
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Authoritative UTC Time"]</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600; font-family: monospace;">
                                @SpokesClock.UtcNow.ToString("yyyy-MM-dd HH:mm:ss") UTC
                            </MudText>
                        </MudItem>
                        <MudItem xs="12" sm="6">
                            <MudText Typo="Typo.caption" Color="Color.Secondary">@Loc["Effective Local Time"]</MudText>
                            <MudText Typo="Typo.body2" Style="font-weight: 600; font-family: monospace;">
                                @SpokesClock.Now.ToString("yyyy-MM-dd HH:mm:ss")
                            </MudText>
                        </MudItem>
                    </MudGrid>
                </div>
            </SettingsCard>

            @* --- Card 3: Identity Provider --- *@
            <SettingsCard Title="@Loc["Identity Provider"]"
                          Icon="@Icons.Material.Filled.Key"
                          Description="@Loc["Configure the system's global identity provider (Built-in Casdoor or External OIDC)."]">
                <MudSelect ShrinkLabel="true" Value="_systemConfig.ProviderType" ValueChanged="@((IdpType v) => OnProviderTypeChanged(v))" Label="@Loc["Identity Provider Type"]" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    <MudSelectItem Value="@IdpType.BuiltInCasdoor">@Loc["Built-in Casdoor"]</MudSelectItem>
                    <MudSelectItem Value="@IdpType.External">@Loc["External Provider (OIDC)"]</MudSelectItem>
                </MudSelect>

                @if (_systemConfig.ProviderType == IdpType.External)
                {
                    <MudDivider Class="my-3" />
                    <MudText Typo="Typo.subtitle2" Class="mb-3">@Loc["External Provider Configuration"]</MudText>
                    <MudStack Spacing="3">
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.Authority" Label="@Loc["Issuer / Authority URL"]" Required="true" />
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.ClientId" Label="@Loc["Client ID"]" Required="true" />
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.ClientSecret" Label="@Loc["Client Secret"]" InputType="InputType.Password" Required="true" />
                    </MudStack>
                }
            </SettingsCard>

            @* --- Card 4: Browser Push (VAPID) Keys --- *@
            <SettingsCard Title="@Loc["Browser Push (VAPID) Keys"]"
                          Icon="@Icons.Material.Filled.Notifications"
                          Description="@Loc["VAPID keys authenticate your server with push notification services for browsers without requiring a Spokes Pass."]">
                @if (string.IsNullOrEmpty(Profile.VapidPublicKey))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-3">
                        <MudText><strong>@Loc["Push notifications are not configured."]</strong> @Loc["Click the button below to generate VAPID keys."]</MudText>
                    </MudAlert>
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key" OnClick="GenerateVapidKeys">
                        @Loc["Generate VAPID Keys"]
                    </MudButton>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="mb-3">
                        @Loc["Push notifications are configured and ready to use."]
                    </MudAlert>

                    <MudGrid>
                        <MudItem xs="12">
                            <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.VapidPublicKey" Label="@Loc["Public Key"]" ReadOnly="true"
                                          Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                                          OnAdornmentClick="@(() => CopyToClipboard(Profile.VapidPublicKey))" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@MaskedPrivateKey" Label="@Loc["Private Key (Hidden)"]" ReadOnly="true"
                                          InputType="InputType.Password"
                                          HelperText="@Loc["Private key is stored securely and hidden for security"]" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.VapidSubject" Label="@Loc["Contact Email"]"
                                          HelperText="@Loc["Email address for push service operators to contact you (e.g., mailto:admin@company.com)"]" />
                        </MudItem>
                    </MudGrid>

                    <div class="d-flex flex-column flex-sm-row align-start align-sm-center gap-3 mt-3">
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Refresh" OnClick="RegenerateVapidKeys">
                            @Loc["Regenerate Keys"]
                        </MudButton>
                        <MudText Typo="Typo.caption" Color="Color.Error">
                            @Loc["Warning: Regenerating keys will invalidate all existing push subscriptions."]
                        </MudText>
                    </div>
                }
            </SettingsCard>

        </MudStack>
    }
    else if (activeTabIndex == 9)
    {
        <MudStack Spacing="4">
            @* --- Card 1: Diagnostics --- *@
            <SettingsCard Title="@Loc["Diagnostics"]"
                          Icon="@Icons.Material.Filled.BugReport"
                          IconColor="Color.Warning"
                          Description="@Loc["Configure real-time exception transmission and debugging options."]">
                <SettingsSwitchRow Title="@Loc["Enable Detailed Circuit Errors"]"
                                   Description="@Loc["Transmits detailed exception stack traces to the browser console and Blazor UI for debugging. Requires a new connection or server restart to take effect. Leave disabled in production for security and performance."]"
                                   Value="_systemConfig.EnableDetailedCircuitErrors"
                                   ValueChanged="OnDetailedCircuitErrorsChanged" />
            </SettingsCard>

            @* --- Card 2: Server Event Logs --- *@
            <SettingsCard Title="@Loc["Server Event Logs"]"
                          Icon="@Icons.Material.Filled.Terminal"
                          Description="@Loc["View internal server errors and events. Logs are stored as JSON Lines and displayed here as raw text for easy copying."]">
                <HeaderActions>
                    <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" Color="Color.Default" Size="Size.Small" OnClick="CopyLogsToClipboard">
                        @Loc["Copy Logs"]
                    </MudButton>
                </HeaderActions>
                <ChildContent>
                    <div class="mb-4" style="max-width: 300px;">
                        <MudDatePicker Label="@Loc["Log Date"]"
                                       Date="@((DateTime?)_selectedLogDate)"
                                       DateChanged="OnLogDateChangedNullable"
                                       AdditionalDateClassesFunc="GetLogDateClasses"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense" />
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1 d-block">@Loc["Dates with a colored ring have log entries."]</MudText>
                    </div>

                    <MudPaper Class="pa-4 rounded-lg" Outlined="true" Style="background-color: #1e1e1e; max-height: 600px; overflow-y: auto;">
                        @if (_currentLogs.Count == 0)
                        {
                            <MudText Typo="Typo.body2" Style="color: #888;">@Loc["No logs found for this date."]</MudText>
                        }
                        else
                        {
                            <pre style="color: #d4d4d4; font-family: Consolas, monospace; font-size: 13px; white-space: pre-wrap; margin: 0;">
@foreach (var log in _currentLogs)
{
@($"[{log.TimestampUtc:yyyy-MM-dd HH:mm:ss}] [{log.Severity.ToUpper()}] [{log.Category}] {log.Message}")
@if (!string.IsNullOrEmpty(log.Details))
{
@Environment.NewLine@log.Details
}
@Environment.NewLine
}
                            </pre>
                        }
                    </MudPaper>

                    <div class="d-flex justify-end mt-3">
                        <MudButton Variant="Variant.Outlined" StartIcon="@Icons.Material.Filled.ContentCopy" Color="Color.Default" OnClick="CopyLogsToClipboard">
                            @Loc["Copy Logs"]
                        </MudButton>
                    </div>
                </ChildContent>
            </SettingsCard>
        </MudStack>
    }
    else if (activeTabIndex == 10)
    {
        <MudStack Spacing="4">
            @* --- Card 1: HR & Overtime --- *@
            <SettingsCard Title="@BizLoc["HR & Overtime"]"
                          Icon="@Icons.Material.Filled.MoreTime"
                          Description="@BizLoc["Configure how employee hour banks and overtime thresholds are calculated."]">
                <SettingsSwitchRow Title="@BizLoc["Enable Hour Bank"]"
                                   Description="@BizLoc["Track banked hours that employees can redeem or cash out."]"
                                   Value="Profile.HRConfig.EnableHourBank"
                                   ValueChanged="@(async (bool v) => { Profile.HRConfig.EnableHourBank = v; await SaveProfile(); })" />
                <MudDivider Class="my-3" />
                <MudGrid>
                    <MudItem xs="12" sm="6">
                        <MudSelect T="string" ShrinkLabel="true" Value="Profile.HRConfig.OvertimeCalculationMode" ValueChanged="@(async (string v) => { Profile.HRConfig.OvertimeCalculationMode = v; await SaveProfile(); })" Label="@BizLoc["Overtime Calculation Mode"]" Variant="Variant.Outlined" Margin="Margin.Dense">
                            <MudSelectItem Value="@("Weekly")">@BizLoc["Weekly (Default)"]</MudSelectItem>
                            <MudSelectItem Value="@("Daily")">@BizLoc["Daily"]</MudSelectItem>
                            <MudSelectItem Value="@("None")">@BizLoc["None (Disabled)"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>
                    @if (Profile.HRConfig.OvertimeCalculationMode == "Daily")
                    {
                        <MudItem xs="12" sm="6">
                            <MudNumericField T="decimal" ShrinkLabel="true" Value="Profile.HRConfig.DailyOvertimeThreshold" ValueChanged="@(async (decimal v) => { Profile.HRConfig.DailyOvertimeThreshold = v; await SaveProfile(); })" Label="@BizLoc["Daily Overtime Threshold (Hours)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="24" Step="0.5m" />
                        </MudItem>
                    }
                    <MudItem xs="12" sm="6">
                        <MudNumericField T="decimal" ShrinkLabel="true" Value="Profile.HRConfig.MaxBankableHours" ValueChanged="@(async (decimal v) => { Profile.HRConfig.MaxBankableHours = v; await SaveProfile(); })" Label="@BizLoc["Max Bankable Hours (0 for unlimited)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="0" Step="1" />
                    </MudItem>
                </MudGrid>
            </SettingsCard>

            @* --- Card 2: Features --- *@
            <SettingsCard Title="@BizLoc["Features"]"
                          Icon="@Icons.Material.Filled.Extension"
                          Description="@BizLoc["Enable or disable optional timesheet modules for your organization."]">
                <SettingsSwitchRow Title="@BizLoc["Enable Weekly Plan"]"
                                   Description="@BizLoc["When disabled, the weekly plan widget is hidden from employee timesheets and the Team Planning page is hidden from managers."]"
                                   Value="Profile.TimesheetConfig.EnableWeeklyPlan"
                                   ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.EnableWeeklyPlan = v; await SaveProfile(); })" />
            </SettingsCard>

            @* --- Card 3: Approval Workflow --- *@
            <SettingsCard Title="@BizLoc["Approval Workflow"]"
                          Icon="@Icons.Material.Filled.FactCheck"
                          Description="@BizLoc["Require manager approval before timesheets are finalized."]">
                <SettingsSwitchRow Title="@BizLoc["Require Timesheet Approval"]"
                                   Description="@BizLoc["When enabled, employees must submit timesheets for manager approval. Approved timesheets become read-only."]"
                                   Value="Profile.TimesheetConfig.RequireApproval"
                                   ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireApproval = v; await SaveProfile(); })" />
            </SettingsCard>

            @* --- Card 4: Timesheet Locking --- *@
            <SettingsCard Title="@BizLoc["Timesheet Locking"]"
                          Icon="@Icons.Material.Filled.LockClock"
                          Description="@BizLoc["Automatically lock timesheets after a set number of days to prevent edits to finalized periods."]">
                <SettingsSwitchRow Title="@BizLoc["Enable Automatic Timesheet Locking"]"
                                   Description="@BizLoc["Prevent employees and managers from modifying entries older than the cutoff threshold."]"
                                   Value="Profile.TimesheetConfig.EnableTimesheetLocking"
                                   ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.EnableTimesheetLocking = v; await SaveProfile(); })" />
                @if (Profile.TimesheetConfig.EnableTimesheetLocking)
                {
                    <MudDivider Class="my-3" />
                    <div style="max-width: 320px;">
                        <MudNumericField T="int" ShrinkLabel="true" Value="Profile.TimesheetConfig.LockTimesheetsOlderThanDays" ValueChanged="@(async (int v) => { Profile.TimesheetConfig.LockTimesheetsOlderThanDays = v; await SaveProfile(); })" Label="@BizLoc["Lock timesheets older than (days)"]" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="365" />
                    </div>
                }
            </SettingsCard>

            @* --- Card 5: Required Fields --- *@
            <SettingsCard Title="@BizLoc["Required Fields"]"
                          Icon="@Icons.Material.Filled.Rule"
                          Description="@BizLoc["Control which fields employees must fill in when logging time."]">
                <MudStack Spacing="1">
                    <SettingsSwitchRow Title="@BizLoc["Require Project"]"
                                       Description="@BizLoc["Employees must select a project when recording hours."]"
                                       Value="Profile.TimesheetConfig.RequireProject"
                                       ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireProject = v; await SaveProfile(); })" />
                    <MudDivider />
                    <SettingsSwitchRow Title="@BizLoc["Require Task"]"
                                       Description="@BizLoc["Employees must select a project task when recording hours."]"
                                       Value="Profile.TimesheetConfig.RequireTask"
                                       ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireTask = v; await SaveProfile(); })" />
                    <MudDivider />
                    <SettingsSwitchRow Title="@BizLoc["Require Note"]"
                                       Description="@BizLoc["Employees must include a text description when recording hours."]"
                                       Value="Profile.TimesheetConfig.RequireNote"
                                       ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireNote = v; await SaveProfile(); })" />
                </MudStack>
            </SettingsCard>

            @* --- Card 6: Time Rounding --- *@
