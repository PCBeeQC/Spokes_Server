            </MudItem>

            @* Features *@
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Features</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Enable or disable optional timesheet modules for your organization.</MudText>
                    <MudSwitch T="bool" Value="Profile.TimesheetConfig.EnableWeeklyPlan" ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.EnableWeeklyPlan = v; await SaveProfile(); })" Label="Enable Weekly Plan" Color="Color.Primary" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">When disabled, the weekly plan widget is hidden from employee timesheets and the Team Planning page is hidden from managers.</MudText>
                </MudPaper>
            </MudItem>

            @* Approval Workflow *@
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Approval Workflow</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">When enabled, employees must submit timesheets for manager approval. Approved timesheets become read-only.</MudText>
                    <MudSwitch T="bool" Value="Profile.TimesheetConfig.RequireApproval" ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireApproval = v; await SaveProfile(); })" Label="Require timesheet approval" Color="Color.Primary" />
                </MudPaper>
            </MudItem>

            @* Timesheet Locking *@
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Timesheet Locking</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Automatically lock timesheets after a set number of days to prevent edits to finalized periods.</MudText>
                    <MudSwitch T="bool" Value="Profile.TimesheetConfig.EnableTimesheetLocking" ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.EnableTimesheetLocking = v; await SaveProfile(); })" Label="Enable automatic timesheet locking" Color="Color.Primary" />
                    @if (Profile.TimesheetConfig.EnableTimesheetLocking)
                    {
                        <MudNumericField T="int" Value="Profile.TimesheetConfig.LockTimesheetsOlderThanDays" ValueChanged="@(async (int v) => { Profile.TimesheetConfig.LockTimesheetsOlderThanDays = v; await SaveProfile(); })" Label="Lock timesheets older than (days)" Variant="Variant.Outlined" Min="1" Max="365" Class="mt-3" Style="max-width: 300px;" />
                    }
                </MudPaper>
            </MudItem>

            @* Required Fields *@
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Required Fields</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Control which fields employees must fill in when logging time.</MudText>
                    <MudStack Spacing="1">
                        <MudSwitch T="bool" Value="Profile.TimesheetConfig.RequireProject" ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireProject = v; await SaveProfile(); })" Label="Require project" Color="Color.Primary" />
                        <MudSwitch T="bool" Value="Profile.TimesheetConfig.RequireTask" ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireTask = v; await SaveProfile(); })" Label="Require task" Color="Color.Primary" />
                        <MudSwitch T="bool" Value="Profile.TimesheetConfig.RequireNote" ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.RequireNote = v; await SaveProfile(); })" Label="Require note" Color="Color.Primary" />
                    </MudStack>
                </MudPaper>
            </MudItem>

            @* Time Rounding *@
            <MudItem xs="12">
                <MudPaper Class="pa-4" Outlined="true">
                    <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Time Rounding</b></MudText>
                    <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-3">Round time entries in reports and exports. Raw timesheet data is not modified.</MudText>
                    <MudSwitch T="bool" Value="Profile.TimesheetConfig.EnableRounding" ValueChanged="@(async (bool v) => { Profile.TimesheetConfig.EnableRounding = v; await SaveProfile(); })" Label="Enable time rounding" Color="Color.Primary" />
                    @if (Profile.TimesheetConfig.EnableRounding)
                    {
                        <MudGrid Class="mt-3">
                            <MudItem xs="12" sm="6">
                                <MudSelect T="int" Value="Profile.TimesheetConfig.RoundingIntervalMinutes" ValueChanged="@(async (int v) => { Profile.TimesheetConfig.RoundingIntervalMinutes = v; await SaveProfile(); })" Label="Rounding interval" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="5">5 minutes</MudSelectItem>
                                    <MudSelectItem Value="6">6 minutes</MudSelectItem>
                                    <MudSelectItem Value="15">15 minutes</MudSelectItem>
                                    <MudSelectItem Value="30">30 minutes</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                            <MudItem xs="12" sm="6">
                                <MudSelect T="string" Value="Profile.TimesheetConfig.RoundingDirection" ValueChanged="@(async (string v) => { Profile.TimesheetConfig.RoundingDirection = v; await SaveProfile(); })" Label="Rounding direction" Variant="Variant.Outlined" AnchorOrigin="Origin.BottomCenter">
                                    <MudSelectItem Value="@("Nearest")">Nearest</MudSelectItem>
                                    <MudSelectItem Value="@("Up")">Round up</MudSelectItem>
                                    <MudSelectItem Value="@("Down")">Round down</MudSelectItem>
                                </MudSelect>
                            </MudItem>
                        </MudGrid>
                    }
                </MudPaper>
            </MudItem>
        </MudGrid>
