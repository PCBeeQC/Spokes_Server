    [Inject] private StorageMaintenanceService StorageMaintenance { get; set; } = default!;
    private bool _isCleaningOrphans;

    private async Task CleanOrphanedFilesAsync()
    {
        if (_isCleaningOrphans) return;

        var confirmed = await DialogService.ShowMessageBoxAsync(
            Loc["Clean Orphaned Files"].Value,
            Loc["Are you sure you want to scan for and permanently delete all orphaned files? Files modified in the last 15 minutes will be safely preserved."].Value,
            yesText: Loc["Clean Now"].Value,
            cancelText: Loc["Cancel"].Value);

        if (confirmed != true) return;

        _isCleaningOrphans = true;
        StateHasChanged();

        try
        {
            var result = await StorageMaintenance.PurgeOrphanedUploadsAsync();
            if (result.Errors.Count > 0)
            {
                Snackbar.Add(string.Format(Loc["Cleaned {0} orphaned files ({1} reclaimed) with {2} errors."].Value,
                    result.OrphansDeleted, result.FormattedBytesReclaimed, result.Errors.Count), Severity.Warning);
            }
            else if (result.OrphansDeleted == 0)
            {
                Snackbar.Add(Loc["No orphaned files found. Storage is clean!"].Value, Severity.Info);
            }
            else
            {
                Snackbar.Add(string.Format(Loc["Cleaned {0} orphaned files ({1} reclaimed)."].Value,
                    result.OrphansDeleted, result.FormattedBytesReclaimed), Severity.Success);
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error cleaning orphaned files");
            Snackbar.Add(string.Format(Loc["Failed to clean orphaned files: {0}"].Value, ex.Message), Severity.Error);
        }
        finally
        {
            _isCleaningOrphans = false;
            StateHasChanged();
        }
    }

    private bool _isSaving;

    private async Task SaveCurrentSettings()
    {
        if (_isSaving) return;
        _isSaving = true;
        StateHasChanged();

        try
        {
            if (activeTabIndex == 8)
            {
                await SaveSystemSetup();
            }
            else if (activeTabIndex != 9)
            {
                await SaveProfile();
            }
        }
        finally
        {
            _isSaving = false;
            StateHasChanged();
        }
    }

    private async Task SaveProfile()
    {
        Profile.PrimaryColor = _primaryColor;
        Profile.SecondaryColor = _secondaryColor;
        BrandingService.SaveWithOptimizedBranding(Profile);
        CultureCircuitHandler.ApplyDateFormat(Profile.DateFormat);
        
        // Sync branding to Casdoor
        try
        {
            await CasdoorProvisioning.SyncBrandingAsync();
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "[CompanySettings] Failed to sync branding to Casdoor during profile save");
        }

        Snackbar.Add(string.Format(Loc["{0} Profile Saved"].Value, AppLabels.Company), Severity.Success);
    }

    // --- Permission Group Logic ---

    private async Task AddPermissionGroup()
    {
        var group = new PermissionGroup { Name = Loc["New Group"].Value };
        var parameters = new DialogParameters { ["Group"] = group };
        var dialog = await DialogService.ShowAsync<PermissionGroupDialog>(Loc["Create Permission Group"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PermissionGroup newGroup)
        {
            Profile.PermissionGroups.Add(newGroup);
            await SaveProfile();
        }
    }

    private async Task EditPermissionGroup(PermissionGroup group)
    {
        var parameters = new DialogParameters { ["Group"] = group };
        var dialog = await DialogService.ShowAsync<PermissionGroupDialog>(Loc["Edit Permission Group"].Value, parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PermissionGroup updatedGroup)
        {
            var index = Profile.PermissionGroups.FindIndex(g => g.Id == updatedGroup.Id);
            if (index != -1)
            {
                Profile.PermissionGroups[index] = updatedGroup;
            }
            await SaveProfile();
        }
    }

    private async Task RemovePermissionGroup(PermissionGroup group)
    {
        bool hasDuplicateEntry = Profile.PermissionGroups.Count(g => g.Id == group.Id) > 1;

        if (!hasDuplicateEntry)
        {
            var assignedActiveUsers = Db.Employees.GetAll()
                .Where(e => e.IsActive && (e.PermissionGroupIds.Contains(group.Id) || e.PermissionGroupId == group.Id))
                .ToList();

            if (assignedActiveUsers.Count > 0)
            {
                await DialogService.ShowMessageBoxAsync(
                    Loc["Cannot Delete Group"].Value,
                    string.Format(Loc["Cannot delete '{0}' because it is assigned to {1} active {2}. Please reassign them before deleting this group."].Value,
                        group.Name, assignedActiveUsers.Count, assignedActiveUsers.Count == 1 ? AppLabels.Employee.ToLower() : AppLabels.Employees.ToLower()),
                    yesText: Loc["OK"].Value);
                return;
            }
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            Loc["Delete Permission Group"].Value,
            string.Format(Loc["Are you sure you want to delete {0}? Users currently having these permissions will not lose them, but this group will no longer be available for new users."].Value, group.Name),
            yesText: Loc["Delete"].Value, cancelText: Loc["Cancel"].Value);
        if (confirmed == true)
        {
            Profile.PermissionGroups.Remove(group);
            if (Profile.DefaultPermissionGroupId == group.Id && !Profile.PermissionGroups.Any(g => g.Id == group.Id))
            {
                Profile.DefaultPermissionGroupId = string.Empty;
            }
            await SaveProfile();
        }
    }

    private async Task LoadBusinessDefaults()
    {
        var defaults = DefaultPermissionGroups.GetBusinessDefaults();
        var existingIds = Profile.PermissionGroups.Select(g => g.Id).ToHashSet();
        var existingNames = Profile.PermissionGroups.Select(g => g.Name.Trim().ToLowerInvariant()).ToHashSet();

        var toAdd = defaults
            .Where(d => !existingIds.Contains(d.Id) && !existingNames.Contains(d.Name.Trim().ToLowerInvariant()))
            .ToList();

        if (toAdd.Count == 0)
        {
            Snackbar.Add(Loc["All default permission groups are already present."].Value, Severity.Info);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            "Load Business Defaults",
            "This will append the default Business Edition permission groups to your list. Proceed?",
            yesText: Loc["Load"].Value, cancelText: Loc["Cancel"].Value);
        if (confirmed == true)
        {
            Profile.PermissionGroups.AddRange(toAdd);
            await SaveProfile();
            Snackbar.Add(string.Format(Loc["Added {0} default group(s)."].Value, toAdd.Count), Severity.Success);
        }
    }

