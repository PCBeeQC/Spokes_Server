@using Spokes_Server.Core.Services

@inject Spokes_Server.Core.Services.Core.UserService UserService
@inject Spokes_Server.Core.Services.Core.CasdoorProvisioningService CasdoorProvisioning

@code {
    private CompanyProfile Profile = default!;
    private SystemConfig _systemConfig = new();
    private SystemConfig _initialSystemConfig = new();
    private List<DocumentTemplate> Templates = new();
    private string _primaryColor = string.Empty;
    private string _secondaryColor = string.Empty;
    private string MaskedPrivateKey => string.IsNullOrEmpty(Profile?.VapidPrivateKey) ? "" : new string('�', 20);
    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";
    [Inject] private Spokes_Server.Core.Services.Communication.Notifications.IWebPushService WebPush { get; set; } = default!;
    [Inject] private Spokes_Server.Core.Services.Licensing.LicenseValidationService LicenseService { get; set; } = default!;
    [Inject] private Spokes_Server.Core.Services.Logging.ISystemLogService SystemLog { get; set; } = default!;

    [SupplyParameterFromQuery] public string? Tab { get; set; }
    [SupplyParameterFromQuery] public bool Restored { get; set; }
    [SupplyParameterFromQuery] public bool CasdoorRestarted { get; set; }
    private int activeTabIndex = 0;

    private List<DateTime> _availableLogDates = new();
    private DateTime _selectedLogDate = DateTime.Today;
    private List<Spokes_Server.Core.Services.Logging.SystemLogEntry> _currentLogs = new();

    protected override void OnParametersSet()
    {
        if (!string.IsNullOrEmpty(Tab))
        {
            activeTabIndex = Tab.ToLower() switch
            {
                "profile" => 0,
                "templates" => 1,
                "statuses" => 2,
                "categories" => 3,
                "backups" => 4,
                "permissions" => 5,
                "email" => 6,
                "chat" => 7,
                "setup" => 8,
                "logs" => 9,
                "timesheets" => 10,
                _ => 0
            };
        }
    }

    private bool _isDisposed;

    public void Dispose()
    {
        _isDisposed = true;
    }

    private void UpdateActiveTab(int index)
    {
        if (_isDisposed) return;
        
        activeTabIndex = index;
        
        // Prevent navigation if the component is being disposed due to navigating to another page
        if (!Nav.Uri.Contains("/admin/settings", StringComparison.OrdinalIgnoreCase))
        {
            return;
        }

        var tabName = index switch
        {
            0 => "profile",
            1 => "templates",
            2 => "statuses",
            3 => "categories",
            4 => "backups",
            5 => "permissions",
            6 => "email",
            7 => "chat",
            8 => "setup",
            9 => "logs",
            10 => "timesheets",
            _ => "profile"
        };
        
        try
        {
            Nav.NavigateTo(Nav.GetUriWithQueryParameter("tab", tabName), replace: true);
        }
        catch (Microsoft.AspNetCore.Components.NavigationException)
        {
            // Ignore expected exception during component disposal
        }
    }

    protected override async Task OnInitializedAsync()
    {
        var emp = await UserService.GetEmployeeAsync();
        var hasAccess = emp != null && (emp.IsAdmin || emp.HasPermission(AppPermissions.Admin.ManageSettings));

        if (!hasAccess)
        {
            Nav.NavigateTo("/", true);
            return;
        }

        Profile = Db.CompanyProfile.Get();
        _systemConfig = Db.SystemConfigs.Get();
        _initialSystemConfig = System.Text.Json.JsonSerializer.Deserialize<SystemConfig>(
            System.Text.Json.JsonSerializer.Serialize(_systemConfig)) ?? new();
        _primaryColor = Profile.PrimaryColor;
        _secondaryColor = Profile.SecondaryColor;
        RefreshTemplates();
        RefreshBackups();

        _availableLogDates = SystemLog.GetAvailableLogDates();
        if (_availableLogDates.Count > 0 && !_availableLogDates.Contains(_selectedLogDate))
        {
            _selectedLogDate = _availableLogDates.First();
        }
        else if (_availableLogDates.Count == 0)
        {
            _availableLogDates.Add(DateTime.Today);
        }
        await LoadLogsForDate(_selectedLogDate);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && Restored)
        {
            await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.RestoreCompleteDialog>("", new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
            
            if (CasdoorRestarted)
            {
                Snackbar.Add("Builtin Casdoor instance restarted.", Severity.Info);
            }

            var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                { "restored", null },
                { "casdoorRestarted", null }
            });
            Nav.NavigateTo(uri, forceLoad: false, replace: true);
        }
    }

    private async Task TriggerManualUpdate()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Update Server?",
            $"Are you sure you want to update Spokes to v{ServerUpdateService.LatestVersion}?\n\nThe server will be temporarily unavailable for a few minutes while the update is applied.",
            yesText: "Update Now", cancelText: "Cancel");

        if (confirmed == true)
        {
            Snackbar.Add("Update triggered. The server will restart shortly.", Severity.Success);
            _ = ServerUpdateService.TriggerWatchtowerUpdateAsync();
        }
    }

    private void RefreshTemplates() => Templates = Db.DocumentTemplates.GetAll().OrderBy(t => t.Name).ToList();

    // --- Logs Logic ---
    private async Task OnLogDateChanged(DateTime newDate)
    {
        _selectedLogDate = newDate;
        await LoadLogsForDate(newDate);
    }

    private async Task OnLogDateChangedNullable(DateTime? date)
    {
        if (date.HasValue)
        {
            await OnLogDateChanged(date.Value);
        }
    }

    private string GetLogDateClasses(DateTime date)
    {
        if (_availableLogDates.Contains(date.Date))
            return "mud-border-primary border-2 mud-border-solid rounded-circle font-weight-bold";
        return string.Empty;
    }

    private async Task LoadLogsForDate(DateTime date)
    {
        _currentLogs = await SystemLog.GetLogsAsync(date);
        StateHasChanged();
    }

    private async Task CopyLogsToClipboard()
    {
        if (_currentLogs.Count == 0) return;
        var sb = new System.Text.StringBuilder();
        foreach (var log in _currentLogs)
        {
            sb.AppendLine($"[{log.TimestampUtc:yyyy-MM-dd HH:mm:ss}] [{log.Severity.ToUpper()}] [{log.Category}] {log.Message}");
            if (!string.IsNullOrEmpty(log.Details))
            {
                sb.AppendLine(log.Details);
            }
        }
        await JS.InvokeVoidAsync("navigator.clipboard.writeText", sb.ToString());
        Snackbar.Add("Logs copied to clipboard.", Severity.Success);
    }

    // --- Backup Logic ---
    [Inject] private BackupService BackupSvc { get; set; } = default!;
    private List<BackupFileInfo> _backupFiles = new();
    private bool _isBackingUp;

    private void RefreshBackups() => _backupFiles = BackupSvc.GetBackups();

    private async Task RunBackupNow()
    {
        _isBackingUp = true;
        StateHasChanged();
        try
        {
            await BackupSvc.RunBackupNow();
            RefreshBackups();
            Snackbar.Add("Backup created successfully", Severity.Success);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"Backup failed: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBackingUp = false;
        }
    }

    private async Task DownloadBackup(BackupFileInfo backup)
    {
        var url = $"/spokesapi/backups/{Uri.EscapeDataString(backup.FileName)}";
        await JS.InvokeVoidAsync("open", url, "_blank");
    }

    private async Task DeleteBackup(BackupFileInfo backup)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete Backup",
            $"Are you sure you want to delete {backup.FileName}?",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            BackupSvc.DeleteBackup(backup.FilePath);
            RefreshBackups();
            Snackbar.Add("Backup deleted", Severity.Info);
        }
    }



    private async Task RestoreBackup(BackupFileInfo backup)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Restore Backup?",
            $"Are you sure you want to restore {backup.FileName}?\n\nWARNING: All data created since this backup will be PERMANENTLY LOST.",
            yesText: "RESTORE", cancelText: "Cancel");

        if (confirmed == true)
        {
            try 
            {
                bool casdoorRestarted = Db.RestoreBackup(backup.FilePath, Logger);
                Snackbar.Add("System restored successfully!", Severity.Success);
                
                var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
                {
                    { "restored", true },
                    { "casdoorRestarted", casdoorRestarted ? true : null }
                });
                Nav.NavigateTo(uri, forceLoad: true);
            }
            catch(Exception ex)
            {
                Snackbar.Add($"Restore failed: {ex.Message}", Severity.Error);
            }
        }
    }

    private async Task UploadAndRestoreBackup(IBrowserFile file)
    {
        var parameters = new DialogParameters { ["File"] = file };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.RestoreBackupDialog>("", parameters, new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, BackdropClick = false });
        
        var result = await dialog.Result;
        if (result != null && !result.Canceled)
        {
            bool casdoorRestarted = (bool)(result.Data ?? false);
            var uri = Nav.GetUriWithQueryParameters(new Dictionary<string, object?>
            {
                { "restored", true },
                { "casdoorRestarted", casdoorRestarted ? true : null }
            });
            Nav.NavigateTo(uri, forceLoad: true);
        }
    }

    private async Task SaveProfile()
    {
        Profile.PrimaryColor = _primaryColor;
        Profile.SecondaryColor = _secondaryColor;
        Db.CompanyProfile.Save(Profile);
        
        // Sync branding to Casdoor
        _ = CasdoorProvisioning.SyncBrandingAsync();

        Snackbar.Add("Company Profile Saved", Severity.Success);
    }

    // --- Permission Group Logic ---

    private async Task AddPermissionGroup()
    {
        var group = new PermissionGroup { Name = "New Group" };
        var parameters = new DialogParameters { ["Group"] = group };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.PermissionGroupDialog>("Create Permission Group", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PermissionGroup newGroup)
        {
            Profile.PermissionGroups.Add(newGroup);
            await SaveProfile();
        }
    }

    private async Task EditPermissionGroup(PermissionGroup group)
    {
        var parameters = new DialogParameters { ["Group"] = group };
        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Dialogs.PermissionGroupDialog>("Edit Permission Group", parameters, new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true });
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is PermissionGroup updatedGroup)
        {
            var index = Profile.PermissionGroups.FindIndex(g => g.Id == updatedGroup.Id);
            if (index != -1)
            {
                Profile.PermissionGroups[index] = updatedGroup;
            }
            await SaveProfile();
        }
    }

    private async Task RemovePermissionGroup(PermissionGroup group)
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Delete Permission Group",
            $"Are you sure you want to delete {group.Name}? Users currently having these permissions will not lose them, but this group will no longer be available for new users.",
            yesText: "Delete", cancelText: "Cancel");
        if (confirmed == true)
        {
            Profile.PermissionGroups.Remove(group);
            if (Profile.DefaultPermissionGroupId == group.Id)
            {
                Profile.DefaultPermissionGroupId = string.Empty;
            }
            await SaveProfile();
        }
    }

    private async Task LoadBusinessDefaults()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Load Business Defaults",
            "This will append the default Business Edition permission groups to your list. Proceed?",
            yesText: "Load", cancelText: "Cancel");
        if (confirmed == true)
        {
            Profile.PermissionGroups.AddRange(DefaultPermissionGroups.GetBusinessDefaults());
            await SaveProfile();
        }
    }

    private async Task LoadFriendDefaults()
    {
        var confirmed = await DialogService.ShowMessageBoxAsync("Load Friend Defaults",
            "This will append the default Friend Edition permission groups to your list. Proceed?",
            yesText: "Load", cancelText: "Cancel");
        if (confirmed == true)
        {
            Profile.PermissionGroups.AddRange(DefaultPermissionGroups.GetFriendDefaults());
            await SaveProfile();
        }
    }

    [Inject] private Spokes_Server.Core.Services.Core.IFileService FileService { get; set; } = default!;

    private void HandleLogoUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        
        var result = results.First();
        var parts = result.FilePath.Substring("/spokesapi/files/".Length).Split('/');
        if (parts.Length != 3) return;
        var fullPath = FileService.GetPhysicalPath(parts[0], parts[1], parts[2]);
        
        if (File.Exists(fullPath))
        {
            try
            {
                var bytes = File.ReadAllBytes(fullPath);
                var base64 = Convert.ToBase64String(bytes);
                var format = result.FileName?.EndsWith("png", StringComparison.OrdinalIgnoreCase) == true ? "png" : "jpeg";
                Profile.LogoBase64 = $"data:image/{format};base64,{base64}";
                FileService.CleanTempContext(parts[1]);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error processing logo: {ex.Message}", Severity.Error);
                FileService.CleanTempContext(parts[1]);
            }
        }
    }

    private void HandleIconUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        
        var result = results.First();
        var parts = result.FilePath.Substring("/spokesapi/files/".Length).Split('/');
        if (parts.Length != 3) return;
        var fullPath = FileService.GetPhysicalPath(parts[0], parts[1], parts[2]);
        
        if (File.Exists(fullPath))
        {
            try
            {
                var bytes = File.ReadAllBytes(fullPath);
                var base64 = Convert.ToBase64String(bytes);
                var format = result.FileName?.EndsWith("png", StringComparison.OrdinalIgnoreCase) == true ? "png" : 
                            result.FileName?.EndsWith("ico", StringComparison.OrdinalIgnoreCase) == true ? "x-icon" : "jpeg";
                Profile.IconBase64 = $"data:image/{format};base64,{base64}";
                FileService.CleanTempContext(parts[1]);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Error processing icon: {ex.Message}", Severity.Error);
                FileService.CleanTempContext(parts[1]);
            }
        }
    }

    // --- Template Logic ---


    private async Task CreateTemplate()
    {
        var t = new DocumentTemplate { Name = "New Template" };
        await EditTemplate(t);
    }

    private async Task EditTemplate(DocumentTemplate t)
    {
        // Use the dedicated Template Editor Dialog
        var parameters = new DialogParameters { ["Template"] = t };
        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };

        var dialog = await DialogService.ShowAsync<Spokes_Server.Components.Pages.Admin.TemplateEditorDialog>("Edit Template",
        parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is DocumentTemplate updated)
        {

            // If this is set to default, unset others
            if (updated.IsDefault)
            {
                foreach (var other in Templates.Where(x => x.Id != updated.Id && x.IsDefault))
                {
                    other.IsDefault = false;
                    Db.DocumentTemplates.Save(other);
                }
            }

            Db.DocumentTemplates.Save(updated);
            RefreshTemplates();
        }
    }

    private void DeleteTemplate(DocumentTemplate t)
    {
        Db.DocumentTemplates.Delete(t.Id);
        RefreshTemplates();
    }

    private async Task ExportTemplate(DocumentTemplate t)
    {
        var json = System.Text.Json.JsonSerializer.Serialize(t, new System.Text.Json.JsonSerializerOptions
            {
                WriteIndented = true
            });
        var fileName = $"{t.Name.Replace(" ", "_")}_Template.json";
        await JS.InvokeVoidAsync("downloadFile", fileName, "application/json", json);
    }

    private void HandleTemplateUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        
        var result = results.First();
        var parts = result.FilePath.Substring("/spokesapi/files/".Length).Split('/');
        if (parts.Length != 3) return;
        var fullPath = FileService.GetPhysicalPath(parts[0], parts[1], parts[2]);
        
        if (File.Exists(fullPath))
        {
            try
            {
                var json = File.ReadAllText(fullPath);
                var t = System.Text.Json.JsonSerializer.Deserialize<DocumentTemplate>(json);

                if (t != null)
                {
                    t.Id = Guid.NewGuid().ToString(); // Ensure new ID
                    t.Name += " (Imported)";
                    t.IsDefault = false; // Prevent accidental default override
                    Db.DocumentTemplates.Save(t);
                    RefreshTemplates();
                    Snackbar.Add("Template Imported", Severity.Success);
                }
                
                FileService.CleanTempContext(parts[1]);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Import Failed: {ex.Message}", Severity.Error);
                FileService.CleanTempContext(parts[1]);
            }
        }
    }

    private void HandleLicenseUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        
        var result = results.First();
        var parts = result.FilePath.Substring("/spokesapi/files/".Length).Split('/');
        if (parts.Length != 3) return;
        var fullPath = FileService.GetPhysicalPath(parts[0], parts[1], parts[2]);
        
        if (File.Exists(fullPath))
        {
            try
            {
                var json = File.ReadAllText(fullPath);
                var config = Db.ServerConfigs.GetOrCreateGlobalConfig();
                var validationResult = LicenseService.ValidateLicense(json, config);

                if (validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid || validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Tolerated)
                {
                    if (validationResult.ParsedLicense != null)
                    {
                        Profile.LicensePayload = json;
                        
                        var newEditions = Spokes_Server.Core.Services.Licensing.LicenseValidationService.GetAvailableEditions(validationResult);
                        if (!newEditions.Contains(Profile.Edition))
                        {
                            Profile.Edition = newEditions.FirstOrDefault() ?? "Family";
                        }
                        
                        Db.CompanyProfile.Save(Profile);
                        Snackbar.Add("License Validated & Saved Successfully!", Severity.Success);
                        
                        // Force a reload so MainLayout picks up the new status
                        Nav.NavigateTo(Nav.Uri, forceLoad: true);
                    }
                    else
                    {
                        Snackbar.Add("License is valid but could not be parsed.", Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add($"Invalid License: {validationResult.Message}", Severity.Error);
                }
                
                FileService.CleanTempContext(parts[1]);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Upload Failed: {ex.Message}", Severity.Error);
                FileService.CleanTempContext(parts[1]);
            }
        }
    }

