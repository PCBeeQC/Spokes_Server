@page "/admin/settings"
@implements IDisposable
<PageTitle>Company Settings</PageTitle>
@using Spokes_Server.Core.Models
@using Spokes_Server.Core.Data
@using MudBlazor
@inject Database Db
@inject ISnackbar Snackbar
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@inject NavigationManager Nav
@inject Microsoft.Extensions.Hosting.IHostApplicationLifetime AppLifetime
@inject ILogger<CompanySettings> Logger
@inject Microsoft.Extensions.Configuration.IConfiguration Config
@inject Spokes_Server.Core.Services.Licensing.LicenseValidationService LicenseValidationService
@inject Spokes_Server.Core.Services.Core.AppLabelService AppLabels
@inject Spokes_Server.Core.Services.Core.ServerUpdateService ServerUpdateService
@inject Spokes_Server.Core.Services.Communication.Voice.LiveKitService LiveKitService
@using Microsoft.AspNetCore.Components.Authorization
@using System.Security.Claims
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Core



    <MudContainer MaxWidth="MaxWidth.Large" Class="pa-2">
    <MudText Typo="Typo.h4" GutterBottom="true">@AppLabels.Company Settings</MudText>
    <div class="mb-6">
        <MudMenu Label="@GetActiveTabName()" StartIcon="@GetActiveTabIcon()" EndIcon="@Icons.Material.Filled.KeyboardArrowDown" Variant="Variant.Outlined" Color="Color.Default" FullWidth="true" AnchorOrigin="Origin.BottomCenter" TransformOrigin="Origin.TopCenter" MaxHeight="800">
            <MudMenuItem OnClick="@(() => UpdateActiveTab(0))" Icon="@Icons.Material.Filled.Business">@AppLabels.Company Profile</MudMenuItem>
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(1))" Icon="@Icons.Material.Filled.Description">Document Templates</MudMenuItem>
            }
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(2))" Icon="@Icons.Material.Filled.Palette">Project Statuses</MudMenuItem>
            }
            <MudMenuItem OnClick="@(() => UpdateActiveTab(3))" Icon="@Icons.Material.Filled.Category">Calendar Categories</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(4))" Icon="@Icons.Material.Filled.Backup">Backups & Restore</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(5))" Icon="@Icons.Material.Filled.Security">Permission Groups</MudMenuItem>
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(6))" Icon="@Icons.Material.Filled.Email">Email Server</MudMenuItem>
            }
            <MudMenuItem OnClick="@(() => UpdateActiveTab(7))" Icon="@Icons.Material.Filled.Chat">Chat Settings</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(8))" Icon="@Icons.Material.Filled.SettingsApplications">System Setup</MudMenuItem>
            <MudMenuItem OnClick="@(() => UpdateActiveTab(9))" Icon="@Icons.Material.Filled.Terminal">Server Logs</MudMenuItem>
            @if (!IsFriendEdition)
            {
                <MudMenuItem OnClick="@(() => UpdateActiveTab(10))" Icon="@Icons.Material.Filled.Schedule">Timesheets</MudMenuItem>
            }
        </MudMenu>
    </div>

    @if (activeTabIndex == 0)
    {
        <MudGrid>
            @if (ServerUpdateService.IsUpdateAvailable)
            {
                <MudItem xs="12">
                    @{
                        var valResult = LicenseValidationService.ValidateLicense(Profile.LicensePayload, Db.ServerConfigs.GetOrCreateGlobalConfig());
                        string maxVer = valResult.MaxAllowedVersion ?? "";
                        bool latestExceedsAllowed = false;

                        if (Version.TryParse(ServerUpdateService.LatestVersion?.TrimStart('v'), out Version? lv) && 
                            Version.TryParse(maxVer.TrimStart('v'), out Version? mv))
                        {
                            latestExceedsAllowed = lv > mv;
                        }

                        if (latestExceedsAllowed)
                        {
                            bool isDemo = string.IsNullOrEmpty(Profile.LicensePayload);
                            <MudAlert Severity="Severity.Error" Variant="Variant.Filled" Class="mb-2" Icon="@Icons.Material.Filled.Warning">
                                @if (isDemo)
                                {
                                    <MudText Typo="Typo.body2">Updating to the latest version will lock up your server. Your demo server does not allow updates pass <b>@maxVer</b>. You can either stay on <b>@maxVer</b> for as long as you like or you can purchase a license at <MudLink Href="https://www.spokes.sh" Target="_blank" Style="color: white; text-decoration: underline;"><b>www.spokes.sh</b></MudLink>.</MudText>
                                }
                                else
                                {
                                    <MudText Typo="Typo.body2">Updating to the latest version will lock up your server. Your current license does not allow updates pass <b>@maxVer</b>. You can either stay on <b>@maxVer</b> for as long as you like or you can purchase a new license at <MudLink Href="https://www.spokes.sh" Target="_blank" Style="color: white; text-decoration: underline;"><b>www.spokes.sh</b></MudLink>.</MudText>
                                }
                            </MudAlert>
                        }
                        else
                        {
                            <MudAlert Severity="Severity.Info" Variant="Variant.Filled" Class="mb-2">
                                <div class="d-flex align-center justify-space-between" style="width: 100%;">
                                    <MudText Typo="Typo.body2">A new server update is available: <b>v@(ServerUpdateService.LatestVersion)</b>. Your current version is <b>@(ServerUpdateService.CurrentVersion)</b>.</MudText>
                                    @if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("WATCHTOWER_HTTP_API_TOKEN")))
                                    {
                                        <MudButton Variant="Variant.Filled" Color="Color.Surface" Size="Size.Small" OnClick="TriggerManualUpdate">Update Now</MudButton>
                                    }
                                </div>
                            </MudAlert>
                        }
                    }
                </MudItem>
            }
            <MudItem xs="12" sm="4" Class="d-flex flex-column align-center">
                @if (!string.IsNullOrEmpty(Profile.LogoBase64))
                {
                        <MudImage Src="@Profile.LogoBase64" Alt="Logo" Height="100" Class="mb-4"
                            ObjectFit="ObjectFit.Contain" />
                }
                else
                {
                        <MudPaper Class="d-flex align-center justify-center mb-4" Width="150px" Height="150px" Outlined="true">
                            <MudText>No Logo</MudText>
                        </MudPaper>
                }

                <div class="d-inline-flex">
                    <ApiFileUpload 
                        Category="temp" 
                        ContextId="@Guid.NewGuid().ToString()" 
                        OnUploadCompleted="HandleLogoUploaded">
                        <CustomContent>
                            <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                Upload Logo
                            </MudButton>
                        </CustomContent>
                    </ApiFileUpload>
                </div>

                <MudDivider Class="my-4" />

                @if (!string.IsNullOrEmpty(Profile.IconBase64))
                {
                        <MudImage Src="@Profile.IconBase64" Alt="Icon" Height="50" Class="mb-4" ObjectFit="ObjectFit.Contain" />
                }
                else
                {
                        <MudPaper Class="d-flex align-center justify-center mb-4" Width="50px" Height="50px" Outlined="true">
                            <MudText Typo="Typo.caption">No Icon</MudText>
                        </MudPaper>
                }

                <div class="d-inline-flex">
                    <ApiFileUpload 
                        Category="temp" 
                        ContextId="@Guid.NewGuid().ToString()" 
                        OnUploadCompleted="HandleIconUploaded">
                        <CustomContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.CloudUpload">
                                Upload Icon
                            </MudButton>
                        </CustomContent>
                    </ApiFileUpload>
                </div>
            </MudItem>

            <MudItem xs="12" sm="8">
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.CompanyName" Label="@($"{AppLabels.Company} Name")" Required="true" />
                <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.PrivacyPolicyUrl" Label="Privacy Policy URL" HelperText="This URL will be shown to users in their Settings to comply with App Store guidelines." />
                @if (!IsFriendEdition)
                {
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.Website" Label="Website" />
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.PhoneNumber" Label="Phone" />
                    <MudColorPicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Label="Primary Brand Color" @bind-Text="_primaryColor" Style="width: 100%;" />
                    <MudColorPicker Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Label="Secondary Brand Color" @bind-Text="_secondaryColor" Style="width: 100%;" />
                }
            </MudItem>

            <MudItem xs="12" sm="12">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1">File Uploads</MudText>
            </MudItem>
            <MudItem xs="12" sm="12" Class="mt-n4">
                <MudNumericField ShrinkLabel="true" Value="@(Profile.MaxFileUploadSizeBytes / 1024 / 1024)" ValueChanged="@((long v) => Profile.MaxFileUploadSizeBytes = v * 1024 * 1024)" Label="Max Upload Size (MB)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="1" Max="2048" HelperText="Maximum allowed size per file (requires server restart to fully apply to Kestrel)" />
            </MudItem>

            @if (!IsFriendEdition)
            {
                <MudItem xs="12">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.h6">Document Numbering</MudText>
                </MudItem>
                <MudItem xs="6" Class="mt-n4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.QuotePrefix" Label="Quote Prefix" HelperText="e.g. Q-001" />
                </MudItem>
                <MudItem xs="6" Class="mt-n4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.InvoicePrefix" Label="Invoice Prefix" HelperText="e.g. INV-001" />
                </MudItem>

                <MudItem xs="12" Class="mt-n2">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.h6">Financial Defaults</MudText>
                </MudItem>
                <MudItem xs="12" sm="4" Class="mt-n4">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.KilometrageRate" Label="Kilometrage Rate ($/km)" Format="N2"
                                     Adornment="Adornment.Start" AdornmentIcon="@Icons.Material.Filled.AttachMoney" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="mt-n4">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.DefaultInternalCommission" Label="Default Internal Commission (%)"
                                     Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="mt-n4">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.DefaultExternalCommission" Label="Default External Commission (%)"
                                     Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudNumericField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" Value="@(Profile.DefaultTaxRate * 100)"
                                     ValueChanged="@((decimal v) => Profile.DefaultTaxRate = v / 100)" Label="Default Tax Rate (%)"
                                     Format="N3" Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.Percent" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.CurrencySymbol" Label="Currency Symbol" HelperText="e.g. $, £, " />
                </MudItem>
                <MudItem xs="12">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" 
                                  Value='@(string.Join(", ", Profile.SupportedCurrencies))'
                                  ValueChanged="@((string v) => Profile.SupportedCurrencies = v.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries).Select(w => w.Trim()).ToList())"
                                  Label="Supported Currencies" HelperText="Enter currency codes separated by commas (e.g. CAD, USD, EUR)" />
                </MudItem>


                <MudItem xs="12" Class="mt-n2">
                    <MudDivider Class="my-2" />
                    <MudText Typo="Typo.h6">Address</MudText>
                </MudItem>
                <MudItem xs="12" sm="8" Class="mt-n4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressStreet" Label="Street Address" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="mt-n4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressZip" Label="Zip/Postal" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressCity" Label="City" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressState" Label="State/Province" />
                </MudItem>
                <MudItem xs="12" sm="4">
                    <MudTextField Variant="Variant.Outlined" Margin="Margin.Dense" ShrinkLabel="true" @bind-Value="Profile.AddressCountry" Label="Country" />
                </MudItem>
            }
            



            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProfile">Save Profile</MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (activeTabIndex == 1)
    {
        <MudText Typo="Typo.body2" Class="mb-4">Create templates for different languages (e.g. French Invoice, English
            PO).</MudText>

        <MudButton StartIcon="@Icons.Material.Filled.Add" Variant="Variant.Filled" Color="Color.Primary"
            OnClick="CreateTemplate">New Template</MudButton>

        <div class="d-inline-flex ml-4">
            <ApiFileUpload 
                Category="temp" 
                ContextId="@Guid.NewGuid().ToString()" 
                OnUploadCompleted="HandleTemplateUploaded">
                <CustomContent>
                    <MudButton Variant="Variant.Outlined" Color="Color.Secondary" StartIcon="@Icons.Material.Filled.UploadFile">
                        Import
                    </MudButton>
                </CustomContent>
            </ApiFileUpload>
        </div>

        <MudTable Items="@Templates" Breakpoint="Breakpoint.None" Hover="true" Elevation="0" Outlined="true" Bordered="true" Striped="true" Class="mt-4">
            <HeaderContent>
                <MudTh Style="min-width: 250px;">Name</MudTh>
                <MudTh Style="min-width: 150px;">Language</MudTh>
                <MudTh Style="width: 100px;">Default</MudTh>
                <MudTh Style="width: 160px;">Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd>@context.Name</MudTd>
                <MudTd>@context.LanguageCode.ToUpper()</MudTd>
                <MudTd>
                    @if (context.IsDefault)
                    {
                            <MudIcon Icon="@Icons.Material.Filled.Check" Color="Color.Success" />
                    }
                </MudTd>
                <MudTd>
                    <MudIconButton Icon="@Icons.Material.Filled.Edit" OnClick="@(() => EditTemplate(context))" />
                    <MudIconButton Icon="@Icons.Material.Filled.Download" Color="Color.Info" Title="Export JSON"
                        OnClick="@(() => ExportTemplate(context))" />
                    @if (!context.IsDefault)
                    {
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                OnClick="@(() => DeleteTemplate(context))" />
                    }
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
    else if (activeTabIndex == 2)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mb-4">Configure the statuses available for projects and their display
                    colors.</MudText>
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudTable Items="@Profile.ProjectStatuses" Breakpoint="Breakpoint.None" Hover="true" Dense="true" Outlined="true" Bordered="true" Striped="true" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="min-width: 220px;">Status Name</MudTh>
                        <MudTh Style="min-width: 150px;">Color</MudTh>
                        <MudTh Style="min-width: 150px;">System Mapping</MudTh>
                        <MudTh Style="width: 120px;">Preview</MudTh>
                        <MudTh Style="width: 80px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.Name" Label="Name" Margin="Margin.Dense"
                                Required="true" />
                        </MudTd>
                        <MudTd>
                            <MudSelect ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.Color" Label="Color" Dense="true" Margin="Margin.Dense"
                                Style="width: 150px;">
                                @foreach (var colorName in Enum.GetNames(typeof(Color)))
                                {
                                        <MudSelectItem Value="@colorName">@colorName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            <MudSelect ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.SystemMapping" Label="System Type" Dense="true" Margin="Margin.Dense"
                                Style="width: 150px;">
                                @foreach (var type in SystemStatusMappings.All)
                                {
                                        <MudSelectItem Value="@type">@type</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            @{
                                Color chipColor = Color.Default;
                                Enum.TryParse(context.Color, out chipColor);
                            }
                            <MudChip T="string" Color="@chipColor" Size="Size.Small">@context.Name</MudChip>
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                OnClick="@(() => RemoveStatus(context))" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="5">
                            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddStatus" Color="Color.Primary">
                                Add Status</MudButton>
                        </MudTd>
                    </FooterContent>
                </MudTable>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProfile">Save Settings
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (activeTabIndex == 3)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.body2" Class="mb-4">Configure categories for calendar events and their display
                    colors.</MudText>
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudTable Items="@Profile.CalendarCategories" Breakpoint="Breakpoint.None" Dense="true" Elevation="0" Outlined="true" Bordered="true">
                    <HeaderContent>
                        <MudTh Style="min-width: 220px;">Category Name</MudTh>
                        <MudTh Style="min-width: 150px;">Color</MudTh>
                        <MudTh Style="width: 120px;">Preview</MudTh>
                        <MudTh Style="width: 80px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>
                            <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="context.Name" Label="Name"
                                Required="true" />
                        </MudTd>
                        <MudTd>
                            <MudSelect ShrinkLabel="true" Variant="Variant.Outlined" @bind-Value="context.Color" Label="Color" Dense="true" Margin="Margin.Dense"
                                Style="width: 150px;">
                                @foreach (var colorName in Enum.GetNames(typeof(Color)))
                                {
                                        <MudSelectItem Value="@colorName">@colorName</MudSelectItem>
                                }
                            </MudSelect>
                        </MudTd>
                        <MudTd>
                            @{
                                Color chipColor = Color.Default;
                                Enum.TryParse(context.Color, out chipColor);
                            }
                            <MudChip T="string" Color="@chipColor" Size="Size.Small">@context.Name</MudChip>
                        </MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small"
                                OnClick="@(() => RemoveCategory(context))" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="4">
                            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddCategory"
                                Color="Color.Primary">Add Category</MudButton>
                        </MudTd>
                    </FooterContent>
                </MudTable>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProfile">Save Settings
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (activeTabIndex == 4)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6" GutterBottom="true">Automated Backups</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    Configure automatic backups of your Spokes data. Backups are stored as ZIP files in your data directory.
                </MudText>
            </MudItem>

            <MudItem xs="12" sm="12" Class="mt-n4">
                <MudSwitch @bind-Value="Profile.BackupsEnabled" Color="Color.Primary" Label="Enable Automatic Backups" />
            </MudItem>

            <MudItem xs="12" sm="6" Class="mt-n4">
                <MudNumericField ShrinkLabel="true" @bind-Value="Profile.BackupRetentionCount" Margin="Margin.Dense" Label="Backups to Keep" Min="1" Max="100"
                    Variant="Variant.Outlined" HelperText="Older backups are automatically deleted" />
            </MudItem>

            <MudItem xs="12" sm="6" Class="mt-n4">
                <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.BackupTimeLocal" Label="Scheduled Time (Local)"
                    HelperText="24-hour format, e.g. 03:00" />
            </MudItem>

            @if (!IsFriendEdition)
            {
                <MudItem xs="12" sm="12" Class="mt-n4">
                    <MudSwitch @bind-Value="Profile.BackupEmployeeEmails" Color="Color.Primary" Label="Include Employee Emails in Backup" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudDivider />
            </MudItem>

            <MudItem xs="12">
                <div class="d-flex align-center gap-4 mb-2">
                    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Backup"
                        OnClick="RunBackupNow" Disabled="@_isBackingUp">
                        @if (_isBackingUp)
                        {
                                <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                <span>Creating Backup...</span>
                        }
                        else
                        {
                                <span>Backup Now</span>
                        }
                    </MudButton>

                    @if (BackupSvc.LastBackupAt.HasValue)
                    {
                            <MudText Typo="Typo.caption" Color="Color.Secondary">
                                Last backup: @BackupSvc.LastBackupAt.Value.ToLocalTime().ToString("g") � @BackupSvc.LastBackupStatus
                            </MudText>
                    }
                </div>
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudText Typo="Typo.h6" GutterBottom="true">Restore Backup</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Upload a backup file (.zip) to restore the system state. <br />
                    <b>WARNING:</b> Restoring a backup will overwrite all current data.
                </MudText>
                
                <MudFileUpload T="IBrowserFile" Accept=".zip" FilesChanged="UploadAndRestoreBackup">
                    <CustomContent>
                        <MudButton Variant="Variant.Outlined" Color="Color.Warning" OnClick="@context.OpenFilePickerAsync" 
                            StartIcon="@Icons.Material.Filled.RestorePage">
                            Upload & Restore
                        </MudButton>
                    </CustomContent>
                        <SelectedTemplate></SelectedTemplate>
                </MudFileUpload>
            </MudItem>

            <MudItem xs="12">
                <MudText Typo="Typo.subtitle1" Class="mb-2"><b>Existing Backups</b></MudText>
                @if (_backupFiles.Any())
                {
                        <MudTable Items="@_backupFiles" Breakpoint="Breakpoint.None" Dense="true" Hover="true" Elevation="0" Bordered="true" Outlined="true">
                            <HeaderContent>
                                <MudTh Style="min-width: 200px;">File</MudTh>
                                <MudTh Style="width: 100px;">Size</MudTh>
                                <MudTh Style="width: 100px;">Type</MudTh>
                                <MudTh Style="min-width: 150px;">Created</MudTh>
                                <MudTh Style="width:160px">Actions</MudTh>
                            </HeaderContent>
                            <RowTemplate>
                                <MudTd>@context.FileName</MudTd>
                                <MudTd>@context.FormattedSize</MudTd>
                                <MudTd DataLabel="Type">
                                    @if (context.IsManual)
                                    {
                                        <MudChip T="string" Color="Color.Info" Size="Size.Small">Manual</MudChip>
                                    }
                                    else
                                    {
                                        <MudChip T="string" Color="Color.Success" Size="Size.Small">Auto</MudChip>
                                    }
                                </MudTd>
                                <MudTd>@context.CreatedAt.ToLocalTime().ToString("g")</MudTd>
                                <MudTd>
                                    <MudIconButton Icon="@Icons.Material.Filled.Download" Size="Size.Small"
                                        OnClick="@(() => DownloadBackup(context))" Title="Download" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Restore" Size="Size.Small" Color="Color.Warning"
                                        OnClick="@(() => RestoreBackup(context))" Title="Restore" />
                                    <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Small" Color="Color.Error"
                                        OnClick="@(() => DeleteBackup(context))" Title="Delete" />
                                </MudTd>
                            </RowTemplate>
                        </MudTable>
                }
                else
                {
                        <MudText Typo="Typo.body2" Color="Color.Secondary">No backups found.</MudText>
                }
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProfile">Save Settings
                </MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (activeTabIndex == 6)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6">Global Email Configuration</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Configure the IMAP and SMTP server settings used by all employees.
                    Individual usernames and passwords will be set in each employee's profile.
                </MudText>
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudDivider Class="my-2"/>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">Incoming Mail (IMAP)</MudText>
            </MudItem>
            <MudItem xs="12" sm="8" Class="mt-n2">
                <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.EmailSettings.ImapHost" Label="IMAP Host" HelperText="e.g. imap.gmail.com"/>
            </MudItem>
            <MudItem xs="12" sm="4" Class="mt-n2">
                <MudNumericField ShrinkLabel="true" @bind-Value="Profile.EmailSettings.ImapPort" Margin="Margin.Dense" Label="Port" Variant="Variant.Outlined" HelperText="e.g. 993"/>
            </MudItem>
            <MudItem xs="12" Class="mt-n4">
                <MudCheckBox @bind-Value="Profile.EmailSettings.ImapSsl" Label="Use SSL/TLS" Color="Color.Primary"/>
            </MudItem>

            

            <MudItem xs="12" Class="mt-n4">
                <MudDivider Class="my-2"/>
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">Outgoing Mail (SMTP)</MudText>
            </MudItem>
            <MudItem xs="12" sm="8" Class="mt-n2">
                <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.EmailSettings.SmtpHost" Label="SMTP Host" HelperText="e.g. smtp.gmail.com"/>
            </MudItem>
            <MudItem xs="12" sm="4" Class="mt-n2">
                <MudNumericField ShrinkLabel="true" @bind-Value="Profile.EmailSettings.SmtpPort" Margin="Margin.Dense" Label="Port" HelperText="e.g. 465" Variant="Variant.Outlined" />
            </MudItem>
            <MudItem xs="12" Class="mt-n4">
                <MudCheckBox @bind-Value="Profile.EmailSettings.SmtpSsl" Label="Use SSL/TLS" Color="Color.Primary"/>
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1" Color="Color.Primary">Display Settings</MudText>
            </MudItem>
            <MudItem xs="12">
                <MudSelect ShrinkLabel="true" @bind-Value="Profile.TimeZoneId" Margin="Margin.Dense" Label="Server Time Zone" Variant="Variant.Outlined" HelperText="This time zone is used for displaying email dates and times">
                    <MudSelectItem Value="@string.Empty">Server Local Time</MudSelectItem>
                    @foreach (var tz in TimeZoneInfo.GetSystemTimeZones())
                    {
                        <MudSelectItem Value="@tz.Id">@tz.DisplayName</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-4">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveProfile">Save Settings</MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (activeTabIndex == 5)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6">Permission Groups Config</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Create roles and permission groups for your users. Select a default group for new users.
                </MudText>
            </MudItem>

            <MudItem xs="12" sm="6" Class="mt-n4">
                <MudSelect ShrinkLabel="true" @bind-Value="Profile.DefaultPermissionGroupId" Label="Default New User Role" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-4">
                    <MudSelectItem Value="@string.Empty">-- None (Chat Only) --</MudSelectItem>
                    @foreach (var g in Profile.PermissionGroups)
                    {
                        <MudSelectItem Value="@g.Id">@g.Name</MudSelectItem>
                    }
                </MudSelect>
            </MudItem>

            <MudItem xs="12" Class="d-flex gap-2 mt-n4">
                @if (!IsFriendEdition)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadBusinessDefaults">Load Business Edition Defaults</MudButton>
                }
                @if (IsFriendEdition)
                {
                    <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="LoadFriendDefaults">Load Friend Edition Defaults</MudButton>
                }
            </MudItem>

            <MudItem xs="12" Class="mt-2">
                <MudTable Items="@Profile.PermissionGroups" Breakpoint="Breakpoint.None" Hover="true" Dense="true" Outlined="true" Bordered="true" Elevation="0">
                    <HeaderContent>
                        <MudTh Style="min-width: 250px;">Group Name</MudTh>
                        <MudTh Style="min-width: 200px;">Permissions Count</MudTh>
                        <MudTh Style="width: 160px;">Actions</MudTh>
                    </HeaderContent>
                    <RowTemplate>
                        <MudTd>@context.Name</MudTd>
                        <MudTd>@context.Permissions.Count permission(s)</MudTd>
                        <MudTd>
                            <MudIconButton Icon="@Icons.Material.Filled.Edit" Color="Color.Info" Size="Size.Small" OnClick="@(() => EditPermissionGroup(context))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(() => RemovePermissionGroup(context))" />
                        </MudTd>
                    </RowTemplate>
                    <FooterContent>
                        <MudTd colspan="3">
                            <MudButton StartIcon="@Icons.Material.Filled.Add" OnClick="AddPermissionGroup" Color="Color.Primary">Add Group</MudButton>
                        </MudTd>
                    </FooterContent>
                </MudTable>
            </MudItem>

            <MudItem xs="12" Class="d-flex justify-end mt-4">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(async () => await SaveProfile())">Save Settings</MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (activeTabIndex == 7)
    {
        <MudGrid>
            <MudItem xs="12">
                <MudText Typo="Typo.h6">Chat Configurations</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Global settings for the Chat and Communication features.
                </MudText>
            </MudItem>
            
            <MudItem xs="12" Class="mt-n4">
                @if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("SPOKES_MASTER_PASSWORD")))
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4">
                        <b>Master Password Configured via Environment:</b> Public channel messages are securely escrowed.
                    </MudAlert>
                }
                else if (!string.IsNullOrEmpty(Profile.PublicChannelMasterPassword))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <b>Insecure Legacy Master Password Found:</b> Please copy this password and add it to your docker-compose.yml as `SPOKES_MASTER_PASSWORD` to secure your server. Restart the server after setting the variable.
                        <MudTextField Value="@Profile.PublicChannelMasterPassword" ReadOnly="true" Margin="Margin.Dense" Class="mt-2" />
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <b>Master Password Missing:</b> Set the `SPOKES_MASTER_PASSWORD` environment variable to enable Server-assisted message recovery for public channels.
                    </MudAlert>
                }
            </MudItem>
            <MudItem xs="12" Class="mt-n4">
                <MudSelect ShrinkLabel="true" @bind-Value="Profile.DefaultPublicChannelSubscription" Label="Default Public Channel Notifications (for new users)" Variant="Variant.Outlined" Margin="Margin.Dense" Class="mb-3">
                    <MudSelectItem Value="@("Mentions")">Mentions Only</MudSelectItem>
                    <MudSelectItem Value="@("All")">All Messages</MudSelectItem>
                </MudSelect>
            </MudItem>
            
            <MudItem xs="12" Class="mt-n4">
                <MudNumericField @bind-Value="Profile.MaxChatCacheSizeMb" Label="Max Global Chat Cache Size (MB)" Variant="Variant.Outlined" Margin="Margin.Dense" Min="10" Max="5000" Step="100" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">Limits the amount of RAM the server will allocate for caching chat messages globally. At least 500MB is recommended.</MudText>
            </MudItem>
            
            <MudItem xs="12" Class="mt-n2">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1">GIF Integration</MudText>
            </MudItem>
            <MudItem xs="12" sm="6" Class="mt-n4">
                <MudSelect ShrinkLabel="true" @bind-Value="Profile.GifProvider" Label="GIF Provider" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@("Spokes Default Provider")">Spokes Default Provider</MudSelectItem>
                    <MudSelectItem Value="@("Klipy")">Klipy</MudSelectItem>
                    <MudSelectItem Value="@("None")">None (Disabled)</MudSelectItem>
                </MudSelect>
            </MudItem>
            @if (Profile.GifProvider != "Spokes Default Provider")
            {
                <MudItem xs="12" sm="6" Class="mt-n4">
                    <MudTextField ShrinkLabel="true" @bind-Value="Profile.GifApiKey" Label="API Key" Variant="Variant.Outlined" Margin="Margin.Dense" />
                </MudItem>
            }

            

            <MudItem xs="12" Class="mt-n2">
                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1">Content Moderation</MudText>
            </MudItem>
            <MudItem xs="12" sm="12" Class="mt-n4">
                <MudSwitch @bind-Value="Profile.Moderation.EnableTextFilter" Color="Color.Primary" Label="Enable Text Moderation Filter" />
            </MudItem>
            @if (Profile.Moderation.EnableTextFilter)
            {
                <MudItem xs="12" sm="6" Class="mt-n4">
                    <MudSelect ShrinkLabel="true" @bind-Value="Profile.Moderation.TextAction" Label="Action on Violation" Variant="Variant.Outlined" Margin="Margin.Dense">
                        <MudSelectItem Value="TextModerationAction.Block">Block Message</MudSelectItem>
                        <MudSelectItem Value="TextModerationAction.Sanitize">Sanitize Message (replace with ***)</MudSelectItem>
                    </MudSelect>
                </MudItem>
                <MudItem xs="12" Class="mt-2">
                    <MudText Typo="Typo.subtitle2">Blocked Words</MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary">Enter words to block, separated by commas.</MudText>
                    <MudTextField Lines="3" Variant="Variant.Outlined" Margin="Margin.Dense"
                                  Value='@(string.Join(", ", Profile.Moderation.BlockedWords))'
                                  ValueChanged="@((string v) => Profile.Moderation.BlockedWords = v.Split(new[] { ',', '\n' }, StringSplitOptions.RemoveEmptyEntries).Select(w => w.Trim()).ToList())"
                                  Placeholder="e.g. badword, awfulword" />
                </MudItem>
            }

            <MudItem xs="12" Class="d-flex justify-end mt-2">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="@(async () => await SaveProfile())">Save Settings</MudButton>
            </MudItem>
        </MudGrid>
    }
    else if (activeTabIndex == 8)
    {
        <MudGrid>
            
            <MudItem xs="12" Class="mt-n2">
                <MudText Typo="Typo.h5">Licensing & Telemetry</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Manage your Spokes software license and usage statistics preferences.
                </MudText>
            </MudItem>

            @if (GetAvailableEditions().Count > 1)
            {
                <MudItem xs="12" Class="mt-n8">
                    <MudSelect ShrinkLabel="true" @bind-Value="Profile.Edition" Label="Active Edition" Variant="Variant.Outlined" Margin="Margin.Dense">
                        @foreach (var edition in GetAvailableEditions())
                        {
                            <MudSelectItem Value="@edition">@edition Edition</MudSelectItem>
                        }
                    </MudSelect>
                </MudItem>
            }

            <MudItem xs="12" Class="mt-n4">
                @if (string.IsNullOrEmpty(Profile.LicensePayload))
                {
                    <MudAlert Severity="Severity.Warning" Class="mb-4">
                        <b>No License Found:</b> Spokes requires a valid license to receive updates.
                        <br/>
                        Maximum allowed server version for this Demo: <b>@(Spokes_Server.Core.Services.Licensing.LicenseValidationService.CalculateMaxAllowedVersion(Db.ServerConfigs.GetOrCreateGlobalConfig().DatabaseCreationVersion))</b>
                        <br/>
                        <MudText Typo="Typo.caption">Updating the application beyond this version will cause the system to lock up until a valid license is uploaded, or the server version is reverted to the allowed version.</MudText>
                    </MudAlert>
                }
                else
                {
                    <MudAlert Severity="Severity.Success" Class="mb-4">
                        <b>License Active:</b> Your Spokes instance is licensed.
                    </MudAlert>

                    Spokes_Server.Core.Services.Licensing.SpokesLicenseFile? license = null;
                    try 
                    { 
                        var options = new System.Text.Json.JsonSerializerOptions { PropertyNameCaseInsensitive = true };
                        license = System.Text.Json.JsonSerializer.Deserialize<Spokes_Server.Core.Services.Licensing.SpokesLicenseFile>(Profile.LicensePayload, options); 
                    } 
                    catch { }
                    
                    if (license != null)
                    {
                        <MudPaper Class="pa-4 mb-4" Elevation="1">
                            <MudText Typo="Typo.subtitle2" Class="mb-2">License Details</MudText>
                            <MudGrid>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Registered Email</MudText>
                                    <MudText Typo="Typo.body2">@license.Email</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Updates Expiry Date</MudText>
                                    <MudText Typo="Typo.body2">@license.ValidForUpdatesUntil.ToString("yyyy-MM-dd")</MudText>
                                </MudItem>
                                <MudItem xs="12" sm="4">
                                    <MudText Typo="Typo.caption" Color="Color.Secondary">Time Until Expiry</MudText>
                                    <MudText Typo="Typo.body2" Color="@((license.ValidForUpdatesUntil - DateTime.UtcNow).TotalDays > 0 ? Color.Success : Color.Error)">
                                        @GetTimeUntilExpiry(license.ValidForUpdatesUntil)
                                    </MudText>
                                </MudItem>
                            </MudGrid>
                        </MudPaper>
                    }
                }
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudText Typo="Typo.subtitle1">Upload License (.spokes-license)</MudText>
                <div class="d-inline-flex mt-2">
                    <ApiFileUpload 
                        Category="temp" 
                        Accept=".spokes-license"
                        ContextId="@Guid.NewGuid().ToString()" 
                        OnUploadCompleted="HandleLicenseUploaded">
                        <CustomContent>
                            <MudButton Variant="Variant.Outlined" Color="Color.Primary" StartIcon="@Icons.Material.Filled.UploadFile">
                                Upload License File
                            </MudButton>
                        </CustomContent>
                    </ApiFileUpload>
                </div>
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudText Typo="Typo.subtitle1">Usage Statistics</MudText>
                <MudSwitch @bind-Value="Profile.SendUsageStatistics" Color="Color.Primary" Label="Send Anonymous Usage Statistics (Soft Ping)" />
                <MudText Typo="Typo.caption" Color="Color.Secondary">
                    We collect a secure hash of your license key along with basic system stats to ensure fair usage and help us improve Spokes. You may disable this at any time.
                </MudText>
            </MudItem>

            <MudItem xs="12">
                <MudDivider Class="my-2" />
            </MudItem>

            <MudItem xs="12" Class="mt-n6">
                <MudText Typo="Typo.h5">System Setup</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    Configure core system settings such as public URLs, routing ports, and identity providers.
                </MudText>
            </MudItem>

            <MudItem xs="12" Class="mt-n6">
                <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.ServerPublicUrl" Label="Server Public URL" HelperText="The base URL where this server is accessible (e.g. https://spokes.example.com)" />
            </MudItem>

            @if (!string.IsNullOrEmpty(Environment.GetEnvironmentVariable("WATCHTOWER_HTTP_API_TOKEN")))
            {
                <MudItem xs="12" Class="mt-n4">
                    <MudSwitch @bind-Value="_systemConfig.EnableAutoUpdate" Color="Color.Primary" Label="Enable Automatic DigitalOcean Updates" />
                    <MudText Typo="Typo.caption" Color="Color.Secondary">When enabled, the server will automatically pull and apply updates via Watchtower when a new version is released.</MudText>
                </MudItem>
            }

            @if (Environment.GetEnvironmentVariable("SPOKES_HOSTING_PROVIDER") != "digitalocean")
            {
                <MudItem xs="12" Class="mt-n4">
                    <MudText Typo="Typo.h6" >LiveKit Ports</MudText>
                    <MudAlert Severity="Severity.Warning" Class="mt-2 mb-4">If you modify these ports, you MUST ensure your <b>docker-compose.yml</b> and router are updated to match precisely. These must be mapped 1-to-1-to-1 across your network.</MudAlert>
                </MudItem>
                
                <MudItem xs="12" sm="4" Class="mt-n4">
                    <MudNumericField ShrinkLabel="true" @bind-Value="_systemConfig.LiveKitFallbackPort" Margin="Margin.Dense" Label="TCP Fallback Port" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="mt-n4">
                    <MudNumericField ShrinkLabel="true" @bind-Value="_systemConfig.LiveKitUdpStartPort" Margin="Margin.Dense" Label="UDP Start Port" Variant="Variant.Outlined" />
                </MudItem>
                <MudItem xs="12" sm="4" Class="mt-n4">
                    <MudNumericField ShrinkLabel="true" @bind-Value="_systemConfig.LiveKitUdpEndPort" Margin="Margin.Dense" Label="UDP End Port" Variant="Variant.Outlined" />
                </MudItem>
            }

            <MudItem xs="12" Class="mt-n4">
                <MudText Typo="Typo.h6" >Identity Provider</MudText>
                <MudText Typo="Typo.caption" Color="Color.Secondary">Configuring the system's global identity provider.</MudText>
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudSelect ShrinkLabel="true" Value="_systemConfig.ProviderType" ValueChanged="@((IdpType v) => OnProviderTypeChanged(v))" Label="Identity Provider Type" Variant="Variant.Outlined" Margin="Margin.Dense">
                    <MudSelectItem Value="@IdpType.BuiltInCasdoor">Built-in Casdoor</MudSelectItem>
                    <MudSelectItem Value="@IdpType.External">External Provider (OIDC)</MudSelectItem>
                </MudSelect>
            </MudItem>

            @if (_systemConfig.ProviderType == IdpType.External)
            {
                <MudItem xs="12" Class="mt-n4">
                    <MudText Typo="Typo.subtitle2" Class="mb-4">External Provider Configuration</MudText>
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.Authority" Label="Issuer / Authority URL" Required="true" Class="mb-4" />
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.ClientId" Label="Client ID" Required="true" Class="mb-4" />
                    <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="_systemConfig.ClientSecret" Label="Client Secret" InputType="InputType.Password" Required="true" />
                </MudItem>
            }

            <MudItem xs="12">
                <MudDivider Class="my-4" />
            </MudItem>

            <MudItem xs="12" Class="mt-n4">
                <MudText Typo="Typo.h5" Class="mb-2">VAPID Keys</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary">
                    VAPID (Voluntary Application Server Identification) keys authenticate your server with push
                    notification services.
                    Generate keys once per Spokes instance. These keys are stored securely and used to sign push requests.
                </MudText>
            </MudItem>

            @if (string.IsNullOrEmpty(Profile.VapidPublicKey))
            {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Warning">
                            <MudText><strong>Push notifications are not configured.</strong> Click the button below to generate
                                VAPID keys.</MudText>
                        </MudAlert>
                        <MudButton Class="mt-2" Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Key"
                            OnClick="GenerateVapidKeys">
                            Generate VAPID Keys
                        </MudButton>
                    </MudItem>
            }
            else
            {
                    <MudItem xs="12">
                        <MudAlert Severity="Severity.Success">
                            Push notifications are configured and ready to use.
                        </MudAlert>
                    </MudItem>

                    <MudItem xs="12">
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.VapidPublicKey" Label="Public Key" ReadOnly="true"
                            Adornment="Adornment.End" AdornmentIcon="@Icons.Material.Filled.ContentCopy"
                            OnAdornmentClick="@(() => CopyToClipboard(Profile.VapidPublicKey))" />
                    </MudItem>

                    <MudItem xs="12" Class="mt-n2">
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" Value="@MaskedPrivateKey" Label="Private Key (Hidden)" ReadOnly="true"
                            InputType="InputType.Password"
                            HelperText="Private key is stored securely and hidden for security" />
                    </MudItem>

                <MudItem xs="12" Class="mt-n2">
                        <MudTextField ShrinkLabel="true" Variant="Variant.Outlined" Margin="Margin.Dense" @bind-Value="Profile.VapidSubject" Label="Contact Email"
                            HelperText="Email address for push service operators to contact you (e.g., mailto:admin@company.com)" />
                    </MudItem>

                    <MudItem xs="12">
                        <MudButton Variant="Variant.Outlined" Color="Color.Error" StartIcon="@Icons.Material.Filled.Refresh"
                            OnClick="RegenerateVapidKeys">
                            Regenerate Keys
                        </MudButton>
                        <MudText Typo="Typo.caption" Class="ml-4" Color="Color.Error">
                            Warning: Regenerating keys will invalidate all existing push subscriptions.
                        </MudText>
                    </MudItem>
            }

            <MudItem xs="12" Class="d-flex justify-end mt-4 mb-6">
                <MudButton Color="Color.Primary" Variant="Variant.Filled" OnClick="SaveSystemSetup">Save Settings
                </MudButton>
            </MudItem>

        </MudGrid>
    }
    else if (activeTabIndex == 9)
    {
        <MudGrid>
            <MudItem xs="12" Class="mt-n2">
                <MudText Typo="Typo.h5">Server Logs</MudText>
                <MudText Typo="Typo.body2" Color="Color.Secondary" Class="mb-4">
                    View internal server errors and events. Logs are stored as JSON Lines and displayed here as raw text for easy copying.
                </MudText>
            </MudItem>
            <MudItem xs="12" Class="mt-n4">
                <MudDatePicker Label="Log Date"
                               Date="@((DateTime?)_selectedLogDate)"
