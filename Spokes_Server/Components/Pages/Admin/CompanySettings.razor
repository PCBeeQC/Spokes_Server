    private Employee? ResolveAuthorizedEmailAdmin()
    {
        if (string.IsNullOrWhiteSpace(_currentUser?.Id)) return null;
        var liveUser = Db.Employees.GetById(_currentUser.Id);
        if (liveUser != null) _currentUser = liveUser;
        if (liveUser is not { IsActiveUnsuspended: true }) return null;
        return liveUser.IsAdmin || liveUser.HasPermission(AppPermissions.Admin.ManageSettings) ? liveUser : null;
    }

    private async Task AdminConnectRealInboxAsync()
    {
        if (ResolveAuthorizedEmailAdmin() == null) return;
        var adminOwnerId = _activeAdmins.FirstOrDefault()?.Id ?? string.Empty;
        var newAccount = new EmailAccount
        {
            OwnerEmployeeId = adminOwnerId,
            IsServerManaged = true,
            SortOrder = Db.EmailAccounts.GetAll().Count
