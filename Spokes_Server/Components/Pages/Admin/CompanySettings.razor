    private async Task RegenerateVapidKeys()
    {
        var result = await DialogService.ShowMessageBoxAsync(
        "Regenerate VAPID Keys?",
        "This will invalidate all existing push subscriptions. Users will need to re-enable notifications in their browser.",
        yesText: "Regenerate", cancelText: "Cancel");

        if (result == true)
        {
            // Delete all existing subscriptions
            var allSessionsWithPush = Db.DeviceSessions.GetAll().Where(s => s.HasPush).ToList();
            foreach (var session in allSessionsWithPush)
            {
                Db.DeviceSessions.ClearPushFields(session);
            }

            GenerateVapidKeys();
            Snackbar.Add("Keys regenerated. All existing subscriptions have been cleared.", Severity.Warning);
        }
    }

