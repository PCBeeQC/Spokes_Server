    [Inject] private IFileService FileService { get; set; } = default!;
    [Inject] private ImageProcessingService ImageService { get; set; } = default!;

    private void HandleLogoUploaded(List<ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        
        var result = results.First();
        var parts = result.FilePath.Substring("/spokesapi/files/".Length).Split('/');
        if (parts.Length != 3) return;
        var fullPath = FileService.GetPhysicalPath(parts[0], parts[1], parts[2]);
        
        if (File.Exists(fullPath))
        {
            try
            {
                var bytes = File.ReadAllBytes(fullPath);
                var (optimizedBytes, mimeType) = ImageService.OptimizeImage(bytes, maxDimension: 1024);
                var base64 = Convert.ToBase64String(optimizedBytes);
                Profile.LogoBase64 = $"data:{mimeType};base64,{base64}";
                Profile.LogoVersion++;
                FileService.CleanTempContext(parts[1]);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add(string.Format(Loc["Error processing logo: {0}"].Value, ex.Message), Severity.Error);
                FileService.CleanTempContext(parts[1]);
            }
        }
    }

