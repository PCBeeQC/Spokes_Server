                { x => x.Account, newAccount },
                { x => x.IsNew, true },
                { x => x.AllowSharing, true }
            },
            new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true });

        var result = await dialog.Result;
        if (result is { Canceled: false, Data: EmailAccount savedAccount })
        {
            if (EmailInboxService.HasWebmailConsumers(savedAccount))
