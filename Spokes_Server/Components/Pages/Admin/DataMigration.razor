@page "/admin/data-migration"
@attribute [Authorize(Policy = AppPermissions.Admin.PolicyName)]
@using Spokes_Server.Components.Dialogs.Accounting
@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Services.Accounting
@using Spokes_Server.Core.Services.Identity
@using Spokes_Server.Core.Services.Migrations
@inject IAccountingMigrationService MigrationService
@inject ClockifyMigrationService ClockifyService
@inject UserService UserService
@inject IDialogService DialogService
@inject ISnackbar Snackbar

<PageTitle>@BizLoc["Unified Data Import & Cutover"] - Spokes</PageTitle>

<MudContainer MaxWidth="MaxWidth.ExtraLarge" Class="py-4">
    @if (!_isAuthorized)
    {
        <MudAlert Severity="Severity.Error" Variant="Variant.Filled">
            @BizLoc["You do not have permission to access Data Migration. Global Administrator access is required."]
        </MudAlert>
    }
    else
    {
        <MudStack Spacing="3">
            @* Header *@
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <div class="d-flex flex-wrap align-center justify-space-between gap-3">
                    <div>
                        <MudText Typo="Typo.h5"><b>@BizLoc["Unified Data Import & Accounting Cutover"]</b></MudText>
                        <MudText Typo="Typo.body2" Color="Color.Secondary">
                            @BizLoc["Drop all company export files here in one batch: Sage 50 (.txt / .imp), Chart of Accounts, Vendors, Customers, Employees, Projects, Payroll YTD CSV, Open AR/AP Invoices & Bills, or Clockify Timesheets CSV. You will review, filter, and pick what to keep before anything is saved."]
                        </MudText>
                    </div>
                    <MudChip T="string" Color="Color.Primary" Variant="Variant.Outlined" Icon="@Icons.Material.Filled.FactCheck">
                        @BizLoc["Interactive Review & 1-Click Rollback"]
                    </MudChip>
                </div>
            </MudPaper>

            @* Step 1: Configuration & Single Multi-File Drop Zone *@
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <MudGrid Spacing="3" Class="align-center">
                    <MudItem xs="12" md="4">
                        <MudSelect T="AccountingMigrationMode"
                                   Label="@BizLoc["Cutover Mode"]"
                                   @bind-Value="_mode"
                                   Variant="Variant.Outlined"
                                   Dense="true">
                            <MudSelectItem Value="AccountingMigrationMode.FreshCutover">
                                @BizLoc["Fresh Cutover (New Spokes Workspace)"]
                            </MudSelectItem>
                            <MudSelectItem Value="AccountingMigrationMode.ExistingWorkspaceDelta">
                                @BizLoc["Existing Workspace Delta (Sync with Existing GL)"]
                            </MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudSelect T="AccountingMigrationSourceFormat"
                                   Label="@BizLoc["Source Format"]"
                                   @bind-Value="_format"
                                   Variant="Variant.Outlined"
                                   Dense="true">
                            <MudSelectItem Value="AccountingMigrationSourceFormat.AutoDetect">@BizLoc["Auto-Detect (Recommended)"]</MudSelectItem>
                            <MudSelectItem Value="AccountingMigrationSourceFormat.Sage50DesktopImp">@BizLoc["Sage 50 Desktop (.imp)"]</MudSelectItem>
                            <MudSelectItem Value="AccountingMigrationSourceFormat.Sage50ExportCsv">@BizLoc["Sage 50 Export (.txt / CSV)"]</MudSelectItem>
                            <MudSelectItem Value="AccountingMigrationSourceFormat.SageBusinessCloudCsv">@BizLoc["Sage Business Cloud CSV"]</MudSelectItem>
                            <MudSelectItem Value="AccountingMigrationSourceFormat.StandardCsv">@BizLoc["Generic / Clockify CSV"]</MudSelectItem>
                        </MudSelect>
                    </MudItem>

                    <MudItem xs="12" md="4">
                        <MudDatePicker Label="@BizLoc["Cutover As-Of Date"]"
                                       @bind-Date="_asOfDate"
                                       Variant="Variant.Outlined"
                                       Margin="Margin.Dense"
                                       DateFormat="yyyy-MM-dd" />
                    </MudItem>

                    <MudItem xs="12">
                        <div class="d-flex flex-wrap align-center gap-3">
                            <InputFile id="unified-migration-upload"
                                       OnChange="OnFilesSelected"
                                       multiple
                                       accept=".csv,.txt,.imp,.gff"
                                       style="display:none;" />
                            <MudButton HtmlTag="label"
                                       for="unified-migration-upload"
                                       Variant="Variant.Outlined"
                                       Color="Color.Primary"
                                       StartIcon="@Icons.Material.Filled.CloudUpload"
                                       Disabled="@_isBusy">
                                @BizLoc["Select Export Files (.txt, .imp, .csv)"]
                            </MudButton>

                            @if (_queuedFiles.Count > 0)
                            {
                                <MudButton Variant="Variant.Filled"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.FactCheck"
                                           Disabled="@_isBusy"
                                           OnClick="AnalyzeAndReviewAsync">
                                    @(_isBusy ? BizLoc["Analyzing Files..."].Value : $"{BizLoc["Analyze & Review Import"].Value} ({_queuedFiles.Count})")
                                </MudButton>

                                <MudButton Variant="Variant.Text"
                                           Color="Color.Secondary"
                                           StartIcon="@Icons.Material.Filled.ClearAll"
                                           Disabled="@_isBusy"
                                           OnClick="ClearQueue">
                                    @BizLoc["Clear Files"]
                                </MudButton>
                            }
                        </div>
                    </MudItem>

                    @if (_queuedFiles.Count > 0)
                    {
                        <MudItem xs="12">
                            <MudTable Items="@_queuedFiles" Dense="true" Hover="true" Outlined="true" Elevation="0">
                                <HeaderContent>
                                    <MudTh>@BizLoc["File Name"]</MudTh>
                                    <MudTh>@BizLoc["Detected Content"]</MudTh>
                                    <MudTh>@BizLoc["Size"]</MudTh>
                                    <MudTh></MudTh>
                                </HeaderContent>
                                <RowTemplate Context="q">
                                    <MudTd><b>@q.File.FileName</b></MudTd>
                                    <MudTd>
                                        <MudSelect T="MigrationFileKind"
                                                   @bind-Value="q.File.ExplicitKind"
                                                   Dense="true"
                                                   Variant="Variant.Outlined"
                                                   Margin="Margin.Dense">
                                            <MudSelectItem Value="MigrationFileKind.Auto">@($"{BizLoc["Auto"].Value}: {FormatKindLabel(q.DetectedKind)}")</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.SageImp">@BizLoc["Sage 50 .imp Package"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.ChartOfAccounts">@BizLoc["Chart of Accounts"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.TrialBalance">@BizLoc["GL Trial Balance"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.Customers">@BizLoc["Customers / Clients"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.Vendors">@BizLoc["Suppliers / Vendors"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.Employees">@BizLoc["Employees Directory"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.PayrollYtd">@BizLoc["Payroll YTD Seed"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.Projects">@BizLoc["Projects"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.Inventory">@BizLoc["Inventory Items (Info)"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.OpenReceivables">@BizLoc["Open AR Invoices"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.OpenPayables">@BizLoc["Open AP Bills"]</MudSelectItem>
                                            <MudSelectItem Value="MigrationFileKind.ClockifyTimesheets">@BizLoc["Clockify Timesheets CSV"]</MudSelectItem>
                                        </MudSelect>
                                    </MudTd>
                                    <MudTd>@($"{q.File.Content.Length / 1024.0:N1} KB")</MudTd>
                                    <MudTd Style="text-align:right">
                                        <MudIconButton Icon="@Icons.Material.Filled.DeleteOutline"
                                                       Size="Size.Small"
                                                       Color="Color.Error"
                                                       OnClick="@(() => { _queuedFiles.Remove(q); })" />
                                    </MudTd>
                                </RowTemplate>
                            </MudTable>
                        </MudItem>
                    }
                </MudGrid>
            </MudPaper>

            @* Last Execution Result *@
            @if (_lastResult != null)
            {
                <MudAlert Severity="Severity.Success" Variant="Variant.Outlined" ShowCloseIcon="true" CloseIconClicked="@(() => { _lastResult = null; })">
                    <b>@string.Format(BizLoc["Import Batch {0} completed."].Value, _lastResult.Batch.BatchNumber)</b>
                    @($" · {_lastResult.Batch.CreatedEmployeeIds.Count} {BizLoc["Employees"]} · {_lastResult.Batch.CreatedSupplierIds.Count} {BizLoc["Address Book"]} · {_lastResult.Batch.CreatedProjectIds.Count} {BizLoc["Projects"]} · {_lastResult.Batch.CreatedGlAccountIds.Count} {BizLoc["GL Accounts"]} · {_lastResult.Batch.CreatedInvoiceIds.Count} AR · {_lastResult.Batch.CreatedBillIds.Count} AP · {_lastResult.Batch.CreatedPayRunIds.Count} YTD")
                    @if (_lastClockifyCount > 0)
                    {
                        @($" · {_lastClockifyCount} {BizLoc["Clockify Time Entries"]}")
                    }
                </MudAlert>
            }

            @* Step 2: Executed Migration Batches & 1-Click Rollback *@
            <MudPaper Class="pa-4" Elevation="0" Outlined="true">
                <div class="d-flex align-center justify-space-between mb-2">
                    <MudText Typo="Typo.subtitle1"><b>@BizLoc["Migration Cutover History & 1-Click Rollback"]</b></MudText>
                    <MudIconButton Icon="@Icons.Material.Filled.Refresh" Size="Size.Small" OnClick="RefreshHistory" />
                </div>

                <MudTable Items="@_history" Dense="true" Hover="true" Outlined="true" Elevation="0">
                    <HeaderContent>
                        <MudTh>@BizLoc["Batch #"]</MudTh>
                        <MudTh>@BizLoc["Executed At (UTC)"]</MudTh>
                        <MudTh>@BizLoc["Cutover Date"]</MudTh>
                        <MudTh>@BizLoc["Mode / Format"]</MudTh>
                        <MudTh>@BizLoc["Imported Entities"]</MudTh>
                        <MudTh>@BizLoc["3900 Residual"]</MudTh>
                        <MudTh>@BizLoc["Status"]</MudTh>
                        <MudTh></MudTh>
                    </HeaderContent>
                    <RowTemplate Context="b">
                        <MudTd><b>@b.BatchNumber</b></MudTd>
                        <MudTd>@b.ExecutedAtUtc.ToString("yyyy-MM-dd HH:mm")</MudTd>
                        <MudTd>@b.AsOfDate.ToString("yyyy-MM-dd")</MudTd>
                        <MudTd>@($"{b.Mode} · {b.DetectedFormat}")</MudTd>
                        <MudTd>
                            @($"{b.CreatedEmployeeIds.Count} Emp · {b.CreatedSupplierIds.Count} Dir · {b.CreatedProjectIds.Count} Proj · {b.CreatedGlAccountIds.Count} GL · {b.CreatedInvoiceIds.Count} AR · {b.CreatedBillIds.Count} AP · {b.CreatedJournalEntryIds.Count} JE · {b.CreatedPayRunIds.Count} YTD")
                        </MudTd>
                        <MudTd>@b.ResidualClearingBalance3900.ToString("N2")</MudTd>
                        <MudTd>
                            <MudChip T="string"
                                     Size="Size.Small"
                                     Color="@(b.Status == AccountingMigrationBatchStatus.Applied ? Color.Success : Color.Default)"
                                     Variant="Variant.Outlined">
                                @b.Status
                            </MudChip>
                        </MudTd>
                        <MudTd Style="text-align:right">
                            @if (b.Status == AccountingMigrationBatchStatus.Applied)
                            {
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Error"
                                           Size="Size.Small"
                                           StartIcon="@Icons.Material.Filled.Undo"
                                           OnClick="@(() => ConfirmRollbackAsync(b))">
                                    @BizLoc["Rollback"]
                                </MudButton>
                            }
                        </MudTd>
                    </RowTemplate>
                    <NoRecordsContent>
                        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="pa-2">
                            @BizLoc["No migration cutovers executed yet."]
                        </MudText>
                    </NoRecordsContent>
                </MudTable>
            </MudPaper>
        </MudStack>
    }
</MudContainer>

@code {
    private sealed class QueuedImportFile
    {
        public MigrationUploadedFile File { get; set; } = new();
        public MigrationFileKind DetectedKind { get; set; }
    }

    private AccountingMigrationMode _mode = AccountingMigrationMode.FreshCutover;
    private AccountingMigrationSourceFormat _format = AccountingMigrationSourceFormat.AutoDetect;
    private DateTime? _asOfDate = new DateTime(DateTime.Today.Year, DateTime.Today.Month, 1).AddDays(-1);
    private List<QueuedImportFile> _queuedFiles = [];
    private List<AccountingMigrationBatch> _history = [];
    private AccountingMigrationResult? _lastResult;
    private int _lastClockifyCount;
    private bool _isBusy;
    private bool _isAuthorized;

    protected override async Task OnInitializedAsync()
    {
        var currentEmp = await UserService.GetEmployeeAsync();
        _isAuthorized = currentEmp is { IsActiveUnsuspended: true } && currentEmp.IsEffectiveAdmin;
        if (_isAuthorized)
        {
            RefreshHistory();
        }
    }

    private void RefreshHistory()
    {
        _history = MigrationService.GetMigrationHistory();
    }

    private async Task OnFilesSelected(InputFileChangeEventArgs e)
    {
        try
        {
            foreach (var browserFile in e.GetMultipleFiles(30))
            {
                await using var stream = browserFile.OpenReadStream(maxAllowedSize: 15 * 1024 * 1024);
                using var ms = new MemoryStream();
                await stream.CopyToAsync(ms);
                var bytes = ms.ToArray();

                var detected = AccountingMigrationParser.DetectBannerKind(bytes);
                _queuedFiles.Add(new QueuedImportFile
                {
                    File = new MigrationUploadedFile
                    {
                        FileName = browserFile.Name,
                        Content = bytes,
                        ExplicitKind = MigrationFileKind.Auto
                    },
                    DetectedKind = detected
                });
            }
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{BizLoc["Failed to read selected file"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private void ClearQueue()
    {
        _queuedFiles.Clear();
    }

    private async Task AnalyzeAndReviewAsync()
    {
        if (_queuedFiles.Count == 0) return;

        var actor = await UserService.GetEmployeeAsync();
        if (actor is not { IsActiveUnsuspended: true } || !actor.IsEffectiveAdmin)
        {
            _isAuthorized = false;
            Snackbar.Add(BizLoc["Only an active Global Administrator may analyze or execute migrations."].Value, Severity.Error);
            return;
        }

        _isBusy = true;
        try
        {
            var asOf = _asOfDate ?? DateTime.Today;
            var clockifyFiles = _queuedFiles
                .Where(q => q.File.ExplicitKind == MigrationFileKind.ClockifyTimesheets ||
                            (q.File.ExplicitKind == MigrationFileKind.Auto && q.DetectedKind == MigrationFileKind.ClockifyTimesheets))
                .ToList();

            var accountingFiles = _queuedFiles
                .Except(clockifyFiles)
                .Select(q => q.File)
                .ToList();

            var preview = MigrationService.BuildPreview(new AccountingMigrationPreviewRequest
            {
                Mode = _mode,
                Format = _format,
                AsOfDate = asOf,
                Files = accountingFiles
            }, actor);

            var clockifyRecords = new List<ClockifyRecord>();
            foreach (var cf in clockifyFiles)
            {
                await using var ms = new MemoryStream(cf.File.Content);
                var parsed = await ClockifyService.ParseCsvAsync(ms, cf.File.FileName);
                clockifyRecords.AddRange(parsed.Records);
            }

            var clockifyUsers = clockifyRecords.Count > 0 ? ClockifyService.MapUsers(clockifyRecords) : null;
            var clockifyProjects = clockifyRecords.Count > 0 ? ClockifyService.MapProjects(clockifyRecords) : null;

            var parameters = new DialogParameters<MigrationReviewDialog>
            {
                { x => x.Preview, preview },
                { x => x.ClockifyUsers, clockifyUsers },
                { x => x.ClockifyProjects, clockifyProjects },
                { x => x.ClockifyRecordCount, clockifyRecords.Count }
            };

            var options = new DialogOptions
            {
                MaxWidth = MaxWidth.ExtraLarge,
                FullWidth = true,
                CloseOnEscapeKey = true,
                BackdropClick = false
            };

            var dialog = await DialogService.ShowAsync<MigrationReviewDialog>(
                BizLoc["Review & Curate Import Data"].Value,
                parameters,
                options);

            var result = await dialog.Result;
            if (result == null || result.Canceled)
                return;

            await ExecuteConfirmedImportAsync(preview, clockifyRecords, clockifyUsers, clockifyProjects);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{BizLoc["Import analysis failed"].Value}: {ex.Message}", Severity.Error);
        }
        finally
        {
            _isBusy = false;
        }
    }

    private async Task ExecuteConfirmedImportAsync(
        AccountingMigrationPreview preview,
        List<ClockifyRecord> clockifyRecords,
        List<ClockifyUserMap>? clockifyUsers,
        List<ClockifyProjectMap>? clockifyProjects)
    {
        var actor = await UserService.GetEmployeeAsync();
        if (actor is not { IsActiveUnsuspended: true } || !actor.IsEffectiveAdmin)
        {
            _isAuthorized = false;
            Snackbar.Add(BizLoc["Only an active Global Administrator may execute migrations."].Value, Severity.Error);
            return;
        }

        var userId = actor.Id;
        var userName = !string.IsNullOrWhiteSpace(actor.FullName) ? actor.FullName : actor.Email;

        AccountingMigrationResult? accountingResult = null;
        var hasAccountingOrEntityWork =
            preview.GlMappings.Any(g => g.Include && g.Action != MigrationGlAction.Ignore) ||
            preview.Vendors.Any(v => v.Include && v.Action != MigrationPartyAction.Skip) ||
            preview.Customers.Any(c => c.Include && c.Action != MigrationPartyAction.Skip) ||
            preview.Projects.Any(p => p.Include && p.Action != MigrationProjectAction.Skip) ||
            preview.OpenInvoices.Any(i => i.Include) ||
            preview.OpenBills.Any(b => b.Include) ||
            preview.PayrollYtds.Any(p => p.Include && p.Action != MigrationEmployeeAction.Skip);

        if (hasAccountingOrEntityWork)
        {
            accountingResult = MigrationService.ExecuteMigration(preview, userId, userName, actor);
            _lastResult = accountingResult;
        }

        _lastClockifyCount = 0;
        if (clockifyRecords.Count > 0 && clockifyUsers != null && clockifyProjects != null)
        {
            // Link Clockify users/projects against any Sage Employees/Projects just created above
            if (hasAccountingOrEntityWork)
            {
                ClockifyService.RelinkUnmatchedMappings(clockifyUsers, clockifyProjects);
            }

            await ClockifyService.ExecuteMigrationAsync(clockifyRecords, clockifyUsers, clockifyProjects, actor);
            _lastClockifyCount = clockifyRecords.Count;
        }

        RefreshHistory();
        _queuedFiles.Clear();

        if (accountingResult != null)
        {
            Snackbar.Add(
                string.Format(
                    BizLoc["Migration batch {0} executed successfully."].Value,
                    accountingResult.Batch.BatchNumber),
                Severity.Success);
        }
        else if (_lastClockifyCount > 0)
        {
            Snackbar.Add(
                string.Format(BizLoc["Imported {0} Clockify time entries."].Value, _lastClockifyCount),
                Severity.Success);
        }
    }

    private async Task ConfirmRollbackAsync(AccountingMigrationBatch batch)
    {
        var actor = await UserService.GetEmployeeAsync();
        if (actor is not { IsActiveUnsuspended: true } || !actor.IsEffectiveAdmin)
        {
            _isAuthorized = false;
            Snackbar.Add(BizLoc["Only an active Global Administrator may roll back migrations."].Value, Severity.Error);
            return;
        }

        var confirmed = await DialogService.ShowMessageBoxAsync(
            BizLoc["Confirm Migration Rollback"].Value,
            string.Format(
                BizLoc["Roll back migration batch {0}? This deletes imported opening journal entries, un-paid invoices/bills, created employees, created suppliers, created projects, GL accounts, and payroll YTD seed runs created by this batch."].Value,
                batch.BatchNumber),
            yesText: BizLoc["Rollback"].Value,
            cancelText: Loc["Cancel"].Value);

        if (confirmed != true) return;

        actor = await UserService.GetEmployeeAsync();
        if (actor is not { IsActiveUnsuspended: true } || !actor.IsEffectiveAdmin)
        {
            _isAuthorized = false;
            Snackbar.Add(BizLoc["Only an active Global Administrator may roll back migrations."].Value, Severity.Error);
            return;
        }

        try
        {
            var userName = !string.IsNullOrWhiteSpace(actor.FullName) ? actor.FullName : actor.Email;
            MigrationService.RollbackMigrationBatch(batch.Id, userName, actor);
            RefreshHistory();
            Snackbar.Add(string.Format(BizLoc["Rolled back migration batch {0}."].Value, batch.BatchNumber), Severity.Info);
        }
        catch (Exception ex)
        {
            Snackbar.Add($"{BizLoc["Rollback failed"].Value}: {ex.Message}", Severity.Error);
        }
    }

    private string FormatKindLabel(MigrationFileKind kind) => kind switch
    {
        MigrationFileKind.SageImp => BizLoc["Sage 50 .imp"].Value,
        MigrationFileKind.ChartOfAccounts => BizLoc["Chart of Accounts"].Value,
        MigrationFileKind.TrialBalance => BizLoc["GL Trial Balance"].Value,
        MigrationFileKind.Customers => BizLoc["Customers / Clients"].Value,
        MigrationFileKind.Vendors => BizLoc["Suppliers / Vendors"].Value,
        MigrationFileKind.Employees => BizLoc["Employees Directory"].Value,
        MigrationFileKind.PayrollYtd => BizLoc["Payroll YTD"].Value,
        MigrationFileKind.Projects => BizLoc["Projects"].Value,
        MigrationFileKind.Inventory => BizLoc["Inventory (Info)"].Value,
        MigrationFileKind.OpenReceivables => BizLoc["Open AR Invoices"].Value,
        MigrationFileKind.OpenPayables => BizLoc["Open AP Bills"].Value,
        MigrationFileKind.ClockifyTimesheets => BizLoc["Clockify Timesheets"].Value,
        _ => BizLoc["Auto"].Value
    };
}
