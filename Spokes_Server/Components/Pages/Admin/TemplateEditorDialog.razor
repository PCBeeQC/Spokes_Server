@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using MudBlazor
@inject Database Db

<MudDialog>
    <DialogContent>
        <MudForm>
            <MudTabs Elevation="0" ApplyEffectsToContainer="true" TabPanelsClass="pt-4">

                <MudTabPanel Text="Settings">
                    <MudGrid>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Name" Label="Template Name (Internal)"
                                Required="true" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.LanguageCode" Label="Language Code (e.g. fr-CA)" />
                        </MudItem>
                        <MudItem xs="2">
                            <MudSwitch @bind-Value="Template.IsDefault" Label="Default" Color="Color.Primary" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudSelect @bind-Value="Template.TaskTranslationLanguage" Label="Task Translation Language" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense" HelperText="Select language for task names">
                                <MudSelectItem Value="@(string.Empty)">Default</MudSelectItem>
                                @if (TaskLanguages != null)
                                {
                                    @foreach (var lang in TaskLanguages)
                                    {
                                        <MudSelectItem Value="@lang">@lang</MudSelectItem>
                                    }
                                }
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="6">
                            <MudSelect @bind-Value="Template.DateFormat" Label="Date Format" Variant="Variant.Outlined" Dense="true" Margin="Margin.Dense">
                                <MudSelectItem Value="@("MM/dd/yyyy")">MM/dd/yyyy (US)</MudSelectItem>
                                <MudSelectItem Value="@("dd/MM/yyyy")">dd/MM/yyyy (UK/Global)</MudSelectItem>
                                <MudSelectItem Value="@("yyyy-MM-dd")">yyyy-MM-dd (ISO)</MudSelectItem>
                                <MudSelectItem Value="@("MMM dd, yyyy")">MMM dd, yyyy (Jan 01, 2024)</MudSelectItem>
                                <MudSelectItem Value="@("dd MMM yyyy")">dd MMM yyyy (01 Jan 2024)</MudSelectItem>
                            </MudSelect>
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Financials & Tax</MudText>
                        </MudItem>

                        <MudItem xs="4">
                            <MudNumericField @bind-Value="Template.TaxRate" Label="Tax Rate %" Format="P4" Step="0.0001M"
                                Max="1.0M" />
                        </MudItem>
                        <MudItem xs="4">
                             <MudSwitch @bind-Value="Template.CurrencySymbolAfter" Label="Symbol After Number" Color="Color.Primary" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.CurrencySymbol" Label="Currency Symbol" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.TaxId1" Label="Tax ID 1 (Name & #)"
                                HelperText="e.g. TPS: 123456" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.TaxId2" Label="Tax ID 2 (Name & #)"
                                HelperText="e.g. TVQ: 987654" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.subtitle2">Banking (Wire Info)</MudText>
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.BankName" Label="Bank Name" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.BankSwiftCode" Label="Swift / BIC / Transit" />
                        </MudItem>
                        <MudItem xs="12">
                            <MudTextField @bind-Value="Template.BankAccountNumber" Label="Account / IBAN Number" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Template.PaymentInstructions"
                                Label="Payment Instructions (Footer)" Lines="2" />
                        </MudItem>



                        <MudItem xs="4">
                            <MudColorPicker Label="Document Primary Color" @bind-Text="Template.ColorPrimary"
                                Style="width:100%;" DisableAlpha="true" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudColorPicker Label="Document Secondary Color" @bind-Text="Template.ColorSecondary"
                                Style="width:100%;" DisableAlpha="true" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Labels / Translations">
                    <MudGrid>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_Invoice" Label="INVOICE Title" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_Quote" Label="QUOTE Title" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_PurchaseOrder" Label="PO Title" />
                        </MudItem>

                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_Date" Label="Label: Date" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_DueDate" Label="Label: Due Date" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_BillTo" Label="Label: Bill To" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_ShipTo" Label="Label: Ship To" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_ProjectNumber" Label="Label: Project # (Header)" />
                        </MudItem>

                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_Description" Label="Col: Description" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_Quantity" Label="Col: Qty" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_Price" Label="Col: Price" />
                        </MudItem>
                        <MudItem xs="3">
                            <MudTextField @bind-Value="Template.Label_Total" Label="Col: Total" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_ItemLaborTag" Label="Labor Item Suffix"
                                HelperText="Appended to task names (e.g. 'Engineering (Labor)')" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_BlockOfHours" Label="Block of Hours Prefix"
                                HelperText="Used for pre-payment blocks (e.g. 'Block of Hours:')" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_ProjectManager" Label="Label: Project Manager" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption">Footer & Banking Labels</MudText>
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_PaymentInstructions"
                                Label="Header: Payment Instructions" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_BankName" Label="Label: Bank Name" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_SwiftCode" Label="Label: Swift/Transit" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_BankAccount" Label="Label: Account #" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_TaxId1" Label="Label: Tax ID 1 (e.g. GST:)" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_TaxId2" Label="Label: Tax ID 2 (e.g. QST:)" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption">Totals</MudText>
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_Subtotal" Label="Total: Subtotal" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_Tax" Label="Total: Tax" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_QuoteTotal" Label="Total: Quote Total" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_GrandTotal" Label="Total: Inbox/Grand Total" />
                        </MudItem>

                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_ClientBoughtTotal" Label="Total: Client Bought" />
                        </MudItem>
                        <MudItem xs="4">
                            <MudTextField @bind-Value="Template.Label_ClientBoughtTag" Label="Item Tag (Client Resp.)" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption">Quote & Proposal</MudText>
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_ScopeOfWork" Label="Header: Scope of Work" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_TermsAndConditions"
                                Label="Header: Terms & Conditions" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_Acceptance" Label="Header: Acceptance" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_Signature" Label="Label: Signature" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_QuoteTo" Label="Label: Quote For" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_PresentedBy" Label="Label: Presented By" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_Confidential"
                                Label="Label: Confidential Header" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_ManagerEmail" Label="Label: Email" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_PricingBreakdown"
                                Label="Header: Pricing Breakdown" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_PaymentSchedule"
                                Label="Header: Payment Schedule" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudDivider Class="my-2" />
                            <MudText Typo="Typo.caption">Purchase Order Specific</MudText>
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_Vendor" Label="Label: Vendor Header" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_IssuedBy" Label="Label: Issued By" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_PoTotal" Label="Label: PO Total" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_SupplierRef" Label="Label: Supplier Quote Ref" />
                        </MudItem>

                        <MudItem xs="12">
                            <MudTextField @bind-Value="Template.Label_AcceptanceText" Label="Acceptance Legal Text"
                                Lines="2" />
                        </MudItem>

                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_SignatureClient"
                                Label="Label: Client Signature" />
                        </MudItem>
                        <MudItem xs="6">
                            <MudTextField @bind-Value="Template.Label_SignatureCompany"
                                Label="Label: Company Signature" />
                        </MudItem>
                    </MudGrid>
                </MudTabPanel>

                <MudTabPanel Text="Content Defaults">
                    <MudText Typo="Typo.body2" Class="mb-4">Set the default text that appears on new quotes.</MudText>

                    <MudTextField @bind-Value="Template.DefaultTermsAndConditions" Label="Default Terms & Conditions"
                        Lines="10" Variant="Variant.Outlined"
                        HelperText="This text will be copied to new quotes automatically." />

                    <MudItem xs="12">
                        <MudDivider Class="my-4" />
                    </MudItem>

                    <MudTextField @bind-Value="Template.DefaultCostPlusTerms" Label="Cost+ Billing Explanation"
                        HelperText="Displayed instead of Payment Schedule if no milestones are defined (Supports Markdown)."
                        Lines="4" Variant="Variant.Outlined" />
                </MudTabPanel>

            </MudTabs>
        </MudForm>
    </DialogContent>
    <DialogActions>
        <MudButton OnClick="Cancel">Cancel</MudButton>
        <MudButton Color="Color.Primary" OnClick="Submit">Save Template</MudButton>
    </DialogActions>
</MudDialog>

@code {
    [CascadingParameter] IMudDialogInstance MudDialog { get; set; } = default!;
    [Parameter] public DocumentTemplate Template { get; set; } = default!;
    
    private List<string> TaskLanguages = new();

    protected override void OnInitialized()
    {
        var profile = Db.CompanyProfile.Get();
        TaskLanguages = profile?.TaskTranslationLanguages ?? new List<string>();
    }

    private void Cancel() => MudDialog.Cancel();
    private void Submit() => MudDialog.Close(DialogResult.Ok(Template));
}
