@page "/purchases"
@inject Spokes_Server.Core.Services.Accounting.FinancialCalculationEngine CalcEngine
<PageTitle>Purchases</PageTitle>
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Models.HR
@using Spokes_Server.Core.Data
@using Spokes_Server.Components.Pages.Purchases
@using Spokes_Server.Components.Dialogs
@inject Database Db
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject AuthenticationStateProvider AuthStateProvider
@using Microsoft.AspNetCore.Components.Authorization
@using Spokes_Server.Core.Constants
@inject UserService UserService

<MudText Class="mt-4" Typo="Typo.h4" GutterBottom="true">Purchases (POs)</MudText>


<MudGrid Class="mb-6">
    <MudItem xs="12" sm="6">
        <MudPaper Class="pa-4 d-flex justify-space-between align-center" Elevation="0" Outlined="true">
            <div>
                <MudText Typo="Typo.caption">Estimated Open POs</MudText>
                <MudText Typo="Typo.h5" Color="Color.Info">@OpenPOsValue.ToString("C0")</MudText>
                <MudText Typo="Typo.caption">Last 30 Days</MudText>
            </div>
            <MudIcon Icon="@Icons.Material.Filled.ReceiptLong" Size="Size.Large" Color="Color.Info" />
        </MudPaper>
    </MudItem>
</MudGrid>

<MudPaper Elevation="0" Outlined="true" Class="pa-4">
    @if (CanViewPOs)
    {
        @if (CanManagePOs)
        {
            <div class="d-flex gap-4 mb-4">
                <MudButton Variant="Variant.Outlined" Color="Color.Primary" OnClick="CreateNewPO"
                    StartIcon="@Icons.Material.Filled.Add">Create PO</MudButton>
            </div>
        }

        <MudTable Items="@PoList" Dense="true" Striped="true" Outlined="true" Elevation="0" Hover="true" Filter="new Func<PurchaseOrder, bool>(FilterFuncPO)">
            <ToolBarContent>
                <MudText Typo="Typo.h5" Color="Color.Primary">Purchase Orders</MudText>
                <MudSpacer />
                <MudTextField @bind-Value="searchStringPO" Variant="Variant.Outlined" Margin="Margin.Dense" Placeholder="Search Supplier or PO #" Adornment="Adornment.Start"
                    AdornmentIcon="@Icons.Material.Filled.Search" IconSize="Size.Medium" Class="mt-0"></MudTextField>
            </ToolBarContent>
            <HeaderContent>
                <MudTh>PO #</MudTh>
                <MudTh>Date</MudTh>
                <MudTh>Supplier</MudTh>
                <MudTh>Issued By</MudTh>
                <MudTh>Total</MudTh>
                <MudTh>Status</MudTh>
                <MudTh>Actions</MudTh>
            </HeaderContent>
            <RowTemplate>
                <MudTd><b>@context.PoNumber</b></MudTd>
                <MudTd>@context.Date.ToShortDateString()</MudTd>
                <MudTd>@context.Supplier.BusinessName</MudTd>
                <MudTd>@context.IssuedBy</MudTd>
                <MudTd>@context.GrandTotal.ToString("C")</MudTd>
                <MudTd>
                    <StatusChip Status="@context.Status" />
                    @if (context.TotalBilled > 0)
                    {
                        <MudText Typo="Typo.caption" Class="d-block mt-1 text-muted">@context.TotalBilled.ToString("C") / @context.GrandTotal.ToString("C")</MudText>
                    }
                </MudTd>
                <MudTd>
                    <MudTooltip Text="View Document">
                        <MudIconButton Icon="@Icons.Material.Filled.Visibility" Color="Color.Primary"
                            OnClick="@(() => OpenViewer(context))" />
                    </MudTooltip>
                </MudTd>
            </RowTemplate>
        </MudTable>
    }
</MudPaper>

@code {
    private List<PurchaseOrder> PoList = new();

    [SupplyParameterFromQuery(Name = "q")]
    public string? QuerySearchString { get; set; }

    private string _searchStringPO = "";
    private string searchStringPO
    {
        get => _searchStringPO;
        set
        {
            if (_searchStringPO != value)
            {
                _searchStringPO = value;
                var uri = Nav.GetUriWithQueryParameter("q", string.IsNullOrWhiteSpace(_searchStringPO) ? null : _searchStringPO);
                Nav.NavigateTo(uri, new NavigationOptions { ReplaceHistoryEntry = true });
            }
        }
    }

    private decimal OpenPOsValue = 0;

    private bool CanManagePOs = false;
    private bool CanViewPOs = false;

    protected override async Task OnInitializedAsync()
    {
        if (!string.IsNullOrEmpty(QuerySearchString))
        {
            _searchStringPO = QuerySearchString;
        }

        // Use UserService for consistent permissions
        var emp = await UserService.GetEmployeeAsync();
        if (emp != null)
        {
            CanManagePOs = emp.IsAdmin || emp.HasPermission(AppPermissions.Purchases.ManagePOs);
            CanViewPOs = emp.IsAdmin || 
                         emp.HasPermission(AppPermissions.Purchases.ManagePOs) || 
                         emp.HasPermission(AppPermissions.Purchases.ViewPOs) || 
                         emp.HasPermission(AppPermissions.Purchases.ManageBills);
        }

        if (!CanViewPOs)
        {
            Nav.NavigateTo("/", true);
            return;
        }

        Refresh();
    }

    private void Refresh()
    {
        PoList = Db.Purchases.GetAll().Where(p => p.Status != "Void").OrderByDescending(p => p.PoNumber).ToList();

        // Open POs (Estimating by subtracting billed amount from PO total?)
        var recent = DateTime.Today.AddDays(-30);
        OpenPOsValue = PoList.Where(p => p.Date >= recent).Sum(p => p.RemainingBalance);
    }

    private void OpenViewer(PurchaseOrder po)
    {
        Nav.NavigateTo($"/purchases/{po.Id}");
    }

    private async Task CreateNewPO()
    {
        var po = new PurchaseOrder { Date = DateTime.Today };
        var parameters = new DialogParameters { ["PO"] = po };
        var options = new DialogOptions { MaxWidth = MaxWidth.ExtraExtraLarge, FullWidth = true, CloseOnEscapeKey = false };

        var dialog = await DialogService.ShowAsync<PurchaseOrderDialog>("New Purchase Order", parameters, options);
        var result = await dialog.Result;

        if (!result.Canceled)
        {
            if (result.Data is PurchaseOrder dataPo)
            {
                Db.Purchases.Save(dataPo);
                Refresh();
            }
        }
    }

    private bool FilterFuncPO(PurchaseOrder element) =>
    string.IsNullOrWhiteSpace(searchStringPO) ||
    element.PoNumber.Contains(searchStringPO, StringComparison.OrdinalIgnoreCase) ||
    element.Supplier.BusinessName.Contains(searchStringPO, StringComparison.OrdinalIgnoreCase);
}
