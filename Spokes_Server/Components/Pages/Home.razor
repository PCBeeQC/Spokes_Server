@page "/"
@page "/home"
@using Spokes_Server.Core.Constants
@using System.Globalization
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Pages.Chat
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.Security
@inject NavigationManager Nav
@inject Database Db
@inject UserService UserService
@inject Spokes_Server.Core.Services.HR.CalendarService CalendarService
@inject IChatAuthorizationService ChatAuth
@inject IEmailInboxService EmailInboxService
@inject IUserPrivacyService PrivacyService
@inject AppLabelService AppLabels
@inject IDialogService DialogService
@inject ISnackbar Snackbar
@inject ILogger<Home> Logger
@inject Spokes_Server.Core.Services.Maintenance.StartupTimingService StartupTimings
@inject IJSRuntime JS

<PageTitle>Home | Spokes</PageTitle>

@if (!IsFriendEdition)
{
    @if (!IsExplicitHomeRoute && !string.IsNullOrWhiteSpace(_currentUser?.LandingPage) && _currentUser.LandingPage != "" && _currentUser.LandingPage != "/")
    {
        @* Instant redirection to custom landing page in progress; do not render dashboard cards *@
    }
    else
    {
    <MudContainer MaxWidth="MaxWidth.Large" Class="mt-4">
        <div class="d-flex flex-column gap-4">
            <!-- Welcome Section -->
            <MudPaper Class="pa-6" Outlined="true" Elevation="0">
                <MudText Typo="Typo.h4">Welcome back, @(_currentUser?.FirstName ?? "User")!</MudText>
                <MudText Typo="Typo.subtitle1" Color="Color.Secondary">Here's what's happening this week.</MudText>
            </MudPaper>

            @if (_isLoading)
            {
                <div class="d-flex justify-center align-center py-16">
                    <MudProgressCircular Color="Color.Primary" Indeterminate="true" Size="Size.Large" />
                </div>
            }
            else
            {
                <MudGrid>
                <!-- 1. This Week's Agenda -->
                @if (HasPerm(AppPermissions.Calendar.View))

                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0" Style="height: 100%">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h6"><b>This Week's Agenda</b></MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                    EndIcon="@Icons.Material.Filled.ArrowForward"
                                    OnClick="@(() => Nav.NavigateTo("/planning/calendar"))">Calendar</MudButton>
                            </div>

                            @if (WeekEvents.Count > 0)
                            {
                                var viewingContext = new CalendarViewingContext(
                                    _currentUser?.Id ?? "",
                                    _currentUserTeamIds,
                                    _employeeNames,
                                    _teamNames,
                                    Categories.ToDictionary(c => c.Id, c => c));
                                <MudList T="string" Dense="true">
                                    @foreach (var group in WeekEvents.GroupBy(e => e.Start.Date))
                                    {
                                        <MudListSubheader Class="pb-1 pt-2 px-4">
                                            <MudText Typo="Typo.subtitle2" Color="Color.Primary">
                                                <b>@(group.Key.Date == DateTime.Today ? "Today" : group.Key.Date == DateTime.Today.AddDays(1) ? "Tomorrow" : group.Key.ToString("dddd, MMM d"))</b>
                                            </MudText>
                                        </MudListSubheader>
                                        
                                        @foreach (var evt in group)
                                        {
                                            var effCat = CalendarEffectiveCategory.Resolve(evt, viewingContext);

                                            <MudListItem T="string" Icon="@Icons.Material.Filled.Event" IconColor="@effCat.Color" OnClick="@(() => OpenEventDialog(evt))">
                                                <div class="d-flex justify-space-between align-center" style="width: 100%">
                                                    <div class="d-flex flex-column">
                                                        <MudText Typo="Typo.subtitle2">@evt.Title</MudText>
                                                        <MudText Typo="Typo.caption">
                                                            @(evt.IsAllDay ? "All Day" : $"{evt.Start:HH:mm} - {evt.End:HH:mm}")
                                                        </MudText>
                                                    </div>
                                                    @if (!string.IsNullOrEmpty(effCat.DisplayName))
                                                    {
                                                        <MudChip T="string" Color="@effCat.Color" Size="Size.Small" Variant="Variant.Outlined">@effCat.DisplayName</MudChip>
                                                    }
                                                </div>
                                            </MudListItem>
                                        }
                                    }
                                </MudList>
                            }

                            else

                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">No events scheduled for this week.</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }

                <!-- 2. Latest Chat & Email Notifications -->
                @if (HasPerm(AppPermissions.Chat.Use) || (!IsFriendEdition && HasPerm(AppPermissions.Email.Use)))

                {
                    <MudItem xs="12" md="6">
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0" Style="height: 100%">
                            <div class="d-flex justify-space-between align-start mb-4">
                                <MudText Typo="Typo.h6" Class="mt-2"><b>Notifications</b></MudText>
                            </div>

                            @if (UnreadMessages.Any())
                            {
                                <MudList T="string" Dense="true" ReadOnly="false">
                                    @foreach (var msg in UnreadMessages)
                                    {
                                        bool isChat = msg.Type == "Chat";
                                        string icon = isChat ? Icons.Material.Filled.Chat : Icons.Material.Filled.Email;
                                        Color iconColor = isChat ? Color.Primary : Color.Secondary;
                                        string url = isChat ? $"/chat/{msg.ChannelId}" : $"/email/{msg.FolderPath}/{msg.EmailId}";
                                        
                                        <MudListItem T="string" Icon="@icon" IconColor="@iconColor"
                                            OnClick="@(() => Nav.NavigateTo(url))">
                                            <div class="d-flex flex-column">
                                                <MudText Typo="Typo.subtitle2"><b>@msg.SenderName</b> @(isChat ? "in " + msg.ChannelName : "")</MudText>
                                                @if (!isChat)
                                                {
                                                    <MudText Typo="Typo.body2" Class="text-truncate" Style="max-width: 300px;"><b>@msg.ChannelName</b></MudText>
                                                }
                                                <MudText Typo="Typo.caption" Class="text-truncate" Style="max-width: 300px;">
                                                    @msg.Content</MudText>
                                            </div>
                                        </MudListItem>
                                    }
                                </MudList>
                            }

                            else

                            {
                                <MudText Typo="Typo.body2" Color="Color.Secondary">You're all caught up!</MudText>
                            }
                        </MudPaper>
                    </MudItem>
                }

                <!-- 3. Weekly Planned Work -->
                @if (!IsFriendEdition && IsWeeklyPlanEnabled && HasPerm(AppPermissions.Timesheets.AccessTimesheet))

                {
                    <MudItem xs="12">
                        <MudPaper Class="pa-4" Outlined="true" Elevation="0">
                            <div class="d-flex justify-space-between align-center mb-4">
                                <MudText Typo="Typo.h6"><b>My Week Plan</b></MudText>
                                <MudButton Variant="Variant.Text" Color="Color.Primary"
                                    EndIcon="@Icons.Material.Filled.ArrowForward"
                                    OnClick="@(() => Nav.NavigateTo("/my-timesheet"))">Timesheet</MudButton>
                            </div>

                            @if (CurrentPlan != null && CurrentPlan.Entries.Any())

                            {
                                <MudGrid>
                                    <MudItem xs="12" sm="3" Class="d-flex flex-column justify-center align-center">
                                        <MudText Typo="Typo.h3" Color="Color.Primary">@CurrentPlan.TotalHours.ToString("F0")h
                                        </MudText>
                                        <MudText Typo="Typo.subtitle2">Planned This Week</MudText>
                                    </MudItem>
                                    <MudItem xs="12" sm="9">
                                        <MudTable Items="@CurrentPlan.Entries" Dense="true" Hover="true" Elevation="0" Outlined="true">
                                            <HeaderContent>
                                                <MudTh>Project</MudTh>
                                                <MudTh>Planned Hours</MudTh>
                                                <MudTh>Focus</MudTh>
                                            </HeaderContent>
                                            <RowTemplate>
                                                <MudTd>@context.ProjectName</MudTd>
                                                <MudTd>@context.Hours.ToString("F1")h</MudTd>
                                                <MudTd>
                                                    <MudText Typo="Typo.caption">@context.Note</MudText>
                                                </MudTd>
                                            </RowTemplate>
                                        </MudTable>
                                    </MudItem>
                                </MudGrid>
                            }

                            else

                            {
                                <div class="d-flex flex-column align-center pa-4">
                                    <MudText Typo="Typo.body1" Class="mb-2">No work planned for this week yet.</MudText>
                                    <MudButton Variant="Variant.Outlined" Color="Color.Primary"
                                        OnClick="@(() => Nav.NavigateTo("/my-timesheet"))">Create Plan</MudButton>
                                </div>
                            }
                        </MudPaper>
                    </MudItem>
                }
            </MudGrid>

            <!-- Quick Actions based on Perms -->
            @if (!IsFriendEdition)
            {
                <MudText Typo="Typo.h5" Class="mt-6"><b>Quick Actions</b></MudText>
                <MudGrid>
                    @if (HasPerm(AppPermissions.Projects.View))
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudCard Outlined="true" Elevation="0" Class="cursor-pointer hover-elevate" @onclick="@(() => Nav.NavigateTo("/projects"))">
                                <MudCardContent Class="d-flex flex-column align-center py-6">
                                    <MudIcon Icon="@Icons.Material.Filled.Work" Size="Size.Large" Color="Color.Primary"
                                             Class="mb-2" />
                                    <MudText>Projects</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }

                    @if (HasPerm(AppPermissions.Finance.AccessAccounting))
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudCard Outlined="true" Elevation="0" Class="cursor-pointer hover-elevate" @onclick="@(() => Nav.NavigateTo("/business-dashboard"))">
                                <MudCardContent Class="d-flex flex-column align-center py-6">
                                    <MudIcon Icon="@Icons.Material.Filled.Dashboard" Size="Size.Large" Color="Color.Secondary"
                                             Class="mb-2" />
                                    <MudText>Business Dashboard</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }

                    @if (HasPerm(AppPermissions.Purchases.ManagePOs))
                    {
                        <MudItem xs="6" sm="4" md="3">
                            <MudCard Outlined="true" Elevation="0" Class="cursor-pointer hover-elevate"
                                     @onclick="@(() => Nav.NavigateTo("/purchases/create-po"))">
                                <MudCardContent Class="d-flex flex-column align-center py-6">
                                    <MudIcon Icon="@Icons.Material.Filled.AddShoppingCart" Size="Size.Large" Color="Color.Success"
                                             Class="mb-2" />
                                    <MudText>New Purchase Order</MudText>
                                </MudCardContent>
                            </MudCard>
                        </MudItem>
                    }
                </MudGrid>
                          
            }
            }
            

        </div>
    </MudContainer>
    }
}

<style>
    .hover-elevate {
        transition: transform 0.2s, box-shadow 0.2s;
    }

    .hover-elevate:hover {
        transform: translateY(-2px);
        box-shadow: 0 4px 8px rgba(0, 0, 0, 0.1);
    }
</style>

@code {
    private Employee? _currentUser;
    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";
    private bool IsWeeklyPlanEnabled => Db.CompanyProfile.Get()?.TimesheetConfig?.EnableWeeklyPlan ?? true;
    private bool _isLoading = true;
    private bool _reportedPerfSettled;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!_isLoading && !_reportedPerfSettled)
        {
            _reportedPerfSettled = true;
            StartupTimings.TryMarkRouteSettled("HomeDashboard");
            try
            {
                await JS.InvokeVoidAsync("startupDiagnostics.reportRouteSettled", "HomeDashboard");
            }
            catch
            {
                // Ignore disconnected circuit during teardown
            }
        }
    }

    private bool IsExplicitHomeRoute
    {
        get
        {
            var uri = Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
            return string.Equals(uri, "home", StringComparison.OrdinalIgnoreCase);
        }
    }

    // Data Models

    private List<CalendarEvent> WeekEvents = new();
    private List<CalendarCategory> Categories = new();
    private HashSet<string> _currentUserTeamIds = [];
    private Dictionary<string, string> _employeeNames = [];
    private Dictionary<string, Employee> _employeesById = [];
    private Dictionary<string, string> _teamNames = [];

    private List<NotificationViewModel> UnreadMessages = new();

    private WeeklyPlan? CurrentPlan;

    protected override async Task OnInitializedAsync()
    {
        _currentUser = await UserService.GetEmployeeAsync();

        if (!IsFriendEdition && !IsExplicitHomeRoute && !string.IsNullOrWhiteSpace(_currentUser?.LandingPage) && _currentUser.LandingPage != "" && _currentUser.LandingPage != "/")
        {
            var target = _currentUser.LandingPage.StartsWith('/') ? _currentUser.LandingPage : "/" + _currentUser.LandingPage;
            Nav.NavigateTo(target, replace: true);
            return;
        }

        if (!IsFriendEdition)
        {
            var serverProfile = Db.CompanyProfile.Get();
            Categories = _currentUser != null
                ? _currentUser.EnsureCalendarCategories(serverProfile)
                : CalendarCategoryDefaults.CloneList(serverProfile?.CalendarCategories);

            var discoverableEmployees = _currentUser != null
                ? PrivacyService.FilterDiscoverableEmployees(_currentUser, Db.Employees.GetActiveEmployees())
                : [];
            _employeeNames = discoverableEmployees.ToDictionary(e => e.Id, e => e.FullName);
            _employeesById = discoverableEmployees.ToDictionary(e => e.Id, e => e);
            if (_currentUser != null)
            {
                _employeeNames.TryAdd(_currentUser.Id, _currentUser.FullName);
                _employeesById.TryAdd(_currentUser.Id, _currentUser);
            }
            var discoverableTeams = _currentUser != null
                ? PrivacyService.FilterDiscoverableTeams(_currentUser, Db.Teams.GetAll())
                : [];
            _teamNames = discoverableTeams.ToDictionary(t => t.Id, t => t.Name);
            _currentUserTeamIds.Clear();
            if (!string.IsNullOrEmpty(_currentUser?.TeamId))
                _currentUserTeamIds.Add(_currentUser.TeamId);
            if (_currentUser != null)
            {
                foreach (var t in Db.Teams.GetAll().Where(t => t.LeaderId == _currentUser.Id))
                    _currentUserTeamIds.Add(t.Id);
            }
        }

        if (_currentUser != null && !IsFriendEdition)
        {
            StartupTimings.RegisterPendingRouteGate("HomeDashboard");
            LoadDashboardData();
        }
        else
        {
            _isLoading = false;
        }
    }

    private void LoadDashboardData()
    {
        try
        {
            if (_currentUser == null) return;

            LoadWeekAgenda();
            LoadNotifications();
            if (IsWeeklyPlanEnabled)
            {
                LoadWeeklyPlan();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error loading dashboard data.");
        }
        finally
        {
            _isLoading = false;
        }
    }

    private void LoadWeekAgenda()

    {

        var currentUser = _currentUser;
        if (currentUser == null) return;

        var today = DateTime.Today;

        var daysUntilSunday = ((int)DayOfWeek.Sunday - (int)today.DayOfWeek + 7) % 7;
        var endOfWeek = today.AddDays(daysUntilSunday + 1);

        // Fetch events where user is EmployeeId or (Participant logic if implemented)

        // Ignoring complicated recurrence or attendees for MVP, assuming 'EmployeeId' owns the event

        var canViewCalendar = Spokes_Server.Core.Services.HR.CalendarService.HasCalendarViewAccess(currentUser)
            || Spokes_Server.Core.Services.HR.CalendarService.HasCalendarAdminOverride(currentUser);
        var allEvents = canViewCalendar ? Db.CalendarEvents.GetAll() : new List<CalendarEvent>();

        WeekEvents = allEvents

        .Where(e => (e.IsCompanyWide || 
                     e.EmployeeId == currentUser.Id || 
                     (e.Attendees != null && e.Attendees.Contains(currentUser.Id)) || 
                     (e.InvitedTeamIds != null && e.InvitedTeamIds.Any(tId => _currentUserTeamIds.Contains(tId)))) &&
        e.Start < endOfWeek && e.End > today) // Overlaps this week

        .OrderBy(e => e.Start)

        .ToList();

    }

    private void LoadNotifications()
    {
        var currentUser = _currentUser;
        if (currentUser == null) return;

        if (HasPerm(AppPermissions.Chat.Use))
        {
            string ResolveVisibleSenderName(string? senderId)
            {
                if (string.IsNullOrWhiteSpace(senderId)) return "Unknown";
                if (_employeeNames.TryGetValue(senderId, out var visibleName)) return visibleName;
                return Db.Employees.GetById(senderId) != null ? AppLabels.Employee : "Unknown";
            }

            // 1. Get user channels using centralized authorization
            var channels = ChatAuth.GetChannelsForUser(currentUser.Id)
                .Where(c => ChatAuth.CanUserAccessChannel(c, currentUser));

            foreach (var channel in channels)
            {
                var lastRead = Db.ChatReadStates.GetLastReadAt(currentUser.Id, channel.Id);

                // Fast path: check unread count using in-memory index without loading messages from disk
                if (Db.ChatMessages.GetUnreadCountSince(channel.Id, lastRead, currentUser.Id) == 0)
                    continue;

                // Existing method used by ChatSidebar for channel preview
                var preview = Db.ChatMessages.GetChannelPreviewSummary(channel.Id);
                if (preview != null && preview.SentAt > lastRead && preview.SenderId != currentUser.Id)
                {
                    var senderName = ResolveVisibleSenderName(preview.SenderId);
                    var channelName = ChatChannelFormatter.GetDisplayName(channel, currentUser.Id, id => _employeesById.GetValueOrDefault(id));
                    bool isEncrypted = preview.IsEncrypted || channel.IsEncrypted;
                    var content = preview.PreviewText ?? (isEncrypted ? "Encrypted message" : "");

                    if (string.IsNullOrEmpty(content) && !isEncrypted)
                    {
                        var msg = Db.ChatMessages.GetByIdOrLoad(channel.Id, preview.MessageId);
                        if (msg != null)
                        {
                            content = msg.IsEncrypted ? "Encrypted message" : msg.Content;
                        }
                    }

                    UnreadMessages.Add(new NotificationViewModel
                    {
                        ChannelId = channel.Id,
                        ChannelName = channelName,
                        SenderName = senderName,
                        Content = content,
                        SentAt = preview.SentAt,
                        Type = "Chat",
                        EmailId = "",
                        FolderPath = ""
                    });
                }
                else
                {
                    // Fallback to existing repository method: loads only unread messages for this specific channel
                    var latestUnread = Db.ChatMessages.GetUnreadMessagesSince(channel.Id, lastRead, currentUser.Id)
                        .OrderByDescending(m => m.SentAt)
                        .FirstOrDefault();

                    if (latestUnread != null)
                    {
                        var senderName = ResolveVisibleSenderName(latestUnread.SenderId);
                        var channelName = ChatChannelFormatter.GetDisplayName(channel, currentUser.Id, id => _employeesById.GetValueOrDefault(id));
                        bool isEncrypted = latestUnread.IsEncrypted || channel.IsEncrypted;

                        UnreadMessages.Add(new NotificationViewModel
                        {
                            ChannelId = channel.Id,
                            ChannelName = channelName,
                            SenderName = senderName,
                            Content = isEncrypted ? "Encrypted message" : latestUnread.Content,
                            SentAt = latestUnread.SentAt,
                            Type = "Chat",
                            EmailId = "",
                            FolderPath = ""
                        });
                    }
                }
            }
        }

        if (!IsFriendEdition && HasPerm(AppPermissions.Email.Use))
        {
            // 2. Fetch unread emails strictly scoped to non-archived Real Inboxes and filter-scoped Virtual Inboxes
            var seenEmails = new HashSet<string>(StringComparer.OrdinalIgnoreCase);
            var realAccounts = EmailInboxService.GetAccessibleRealInboxes(currentUser.Id)
                .Where(a => !a.IsArchived)
                .ToList();
            var realAccountIds = new HashSet<string>(realAccounts.Select(a => a.Id), StringComparer.OrdinalIgnoreCase);

            foreach (var account in realAccounts)
            {
                if (Db.EmailMessages.GetUnreadCount(account.Id, "INBOX") <= 0)
                    continue;

                var topEmails = Db.EmailMessages.GetUnreadByFolderRecent(account.Id, "INBOX", 5);
                foreach (var email in topEmails)
                {
                    if (!seenEmails.Add($"{account.Id}:{email.Id}"))
                        continue;

                    UnreadMessages.Add(new NotificationViewModel
                    {
                        ChannelId = "",
                        ChannelName = email.Subject,
                        SenderName = string.IsNullOrWhiteSpace(email.FromName) ? email.FromAddress : email.FromName,
                        Content = string.IsNullOrWhiteSpace(email.Snippet) ? "No snippet available" : email.Snippet,
                        SentAt = email.Date.DateTime,
                        Type = "Email",
                        EmailId = email.Id,
                        FolderPath = $"real-{account.Id}"
                    });
                }
            }

            foreach (var inbox in EmailInboxService.GetAccessibleInboxes(currentUser.Id))
            {
                if (string.IsNullOrWhiteSpace(inbox.AccountId) || realAccountIds.Contains(inbox.AccountId))
                    continue;

                var filter = EmailInboxService.GetMetadataFilterForInbox(inbox);
                if (Db.EmailMessages.GetUnreadCount(inbox.AccountId, "INBOX", filter) <= 0)
                    continue;

                var topEmails = Db.EmailMessages.GetUnreadByFolderRecent(inbox.AccountId, "INBOX", 5, filter);
                foreach (var email in topEmails)
                {
                    if (!seenEmails.Add($"{inbox.AccountId}:{email.Id}"))
                        continue;

                    UnreadMessages.Add(new NotificationViewModel
                    {
                        ChannelId = "",
                        ChannelName = email.Subject,
                        SenderName = string.IsNullOrWhiteSpace(email.FromName) ? email.FromAddress : email.FromName,
                        Content = string.IsNullOrWhiteSpace(email.Snippet) ? "No snippet available" : email.Snippet,
                        SentAt = email.Date.DateTime,
                        Type = "Email",
                        EmailId = email.Id,
                        FolderPath = $"inbox-{inbox.Id}"
                    });
                }
            }
        }

        UnreadMessages = UnreadMessages.OrderByDescending(m => m.SentAt).Take(5).ToList();
    }

    private void LoadWeeklyPlan()
    {
        var currentUser = _currentUser;
        if (currentUser == null) return;

        var (year, week) = Spokes_Server.Core.Services.HR.WeeklyPlanService.GetCurrentIsoYearWeek();
        CurrentPlan = Db.WeeklyPlans.GetOrStubByEmployeeAndWeek(currentUser.Id, year, week);

        if (CurrentPlan != null)
        {
            var allProjects = Db.Projects.GetAll()
                .Where(p => UserService.CanViewProject(_currentUser, p))
                .ToList();

            Spokes_Server.Core.Services.HR.WeeklyPlanService.EnrichProjectNames(CurrentPlan, allProjects);
        }
    }

    private bool HasPerm(string perm) => _currentUser?.HasPermission(perm) ?? false;

    public class NotificationViewModel

    {

        public string ChannelId { get; set; } = string.Empty;

        public string ChannelName { get; set; } = string.Empty;

        public string SenderName { get; set; } = string.Empty;

        public string Content { get; set; } = string.Empty;

        public DateTime SentAt { get; set; }
        public string Type { get; set; } = "Chat";
        public string EmailId { get; set; } = "";
        public string FolderPath { get; set; } = "";
    }

    private async Task OpenEventDialog(CalendarEvent evt)
    {
        var liveUser = _currentUser != null
            ? Db.Employees.GetById(_currentUser.Id)
            : await UserService.GetEmployeeAsync();
        if (liveUser == null || !CalendarService.CanUserViewEvent(evt, liveUser))
        {
            Snackbar.Add("You do not have permission to view this calendar event.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Event"] = evt, ["IsNew"] = false };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<CalendarEventDialog>("Event Details", parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled)
        {
            var actionUser = Db.Employees.GetById(liveUser.Id);
            var persistedEvent = CalendarService.GetEventById(evt.Id) ?? evt;
            if (actionUser == null || !CalendarService.CanUserEditEvent(persistedEvent, actionUser))
            {
                Snackbar.Add("You do not have permission to modify this calendar event.", Severity.Warning);
                return;
            }

            try
            {
                if (result.Data is CalendarEvent resultEvent) // Saved
                {
                    CalendarService.SaveEvent(resultEvent, actionUser.Id);
                    Snackbar.Add("Event saved", Severity.Success);
                }
                else // Deleted
                {
                    CalendarService.DeleteEvent(evt.Id, actionUser.Id);
                    Snackbar.Add("Event deleted", Severity.Success);
                }
            }
            catch (UnauthorizedAccessException)
            {
                Snackbar.Add("You do not have permission to modify this calendar event.", Severity.Warning);
                return;
            }
            LoadWeekAgenda();
            StateHasChanged();
        }
    }
}

