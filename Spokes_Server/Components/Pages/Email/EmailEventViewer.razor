@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Core.Helpers
@using Spokes_Server.Core.Services.Communication.Email
@using Spokes_Server.Core.Services.HR
@inject IEmailCacheMaintenanceService CacheMaintenance
@inject CalendarService CalendarService
@inject UserService UserService
@inject IDialogService DialogService
@inject Database Db
@inject ISnackbar Snackbar
@inject IStringLocalizer<AppResources> Loc

<MudCard Outlined="true" Class="mt-4" Style="max-width: 600px; background-color: var(--mud-palette-background-grey);">
    @if (_event != null)
    {
        <MudCardHeader>
            <CardHeaderAvatar>
                <MudAvatar Color="Color.Primary" Variant="Variant.Filled">
                    <MudIcon Icon="@Icons.Material.Filled.Event" />
                </MudAvatar>
            </CardHeaderAvatar>
            <CardHeaderContent>
                <MudText Typo="Typo.body1"><b>@_event.Title</b></MudText>
                <MudText Typo="Typo.body2">
                    @if (_event.IsAllDay)
                    {
                        @_event.Start.ToShortDateString() <span> - @Loc["All Day"]</span>
                    }
                    else
                    {
                        @_event.Start.ToString("g") <span> @Loc["To"].Value.ToLower() </span> @_event.End.ToString("t")
                    }
                </MudText>
            </CardHeaderContent>
            <CardHeaderActions>
                @if (_canAddToCalendar)
                {
                    <MudButton Color="Color.Primary" Variant="Variant.Filled" Size="Size.Small" StartIcon="@Icons.Material.Filled.Add" OnClick="AddToCalendar" Class="mt-2 text-nowrap">
                        @Loc["Add to Calendar"]
                    </MudButton>
                }
            </CardHeaderActions>
        </MudCardHeader>
        <MudCardContent Class="pt-0">
            @if (!string.IsNullOrWhiteSpace(_event.Location))
            {
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.LocationOn" Size="Size.Small" Color="Color.Default" />
                    <MudText Typo="Typo.body2">@_event.Location</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_organizer))
            {
                <div class="d-flex align-center gap-2 mb-2">
                    <MudIcon Icon="@Icons.Material.Filled.Person" Size="Size.Small" Color="Color.Default" />
                    <MudText Typo="Typo.body2">@Loc["Organizer"]: @_organizer</MudText>
                </div>
            }
            @if (!string.IsNullOrWhiteSpace(_event.Description))
            {
                <MudText Typo="Typo.body2" Class="mt-2" Style="white-space: pre-wrap; word-break: break-word;">@_event.Description</MudText>
            }
        </MudCardContent>
    }
    else if (_hasError)
    {
        <MudCardContent>
            <MudText Color="Color.Error" Typo="Typo.body2">@Loc["Could not display calendar event details."]</MudText>
        </MudCardContent>
    }
    else
    {
        <MudCardContent>
            <MudProgressCircular Indeterminate="true" Size="Size.Small" Color="Color.Primary" />
        </MudCardContent>
    }
</MudCard>

@code {
    [Parameter] public EmailAttachmentMeta Attachment { get; set; } = default!;
    [Parameter] public string MessageId { get; set; } = "";
    [Parameter] public string? AccountId { get; set; }
    [Parameter] public string EmployeeId { get; set; } = "";

    private CalendarEvent? _event;
    private string? _organizer;
    private bool _hasError;
    private bool _canAddToCalendar;
    private string? _lastAttachmentId;

    private async Task<Employee?> ResolveLiveActingEmployeeAsync()
    {
        var user = await UserService.GetEmployeeAsync();
        if (user != null) return Db.Employees.GetById(user.Id);
        return !string.IsNullOrEmpty(EmployeeId) ? Db.Employees.GetById(EmployeeId) : null;
    }

    protected override async Task OnParametersSetAsync()
    {
        var currentEmp = await ResolveLiveActingEmployeeAsync();
        _canAddToCalendar = CalendarService.CanCreateOrParticipateInCalendar(currentEmp)
            || CalendarService.HasCalendarAdminOverride(currentEmp);

        var effectiveAccountId = !string.IsNullOrEmpty(AccountId) ? AccountId : EmployeeId;
        if (Attachment == null || string.IsNullOrEmpty(effectiveAccountId)) return;
        if (Attachment.Id == _lastAttachmentId) return;
        
        _lastAttachmentId = Attachment.Id;
        _event = null;
        _organizer = null;
        _hasError = false;

        try
        {
            var path = CacheMaintenance.GetAttachmentPath(effectiveAccountId, MessageId, Attachment.Id);
            if (File.Exists(path))
            {
                var icsContent = await File.ReadAllTextAsync(path);
                var eventData = IcsParser.ParseFirstEvent(icsContent);

                if (eventData != null)
                {
                    _event = IcsParser.ToCalendarEvent(eventData, !string.IsNullOrEmpty(EmployeeId) ? EmployeeId : effectiveAccountId);
                    _organizer = eventData.Organizer;
                }
                else
                {
                    _hasError = true;
                }
            }
            else
            {
                _hasError = true;
            }
        }
        catch (Exception)
        {
            _hasError = true;
        }
    }

    private async Task AddToCalendar()
    {
        if (_event == null) return;

        var liveEmp = await ResolveLiveActingEmployeeAsync();
        if (liveEmp == null || (!CalendarService.CanCreateOrParticipateInCalendar(liveEmp) && !CalendarService.HasCalendarAdminOverride(liveEmp)))
        {
            Snackbar.Add(Loc["You do not have permission to create calendar events."].Value, Severity.Warning);
            return;
        }

        var parameters = new DialogParameters { ["Event"] = _event, ["IsNew"] = true };
        var options = new DialogOptions
        {
            MaxWidth = MaxWidth.Small,
            FullWidth = true,
            CloseButton = true,
            CloseOnEscapeKey = true
        };
        var dialog = await DialogService.ShowAsync<CalendarEventDialog>(Loc["New Event"], parameters, options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is CalendarEvent resultEvent)
        {
            var saveEmp = await ResolveLiveActingEmployeeAsync();
            if (saveEmp == null || (!CalendarService.CanCreateOrParticipateInCalendar(saveEmp) && !CalendarService.HasCalendarAdminOverride(saveEmp)))
            {
                Snackbar.Add(Loc["You do not have permission to create calendar events."].Value, Severity.Warning);
                return;
            }

            try
            {
                CalendarService.SaveEvent(resultEvent, saveEmp.Id);
                Snackbar.Add(Loc["Event added to calendar"], Severity.Success);
            }
            catch (UnauthorizedAccessException)
            {
                Snackbar.Add(Loc["You do not have permission to create calendar events."].Value, Severity.Warning);
            }
        }
    }
}
