        {
            EmailIdleService.StopWatching(_selectedFolder.AccountId, _selectedFolder.Path);
        }
    }

    private async Task SelectMessage(EmailMessage? msg)
    {
        if (msg != null && _selectedMessageId == msg.Id && !string.IsNullOrEmpty(_messageBody))
        {
            return;
        }
        if (msg == null)
        {
            _selectedMessageId = null;
            _selectedMessage = null;
            _messageBody = "";
            return;
        }

        if (_currentEmployee == null) return;

        // Check if Draft
        var msgFolder = _folders.FirstOrDefault(f => f.AccountId == msg.AccountId && f.Path == msg.FolderPath);
        if (_selectedNodeKey == "all-drafts" || (msgFolder != null && msgFolder.IsDrafts) || msg.FolderPath == "LocalDrafts")
        {
            if (IsReadOnly || !CanComposeEmail)
            {
                Snackbar.Add(Loc["Your account is currently in read-only mode."].Value, Severity.Warning);
                return;
            }
            if (!CanCurrentUserSeeDraft(msg))
            {
                Snackbar.Add(Loc["You do not have permission to open this draft."].Value, Severity.Error);
                return;
            }
            await OpenComposerDialog(draftId: msg.Id, accountId: msg.AccountId);
            return;
        }

        var currentVersion = ++_messageSelectionVersion;
        _selectedMessageId = msg.Id;
        _selectedMessage = msg;
        _isLoadingBody = true;
        _messageBody = "";
        StateHasChanged();

        if (_module != null)
        {
            try { await _module.InvokeVoidAsync("scrollToTopOfEmail"); } catch { }
        }

        try
        {
            var body = await CacheMaintenance.GetEmailBodyAsync(msg.AccountId, msg.Id);

            if (currentVersion != _messageSelectionVersion) return;

            _messageBody = body;
            _isLoadingBody = false;
            StateHasChanged();

            if (!msg.IsRead && LiveEmployee is { IsActiveUnsuspended: true } readActor)
            {
                msg.IsRead = true;
                if (msgFolder != null && msgFolder.UnreadCount > 0)
                {
                    msgFolder.UnreadCount--;
                }
                StateHasChanged();

                var callerId = readActor.Id;
                _ = Task.Run(async () =>
                {
                    try
                    {
                        await MessageLifecycleService.MarkMessageReadAsync(msg.AccountId, msg.Id, true, callerId);
                        await InvokeAsync(() =>
                        {
                            LoadFoldersAndInboxes();
                            StateHasChanged();
                        });
                    }
                    catch (Exception ex)
                    {
                        Logger.LogError(ex, "Failed to sync read flag to server for message {MessageId}", msg.Id);
                    }
                });
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Failed to load email body for message {MessageId}", msg.Id);
            if (currentVersion == _messageSelectionVersion)
            {
                _messageBody = "";
            }
        }
        finally
        {
            if (currentVersion == _messageSelectionVersion)
            {
                _isLoadingBody = false;
                StateHasChanged();
            }
        }
    }

