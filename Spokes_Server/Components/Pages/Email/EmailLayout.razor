    private async Task PrintMessage()
    {
        if (_selectedMessage == null || _module == null) return;

        var subject = _selectedMessage.Subject;
        var from = string.IsNullOrWhiteSpace(_selectedMessage.FromName) 
            ? _selectedMessage.FromAddress 
            : $"{_selectedMessage.FromName} <{_selectedMessage.FromAddress}>";
        var to = string.Join(", ", _selectedMessage.ToAddresses ?? []);
        var dateStr = FormatDate(_selectedMessage.Date);
        var sanitizedBody = EmailPrintSanitizer.SanitizeForPrint(_messageBody, _sessionAllowedRemoteImageMessageIds.Contains(_selectedMessage.Id));

        await _module.InvokeVoidAsync("printEmail",
            System.Net.WebUtility.HtmlEncode(subject ?? ""),
            System.Net.WebUtility.HtmlEncode(from),
            System.Net.WebUtility.HtmlEncode(to),
            System.Net.WebUtility.HtmlEncode(dateStr),
            sanitizedBody);
    }

    private async Task AddEmailToTimeline()
    {
        if (IsReadOnly || _selectedMessage == null || LiveEmployee is not { IsActiveUnsuspended: true } actor) return;
        if (!actor.HasPermission(AppPermissions.Email.Use) || !actor.HasPermission(AppPermissions.Projects.Edit))
        {
            Snackbar.Add("You do not have permission to add emails to project timelines.", Severity.Warning);
            return;
        }

        var parameters = new DialogParameters
        {
            { "Email", _selectedMessage },
            { "AccountId", _selectedMessage.AccountId }
        };

        var options = new DialogOptions { MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await _dialogService.ShowAsync<AddEmailToTimelineDialog>(Loc["Add Email to Timeline"], parameters, options);
        await dialog.Result;
    }
