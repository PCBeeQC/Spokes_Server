    private async Task OpenComposer()
    {
        if (!CanComposeEmail) return;
        string? targetAccountId = null;
        string? targetInboxId = null;
        string? targetIdentityId = null;

        if (_selectedInbox != null)
        {
            targetInboxId = _selectedInbox.Id;
            targetAccountId = _selectedInbox.AccountId;
            var backingAccount = _accounts.FirstOrDefault(a => a.Id == _selectedInbox.AccountId)
                                 ?? Db.EmailAccounts.GetById(_selectedInbox.AccountId);
            targetIdentityId = _currentEmployee != null
                ? InboxService.SelectDefaultIdentity(_currentEmployee, _selectedInbox, realInbox: backingAccount)?.Id
                : null;
        }
        else if (_selectedRealInbox != null)
        {
            targetAccountId = _selectedRealInbox.Id;
            targetIdentityId = _currentEmployee != null
                ? InboxService.SelectDefaultIdentity(_currentEmployee, realInbox: _selectedRealInbox)?.Id
                : null;
        }
        else if (_selectedFolder != null)
        {
            targetAccountId = _selectedFolder.AccountId;
            var parentAccount = _accounts.FirstOrDefault(a => a.Id == _selectedFolder.AccountId)
                                ?? Db.EmailAccounts.GetById(_selectedFolder.AccountId);
            targetIdentityId = _currentEmployee != null
                ? InboxService.SelectDefaultIdentity(_currentEmployee, realInbox: parentAccount)?.Id
                : null;
        }
        else
        {
            // Unified view ("all-inboxes", "all-mail", "all-unread", etc.)
            // Leave targetAccountId and targetInboxId as null so all accessible accounts and identities are available
            targetIdentityId = _currentEmployee != null
                ? InboxService.SelectDefaultIdentity(_currentEmployee)?.Id
                : null;
        }

        await OpenComposerDialog(
            accountId: targetAccountId,
            inboxId: targetInboxId,
            sendingIdentityId: targetIdentityId);
    }

    private async Task OpenComposerDialog(
        string? to = null,
        string? subject = null,
        string? body = null,
        string? draftId = null,
        string? accountId = null,
        string? inboxId = null,
        string? sendingIdentityId = null,
        string? inReplyTo = null,
        List<string>? references = null,
        List<string>? replyReceivingAddresses = null,
        List<ForwardedEmailAttachmentRef>? preloadedForwardedAttachments = null)
    {
        if (!CanComposeEmail) return;
        var parameters = new DialogParameters();
        if (to != null) parameters.Add("To", to);
        if (subject != null) parameters.Add("Subject", subject);
        if (body != null) parameters.Add("Body", body);
        if (draftId != null) parameters.Add("DraftId", draftId);
        if (accountId != null) parameters.Add("AccountId", accountId);
        if (inboxId != null) parameters.Add("InboxId", inboxId);
        if (sendingIdentityId != null) parameters.Add("SendingIdentityId", sendingIdentityId);
        if (inReplyTo != null) parameters.Add("InReplyTo", inReplyTo);
        if (references != null) parameters.Add("References", references);
        if (replyReceivingAddresses != null) parameters.Add("ReplyReceivingAddresses", replyReceivingAddresses);
        if (preloadedForwardedAttachments != null) parameters.Add("PreloadedForwardedAttachments", preloadedForwardedAttachments);

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
        var dialog = await _dialogService.ShowAsync<EmailComposer>(Loc["Compose Message"], parameters, options);
        await dialog.Result;

        LoadFoldersAndInboxes();
        LoadCurrentViewMessages();
        StateHasChanged();
    }

    private string GetCleanQuotedBody(string fullHtml)
    {
        if (string.IsNullOrWhiteSpace(fullHtml)) return "";

        var cleanHtml = fullHtml;
        var bodyMatch = System.Text.RegularExpressions.Regex.Match(cleanHtml, @"<body[^>]*>(.*?)</body>", System.Text.RegularExpressions.RegexOptions.Singleline | System.Text.RegularExpressions.RegexOptions.IgnoreCase);
        if (bodyMatch.Success)
        {
            cleanHtml = bodyMatch.Groups[1].Value;
        }

        cleanHtml = System.Text.RegularExpressions.Regex.Replace(cleanHtml, @"<script[^>]*>.*?</script>", "", System.Text.RegularExpressions.RegexOptions.Singleline | System.Text.RegularExpressions.RegexOptions.IgnoreCase);

        return cleanHtml;
    }

    private (string? InReplyTo, List<string> References) BuildReplyThreadingHeaders(EmailMessage message)
    {
        var inReplyTo = !string.IsNullOrWhiteSpace(message.GlobalMessageId) ? message.GlobalMessageId : null;
        var refs = new List<string>(message.References ?? []);
        if (!string.IsNullOrWhiteSpace(message.GlobalMessageId) && !refs.Contains(message.GlobalMessageId, StringComparer.OrdinalIgnoreCase))
        {
            refs.Add(message.GlobalMessageId);
        }
        return (inReplyTo, refs);
    }

    private async Task Reply()
    {
        if (!CanComposeEmail || _selectedMessage == null) return;
        var subject = _selectedMessage.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase)
            ? _selectedMessage.Subject
            : $"Re: {_selectedMessage.Subject}";

        var replyTarget = _selectedMessage.ReplyToAddresses.FirstOrDefault() ?? _selectedMessage.FromAddress;
        var dateStr = FormatDate(_selectedMessage.Date);
        var cleanQuote = GetCleanQuotedBody(_messageBody);
        var body = $"On {dateStr}, {_selectedMessage.FromName} wrote:<br><blockquote style=\"margin: 0 0 0 .8ex; border-left: 1px #ccc solid; padding-left: 1ex;\">{cleanQuote}</blockquote>";
        var (inReplyTo, refs) = BuildReplyThreadingHeaders(_selectedMessage);

        await OpenComposerDialog(
            to: replyTarget,
            subject: subject,
            body: body,
            accountId: _selectedMessage.AccountId,
            inboxId: _selectedInbox?.Id,
            inReplyTo: inReplyTo,
            references: refs,
            replyReceivingAddresses: _selectedMessage.ReceivingAddresses);
    }

    private async Task ReplyAll()
    {
        if (!CanComposeEmail || _selectedMessage == null) return;
        var subject = _selectedMessage.Subject.StartsWith("Re:", StringComparison.OrdinalIgnoreCase)
            ? _selectedMessage.Subject
            : $"Re: {_selectedMessage.Subject}";

        var replyTarget = _selectedMessage.ReplyToAddresses.FirstOrDefault() ?? _selectedMessage.FromAddress;
        var selfAddresses = new HashSet<string>(
            _selectedMessage.ReceivingAddresses.Concat([_currentEmployee?.Email ?? ""]),
            StringComparer.OrdinalIgnoreCase);

        List<string> toList = [replyTarget];
        toList.AddRange(_selectedMessage.ToAddresses.Where(a => !selfAddresses.Contains(a)));
        var to = string.Join(", ", toList.Distinct(StringComparer.OrdinalIgnoreCase));

        var dateStr = FormatDate(_selectedMessage.Date);
        var cleanQuote = GetCleanQuotedBody(_messageBody);
        var body = $"On {dateStr}, {_selectedMessage.FromName} wrote:<br><blockquote style=\"margin: 0 0 0 .8ex; border-left: 1px #ccc solid; padding-left: 1ex;\">{cleanQuote}</blockquote>";
        var (inReplyTo, refs) = BuildReplyThreadingHeaders(_selectedMessage);

        await OpenComposerDialog(
            to: to,
            subject: subject,
            body: body,
            accountId: _selectedMessage.AccountId,
            inboxId: _selectedInbox?.Id,
            inReplyTo: inReplyTo,
            references: refs,
            replyReceivingAddresses: _selectedMessage.ReceivingAddresses);
    }

    private async Task Forward()
    {
        if (!CanComposeEmail || _selectedMessage == null) return;
        var subject = $"Fwd: {_selectedMessage.Subject}";
        var cleanQuote = GetCleanQuotedBody(_messageBody);
        var dateStr = FormatDate(_selectedMessage.Date);
        var body = $"---------- Forwarded message ---------<br>From: {_selectedMessage.FromName} &lt;{_selectedMessage.FromAddress}&gt;<br>Date: {dateStr}<br>Subject: {_selectedMessage.Subject}<br><br>{cleanQuote}";

        List<ForwardedEmailAttachmentRef> preloadedForwardedAttachments = [];
        if (_selectedMessage.HasAttachments)
        {
            foreach (var att in _selectedMessage.Attachments)
            {
                if (string.IsNullOrWhiteSpace(att.Id)) continue;
                var path = CacheMaintenance.GetAttachmentPath(_selectedMessage.AccountId, _selectedMessage.Id, att.Id);
                if (System.IO.File.Exists(path))
                {
                    preloadedForwardedAttachments.Add(new ForwardedEmailAttachmentRef(
                        _selectedMessage.AccountId,
                        _selectedMessage.Id,
                        att.Id,
                        att.FileName));
                }
            }
        }

        await OpenComposerDialog(
            subject: subject,
            body: body,
            accountId: _selectedMessage.AccountId,
            inboxId: _selectedInbox?.Id,
            replyReceivingAddresses: _selectedMessage.ReceivingAddresses,
            preloadedForwardedAttachments: preloadedForwardedAttachments);
    }

    private async Task MarkAsUnread()
    {
        if (_selectedMessage == null) return;
        await MarkMessageAsUnread(_selectedMessage);
    }

    private async Task MarkMessageAsUnread(EmailMessage msg)
    {
        if (IsReadOnly || LiveEmployee is not { IsActiveUnsuspended: true } actor || msg == null) return;

        msg.IsRead = false;
        var msgId = msg.Id;

        if (_selectedMessageId == msgId)
        {
            _selectedMessageId = null;
            _selectedMessage = null;
            _messageBody = "";
        }

        await MessageLifecycleService.MarkMessageReadAsync(msg.AccountId, msgId, false, actor.Id);
        LoadFoldersAndInboxes();
        StateHasChanged();
    }

    private bool HasNextMessage
    {
        get
        {
            if (_selectedMessageId == null) return false;
            var idx = _messages.FindIndex(m => m.Id == _selectedMessageId);
            return idx >= 0 && idx < _messages.Count - 1;
        }
    }

    private bool HasPreviousMessage
    {
        get
        {
            if (_selectedMessageId == null) return false;
            var idx = _messages.FindIndex(m => m.Id == _selectedMessageId);
            return idx > 0;
        }
    }

    private async Task SelectNextMessage()
    {
        if (_selectedMessageId == null) return;
        var idx = _messages.FindIndex(m => m.Id == _selectedMessageId);
        if (idx >= 0 && idx < _messages.Count - 1)
        {
            await SelectMessage(_messages[idx + 1]);
        }
    }

    private async Task SelectPreviousMessage()
    {
        if (_selectedMessageId == null) return;
        var idx = _messages.FindIndex(m => m.Id == _selectedMessageId);
        if (idx > 0)
        {
            await SelectMessage(_messages[idx - 1]);
        }
    }

    private string FormatDate(DateTimeOffset date) =>
        TimeZoneHelper.ConvertOffsetToLocalTime(_timeZoneId, date).ToString("g");

    private EmailMessage? GetAdjacentMessage(EmailMessage current)
    {
        var idx = _messages.FindIndex(m => m.Id == current.Id);
        if (idx < 0) return null;

        if (idx + 1 < _messages.Count)
            return _messages[idx + 1];

        if (idx > 0)
            return _messages[idx - 1];

        return null;
    }

    private bool CanCurrentUserMutateSelectedMessage()
    {
        if (_selectedMessage == null || LiveEmployee is not { IsActiveUnsuspended: true })
            return false;
        return CanCurrentUserAccessMessageInUi(_selectedMessage);
    }

    private async Task MoveFolderTo(string destFolderPath)
    {
        if (!CanCurrentUserMutateSelectedMessage() || !CanBrowseFullAccount(_selectedMessage!.AccountId) || string.IsNullOrEmpty(destFolderPath)) return;
        var actorId = LiveEmployee!.Id;

        var accountId = _selectedMessage!.AccountId;
        var msgId = _selectedMessage.Id;
        var nextMessage = GetAdjacentMessage(_selectedMessage);

        _messages.Remove(_selectedMessage);
        await SelectMessage(nextMessage);

        await MessageLifecycleService.MoveMessageAsync(accountId, msgId, destFolderPath, actorId);

        LoadFoldersAndInboxes();
        LoadCurrentViewMessages();
        StateHasChanged();
    }

    private async Task DeleteMessage()
    {
        if (!CanCurrentUserMutateSelectedMessage()) return;
        var actorId = LiveEmployee!.Id;

        var selected = _selectedMessage!;
        var accountId = selected.AccountId;
        var msgId = selected.Id;
        var nextMessage = GetAdjacentMessage(selected);

        _messages.Remove(selected);
        await SelectMessage(nextMessage);

        if (string.Equals(selected.FolderPath, "LocalDrafts", StringComparison.OrdinalIgnoreCase))
        {
            await EmailDraftService.DeleteDraftAsync(accountId, msgId, actorId);
        }
        else
        {
            await MessageLifecycleService.MoveMessageToTrashAsync(accountId, msgId, actorId);
        }
        LoadFoldersAndInboxes();
        StateHasChanged();
    }

