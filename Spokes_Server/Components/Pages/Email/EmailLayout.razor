@page "/email"
@page "/email/{FolderId}"
@page "/email/{FolderId}/{MessageId}"
@using Microsoft.AspNetCore.Components.Authorization
@using Spokes_Server.Core.Constants
@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Dialogs.Communication.Email
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Services.Communication.Email
@attribute [Authorize(Policy = AppPermissions.Email.Use)]
@inject IEmailSyncService EmailSyncService
@inject IEmailMessageLifecycleService MessageLifecycleService
@inject IEmailDraftService EmailDraftService
@inject IEmailCacheMaintenanceService CacheMaintenance
@inject IEmailInboxService InboxService
@inject UserService UserService
@inject Database Db
@inject EmailIdleService EmailIdleService
@inject EmailNotificationService EmailNotifications
@inject EmailSyncStateService SyncStateService
@inject IDialogService _dialogService
@inject NavigationManager Nav
@inject IJSRuntime JS
@inject ISnackbar Snackbar
@inject ILogger<EmailLayout> Logger
@inject IStringLocalizer<AppResources> Loc
@implements IDisposable

<PageTitle>@Loc["Email"]</PageTitle>

<!-- Main Layout Container -->
<div class="d-flex flex-row flex-grow-1 w-100 email-main-layout @(IsMobileReading ? "email-mobile-reading" : "")">

    <!-- Left Pane: Sidebar (Unified Views, Inboxes, Mailboxes & Folders) -->
    <div class="@SidebarClass email-sidebar-container">
        <EmailSidebar Inboxes="_inboxes"
                      InboxUnreadCounts="_inboxUnreadCounts"
                      RealInboxUnreadCounts="_realInboxUnreadCounts"
                      AllInboxesUnreadCount="_allInboxesUnreadCount"
                      Accounts="_accounts"
                      Folders="_folders"
                      SelectedNodeKey="@_selectedNodeKey"
                      SelectedFolderId="@_selectedFolder?.Id"
                      OnSelectView="SelectUnifiedView"
                      OnSelectRealInbox="SelectRealInbox"
                      OnSelectInbox="SelectInbox"
                      OnSelectFolder="SelectFolder"
                      OnCompose="OpenComposer"
                      OnRepairAttachments="RepairAttachments"
                      OnFoldersChanged="HandleFoldersAndInboxesChanged"
                      IsRepairing="_isRepairing" />
    </div>

    <!-- Middle Pane: Message List -->
    <div class="@ListClass email-list-container">
        <EmailList Messages="_messages"
                   CurrentAccountId="@CurrentBrowsableAccountId"
                   CurrentAccountFolders="@CurrentAccountFolders"
                   SelectedFolder="@_selectedFolder"
                   OnSelectFolder="SelectFolder"
                   OnFoldersChanged="HandleFoldersAndInboxesChanged"
                   FolderName="@CurrentViewTitle"
                   FolderSubtitle="@CurrentViewSubtitle"
                   OnGoBack="@(() => { _showMobileFolders = true; StateHasChanged(); })"
                   OnCompose="OpenComposer"
                   OnRefresh="HandleRefreshAsync"
                   IsRefreshing="_isRefreshing"
                   IsReadOnly="@IsReadOnly"
                   SelectedMessageId="@_selectedMessageId"
                   SearchText="@_searchText"
                   HasMoreMessages="_hasMoreMessages"
                   IsLoadingOlder="_isLoadingOlder"
                   SearchAllFolders="@_searchAllFolders"
                   IsSearching="@_isSearching"
                   SearchProcessedCount="@_searchProcessedCount"
                   SearchTotalCount="@_searchTotalCount"
                   TimeZoneId="@_timeZoneId"
                   OnSelectMessage="SelectMessage"
                   OnSearch="HandleSearch"
                   OnSearchAllFoldersChanged="HandleSearchScopeChanged"
                   OnToggleFlag="ToggleFlag"
                   OnMarkAsUnread="MarkMessageAsUnread" />
    </div>

    <!-- Right Pane: Reader -->
    <div class="@ReaderClass flex-grow-1 email-reader-container" style="min-width: 0;">
        <EmailReader SelectedMessage="_selectedMessage"
                     MessageBody="@_messageBody"
                     IsLoadingBody="_isLoadingBody"
                     TimeZoneId="@_timeZoneId"
                     Folders="_folders"
                     CurrentFolderPath="@(_selectedMessage?.FolderPath ?? _selectedFolder?.Path)"
                     AccountId="@(_selectedMessage?.AccountId ?? _selectedRealInbox?.Id ?? _selectedFolder?.AccountId ?? _selectedInbox?.AccountId)"
                     EmployeeId="@_currentEmployee?.Id"
                     IsReadOnly="@IsReadOnly"
                     ShowFolderActions="@CanBrowseFullAccount(_selectedMessage?.AccountId)"
                     AllowedRemoteImageMessageIds="_sessionAllowedRemoteImageMessageIds"
                     OnRemoteImagesAllowed="HandleRemoteImagesAllowed"
                     OnClose="@(() => SelectMessage(null))"
                     OnToggleFlag="ToggleFlag"
                     OnDownloadAttachment="DownloadAttachment"
                     OnMarkAsUnread="MarkAsUnread"
                     OnMoveTo="MoveFolderTo"
                     OnInboxCreated="HandleFoldersAndInboxesChanged"
                     OnReply="Reply"
                     OnReplyAll="ReplyAll"
                     OnForward="Forward"
                     OnDelete="DeleteMessage"
                     OnArchive="ArchiveMessage"
                     OnJunk="JunkMessage"
                     OnPrint="PrintMessage"
                     CanAddToTimeline="@(!IsReadOnly && _canAddToTimeline)"
                     OnAddToTimeline="AddEmailToTimeline"
                     HasNextMessage="HasNextMessage"
                     HasPreviousMessage="HasPreviousMessage"
                     OnNextMessage="SelectNextMessage"
                     OnPreviousMessage="SelectPreviousMessage"
                      IsDarkMode="@(_currentEmployee?.IsDarkMode ?? true)" />
    </div>

</div>

@code {
    [Parameter] public string? FolderId { get; set; }
    [Parameter] public string? MessageId { get; set; }

    private string? _selectedNodeKey;
    private EmailAccount? _selectedRealInbox;
    private EmailInbox? _selectedInbox;
    private EmailFolder? _selectedFolder;
    private string? _selectedMessageId;
    private bool _showMobileFolders;

    // Responsive Visibility Logic
    private string SidebarClass
    {
        get
        {
            if (_selectedMessageId != null) return "d-none d-md-block";
            if (_showMobileFolders) return "d-block";
            return "d-none d-md-block";
        }
    }

    private string ListClass
    {
        get
        {
            if (_selectedMessageId != null) return "d-none d-md-block";
            if (_showMobileFolders) return "d-none d-md-block";
            return "d-block";
        }
    }

    private string ReaderClass =>
        (_selectedMessageId == null ? "d-none d-md-block" : "d-block");

    private bool IsMobileReading => _selectedMessageId != null;

    private List<EmailAccount> _accounts = [];
    private List<EmailInbox> _inboxes = [];
    private Dictionary<string, int> _inboxUnreadCounts = new();
    private Dictionary<string, int> _realInboxUnreadCounts = new();
    private int _allInboxesUnreadCount;
    private List<EmailFolder> _folders = [];
    private List<EmailMessage> _messages = [];
    private EmailMessage? _selectedMessage;

    private Employee? _currentEmployee;
    private Employee? LiveEmployee => _currentEmployee != null ? (Db.Employees.GetById(_currentEmployee.Id) ?? _currentEmployee) : null;
    private bool IsReadOnly => LiveEmployee is not { IsActiveUnsuspended: true };
    private bool CanComposeEmail => !IsReadOnly &&
                                    !string.Equals(Db.CompanyProfile.Get()?.Edition, "Family", StringComparison.OrdinalIgnoreCase) &&
                                    (LiveEmployee?.HasPermission(AppPermissions.Email.Use) ?? false);
    private string _searchText = "";
    private bool _searchAllFolders;
    private string _messageBody = "";
    private bool _isLoadingBody;
    private string _timeZoneId = "";
    private bool _canAddToTimeline;
    private bool _isRefreshing;
    private int _messageSelectionVersion;

    // Search state
    private bool _isSearching;
    private int _searchProcessedCount;
    private int _searchTotalCount;
    private CancellationTokenSource? _searchCts;

    // JS Interop
    private IJSObjectReference? _module;
    private DotNetObjectReference<EmailLayout>? _objRef;

    private List<EmailFolder> CurrentAccountFolders
    {
        get
        {
            var accountId = CurrentBrowsableAccountId;
            if (string.IsNullOrEmpty(accountId)) return [];
            return _folders
                .Where(f => f.AccountId == accountId && f.Path != "LocalDrafts")
                .OrderByDescending(f => f.IsInbox && string.IsNullOrEmpty(f.ParentPath))
                .ThenBy(f => f.Name)
                .ToList();
        }
    }

    private string CurrentViewTitle => _selectedNodeKey switch
    {
        "all-inboxes" => Loc["All Inboxes"],
        "all-mail" => Loc["All"],
        "all-unread" => Loc["Unread"],
        "all-flagged" => Loc["Starred"],
        "all-sent" => Loc["Sent"],
        "all-drafts" => Loc["Drafts"],
        "all-archive" => Loc["Archive"],
        "all-junk" => Loc["Spam"],
        "all-trash" => Loc["Trash"],
        _ when _selectedRealInbox != null => _selectedRealInbox.Name,
        _ when _selectedInbox != null => _selectedInbox.Name,
        _ when _selectedFolder != null => _selectedFolder.Name,
        _ => Loc["Messages"]
    };

    private string? CurrentViewSubtitle
    {
        get
        {
            if (_selectedRealInbox != null)
            {
                return _selectedRealInbox.IsArchived
                    ? $"{_selectedRealInbox.EmailAddress} • {Loc["Archived"].Value}"
                    : _selectedRealInbox.EmailAddress;
            }
            if (_selectedInbox != null)
            {
                return string.Join(", ", _selectedInbox.TargetAddresses);
            }
            if (_selectedFolder != null)
            {
                var acc = _accounts.FirstOrDefault(a => a.Id == _selectedFolder.AccountId)
                          ?? GetBrowsableAccount(_selectedFolder.AccountId);
                if (acc == null) return null;
                return acc.IsArchived
                    ? $"{acc.EmailAddress} • {Loc["Archived"].Value}"
                    : acc.EmailAddress;
            }
            return null;
        }
    }

    private EmailAccount? GetBrowsableAccount(string? accountId)
    {
        if (string.IsNullOrWhiteSpace(accountId) || _currentEmployee == null) return null;
        var accessible = InboxService.GetAccessibleRealInboxes(_currentEmployee, includeArchived: true)
            .FirstOrDefault(a => string.Equals(a.Id, accountId, StringComparison.OrdinalIgnoreCase));
        if (accessible != null) return accessible;

        if (_currentEmployee.IsAdmin)
        {
            var account = Db.EmailAccounts.GetById(accountId);
            if (account is { IsServerManaged: true }) return account;
        }
        return null;
    }

    private bool CanBrowseFullAccount(string? accountId) => GetBrowsableAccount(accountId) != null;

    private string CurrentBrowsableAccountId =>
        CanBrowseFullAccount(_selectedRealInbox?.Id ?? _selectedFolder?.AccountId)
            ? (_selectedRealInbox?.Id ?? _selectedFolder?.AccountId ?? "")
            : "";

    private readonly HashSet<string> _sessionAllowedRemoteImageMessageIds = new(StringComparer.OrdinalIgnoreCase);

    private void HandleRemoteImagesAllowed(string messageId)
    {
        if (!string.IsNullOrWhiteSpace(messageId))
            _sessionAllowedRemoteImageMessageIds.Add(messageId);
    }

    protected override async Task OnParametersSetAsync()
    {
        if (_currentEmployee == null)
        {
            _currentEmployee = await UserService.GetEmployeeAsync();
            if (_currentEmployee == null) return;

            var profile = Db.CompanyProfile.Get();
            if (string.Equals(profile?.Edition, "Family", StringComparison.OrdinalIgnoreCase)
                || !_currentEmployee.HasPermission(AppPermissions.Email.Use))
            {
                Nav.NavigateTo("/");
                return;
            }
            _timeZoneId = profile?.TimeZoneId ?? "";

            _canAddToTimeline = _currentEmployee.HasPermission(AppPermissions.Email.Use) &&
                            _currentEmployee.HasPermission(AppPermissions.Projects.Edit);

            SyncStateService.OnNewEmailReceived += HandleRealtimeNewEmail;
            SyncStateService.OnUnreadCountChanged += HandleRealtimeUnreadCountChanged;
            Db.EmailMessages.OnSaved += HandleRealtimeMessageSaved;
            EmailNotifications.OnUnreadCountChanged += OnUnreadCountChanged;

            LoadFoldersAndInboxes();
        }

        EmailNotifications.MarkEmailPageVisited();

        if (!string.IsNullOrEmpty(FolderId))
        {
            if (_selectedNodeKey != FolderId &&
                _selectedNodeKey != $"inbox:{FolderId.Replace("inbox-", "")}" &&
                _selectedNodeKey != $"real:{FolderId.Replace("real-", "")}")
            {
                if (!ApplyRouteSelection(FolderId))
                {
                    SelectDefaultView();
                }
            }
        }
        else if (_selectedNodeKey == null)
        {
            SelectDefaultView();
        }

        if (MessageId != null && _selectedMessageId != MessageId)
        {
            var msg = _messages.FirstOrDefault(m => m.Id == MessageId);
            if (msg != null) await SelectMessage(msg);
        }
    }

    private bool ApplyRouteSelection(string routeKey)
    {
        if (routeKey is "all-inboxes" or "all-mail" or "all-unread" or "all-flagged" or "all-sent" or "all-drafts" or "all-archive" or "all-junk" or "all-trash")
        {
            SelectUnifiedView(routeKey, updateUrl: false);
            return true;
        }

        if (routeKey.StartsWith("real-", StringComparison.OrdinalIgnoreCase))
        {
            var accountId = routeKey.Substring("real-".Length);
            var account = _accounts.FirstOrDefault(a => a.Id == accountId) ?? GetBrowsableAccount(accountId);
            if (account != null)
            {
                EnsureAccountFoldersLoaded(account.Id);
                SelectRealInbox(account, updateUrl: false);
                return true;
            }
        }

        if (routeKey.StartsWith("inbox-", StringComparison.OrdinalIgnoreCase))
        {
            var inboxId = routeKey.Substring("inbox-".Length);
            var inbox = _inboxes.FirstOrDefault(i => i.Id == inboxId);
            if (inbox != null)
            {
                SelectInbox(inbox, updateUrl: false);
                return true;
            }
        }

        var folder = _folders.FirstOrDefault(f => f.Id == routeKey);
        if (folder != null)
        {
            if (CanBrowseFullAccount(folder.AccountId))
            {
                SelectFolder(folder, updateUrl: false);
                return true;
            }
        }

        return false;
    }

    private void SelectDefaultView()
    {
        if (_accounts.Count == 1 && _inboxes.Count == 0)
        {
            SelectRealInbox(_accounts[0], updateUrl: false);
        }
        else if (_inboxes.Any() || _accounts.Any())
        {
            SelectUnifiedView("all-inboxes", updateUrl: false);
        }
        else if (_folders.Any())
        {
            var inbox = _folders.FirstOrDefault(f => f.IsInbox) ?? _folders.First();
            SelectFolder(inbox, updateUrl: false);
        }
    }

    private void HandleFoldersAndInboxesChanged()
    {
        LoadFoldersAndInboxes();
        LoadCurrentViewMessages();
        StateHasChanged();
    }

    private void OnUnreadCountChanged()
    {
        InvokeAsync(() =>
        {
            LoadFoldersAndInboxes();
            StateHasChanged();
        });
    }

    private async Task HandleRefreshAsync()
    {
        if (IsReadOnly || _isRefreshing) return;

        _isRefreshing = true;
        StateHasChanged();

        try
        {
            await Task.Run(async () =>
            {
                if (_selectedFolder != null)
                {
                    await EmailSyncService.SyncSingleFolderAsync(_selectedFolder.AccountId, _selectedFolder.Path);
                }
                else if (_selectedRealInbox != null)
                {
                    var inboxFolder = _folders.FirstOrDefault(f => f.AccountId == _selectedRealInbox.Id && f.IsInbox);
                    var folderPath = inboxFolder?.Path ?? "INBOX";
                    await EmailSyncService.SyncSingleFolderAsync(_selectedRealInbox.Id, folderPath);
                }
                else if (_selectedInbox != null)
                {
                    var inboxFolder = _folders.FirstOrDefault(f => f.AccountId == _selectedInbox.AccountId && f.IsInbox);
                    var folderPath = inboxFolder?.Path ?? "INBOX";
                    await EmailSyncService.SyncSingleFolderAsync(_selectedInbox.AccountId, folderPath);
                }
                else
                {
                    await SyncAccessibleAccountInboxesAsync();
                }
            });

            LoadFoldersAndInboxes();
            LoadCurrentViewMessages();
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "Error refreshing email inbox");
            Snackbar.Add(Loc["Failed to refresh email"], Severity.Warning);
        }
        finally
        {
            _isRefreshing = false;
            StateHasChanged();
        }
    }

    private bool CanCurrentUserSeeDraft(EmailMessage message)
    {
        if (_currentEmployee == null) return false;

        if (string.Equals(message.FolderPath, "LocalDrafts", StringComparison.OrdinalIgnoreCase))
        {
            return InboxService.CanEmployeeAccessLocalDraft(message, _currentEmployee.Id);
        }

        // External IMAP-synced Drafts folder (non-LocalDrafts) requires full Real Inbox access.
        return _accounts.Any(a => string.Equals(a.Id, message.AccountId, StringComparison.OrdinalIgnoreCase));
    }

    private bool CanCurrentUserAccessMessageInUi(EmailMessage message)
    {
        if (_currentEmployee == null) return false;

        if (string.Equals(message.FolderPath, "LocalDrafts", StringComparison.OrdinalIgnoreCase))
        {
            return CanCurrentUserSeeDraft(message);
        }

        var msgFolder = _folders.FirstOrDefault(f =>
            string.Equals(f.AccountId, message.AccountId, StringComparison.OrdinalIgnoreCase) &&
            string.Equals(f.Path, message.FolderPath, StringComparison.OrdinalIgnoreCase));
        if (msgFolder is { IsDrafts: true })
        {
            return CanCurrentUserSeeDraft(message);
        }

        if (CanBrowseFullAccount(message.AccountId))
        {
            return true;
        }

        if (!InboxService.IsPrimaryRootInboxMessage(message))
        {
            return false;
        }

        return _inboxes.Any(i =>
            string.Equals(i.AccountId, message.AccountId, StringComparison.OrdinalIgnoreCase) &&
            InboxService.DoesMessageMatchInbox(message, i));
    }

    private void HandleRealtimeNewEmail(string accountId, EmailMessage message)
    {
        if (_currentEmployee == null) return;
        if (!CanCurrentUserAccessMessageInUi(message)) return;

        var authorizedUsers = InboxService.GetAuthorizedEmployeeIdsForMessage(message);
        if (!authorizedUsers.Contains(_currentEmployee.Id, StringComparer.OrdinalIgnoreCase))
            return;

        _ = InvokeAsync(() =>
        {
            LoadFoldersAndInboxes();

            if (!_isSearching && string.IsNullOrWhiteSpace(_searchText))
            {
                bool isLocalDraft = string.Equals(message.FolderPath, "LocalDrafts", StringComparison.OrdinalIgnoreCase);
                bool matchesCurrentView = false;
                if (_selectedNodeKey == "all-inboxes")
                {
                    matchesCurrentView = !isLocalDraft && InboxService.IsPrimaryRootInboxMessage(message);
                }
                else if (_selectedNodeKey is "all-mail" or "all-unread")
                {
                    matchesCurrentView = !isLocalDraft
                        && (_selectedNodeKey != "all-unread" || !message.IsRead)
                        && (CanBrowseFullAccount(message.AccountId) || InboxService.IsPrimaryRootInboxMessage(message));
                }
                else if (_selectedRealInbox != null)
                {
                    matchesCurrentView = !isLocalDraft
                        && string.Equals(message.AccountId, _selectedRealInbox.Id, StringComparison.OrdinalIgnoreCase)
                        && CanBrowseFullAccount(message.AccountId);
                }
                else if (_selectedInbox != null)
                {
                    if (!isLocalDraft
                        && string.Equals(message.AccountId, _selectedInbox.AccountId, StringComparison.OrdinalIgnoreCase)
                        && (CanBrowseFullAccount(message.AccountId) || InboxService.IsPrimaryRootInboxMessage(message)))
                    {
                        var filter = InboxService.GetMetadataFilterForInbox(_selectedInbox);
                        var meta = new Spokes_Server.Core.Data.Repositories.Communication.MessageMetadata
                        {
                            Id = message.Id,
                            ReceivingAddresses = message.ReceivingAddresses ?? []
                        };
                        matchesCurrentView = filter == null || filter(meta);
                    }
                }
                else if (_selectedFolder != null)
                {
                    matchesCurrentView = string.Equals(message.AccountId, _selectedFolder.AccountId, StringComparison.OrdinalIgnoreCase)
                        && string.Equals(message.FolderPath, _selectedFolder.Path, StringComparison.OrdinalIgnoreCase);
                }

                if (matchesCurrentView)
                {
                    if (!_messages.Any(m => m.Id == message.Id))
                    {
                        _messages.Insert(0, message);
                    }
                }
            }

            StateHasChanged();
        });
    }

    private void HandleRealtimeMessageSaved(EmailMessage saved)
    {
        if (_currentEmployee == null) return;
        if (!CanCurrentUserAccessMessageInUi(saved)) return;

        _ = InvokeAsync(() =>
        {
            if (_selectedMessageId == saved.Id)
            {
                _selectedMessage = saved;
            }

            var index = _messages.FindIndex(m => m.Id == saved.Id);
            if (index >= 0)
            {
                if (_selectedNodeKey == "all-unread" && saved.IsRead)
                {
                    _messages.RemoveAt(index);
                }
                else
                {
                    _messages[index] = saved;
                }
                StateHasChanged();
            }
        });
    }

    private void HandleRealtimeUnreadCountChanged(string accountId)
    {
        if (_currentEmployee == null) return;

        _ = InvokeAsync(() =>
        {
            LoadFoldersAndInboxes();
            StateHasChanged();
        });
    }

    public void Dispose()
    {
        if (_selectedFolder != null && !_selectedFolder.IsInbox)
        {
            EmailIdleService.StopWatching(_selectedFolder.AccountId, _selectedFolder.Path);
        }

        _searchCts?.Cancel();
        _searchCts?.Dispose();

        SyncStateService.OnNewEmailReceived -= HandleRealtimeNewEmail;
        SyncStateService.OnUnreadCountChanged -= HandleRealtimeUnreadCountChanged;
        Db.EmailMessages.OnSaved -= HandleRealtimeMessageSaved;
        EmailNotifications.OnUnreadCountChanged -= OnUnreadCountChanged;

        EmailNotifications.MarkEmailPageVisited();

        _objRef?.Dispose();
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _objRef = DotNetObjectReference.Create(this);
                _module = await JS.InvokeAsync<IJSObjectReference>("import", $"./{Assets.Bypassed("Components/Pages/Email/EmailLayout.razor.js")}");
            }
            catch { /* Ignore */ }
        }

        if (_messages.Any() && _module != null && _hasMoreMessages)
        {
            try
            {
                await _module.InvokeVoidAsync("initInfiniteScroll", "email-message-list", "email-list-sentinel", _objRef);
            }
            catch { /* Ignore */ }
        }
    }

    [JSInvokable]
    public async Task LoadOlderMessagesJS()
    {
        await LoadOlderMessages();
    }

    private void LoadFoldersAndInboxes()
    {
        if (_currentEmployee == null) return;

        _accounts = InboxService.GetAccessibleRealInboxes(_currentEmployee);
        _inboxes = InboxService.GetAccessibleInboxes(_currentEmployee);

        _realInboxUnreadCounts.Clear();
        foreach (var account in _accounts)
        {
            _realInboxUnreadCounts[account.Id] = InboxService.GetUnreadCountForRealInbox(account.Id);
        }

        _inboxUnreadCounts.Clear();
        foreach (var inbox in _inboxes)
        {
            _inboxUnreadCounts[inbox.Id] = InboxService.GetUnreadCountForInbox(inbox);
        }

        _folders = [];
        var allAccessibleAccounts = InboxService.GetAccessibleAccounts(_currentEmployee, includeArchived: true);
        foreach (var account in allAccessibleAccounts)
        {
            EnsureAccountFoldersLoaded(account.Id);
        }
        if (_selectedRealInbox != null)
        {
            EnsureAccountFoldersLoaded(_selectedRealInbox.Id);
        }
        if (_selectedFolder != null)
        {
            EnsureAccountFoldersLoaded(_selectedFolder.AccountId);
        }

        _allInboxesUnreadCount = InboxService.GetTotalUnreadCountForUser(_currentEmployee.Id);
    }

    private void EnsureAccountFoldersLoaded(string accountId)
    {
        if (string.IsNullOrWhiteSpace(accountId) || _folders.Any(f => string.Equals(f.AccountId, accountId, StringComparison.OrdinalIgnoreCase)))
            return;

        var accountFolders = Db.EmailFolders.GetByAccount(accountId);
        if (!CanBrowseFullAccount(accountId))
        {
            var rootInbox = accountFolders.FirstOrDefault(f => f.IsInbox && string.IsNullOrEmpty(f.ParentPath))
                            ?? accountFolders.FirstOrDefault(f => f.Path.Equals("INBOX", StringComparison.OrdinalIgnoreCase));
            accountFolders = accountFolders
                .Where(f => ReferenceEquals(f, rootInbox) || string.Equals(f.Path, "LocalDrafts", StringComparison.OrdinalIgnoreCase))
                .ToList();
        }
        foreach (var folder in accountFolders)
        {
            folder.UnreadCount = Db.EmailMessages.GetUnreadCount(accountId, folder.Path);
        }
        _folders.AddRange(accountFolders);
    }

    private List<(string AccountId, string FolderPath, Func<Spokes_Server.Core.Data.Repositories.Communication.MessageMetadata, bool>? FolderFilter)> GetUnifiedViewFolderScopes()
    {
        var scopes = new List<(string AccountId, string FolderPath, Func<Spokes_Server.Core.Data.Repositories.Communication.MessageMetadata, bool>? FolderFilter)>();
        var realAccountIds = _accounts.Select(a => a.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);

        foreach (var folder in _folders)
        {
            if (!realAccountIds.Contains(folder.AccountId)) continue;
            if (folder.IsTrash || folder.IsJunk || folder.IsDrafts || folder.Path == "LocalDrafts") continue;
            scopes.Add((folder.AccountId, folder.Path, null));
        }

        foreach (var inbox in _inboxes)
        {
            if (realAccountIds.Contains(inbox.AccountId)) continue;
            var inboxFolder = _folders.FirstOrDefault(f => f.AccountId == inbox.AccountId && f.IsInbox && string.IsNullOrEmpty(f.ParentPath))
                              ?? _folders.FirstOrDefault(f => f.AccountId == inbox.AccountId && f.Path.Equals("INBOX", StringComparison.OrdinalIgnoreCase));
            if (inboxFolder != null)
            {
                scopes.Add((inbox.AccountId, inboxFolder.Path, InboxService.GetMetadataFilterForInbox(inbox)));
            }
        }

        return scopes;
    }

    private void LoadCurrentViewMessages()
    {
        if (_currentEmployee == null || _selectedNodeKey == null) return;

        if (_selectedNodeKey == "all-inboxes")
        {
            _messages = InboxService.GetAllInboxesMessages(_currentEmployee, 50);
            _hasMoreMessages = _messages.Count >= 50;
        }
        else if (_selectedNodeKey == "all-mail")
        {
            _messages = Db.EmailMessages.GetRecentAcrossFolders(GetUnifiedViewFolderScopes(), 50);
            _hasMoreMessages = _messages.Count >= 50;
        }
        else if (_selectedNodeKey == "all-unread")
        {
            _messages = Db.EmailMessages.GetRecentAcrossFolders(GetUnifiedViewFolderScopes(), 50, globalFilter: m => !m.IsRead);
            _hasMoreMessages = _messages.Count >= 50;
        }
        else if (_selectedNodeKey == "all-flagged")
        {
            _messages = Db.EmailMessages.GetRecentAcrossFolders(GetUnifiedViewFolderScopes(), 50, globalFilter: m => m.IsFlagged);
            _hasMoreMessages = _messages.Count >= 50;
        }
        else if (_selectedNodeKey == "all-sent")
        {
            var activeAccountIds = _accounts.Select(a => a.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _messages = _folders
                .Where(f => f.IsSent && activeAccountIds.Contains(f.AccountId))
                .SelectMany(f => Db.EmailMessages.GetByFolderRecent(f.AccountId, f.Path, 50))
                .OrderByDescending(m => m.Date)
                .Take(50)
                .ToList();
            _hasMoreMessages = false;
        }
        else if (_selectedNodeKey == "all-drafts")
        {
            var realAccountIds = _accounts.Select(a => a.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            var draftAccountIds = realAccountIds
                .Concat(_inboxes.Select(i => i.AccountId))
                .ToHashSet(StringComparer.OrdinalIgnoreCase);
            _messages = _folders
                .Where(f => (f.IsDrafts || f.Path == "LocalDrafts") && draftAccountIds.Contains(f.AccountId))
                .SelectMany(f => Db.EmailMessages.GetByFolderRecent(f.AccountId, f.Path, 50))
                .Where(CanCurrentUserSeeDraft)
                .OrderByDescending(m => m.Date)
                .Take(50)
                .ToList();
            _hasMoreMessages = false;
        }
        else if (_selectedNodeKey == "all-archive")
        {
            var activeAccountIds = _accounts.Select(a => a.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _messages = _folders
                .Where(f => f.IsArchive && activeAccountIds.Contains(f.AccountId))
                .SelectMany(f => Db.EmailMessages.GetByFolderRecent(f.AccountId, f.Path, 50))
                .OrderByDescending(m => m.Date)
                .Take(50)
                .ToList();
            _hasMoreMessages = false;
        }
        else if (_selectedNodeKey == "all-junk")
        {
            var activeAccountIds = _accounts.Select(a => a.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _messages = _folders
                .Where(f => f.IsJunk && activeAccountIds.Contains(f.AccountId))
                .SelectMany(f => Db.EmailMessages.GetByFolderRecent(f.AccountId, f.Path, 50))
                .OrderByDescending(m => m.Date)
                .Take(50)
                .ToList();
            _hasMoreMessages = false;
        }
        else if (_selectedNodeKey == "all-trash")
        {
            var activeAccountIds = _accounts.Select(a => a.Id).ToHashSet(StringComparer.OrdinalIgnoreCase);
            _messages = _folders
                .Where(f => f.IsTrash && activeAccountIds.Contains(f.AccountId))
                .SelectMany(f => Db.EmailMessages.GetByFolderRecent(f.AccountId, f.Path, 50))
                .OrderByDescending(m => m.Date)
                .Take(50)
                .ToList();
            _hasMoreMessages = false;
        }
        else if (_selectedRealInbox != null)
        {
            _messages = InboxService.GetRealInboxMessages(_selectedRealInbox.Id, 50);
            _hasMoreMessages = _messages.Count >= 50;
        }
        else if (_selectedInbox != null)
        {
            _messages = InboxService.GetInboxMessages(_selectedInbox, 50);
            _hasMoreMessages = _messages.Count >= 50;
        }
        else if (_selectedFolder != null)
        {
            var canBrowseFullAccount = _accounts.Any(a => string.Equals(a.Id, _selectedFolder.AccountId, StringComparison.OrdinalIgnoreCase));
            var folderMessages = Db.EmailMessages.GetByFolderRecent(_selectedFolder.AccountId, _selectedFolder.Path, 50)
                .Where(CanCurrentUserAccessMessageInUi)
                .ToList();
            _messages = folderMessages;
            _hasMoreMessages = (canBrowseFullAccount || _inboxes.Any(i => string.Equals(i.AccountId, _selectedFolder.AccountId, StringComparison.OrdinalIgnoreCase)))
                && Db.EmailMessages.HasMoreMessages(_selectedFolder.AccountId, _selectedFolder.Path);
        }

        StateHasChanged();
    }

    private bool _isLoadingOlder;
    private bool _hasMoreMessages = true;

    private async Task LoadOlderMessages()
    {
        if (_currentEmployee == null || _selectedNodeKey == null || _isLoadingOlder) return;
        if (_isSearching || !string.IsNullOrWhiteSpace(_searchText)) return;

        _isLoadingOlder = true;
        StateHasChanged();

        try
        {
            var oldestDate = _messages.LastOrDefault()?.Date.UtcDateTime ?? DateTime.UtcNow;
            List<EmailMessage> olderMessages = [];

            await Task.Run(() =>
            {
                if (_selectedNodeKey == "all-inboxes")
                {
                    olderMessages = InboxService.GetAllInboxesMessages(_currentEmployee, 30, oldestDate);
                }
                else if (_selectedNodeKey == "all-mail")
                {
                    olderMessages = Db.EmailMessages.GetRecentAcrossFolders(GetUnifiedViewFolderScopes(), 30, oldestDate);
                }
                else if (_selectedNodeKey == "all-unread")
                {
                    olderMessages = Db.EmailMessages.GetRecentAcrossFolders(GetUnifiedViewFolderScopes(), 30, oldestDate, m => !m.IsRead);
                }
                else if (_selectedNodeKey == "all-flagged")
                {
                    olderMessages = Db.EmailMessages.GetRecentAcrossFolders(GetUnifiedViewFolderScopes(), 30, oldestDate, m => m.IsFlagged);
                }
                else if (_selectedRealInbox != null)
                {
                    olderMessages = InboxService.GetRealInboxMessages(_selectedRealInbox.Id, 30, oldestDate);
                }
                else if (_selectedInbox != null)
                {
                    olderMessages = InboxService.GetInboxMessages(_selectedInbox, 30, oldestDate);
                }
                else if (_selectedFolder != null)
                {
                    olderMessages = Db.EmailMessages.GetByFolderBeforeDate(_selectedFolder.AccountId, _selectedFolder.Path, oldestDate, 30)
                        .Where(CanCurrentUserAccessMessageInUi)
                        .ToList();
                }
            });

            if (olderMessages.Any())
            {
                _messages.AddRange(olderMessages);
                StateHasChanged();
            }
            else
            {
                _hasMoreMessages = false;
            }
        }
        finally
        {
            _isLoadingOlder = false;
            StateHasChanged();
        }
    }

    private async Task HandleSearch(string value)
    {
        _searchText = value ?? "";

        _searchCts?.Cancel();
        _searchCts?.Dispose();
        _searchCts = new CancellationTokenSource();
        var token = _searchCts.Token;

        if (string.IsNullOrWhiteSpace(_searchText))
        {
            _isSearching = false;
            LoadCurrentViewMessages();
            return;
        }

        if (_currentEmployee == null) return;

        _isSearching = true;
        _messages = [];
        _searchProcessedCount = 0;
        _searchTotalCount = 0;
        StateHasChanged();

        var progress = new Progress<(int processed, int total)>(p =>
        {
            _searchProcessedCount = p.processed;
            _searchTotalCount = p.total;
            InvokeAsync(StateHasChanged);
        });

        try
        {
            await Task.Run(async () =>
            {
                List<string> targetAccountIds;
                if (_selectedFolder != null && !_searchAllFolders)
                {
                    targetAccountIds = [_selectedFolder.AccountId];
                }
                else if (_selectedRealInbox != null && !_searchAllFolders)
                {
                    targetAccountIds = [_selectedRealInbox.Id];
                }
                else if (_selectedInbox != null && !_searchAllFolders)
                {
                    targetAccountIds = [_selectedInbox.AccountId];
                }
                else
                {
                    targetAccountIds = _accounts.Select(a => a.Id)
                        .Concat(_inboxes.Select(i => i.AccountId))
                        .Where(id => !string.IsNullOrWhiteSpace(id))
                        .Distinct(StringComparer.OrdinalIgnoreCase)
                        .ToList();
                }

                string? folderPath = (!_searchAllFolders && _selectedFolder != null) ? _selectedFolder.Path : null;
                var scopedInbox = (!_searchAllFolders && _selectedInbox != null) ? _selectedInbox : null;

                foreach (var targetAccountId in targetAccountIds)
                {
                    if (token.IsCancellationRequested) break;

                    var canBrowse = CanBrowseFullAccount(targetAccountId);
                    var searchFolderPath = folderPath;
                    Func<Spokes_Server.Core.Data.Repositories.Communication.MessageMetadata, bool>? metadataFilter = null;
                    if (!canBrowse)
                    {
                        searchFolderPath = _folders.FirstOrDefault(f => string.Equals(f.AccountId, targetAccountId, StringComparison.OrdinalIgnoreCase) && f.IsInbox && string.IsNullOrEmpty(f.ParentPath))?.Path
                            ?? _folders.FirstOrDefault(f => string.Equals(f.AccountId, targetAccountId, StringComparison.OrdinalIgnoreCase) && f.Path.Equals("INBOX", StringComparison.OrdinalIgnoreCase))?.Path
                            ?? "INBOX";

                        if (scopedInbox != null)
                        {
                            metadataFilter = string.Equals(scopedInbox.AccountId, targetAccountId, StringComparison.OrdinalIgnoreCase)
                                ? InboxService.GetMetadataFilterForInbox(scopedInbox)
                                : (_ => false);
                        }
                        else
                        {
                            var inboxFilters = _inboxes
                                .Where(i => string.Equals(i.AccountId, targetAccountId, StringComparison.OrdinalIgnoreCase))
                                .Select(i => InboxService.GetMetadataFilterForInbox(i))
                                .ToList();
                            metadataFilter = inboxFilters.Count == 0
                                ? (_ => false)
                                : (meta => inboxFilters.Any(f => f == null || f(meta)));
                        }
                    }

                    await foreach (var msg in Db.EmailMessages.SearchStreamingAsync(targetAccountId, _searchText, searchFolderPath, progress, token, metadataFilter))
                    {
                        if (token.IsCancellationRequested) break;
                        if (!canBrowse && !InboxService.IsPrimaryRootInboxMessage(msg)) continue;
                        if (!CanCurrentUserAccessMessageInUi(msg)) continue;
                        if (scopedInbox != null && !InboxService.DoesMessageMatchInbox(msg, scopedInbox)) continue;

                        await InvokeAsync(() =>
                        {
                            _messages.Add(msg);
                            StateHasChanged();
                        });
                    }
                }
            }, token);

            if (!token.IsCancellationRequested)
            {
                _hasMoreMessages = false;
            }
        }
        catch (OperationCanceledException)
        {
        }
        finally
        {
            if (!token.IsCancellationRequested)
            {
                _isSearching = false;
                StateHasChanged();
            }
        }
    }

    private async Task HandleSearchScopeChanged(bool searchAll)
    {
        _searchAllFolders = searchAll;
        await HandleSearch(_searchText);
    }

    private void SelectUnifiedView(string viewKey) => SelectUnifiedView(viewKey, updateUrl: true);

    private void SelectUnifiedView(string viewKey, bool updateUrl)
    {
        StopWatchingPreviousFolder();

        _showMobileFolders = false;
        _selectedNodeKey = viewKey;
        _selectedRealInbox = null;
        _selectedInbox = null;
        _selectedFolder = null;
        _selectedMessageId = null;
        _selectedMessage = null;
        _searchText = "";

        if (updateUrl && FolderId != viewKey)
        {
            Nav.NavigateTo($"/email/{viewKey}");
        }

        LoadCurrentViewMessages();

        if (!IsReadOnly && viewKey is "all-inboxes" or "all-unread")
        {
            _ = Task.Run(async () =>
            {
                try
                {
                    await SyncAccessibleAccountInboxesAsync();
                    await InvokeAsync(() =>
                    {
                        LoadFoldersAndInboxes();
                        LoadCurrentViewMessages();
                    });
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Failed to background sync accessible inboxes for unified view {ViewKey}", viewKey);
                }
            });
        }
    }

    private async Task SyncAccessibleAccountInboxesAsync()
    {
        if (_currentEmployee == null) return;
        var accessibleAccounts = InboxService.GetAccessibleAccounts(_currentEmployee);
        foreach (var acc in accessibleAccounts)
        {
            if (acc.IsArchived || !acc.Enabled) continue;
            var inboxFolder = _folders.FirstOrDefault(f => f.AccountId == acc.Id && f.IsInbox);
            var folderPath = inboxFolder?.Path ?? "INBOX";
            try
            {
                await EmailSyncService.SyncSingleFolderAsync(acc.Id, folderPath);
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Failed to refresh account {AccountId}", acc.Id);
            }
        }
    }

