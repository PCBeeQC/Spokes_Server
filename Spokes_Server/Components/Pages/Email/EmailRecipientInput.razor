@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Identity
@inject Database Db
@inject UserService UserService

<div class="@($"email-composer-field-row d-flex align-center w-100 {Class}".Trim())">
    @if (!string.IsNullOrEmpty(Label))
    {
        <MudText Typo="Typo.body2" Color="Color.Secondary" Class="email-composer-field-label flex-shrink-0">
            @Label
        </MudText>
    }

    <div class="d-flex flex-wrap align-center gap-1 flex-grow-1 email-recipient-chips-wrap">
        @foreach (var email in SelectedEmails)
        {
            <MudChip T="string" OnClose="@(() => RemoveEmail(email))" Size="Size.Small"
                     Color="Color.Primary" Class="ma-0 email-recipient-chip">
                @email
            </MudChip>
        }

        <div class="email-recipient-autocomplete">
            <MudAutocomplete T="string" @ref="_autocomplete" Value="@_currentInput" FullWidth="true"
                             ValueChanged="OnValueChanged" SearchFunc="@Search"
                             CoerceText="false" CoerceValue="false"
                             Variant="Variant.Text" Underline="false" Margin="Margin.Dense"
                             ResetValueOnEmptyText="true"
                             Placeholder="@(SelectedEmails.Count == 0 ? (Placeholder ?? "") : "")"
                             Class="ma-0 email-composer-flat-input" UserAttributes="@_inputAttributes" />
        </div>
    </div>

    <div class="d-flex align-center flex-shrink-0 ml-1 email-composer-trailing-actions">
        <MudTooltip Text="@BizLoc["Open Address Book"]">
            <MudIconButton Icon="@Icons.Material.Outlined.Contacts" OnClick="OpenAddressBook"
                           Color="Color.Default" Size="Size.Small"
                           aria-label="@BizLoc["Open Address Book"]" />
        </MudTooltip>
        @TrailingActions
    </div>
</div>

@code {
    [Parameter] public string Class { get; set; } = "";
    [Parameter] public string Label { get; set; } = "To";
    [Parameter] public string? Placeholder { get; set; }
    [Parameter] public List<string> SelectedEmails { get; set; } = new();
    [Parameter] public EventCallback<List<string>> SelectedEmailsChanged { get; set; }
    [Parameter] public EventCallback OnAddressBookClick { get; set; }
    [Parameter] public RenderFragment? TrailingActions { get; set; }

    private string? _currentInput;
    private MudAutocomplete<string>? _autocomplete;

    // Attributes to deter password managers from hijacking the field
    private Dictionary<string, object> _inputAttributes = new()
    {
        { "autocomplete", "new-password" },
        { "data-lpignore", "true" },
        { "data-1p-ignore", "true" },
        { "data-bwignore", "true" },
        { "data-form-type", "other" }
    };

    private async Task<IEnumerable<string>> Search(string value, CancellationToken token)
    {
        var suggestions = new HashSet<string>();

        // Always allow what the user typed if it looks somewhat like an email
        if (!string.IsNullOrWhiteSpace(value) && value.Contains("@"))
        {
            suggestions.Add(value);
        }

        if (string.IsNullOrEmpty(value))
        {
            return suggestions;
        }

        var search = value.Trim();
        var employee = await UserService.GetEmployeeAsync(allowSuspended: true);
        if (employee == null)
        {
            return suggestions;
        }

        if (employee.HasEffectivePermission(AppPermissions.AddressBook.View, allowSuspended: true))
        {
            // 1. Search in Tier 1: Suppliers / Companies
            var suppliers = Db.Suppliers.GetAll();

            foreach (var supplier in suppliers)
            {
                if (supplier.Contacts.Count > 0)
                {
                    foreach (var contact in supplier.Contacts)
                    {
                        if (!string.IsNullOrEmpty(contact.Email))
                        {
                            if (contact.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                                contact.Name.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                                supplier.ContactInfo.BusinessName.Contains(search, StringComparison.OrdinalIgnoreCase))
                            {
                                suggestions.Add(contact.Email);
                            }
                        }
                    }
                }
                else if (!string.IsNullOrEmpty(supplier.ContactInfo.ContactPersonEmail))
                {
                    if (supplier.ContactInfo.ContactPersonEmail.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                        supplier.ContactInfo.ContactPersonName.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                        supplier.ContactInfo.BusinessName.Contains(search, StringComparison.OrdinalIgnoreCase))
                    {
                        suggestions.Add(supplier.ContactInfo.ContactPersonEmail);
                    }
                }
            }

            // 2. Search in Tier 2: Public Contacts
            var publicContacts = Db.PublicContacts.GetAll();
            foreach (var contact in publicContacts)
            {
                if (!string.IsNullOrEmpty(contact.Email) &&
                    (contact.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                     contact.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))
                {
                    suggestions.Add(contact.Email);
                }
            }
        }

        // 3. Search in Tier 3: Private Contacts
        var privateContacts = Db.PrivateContacts.GetAllForEmployee(employee.Id);
        foreach (var contact in privateContacts)
        {
            if (!string.IsNullOrEmpty(contact.Email) &&
                (contact.Email.Contains(search, StringComparison.OrdinalIgnoreCase) ||
                 contact.Name.Contains(search, StringComparison.OrdinalIgnoreCase)))
            {
                suggestions.Add(contact.Email);
            }
        }

        return suggestions;
    }

    private async Task OnValueChanged(string value)
    {
        if (!string.IsNullOrWhiteSpace(value))
        {
            if (!SelectedEmails.Contains(value))
            {
                SelectedEmails.Add(value);
                await SelectedEmailsChanged.InvokeAsync(SelectedEmails);
            }

            // Step 1: Blank out the binding immediately
            _currentInput = null;

            // Step 2: Yield thread to let Blazor register that _currentInput has nulled
            await Task.Delay(10);

            if (_autocomplete != null)
            {
                // Step 3: Use MudBlazor's inner cleanup commands
                await _autocomplete.ClearAsync();
                await _autocomplete.ResetAsync();

                // Step 4: Simulate blur/focus to clear residual display text while keeping focus
                await _autocomplete.BlurAsync();
                await _autocomplete.FocusAsync();
            }
        }
    }

    private async Task RemoveEmail(string email)
    {
        SelectedEmails.Remove(email);
        await SelectedEmailsChanged.InvokeAsync(SelectedEmails);
    }

    private Task OpenAddressBook() => OnAddressBookClick.InvokeAsync();
}
