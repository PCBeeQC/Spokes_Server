@inject IJSRuntime JSRuntime
@inject IDialogService DialogService
@inject ILogger<EmailContentRenderer> Logger
@inject IStringLocalizer<AppResources> Loc
@implements IAsyncDisposable

<div @ref="_container" class="email-content-renderer"></div>

@code {
    [Parameter] public string HtmlContent { get; set; } = "";
    [Parameter] public bool AllowRemoteImages { get; set; }
    [Parameter] public string ThemeMode { get; set; } = "auto";
    [Parameter] public EventCallback<bool> OnRemoteImagesBlocked { get; set; }

    private ElementReference _container;
    private IJSObjectReference? _module;
    private DotNetObjectReference<EmailContentRenderer>? _dotNetHelper;

    private bool _initialized;
    private string? _lastRenderedHtml;
    private bool? _lastRenderedAllowRemoteImages;
    private string? _lastRenderedThemeMode;
    private bool? _lastBlockedState;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            try
            {
                _module = await JSRuntime.InvokeAsync<IJSObjectReference>("import",
                    $"./{Assets.Bypassed("Components/Pages/Email/EmailContentRenderer.razor.js")}");
                _dotNetHelper = DotNetObjectReference.Create(this);
                _initialized = true;
            }
            catch (Exception ex)
            {
                Logger.LogError(ex, "Error initializing email renderer.");
            }
        }

        if (_initialized && _module != null && _dotNetHelper != null)
        {
            if (_lastRenderedHtml != HtmlContent ||
                _lastRenderedAllowRemoteImages != AllowRemoteImages ||
                _lastRenderedThemeMode != ThemeMode)
            {
                _lastRenderedHtml = HtmlContent;
                _lastRenderedAllowRemoteImages = AllowRemoteImages;
                _lastRenderedThemeMode = ThemeMode;
                try
                {
                    await _module.InvokeVoidAsync("renderContent", _container, HtmlContent, _dotNetHelper, AllowRemoteImages, ThemeMode);
                }
                catch (Exception ex)
                {
                    Logger.LogError(ex, "Error rendering email content.");
                }
            }
        }
    }

    [JSInvokable]
    public async Task NotifyRemoteImagesBlocked(bool blocked)
    {
        if (_lastBlockedState == blocked) return;
        _lastBlockedState = blocked;
        if (OnRemoteImagesBlocked.HasDelegate)
        {
            await OnRemoteImagesBlocked.InvokeAsync(blocked);
        }
    }

    [JSInvokable]
    public async Task HandleLinkClick(string url)
    {
        if (!Uri.TryCreate(url, UriKind.Absolute, out var parsedUri) || 
            (parsedUri.Scheme != Uri.UriSchemeHttp && parsedUri.Scheme != Uri.UriSchemeHttps))
        {
            await DialogService.ShowMessageBoxAsync(Loc["Security Warning"], Loc["This link was blocked for security reasons."], yesText: Loc["OK"]);
            return;
        }

        var encodedUrl = System.Net.WebUtility.HtmlEncode(url);
        var promptText = Loc["Do you really want to go to"].Value;
        var result = await DialogService.ShowMessageBoxAsync(Loc["External Link"], 
            (MarkupString)$"{promptText}<br/><a href='{encodedUrl}' target='_blank' rel='noopener noreferrer' style='word-break: break-all;'>{encodedUrl}</a>?", 
            yesText: Loc["Yes"], cancelText: Loc["No"]);

        if (result == true)
        {
            await JSRuntime.InvokeVoidAsync("open", url, "_blank");
        }
    }

    public async ValueTask DisposeAsync()
    {
        if (_module != null)
        {
            try
            {
                await _module.InvokeVoidAsync("cleanupContent", _container);
            }
            catch
            {
                // Ignored - DOM cleanup
            }

            try
            {
                await _module.DisposeAsync();
            }
            catch (JSDisconnectedException)
            {
                // Ignored - disconnected
            }
            catch (InvalidOperationException)
            {
                // Ignored - prerendering
            }
        }
        _dotNetHelper?.Dispose();
    }
}
