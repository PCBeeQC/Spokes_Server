@using Spokes_Server.Components.Dialogs
@using Spokes_Server.Components.Dialogs.Communication.Email
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Services.Communication.Email
@inject IDialogService DialogService
@inject IEmailInboxService InboxService
@inject Database Db
@inject IJSRuntime JS
@inject IStringLocalizer<AppResources> Loc

<MudPaper Elevation="0" Class="d-flex flex-column flex-grow-1 custom-scrollbar email-reader-root">
    @if (SelectedMessage != null)
    {
        <!-- Action Toolbar -->
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="px-3 border-b flex-wrap gap-y-2 gap-x-0 email-reader-toolbar" Style="border-color: var(--mud-palette-divider);" Spacing="2">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="flex-wrap gap-y-2">
                @if (OnClose.HasDelegate)
                {
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudTooltip Text="@Loc["Back"]">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowBack" Size="Size.Small" OnClick="OnClose" />
                        </MudTooltip>
                    </MudHidden>
                }

                @if (OnPreviousMessage.HasDelegate || OnNextMessage.HasDelegate)
                {
                    <MudTooltip Text="@Loc["Previous"]">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronLeft" Size="Size.Medium" OnClick="OnPreviousMessage"
                            Disabled="@(!HasPreviousMessage)" />
                    </MudTooltip>
                    <MudTooltip Text="@Loc["Next"]">
                        <MudIconButton Icon="@Icons.Material.Filled.ChevronRight" Size="Size.Medium" OnClick="OnNextMessage"
                            Disabled="@(!HasNextMessage)" />
                    </MudTooltip>
                }

                @if ((OnPreviousMessage.HasDelegate || OnNextMessage.HasDelegate) && (OnReply.HasDelegate || OnReplyAll.HasDelegate || OnForward.HasDelegate))
                {
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                    </MudHidden>
                }

                @if (OnReply.HasDelegate)
                {
                    <MudTooltip Text="@Loc["Reply"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Reply" Size="Size.Medium" Color="Color.Primary" OnClick="OnReply" />
                    </MudTooltip>
                }
                @if (OnReplyAll.HasDelegate || OnForward.HasDelegate)
                {
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        @if (OnReplyAll.HasDelegate)
                        {
                            <MudTooltip Text="@Loc["Reply All"]">
                                <MudIconButton Icon="@Icons.Material.Filled.ReplyAll" Size="Size.Medium" Color="Color.Primary" OnClick="OnReplyAll" />
                            </MudTooltip>
                        }
                        @if (OnForward.HasDelegate)
                        {
                            <MudTooltip Text="@Loc["Forward"]">
                                <MudIconButton Icon="@Icons.Material.Filled.Forward" Size="Size.Medium" Color="Color.Primary" OnClick="OnForward" />
                            </MudTooltip>
                        }
                    </MudHidden>
                }

                @if (OnMarkAsUnread.HasDelegate || (ShowFolderActions && _treeItems.Any() && OnMoveTo.HasDelegate))
                {
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                    </MudHidden>
                }

                @if (OnMarkAsUnread.HasDelegate)
                {
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudTooltip Text="@Loc["Mark as Unread"]">
                            <MudIconButton Icon="@Icons.Material.Filled.MarkEmailUnread" Size="Size.Medium" OnClick="OnMarkAsUnread" />
                        </MudTooltip>
                    </MudHidden>
                }

                @if (ShowFolderActions && _treeItems.Any() && OnMoveTo.HasDelegate)
                {
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudMenu Icon="@Icons.Material.Filled.DriveFileMove" title="@Loc["Move to Folder"]" Size="Size.Medium" AnchorOrigin="Origin.BottomLeft"
                            TransformOrigin="Origin.TopLeft">
                            <div style="min-width: 280px; max-height: 400px; overflow-y: auto;" class="pa-2">
                                <MudText Typo="Typo.subtitle2" Class="px-2 pb-2">@Loc["Move to..."]</MudText>
                                <MudTreeView T="EmailFolder" Items="_treeItems" Hover="true" Width="100%"
                                    SelectedValueChanged="HandleMoveToFolder">
                                    <ItemTemplate Context="treeItem">
                                        @{
                                            var isDisabled = (treeItem as FolderTreeItem)?.IsCurrentFolder == true;
                                        }
                                        <MudTreeViewItem @bind-Expanded="@treeItem.Expanded" Items="@treeItem.Children"
                                            Value="@treeItem.Value">
                                            <Content>
                                                <MudIcon Icon="@treeItem.Icon" Class="ml-0 mr-2" Size="Size.Medium"
                                                    Style="@(isDisabled ? "opacity: 0.4;" : "")" />
                                                <MudText Typo="Typo.body2" Style="@(isDisabled ? "opacity: 0.4;" : "")">
                                                    @(treeItem.Value?.Name ?? treeItem.Text)</MudText>
                                            </Content>
                                        </MudTreeViewItem>
                                    </ItemTemplate>
                                </MudTreeView>
                            </div>
                        </MudMenu>
                    </MudHidden>
                }

                @if (ShowDelete && OnDelete.HasDelegate)
                {
                    <MudHidden Breakpoint="Breakpoint.Xs">
                        <MudDivider Vertical="true" FlexItem="true" Class="mx-2 my-2" />
                    </MudHidden>

                    <MudTooltip Text="@Loc["Delete"]">
                        <MudIconButton Icon="@Icons.Material.Filled.Delete" Size="Size.Medium" Color="Color.Error" OnClick="OnDelete" />
                    </MudTooltip>
                }

                @if (CanAddToTimeline && OnAddToTimeline.HasDelegate)
                {
                    <MudHidden Breakpoint="Breakpoint.SmAndDown">
                        <MudTooltip Text="@Loc["Add to Project Timeline"]">
                            <MudIconButton Icon="@Icons.Material.Filled.PlaylistAdd" Size="Size.Medium" Color="Color.Primary" OnClick="OnAddToTimeline" />
                        </MudTooltip>
                    </MudHidden>
                }

                <MudMenu Icon="@Icons.Material.Filled.MoreVert" Size="Size.Medium">
                    @if (OnArchive.HasDelegate)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Inventory2" OnClick="OnArchive">@Loc["Archive"]</MudMenuItem>
                    }
                    @if (OnJunk.HasDelegate)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Report" OnClick="OnJunk">@Loc["Junk"]</MudMenuItem>
                    }
                    <MudMenuItem Icon="@Icons.Material.Filled.Print" OnClick="OnPrint">@Loc["Print"]</MudMenuItem>
                    
                    <MudHidden Breakpoint="Breakpoint.MdAndUp">
                        <MudDivider />
                        @if (OnReplyAll.HasDelegate)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.ReplyAll" OnClick="OnReplyAll">@Loc["Reply All"]</MudMenuItem>
                        }
                        @if (OnForward.HasDelegate)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.Forward" OnClick="OnForward">@Loc["Forward"]</MudMenuItem>
                        }
                        @if (OnMarkAsUnread.HasDelegate)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.MarkEmailUnread" OnClick="OnMarkAsUnread">@Loc["Mark as Unread"]</MudMenuItem>
                        }
                        @if (CanAddToTimeline && OnAddToTimeline.HasDelegate)
                        {
                            <MudMenuItem Icon="@Icons.Material.Filled.PlaylistAdd" OnClick="OnAddToTimeline">@Loc["Add to Timeline"]</MudMenuItem>
                        }
                        @if (ShowFolderActions && _treeItems.Any() && OnMoveTo.HasDelegate)
                        {
                            <div class="px-2 pt-2">
                                <MudText Typo="Typo.subtitle2" Class="px-2">@Loc["Move to..."]</MudText>
                                <div style="max-height: 250px; overflow-y: auto;">
                                    <MudTreeView T="EmailFolder" Items="_treeItems" Hover="true" Width="100%"
                                        SelectedValueChanged="HandleMoveToFolder">
                                        <ItemTemplate Context="treeItem">
                                            @{
                                                var isDisabled = (treeItem as FolderTreeItem)?.IsCurrentFolder == true;
                                            }
                                            <MudTreeViewItem @bind-Expanded="@treeItem.Expanded" Items="@treeItem.Children"
                                                Value="@treeItem.Value">
                                                <Content>
                                                    <MudIcon Icon="@treeItem.Icon" Class="ml-0 mr-2" Size="Size.Medium"
                                                        Style="@(isDisabled ? "opacity: 0.4;" : "")" />
                                                    <MudText Typo="Typo.body2" Style="@(isDisabled ? "opacity: 0.4;" : "")">
                                                        @(treeItem.Value?.Name ?? treeItem.Text)</MudText>
                                                </Content>
                                            </MudTreeViewItem>
                                        </ItemTemplate>
                                    </MudTreeView>
                                </div>
                            </div>
                        }
                    </MudHidden>
                </MudMenu>
            </MudStack>

            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1">
                @if (!string.IsNullOrWhiteSpace(SelectedMessage.UnsubscribeUrl) || !string.IsNullOrWhiteSpace(SelectedMessage.UnsubscribeMailto))
                {
                    <MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Secondary"
                               StartIcon="@Icons.Material.Filled.Unsubscribe" OnClick="HandleUnsubscribeAsync">
                        @Loc["Unsubscribe"]
                    </MudButton>
                }
                <MudTooltip Text="@(IsCurrentlyDark ? Loc["View Email with Light Background"] : Loc["View Email with Dark Background"])">
                    <MudIconButton Icon="@(IsCurrentlyDark ? Icons.Material.Filled.LightMode : Icons.Material.Filled.DarkMode)"
                                   Size="Size.Medium"
                                   Color="@(_overrideThemeIsDark.HasValue ? Color.Primary : Color.Default)"
                                   OnClick="@(() => _overrideThemeIsDark = !IsCurrentlyDark)" />
                </MudTooltip>
                @if (OnToggleFlag.HasDelegate)
                {
                    <MudTooltip Text="@(SelectedMessage.IsFlagged ? Loc["Remove Flag"] : Loc["Flag Message"])">
                        <MudIconButton
                            Icon="@(SelectedMessage.IsFlagged ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)"
                            Size="Size.Medium"
                            Color="@(SelectedMessage.IsFlagged ? Color.Warning : Color.Default)"
                            OnClick="@(() => OnToggleFlag.InvokeAsync(SelectedMessage))" />
                    </MudTooltip>
                }
            </MudStack>
        </MudStack>

        <!-- Message Header -->
        <div class="pa-4 border-b" style="border-color: var(--mud-palette-divider);">
            <div @onclick="@(() => _subjectExpanded = !_subjectExpanded)" style="cursor: pointer;">
                <MudText Typo="Typo.h6" Class="mb-2"
                    Style="@(_subjectExpanded ? "" : "display: -webkit-box; -webkit-line-clamp: 2; -webkit-box-orient: vertical; overflow: hidden;")">
                    @SelectedMessage.Subject
                </MudText>
            </div>

            <div class="d-flex align-center gap-3">
                <MudAvatar Color="Color.Primary">@(string.IsNullOrWhiteSpace(SelectedMessage.FromName) ? (SelectedMessage.FromAddress.Length > 0 ? SelectedMessage.FromAddress[0] : '?') : SelectedMessage.FromName[0])</MudAvatar>
                <div class="flex-grow-1">
                    <MudText Typo="Typo.body1" Class="d-flex align-center gap-1 flex-wrap">
                        <b>@SelectedMessage.FromName</b>
                        <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                            OnClick="@(() => OpenContactDialog(SelectedMessage.FromAddress, SelectedMessage.FromName))"
                            Class="cursor-pointer ml-1">
                            &lt;@SelectedMessage.FromAddress&gt;
                        </MudChip>
                    </MudText>
                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-flex align-center flex-wrap gap-1">
                        @Loc["To:"]
                        @foreach (var to in SelectedMessage.ToAddresses)
                        {
                            <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                OnClick="@(() => OpenContactDialog(to, ""))" Class="cursor-pointer ma-0 px-1">
                                @to
                            </MudChip>
                        }
                    </MudText>

                    @if (SelectedMessage.CcAddresses.Any())
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-flex align-center flex-wrap gap-1">
                            @Loc["Cc:"]
                            @foreach (var cc in SelectedMessage.CcAddresses)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text"
                                    OnClick="@(() => OpenContactDialog(cc, ""))" Class="cursor-pointer ma-0 px-1">
                                    @cc
                                </MudChip>
                            }
                        </MudText>
                    }
                    @if (SelectedMessage.BccAddresses.Any())
                    {
                        <MudText Typo="Typo.caption" Color="Color.Secondary" Class="d-flex align-center flex-wrap gap-1">
                            @Loc["Bcc:"]
                            @foreach (var bcc in SelectedMessage.BccAddresses)
                            {
                                <MudChip T="string" Size="Size.Small" Variant="Variant.Text" Class="ma-0 px-1">
                                    @bcc
                                </MudChip>
                            }
                        </MudText>
                    }

                    @if (_unmatchedAddresses.Any())
                    {
                        <div class="d-flex align-center flex-wrap gap-1 mt-1">
                            @foreach (var addr in _unmatchedAddresses)
                            {
                                <MudChip T="string" Size="Size.Small" Color="Color.Success" Variant="Variant.Outlined"
                                         Icon="@Icons.Material.Filled.Add"
                                         OnClick="@(() => CreateInboxForAddress(addr))" Class="cursor-pointer ma-0 px-2">
                                    @string.Format(Loc["Create Inbox for {0}"].Value, addr)
                                </MudChip>
                            }
                        </div>
                    }

                    <MudText Typo="Typo.caption" Color="Color.Secondary" Class="mt-1">@FormatDate(SelectedMessage.Date)</MudText>
                </div>
            </div>

            @if (SelectedMessage.HasAttachments)
            {
                <div class="d-flex flex-wrap gap-2 mt-2">
                    @foreach (var att in SelectedMessage.Attachments)
                    {
                        <MudChip T="string" Size="Size.Small" Icon="@GetAttachmentIcon(att)"
                            OnClick="@(() => HandleAttachmentClick(att))">
                            @att.FileName (@FormatSize(att.Size))
                        </MudChip>
                    }
                </div>
            }

            <!-- Privacy Shield Banner -->
            @if (_remoteImagesBlocked && !SelectedMessage.AllowRemoteImages)
            {
                <MudAlert Severity="Severity.Info" Dense="true" Variant="Variant.Outlined" Class="mt-3 mb-0">
                    <div class="d-flex align-center justify-space-between flex-wrap gap-2">
                        <MudText Typo="Typo.caption">@Loc["Remote images are blocked to protect your privacy."]</MudText>
                        <MudButton Variant="Variant.Text" Color="Color.Primary" Size="Size.Small"
                                   StartIcon="@Icons.Material.Filled.Image" OnClick="AllowRemoteImagesForMessage">
                            @Loc["Load Images"]
                        </MudButton>
                    </div>
                </MudAlert>
            }
        </div>

        <!-- Body -->
        <div class="pa-4 d-flex flex-column email-reader-body">
            @if (SelectedMessage.HasAttachments)
            {
                var icsAtts = SelectedMessage.Attachments.Where(a => IsIcsAttachment(a)).ToList();
                if (icsAtts.Any())
                {
                    <div class="d-flex flex-column gap-2 mb-4 shrink-0">
                        @foreach (var att in icsAtts)
                        {
                            <EmailEventViewer Attachment="att" MessageId="@SelectedMessage.Id"
                                              AccountId="@EffectiveAccountId" EmployeeId="@(EmployeeId ?? "")" />
                        }
                    </div>
                }
            }

            @if (IsLoadingBody)
            {
                <MudProgressLinear Indeterminate="true" Color="Color.Primary" />
            }
            else if (!string.IsNullOrWhiteSpace(MessageBody))
            {
                <div class="email-body-content">
                    <EmailContentRenderer HtmlContent="@MessageBody"
                                          AllowRemoteImages="@SelectedMessage.AllowRemoteImages"
                                          ThemeMode="@(IsCurrentlyDark ? "dark" : "light")"
                                          OnRemoteImagesBlocked="HandleRemoteImagesBlocked" />
                </div>
            }
            else if (!string.IsNullOrWhiteSpace(SelectedMessage.Snippet))
            {
                <div class="pa-4" style="white-space: pre-wrap; font-family: sans-serif; font-size: 14px; line-height: 1.6;">
                    @SelectedMessage.Snippet
                </div>
            }
            else
            {
                <div class="pa-4 text-muted" style="font-family: sans-serif; font-size: 14px;">
                    @Loc["No message content available."]
                </div>
            }
        </div>
    }
    else
    {
        <div class="d-flex flex-column align-center justify-center flex-grow-1">
            <MudIcon Icon="@Icons.Material.Filled.Email" Size="Size.Large" Color="Color.Tertiary"
                Style="font-size: 64px;" />
            <MudText Typo="Typo.h6" Color="Color.Secondary" Class="mt-4">@Loc["Select a message to read"]</MudText>
        </div>
    }
</MudPaper>

@code {
    [Parameter] public EmailMessage? SelectedMessage { get; set; }
    [Parameter] public string? SelectedMessageId { get; set; }
    [Parameter] public string? TimeZoneId { get; set; }
    [Parameter] public string MessageBody { get; set; } = "";
    [Parameter] public bool IsLoadingBody { get; set; }
    [Parameter] public List<EmailFolder> Folders { get; set; } = [];
    [Parameter] public string? CurrentFolderPath { get; set; }
    [Parameter] public string? AccountId { get; set; }
    [Parameter] public string? EmployeeId { get; set; }
    [Parameter] public bool ShowFolderActions { get; set; } = true;
    [Parameter] public bool ShowDelete { get; set; } = true;

    [Parameter] public EventCallback OnClose { get; set; }
    [Parameter] public EventCallback<EmailMessage> OnToggleFlag { get; set; }
    [Parameter] public EventCallback<EmailAttachmentMeta> OnDownloadAttachment { get; set; }
    [Parameter] public EventCallback OnMarkAsUnread { get; set; }
    [Parameter] public EventCallback<string> OnMoveTo { get; set; }
    [Parameter] public EventCallback OnInboxCreated { get; set; }

    [Parameter] public EventCallback OnReply { get; set; }
    [Parameter] public EventCallback OnReplyAll { get; set; }
    [Parameter] public EventCallback OnForward { get; set; }
    [Parameter] public EventCallback OnDelete { get; set; }
    [Parameter] public EventCallback OnArchive { get; set; }
    [Parameter] public EventCallback OnJunk { get; set; }
    [Parameter] public EventCallback OnPrint { get; set; }
    [Parameter] public bool CanAddToTimeline { get; set; }
    [Parameter] public EventCallback OnAddToTimeline { get; set; }

    [Parameter] public bool HasNextMessage { get; set; }
    [Parameter] public bool HasPreviousMessage { get; set; }
    [Parameter] public EventCallback OnNextMessage { get; set; }
    [Parameter] public EventCallback OnPreviousMessage { get; set; }
    [Parameter] public bool IsDarkMode { get; set; } = true;

    private List<TreeItemData<EmailFolder>> _treeItems = [];
    private List<string> _unmatchedAddresses = [];
    private bool _subjectExpanded;
    private bool _remoteImagesBlocked;
    private bool? _overrideThemeIsDark;
    private bool IsCurrentlyDark => _overrideThemeIsDark ?? IsDarkMode;
    private string? _lastMessageId;

    private string EffectiveAccountId =>
        !string.IsNullOrEmpty(SelectedMessage?.AccountId) ? SelectedMessage.AccountId :
        !string.IsNullOrEmpty(AccountId) ? AccountId :
        EmployeeId ?? "";

    protected override void OnParametersSet()
    {
        if (Folders != null && Folders.Any())
        {
            var msgAccountId = SelectedMessage?.AccountId;
            var filtered = Folders
                .Where(f => !f.IsDrafts && f.Path != "LocalDrafts" && (string.IsNullOrEmpty(msgAccountId) || f.AccountId == msgAccountId))
                .ToList();
            _treeItems = BuildTree(filtered);
        }

        if (SelectedMessage?.Id != _lastMessageId)
        {
            _lastMessageId = SelectedMessage?.Id;
            _subjectExpanded = false;
            _remoteImagesBlocked = false;
        }

        if (SelectedMessage != null && !string.IsNullOrEmpty(SelectedMessage.AccountId) && CanCreateVirtualInboxForSelectedMessage())
        {
            _unmatchedAddresses = InboxService.GetUnmatchedAddressesForMessage(SelectedMessage);
        }
        else
        {
            _unmatchedAddresses = [];
        }
    }

    private bool CanCreateVirtualInboxForSelectedMessage()
    {
        if (SelectedMessage == null || string.IsNullOrEmpty(SelectedMessage.AccountId)) return false;
        var emp = !string.IsNullOrEmpty(EmployeeId) ? Db.Employees.GetById(EmployeeId) : null;
        if (emp != null && emp.IsAdmin) return true;
        var settings = Db.CompanyProfile.GetEmailSettings();
        if (!settings.AllowUsersToCreateVirtualInboxes) return false;
        if (string.IsNullOrEmpty(EmployeeId)) return false;
        var account = Db.EmailAccounts.GetById(SelectedMessage.AccountId);
        return account != null && account.CanUserAccess(EmployeeId, InboxService.GetUserTeamIds(EmployeeId));
    }

    private void HandleRemoteImagesBlocked(bool blocked)
    {
        if (_remoteImagesBlocked != blocked)
        {
            _remoteImagesBlocked = blocked;
            StateHasChanged();
        }
    }

    private void AllowRemoteImagesForMessage()
    {
        if (SelectedMessage == null) return;
        SelectedMessage.AllowRemoteImages = true;
        _remoteImagesBlocked = false;
        Db.EmailMessages.Save(SelectedMessage);
        StateHasChanged();
    }

    private async Task CreateInboxForAddress(string address)
    {
        if (SelectedMessage == null || !CanCreateVirtualInboxForSelectedMessage()) return;

        var localPart = address.Split('@')[0];
        var defaultName = string.IsNullOrWhiteSpace(localPart)
            ? address
            : char.ToUpperInvariant(localPart[0]) + (localPart.Length > 1 ? localPart.Substring(1) : "");

        var inbox = new EmailInbox
        {
            Name = defaultName,
            AccountId = SelectedMessage.AccountId,
            OwnerEmployeeId = EmployeeId ?? "",
            TargetAddresses = [address.Trim().ToLowerInvariant()]
        };

        var parameters = new DialogParameters<EmailInboxDialog>
        {
            { x => x.Inbox, inbox },
            { x => x.IsNew, true }
        };
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Medium, FullWidth = true };
        var dialog = await DialogService.ShowAsync<EmailInboxDialog>(Loc["New Virtual Inbox"], parameters, options);
        var result = await dialog.Result;

        if (result is { Canceled: false, Data: EmailInbox saved })
        {
            Db.EmailInboxes.Save(saved);
            _unmatchedAddresses = InboxService.GetUnmatchedAddressesForMessage(SelectedMessage);
            if (OnInboxCreated.HasDelegate)
            {
                await OnInboxCreated.InvokeAsync();
            }
            StateHasChanged();
        }
    }

    private async Task HandleUnsubscribeAsync()
    {
        if (SelectedMessage == null) return;

        if (!string.IsNullOrWhiteSpace(SelectedMessage.UnsubscribeUrl))
        {
            var encodedUrl = System.Net.WebUtility.HtmlEncode(SelectedMessage.UnsubscribeUrl);
            var promptText = Loc["Open the sender's unsubscribe page?"].Value;
            var confirm = await DialogService.ShowMessageBoxAsync(
                Loc["Unsubscribe"],
                (MarkupString)$"{promptText}<br/><a href='{encodedUrl}' target='_blank' rel='noopener noreferrer' style='word-break: break-all;'>{encodedUrl}</a>",
                yesText: Loc["Unsubscribe"], cancelText: Loc["Cancel"]);

            if (confirm == true)
            {
                await JS.InvokeVoidAsync("open", SelectedMessage.UnsubscribeUrl, "_blank");
            }
        }
        else if (!string.IsNullOrWhiteSpace(SelectedMessage.UnsubscribeMailto))
        {
            var mailto = SelectedMessage.UnsubscribeMailto;
            var raw = mailto.StartsWith("mailto:", StringComparison.OrdinalIgnoreCase)
                ? mailto.Substring(7)
                : mailto;

            var parts = raw.Split('?', 2);
            var toAddress = Uri.UnescapeDataString(parts[0]);
            var subject = "Unsubscribe";

            if (parts.Length > 1)
            {
                var queryParams = parts[1].Split('&', StringSplitOptions.RemoveEmptyEntries);
                foreach (var kv in queryParams)
                {
                    var pair = kv.Split('=', 2);
                    if (pair.Length == 2 && pair[0].Equals("subject", StringComparison.OrdinalIgnoreCase))
                    {
                        subject = Uri.UnescapeDataString(pair[1]);
                    }
                }
            }

            var parameters = new DialogParameters
            {
                ["AccountId"] = EffectiveAccountId,
                ["To"] = toAddress,
                ["Subject"] = subject,
                ["Body"] = "<p>Unsubscribe</p>",
                ["ReplyReceivingAddresses"] = SelectedMessage.ReceivingAddresses
            };
            var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.ExtraLarge, FullWidth = true, CloseButton = true };
            await DialogService.ShowAsync<EmailComposer>(Loc["Unsubscribe"], parameters, options);
        }
    }

    private string GetAttachmentIcon(EmailAttachmentMeta att) =>
        IsImageAttachment(att) ? Icons.Material.Filled.Image :
        IsPdfAttachment(att) ? Icons.Material.Filled.PictureAsPdf :
        Icons.Material.Filled.AttachFile;

    private bool IsImageAttachment(EmailAttachmentMeta att) =>
        att.ContentType.StartsWith("image/", StringComparison.OrdinalIgnoreCase);

    private bool IsPdfAttachment(EmailAttachmentMeta att) =>
        att.ContentType.Equals("application/pdf", StringComparison.OrdinalIgnoreCase);

    private bool IsIcsAttachment(EmailAttachmentMeta att) =>
        att.FileName.EndsWith(".ics", StringComparison.OrdinalIgnoreCase) || 
        att.ContentType.Equals("text/calendar", StringComparison.OrdinalIgnoreCase);

    private async Task HandleAttachmentClick(EmailAttachmentMeta att)
    {
        if (SelectedMessage == null) return;

        if (IsImageAttachment(att) || IsPdfAttachment(att))
        {
            var url = $"/spokesapi/files/email/{SelectedMessage.Id}/{att.Id}?accountId={Uri.EscapeDataString(EffectiveAccountId)}&ct={Uri.EscapeDataString(att.ContentType)}&fn={Uri.EscapeDataString(att.FileName)}";
            var parameters = new DialogParameters
            {
                { "Url", url },
                { "FileName", att.FileName },
                { "IsImage", IsImageAttachment(att) }
            };
            var options = new DialogOptions { MaxWidth = MaxWidth.Large, FullWidth = true, CloseOnEscapeKey = true };
            await DialogService.ShowAsync<AttachmentPreviewDialog>(Loc["Preview"], parameters, options);
        }
        else
        {
            await OnDownloadAttachment.InvokeAsync(att);
        }
    }

    private async Task HandleMoveToFolder(EmailFolder? folder)
    {
        if (folder != null && folder.Path != CurrentFolderPath && OnMoveTo.HasDelegate)
        {
            await OnMoveTo.InvokeAsync(folder.Path);
        }
    }

    private List<TreeItemData<EmailFolder>> BuildTree(List<EmailFolder> folders)
    {
        var allPaths = new HashSet<string>(folders.Select(f => f.Path));
        var roots = folders.Where(f =>
            string.IsNullOrEmpty(f.ParentPath) || !allPaths.Contains(f.ParentPath)
        ).OrderByDescending(f => f.IsInbox).ThenBy(f => f.Name).ToList();
        return roots.Select(r => BuildNode(r, folders)).ToList();
    }

    private TreeItemData<EmailFolder> BuildNode(EmailFolder folder, List<EmailFolder> allFolders)
    {
        var children = allFolders.Where(f => f.ParentPath == folder.Path)
            .OrderBy(f => f.Name).ToList();
        return new FolderTreeItem(folder)
        {
            Text = folder.Name,
            Icon = GetFolderIcon(folder),
            Expanded = true,
            IsCurrentFolder = folder.Path == CurrentFolderPath,
            Children = children.Select(c => BuildNode(c, allFolders)).ToList()
        };
    }

    private class FolderTreeItem : TreeItemData<EmailFolder>
    {
        public bool IsCurrentFolder { get; set; }
        public FolderTreeItem(EmailFolder folder) : base(folder) { }
    }

    private static string GetFolderIcon(EmailFolder? folder) => folder switch
    {
        { IsInbox: true } => Icons.Material.Filled.Inbox,
        { IsSent: true } => Icons.Material.Filled.Send,
        { IsTrash: true } => Icons.Material.Filled.Delete,
        { IsArchive: true } => Icons.Material.Filled.Inventory2,
        { IsJunk: true } => Icons.Material.Filled.Report,
        _ => Icons.Material.Filled.Folder
    };

    private string FormatSize(long bytes)
    {
        if (bytes < 1024) return $"{bytes} B";
        if (bytes < 1024 * 1024) return $"{bytes / 1024} KB";
        return $"{bytes / 1024 / 1024} MB";
    }

    private string FormatDate(DateTimeOffset date)
    {
        DateTime localDate;
        if (!string.IsNullOrWhiteSpace(TimeZoneId))
        {
            try
            {
                localDate = TimeZoneInfo.ConvertTimeBySystemTimeZoneId(date, TimeZoneId).DateTime;
            }
            catch
            {
                localDate = date.LocalDateTime;
            }
        }
        else
        {
            localDate = date.LocalDateTime;
        }

        return localDate.ToString("g");
    }

    private async Task OpenContactDialog(string email, string name)
    {
        if (string.IsNullOrWhiteSpace(email)) return;

        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true };
        var parameters = new DialogParameters
        {
            { "Email", email },
            { "DisplayName", name }
        };

        await DialogService.ShowAsync<AddContactFromEmailDialog>(Loc["Save Contact"], parameters, options);
    }
}
