@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Security
@inject Database Db
@inject UserService UserService
@inject IUserPrivacyService PrivacyService
@inject AuthenticationStateProvider AuthStateProvider
@inject ChatNotificationService ChatNotifications
@inject EmailNotificationService EmailNotifications
@inject CalendarNotificationService CalendarNotifications
@inject AppLabelService AppLabels
@inject StartupTimingService StartupTimings
@inject IConfiguration Config
@inject IJSRuntime JS
@inject ILogger<NavMenu> Logger
@implements IDisposable

<MudNavMenu>
    @* --- Home (Always Pinned) --- *@
    <MudNavLink Href="" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.Home">
        <div class="d-flex align-center" style="width: 100%;">
            <span style="flex: 1;">Home</span>
        </div>
    </MudNavLink>

    @* --- Favorites --- *@
    @if (_currentUser?.FavoriteLinks.Any(h => h != "") == true)
    {
        @foreach (var href in _currentUser.FavoriteLinks.Where(h => h != ""))
        {
            var meta = GetLinkMetadata(href);
            <MudNavLink Href="@href" Match="@GetNavLinkMatch(href)" Icon="@meta.Icon">
                <div class="d-flex align-center" style="width: 100%;">
                    <span style="flex: 1;">@meta.Title</span>
                    @if (href == "chat" && _unreadCount > 0)
                    {
                        <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; margin-right: 8px; border-radius: 10px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadCount</span>
                    }
                    else if (href == "email" && _unreadEmailCount > 0)
                    {
                        <span class="d-inline-flex align-center justify-center rounded-pill px-2 py-0 mr-2" style="min-width: 20px; height: 20px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadEmailCount</span>
                    }
                    
                    @if (_isEditingFavorites)
                    {
                        <span @onclick:stopPropagation="true" @onclick:preventDefault="true" class="d-flex">
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Default" Size="Size.Small" OnClick="@(() => MoveFavoriteUp(href))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Default" Size="Size.Small" OnClick="@(() => MoveFavoriteDown(href))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Star" Color="Color.Default" Size="Size.Small" OnClick="@(() => ToggleFavorite(href))" />
                        </span>
                    }
                </div>
            </MudNavLink>
        }
    }

    @if (drawerOpen)
    {
        <MudDivider Class="my-4"></MudDivider>

        @* ==========================================
           PILLAR 1: ME (Personal Space)
           ========================================== *@
        <MudNavGroup Title="Me" Icon="@Icons.Material.Filled.Person" Expanded="true">
            @if (HasPerm(AppPermissions.Chat.Use))
            {
                <MudNavLink Href="chat" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Chat">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Chat</span>
                        @if (_unreadCount > 0)
                        {
                            <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; margin-right: 8px; border-radius: 10px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadCount</span>
                        }
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("chat") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("chat"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Email.Use))
            {
                <MudNavLink Href="email" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Email">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Email</span>
                        @if (_unreadEmailCount > 0)
                        {
                            <span class="d-inline-flex align-center justify-center rounded-pill px-2 py-0 mr-2" style="min-width: 20px; height: 20px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadEmailCount</span>
                        }
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("email") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("email"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Calendar.View))
            {
                <MudNavLink Href="planning/calendar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Calendar</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("planning/calendar") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("planning/calendar"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Timesheets.AccessTimesheet))
            {
                <MudNavLink Href="my-timesheet" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccessTime">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">My Timesheet</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("my-timesheet") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("my-timesheet"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Finance.AccessExpenses))
            {
                <MudNavLink Href="me/expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">My Expenses</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("me/expenses") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("me/expenses"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Albums.View))
            {
                <MudNavLink Href="albums" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PhotoAlbum">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Albums</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("albums") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("albums"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }
        </MudNavGroup>

        @* ==========================================
           PILLAR 2: WORK (Projects & Clients)
           ========================================== *@
        @if (HasPerm(AppPermissions.Projects.View) || HasAnyPerm(AppPermissions.AddressBook.View, AppPermissions.AddressBook.Manage) || HasPerm(AppPermissions.BusinessDocuments.View))
        {
            <MudNavGroup Title="Work" Icon="@Icons.Material.Filled.Work" Expanded="false">
                @if (HasPerm(AppPermissions.Projects.View))
                {
                    <MudNavLink Href="projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FolderSpecial">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Projects</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("projects") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("projects"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasAnyPerm(AppPermissions.AddressBook.View, AppPermissions.AddressBook.Manage))
                {
                    <MudNavLink Href="/business/address-book" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Contacts">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Clients</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("/business/address-book") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("/business/address-book"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.BusinessDocuments.View))
                {
                    <MudNavLink Href="business/documents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Documents</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/documents") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/documents"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           PILLAR 3: MONEY (Financials & Procurement)
           ========================================== *@
        @if (HasPerm(AppPermissions.Finance.AccessAccounting) || HasAnyPerm(AppPermissions.Purchases.ViewPOs, AppPermissions.Purchases.ManagePOs))
        {
            <MudNavGroup Title="Money" Icon="@Icons.Material.Filled.AttachMoney" Expanded="false">
                @if (HasPerm(AppPermissions.Finance.AccessAccounting))
                {
                    <MudNavLink Href="/business-dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Financial Dashboard</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("/business-dashboard") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("/business-dashboard"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="business/accounting" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalance">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Accounting & Invoicing</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/accounting") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/accounting"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="business/accounting/inbox" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MarkEmailUnread">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Bill Inbox</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/accounting/inbox") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/accounting/inbox"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasAnyPerm(AppPermissions.Purchases.ViewPOs, AppPermissions.Purchases.ManagePOs))
                {
                    <MudNavLink Href="purchases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Purchases & POs</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("purchases") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("purchases"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           TEAM LEAD (Management & Approvals)
           ========================================== *@
        @if (IsTeamLeader || _currentUser?.IsAdmin == true)
        {
            <MudNavGroup Title="Team Lead" Icon="@Icons.Material.Filled.SupervisorAccount" Expanded="false">
                <MudNavLink Href="planning/timesheet-approvals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FactCheck">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Timesheet Approvals</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("planning/timesheet-approvals") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("planning/timesheet-approvals"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>

                @if (Db.CompanyProfile.Get()?.TimesheetConfig?.EnableWeeklyPlan ?? true)
                {
                    <MudNavLink Href="planning/manager" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SupervisorAccount">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@AppLabels.Team Planning</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("planning/manager") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("planning/manager"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           BUSINESS (Administration, Reports & Org)
           ========================================== *@
        @if (PrivacyService.CanViewDirectory(_currentUser) || HasPerm(AppPermissions.Finance.AccessAccounting) || HasPerm(AppPermissions.Finance.TeamCapacity) || _currentUser?.IsAdmin == true)
        {
            <MudNavGroup Title="Business" Icon="@Icons.Material.Filled.Business" Expanded="false">
                @if (PrivacyService.CanViewDirectory(_currentUser))
                {
                    <MudNavLink Href="organization" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@AppLabels.Company Directory</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("organization") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("organization"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.Finance.AccessAccounting) || HasPerm(AppPermissions.Finance.TeamCapacity) || _currentUser?.IsAdmin == true)
                {
                    <MudNavLink Href="business/timesheet-reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Timesheet Reports</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/timesheet-reports") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/timesheet-reports"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>

                    <MudNavLink Href="/business/expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalanceWallet">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Forward Planning</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("/business/expenses") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("/business/expenses"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.Finance.TeamCapacity) || _currentUser?.IsAdmin == true)
                {
                    <MudNavLink Href="business/capacity" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@AppLabels.Teams Capacity</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/capacity") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/capacity"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           SERVER ADMIN (System Configuration)
           ========================================== *@
        @if (HasPerm(AppPermissions.Admin.ManageSettings) || HasPerm(AppPermissions.Chat.Moderator) || _currentUser?.IsAdmin == true)
        {
            <MudNavGroup Title="Server Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                @if (HasPerm(AppPermissions.Admin.ManageSettings) || _currentUser?.IsAdmin == true)
                {
                    <MudNavLink Href="admin/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Settings</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/settings") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/settings"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="admin/definitions" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ListAlt">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Task Definitions</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/definitions") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/definitions"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="admin/standard-documents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Standard Documents</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/standard-documents") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/standard-documents"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="admin/data-migration" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CloudUpload">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Data Migration</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/data-migration") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/data-migration"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if ((HasPerm(AppPermissions.Admin.ManageSettings) || _currentUser?.IsAdmin == true) && Config.GetValue<bool>("Spokes_DemoSetup"))
                {
                    <MudNavLink Href="admin/demo-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Build">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Demo Settings</span>
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.Chat.Moderator) || _currentUser?.IsAdmin == true)
                {
                    <MudNavLink Href="admin/moderation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Moderation</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/moderation") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/moderation"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }
    }
    

</MudNavMenu>

@code {
    [Parameter] public bool _isEditingFavorites { get; set; } = false;
    [Parameter] public bool drawerOpen { get; set; } = true;
    
    private bool IsFamilyEdition => Db.CompanyProfile.Get()?.Edition == "Family";
    
    private bool IsAdmin = false;
    private bool IsTeamLeader = false;
    private Employee? _currentUser;
    private int _unreadCount = 0;
    private int _unreadEmailCount = 0;
    private string? _currentUserId;
    private string _appVersion = Spokes_Server.Core.Services.Licensing.LicenseValidationService.AppVersion;

    private (string Title, string Icon) GetLinkMetadata(string href) => href switch
    {
        "" => ("Home", Icons.Material.Filled.Home),
        "chat" => ("Chat", Icons.Material.Filled.Chat),
