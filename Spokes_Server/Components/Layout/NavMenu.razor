@using Spokes_Server.Core.Constants
@using Spokes_Server.Core.Services.Security
@inject Database Db
@inject UserService UserService
@inject IUserPrivacyService PrivacyService
@inject ChatNotificationService ChatNotifications
@inject EmailNotificationService EmailNotifications
@inject AppLabelService AppLabels
@inject StartupTimingService StartupTimings
@inject IConfiguration Config
@inject IJSRuntime JS
@implements IDisposable

<MudNavMenu>
    @if (StartupTimings.IsChatProfilerEnabled)
    {
        StartupTimings.AddChatTransition($"Server: RenderTree NavMenu (drawerOpen={drawerOpen})");
    }
    @* --- Landing Page Section (Exactly 1 Page) --- *@
    @{
        var rawLandingHref = _currentUser?.LandingPage ?? "";
        var landingHref = IsNavHrefPermitted(rawLandingHref) ? rawLandingHref : "";
        var landingMeta = GetLinkMetadata(landingHref);
    }
    @if (_isEditingFavorites && drawerOpen)
    {
        <div class="d-flex align-center px-4 pt-2 pb-1">
            <MudText Typo="Typo.overline" Style="font-size: 0.7rem; color: var(--mud-palette-text-secondary); font-weight: 600;">
                @BizLoc["Landing Page"]
            </MudText>
        </div>
    }
    <MudNavLink Href="@landingHref" Match="@GetNavLinkMatch(landingHref)" Icon="@landingMeta.Icon">
        <div class="d-flex align-center" style="width: 100%;">
            <span style="flex: 1;">@(string.IsNullOrEmpty(landingHref) ? Loc["Home"] : landingMeta.Title)</span>
            @if (landingHref == "chat" && _unreadCount > 0)
            {
                <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; margin-right: 8px; border-radius: 10px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadCount</span>
            }
            else if (landingHref == "email" && _unreadEmailCount > 0)
            {
                <span class="d-inline-flex align-center justify-center rounded-pill px-2 py-0 mr-2" style="min-width: 20px; height: 20px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadEmailCount</span>
            }

            @if (_isEditingFavorites)
            {
                <span @onclick:stopPropagation="true" @onclick:preventDefault="true" class="d-flex align-center">
                    <MudTooltip Text="@BizLoc["Change Landing Page"]">
                        <MudMenu Icon="@Icons.Material.Filled.SwapHoriz" Color="Color.Default" Size="Size.Small" Dense="true" AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight">
                        <MudMenuItem OnClick="@(() => SetLandingPage(""))" Icon="@Icons.Material.Filled.Home">
                            @Loc["Home"] (@Loc["Default"])
                        </MudMenuItem>
                        <MudDivider Class="my-1" />
                        @foreach (var pageLink in GetAvailableLandingPages())
                        {
                            var pMeta = GetLinkMetadata(pageLink);
                            <MudMenuItem OnClick="@(() => SetLandingPage(pageLink))" Icon="@pMeta.Icon">
                                @pMeta.Title
                            </MudMenuItem>
                        }
                    </MudMenu>
                    </MudTooltip>
                    @if (!string.IsNullOrEmpty(landingHref))
                    {
                        <MudTooltip Text="@Loc["Reset to default"]">
                            <MudIconButton Icon="@Icons.Material.Filled.RestartAlt" Color="Color.Default" Size="Size.Small" OnClick="@(() => SetLandingPage(""))" />
                        </MudTooltip>
                    }
                </span>
            }
        </div>
    </MudNavLink>

    @* --- Favorites --- *@
    @{
        var visibleFavorites = _currentUser?.FavoriteLinks.Where(h => h != "" && h != landingHref && IsNavHrefPermitted(h)).ToList() ?? [];
    }
    @if (visibleFavorites.Count > 0)
    {
        @if (_isEditingFavorites && drawerOpen)
        {
            <div class="d-flex align-center px-4 pt-2 pb-1">
                <MudText Typo="Typo.overline" Style="font-size: 0.7rem; color: var(--mud-palette-text-secondary); font-weight: 600;">
                    @AppLabels.Favorites
                </MudText>
            </div>
        }
        @foreach (var href in visibleFavorites)
        {
            var meta = GetLinkMetadata(href);
            <MudNavLink Href="@href" Match="@GetNavLinkMatch(href)" Icon="@meta.Icon">
                <div class="d-flex align-center" style="width: 100%;">
                    <span style="flex: 1;">@meta.Title</span>
                    @if (href == "chat" && _unreadCount > 0)
                    {
                        <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; margin-right: 8px; border-radius: 10px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadCount</span>
                    }
                    else if (href == "email" && _unreadEmailCount > 0)
                    {
                        <span class="d-inline-flex align-center justify-center rounded-pill px-2 py-0 mr-2" style="min-width: 20px; height: 20px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadEmailCount</span>
                    }
                    
                    @if (_isEditingFavorites)
                    {
                        <span @onclick:stopPropagation="true" @onclick:preventDefault="true" class="d-flex align-center">
                            <MudTooltip Text="@BizLoc["Set as Landing Page"]">
                                <MudIconButton Icon="@Icons.Material.Outlined.Home" Color="Color.Default" Size="Size.Small" OnClick="@(() => SetLandingPage(href))" />
                            </MudTooltip>
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Color="Color.Default" Size="Size.Small" OnClick="@(() => MoveFavoriteUp(href))" />
                            <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Color="Color.Default" Size="Size.Small" OnClick="@(() => MoveFavoriteDown(href))" />
                            <MudIconButton Icon="@Icons.Material.Filled.Star" Color="Color.Default" Size="Size.Small" OnClick="@(() => ToggleFavorite(href))" />
                        </span>
                    }
                </div>
            </MudNavLink>
        }
    }

    @if (drawerOpen)
    {
        <MudDivider Class="my-4"></MudDivider>

        @* ==========================================
           PILLAR 1: ME (Personal Space)
           ========================================== *@
        <MudNavGroup Title="Me" Icon="@Icons.Material.Filled.Person" Expanded="true">
            @if (HasPerm(AppPermissions.Chat.Use))
            {
                <MudNavLink Href="chat" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Chat">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Chat</span>
                        @if (_unreadCount > 0)
                        {
                            <span style="display: inline-flex; align-items: center; justify-content: center; min-width: 20px; height: 20px; padding: 0 6px; margin-right: 8px; border-radius: 10px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadCount</span>
                        }
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("chat") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("chat"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (!IsFamilyEdition && HasPerm(AppPermissions.Email.Use))
            {
                <MudNavLink Href="email" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Email">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Email</span>
                        @if (_unreadEmailCount > 0)
                        {
                            <span class="d-inline-flex align-center justify-center rounded-pill px-2 py-0 mr-2" style="min-width: 20px; height: 20px; background: var(--mud-palette-error); color: white; font-size: 11px; font-weight: 700;">@_unreadEmailCount</span>
                        }
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("email") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("email"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Calendar.View))
            {
                <MudNavLink Href="planning/calendar" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CalendarMonth">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Calendar</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("planning/calendar") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("planning/calendar"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Timesheets.AccessTimesheet))
            {
                <MudNavLink Href="my-timesheet" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccessTime">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">My Timesheet</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("my-timesheet") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("my-timesheet"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Finance.AccessExpenses))
            {
                <MudNavLink Href="me/expenses" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Receipt">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">My Expenses</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("me/expenses") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("me/expenses"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }

            @if (HasPerm(AppPermissions.Albums.View))
            {
                <MudNavLink Href="albums" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.PhotoAlbum">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">Albums</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("albums") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("albums"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>
            }
        </MudNavGroup>

        @* ==========================================
           PILLAR 2: WORK (Projects & Clients)
           ========================================== *@
        @if (HasPerm(AppPermissions.Projects.View) || HasAnyPerm(AppPermissions.AddressBook.View, AppPermissions.AddressBook.Manage) || HasPerm(AppPermissions.BusinessDocuments.View) || PrivacyService.CanViewDirectory(_currentUser))
        {
            <MudNavGroup Title="Work" Icon="@Icons.Material.Filled.Work" Expanded="false">
                @if (HasPerm(AppPermissions.Projects.View))
                {
                    <MudNavLink Href="projects" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FolderSpecial">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Projects</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("projects") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("projects"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasAnyPerm(AppPermissions.AddressBook.View, AppPermissions.AddressBook.Manage))
                {
                    <MudNavLink Href="/business/address-book" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Contacts">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Clients</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("/business/address-book") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("/business/address-book"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.BusinessDocuments.View))
                {
                    <MudNavLink Href="business/documents" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Description">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Documents</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/documents") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/documents"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (PrivacyService.CanViewDirectory(_currentUser))
                {
                    <MudNavLink Href="organization" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountTree">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@AppLabels.Company Directory</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("organization") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("organization"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           PILLAR 3: MONEY (Financials & Procurement)
           ========================================== *@
        @if (HasPerm(AppPermissions.Finance.AccessAccounting) || HasAnyPerm(AppPermissions.Purchases.ViewPOs, AppPermissions.Purchases.ManagePOs))
        {
            <MudNavGroup Title="Money" Icon="@Icons.Material.Filled.AttachMoney" Expanded="false">
                @if (HasPerm(AppPermissions.Finance.AccessAccounting))
                {
                    <MudNavLink Href="/business-dashboard" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Dashboard">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Financial Dashboard</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("/business-dashboard") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("/business-dashboard"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="business/accounting" Match="NavLinkMatch.All" Icon="@Icons.Material.Filled.AccountBalance">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@BizLoc["Accounting"]</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/accounting") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/accounting"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="business/accounting/inbox" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.MarkEmailUnread">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Bill Inbox</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/accounting/inbox") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/accounting/inbox"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    <MudNavLink Href="business/operating-costs" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.AccountBalanceWallet">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@BizLoc["Operating Costs"]</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/operating-costs") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/operating-costs"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasAnyPerm(AppPermissions.Purchases.ViewPOs, AppPermissions.Purchases.ManagePOs))
                {
                    <MudNavLink Href="purchases" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.ReceiptLong">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Purchases & POs</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("purchases") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("purchases"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           TEAM LEAD (Management & Approvals)
           ========================================== *@
        @if (IsTeamLeader || _currentUser?.IsAdmin == true)
        {
            <MudNavGroup Title="Team Lead" Icon="@Icons.Material.Filled.SupervisorAccount" Expanded="false">
                <MudNavLink Href="planning/timesheet-approvals" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.FactCheck">
                    <div class="d-flex align-center" style="width: 100%;">
                        <span style="flex: 1;">@AppLabels.Team Timesheets</span>
                        @if (_isEditingFavorites)
                        {
                            <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("planning/timesheet-approvals") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("planning/timesheet-approvals"))' />
                            </span>
                        }
                    </div>
                </MudNavLink>

                @if (Db.CompanyProfile.Get()?.TimesheetConfig?.EnableWeeklyPlan ?? true)
                {
                    <MudNavLink Href="planning/manager" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.SupervisorAccount">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@AppLabels.Team Planning</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("planning/manager") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("planning/manager"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           BUSINESS (HR, Reports, Planning & Settings)
           ========================================== *@
        @if (HasAnyPerm(AppPermissions.Hr.ManageEmployees, AppPermissions.Admin.ManageUsers, AppPermissions.Hr.ManageSalaries, AppPermissions.Timesheets.ViewReport, AppPermissions.Finance.TeamCapacity, AppPermissions.Finance.AccessAccounting, AppPermissions.Business.ManageSettings))
        {
            <MudNavGroup Title="Business" Icon="@Icons.Material.Filled.Business" Expanded="false">
                @if (HasAnyPerm(AppPermissions.Hr.ManageEmployees, AppPermissions.Admin.ManageUsers, AppPermissions.Hr.ManageSalaries))
                {
                    <MudNavLink Href="business/hr" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Badge">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@BizLoc["HR & People"]</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/hr") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/hr"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.Timesheets.ViewReport))
                {
                    <MudNavLink Href="business/timesheet-reports" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Assessment">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Timesheet Reports</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/timesheet-reports") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/timesheet-reports"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasAnyPerm(AppPermissions.Finance.AccessAccounting, AppPermissions.Finance.TeamCapacity))
                {
                    <MudNavLink Href="business/capacity" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Groups">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@BizLoc["Forward Planning & Capacity"]</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/capacity") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/capacity"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.Business.ManageSettings))
                {
                    <MudNavLink Href="business/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Tune">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">@BizLoc["Business Settings"]</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("business/settings") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("business/settings"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }

        @* ==========================================
           SERVER ADMIN (System Configuration)
           ========================================== *@
        @if (HasPerm(AppPermissions.Admin.ManageSettings) || HasPerm(AppPermissions.Chat.Moderator) || _currentUser?.IsAdmin == true)
        {
            <MudNavGroup Title="Server Admin" Icon="@Icons.Material.Filled.AdminPanelSettings" Expanded="false">
                @if (HasPerm(AppPermissions.Admin.ManageSettings) || _currentUser?.IsAdmin == true)
                {
                    <MudNavLink Href="admin/settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Settings">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Settings</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/settings") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/settings"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                    @if (_currentUser?.IsEffectiveAdmin == true)
                    {
                        <MudNavLink Href="admin/data-migration" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.CloudUpload">
                            <div class="d-flex align-center" style="width: 100%;">
                                <span style="flex: 1;">Data Migration</span>
                                @if (_isEditingFavorites)
                                {
                                    <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                        <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/data-migration") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/data-migration"))' />
                                    </span>
                                }
                            </div>
                        </MudNavLink>
                    }
                }

                @if (_currentUser?.IsEffectiveAdmin == true && Config.GetValue<bool>("Spokes_DemoSetup"))
                {
                    <MudNavLink Href="admin/demo-settings" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Build">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Demo Settings</span>
                        </div>
                    </MudNavLink>
                }

                @if (HasPerm(AppPermissions.Chat.Moderator) || _currentUser?.IsAdmin == true)
                {
                    <MudNavLink Href="admin/moderation" Match="NavLinkMatch.Prefix" Icon="@Icons.Material.Filled.Gavel">
                        <div class="d-flex align-center" style="width: 100%;">
                            <span style="flex: 1;">Moderation</span>
                            @if (_isEditingFavorites)
                            {
                                <span @onclick:stopPropagation="true" @onclick:preventDefault="true">
                                    <MudIconButton Icon='@(_currentUser?.FavoriteLinks.Contains("admin/moderation") == true ? Icons.Material.Filled.Star : Icons.Material.Outlined.StarBorder)' Color="Color.Default" Size="Size.Small" OnClick='@(() => ToggleFavorite("admin/moderation"))' />
                                </span>
                            }
                        </div>
                    </MudNavLink>
                }
            </MudNavGroup>
        }
    }
    

</MudNavMenu>

@code {
    [Parameter] public bool _isEditingFavorites { get; set; } = false;
    [Parameter] public bool drawerOpen { get; set; } = true;
    
    private bool IsFamilyEdition => Db.CompanyProfile.Get()?.Edition == "Family";
    private bool IsEmailEligible => !IsFamilyEdition && HasPerm(AppPermissions.Email.Use);
    private bool IsNavHrefPermitted(string href) => href != "email" || IsEmailEligible;
    
    private bool IsTeamLeader = false;
    private Employee? _currentUser;
    private int _unreadCount = 0;
    private int _unreadEmailCount = 0;
    private string? _currentUserId;

    private (string Title, string Icon) GetLinkMetadata(string href) => href switch
    {
        "" => ("Home", Icons.Material.Filled.Home),
        "chat" => ("Chat", Icons.Material.Filled.Chat),
        "email" => ("Email", Icons.Material.Filled.Email),
        "my-timesheet" => ("Timesheet", Icons.Material.Filled.AccessTime),
        "planning/calendar" => (IsFamilyEdition ? "Family Calendar" : "My Calendar", Icons.Material.Filled.CalendarMonth),
        "me/expenses" => ("My Expenses", Icons.Material.Filled.Receipt),
        "projects" => ("Projects", Icons.Material.Filled.FolderSpecial),
        "purchases" => ("Purchases & POs", Icons.Material.Filled.ReceiptLong),
        "planning/manager" => ($"{AppLabels.Team} Planning", Icons.Material.Filled.SupervisorAccount),
        "/business/address-book" => ("Clients", Icons.Material.Filled.Contacts),
        "/business-dashboard" => ("Financial Dashboard", Icons.Material.Filled.Dashboard),
        "business/accounting" => (BizLoc["Accounting"].Value, Icons.Material.Filled.AccountBalance),
        "business/accounting/inbox" => ("Bill Inbox", Icons.Material.Filled.MarkEmailUnread),
        "business/operating-costs" => (BizLoc["Operating Costs"].Value, Icons.Material.Filled.AccountBalanceWallet),
        "business/timesheet-reports" => ("Timesheet Reports", Icons.Material.Filled.Assessment),
        "planning/timesheet-approvals" => ($"{AppLabels.Team} Timesheets", Icons.Material.Filled.FactCheck),
        "/business/expenses" => (BizLoc["Operating Costs"].Value, Icons.Material.Filled.AccountBalanceWallet),
        "business/capacity" => (BizLoc["Forward Planning & Capacity"].Value, Icons.Material.Filled.Groups),
        "business/documents" => ("Documents", Icons.Material.Filled.Description),
        "organization" => ($"{AppLabels.Company} Directory", Icons.Material.Filled.AccountTree),
        "business/hr" => (BizLoc["HR & People"].Value, Icons.Material.Filled.Badge),
        "business/settings" => (BizLoc["Business Settings"].Value, Icons.Material.Filled.Tune),
        "admin/definitions" => (BizLoc["Business Settings"].Value, Icons.Material.Filled.Tune),
        "admin/standard-documents" => (BizLoc["Business Settings"].Value, Icons.Material.Filled.Tune),
        "admin/data-migration" => ("Data Migration", Icons.Material.Filled.CloudUpload),
        "admin/settings" => ("Settings", Icons.Material.Filled.Settings),
        "admin/demo-settings" => ("Demo Settings", Icons.Material.Filled.Build),
        "admin/moderation" => ("Moderation", Icons.Material.Filled.Gavel),
        "albums" => ("Albums", Icons.Material.Filled.PhotoAlbum),
        _ => ("Unknown", Icons.Material.Filled.Link)
    };

    private NavLinkMatch GetNavLinkMatch(string href)
    {
        if (string.IsNullOrEmpty(href) || href.TrimStart('/') == "business/accounting")
        {
            return NavLinkMatch.All;
        }
        return NavLinkMatch.Prefix;
    }

    private void SetLandingPage(string href)
    {
        if (_currentUser == null) return;
        _currentUser.LandingPage = string.IsNullOrEmpty(href) ? null : href;
        Db.Employees.Save(_currentUser);
        StateHasChanged();
    }

    private List<string> GetAvailableLandingPages()
    {
        var pages = new List<string>();

        // Me
        if (HasPerm(AppPermissions.Chat.Use)) pages.Add("chat");
        if (!IsFamilyEdition && HasPerm(AppPermissions.Email.Use)) pages.Add("email");
        if (HasPerm(AppPermissions.Calendar.View)) pages.Add("planning/calendar");
        if (HasPerm(AppPermissions.Timesheets.AccessTimesheet)) pages.Add("my-timesheet");
        if (HasPerm(AppPermissions.Finance.AccessExpenses)) pages.Add("me/expenses");
        if (HasPerm(AppPermissions.Albums.View)) pages.Add("albums");

        // Work
        if (HasPerm(AppPermissions.Projects.View)) pages.Add("projects");
        if (HasAnyPerm(AppPermissions.AddressBook.View, AppPermissions.AddressBook.Manage)) pages.Add("/business/address-book");
        if (HasPerm(AppPermissions.BusinessDocuments.View)) pages.Add("business/documents");
        if (PrivacyService.CanViewDirectory(_currentUser)) pages.Add("organization");

        // Money
        if (HasPerm(AppPermissions.Finance.AccessAccounting))
        {
            pages.Add("/business-dashboard");
            pages.Add("business/accounting");
            pages.Add("business/accounting/inbox");
            pages.Add("business/operating-costs");
        }
        if (HasAnyPerm(AppPermissions.Purchases.ViewPOs, AppPermissions.Purchases.ManagePOs)) pages.Add("purchases");

        // Team Lead
        if (IsTeamLeader || _currentUser?.IsAdmin == true)
        {
            pages.Add("planning/timesheet-approvals");
            if (Db.CompanyProfile.Get()?.TimesheetConfig?.EnableWeeklyPlan ?? true) pages.Add("planning/manager");
        }

        // Business
        if (HasAnyPerm(AppPermissions.Hr.ManageEmployees, AppPermissions.Admin.ManageUsers, AppPermissions.Hr.ManageSalaries))
        {
            pages.Add("business/hr");
        }
        if (HasPerm(AppPermissions.Timesheets.ViewReport))
        {
            pages.Add("business/timesheet-reports");
        }
        if (HasAnyPerm(AppPermissions.Finance.AccessAccounting, AppPermissions.Finance.TeamCapacity))
        {
            pages.Add("business/capacity");
        }
        if (HasPerm(AppPermissions.Business.ManageSettings))
        {
            pages.Add("business/settings");
        }

        // Server Admin
        if (HasPerm(AppPermissions.Admin.ManageSettings) || _currentUser?.IsAdmin == true)
        {
            pages.Add("admin/settings");
            if (_currentUser?.IsEffectiveAdmin == true)
            {
                pages.Add("admin/data-migration");
                if (Config.GetValue<bool>("Spokes_DemoSetup")) pages.Add("admin/demo-settings");
            }
        }
        if (HasPerm(AppPermissions.Chat.Moderator) || _currentUser?.IsAdmin == true) pages.Add("admin/moderation");

        return pages;
    }

    private void MoveFavoriteUp(string href)
    {
        if (_currentUser == null) return;
        var landingHref = _currentUser.LandingPage ?? "";
        var visible = _currentUser.FavoriteLinks.Where(h => h != "" && h != landingHref && IsNavHrefPermitted(h)).ToList();
        var visIndex = visible.IndexOf(href);
        if (visIndex > 0)
        {
            var targetPrev = visible[visIndex - 1];
            var actualIndex = _currentUser.FavoriteLinks.IndexOf(href);
            var prevActualIndex = _currentUser.FavoriteLinks.IndexOf(targetPrev);
            _currentUser.FavoriteLinks.RemoveAt(actualIndex);
            _currentUser.FavoriteLinks.Insert(prevActualIndex, href);
            Db.Employees.Save(_currentUser);
            StateHasChanged();
        }
    }

    private void MoveFavoriteDown(string href)
    {
        if (_currentUser == null) return;
        var landingHref = _currentUser.LandingPage ?? "";
        var visible = _currentUser.FavoriteLinks.Where(h => h != "" && h != landingHref && IsNavHrefPermitted(h)).ToList();
        var visIndex = visible.IndexOf(href);
        if (visIndex >= 0 && visIndex < visible.Count - 1)
        {
            var targetNext = visible[visIndex + 1];
            var actualIndex = _currentUser.FavoriteLinks.IndexOf(href);
            var nextActualIndex = _currentUser.FavoriteLinks.IndexOf(targetNext);
            _currentUser.FavoriteLinks.RemoveAt(actualIndex);
            _currentUser.FavoriteLinks.Insert(nextActualIndex, href);
            Db.Employees.Save(_currentUser);
            StateHasChanged();
        }
    }

    private void ToggleFavorite(string href)
    {
        if (_currentUser == null) return;
        
        if (_currentUser.FavoriteLinks.Contains(href))
        {
            _currentUser.FavoriteLinks.Remove(href);
        }
        else
        {
            _currentUser.FavoriteLinks.Add(href);
        }
        
        Db.Employees.Save(_currentUser);
    }

    protected override async Task OnInitializedAsync()
    {
        var sw = System.Diagnostics.Stopwatch.StartNew();
        StartupTimings.Add("Server: NavMenu OnInitializedAsync Start");
        _currentUser = await UserService.GetEmployeeAsync();
        if (_currentUser != null)
        {
            if (_currentUser.FavoriteLinks.Contains("planning/my-week"))
            {
                var index = _currentUser.FavoriteLinks.IndexOf("planning/my-week");
                _currentUser.FavoriteLinks[index] = "planning/calendar";
                Db.Employees.Save(_currentUser);
            }

            if (_currentUser.FavoriteLinks.Contains("boards"))
            {
                _currentUser.FavoriteLinks.Remove("boards");
                Db.Employees.Save(_currentUser);
            }

            if (_currentUser.FavoriteLinks.Contains("admin/definitions") || _currentUser.FavoriteLinks.Contains("admin/standard-documents"))
            {
                _currentUser.FavoriteLinks.Remove("admin/definitions");
                _currentUser.FavoriteLinks.Remove("admin/standard-documents");
                if (!_currentUser.FavoriteLinks.Contains("business/settings"))
                {
                    _currentUser.FavoriteLinks.Add("business/settings");
                }
                Db.Employees.Save(_currentUser);
            }

            _currentUserId = _currentUser.Id;

            // Check if Team Leader
            IsTeamLeader = Db.Teams.GetAll().Any(t => t.LeaderId == _currentUser.Id);

            // Subscribe to unread count changes (lifecycle owned by MainLayout)
            ChatNotifications.OnUnreadCountChanged += UpdateUnreadCount;
            EmailNotifications.OnUnreadCountChanged += UpdateUnreadEmailCount;
            Db.Employees.OnSaved += OnEmployeeSaved;
            Db.CompanyProfile.OnSaved += OnCompanyProfileSaved;

            _unreadCount = ChatNotifications.TotalUnreadCount;
            _unreadEmailCount = EmailNotifications.TotalUnreadCount;
        }
        StartupTimings.Add($"Server: NavMenu OnInitializedAsync Done (+{sw.ElapsedMilliseconds}ms)");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender && _currentUser != null)
        {
            try { await JS.InvokeVoidAsync("pushNotifications.updateBadge", _unreadCount + _unreadEmailCount); } catch { }
        }
    }

    private void OnEmployeeSaved(Employee savedEmployee)
    {
        if (string.IsNullOrEmpty(_currentUserId) || savedEmployee.Id != _currentUserId) return;
        _currentUser = Db.Employees.GetById(_currentUserId) ?? savedEmployee;
        _ = InvokeAsync(StateHasChanged);
    }

    private void OnCompanyProfileSaved(CompanyProfile profile)
    {
        if (!string.IsNullOrEmpty(_currentUserId))
        {
            _currentUser = Db.Employees.GetById(_currentUserId) ?? _currentUser;
        }
        _ = InvokeAsync(StateHasChanged);
    }

    private bool HasPerm(string perm) => _currentUser?.HasPermission(perm) ?? false;

    private bool HasAnyPerm(params string[] perms)
    {
        if (_currentUser == null) return false;
        if (_currentUser.IsAdmin) return true;
        return perms.Any(p => _currentUser.HasPermission(p));
    }

    private void UpdateUnreadCount()
    {
        var nextCount = ChatNotifications.TotalUnreadCount;
        if (nextCount == _unreadCount)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            _unreadCount = nextCount;
            StateHasChanged();
            await Task.Delay(250);
            try { await JS.InvokeVoidAsync("pushNotifications.updateBadge", _unreadCount + _unreadEmailCount); } catch { }
        });
    }

    private void UpdateUnreadEmailCount()
    {
        var nextEmailCount = EmailNotifications.TotalUnreadCount;
        if (nextEmailCount == _unreadEmailCount)
        {
            return;
        }
        _ = InvokeAsync(async () =>
        {
            _unreadEmailCount = nextEmailCount;
            StateHasChanged();
            await Task.Delay(250);
            try { await JS.InvokeVoidAsync("pushNotifications.updateBadge", _unreadCount + _unreadEmailCount); } catch { }
        });
    }

    public void Dispose()
    {
        ChatNotifications.OnUnreadCountChanged -= UpdateUnreadCount;
        EmailNotifications.OnUnreadCountChanged -= UpdateUnreadEmailCount;
        Db.Employees.OnSaved -= OnEmployeeSaved;
        Db.CompanyProfile.OnSaved -= OnCompanyProfileSaved;
    }
}
