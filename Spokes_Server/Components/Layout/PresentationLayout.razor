@inherits LayoutComponentBase

<MudThemeProvider Theme="@_theme" IsDarkMode="true" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<div style="position: fixed; inset: 0; width: 100%; height: 100%; overflow: hidden; background-color: #0b0b0f; margin: 0; padding: 0; box-sizing: border-box;">
    @Body
</div>

@code {
    private readonly MudTheme _theme = SpokesTheme.CreateTheme();
}
