@inherits LayoutComponentBase
@using Spokes_Server.Core.Constants
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Http
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.Licensing
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.UI
@inject Database Db
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthStateProvider
@inject UserService UserService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TimesheetTimerService TimerService
@inject ISnackbar Snackbar
@inject PresenceStateService PresenceState
@inject UserCircuitContext CircuitContext
@inject IBrowserViewportService ViewportService
@inject AppLabelService AppLabels
@inject LicenseValidationService LicenseValidationService
@inject ChatNotificationService ChatNotifications
@inject Spokes_Server.Core.Services.Communication.Email.EmailNotificationService EmailNotifications
@inject Spokes_Server.Core.Services.HR.Calendar.CalendarNotificationService CalendarNotifications
@inject ShareTargetStateService ShareTargetStateService
@inject ServerUpdateService ServerUpdateService
@inject ScopedKeystoreService ScopedKeystore
@inject Microsoft.AspNetCore.DataProtection.IDataProtectionProvider DataProtection
@inject ImageRecoveryService ImageRecovery
@inject IHttpContextAccessor HttpContextAccessor
@inject StartupTimingService StartupTimings
@inject UserClientStateService UserClientStateService
@inject SessionService SessionService
@inject IStorageHealthService StorageHealth
@inject ILogger<MainLayout> Logger
@inject Spokes_Server.Core.Services.Communication.Voice.GlobalVoiceService VoiceService
@implements IAsyncDisposable
@implements IBrowserViewportObserver

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<SpokesDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @if (StartupTimings.IsChatProfilerEnabled)
    {
        StartupTimings.AddChatTransition($"Server: RenderTree MainLayout[{_diagTag}] #{++_diagRenderCount} (_isChatChannelOpen={_isChatChannelOpen})");
    }
    <MudAppBar Class="@($"py-n2{(_isChatChannelOpen ? " hide-appbar-mobile" : "")}")" Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@((e) => DrawerToggle())" />
        <div class="d-flex align-center ml-1 flex-shrink-1" style="min-width: 0; overflow: hidden; cursor: pointer;" @onclick="@(() => Nav.NavigateTo("/"))">
            @if (Profile?.HasCustomLogo == true)
            {
                <MudImage Src="@($"/spokesapi/Media/Logo?v={Profile.LogoVersion}")" Height="32" Class="mr-2 flex-shrink-0" />
            }
            else if (Profile?.HasCustomIcon == true)
            {
                <MudImage Src="@($"/spokesapi/Media/Icon?v={Profile.IconVersion}")" Height="32" Class="mr-2 flex-shrink-0" />
            }

            <MudText Typo="Typo.h6" Style="font-weight: 700; white-space: nowrap; overflow: hidden; text-overflow: ellipsis; min-width: 0;">
                @Profile?.CompanyName
            </MudText>
        </div>

        @if (!CircuitContext.IsMobileLayout)
        {
            @* Desktop Toolbar *@
            @if (!IsFriendEdition)
            {
                <LazyMudMenu Icon="@Icons.Material.Filled.Add" Color="Color.Inherit" Class="ml-4" AnchorOrigin="Origin.BottomLeft" TransformOrigin="Origin.TopLeft" Context="closeMenu">
                    <MudListItem T="string" Class="mud-menu-item" OnClick="@(() => { closeMenu(); Nav.NavigateTo("/projects/new"); })">@BizLoc["New Project"]</MudListItem>
                    <MudListItem T="string" Class="mud-menu-item" OnClick="@(() => { closeMenu(); Nav.NavigateTo("/my-timesheet"); })">@BizLoc["Log Time"]</MudListItem>
                    <MudListItem T="string" Class="mud-menu-item" OnClick="@(() => { closeMenu(); Nav.NavigateTo("/me/expenses"); })">@BizLoc["New Expense"]</MudListItem>
                </LazyMudMenu>

                @if (!IsReadOnlyOrRestricted && _currentUser?.HasPermission(AppPermissions.Timesheets.AccessTimesheet) == true)
                {
                    <Spokes_Server.Components.Shared.TimerButton />
                }
            }
            
            <MudSpacer />
            @if (!IsFriendEdition)
            {
                <Spokes_Server.Components.Shared.GlobalSearchBar @ref="_searchBar" />
            }
            

            <MudSpacer />

            <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                OnClick="OpenUserSettingsDialog" />
            <MudIconButton Icon="@DarkLightModeButtonIcon" Color="Color.Inherit" OnClick="@DarkModeToggle"
                Class="mr-4" />

            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="d-flex align-center cursor-pointer mr-4" @onclick="OpenProfileDialog">
                        <EmployeeAvatar Employee="@_currentUser" Size="Size.Small" Class="mr-2" />
                        <MudText>
                            @(_currentUser?.FullName
                                ?? _currentUser?.Email
                                ?? auth.User.FindFirst("email")?.Value
                                ?? auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                                ?? auth.User.Identity?.Name)
                        </MudText>
                    </div>

                    <form action="logout" method="post" data-enhance="false">
                        <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error">@Loc["Logout"]
                        </MudButton>
                        <AntiforgeryToken />
                    </form>
                </Authorized>
            </AuthorizeView>
        }
        else
        {
            @* Mobile Toolbar *@
            <MudSpacer />

            @* Running timer indicator on mobile *@
            @if (_timerState.IsRunning && !IsReadOnlyOrRestricted && _currentUser?.HasPermission(AppPermissions.Timesheets.AccessTimesheet) == true)
            {
                <div class="d-flex align-center gap-1 mr-2" @onclick="StopTimerFromMenu">
                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Error" Size="Size.Small"
                        Class="timer-pulse" />
                    <MudText Typo="Typo.body2" Style="font-family: monospace; font-weight: 600;">
                        @_timerElapsed.ToString(@"hh\:mm\:ss")
                    </MudText>
                </div>
            }

            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="d-flex align-center cursor-pointer" @onclick="OpenProfileDialog">
                        <EmployeeAvatar Employee="@_currentUser" Size="Size.Small" />
                    </div>
                </Authorized>
            </AuthorizeView>

            <LazyMudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit"
                AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mr-n5"
                ContentVersion="@HashCode.Combine(IsFriendEdition, IsReadOnlyOrRestricted, _timerState.IsRunning, _isDarkMode, _currentUser?.Id, _currentUser?.AvatarVersion)"
                Context="closeMenu">

                @if (!IsFriendEdition)
                {
                    @* New Project *@
                    <MudListItem T="string" Class="mud-menu-item" Icon="@Icons.Material.Filled.Add" OnClick="@(() => { closeMenu(); Nav.NavigateTo("/projects/new"); })">
                        @BizLoc["New Project"]
                    </MudListItem>

                    @* Start/Stop Timer *@
                    @if (!IsReadOnlyOrRestricted && _currentUser?.HasPermission(AppPermissions.Timesheets.AccessTimesheet) == true)
                    {
                        @if (_timerState.IsRunning)
                        {
                            <MudListItem T="string" Class="mud-menu-item" Icon="@Icons.Material.Filled.Stop" IconColor="Color.Error" OnClick="@(async () => { closeMenu(); await StopTimerFromMenu(); })">
                                @BizLoc["Stop Timer"]
                            </MudListItem>
                        }
                        else
                        {
                            <MudListItem T="string" Class="mud-menu-item" Icon="@Icons.Material.Filled.PlayArrow" IconColor="Color.Success"
                                         OnClick="@(async () => { closeMenu(); await StartTimerFromMenu(); })">
                                @BizLoc["Start Timer"]
                            </MudListItem>
                        }
                    }
                }
                
                @if (!IsFriendEdition)
                {
                    @* Search *@
                    <MudListItem T="string" Class="mud-menu-item" Icon="@Icons.Material.Filled.Search" OnClick="@(async () => { closeMenu(); await FocusMobileSearch(); })">
                        @Loc["Search"]
                    </MudListItem>
                }
                

                @* Settings *@
                <MudListItem T="string" Class="mud-menu-item" Icon="@Icons.Material.Filled.Settings"
                    OnClick="@(async () => { closeMenu(); await OpenUserSettingsDialog(); })">
                    @Loc["Settings"]
                </MudListItem>

                @* Theme *@
                <MudListItem T="string" Class="mud-menu-item" Icon="@DarkLightModeButtonIcon" OnClick="@(() => { closeMenu(); DarkModeToggle(); })">
                    @Loc["SwitchTheme"]
                </MudListItem>

                <MudDivider />

                @* Profile *@
                <AuthorizeView>
                    <Authorized Context="auth">
                        <MudListItem T="string" Class="mud-menu-item" Style="position: relative;" Icon="@Icons.Material.Filled.Person" IconColor="Color.Transparent" OnClick="@(async () => { closeMenu(); await OpenProfileDialog(); })">
                            <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); z-index: 10; pointer-events: none;">
                                <EmployeeAvatar Employee="@_currentUser" Size="Size.Small" />
                            </span>
                            @(_currentUser?.FirstName ?? Loc["Profile"].Value)
                        </MudListItem>

                        @* Logout *@
                        <MudListItem T="string" Class="mud-menu-item" Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                            <form action="logout" method="post" data-enhance="false" id="logout-form-mobile" style="width: 100%; display: flex; flex-grow: 1;">
                                <button type="submit"
                                    style="background: none; border: none; padding: 0; margin: 0; color: inherit; width: 100%; text-align: left; cursor: pointer; display: flex; align-items: center; justify-content: flex-start;">
                                    @Loc["Logout"]
                                </button>
                                <AntiforgeryToken />
                            </form>
                        </MudListItem>

                    </Authorized>
                </AuthorizeView>
            </LazyMudMenu>
        }
    </MudAppBar>

    <MudDrawer id="nav-drawer" Open="@_drawerOpen" OpenChanged="OnDrawerOpenChanged" ClipMode="DrawerClipMode.Always" Variant="@_drawerVariant" Elevation="1" Class="@((_isLoaded ? "" : "mobile-preload-hide") + (_drawerOpen ? " is-nav-drawer-open" : " is-nav-drawer-closed"))">
        @if (Db.CompanyProfile.Get()?.Edition == "Family")
        {
            <NavMenu_Friend />
        }
        else
        {
            <NavMenu drawerOpen="_drawerOpen" _isEditingFavorites="_isEditingFavorites" />
        }
        <MudPaper Class="mb-2 d-flex flex-grow-1 flex-column" Elevation="0" Style="background-color: transparent;">
            <MudPaper Class="py-2 flex-grow-1" Height="16" Elevation="0" Style="background-color: transparent;" />
			@if (_drawerOpen)
            {
                @if (!IsFriendEdition)
                {
                    <MudPaper Class="d-flex flex-row" Elevation="0" Style="background-color: transparent;">
                        <MudSpacer></MudSpacer>
                        <MudSwitch @bind-Value="_isEditingFavorites" Size="Size.Small" ThumbIcon="@(_isEditingFavorites == true ? Icons.Material.Filled.Edit : Icons.Material.Filled.EditOff)" ThumbIconColor="@(_isEditingFavorites == true ? Color.Success : Color.Default)">@Loc["Edit"] @AppLabels.Favorites</MudSwitch>
                        <MudSpacer></MudSpacer>
                    </MudPaper>
                }

                <MudText Typo="Typo.caption" Align="Align.Center"
                         Style="color: var(--mud-palette-text-disabled); font-size: 0.7rem;">
                    @_appVersion
                </MudText>
            }
        </MudPaper>
    </MudDrawer>

    <MudMainContent Class="@($"d-flex flex-column{(_isChatChannelOpen ? " chat-channel-open" : "")} print-layout")" Style="height: 100vh; overflow: hidden;">
        @if (_currentUser != null && (_currentUser.IsAdmin || _currentUser.HasPermission(AppPermissions.Admin.ManageSettings)))
        {
            var storageStatus = StorageHealth.Status;
            if (storageStatus == StorageStatus.CriticalReadOnly)
            {
                <MudAlert Severity="Severity.Error" 
                          Dense="true" 
                          Class="mb-0 mx-2 mt-2" 
                          ShowCloseIcon="false" 
                          Style="z-index: 100;">
                    <div class="d-flex align-center flex-wrap flex-grow-1">
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Inherit" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.body2">
                            <b>@Loc["CriticalStorageFull"] (@(StorageHealth.AvailableFreeMegabytes) MB free):</b> @Loc["StorageFullDescription"]
                        </MudText>
                    </div>
                </MudAlert>
            }
            else if (storageStatus == StorageStatus.Warning)
            {
                <MudAlert Severity="Severity.Warning" 
                          Dense="true" 
                          Class="mb-0 mx-2 mt-2" 
                          ShowCloseIcon="false" 
                          Style="z-index: 100;">
                    <div class="d-flex align-center flex-wrap flex-grow-1">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Inherit" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.body2">
                            <b>@Loc["StorageWarning"]:</b> @string.Format(Loc["StorageWarningDescription"].Value, StorageHealth.AvailableFreeMegabytes)
                        </MudText>
                    </div>
                </MudAlert>
            }
        }
        @if ((_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock || 
              _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired) && 
              _currentUser != null && (_currentUser.IsAdmin || _currentUser.HasPermission(AppPermissions.Admin.ManageSettings)) && !_hideLicenseBanner)
        {
            <MudAlert Severity="@(_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ? Severity.Error : Severity.Warning)" 
                      Dense="true" 
                      NoIcon="true"
                      Class="license-banner mb-0 mx-2 mt-2" 
                      ShowCloseIcon="false" 
                      Style="z-index: 100;">
                <div class="d-flex align-center flex-wrap flex-grow-1">
                    <MudIcon Icon="@(_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ? Icons.Material.Filled.Error : Icons.Material.Filled.Warning)" 
                             Color="Color.Inherit" 
                             Size="Size.Small" 
                             Class="mr-2" />
                    <MudText Typo="Typo.body2" Class="mr-2">
                        <b>@(_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ? Loc["Spokes Pass Invalid"] : Loc["Spokes Pass Expired"])</b>
                        <span> - @Loc["Native push notifications (desktop & mobile) are currently disabled."]</span>
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => Nav.NavigateTo("/admin/settings?tab=setup"))">@Loc["Resolve"]</MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="DismissLicenseBanner">@Loc["Remind Me Later"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="NeverShowLicenseBanner">@Loc["Never Show Again"]</MudButton>
                </div>
            </MudAlert>
        }
        <Spokes_Server.Components.Shared.GlobalVoiceBar />
        <Spokes_Server.Components.Shared.VoicePipOverlay />
        <div class="flex-grow-1 d-flex flex-column overflow-auto print-scroll" style="position: relative; min-height: 0;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Loc["UnhandledErrorOccurred"]
    <a href="." class="reload">@Loc["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

@* MainLayout shell styles live in wwwroot/css/app.css so they are HTTP-cached instead of streamed in the startup SignalR RenderBatch. *@

@code {
    private bool _isLoaded = false;
    private bool _isCapacitorApp = false;
    private bool _isDesktopSession = false;
    private bool _isEditingFavorites = false;
    private bool _drawerOpen = true;
    private DrawerVariant _drawerVariant = DrawerVariant.Responsive;
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;
    private Employee? _currentUser;
    private CompanyProfile? Profile;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private Spokes_Server.Components.Shared.GlobalSearchBar? _searchBar;
    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";

    // Timer State
    private TimerState _timerState = new();
    private TimeSpan _timerElapsed;
    private System.Timers.Timer? _uiTimer;

    // Notification / Presence State
    private string? _currentSubscriptionEndpoint;
    private string? _currentSubscriptionId;
    private string? _currentPresenceToken;
    private string? _currentSessionId;
    private bool _pushPromptEvaluated = false;
    private bool _isChatPage;
    private bool _isChatChannelOpen;
    private bool _hideLicenseBanner = false;
    private bool IsReadOnlyOrRestricted => _currentUser == null || !_currentUser.IsActive || _currentUser.IsBanned || _currentUser.IsSuspended;

    private void DismissLicenseBanner()
    {
        _hideLicenseBanner = true;
        if (!IsReadOnlyOrRestricted && _currentUser != null)
        {
            _currentUser.LicenseBannerRemindLaterDate = DateTimeOffset.UtcNow.AddDays(3);
            Db.Employees.Save(_currentUser);
        }
    }

    private void NeverShowLicenseBanner()
    {
        _hideLicenseBanner = true;
        if (!IsReadOnlyOrRestricted && _currentUser != null)
        {
            _currentUser.DismissedLicenseBannerPermanently = true;
            _currentUser.LicenseBannerRemindLaterDate = null;
            Db.Employees.Save(_currentUser);
        }
    }

    private string _appVersion = Spokes_Server.Core.Services.Licensing.LicenseValidationService.AppVersion;
    private Spokes_Server.Core.Services.Licensing.LicenseStatus _licenseStatus = Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid;

    // On-demand chat transition profiler (off by default; enabled in-memory via browser console)
    private readonly string _diagTag = Guid.NewGuid().ToString("N")[..4];
    private int _diagRenderCount;
    private int _diagAfterRenderCount;

    [JSInvokable] public bool PingCircuit() => true;
    [JSInvokable] public void SetChatProfilerEnabled(bool enabled) => StartupTimings.SetChatProfilerEnabled(enabled);
    [JSInvokable] public double DiagClockPing() => StartupTimingService.NowMs();
    [JSInvokable] public int DiagBeginTransition(string name) => StartupTimings.BeginTransition(name, isNamed: false);
    [JSInvokable] public ChatTransitionDrainResult DiagDrain(int transitionId, int cursor) => StartupTimings.Drain(transitionId, cursor);

    protected override void OnInitialized()
    {
        StartupTimings.Add("Server: Layout OnInitialized");
        if (StartupTimings.IsChatProfilerEnabled) StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}] OnInitialized");
        _isChatPage = IsChatPageUrl(Nav.Uri);
        _isChatChannelOpen = IsChatChannelUrl(Nav.Uri);
        Nav.LocationChanged += HandleLocationChanged;
        CircuitContext.OnChatChannelOpenChanged += HandleChatChannelOpenChanged;
        
        SessionService.OnSessionRevoked += HandleSessionRevoked;
        SessionService.OnSessionBanned += HandleSessionBanned;
        SessionService.OnSessionVaultRevoked += HandleSessionVaultRevoked;
        SessionService.OnUserSuspensionChanged += HandleUserSuspensionChanged;
        ScopedKeystore.OnLocked += HandleScopedKeystoreLocked;
        Db.Employees.OnSaved += HandleEmployeeSaved;
        Db.CompanyProfile.OnSaved += HandleCompanyProfileSaved;

        if (Db.CompanyProfile.Get()?.Edition == "Family")
        {
            _drawerOpen = false;
        }
    }

    private void HandleChatChannelOpenChanged(bool isOpen)
    {
        if (_isChatChannelOpen != isOpen || !_isChatPage)
        {
            _isChatPage = true;
            _isChatChannelOpen = isOpen;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private void LockAndClearLocalSessionState()
    {
        if (!string.IsNullOrEmpty(_currentUser?.Id))
        {
            ScopedKeystore.Lock(_currentUser.Id);
        }
        UserService.ClearCache();
    }

    private void HandleScopedKeystoreLocked()
    {
        if (_isDisposed || CircuitContext.IsTerminated) return;
        _ = InvokeAsync(async () =>
        {
            if (_isDisposed || CircuitContext.IsTerminated) return;
            try
            {
                await JS.InvokeVoidAsync("spokesMediaLoader.clearEncryptedCache");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
                // Ignore disconnected JS interop during circuit teardown
            }
        });
    }

    private async void HandleSessionVaultRevoked(string sessionId)
    {
        if (_isDisposed || string.IsNullOrEmpty(_currentSessionId) || sessionId != _currentSessionId)
        {
            return;
        }

        if (!string.IsNullOrEmpty(_currentUser?.Id))
        {
            ScopedKeystore.Lock(_currentUser.Id);
        }
        else
        {
            ScopedKeystore.Lock();
        }

        await InvokeAsync(async () =>
        {
            if (_isDisposed || CircuitContext.IsTerminated) return;
            try
            {
                await JS.InvokeVoidAsync("spokesVault.clearStoredVaultKey");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
                // Ignore disconnected JS interop
            }
            try
            {
                await JS.InvokeVoidAsync("spokesMediaLoader.clearEncryptedCache");
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
                // Ignore disconnected JS interop
            }
        });
    }

    private async void HandleSessionRevoked(string sessionId)
    {
        if (!string.IsNullOrEmpty(_currentSessionId) && sessionId == _currentSessionId)
        {
            LockAndClearLocalSessionState();
            await InvokeAsync(async () =>
            {
                try
                {
                    await JS.InvokeVoidAsync("spokesMediaLoader.clearAllCache");
                }
                catch { }
                Nav.NavigateTo("/spokesapi/auth/force-logout", forceLoad: true);
            });
        }
    }

    private bool IsChatNotificationEligible =>
        _currentUser is { IsActive: true, IsBanned: false } &&
        _currentUser.HasEffectivePermission(AppPermissions.Chat.Use, allowSuspended: true);

    private bool IsEmailNotificationEligible =>
        !IsFriendEdition &&
        _currentUser is { IsActive: true, IsBanned: false } &&
        _currentUser.HasPermission(AppPermissions.Email.Use);

    private bool IsCalendarNotificationEligible =>
        _currentUser is { IsActive: true, IsBanned: false } &&
        (Spokes_Server.Core.Services.HR.CalendarService.HasCalendarViewAccess(_currentUser)
            || Spokes_Server.Core.Services.HR.CalendarService.HasCalendarAdminOverride(_currentUser));

    private async Task SyncChatAndCalendarNotificationsAsync()
    {
        try
        {
            if (_currentUser != null && IsChatNotificationEligible)
            {
                await ChatNotifications.InitializeAsync(_currentUser.Id);
            }
            else
            {
                await ChatNotifications.DisposeAsync();
            }

            if (_currentUser != null && IsCalendarNotificationEligible)
            {
                await CalendarNotifications.InitializeAsync(_currentUser.Id);
            }
            else
            {
                await CalendarNotifications.DisposeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[MainLayout] Error syncing chat/calendar notifications");
        }
    }

    private async Task SyncEmailNotificationsAsync()
    {
        try
        {
            var userId = _currentUser?.Id;
            if (!string.IsNullOrEmpty(userId) && IsEmailNotificationEligible)
            {
                await Task.Run(() => EmailNotifications.InitializeAsync(userId));
            }
            else
            {
                await EmailNotifications.DisposeAsync();
            }
        }
        catch (Exception ex)
        {
            Logger.LogError(ex, "[MainLayout] Error syncing email notifications");
        }
    }

    private async Task DisposeAllCircuitNotificationSubscriptionsAsync()
    {
        try { await ChatNotifications.DisposeAsync(); } catch { }
        try { await EmailNotifications.DisposeAsync(); } catch { }
        try { await CalendarNotifications.DisposeAsync(); } catch { }
    }

    private void HandleEmployeeSaved(Employee savedEmployee)
    {
        if (_isDisposed || _currentUser == null || !string.Equals(savedEmployee.Id, _currentUser.Id, StringComparison.Ordinal))
            return;

        _currentUser = Db.Employees.GetById(_currentUser.Id) ?? savedEmployee;
        _ = SyncChatAndCalendarNotificationsAsync();
        _ = SyncEmailNotificationsAsync();
    }

    private void HandleCompanyProfileSaved(CompanyProfile profile)
    {
        if (_isDisposed) return;

        Profile = profile;
        if (_currentUser != null)
        {
            _currentUser = Db.Employees.GetById(_currentUser.Id) ?? _currentUser;
            _ = SyncChatAndCalendarNotificationsAsync();
            _ = SyncEmailNotificationsAsync();
        }
    }

    private async void HandleSessionBanned(string sessionId)
    {
        if (!string.IsNullOrEmpty(_currentSessionId) && sessionId == _currentSessionId)
        {
            LockAndClearLocalSessionState();
            await DisposeAllCircuitNotificationSubscriptionsAsync();
            await InvokeAsync(async () =>
            {
                try
                {
                    await JS.InvokeVoidAsync("spokesMediaLoader.clearAllCache");
                }
                catch { }
                Nav.NavigateTo(PreserveMobileQuery("/banned"), forceLoad: true);
            });
        }
    }

    private async void HandleUserSuspensionChanged(string employeeId, bool isSuspended)
    {
        if (_isDisposed || _currentUser == null || !string.Equals(_currentUser.Id, employeeId, StringComparison.Ordinal))
        {
            return;
        }

        if (isSuspended)
        {
            LockAndClearLocalSessionState();
        }
        else
        {
            UserService.ClearCache();
        }

        await InvokeAsync(async () =>
        {
            if (isSuspended)
            {
                try
                {
                    await JS.InvokeVoidAsync("spokesMediaLoader.clearEncryptedCache");
                }
                catch { }
            }
            if (isSuspended && (VoiceService.IsInVoiceCall || VoiceService.IsConnecting))
            {
                try
                {
                    await VoiceService.DisconnectAsync();
                }
                catch
                {
                    // Ignore disconnected JS interop during force reload
                }
            }
            Nav.NavigateTo(Nav.Uri, forceLoad: true);
        });
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var newIsChatPage = IsChatPageUrl(e.Location);
        var newIsChatChannelOpen = IsChatChannelUrl(e.Location);
        bool layoutStateChanged = _isChatPage != newIsChatPage || _isChatChannelOpen != newIsChatChannelOpen;
        _isChatPage = newIsChatPage;
        _isChatChannelOpen = newIsChatChannelOpen;
        if (StartupTimings.IsChatProfilerEnabled)
        {
            StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}].HandleLocationChanged (_isChatChannelOpen={_isChatChannelOpen}, changed={layoutStateChanged}, intercepted={e.IsNavigationIntercepted}, location={new Uri(e.Location).PathAndQuery})");
        }
        
        if (_currentUser != null)
        {
            CircuitContext.IsIdle = false;
            using (StartupTimings.Span("Server: MainLayout PresenceState.PingUserActive"))
            {
                PresenceState.PingUserActive(_currentUser.Id);
            }
        }
        
        if (!newIsChatPage || layoutStateChanged)
        {
            StateHasChanged();
            if (StartupTimings.IsChatProfilerEnabled)
            {
                StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}].HandleLocationChanged StateHasChanged returned");
            }
        }
    }

    protected override async Task OnInitializedAsync()
    {
        StartupTimings.Add("Server: Layout OnInitializedAsync Start");
        Profile = Db.CompanyProfile.Get();

        // 1. Setup Theme
        _theme = SpokesTheme.CreateTheme();

        // 2. Load User Preference & Session Platform Context
        var user = HttpContextAccessor.HttpContext?.User;
        if (user?.Identity?.IsAuthenticated != true)
        {
            var authState = await AuthStateProvider.GetAuthenticationStateAsync();
            user = authState.User;
        }
        _currentSessionId = user.FindFirst("SessionId")?.Value;

        var initialSession = !string.IsNullOrEmpty(_currentSessionId) ? Db.DeviceSessions.GetById(_currentSessionId) : null;
        var ua = HttpContextAccessor.HttpContext?.Request.Headers.UserAgent.ToString() ?? string.Empty;
        bool isDesktopUa = Spokes_Server.Core.Helpers.DeviceDetectionHelper.IsDesktopClient(ua);
        bool isMobileQuery = string.Equals(HttpContextAccessor.HttpContext?.Request.Query["client"].ToString(), "mobile", StringComparison.OrdinalIgnoreCase)
            || (Nav.Uri?.Contains("client=mobile", StringComparison.OrdinalIgnoreCase) ?? false);
        bool isCapacitorFromUa = ua.Contains("Capacitor", StringComparison.OrdinalIgnoreCase);
        bool isMobileUa = Spokes_Server.Core.Helpers.DeviceDetectionHelper.IsMobileDevice(ua);
        _isDesktopSession = isDesktopUa
            || (initialSession?.DeviceInfo?.Contains("Desktop App", StringComparison.OrdinalIgnoreCase) ?? false);
        _isCapacitorApp = !_isDesktopSession && ((initialSession?.IsCapacitorApp ?? false) || isCapacitorFromUa || isMobileQuery);
        bool isInitialMobile = !_isDesktopSession && (_isCapacitorApp || isMobileUa || isMobileQuery || string.Equals(initialSession?.DeviceType, DeviceType.Mobile, StringComparison.OrdinalIgnoreCase));

        _drawerVariant = DrawerVariant.Mini;
        Snackbar.Configuration.PositionClass = Defaults.Classes.Position.BottomLeft;
        _isLoaded = true;
        if (isInitialMobile)
        {
            _drawerOpen = false;
            _drawerVariant = DrawerVariant.Responsive;
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
        }
        CircuitContext.IsMobileViewport = isInitialMobile;

        // Use UserService to get the employee (synchronous fast-path when HttpContext user is already resolved)
        _currentUser = user.Identity?.IsAuthenticated == true
            ? (UserService.GetEmployee(user) ?? await UserService.GetEmployeeAsync())
            : await UserService.GetEmployeeAsync();
        StartupTimings.Add("Server: Layout GetEmployeeAsync Done");

        // Redirect to access-pending if authenticated but no employee linked
        if (user.Identity?.IsAuthenticated == true && _currentUser == null)
        {
            var currentUri = Nav.Uri ?? string.Empty;
            if (!currentUri.Contains("/access-pending"))
            {
                Nav.NavigateTo("/access-pending", replace: true);
                return;
            }
        }

        if (_currentUser != null)
        {
            // Pre-populate CircuitContext before first render so child components have accurate platform state
            CircuitContext.UserId = _currentUser.Id;
            CircuitContext.SessionId = _currentSessionId;
            CircuitContext.IsCapacitorApp = _isCapacitorApp;
            CircuitContext.DeviceType = _isDesktopSession ? DeviceType.Desktop : (isInitialMobile ? DeviceType.Mobile : (initialSession?.DeviceType ?? DeviceType.Desktop));
            CircuitContext.IsMobileViewport = isInitialMobile;
            CircuitContext.HasPushEnabled = initialSession is { HasPush: true, PushEnabled: true };
            CircuitContext.IsFocused = true;

            if (_currentUser.IsBanned)
            {
                await DisposeAllCircuitNotificationSubscriptionsAsync();
                var currentUri = Nav.Uri ?? string.Empty;
                if (!currentUri.Contains("/banned", StringComparison.OrdinalIgnoreCase))
                {
                    Nav.NavigateTo("/banned", replace: true);
                    return;
                }
            }
            else
            {
                await SyncChatAndCalendarNotificationsAsync();
                _ = SyncEmailNotificationsAsync();
            }

            if (_currentUser.IsSuspended)
            {
                Snackbar.Add("Your account has been suspended. You are in read-only mode.", Severity.Warning, config =>
                {
                    config.VisibleStateDuration = int.MaxValue;
                });
            }

            _isDarkMode = _currentUser.IsDarkMode;

            // Init Timer
            _timerState = TimerService.GetState(_currentUser.Id);
            TimerService.OnTimerChanged += OnTimerChanged;
            if (_timerState.IsRunning) StartUiTimer();
            
            // Verify License
            var result = LicenseValidationService.ValidateLicense(Profile?.LicensePayload, Db.ServerConfigs.GetOrCreateGlobalConfig());
            _licenseStatus = result.Status;
            if (result.Status != Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid && _currentUser != null)
            {
                bool isPermanentlyDismissed = _currentUser.DismissedLicenseBannerPermanently;
                bool isRemindLaterActive = _currentUser.LicenseBannerRemindLaterDate != null && DateTimeOffset.UtcNow < _currentUser.LicenseBannerRemindLaterDate;
                if (isPermanentlyDismissed || isRemindLaterActive)
                {
                    _hideLicenseBanner = true;
                }
            }

            // Server-side vault unlock: read the HttpOnly cookie directly from HttpContext
            // before the circuit switches to WebSocket.
            // This is required so Web clients have the vault unlocked before Albums.razor renders.
            if (!IsReadOnlyOrRestricted && _currentUser != null && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey) && !ScopedKeystore.IsUnlocked)
            {
                try
                {
                ScopedKeystore.TryInitializeFromVaultCookie(
                    HttpContextAccessor.HttpContext, _currentUser.Id, _currentUser.EncryptedPrivateKey);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[MainLayout] Failed to initialize Keystore from vault cookie");
                }
            }
        }
        StartupTimings.Add("Server: Layout OnInitializedAsync Done");
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartupTimings.Add("Server: Layout OnAfterRenderAsync Start");
            _dotNetRef = DotNetObjectReference.Create(this);
            _currentSubscriptionId = Guid.NewGuid().ToString();

            if (string.IsNullOrEmpty(_currentSessionId))
            {
                try
                {
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    _currentSessionId = authState.User.FindFirst("SessionId")?.Value;
                }
                catch { }
            }

            if (_currentUser is { IsActive: true, IsBanned: false })
            {
                if (!string.IsNullOrEmpty(_currentSessionId))
                {
                    var currentSession = Db.DeviceSessions.GetById(_currentSessionId);
                    if (currentSession != null)
                    {
                        bool isSessionMobile = !_isDesktopSession && (currentSession.IsCapacitorApp || string.Equals(currentSession.DeviceType, DeviceType.Mobile, StringComparison.OrdinalIgnoreCase));
                        if (!_isDesktopSession && currentSession.IsCapacitorApp)
                        {
                            _isCapacitorApp = true;
                            CircuitContext.IsCapacitorApp = true;
                        }
                        if (isSessionMobile)
                        {
                            CircuitContext.DeviceType = DeviceType.Mobile;
                            CircuitContext.IsMobileViewport = true;
                        }
                        CircuitContext.HasPushEnabled = currentSession is { HasPush: true, PushEnabled: true };
                    }
                }

                _currentPresenceToken = Spokes_Server.Controllers.PresenceController.CreatePresenceToken(
                    DataProtection, _currentSubscriptionId, _currentUser.Id);
                CircuitContext.UserId = _currentUser.Id;
                CircuitContext.SubscriptionId = _currentSubscriptionId;
                CircuitContext.SessionId = _currentSessionId;
                if (!_isDisposed && CircuitContext.CanRegisterPresence)
                {
                    PresenceState.RegisterConnection(new ConnectionRegistrationOptions
                    {
                        UserId = _currentUser.Id,
                        SubscriptionId = _currentSubscriptionId,
                        DeviceType = CircuitContext.DeviceType,
                        HasPushEnabled = CircuitContext.HasPushEnabled,
                        IsCapacitorApp = CircuitContext.IsCapacitorApp,
                        SessionId = _currentSessionId,
                        IsFocused = CircuitContext.IsFocused,
                        IsTransportAlive = () => !_isDisposed && CircuitContext.CanRegisterPresence
                    });
                }
            }

            var vapidPublicKey = (Profile ?? Db.CompanyProfile.Get())?.VapidPublicKey ?? string.Empty;
            bool shouldBatchDeviceVaultCheck = !IsReadOnlyOrRestricted
                && _currentUser != null
                && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey)
                && !ScopedKeystore.IsUnlocked;
            using var externalVaultScope = shouldBatchDeviceVaultCheck
                ? ScopedKeystore.BeginExternalDeviceCookieInit()
                : default;

            LayoutClientInitResult? clientInit = null;
            try
            {
                clientInit = await JS.InvokeAsync<LayoutClientInitResult>("SpokesBridge.initLayout", _dotNetRef, new
                {
                    userId = _currentUser?.Id,
                    avatarLength = _currentUser?.AvatarBase64?.Length ?? 0,
                    serverTimings = StartupTimings.GetTimings(),
                    subscriptionId = _currentSubscriptionId,
                    presenceToken = _currentPresenceToken,
                    isDarkMode = _isDarkMode,
                    vapidPublicKey = vapidPublicKey,
                    needsVaultKey = shouldBatchDeviceVaultCheck
                });
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "[MainLayout] SpokesBridge.initLayout failed");
            }

            if (_isDisposed || CircuitContext.IsTerminated)
            {
                return;
            }

            if (shouldBatchDeviceVaultCheck && clientInit != null && CircuitContext.CanRegisterPresence)
            {
                await externalVaultScope.CompleteAsync(JS, clientInit.StoredVaultKey, _currentUser!.Id, _currentUser.EncryptedPrivateKey);
            }

            if (ScopedKeystore.HasPendingHttpCookieRenewal && CircuitContext.CanRegisterPresence)
            {
                _ = ScopedKeystore.RenewPendingHttpCookieAsync(JS);
            }

            if (!string.IsNullOrEmpty(clientInit?.TimeZone) && _currentUser is { IsAdmin: true, IsActive: true, IsBanned: false, IsSuspended: false })
            {
                var companyProfile = Db.CompanyProfile.Get();
                if (string.IsNullOrEmpty(companyProfile.TimeZoneId))
                {
                    try
                    {
                        _ = TimeZoneInfo.FindSystemTimeZoneById(clientInit.TimeZone);
                        companyProfile.TimeZoneId = clientInit.TimeZone;
                        Db.CompanyProfile.Save(companyProfile);
                        Profile = companyProfile;
                        Logger.LogInformation("[MainLayout] Auto-detected server timezone as {TimeZone}", clientInit.TimeZone);
                    }
                    catch (Exception tzEx)
                    {
                        Logger.LogDebug("[MainLayout] Client timezone {TimeZone} not recognized by host: {Message}", clientInit.TimeZone, tzEx.Message);
                    }
                }
            }

            var prevIsCapacitor = _isCapacitorApp;

            // Register this connection immediately in memory; slow push/FCM probes run post-TTI
            RegisterInitialPresenceConnection(clientInit);
            _deferredPushClientInit = clientInit;
            _deferredVapidPublicKey = vapidPublicKey;

            if (_isDisposed || !CircuitContext.CanRegisterPresence)
            {
                return;
            }

            // Auto-unlock vault on Native Mobile fallback (only if initLayout failed to return batched payload)
            if (shouldBatchDeviceVaultCheck && clientInit == null && !ScopedKeystore.IsUnlocked)
            {
                externalVaultScope.Dispose();
                try
                {
                    await ScopedKeystore.InitializeFromDeviceCookieAsync(JS, _currentUser!.Id, _currentUser.EncryptedPrivateKey!);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[MainLayout] Failed to initialize Keystore from device");
                }
            }

            // Server Update Notification for Admins
            if (!IsReadOnlyOrRestricted && (_currentUser!.IsEffectiveAdmin || _currentUser.HasPermission(AppPermissions.Admin.ManageSettings)))
            {
                if (ServerUpdateService.IsUpdateAvailable && !string.IsNullOrEmpty(ServerUpdateService.LatestVersion))
                {
                    if (_currentUser.LastSeenUpdateVersion != ServerUpdateService.LatestVersion)
                    {
                        Snackbar.Add($"A new server update is available (v{ServerUpdateService.LatestVersion})", Severity.Info, config =>
                        {
                            config.Action = "More Info";
                            config.ActionColor = Color.Primary;
                            config.OnClick = snackbar =>
                            {
                                Nav.NavigateTo("/admin/settings");
                                return Task.CompletedTask;
                            };
                            config.RequireInteraction = true;
                            config.ShowCloseIcon = true;
                        });
                        
                        _currentUser.LastSeenUpdateVersion = ServerUpdateService.LatestVersion;
                        Db.Employees.Save(_currentUser);
                    }
                }
            }

            if (!IsReadOnlyOrRestricted && _currentUser is { IsActiveUnsuspended: true } && _currentUser.HasPermission(AppPermissions.Chat.Use) && !_currentUser.HasVaultPassword && !_currentUser.DismissedChatWizardPermanently)
            {
                if ((_currentUser.ChatWizardRemindLaterDate == null || DateTimeOffset.UtcNow > _currentUser.ChatWizardRemindLaterDate) && !Config.GetValue<bool>("Spokes_DemoMode"))
                {
                    var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
                    var parameters = new DialogParameters { { "Employee", _currentUser } };
                    var dialog = await DialogService.ShowAsync<SecureChatSetupWizardDialog>("Secure Chat Setup", parameters, options);
                    _ = dialog.Result;
                }
            }

            bool isMobile;
            if (clientInit is { ViewportWidth: > 0 })
            {
                // MudBlazor Breakpoint.Sm upper threshold is < 960px (Breakpoint.Md starts at 960px).
                // Resolving initial breakpoint from initLayout avoids 2 sequential WAN JS round-trips
                // while attaching live resize subscriptions asynchronously in the background.
                isMobile = clientInit.ViewportWidth < 960;
                _ = SubscribeViewportResizeAsync();
            }
            else
            {
                await ViewportService.SubscribeAsync(this);
                var bp = await ViewportService.GetCurrentBreakpointAsync();
                isMobile = bp <= Breakpoint.Sm;
            }
            CircuitContext.IsMobileViewport = isMobile;

            var targetPosition = isMobile ? Defaults.Classes.Position.TopCenter : Defaults.Classes.Position.BottomLeft;
            var targetVariant = isMobile ? DrawerVariant.Responsive : DrawerVariant.Mini;
            var targetDrawerOpen = isMobile ? false : _drawerOpen;

            bool needsRender = !_isLoaded
                || Snackbar.Configuration.PositionClass != targetPosition
                || _drawerVariant != targetVariant
                || (isMobile && _drawerOpen != targetDrawerOpen)
                || prevIsCapacitor != _isCapacitorApp;

            Snackbar.Configuration.PositionClass = targetPosition;
            _drawerVariant = targetVariant;
            if (isMobile)
            {
                _drawerOpen = false;
                if (_isCapacitorApp)
                {
                    try { _ = JS.InvokeVoidAsync("spokesNotifyNavDrawerOpen", false); } catch { }
                }
            }
            _isLoaded = true;

            if (needsRender)
            {
                _pendingLayoutSettleReport = true;
                StateHasChanged();
            }
            else
            {
                await ReportLayoutAndFallbackRouteSettledAsync();
            }
        }
        else
        {
            if (_pendingLayoutSettleReport && _isLoaded)
            {
                _pendingLayoutSettleReport = false;
                await ReportLayoutAndFallbackRouteSettledAsync();
            }
            if (StartupTimings.IsChatProfilerEnabled)
            {
                StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}] OnAfterRender #{++_diagAfterRenderCount} (_isChatChannelOpen={_isChatChannelOpen})");
            }
        }
    }

    private bool _pendingLayoutSettleReport;
    private bool _layoutSettledReported;
    private bool _isDisposed;
    private LayoutClientInitResult? _deferredPushClientInit;
    private string _deferredVapidPublicKey = string.Empty;

    private async Task ReportLayoutAndFallbackRouteSettledAsync()
    {
        if (_layoutSettledReported) return;
        _layoutSettledReported = true;
        StartupTimings.Add("Server: Layout Settled");
        try
        {
            await JS.InvokeVoidAsync("startupDiagnostics.reportLayoutSettled");
            if (!StartupTimings.HasPendingRouteGate && !StartupTimings.IsRouteSettled)
            {
                var relPath = "/" + Nav.ToBaseRelativePath(Nav.Uri).Split('?')[0].Trim('/');
                if (StartupTimings.TryMarkRouteSettled(relPath))
                {
                    await JS.InvokeVoidAsync("startupDiagnostics.reportRouteSettled", relPath);
                }
            }
        }
        catch
        {
            // Ignore disconnected circuit during teardown
        }

        _ = ReconcilePushAfterInteractiveAsync(_deferredPushClientInit, _deferredVapidPublicKey);
    }

    public Guid Id { get; } = Guid.NewGuid();
