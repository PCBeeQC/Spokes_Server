    // --- Presence Connection Registration ---
    private static string? ExtractDictString(Dictionary<string, object>? dict, string key)
    {
        if (dict == null || !dict.TryGetValue(key, out var val) || val == null) return null;
        if (val is System.Text.Json.JsonElement je)
        {
            return je.ValueKind == System.Text.Json.JsonValueKind.String ? je.GetString() : je.ToString();
        }
        return val.ToString();
    }

    private void RegisterInitialPresenceConnection(LayoutClientInitResult? clientInit)
    {
        if (_currentUser == null) return;

        if (string.IsNullOrEmpty(_currentSubscriptionId))
        {
            _currentSubscriptionId = Guid.NewGuid().ToString();
        }

        var currentSession = !string.IsNullOrEmpty(_currentSessionId) ? Db.DeviceSessions.GetById(_currentSessionId) : null;
        bool isDesktopClient = (clientInit?.IsDesktopApp == true) || _isDesktopSession;
        bool isNativeApp = !isDesktopClient && ((clientInit?.IsCapacitorApp == true) || _isCapacitorApp);
        bool isCapacitorApp = !isDesktopClient && (isNativeApp || (currentSession?.IsCapacitorApp ?? false));
        bool isMobileSession = !isDesktopClient && (isCapacitorApp
            || string.Equals(clientInit?.DeviceType, DeviceType.Mobile, StringComparison.OrdinalIgnoreCase)
            || string.Equals(currentSession?.DeviceType, DeviceType.Mobile, StringComparison.OrdinalIgnoreCase)
            || string.Equals(CircuitContext.DeviceType, DeviceType.Mobile, StringComparison.OrdinalIgnoreCase));
        var deviceType = isDesktopClient
            ? DeviceType.Desktop
            : (isMobileSession
                ? DeviceType.Mobile
                : (!string.IsNullOrEmpty(clientInit?.DeviceType) ? clientInit.DeviceType : (currentSession?.DeviceType ?? DeviceType.Desktop)));

        // Self-heal previously poisoned sessions or persist Capacitor identity on mobile sessions
        if (!IsReadOnlyOrRestricted && isDesktopClient && currentSession != null && (currentSession.IsCapacitor || currentSession.DeviceType != DeviceType.Desktop))
        {
            currentSession.IsCapacitor = false;
            currentSession.DeviceType = DeviceType.Desktop;
            Db.DeviceSessions.Save(currentSession);
        }
        else if (!IsReadOnlyOrRestricted && isCapacitorApp && currentSession != null && (!currentSession.IsCapacitor || currentSession.DeviceType != DeviceType.Mobile))
        {
            currentSession.IsCapacitor = true;
            currentSession.DeviceType = DeviceType.Mobile;
            Db.DeviceSessions.Save(currentSession);
        }

        bool initialHasPushEnabled = currentSession is { HasPush: true, PushEnabled: true };
        if (initialHasPushEnabled && !string.IsNullOrEmpty(currentSession?.PushEndpoint))
        {
            _currentSubscriptionEndpoint = currentSession.PushEndpoint;
        }

        _isCapacitorApp = isCapacitorApp;

        bool hadConnection = PresenceState.HasConnection(_currentSubscriptionId);
        bool wasActivelyViewed = hadConnection && PresenceState.IsConnectionActivelyViewed(_currentSubscriptionId);
        if (hadConnection && !wasActivelyViewed)
        {
            // Sync CircuitContext if an out-of-band /spokesapi/presence/unfocus arrived during initLayout.
            CircuitContext.IsFocused = false;
        }
        else if (!hadConnection && clientInit?.IsFocused == false)
        {
            CircuitContext.IsFocused = false;
        }

        CircuitContext.UserId = _currentUser.Id;
        CircuitContext.SubscriptionId = _currentSubscriptionId;
        CircuitContext.SessionId = _currentSessionId;
        CircuitContext.DeviceType = deviceType;
        CircuitContext.HasPushEnabled = initialHasPushEnabled;
        CircuitContext.IsCapacitorApp = isCapacitorApp;
        CircuitContext.IsIdle = false;

        if (_isDisposed || !CircuitContext.CanRegisterPresence)
        {
            return;
        }

        PresenceState.RegisterConnection(new ConnectionRegistrationOptions
        {
            UserId = _currentUser.Id,
            SubscriptionId = _currentSubscriptionId,
            DeviceType = deviceType,
            HasPushEnabled = initialHasPushEnabled,
            IsCapacitorApp = isCapacitorApp,
            SessionId = _currentSessionId,
            IsFocused = CircuitContext.IsFocused,
            PreserveExistingActivity = true,
            IsTransportAlive = () => !_isDisposed && CircuitContext.CanRegisterPresence
        });

        if (!wasActivelyViewed && PresenceState.IsConnectionActivelyViewed(_currentSubscriptionId))
        {
            CircuitContext.NotifyFocusChanged();
        }
    }

    private async Task ReconcilePushAfterInteractiveAsync(LayoutClientInitResult? clientInit, string vapidPublicKey)
    {
        if (_isDisposed || _currentUser == null) return;

        try
        {
            // Let the settled UI frame flush cleanly before probing ServiceWorker / FCM / AndroidKeyStore
            await Task.Delay(60);
            if (_isDisposed || _currentUser == null) return;

            var sessionBeforeProbe = !string.IsNullOrEmpty(_currentSessionId) ? Db.DeviceSessions.GetById(_currentSessionId) : null;

            PushProbeResult? pushProbe = null;
            try
            {
                pushProbe = await JS.InvokeAsync<PushProbeResult?>("SpokesBridge.probePushState", new
                {
                    isCapacitorApp = _isCapacitorApp,
                    hasServerPush = sessionBeforeProbe is { HasPush: true, PushExplicitlyDisabled: false },
                    pushExplicitlyDisabled = sessionBeforeProbe?.PushExplicitlyDisabled == true
                });
            }
            catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
            {
                return;
            }
            catch (Exception ex)
            {
                Logger.LogDebug(ex, "[MainLayout] Deferred push probe failed");
            }

            if (_isDisposed || _currentUser == null) return;

            var currentSession = !string.IsNullOrEmpty(_currentSessionId) ? Db.DeviceSessions.GetById(_currentSessionId) : null;
            bool isDesktopClient = (clientInit?.IsDesktopApp == true) || _isDesktopSession;
            bool isNativeApp = !isDesktopClient && ((clientInit?.IsCapacitorApp == true) || _isCapacitorApp);
            bool isCapacitorApp = _isCapacitorApp;
            var deviceType = CircuitContext.DeviceType;
            bool isExplicitlyDisabled = currentSession?.PushExplicitlyDisabled == true;

            bool hasPushEnabled = false;
            bool shouldSyncPushSubscription = false;
            var existingSub = isExplicitlyDisabled ? null : (pushProbe?.ExistingSubscription ?? clientInit?.ExistingSubscription);
            var endpoint = ExtractDictString(existingSub, "endpoint");

            if (!isExplicitlyDisabled && existingSub != null && !string.IsNullOrEmpty(endpoint))
            {
                _currentSubscriptionEndpoint = endpoint;
                var sub = Db.DeviceSessions.GetByPushEndpoint(_currentSubscriptionEndpoint);
                var incomingPubKey = ExtractDictString(existingSub, "publicKey");
                var subType = ExtractDictString(existingSub, "subscriptionType");
                bool isExistingRelay = string.Equals(subType, "NativeRelay", StringComparison.OrdinalIgnoreCase)
                    || string.Equals(currentSession?.PushSubscriptionType, "NativeRelay", StringComparison.OrdinalIgnoreCase)
                    || isNativeApp || isDesktopClient || (clientInit?.RequiresPushRelay ?? false);
                bool pubKeyMatches = isExistingRelay
                    ? (!string.IsNullOrEmpty(incomingPubKey) && currentSession?.PushPublicKey == incomingPubKey)
                    : (string.IsNullOrEmpty(incomingPubKey) || currentSession?.PushPublicKey == incomingPubKey);

                if (sub != null && sub.Id == currentSession?.Id && currentSession.HasPush && pubKeyMatches)
                {
                    hasPushEnabled = currentSession.PushEnabled;
                }
                else
                {
                    bool isNativePushBlocked = _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ||
                                               _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired;

                    if (!isExistingRelay || !isNativePushBlocked)
                    {
                        hasPushEnabled = true;
                        shouldSyncPushSubscription = true;
                    }
                }
            }
            else
            {
                _currentSubscriptionEndpoint = null;
            }

            if (CircuitContext.HasPushEnabled != hasPushEnabled)
            {
                CircuitContext.HasPushEnabled = hasPushEnabled;
                PresenceState.UpdatePushEnabledState(_currentSubscriptionId, hasPushEnabled);
            }

            if ((pushProbe?.IosSoundDisabled == true || clientInit?.IosSoundDisabled == true) && hasPushEnabled)
            {
                Snackbar.Add("Notification sounds are disabled for Spokes in your iPhone Settings.", Severity.Warning, config =>
                {
                    config.Action = "Open Settings";
                    config.ActionColor = Color.Warning;
                    config.OnClick = _ => JS.InvokeVoidAsync("pushNotifications.openAppSettings").AsTask();
                    config.RequireInteraction = true;
                });
            }

            if (!IsReadOnlyOrRestricted && !isExplicitlyDisabled && shouldSyncPushSubscription && existingSub != null && !_isDisposed)
            {
                try
                {
                    await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer", existingSub, deviceType, "");
                }
                catch { /* Ignore */ }
            }

            if (_isDisposed) return;

            // Auto-prompt or auto-register push notifications on new devices that don't have an active endpoint yet,
            // unless the user explicitly disabled push notifications on this server session.
            if (!_pushPromptEvaluated && !IsReadOnlyOrRestricted && !isExplicitlyDisabled && string.IsNullOrEmpty(_currentSubscriptionEndpoint) && !Config.GetValue<bool>("Spokes_DemoMode"))
            {
                _pushPromptEvaluated = true;
                if (!string.IsNullOrEmpty(vapidPublicKey))
                {
                    var permStatus = pushProbe?.PermissionStatus ?? clientInit?.PermissionStatus ?? "default";
                    bool requiresRelay = isNativeApp || isDesktopClient || (clientInit?.RequiresPushRelay ?? false);

                    if (permStatus == "granted" && !requiresRelay)
                    {
                        await TriggerAutoPushRegistration(vapidPublicKey, isSilent: true, clientInit);
                    }
                    else if ((permStatus is "default" or "prompt" or "prompt-with-rationale" || (permStatus == "granted" && requiresRelay)) && clientInit is { HasBeenPromptedForPush: false, IsPushSupported: true })
                    {
                        bool isNativePushBlocked = _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ||
                                                   _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired;

                        if (requiresRelay && isNativePushBlocked)
                        {
                            await JS.InvokeVoidAsync("pushNotifications.setPushPrompted", vapidPublicKey);
                        }
                        else
                        {
                            await JS.InvokeVoidAsync("pushNotifications.setPushPrompted", vapidPublicKey);

                            Snackbar.Add("Would you like to enable push notifications for this server?", Severity.Info, config =>
                            {
                                config.Action = "Enable";
                                config.ActionColor = Color.Success;
                                config.OnClick = snackbar =>
                                {
                                    _ = TriggerAutoPushRegistration(vapidPublicKey, isSilent: false, clientInit);
                                    return Task.CompletedTask;
                                };
                                config.ShowCloseIcon = true;
                                config.RequireInteraction = true;
                            });
                        }
                    }
                }
            }
        }
        catch (Exception ex) when (ex is JSDisconnectedException or TaskCanceledException or ObjectDisposedException or InvalidOperationException)
        {
            // Circuit closed during background push reconciliation
        }
        catch (Exception ex)
        {
            Logger.LogDebug(ex, "[MainLayout] Background push reconciliation failed");
        }
    }

    [JSInvokable]
    public void OnDeviceActivePing(bool isFocused)
    {
        if (_isDisposed || !CircuitContext.CanRegisterPresence) return;

        bool wasIdle = CircuitContext.IsIdle;
        CircuitContext.IsIdle = false;
        EnsurePresenceConnectionRegistered(isFocusedOverride: isFocused ? true : null);
        PresenceState.PingDeviceActive(_currentSubscriptionId);

        // Defense-in-depth self-healing: if the user is actively interacting inside a focused foreground view
        // while server focus state drifted to unfocused (e.g. legacy client race), immediately reconcile focus.
        if (isFocused && (!CircuitContext.IsFocused ||
            (!string.IsNullOrEmpty(_currentSubscriptionId) && !PresenceState.IsConnectionActivelyViewed(_currentSubscriptionId))))
        {
            ApplyFocusState(true, healUnreadCounts: true, notifyUi: false);
        }
        else if (wasIdle && CircuitContext.IsFocused)
        {
            CircuitContext.NotifyFocusChanged();
        }
    }

    [JSInvokable]
    public void OnClientPresenceStateChanged(string state, long sequence)
    {
        if (string.IsNullOrEmpty(state) || _isDisposed || CircuitContext.IsTerminated) return;

        var normalized = state.Trim().ToLowerInvariant();
        var parsedState = normalized switch
        {
            "away" or "idle" => ConnectionPresenceState.Idle,
            "dnd" => ConnectionPresenceState.DoNotDisturb,
            "offline" or "invisible" => ConnectionPresenceState.Offline,
            _ => ConnectionPresenceState.Active
        };

        if (parsedState != ConnectionPresenceState.Offline && !CircuitContext.CanRegisterPresence) return;

        long? seq = sequence > 0 ? sequence : null;
        bool wasIdle = CircuitContext.IsIdle;
        bool isInVoiceCall = _currentUser != null && PresenceState.IsUserInVoiceCall(_currentUser.Id);
        CircuitContext.IsIdle = parsedState == ConnectionPresenceState.Offline ||
            (parsedState == ConnectionPresenceState.Idle && !isInVoiceCall);

        if (parsedState != ConnectionPresenceState.Offline)
        {
            EnsurePresenceConnectionRegistered(presenceSequence: seq);
        }
        PresenceState.SetConnectionPresenceState(_currentSubscriptionId, parsedState, seq);

        if (CircuitContext.IsIdle && _currentUser != null)
        {
            UserClientStateService.StopActiveTyping(_currentUser.Id);
        }
        else if (wasIdle && !CircuitContext.IsIdle && CircuitContext.IsFocused)
        {
            CircuitContext.NotifyFocusChanged();
        }
    }

