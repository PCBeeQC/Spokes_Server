    public async Task NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        var isMobile = args.Breakpoint <= Breakpoint.Sm;
        var newVariant = isMobile ? DrawerVariant.Responsive : DrawerVariant.Mini;
        
        var newPosition = isMobile ? Defaults.Classes.Position.TopCenter : Defaults.Classes.Position.BottomRight;
        if (Snackbar.Configuration.PositionClass != newPosition)
        {
            Snackbar.Configuration.PositionClass = newPosition;
        }

        if (_drawerVariant != newVariant)
        {
            _drawerVariant = newVariant;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        try
        {
            if (_dotNetRef != null)
            {
                await JS.InvokeVoidAsync("unregisterCtrlK");
                await JS.InvokeVoidAsync("unregisterWindowFocus");
                await JS.InvokeVoidAsync("unregisterActivityTracker");
                await JS.InvokeVoidAsync("unregisterShareTarget");
                await JS.InvokeVoidAsync("pushNotifications.stopIdleDetector");
            }

            // Remove this connection from presence tracking
            if (_currentUser != null && PresenceState != null)
            {
                if (!string.IsNullOrEmpty(_currentSubscriptionId))
                {
                    PresenceState.RemoveConnection(_currentSubscriptionId);
                }
            }

            await ViewportService.UnsubscribeAsync(this);
        }
        catch (JSDisconnectedException) { }
        catch (InvalidOperationException) { }

        TimerService.OnTimerChanged -= OnTimerChanged;
        StopUiTimer();
        Nav.LocationChanged -= HandleLocationChanged;
        PresenceState.OnSessionRevoked -= HandleSessionRevoked;
        _dotNetRef?.Dispose();
    }

