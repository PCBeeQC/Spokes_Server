    /// <summary>
    /// Checks if the URL represents a chat page layout.
    /// In Friend/Family Edition, the root route ("/") also renders the Chat component.
    /// </summary>
    internal bool IsChatPageUrl(string? url) => IsChatPageUrl(url, IsFriendEdition);

    internal static bool IsChatPageUrl(string? url, bool isFriendEdition)
    {
        if (string.IsNullOrEmpty(url)) return false;

        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            var path = uri.AbsolutePath.TrimEnd('/');
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);

            if (segments.Length >= 1 && segments[0].Equals("chat", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            if (segments.Length == 0 && isFriendEdition)
            {
                return true;
            }
        }
        else
        {
            var clean = url.Split('?')[0].TrimEnd('/');
            if (clean.Equals("/chat", StringComparison.OrdinalIgnoreCase) ||
                clean.StartsWith("/chat/", StringComparison.OrdinalIgnoreCase))
            {
                return true;
            }

            if ((clean == "/" || string.IsNullOrEmpty(clean)) && isFriendEdition)
            {
                return true;
            }
        }

        return false;
    }

    /// <summary>
    /// Checks if the URL is a chat channel URL (i.e. /chat/{channelId}).
    /// This is used to hide the app bar on mobile to maximize chat space.
    /// </summary>
    internal static bool IsChatChannelUrl(string url)
    {
        // Extract the path from the full URL
        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            var path = uri.AbsolutePath.TrimEnd('/');
            // Match /chat/{something} but not just /chat
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length >= 2 
                && segments[0].Equals("chat", StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }


    private async Task TriggerAutoPushRegistration(string vapidPublicKey, bool isSilent = false, LayoutClientInitResult? clientInit = null)
    {
        try
        {
            var requiresRelay = clientInit?.RequiresPushRelay ?? await JS.InvokeAsync<bool>("pushNotifications.requiresPushRelay");
            bool isNativePushBlocked = _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock || 
                                       _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired;
            if (requiresRelay && isNativePushBlocked)
            {
                return;
            }

            // 1. Request permission
            var permResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.requestPermission", _dotNetRef);
            var permission = ExtractDictString(permResult, "permission");
            
            if (permission == "granted")
            {
                // 2. Register service worker
                var swResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.registerServiceWorker");
                var swSuccess = string.Equals(ExtractDictString(swResult, "success"), "True", StringComparison.OrdinalIgnoreCase);
                
                if (swSuccess)
                {
                    // 3. Subscribe to push
                    var subscription = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.subscribe", vapidPublicKey, _dotNetRef);
                    var subEndpoint = ExtractDictString(subscription, "endpoint");
                    
                    if (subscription != null && !string.IsNullOrEmpty(subEndpoint))
                    {
                        // 4. Save to server
                        var deviceType = !string.IsNullOrEmpty(clientInit?.DeviceType)
                            ? clientInit.DeviceType
                            : await JS.InvokeAsync<string>("pushNotifications.detectDeviceType");
                        var success = await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer", subscription, deviceType, "", true);
                        
                        if (success)
                        {
                            if (!isSilent)
                            {
                                Snackbar.Add("Push notifications enabled!", Severity.Success);
                            }
                            if (string.Equals(ExtractDictString(permResult, "soundDisabled"), "True", StringComparison.OrdinalIgnoreCase))
                            {
                                Snackbar.Add("Notification sounds are disabled for Spokes in your iPhone Settings.", Severity.Warning, config =>
                                {
                                    config.Action = "Open Settings";
                                    config.ActionColor = Color.Warning;
                                    config.OnClick = _ => JS.InvokeVoidAsync("pushNotifications.openAppSettings").AsTask();
                                    config.RequireInteraction = true;
                                });
                            }
                            // Refresh endpoint and presence so other tabs see it
                            _currentSubscriptionEndpoint = subEndpoint;
                            CircuitContext.HasPushEnabled = true;
                            PresenceState.UpdatePushEnabledState(_currentSubscriptionId, true);
                        }
                        else
                        {
                            try
                            {
                                var lastErr = await JS.InvokeAsync<Dictionary<string, object>?>("pushNotifications.getLastSubscriptionError");
                                var errCode = ExtractDictString(lastErr, "code");
                                if (errCode == "PASS_EXPIRED")
                                {
                                    Snackbar.Add(Loc["Native push notifications require an active Spokes Pass."].Value, Severity.Warning);
                                }
                            }
                            catch { }
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Logger.LogWarning(ex, "Error auto-registering push notifications");
        }
    }

