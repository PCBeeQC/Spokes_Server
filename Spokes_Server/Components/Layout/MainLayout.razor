    private void OnTimerChanged()
    {
        if (_currentUser == null) return;
        _timerState = TimerService.GetState(_currentUser.Id);

        if (_timerState.IsRunning) StartUiTimer();
        else StopUiTimer();

        InvokeAsync(StateHasChanged);
    }

    private void StartUiTimer()
    {
        _uiTimer?.Dispose();
        _uiTimer = new System.Timers.Timer(1000);
        _uiTimer.Elapsed += (_, _) =>
        {
            if (_timerState.IsRunning && _timerState.StartedAt.HasValue)
            {
                _timerElapsed = DateTime.UtcNow - _timerState.StartedAt.Value;
                InvokeAsync(StateHasChanged);
            }
        };
        _uiTimer.Start();
        if (_timerState.StartedAt.HasValue)
            _timerElapsed = DateTime.UtcNow - _timerState.StartedAt.Value;
    }

    private void StopUiTimer()
    {
        _uiTimer?.Dispose();
        _uiTimer = null;
    }

