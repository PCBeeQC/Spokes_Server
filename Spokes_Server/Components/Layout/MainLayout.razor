    // --- Presence Connection Registration ---
    private async Task RegisterPresenceConnection()
    {
        if (_currentUser == null) return;

        // Give this browser tab a robust unique ID so presence works even without push notifications.
        _currentSubscriptionId = Guid.NewGuid().ToString();
        var deviceType = "Desktop"; // Default
        bool hasPushEnabled = false;

        try
        {
            var existingSub = await JS.InvokeAsync<Dictionary<string, object>?>("pushNotifications.getExistingSubscription");
            if (existingSub != null && existingSub.TryGetValue("endpoint", out var epObj))
            {
                _currentSubscriptionEndpoint = epObj?.ToString();

                // Look up the subscription ID from the endpoint
                if (!string.IsNullOrEmpty(_currentSubscriptionEndpoint))
                {
                    var currentSession = !string.IsNullOrEmpty(_currentSessionId) ? Db.DeviceSessions.GetById(_currentSessionId) : null;
                    var sub = Db.DeviceSessions.GetByPushEndpoint(_currentSubscriptionEndpoint);

                    if (sub != null && sub.Id == currentSession?.Id && currentSession.HasPush)
                    {
                        hasPushEnabled = true;
                        deviceType = sub.DeviceType;
                    }
                    else
                    {
                        // Active push subscription exists in browser; re-sync or register to current session
                        hasPushEnabled = true;
                        try
                        {
                            await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer", existingSub, deviceType, "", false);
                        }
                        catch { /* Ignore */ }
                    }
                }
            }
        }
        catch { /* Push not available — will track presence using the anonymous ID */ }

        // Fallback: If push is disabled but we are clearly running in a native Capacitor shell, mark as Mobile
        try
        {
            var isNative = await JS.InvokeAsync<bool>("eval", "typeof window.isCapacitorNative === 'function' ? window.isCapacitorNative() : !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform())");
            if (isNative)
            {
                deviceType = "Mobile";
            }
        }
        catch { }

        // Populate scoped circuit context for PresenceCircuitHandler
        CircuitContext.UserId = _currentUser.Id;
        CircuitContext.SubscriptionId = _currentSubscriptionId;
        CircuitContext.SessionId = _currentSessionId;
        CircuitContext.DeviceType = deviceType;
        CircuitContext.HasPushEnabled = hasPushEnabled;
        CircuitContext.IsFocused = _isThisTabFocused;

        // Register the connection in the PresenceState service
        PresenceState.RegisterConnection(_currentUser.Id, _currentSubscriptionId, deviceType, hasPushEnabled, _currentSessionId, _isThisTabFocused);
        
        try
        {
            await JS.InvokeVoidAsync("eval", $"window._currentSubscriptionId = '{_currentSubscriptionId}';");
        }
        catch { /* Ignore errors if circuit is disconnecting */ }

        // If this device has Idle Detection enabled, try to start it
        if (_currentSubscriptionEndpoint != null)
        {
            var sub = Db.DeviceSessions.GetByPushEndpoint(_currentSubscriptionEndpoint);
            if (sub != null && sub.IsIdleDetectionEnabled && sub.DeviceType == "Desktop")
            {
                try
                {
                    await JS.InvokeAsync<bool>("pushNotifications.startIdleDetector", _dotNetRef);
                }
                catch { /* Ignore errors if browser doesn't support it */ }
            }
            else
            {
                try
                {
                    await JS.InvokeVoidAsync("pushNotifications.stopIdleDetector");
                }
                catch { }
            }
        }

        // Note: Legacy "session consolidation" block removed.
        // Device ID mismatch is now handled at SSO login time (Program.cs /sso/login/auto)
        // and at layout load time (OnAfterRenderAsync deviceId validation above).
    }

