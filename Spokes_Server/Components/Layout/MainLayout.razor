    private async Task TriggerAutoPushRegistration(string vapidPublicKey)
    {
        try
        {
            // 1. Request permission
            var permResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.requestPermission", _dotNetRef);
            var permission = permResult?.GetValueOrDefault("permission")?.ToString();
            
            if (permission == "granted")
            {
                // 2. Register service worker
                var swResult = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.registerServiceWorker");
                var swSuccess = swResult?.GetValueOrDefault("success")?.ToString() == "True";
                
                if (swSuccess)
                {
                    // 3. Subscribe to push
                    var subscription = await JS.InvokeAsync<Dictionary<string, object>>("pushNotifications.subscribe", vapidPublicKey, _dotNetRef);
                    
                    if (subscription != null && subscription.ContainsKey("endpoint"))
                    {
                        // 4. Save to server
                        var deviceType = await JS.InvokeAsync<string>("pushNotifications.detectDeviceType");
                        var success = await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer", subscription, deviceType, "", false);
                        
                        if (success)
                        {
                            Snackbar.Add("Push notifications enabled!", Severity.Success);
                            // Refresh endpoint and presence so other tabs see it
                            _currentSubscriptionEndpoint = subscription.GetValueOrDefault("endpoint")?.ToString();
                            CircuitContext.HasPushEnabled = true;
                            PresenceState.UpdatePushEnabledState(_currentSubscriptionId, true);
                        }
                    }
                }
            }
        }
        catch (Exception ex)
        {
            Console.WriteLine($"Error auto-registering push notifications: {ex.Message}");
        }
    }

