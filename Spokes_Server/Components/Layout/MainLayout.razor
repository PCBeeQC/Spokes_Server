@inherits LayoutComponentBase
@using Spokes_Server.Core.Constants
@using Microsoft.Extensions.Configuration
@using Microsoft.AspNetCore.Http
@using Spokes_Server.Core.Services.Communication.Chat
@using Spokes_Server.Core.Services.Licensing
@using Spokes_Server.Core.Services.Security
@using Spokes_Server.Core.Services.UI
@inject Database Db
@inject IConfiguration Config
@inject AuthenticationStateProvider AuthStateProvider
@inject UserService UserService
@inject NavigationManager Nav
@inject IDialogService DialogService
@inject IJSRuntime JS
@inject TimesheetTimerService TimerService
@inject ISnackbar Snackbar
@inject PresenceStateService PresenceState
@inject UserCircuitContext CircuitContext
@inject IBrowserViewportService ViewportService
@inject AppLabelService AppLabels
@inject LicenseValidationService LicenseValidationService
@inject IFileService FileService
@inject ChatNotificationService ChatNotifications
@inject Spokes_Server.Core.Services.HR.Calendar.CalendarNotificationService CalendarNotifications
@inject ShareTargetStateService ShareTargetStateService
@inject ServerUpdateService ServerUpdateService
@inject ScopedKeystoreService ScopedKeystore
@inject ICryptoService Crypto
@inject GlobalKeystoreService GlobalKeystore
@inject ImageRecoveryService ImageRecovery
@inject IHttpContextAccessor HttpContextAccessor
@inject StartupTimingService StartupTimings
@inject UserClientStateService UserClientStateService
@inject SessionService SessionService
@inject IStorageHealthService StorageHealth
@inject ILogger<MainLayout> Logger
@implements IAsyncDisposable
@implements IBrowserViewportObserver

<MudThemeProvider Theme="@_theme" @bind-IsDarkMode="_isDarkMode" ObserveSystemDarkModeChange="false" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<MudLayout>
    @{
        StartupTimings.AddChatTransition($"Server: RenderTree MainLayout[{_diagTag}] #{++_diagRenderCount} (_isChatChannelOpen={_isChatChannelOpen})"); // DIAG-TEMP
    }
    <MudAppBar Class="@($"py-n2{(_isChatChannelOpen ? " hide-appbar-mobile" : "")}")" Elevation="1" Dense="true">
        <MudIconButton Icon="@Icons.Material.Filled.Menu" Color="Color.Inherit" Edge="Edge.Start"
            OnClick="@((e) => DrawerToggle())" />
        <div class="d-flex align-center ml-1">
            @if (Profile?.HasCustomLogo == true)
            {
                <MudImage Src="@($"/spokesapi/Media/Logo?v={Profile.LogoVersion}")" Height="32" Class="mr-2" />
            }
            else if (Profile?.HasCustomIcon == true)
            {
                <MudImage Src="@($"/spokesapi/Media/Icon?v={Profile.IconVersion}")" Height="32" Class="mr-2" />
            }

            @if(!IsFriendEdition)
            {
                <MudHidden Breakpoint="Breakpoint.SmAndDown">
                    <MudText Typo="Typo.h6" Style="font-weight: 700;">@Profile?.CompanyName</MudText>
                </MudHidden>
            }
            else
            {
                <MudText Typo="Typo.h6" Style="font-weight: 700;">@Profile?.CompanyName</MudText>
            }



        </div>

        @* Desktop Toolbar *@
        <MudHidden Breakpoint="Breakpoint.SmAndDown">
                @if (!IsFriendEdition)
                {
                    <MudMenu Icon="@Icons.Material.Filled.Add" Color="Color.Inherit" Class="ml-4">
                        <MudMenuItem OnClick="@(() => Nav.NavigateTo("/projects/new"))">@BizLoc["New Project"]</MudMenuItem>
                        <MudMenuItem OnClick="@(() => Nav.NavigateTo("/my-timesheet"))">@BizLoc["Log Time"]</MudMenuItem>
                        <MudMenuItem OnClick="@(() => Nav.NavigateTo("/me/expenses"))">@BizLoc["New Expense"]</MudMenuItem>
                    </MudMenu>

                    <Spokes_Server.Components.Shared.TimerButton />
                }
                
                <MudSpacer />
                @if (!IsFriendEdition)
                {
                    <Spokes_Server.Components.Shared.GlobalSearchBar @ref="_searchBar" />
                }
                

                <MudSpacer />

                <MudIconButton Icon="@Icons.Material.Filled.Settings" Color="Color.Inherit"
                    OnClick="OpenUserSettingsDialog" />
                <MudIconButton Icon="@DarkLightModeButtonIcon" Color="Color.Inherit" OnClick="@DarkModeToggle"
                    Class="mr-4" />

                <AuthorizeView>
                    <Authorized Context="auth">
                        <div class="d-flex align-center cursor-pointer mr-4" @onclick="OpenProfileDialog">
                            <EmployeeAvatar Employee="@_currentUser" Size="Size.Small" Class="mr-2" />
                            <MudText>
                                @(_currentUser?.FullName
                                    ?? _currentUser?.Email
                                    ?? auth.User.FindFirst("email")?.Value
                                    ?? auth.User.FindFirst(System.Security.Claims.ClaimTypes.Email)?.Value
                                    ?? auth.User.Identity?.Name)
                            </MudText>
                        </div>

                        <form action="logout" method="post" data-enhance="false">
                            <MudButton ButtonType="ButtonType.Submit" Variant="Variant.Filled" Color="Color.Error">@Loc["Logout"]
                            </MudButton>
                            <AntiforgeryToken />
                        </form>
                    </Authorized>
                </AuthorizeView>
            </MudHidden>

        @* Mobile Toolbar *@
        <MudHidden Breakpoint="Breakpoint.MdAndUp">
            <MudSpacer />

            @* Running timer indicator on mobile *@
            @if (_timerState.IsRunning)
            {
                <div class="d-flex align-center gap-1 mr-2" @onclick="StopTimerFromMenu">
                    <MudIcon Icon="@Icons.Material.Filled.FiberManualRecord" Color="Color.Error" Size="Size.Small"
                        Class="timer-pulse" />
                    <MudText Typo="Typo.body2" Style="font-family: monospace; font-weight: 600;">
                        @_timerElapsed.ToString(@"hh\:mm\:ss")
                    </MudText>
                </div>
            }

            <AuthorizeView>
                <Authorized Context="auth">
                    <div class="d-flex align-center cursor-pointer" @onclick="OpenProfileDialog">
                        <EmployeeAvatar Employee="@_currentUser" Size="Size.Small" />
                    </div>
                </Authorized>
            </AuthorizeView>

            <MudMenu Icon="@Icons.Material.Filled.MoreVert" Color="Color.Inherit"
                AnchorOrigin="Origin.BottomRight" TransformOrigin="Origin.TopRight" Class="mr-n5">

                @if (!IsFriendEdition)
                {
                    @* New Project *@
                    <MudMenuItem Icon="@Icons.Material.Filled.Add" OnClick="@(() => Nav.NavigateTo("/projects/new"))">
                        @BizLoc["New Project"]
                    </MudMenuItem>

                    @* Start/Stop Timer *@
                    @if (_timerState.IsRunning)
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.Stop" IconColor="Color.Error" OnClick="StopTimerFromMenu">
                            @BizLoc["Stop Timer"]
                        </MudMenuItem>
                    }
                    else
                    {
                        <MudMenuItem Icon="@Icons.Material.Filled.PlayArrow" IconColor="Color.Success"
                                     OnClick="StartTimerFromMenu">
                            @BizLoc["Start Timer"]
                        </MudMenuItem>
                    }
                }
                
                @if (!IsFriendEdition)
                {
                    @* Search *@
                    <MudMenuItem Icon="@Icons.Material.Filled.Search" OnClick="FocusMobileSearch">
                        @Loc["Search"]
                    </MudMenuItem>
				}
				

                @* Settings *@
                <MudMenuItem Icon="@Icons.Material.Filled.Settings"
                    OnClick="OpenUserSettingsDialog">
                    @Loc["Settings"]
                </MudMenuItem>

                @* Theme *@
                <MudMenuItem Icon="@DarkLightModeButtonIcon" OnClick="DarkModeToggle">
                    @Loc["SwitchTheme"]
                </MudMenuItem>

                <MudDivider />

                @* Profile *@
                <AuthorizeView>
                    <Authorized Context="auth">
                        <MudMenuItem Icon="@Icons.Material.Filled.Person" IconColor="Color.Transparent" OnClick="OpenProfileDialog">
                            <span style="position: absolute; left: 12px; top: 50%; transform: translateY(-50%); z-index: 10; pointer-events: none;">
                                <EmployeeAvatar Employee="@_currentUser" Size="Size.Small" />
                            </span>
                            @(_currentUser?.FirstName ?? Loc["Profile"].Value)
                        </MudMenuItem>

                        @* Logout *@
                        <MudMenuItem Icon="@Icons.Material.Filled.Logout" IconColor="Color.Error">
                            <form action="logout" method="post" data-enhance="false" id="logout-form-mobile" style="width: 100%; display: flex; flex-grow: 1;">
                                <button type="submit"
                                    style="background: none; border: none; padding: 0; margin: 0; color: inherit; width: 100%; text-align: left; cursor: pointer; display: flex; align-items: center; justify-content: flex-start;">
                                    @Loc["Logout"]
                                </button>
                                <AntiforgeryToken />
                            </form>
                        </MudMenuItem>

                    </Authorized>
                </AuthorizeView>
            </MudMenu>
        </MudHidden>
    </MudAppBar>

    <MudDrawer id="nav-drawer" @bind-Open="_drawerOpen" ClipMode="DrawerClipMode.Always" Variant="@_drawerVariant" Elevation="1" Class="@((_isLoaded ? "" : "mobile-preload-hide") + (_drawerOpen ? " is-nav-drawer-open" : " is-nav-drawer-closed"))">
        @if (Db.CompanyProfile.Get()?.Edition == "Family")
        {
            <NavMenu_Friend drawerOpen="_drawerOpen" _isEditingFavorites="_isEditingFavorites" />
        }
        else
        {
            <NavMenu drawerOpen="_drawerOpen" _isEditingFavorites="_isEditingFavorites" />
        }
        <MudPaper Class="mb-2 d-flex flex-grow-1 flex-column" Elevation="0" Style="background-color: transparent;">
            <MudPaper Class="py-2 flex-grow-1" Height="16" Elevation="0" Style="background-color: transparent;" />
			@if (_drawerOpen)
            {
                @if (!IsFriendEdition)
                {
                    <MudPaper Class="d-flex flex-row" Elevation="0" Style="background-color: transparent;">
                        <MudSpacer></MudSpacer>
                        <MudSwitch @bind-Value="_isEditingFavorites" Size="Size.Small" ThumbIcon="@(_isEditingFavorites == true ? Icons.Material.Filled.Edit : Icons.Material.Filled.EditOff)" ThumbIconColor="@(_isEditingFavorites == true ? Color.Success : Color.Default)">@Loc["Edit"] @AppLabels.Favorites</MudSwitch>
                        <MudSpacer></MudSpacer>
                    </MudPaper>
                }

                <MudText Typo="Typo.caption" Align="Align.Center"
                         Style="color: var(--mud-palette-text-disabled); font-size: 0.7rem;">
                    @_appVersion
                </MudText>
            }
        </MudPaper>
    </MudDrawer>

    <MudMainContent Class="@(_isChatPage ? $"pr-1 d-flex flex-column{(_isChatChannelOpen ? " chat-channel-open" : " pt-12")} print-layout" : "pt-12 pb-4 px-0 px-md-4 d-flex flex-column print-layout")" Style="height: 100vh; overflow: hidden;">
        @if (_currentUser != null && (_currentUser.IsAdmin || _currentUser.HasPermission(AppPermissions.Admin.ManageSettings)))
        {
            var storageStatus = StorageHealth.Status;
            if (storageStatus == StorageStatus.CriticalReadOnly)
            {
                <MudAlert Severity="Severity.Error" 
                          Dense="true" 
                          Class="mb-0 mx-2 mt-2" 
                          ShowCloseIcon="false" 
                          Style="z-index: 100;">
                    <div class="d-flex align-center flex-wrap flex-grow-1">
                        <MudIcon Icon="@Icons.Material.Filled.Error" Color="Color.Inherit" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.body2">
                            <b>@Loc["CriticalStorageFull"] (@(StorageHealth.AvailableFreeMegabytes) MB free):</b> @Loc["StorageFullDescription"]
                        </MudText>
                    </div>
                </MudAlert>
            }
            else if (storageStatus == StorageStatus.Warning)
            {
                <MudAlert Severity="Severity.Warning" 
                          Dense="true" 
                          Class="mb-0 mx-2 mt-2" 
                          ShowCloseIcon="false" 
                          Style="z-index: 100;">
                    <div class="d-flex align-center flex-wrap flex-grow-1">
                        <MudIcon Icon="@Icons.Material.Filled.Warning" Color="Color.Inherit" Size="Size.Small" Class="mr-2" />
                        <MudText Typo="Typo.body2">
                            <b>@Loc["StorageWarning"]:</b> @string.Format(Loc["StorageWarningDescription"].Value, StorageHealth.AvailableFreeMegabytes)
                        </MudText>
                    </div>
                </MudAlert>
            }
        }
        @if ((_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock || 
              _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired || 
              _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Tolerated) && 
              _currentUser != null && (_currentUser.IsAdmin || _currentUser.HasPermission(AppPermissions.Admin.ManageSettings)) && !_hideLicenseBanner)
        {
            <MudAlert Severity="@(_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ? Severity.Error : Severity.Warning)" 
                      Dense="true" 
                      NoIcon="true"
                      Class="license-banner mb-0 mx-2 mt-2" 
                      ShowCloseIcon="false" 
                      Style="z-index: 100;">
                <div class="d-flex align-center flex-wrap flex-grow-1">
                    <MudIcon Icon="@(_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ? Icons.Material.Filled.Error : Icons.Material.Filled.Warning)" 
                             Color="Color.Inherit" 
                             Size="Size.Small" 
                             Class="mr-2" />
                    <MudText Typo="Typo.body2" Class="mr-2">
                        <b>@(_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock ? Loc["Spokes Pass Invalid"] : _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired ? Loc["Spokes Pass Expired"] : Loc["Spokes Pass Update Required"])</b>
                        <span> - @(_licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock || _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired ? Loc["Native push notifications (desktop & mobile) are currently disabled."] : _licenseError)</span>
                    </MudText>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="@(() => Nav.NavigateTo("/admin/settings?tab=setup"))">@Loc["Resolve"]</MudButton>
                    <MudSpacer />
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="DismissLicenseBanner">@Loc["Remind Me Later"]</MudButton>
                    <MudButton Variant="Variant.Text" Color="Color.Inherit" Size="Size.Small" OnClick="NeverShowLicenseBanner">@Loc["Never Show Again"]</MudButton>
                </div>
            </MudAlert>
        }
        <Spokes_Server.Components.Shared.GlobalVoiceBar />
        <div class="flex-grow-1 d-flex flex-column overflow-auto print-scroll" style="position: relative; min-height: 0;">
            @Body
        </div>
    </MudMainContent>
</MudLayout>

<div id="blazor-error-ui" data-nosnippet>
    @Loc["UnhandledErrorOccurred"]
    <a href="." class="reload">@Loc["Reload"]</a>
    <span class="dismiss">🗙</span>
</div>

<style>
    .license-banner.mud-alert {
        align-items: center;
    }

    .license-banner .mud-alert-message {
        width: 100%;
        padding: 4px 0;
    }

    :root {
        --safe-area-top: env(safe-area-inset-top, 0px);
        --safe-area-bottom: env(safe-area-inset-bottom, 0px);
    }

    html.keyboard-open-ios {
        --safe-area-bottom: 0px !important;
    }

    .mud-layout > .mud-appbar {
        padding-top: var(--safe-area-top) !important;
        height: calc(48px + var(--safe-area-top)) !important;
    }

    .mud-layout > .mud-main-content:not(.chat-channel-open) {
        padding-top: calc(48px + var(--safe-area-top)) !important;
        padding-bottom: var(--safe-area-bottom) !important;
    }

    #nav-drawer {
        top: calc(48px + var(--safe-area-top)) !important;
        height: calc(100vh - 48px - var(--safe-area-top) - var(--safe-area-bottom)) !important;
    }

    .timer-pulse {
        animation: pulse 1.5s infinite;
    }

    @@keyframes pulse {
        0% {
            opacity: 1;
        }

        50% {
            opacity: 0.3;
        }

        100% {
            opacity: 1;
        }
    }

    /* Default: chat page still needs top padding for the app bar */
    .mud-layout > .mud-main-content.chat-channel-open {
        padding-top: calc(48px + var(--safe-area-top)) !important;
        padding-bottom: var(--safe-area-bottom) !important;
    }

    /* On mobile (sm and down), hide the app bar when a chat channel is open */
    @@media (max-width: 959.98px) {
        .mobile-preload-hide {
            display: none !important;
        }

        .hide-appbar-mobile {
            display: none !important;
        }

        .mud-layout > .mud-main-content.chat-channel-open {
            padding-top: var(--safe-area-top) !important;
            padding-bottom: var(--safe-area-bottom) !important;
            height: var(--viewport-height, 100dvh) !important;
            position: absolute !important;
            top: 0;
            left: 0;
            right: 0;
            bottom: 0;
            width: 100%;
        }
    }

    /* On desktop (md and up), keep normal top padding */
    @@media (min-width: 960px) {
        .mud-layout > .mud-main-content.chat-channel-open {
            padding-top: calc(48px + var(--safe-area-top)) !important;
        }
    }

    /* Print styling to reset restricted viewports so browsers capture full pages */
    @@media print {
        .print-layout {
            height: auto !important;
            overflow: visible !important;
            display: block !important;
            position: static !important;
        }

        .print-scroll {
            overflow: visible !important;
            display: block !important;
            position: static !important;
        }
    }
</style>

@code {
    private bool _isLoaded = false;
    private bool _isCapacitorApp = false;
    private bool _isDesktopSession = false;
    private bool _isEditingFavorites = false;
    private bool _drawerOpen = true;
    private DrawerVariant _drawerVariant = DrawerVariant.Responsive;
    private bool _isDarkMode = true;
    private MudTheme? _theme = null;
    private Employee? _currentUser;
    private CompanyProfile? Profile;
    private DotNetObjectReference<MainLayout>? _dotNetRef;
    private Spokes_Server.Components.Shared.GlobalSearchBar? _searchBar;
    private bool IsFriendEdition => Db.CompanyProfile.Get()?.Edition == "Family";

    // Timer State
    private TimerState _timerState = new();
    private TimeSpan _timerElapsed;
    private System.Timers.Timer? _uiTimer;

    // Notification / Presence State
    private string? _currentSubscriptionEndpoint;
    private string? _currentSubscriptionId;
    private string? _currentSessionId;
    private bool _pushPromptEvaluated = false;
    private bool _isChatPage;
    private bool _isChatChannelOpen;
    private bool _hideLicenseBanner = false;

    private void DismissLicenseBanner()
    {
        _hideLicenseBanner = true;
        if (_currentUser != null)
        {
            _currentUser.LicenseBannerRemindLaterDate = DateTimeOffset.UtcNow.AddDays(3);
            Db.Employees.Save(_currentUser);
        }
    }

    private void NeverShowLicenseBanner()
    {
        _hideLicenseBanner = true;
        if (_currentUser != null)
        {
            _currentUser.DismissedLicenseBannerPermanently = true;
            _currentUser.LicenseBannerRemindLaterDate = null;
            Db.Employees.Save(_currentUser);
        }
    }

    private bool _isThisTabFocused = true; // Assume focused on initial load
    private string _appVersion = Spokes_Server.Core.Services.Licensing.LicenseValidationService.AppVersion;
    private string? _licenseError;
    private string? _allowedVersion;
    private string? _firstInstalledVersion;
    private string? _lockupVersion;
    private string? _allowedVersionStripped;
    private Spokes_Server.Core.Services.Licensing.LicenseStatus _licenseStatus = Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid;

    private void HandleLicenseUploaded(List<Spokes_Server.Components.Shared.ApiFileUpload.UploadResult> results)
    {
        if (results == null || results.Count == 0) return;
        
        var result = results.First();
        var parts = result.FilePath.Substring("/spokesapi/files/".Length).Split('/');
        if (parts.Length != 3) return;
        var fullPath = FileService.GetPhysicalPath(parts[0], parts[1], parts[2]);
        
        if (File.Exists(fullPath))
        {
            try
            {
                var json = File.ReadAllText(fullPath);
                var config = Db.ServerConfigs.GetOrCreateGlobalConfig();
                var validationResult = LicenseValidationService.ValidateLicense(json, config);

                if (validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid || 
                    validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Tolerated ||
                    validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired)
                {
                    if (validationResult.ParsedLicense != null)
                    {
                        if(Profile != null)
                        {
                            Profile.LicensePayload = json;
                            
                            var newEditions = Spokes_Server.Core.Services.Licensing.LicenseValidationService.GetAvailableEditions(validationResult);
                            if (!newEditions.Contains(Profile.Edition))
                            {
                                Profile.Edition = newEditions.FirstOrDefault() ?? "Family";
                            }
                            
                            Db.CompanyProfile.Save(Profile);
                        }

                        // Reset license banner dismissals so admins are alerted if/when this license expires in the future
                        var admins = Db.Employees.GetAll().Where(e => e.IsAdmin || e.Permissions.Contains(Spokes_Server.Core.Constants.AppPermissions.Admin.ManageSettings)).ToList();
                        foreach (var admin in admins)
                        {
                            if (admin.DismissedLicenseBannerPermanently || admin.LicenseBannerRemindLaterDate != null)
                            {
                                admin.DismissedLicenseBannerPermanently = false;
                                admin.LicenseBannerRemindLaterDate = null;
                                Db.Employees.Save(admin);
                            }
                        }

                        if (validationResult.Status == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired)
                        {
                            Snackbar.Add($"Expired License Saved: {validationResult.Message}", Severity.Warning);
                            _licenseStatus = validationResult.Status;
                            _licenseError = validationResult.Message;
                        }
                        else
                        {
                            Snackbar.Add("License Validated & Saved Successfully!", Severity.Success);
                            _licenseStatus = validationResult.Status;
                            _licenseError = null;
                        }
                        
                        _allowedVersion = null;
                        _firstInstalledVersion = null;
                        _lockupVersion = null;
                    }
                    else
                    {
                        Snackbar.Add("License is valid but could not be parsed.", Severity.Warning);
                    }
                }
                else
                {
                    Snackbar.Add($"Invalid License: {validationResult.Message}", Severity.Error);
                }
                
                FileService.CleanTempContext(parts[1]);
                StateHasChanged();
            }
            catch (Exception ex)
            {
                Snackbar.Add($"Upload Failed: {ex.Message}", Severity.Error);
                FileService.CleanTempContext(parts[1]);
            }
        }
    }

    // DIAG-TEMP: chat transition diagnostics
    private readonly string _diagTag = Guid.NewGuid().ToString("N")[..4];
    private int _diagRenderCount;
    private int _diagAfterRenderCount;

    [JSInvokable] public double DiagPing() => StartupTimingService.NowMs();
    [JSInvokable] public int DiagBeginTransition(string name) => StartupTimings.BeginTransition(name, isNamed: false);
    [JSInvokable] public ChatTransitionDrainResult DiagDrain(int transitionId, int cursor) => StartupTimings.Drain(transitionId, cursor);

    protected override void OnInitialized()
    {
        StartupTimings.Add("Server: Layout OnInitialized");
        StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}] OnInitialized"); // DIAG-TEMP
        _isChatPage = IsChatPageUrl(Nav.Uri);
        _isChatChannelOpen = IsChatChannelUrl(Nav.Uri);
        Nav.LocationChanged += HandleLocationChanged;
        CircuitContext.OnChatChannelOpenChanged += HandleChatChannelOpenChanged;
        
        SessionService.OnSessionRevoked += HandleSessionRevoked;

        if (Db.CompanyProfile.Get()?.Edition == "Family")
        {
            _drawerOpen = false;
        }
    }

    private void HandleChatChannelOpenChanged(bool isOpen)
    {
        if (_isChatChannelOpen != isOpen || !_isChatPage)
        {
            _isChatPage = true;
            _isChatChannelOpen = isOpen;
            _ = InvokeAsync(StateHasChanged);
        }
    }

    private async void HandleSessionRevoked(string sessionId)
    {
        if (!string.IsNullOrEmpty(_currentSessionId) && sessionId == _currentSessionId)
        {
            await InvokeAsync(() =>
            {
                Nav.NavigateTo("/spokesapi/auth/force-logout", forceLoad: true);
            });
        }
    }

    private void HandleLocationChanged(object? sender, LocationChangedEventArgs e)
    {
        var newIsChatPage = IsChatPageUrl(e.Location);
        var newIsChatChannelOpen = IsChatChannelUrl(e.Location);
        bool layoutStateChanged = _isChatPage != newIsChatPage || _isChatChannelOpen != newIsChatChannelOpen;
        _isChatPage = newIsChatPage;
        _isChatChannelOpen = newIsChatChannelOpen;
        StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}].HandleLocationChanged (_isChatChannelOpen={_isChatChannelOpen}, changed={layoutStateChanged}, intercepted={e.IsNavigationIntercepted}, location={new Uri(e.Location).PathAndQuery})"); // DIAG-TEMP
        
        if (_currentUser != null)
        {
            using (StartupTimings.Span("Server: MainLayout PresenceState.PingUserActive")) // DIAG-TEMP
            {
                PresenceState.PingUserActive(_currentUser.Id);
            }
        }
        
        if (!newIsChatPage || layoutStateChanged)
        {
            StateHasChanged();
            StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}].HandleLocationChanged StateHasChanged returned"); // DIAG-TEMP
        }
    }

    protected override async Task OnInitializedAsync()
    {
        StartupTimings.Add("Server: Layout OnInitializedAsync Start");
        Profile = Db.CompanyProfile.Get();

        // 1. Setup Theme
        _theme = SpokesTheme.CreateTheme();

        // 2. Load User Preference & Session Platform Context
        var authState = await AuthStateProvider.GetAuthenticationStateAsync();
        var user = authState.User;
        _currentSessionId = user.FindFirst("SessionId")?.Value;

        var initialSession = !string.IsNullOrEmpty(_currentSessionId) ? Db.DeviceSessions.GetById(_currentSessionId) : null;
        var ua = HttpContextAccessor.HttpContext?.Request.Headers.UserAgent.ToString() ?? string.Empty;
        bool isDesktopUa = Spokes_Server.Core.Helpers.DeviceDetectionHelper.IsDesktopClient(ua);
        bool isMobileQuery = string.Equals(HttpContextAccessor.HttpContext?.Request.Query["client"].ToString(), "mobile", StringComparison.OrdinalIgnoreCase);
        bool isCapacitorFromUa = ua.Contains("Capacitor", StringComparison.OrdinalIgnoreCase);
        bool isMobileUa = !isDesktopUa && (isCapacitorFromUa
            || ua.Contains("Mobile", StringComparison.OrdinalIgnoreCase)
            || ua.Contains("Android", StringComparison.OrdinalIgnoreCase)
            || ua.Contains("iPhone", StringComparison.OrdinalIgnoreCase)
            || ua.Contains("iPod", StringComparison.OrdinalIgnoreCase));
        _isDesktopSession = isDesktopUa
            || (initialSession?.DeviceInfo?.Contains("Desktop App", StringComparison.OrdinalIgnoreCase) ?? false);
        _isCapacitorApp = !_isDesktopSession && ((initialSession?.IsCapacitorApp ?? false) || isCapacitorFromUa || isMobileQuery);
        bool isInitialMobile = !_isDesktopSession && (isMobileUa || isMobileQuery || string.Equals(initialSession?.DeviceType, DeviceType.Mobile, StringComparison.OrdinalIgnoreCase));

        if (isInitialMobile)
        {
            _drawerOpen = false;
            _drawerVariant = DrawerVariant.Responsive;
            Snackbar.Configuration.PositionClass = Defaults.Classes.Position.TopCenter;
            _isLoaded = true;
        }

        // Use UserService to get the employee
        _currentUser = await UserService.GetEmployeeAsync();
        StartupTimings.Add("Server: Layout GetEmployeeAsync Done");

        // Redirect to access-pending if authenticated but no employee linked
        if (user.Identity?.IsAuthenticated == true && _currentUser == null)
        {
            var currentUri = Nav.Uri;
            if (!currentUri.Contains("/access-pending"))
            {
                Nav.NavigateTo("/access-pending", replace: true);
                return;
            }
        }

        if (_currentUser != null)
        {
            // Pre-populate CircuitContext before first render so child components have accurate platform state
            CircuitContext.UserId = _currentUser.Id;
            CircuitContext.SessionId = _currentSessionId;
            CircuitContext.IsCapacitorApp = _isCapacitorApp;
            CircuitContext.DeviceType = _isDesktopSession ? DeviceType.Desktop : (isInitialMobile ? DeviceType.Mobile : (initialSession?.DeviceType ?? DeviceType.Desktop));
            CircuitContext.IsMobileViewport = isInitialMobile;
            CircuitContext.HasPushEnabled = initialSession?.PushEnabled ?? false;
            CircuitContext.IsFocused = _isThisTabFocused;

            await CalendarNotifications.InitializeAsync(_currentUser.Id);

            if (_currentUser.IsBanned)
            {
                var currentUri = Nav.Uri;
                if (!currentUri.Contains("/banned", StringComparison.OrdinalIgnoreCase))
                {
                    Nav.NavigateTo("/banned", replace: true);
                    return;
                }
            }

            if (_currentUser.IsSuspended)
            {
                Snackbar.Add("Your account has been suspended. You are in read-only mode.", Severity.Warning, config =>
                {
                    config.VisibleStateDuration = int.MaxValue;
                });
            }

            _isDarkMode = _currentUser.IsDarkMode;

            // Init Timer
            _timerState = TimerService.GetState(_currentUser.Id);
            TimerService.OnTimerChanged += OnTimerChanged;
            if (_timerState.IsRunning) StartUiTimer();
            
            // Verify License
            var result = LicenseValidationService.ValidateLicense(Profile?.LicensePayload, Db.ServerConfigs.GetOrCreateGlobalConfig());
            _licenseStatus = result.Status;
            if (result.Status != Spokes_Server.Core.Services.Licensing.LicenseStatus.Valid)
            {
                _licenseError = result.Message;
                _allowedVersion = result.MaxAllowedVersion;
                
                if (result.ParsedLicense != null)
                {
                    _allowedVersionStripped = GetVersionNumbersOnly(_allowedVersion);
                }
                else if (string.IsNullOrEmpty(Profile?.LicensePayload))
                {
                    _firstInstalledVersion = result.FirstInstalledVersion ?? Db.ServerConfigs.GetOrCreateGlobalConfig().DatabaseCreationVersion;
                    _lockupVersion = result.LockupVersion ?? _firstInstalledVersion;
                    _allowedVersionStripped = GetVersionNumbersOnly(_allowedVersion);
                }

                if (_currentUser != null)
                {
                    bool isPermanentlyDismissed = _currentUser.DismissedLicenseBannerPermanently;
                    bool isRemindLaterActive = _currentUser.LicenseBannerRemindLaterDate != null && DateTimeOffset.UtcNow < _currentUser.LicenseBannerRemindLaterDate;
                    if (isPermanentlyDismissed || isRemindLaterActive)
                    {
                        _hideLicenseBanner = true;
                    }
                }
            }

            // Server-side vault unlock: read the HttpOnly cookie directly from HttpContext
            // before the circuit switches to WebSocket.
            // This is required so Web clients have the vault unlocked before Albums.razor renders.
            if (_currentUser != null && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey) && !ScopedKeystore.IsUnlocked)
            {
                ScopedKeystore.TryInitializeFromVaultCookie(
                    HttpContextAccessor.HttpContext, _currentUser.Id, _currentUser.EncryptedPrivateKey);
            }
        }
        StartupTimings.Add("Server: Layout OnInitializedAsync Done");
    }

    private string GetVersionNumbersOnly(string? version)
    {
        if (string.IsNullOrEmpty(version)) return "latest";
        int firstDigitIndex = -1;
        for (int i = 0; i < version.Length; i++)
        {
            if (char.IsDigit(version[i]))
            {
                firstDigitIndex = i;
                break;
            }
        }
        if (firstDigitIndex >= 0)
        {
            return version.Substring(firstDigitIndex);
        }
        return version.TrimStart('v', 'V');
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (firstRender)
        {
            StartupTimings.Add("Server: Layout OnAfterRenderAsync Start");
            _dotNetRef = DotNetObjectReference.Create(this);
            _currentSubscriptionId = Guid.NewGuid().ToString();

            if (string.IsNullOrEmpty(_currentSessionId))
            {
                try
                {
                    var authState = await AuthStateProvider.GetAuthenticationStateAsync();
                    _currentSessionId = authState.User.FindFirst("SessionId")?.Value;
                }
                catch { }
            }

            if (_currentUser != null)
            {
                CircuitContext.SubscriptionId = _currentSubscriptionId;
                CircuitContext.SessionId = _currentSessionId;
                PresenceState.RegisterConnection(new ConnectionRegistrationOptions
                {
                    UserId = _currentUser.Id,
                    SubscriptionId = _currentSubscriptionId,
                    DeviceType = CircuitContext.DeviceType,
                    HasPushEnabled = CircuitContext.HasPushEnabled,
                    IsCapacitorApp = CircuitContext.IsCapacitorApp,
                    SessionId = _currentSessionId,
                    IsFocused = _isThisTabFocused
                });
            }

            var vapidPublicKey = (Profile ?? Db.CompanyProfile.Get())?.VapidPublicKey ?? string.Empty;
            LayoutClientInitResult? clientInit = null;
            try
            {
                clientInit = await JS.InvokeAsync<LayoutClientInitResult>("SpokesBridge.initLayout", _dotNetRef, new
                {
                    userId = _currentUser?.Id,
                    avatarLength = _currentUser?.AvatarBase64?.Length ?? 0,
                    serverTimings = StartupTimings.GetTimings(),
                    subscriptionId = _currentSubscriptionId,
                    isDarkMode = _isDarkMode,
                    vapidPublicKey = vapidPublicKey,
                    chatDiagnostics = ChatDiagnostics.Enabled // DIAG-TEMP
                });
            }
            catch (Exception ex)
            {
                Logger.LogWarning(ex, "[MainLayout] SpokesBridge.initLayout failed");
            }

            if (!string.IsNullOrEmpty(clientInit?.TimeZone))
            {
                var companyProfile = Db.CompanyProfile.Get();
                if (string.IsNullOrEmpty(companyProfile.TimeZoneId))
                {
                    try
                    {
                        _ = TimeZoneInfo.FindSystemTimeZoneById(clientInit.TimeZone);
                        companyProfile.TimeZoneId = clientInit.TimeZone;
                        Db.CompanyProfile.Save(companyProfile);
                        Profile = companyProfile;
                        Logger.LogInformation("[MainLayout] Auto-detected server timezone as {TimeZone}", clientInit.TimeZone);
                    }
                    catch (Exception tzEx)
                    {
                        Logger.LogDebug("[MainLayout] Client timezone {TimeZone} not recognized by host: {Message}", clientInit.TimeZone, tzEx.Message);
                    }
                }
            }

            var prevIsCapacitor = _isCapacitorApp;

            // Register this connection for presence tracking using the batched client state
            await RegisterPresenceConnection(clientInit);

            // Auto-unlock vault on Native Mobile (since cookies aren't passed reliably in HTTP initial request)
            if (_currentUser != null && _currentUser.HasVaultPassword && !string.IsNullOrEmpty(_currentUser.EncryptedPrivateKey) && !ScopedKeystore.IsUnlocked)
            {
                try
                {
                    await ScopedKeystore.InitializeFromDeviceCookieAsync(JS, _currentUser.Id, _currentUser.EncryptedPrivateKey);
                }
                catch (Exception ex)
                {
                    Logger.LogWarning(ex, "[MainLayout] Failed to initialize Keystore from device");
                }
            }

            // Auto-prompt or auto-register push notifications on new devices that don't have an active endpoint yet
            if (!_pushPromptEvaluated && _currentUser != null && string.IsNullOrEmpty(_currentSubscriptionEndpoint) && !Config.GetValue<bool>("Spokes_DemoMode"))
            {
                _pushPromptEvaluated = true;
                try
                {
                    if (!string.IsNullOrEmpty(vapidPublicKey))
                    {
                        var permStatus = clientInit?.PermissionStatus ?? "default";
                        if (permStatus == "granted")
                        {
                            _ = TriggerAutoPushRegistration(vapidPublicKey, isSilent: true, clientInit);
                        }
                        else if (permStatus == "default" && clientInit is { HasBeenPromptedForPush: false, IsPushSupported: true })
                        {
                            bool isNativePushBlocked = _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock || 
                                                       _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired;

                            if (clientInit.RequiresPushRelay && isNativePushBlocked)
                            {
                                // Suppress auto-prompt for mobile and desktop app users when server lacks a Spokes Pass.
                                await JS.InvokeVoidAsync("pushNotifications.setPushPrompted", vapidPublicKey);
                            }
                            else
                            {
                                await JS.InvokeVoidAsync("pushNotifications.setPushPrompted", vapidPublicKey);
                                
                                Snackbar.Add("Would you like to enable push notifications for this server?", Severity.Info, config =>
                                {
                                    config.Action = "Enable";
                                    config.ActionColor = Color.Success;
                                    config.OnClick = snackbar =>
                                    {
                                        _ = TriggerAutoPushRegistration(vapidPublicKey, isSilent: false, clientInit);
                                        return Task.CompletedTask;
                                    };
                                    config.ShowCloseIcon = true;
                                    config.RequireInteraction = true;
                                });
                            }
                        }
                    }
                }
                catch { /* Ignore errors if push is unsupported or network fails */ }
            }

            // Server Update Notification for Admins
            if (_currentUser != null && (_currentUser.IsAdmin || _currentUser.HasPermission(AppPermissions.Admin.ManageSettings)))
            {
                if (ServerUpdateService.IsUpdateAvailable && !string.IsNullOrEmpty(ServerUpdateService.LatestVersion))
                {
                    if (_currentUser.LastSeenUpdateVersion != ServerUpdateService.LatestVersion)
                    {
                        Snackbar.Add($"A new server update is available (v{ServerUpdateService.LatestVersion})", Severity.Info, config =>
                        {
                            config.Action = "More Info";
                            config.ActionColor = Color.Primary;
                            config.OnClick = snackbar =>
                            {
                                Nav.NavigateTo("/admin/settings");
                                return Task.CompletedTask;
                            };
                            config.RequireInteraction = true;
                            config.ShowCloseIcon = true;
                        });
                        
                        _currentUser.LastSeenUpdateVersion = ServerUpdateService.LatestVersion;
                        Db.Employees.Save(_currentUser);
                    }
                }
            }

            if (_currentUser != null && !_currentUser.HasVaultPassword && !_currentUser.DismissedChatWizardPermanently)
            {
                if ((_currentUser.ChatWizardRemindLaterDate == null || DateTimeOffset.UtcNow > _currentUser.ChatWizardRemindLaterDate) && !Config.GetValue<bool>("Spokes_DemoMode"))
                {
                    var options = new DialogOptions { CloseOnEscapeKey = false, BackdropClick = false, MaxWidth = MaxWidth.Small, FullWidth = true };
                    var parameters = new DialogParameters { { "Employee", _currentUser } };
                    var dialog = await DialogService.ShowAsync<SecureChatSetupWizardDialog>("Secure Chat Setup", parameters, options);
                    var result = await dialog.Result;
                }
            }

            await ViewportService.SubscribeAsync(this);
            var bp = await ViewportService.GetCurrentBreakpointAsync();
            var isMobile = bp <= Breakpoint.Sm;
            CircuitContext.IsMobileViewport = isMobile;

            var targetPosition = isMobile ? Defaults.Classes.Position.TopCenter : Defaults.Classes.Position.BottomLeft;
            var targetVariant = isMobile ? DrawerVariant.Responsive : DrawerVariant.Mini;
            var targetDrawerOpen = isMobile ? false : _drawerOpen;

            bool needsRender = !_isLoaded
                || Snackbar.Configuration.PositionClass != targetPosition
                || _drawerVariant != targetVariant
                || (isMobile && _drawerOpen != targetDrawerOpen)
                || prevIsCapacitor != _isCapacitorApp;

            Snackbar.Configuration.PositionClass = targetPosition;
            _drawerVariant = targetVariant;
            if (isMobile)
            {
                _drawerOpen = false;
            }
            _isLoaded = true;

            if (needsRender)
            {
                StateHasChanged();
            }
        }
        else
        {
            StartupTimings.AddChatTransition($"Server: MainLayout[{_diagTag}] OnAfterRender #{++_diagAfterRenderCount} (_isChatChannelOpen={_isChatChannelOpen})"); // DIAG-TEMP
        }
    }

