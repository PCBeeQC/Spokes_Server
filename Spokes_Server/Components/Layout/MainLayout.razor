    private string PreserveMobileQuery(string url)
    {
        if (Nav.Uri.Contains("client=mobile") && !url.Contains("client=mobile"))
        {
            var separator = url.Contains('?') ? "&" : "?";
            return $"{url}{separator}client=mobile";
        }
        return url;
    }

    [JSInvokable]
    public void NavigateTo(string url)
    {
        Nav.NavigateTo(PreserveMobileQuery(url));
    }

    [JSInvokable]
    public void OnWindowFocusChanged(bool isFocused)
    {
        bool serverMatches = CircuitContext.IsFocused == isFocused &&
                             !CircuitContext.IsIdle &&
                             (string.IsNullOrEmpty(_currentSubscriptionId) || PresenceState.IsConnectionActivelyViewed(_currentSubscriptionId) == isFocused);
        if (_isThisTabFocused == isFocused && serverMatches) return; // Prevent spurious updates

        _isThisTabFocused = isFocused;
        CircuitContext.IsFocused = isFocused;
        if (isFocused)
        {
            CircuitContext.IsIdle = false;
        }
        CircuitContext.NotifyFocusChanged();

        if (_currentUser != null)
        {
            PresenceState.SetConnectionFocus(_currentUser.Id, _currentSubscriptionId, isFocused);
            if (!isFocused)
            {
                UserClientStateService.FlushToDiskIfUnsent(_currentUser.Id);
            }
        }

        // Force a UI re-render when returning to the app 
        // to un-stick the iOS WKWebView 100vh viewport bug.
        if (isFocused)
        {
            try { _ = JS.InvokeVoidAsync("setCapacitorStatusBarStyle", _isDarkMode); } catch { }

            // Clear any stale pre-sleep snackbars so warm start presents a clean UI
            Snackbar.Clear();

            // Heal any desynced unread counters that were missed while the app was asleep/backgrounded
            ChatNotifications.ReloadUnreadCounts();
            
            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public Task OnShareReceived(SharePayload payload)
    {
        // Normalize plugin's "texts" array into Text/Url if those are empty
        if (payload.Texts is { Count: > 0 })
        {
            foreach (var t in payload.Texts)
            {
                if (Uri.TryCreate(t, UriKind.Absolute, out var uri)
                    && (uri.Scheme == "http" || uri.Scheme == "https"))
                {
                    payload.Url ??= t;
                }
                else
                {
                    payload.Text = string.IsNullOrEmpty(payload.Text) ? t : payload.Text + "\n" + t;
                }
            }
            // If only URLs were in texts and Text is still null, put the URL there too
            payload.Text ??= payload.Url;
        }

        if (!string.IsNullOrEmpty(payload.TargetChannelId))
        {
            ShareTargetStateService.SetPayload(payload, payload.TargetChannelId);
            Nav.NavigateTo(PreserveMobileQuery($"/chat/{payload.TargetChannelId}"));
            return Task.CompletedTask;
        }

        _ = ShowShareModalAsync(payload);
        return Task.CompletedTask;
    }

    private async Task ShowShareModalAsync(SharePayload payload)
    {
        var parameters = new DialogParameters
        {
            { "SharedTitle", payload.Title },
            { "SharedText", payload.Text },
            { "SharedUrl", payload.Url },
            { "SharedFiles", payload.Files ?? [] }
        };

        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ShareModal>("Share to Spokes", parameters,options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ShareModal.ShareResult shareResult)
        {
            if (!string.IsNullOrEmpty(shareResult.ChannelId))
            {
                ShareTargetStateService.SetPayload(payload, shareResult.ChannelId);
                Nav.NavigateTo(PreserveMobileQuery($"/chat/{shareResult.ChannelId}"));
            }
        }
    }

