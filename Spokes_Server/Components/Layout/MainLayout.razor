    public async Task NotifyBrowserViewportChangeAsync(BrowserViewportEventArgs args)
    {
        var isMobile = args.Breakpoint <= Breakpoint.Sm;
        var layoutChanged = CircuitContext.IsMobileViewport != isMobile;
        CircuitContext.IsMobileViewport = isMobile;

        var newVariant = isMobile ? DrawerVariant.Responsive : DrawerVariant.Mini;
        
        var newPosition = isMobile ? Defaults.Classes.Position.TopCenter : Defaults.Classes.Position.BottomLeft;
        if (Snackbar.Configuration.PositionClass != newPosition)
        {
            Snackbar.Configuration.PositionClass = newPosition;
        }

        if (_drawerVariant != newVariant || layoutChanged)
        {
            _drawerVariant = newVariant;
            await InvokeAsync(StateHasChanged);
        }
    }

    public async ValueTask DisposeAsync()
    {
        _isDisposed = true;
        CircuitContext.IsConnected = false;
        CircuitContext.IsTerminated = true;
        CircuitContext.IsFocused = false;

        // Deterministically remove this connection from presence tracking BEFORE any JS interop
        // that throws JSDisconnectedException when disposing a disconnected circuit.
        if (!string.IsNullOrEmpty(_currentSubscriptionId) && PresenceState != null)
        {
            PresenceState.RemoveConnection(_currentSubscriptionId, markTerminated: true);
        }

        try
        {
            if (_dotNetRef != null)
            {
                await JS.InvokeVoidAsync("SpokesBridge.disposeLayout");
            }

            await ViewportService.UnsubscribeAsync(this);
        }
        catch (JSDisconnectedException) { }
        catch (TaskCanceledException) { }
        catch (ObjectDisposedException) { }
        catch (InvalidOperationException) { }

        TimerService.OnTimerChanged -= OnTimerChanged;
        StopUiTimer();
        Nav.LocationChanged -= HandleLocationChanged;
        CircuitContext.OnChatChannelOpenChanged -= HandleChatChannelOpenChanged;
        SessionService.OnSessionRevoked -= HandleSessionRevoked;
        SessionService.OnSessionBanned -= HandleSessionBanned;
        SessionService.OnSessionVaultRevoked -= HandleSessionVaultRevoked;
        SessionService.OnUserSuspensionChanged -= HandleUserSuspensionChanged;
        ScopedKeystore.OnLocked -= HandleScopedKeystoreLocked;
        Db.Employees.OnSaved -= HandleEmployeeSaved;
        Db.CompanyProfile.OnSaved -= HandleCompanyProfileSaved;
        _dotNetRef?.Dispose();
    }

