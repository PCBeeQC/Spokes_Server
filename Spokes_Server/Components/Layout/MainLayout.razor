    // --- Timer Logic ---
    private async Task StartTimerFromMenu()
    {
        if (IsReadOnlyOrRestricted) return;
        var liveUser = await UserService.GetEmployeeAsync();
        _currentUser = liveUser;
        if (liveUser == null || !liveUser.HasPermission(AppPermissions.Timesheets.AccessTimesheet)) return;
        var options = new DialogOptions { MaxWidth = MaxWidth.Small, FullWidth = true, CloseButton = true };
        var dialog = await DialogService.ShowAsync<StartTimerDialog>("Start Timer", options);
        // The dialog handles the actual starting through TimerService
    }

    private async Task StopTimerFromMenu()
    {
        if (IsReadOnlyOrRestricted) return;
        var liveUser = await UserService.GetEmployeeAsync();
        _currentUser = liveUser;
        if (liveUser == null || !liveUser.HasPermission(AppPermissions.Timesheets.AccessTimesheet)) return;
        var result = TimerService.Stop(liveUser.Id);
        if (result.IsSuccess)
        {
            var elapsed = result.Value;
            if (elapsed.TotalMinutes >= 1)
            {
                Snackbar.Add($"Logged {elapsed.Hours}h {elapsed.Minutes}m", Severity.Success);
            }
            else
            {
                Snackbar.Add("Timer < 1 min - discarded", Severity.Warning);
            }
        }
        else
        {
            Snackbar.Add(result.ErrorMessage ?? "Cannot stop timer.", Severity.Error);
        }
    }

    private void OnTimerChanged()
    {
        if (_currentUser == null) return;
        _timerState = TimerService.GetState(_currentUser.Id);

        if (_timerState.IsRunning) StartUiTimer();
        else StopUiTimer();

        InvokeAsync(StateHasChanged);
    }

    private void StartUiTimer()
    {
        _uiTimer?.Dispose();
        _uiTimer = new System.Timers.Timer(1000);
        _uiTimer.Elapsed += (_, _) =>
        {
            if (_timerState.IsRunning && _timerState.StartedAt.HasValue)
            {
                _timerElapsed = DateTime.UtcNow - _timerState.StartedAt.Value;
                InvokeAsync(StateHasChanged);
            }
        };
        _uiTimer.Start();
        if (_timerState.StartedAt.HasValue)
            _timerElapsed = DateTime.UtcNow - _timerState.StartedAt.Value;
    }

    private void StopUiTimer()
    {
        _uiTimer?.Dispose();
        _uiTimer = null;
    }

