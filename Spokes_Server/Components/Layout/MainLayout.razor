    /// <summary>
    /// Checks if the URL is a chat channel URL (i.e. /chat/{channelId}).
    /// This is used to hide the app bar on mobile to maximize chat space.
    /// </summary>
    private static bool IsChatChannelUrl(string url)
    {
        // Extract the path from the full URL
        if (Uri.TryCreate(url, UriKind.Absolute, out var uri))
        {
            var path = uri.AbsolutePath.TrimEnd('/');
            // Match /chat/{something} but not just /chat
            var segments = path.Split('/', StringSplitOptions.RemoveEmptyEntries);
            return segments.Length >= 2 
                && segments[0].Equals("chat", StringComparison.OrdinalIgnoreCase);
        }
        return false;
    }

