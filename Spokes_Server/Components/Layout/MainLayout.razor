        Nav.NavigateTo(PreserveMobileQuery(url));
    }

    private void EnsurePresenceConnectionRegistered(bool? isFocusedOverride = null, bool isReconnect = false, long? presenceSequence = null)
    {
        if (_isDisposed || !CircuitContext.CanRegisterPresence)
            return;

        if (_currentUser is not { IsActive: true, IsBanned: false } || string.IsNullOrEmpty(_currentSubscriptionId))
            return;

        if (isReconnect || !PresenceState.HasConnection(_currentSubscriptionId))
        {
            PresenceState.RegisterConnection(new ConnectionRegistrationOptions
            {
                UserId = _currentUser.Id,
                SubscriptionId = _currentSubscriptionId,
                DeviceType = CircuitContext.DeviceType,
                HasPushEnabled = CircuitContext.HasPushEnabled,
                IsCapacitorApp = CircuitContext.IsCapacitorApp,
                SessionId = _currentSessionId,
                IsFocused = isFocusedOverride ?? CircuitContext.IsFocused,
                IsReconnect = isReconnect,
                PresenceSequence = presenceSequence,
                IsTransportAlive = () => !_isDisposed && CircuitContext.CanRegisterPresence
            });
        }
    }

    private void ApplyFocusState(bool isFocused, bool healUnreadCounts, bool notifyUi, long? sequence = null)
    {
        CircuitContext.IsFocused = isFocused;
        if (isFocused)
        {
            CircuitContext.IsIdle = false;
        }

        if (_currentUser != null)
        {
            PresenceState.SetConnectionFocus(_currentUser.Id, _currentSubscriptionId, isFocused, sequence);
            if (!isFocused)
            {
                UserClientStateService.StopActiveTyping(_currentUser.Id);
            }
        }

        if (isFocused && healUnreadCounts)
        {
            // Heal any desynced unread counters BEFORE NotifyFocusChanged so an actively
            // viewed open chat channel clears its own unread badge immediately afterward.
            ChatNotifications.ReloadUnreadCounts();
            if (IsEmailNotificationEligible)
            {
                EmailNotifications.LoadUnreadCount();
            }
        }

        // Notify subscribers AFTER PresenceState and unread counts are updated so
        // Chat.HandleFocusChanged sees IsConnectionActivelyViewed() == true and marks
        // the open channel as read without being overwritten by ReloadUnreadCounts().
        CircuitContext.NotifyFocusChanged();

        if (isFocused && notifyUi && _isCapacitorApp)
        {
            // Force a UI re-render when returning to the native app
            // to un-stick the iOS WKWebView 100vh viewport bug.
            try { _ = JS.InvokeVoidAsync("setCapacitorStatusBarStyle", _isDarkMode); } catch { }

            // Clear any stale pre-sleep snackbars so warm start presents a clean UI
            Snackbar.Clear();

            InvokeAsync(StateHasChanged);
        }
    }

    [JSInvokable]
    public void OnPageRestoredFromCache(bool isFocused, long sequence)
    {
        if (_isDisposed || !CircuitContext.CanRegisterPresence) return;

        long? seq = sequence > 0 ? sequence : null;
        EnsurePresenceConnectionRegistered(isFocused, isReconnect: true, presenceSequence: seq);
        ApplyFocusState(isFocused, healUnreadCounts: isFocused, notifyUi: false, sequence: seq);
    }

    [JSInvokable]
    public void OnWindowFocusChanged(bool isFocused, long sequence)
    {
        if (_isDisposed || !CircuitContext.CanRegisterPresence) return;

        long? seq = sequence > 0 ? sequence : null;
        bool serverMatchesBeforeRegister = CircuitContext.IsFocused == isFocused &&
                                           !CircuitContext.IsIdle &&
                                           (string.IsNullOrEmpty(_currentSubscriptionId) ||
                                            (PresenceState.HasConnection(_currentSubscriptionId) &&
                                             PresenceState.IsConnectionActivelyViewed(_currentSubscriptionId) == isFocused));

        if (isFocused) EnsurePresenceConnectionRegistered(true, presenceSequence: seq);

        if (serverMatchesBeforeRegister)
        {
            if (_currentUser != null && seq.HasValue)
            {
                PresenceState.SetConnectionFocus(_currentUser.Id, _currentSubscriptionId, isFocused, seq);
            }
            return; // Prevent spurious UI notifications while still advancing monotonic sequence
        }

        ApplyFocusState(isFocused, healUnreadCounts: true, notifyUi: true, sequence: seq);
    }

    [JSInvokable]
    public Task OnShareReceived(SharePayload payload)
    {
        if (IsReadOnlyOrRestricted || !_currentUser!.HasPermission(AppPermissions.Chat.Use)) return Task.CompletedTask;

        if (!string.IsNullOrEmpty(payload.TargetChannelId))
        {
            ShareTargetStateService.SetPayload(payload, payload.TargetChannelId);
            Nav.NavigateTo(PreserveMobileQuery($"/chat/{payload.TargetChannelId}"));
            return Task.CompletedTask;
        }

        _ = ShowShareModalAsync(payload);
        return Task.CompletedTask;
    }

    private async Task ShowShareModalAsync(SharePayload payload)
    {
        var options = new DialogOptions { CloseOnEscapeKey = true, MaxWidth = MaxWidth.Large, FullWidth = true };
        var dialog = await DialogService.ShowAsync<ShareModal>("Share to Spokes", options);
        var result = await dialog.Result;

        if (result != null && !result.Canceled && result.Data is ShareModal.ShareResult shareResult)
        {
            if (!string.IsNullOrEmpty(shareResult.ChannelId))
            {
                ShareTargetStateService.SetPayload(payload, shareResult.ChannelId);
                Nav.NavigateTo(PreserveMobileQuery($"/chat/{shareResult.ChannelId}"));
            }
        }
    }

