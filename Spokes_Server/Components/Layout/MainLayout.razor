    // --- Presence Connection Registration ---
    private static string? ExtractDictString(Dictionary<string, object>? dict, string key)
    {
        if (dict == null || !dict.TryGetValue(key, out var val) || val == null) return null;
        if (val is System.Text.Json.JsonElement je)
        {
            return je.ValueKind == System.Text.Json.JsonValueKind.String ? je.GetString() : je.ToString();
        }
        return val.ToString();
    }

    private async Task RegisterPresenceConnection(LayoutClientInitResult? clientInit)
    {
        if (_currentUser == null) return;

        if (string.IsNullOrEmpty(_currentSubscriptionId))
        {
            _currentSubscriptionId = Guid.NewGuid().ToString();
        }

        var currentSession = !string.IsNullOrEmpty(_currentSessionId) ? Db.DeviceSessions.GetById(_currentSessionId) : null;
        bool isDesktopClient = (clientInit?.IsDesktopApp == true) || _isDesktopSession;
        bool isNativeApp = !isDesktopClient && (clientInit?.IsCapacitorApp ?? _isCapacitorApp);
        bool isCapacitorApp = !isDesktopClient && (isNativeApp || (currentSession?.IsCapacitorApp ?? false));
        var deviceType = isDesktopClient
            ? DeviceType.Desktop
            : (isCapacitorApp
                ? DeviceType.Mobile
                : (!string.IsNullOrEmpty(clientInit?.DeviceType) ? clientInit.DeviceType : (currentSession?.DeviceType ?? DeviceType.Desktop)));

        // Self-heal previously poisoned sessions or persist Capacitor identity on mobile sessions
        if (isDesktopClient && currentSession != null && (currentSession.IsCapacitor || currentSession.DeviceType != DeviceType.Desktop))
        {
            currentSession.IsCapacitor = false;
            currentSession.DeviceType = DeviceType.Desktop;
            Db.DeviceSessions.Save(currentSession);
        }
        else if (isCapacitorApp && currentSession != null && (!currentSession.IsCapacitor || currentSession.DeviceType != DeviceType.Mobile))
        {
            currentSession.IsCapacitor = true;
            currentSession.DeviceType = DeviceType.Mobile;
            Db.DeviceSessions.Save(currentSession);
        }

        bool hasPushEnabled = false;
        bool shouldSyncPushSubscription = false;
        var existingSub = clientInit?.ExistingSubscription;
        var endpoint = ExtractDictString(existingSub, "endpoint");
        if (existingSub != null && !string.IsNullOrEmpty(endpoint))
        {
            _currentSubscriptionEndpoint = endpoint;
            var sub = Db.DeviceSessions.GetByPushEndpoint(_currentSubscriptionEndpoint);
            var incomingPubKey = ExtractDictString(existingSub, "publicKey");
            bool pubKeyMatches = string.IsNullOrEmpty(incomingPubKey) || currentSession?.PushPublicKey == incomingPubKey;

            if (sub != null && sub.Id == currentSession?.Id && currentSession.HasPush && pubKeyMatches)
            {
                hasPushEnabled = currentSession.PushEnabled;
                if (!isDesktopClient)
                {
                    isCapacitorApp = isCapacitorApp || sub.IsCapacitorApp;
                    deviceType = (isCapacitorApp || deviceType == DeviceType.Mobile) ? DeviceType.Mobile : sub.DeviceType;
                }
            }
            else
            {
                // Active push subscription exists on client; sync or register to current session
                var subType = ExtractDictString(existingSub, "subscriptionType");
                bool isExistingRelay = subType == "NativeRelay" || isNativeApp || (clientInit?.RequiresPushRelay ?? false);
                bool isNativePushBlocked = _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.HardLock || 
                                           _licenseStatus == Spokes_Server.Core.Services.Licensing.LicenseStatus.Expired;

                if (!isExistingRelay || !isNativePushBlocked)
                {
                    hasPushEnabled = true;
                    shouldSyncPushSubscription = true;
                }
            }
        }

        if (clientInit?.IosSoundDisabled == true && hasPushEnabled)
        {
            Snackbar.Add("Notification sounds are disabled for Spokes in your iPhone Settings.", Severity.Warning, config =>
            {
                config.Action = "Open Settings";
                config.ActionColor = Color.Warning;
                config.OnClick = _ => JS.InvokeVoidAsync("pushNotifications.openAppSettings").AsTask();
                config.RequireInteraction = true;
            });
        }

        _isCapacitorApp = isCapacitorApp;

        if (clientInit?.IsFocused == false || !PresenceState.IsConnectionActivelyViewed(_currentSubscriptionId))
        {
            _isThisTabFocused = false;
        }

        // Populate scoped circuit context for PresenceCircuitHandler
        CircuitContext.UserId = _currentUser.Id;
        CircuitContext.SubscriptionId = _currentSubscriptionId;
        CircuitContext.SessionId = _currentSessionId;
        CircuitContext.DeviceType = deviceType;
        CircuitContext.HasPushEnabled = hasPushEnabled;
        CircuitContext.IsCapacitorApp = isCapacitorApp;
        CircuitContext.IsFocused = _isThisTabFocused;
        CircuitContext.IsIdle = false;

        // Register the connection in the PresenceState service before awaiting any slow push sync JS roundtrip
        PresenceState.RegisterConnection(new ConnectionRegistrationOptions
        {
            UserId = _currentUser.Id,
            SubscriptionId = _currentSubscriptionId,
            DeviceType = deviceType,
            HasPushEnabled = hasPushEnabled,
            IsCapacitorApp = isCapacitorApp,
            SessionId = _currentSessionId,
            IsFocused = _isThisTabFocused
        });

        if (shouldSyncPushSubscription && existingSub != null)
        {
            try
            {
                await JS.InvokeAsync<bool>("pushNotifications.sendSubscriptionToServer", existingSub, deviceType, "", true);
            }
            catch { /* Ignore */ }
        }
    }

    [JSInvokable]
    public void OnDeviceActivePing()
    {
        bool wasIdle = CircuitContext.IsIdle;
        CircuitContext.IsIdle = false;
        PresenceState.PingDeviceActive(_currentSubscriptionId);
        if (wasIdle && _isThisTabFocused)
        {
            CircuitContext.NotifyFocusChanged();
        }
    }

    [JSInvokable]
    public void OnClientPresenceStateChanged(string state)
    {
        if (string.IsNullOrEmpty(state)) return;

        var normalized = state.Trim().ToLowerInvariant();
        var parsedState = normalized switch
        {
            "away" or "idle" => ConnectionPresenceState.Idle,
            "dnd" => ConnectionPresenceState.DoNotDisturb,
            "offline" or "invisible" => ConnectionPresenceState.Offline,
            _ => ConnectionPresenceState.Active
        };

        bool wasIdle = CircuitContext.IsIdle;
        CircuitContext.IsIdle = parsedState is ConnectionPresenceState.Idle or ConnectionPresenceState.Offline;

        PresenceState.SetConnectionPresenceState(_currentSubscriptionId, parsedState);

        if (CircuitContext.IsIdle && _currentUser != null)
        {
            UserClientStateService.FlushToDiskIfUnsent(_currentUser.Id);
        }
        else if (wasIdle && !CircuitContext.IsIdle && _isThisTabFocused)
        {
            CircuitContext.NotifyFocusChanged();
        }
    }

