@* Custom snackbar content for email notifications *@
<div class="d-flex align-center gap-3" style="cursor: pointer;">
    <MudAvatar Size="Size.Medium" Color="Color.Primary" Variant="Variant.Filled">
        <MudIcon Icon="@Icons.Material.Filled.Email" />
    </MudAvatar>
    <div style="max-width: 250px; overflow: hidden;">
        <MudText Typo="Typo.caption" Style="opacity: 0.7;">New Email</MudText>
        <MudText Typo="Typo.subtitle2"
            Style="font-weight: 600; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@SenderName
        </MudText>
        <MudText Typo="Typo.body2"
            Style="font-weight: 500; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@Subject</MudText>
        <MudText Typo="Typo.body2"
            Style="opacity: 0.8; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;">@Snippet</MudText>
    </div>
</div>

@code {
    [Parameter] public string SenderName { get; set; } = "";
    [Parameter] public string Subject { get; set; } = "";
    [Parameter] public string Snippet { get; set; } = "";
}
