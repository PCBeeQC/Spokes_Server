@inject Database Db

<Router AppAssembly="@typeof(Program).Assembly">
    <Found Context="routeData">
        @{
            RouteData effectiveRouteData = routeData;
            if (routeData.PageType == typeof(Pages.Home) && Db.CompanyProfile.Get()?.Edition == "Family")
            {
                var values = new Dictionary<string, object?>(routeData.RouteValues)
                {
                    [nameof(Pages.Chat.Chat.ChannelId)] = null
                };
                effectiveRouteData = new RouteData(typeof(Pages.Chat.Chat), values);
            }
        }
        <AuthorizeRouteView RouteData="@effectiveRouteData" DefaultLayout="@typeof(Layout.MainLayout)">
            <Authorizing>
                <LayoutView Layout="@typeof(Layout.MainLayout)">
                    <div class="d-flex justify-center align-center" style="height: 60vh;">
                        <MudProgressCircular Color="Color.Primary" Indeterminate="true" />
                    </div>
                </LayoutView>
            </Authorizing>
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
    </Found>
    <NotFound>
        <PageTitle>Not found</PageTitle>
        <AuthorizeView>
            <Authorized>
                <LayoutView Layout="@typeof(Layout.MainLayout)">
                    <p role="alert">Sorry, there's nothing at this address.</p>
                </LayoutView>
            </Authorized>
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeView>
    </NotFound>
</Router>
