            const paper = document.getElementById(paperId);
            if (!paper) return;

            const printBody = paper.querySelector('.print-body');
            if (!printBody) return;

            // --- 1. Identify measurable blocks ---
            const blocks = [];
            let currentId = 0;

            function collectBlocks(node) {
                // If it's keep-together or doesn't have allow-break, it's atomic
                if (node.classList.contains('keep-together') || !node.classList.contains('allow-break')) {
                    node.setAttribute('data-pg-id', currentId++);
