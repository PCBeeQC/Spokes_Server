                }
            }).then(() => {
                // Initial connection established
                console.log('[App.razor] Blazor circuit established.');
                if (typeof loadDeferredScripts === 'function') {
                    loadDeferredScripts();
                }
                window.startupTimings.blazor_conn_up = Date.now();
                if (window._isServerRestarting) return;
                const splash = document.getElementById('startup-splash');
                if (splash) splash.style.display = 'none';
                try {
                    Blazor.addEventListener('enhancedload', () => {
                        if (window._blazorDisconnected || window._isServerRestarting || window._reloadInProgress) return;
                        if (window.startupTimings && window.startupTimings.blazor_conn_up) {
                            const s = document.getElementById('startup-splash');
                            if (s) s.style.display = 'none';
                        }
                    });
                } catch (e) {}
            }).catch(async e => {
                console.error('[App.razor] Blazor.start() promise rejected:', e);
                const errMsg = e ? (e.message || e.toString()) : "unknown";
                
                // If Blazor failed, the session may have been lost between the page request and the
