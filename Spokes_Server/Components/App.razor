@using Spokes_Server.Aggregate
@using Spokes_Server.Core.Models.Core
@using Spokes_Server.Core.Models.Projects
@using Spokes_Server.Core.Models.Accounting
@using Spokes_Server.Core.Models.Communication
@using Spokes_Server.Core.Models.HR
@inject Database Db
@inject Spokes_Server.Core.Services.Security.ScopedKeystoreService ScopedKeystore
@inject Spokes_Server.Core.Services.Security.GlobalKeystoreService GlobalKeystore
@inject ICryptoService Crypto
@{
    var profile = Db.CompanyProfile.Get();
    
    // Auto-unlock vault on HTTP request start if cookie is present
    if (HttpContext != null && HttpContext.Request.Cookies.ContainsKey("chat_vault_key"))
    {
        var sub = HttpContext.User.FindFirst("sub")?.Value ?? HttpContext.User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value;
        if (!string.IsNullOrEmpty(sub))
        {
            var openIdAccount = Db.OpenIdAccounts.GetBySub(sub);
            var user = (openIdAccount != null && !string.IsNullOrEmpty(openIdAccount.LinkedEmployeeId))
                ? Db.Employees.GetById(openIdAccount.LinkedEmployeeId)
                : Db.Employees.GetAll().FirstOrDefault(e => e.Email == HttpContext.User.FindFirst("email")?.Value);
            var empId = user?.Id ?? HttpContext.User.FindFirst("EmployeeId")?.Value;
            if (!string.IsNullOrEmpty(empId) && !ScopedKeystore.IsUnlocked)
            {
                var employee = Db.Employees.GetById(empId);
                if (employee != null && employee.HasChatPassword && !string.IsNullOrEmpty(employee.EncryptedPrivateKey))
                {
                    ScopedKeystore.TryInitializeFromVaultCookie(HttpContext, empId, employee.EncryptedPrivateKey, Crypto, GlobalKeystore);
                }
            }
        }
    }








    var brandingToken = Db.SystemConfigs.Get().PublicBrandingToken ?? "default";
    var favicon = $"/branding/{brandingToken}/icon.png";
    var startupId = HttpContext?.Items["StartupCorrelationId"] as string;
    var clientTimings = HttpContext?.Items["ClientLocalTimings"] as string;
    var signalRLogLevel = Environment.GetEnvironmentVariable("Spokes_SignalR_Log_Level");
}
<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, interactive-widget=resizes-content, viewport-fit=cover" />
    <base href="/" />
    <link rel="preload" href="/_blazor/initializers" as="fetch" crossorigin="anonymous">
    <link rel="preconnect" href="@(HttpContext.Request.Scheme + "://" + HttpContext.Request.Host)" />
    <link rel="preconnect" href="https://cdn.jsdelivr.net" crossorigin />
    <link rel="preconnect" href="https://cdn.quilljs.com" crossorigin />
    <link rel="preconnect" href="https://cdnjs.cloudflare.com" crossorigin />
    <link rel="preconnect" href="https://unpkg.com" crossorigin />
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    <link rel="icon" href="@favicon" />
    @if (HttpContext != null && (HttpContext.Request.Path.StartsWithSegments("/mobile-login") || HttpContext.Request.Path.StartsWithSegments("/mobile-login-success")))
    {
        <HeadOutlet />
    }
    else
    {
        <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    }
    <ImportMap />
    <link href="https://cdn.quilljs.com/2.0.3/quill.snow.css" rel="stylesheet" />
    <link href="https://cdnjs.cloudflare.com/ajax/libs/cropperjs/1.6.1/cropper.min.css" rel="stylesheet" />
    <link href="@Assets["css/app.css"]" rel="stylesheet" />
    <script src="@Assets["js/capacitor-init.js"]"></script>
    <script src="@Assets["js/spokes-auth.js"]"></script>
    <script src="@Assets["js/spokes-vault.js"]"></script>
    <script src="@Assets["js/voice-recorder.js"]"></script>
</head>

<body>
    <div id="startup-splash" style="position: fixed; inset: 0; background-color: #1e1e2d; z-index: 999999; display: flex; flex-direction: column; align-items: center; justify-content: center;">
        <div style="width: 40px; height: 40px; border: 3px solid rgba(255,255,255,0.1); border-top-color: #7e6fff; border-radius: 50%; animation: spokes-spin 1s linear infinite;"></div>
        <div id="splash-status" style="margin-top: 20px; color: #999; font-family: sans-serif; text-align: center; max-width: 80%; font-size: 14px;"></div>
        <style>@@keyframes spokes-spin { to { transform: rotate(360deg); } }</style>
    </div>
    @if (HttpContext != null && (HttpContext.Request.Path.StartsWithSegments("/mobile-login") || HttpContext.Request.Path.StartsWithSegments("/mobile-login-success")))
    {
        <Routes />
    }
    else
    {
        <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    }
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        window.__startupCorrelationId = "@startupId";
        window.__clientLocalTimings = "@clientTimings";
        window.__signalRLogLevel = "@signalRLogLevel";
        window.startupTimings = window.startupTimings || {};
        window.startupTimings.remote_html_received = Date.now();

        console.log('[App.razor] [STARTUP-DIAGNOSTIC] Remote HTML received. Startup ID:', window.__startupCorrelationId);

        try {
            const navEntries = window.performance.getEntriesByType("navigation");
            if (navEntries && navEntries.length > 0) {
                const nav = navEntries[0];
                console.log('[STARTUP-DIAGNOSTIC] --- Web Vitals & Navigation Timings ---');
                console.log('  Redirect:        ' + (nav.redirectEnd - nav.redirectStart).toFixed(1) + 'ms');
                console.log('  DNS Lookup:      ' + (nav.domainLookupEnd - nav.domainLookupStart).toFixed(1) + 'ms');
                console.log('  TCP Connect:     ' + (nav.connectEnd - nav.connectStart).toFixed(1) + 'ms');
                if (nav.secureConnectionStart > 0) {
                    console.log('  SSL Handshake:   ' + (nav.connectEnd - nav.secureConnectionStart).toFixed(1) + 'ms');
                }
                console.log('  Time to First Byte (TTFB): ' + nav.responseStart.toFixed(1) + 'ms');
                console.log('  HTML Download:   ' + (nav.responseEnd - nav.responseStart).toFixed(1) + 'ms');
                console.log('  DOM Interactive: ' + nav.domInteractive.toFixed(1) + 'ms');
                console.log('--------------------------------------------------');
            }
        } catch(e) { console.warn('[STARTUP-DIAGNOSTIC] Navigation timing failed', e); }

        try {
            // Dump resource timings for the Dead Zone
            console.log('[STARTUP-DIAGNOSTIC] --- Resource Load Timings (The Dead Zone) ---');
            const resources = window.performance.getEntriesByType("resource");
            resources.forEach(r => {
                if (r.initiatorType === 'link' || r.initiatorType === 'script' || (r.name && (r.name.includes('css') || r.name.includes('js')))) {
                    const duration = r.duration ? r.duration.toFixed(1) : 0;
                    const name = r.name ? r.name.substring(r.name.lastIndexOf('/') + 1) : 'unknown';
                    console.log(`  [Resource] ${name}: ` +
                        `${duration}ms ` +
                        `(Start: ${(r.startTime || 0).toFixed(1)}, End: ${(r.responseEnd || 0).toFixed(1)})`);
                }
            });
            console.log('--------------------------------------------------');
        } catch(e) { console.warn('[STARTUP-DIAGNOSTIC] Resource timing failed', e); }
            
        try {
            // Fetch patch remains but WebSocket patch removed to fix Blazor startup
            const originalFetch = window.fetch;
            window.fetch = async function() {
                let url = '';
                if (arguments[0] instanceof Request) url = arguments[0].url;
                else if (typeof arguments[0] === 'string') url = arguments[0];
                
                if (url && typeof url === 'string' && (url.includes('/negotiate') || url.includes('_blazor') || url.includes('/prime-session'))) {
                    console.log(`[STARTUP-DIAGNOSTIC] Fetch called for ${url} at ${Date.now()}`);
                    // Track start time for timeline
                    const fetchStart = Date.now();
                    if (url.includes('/prime-session')) window.startupTimings.prime_session_start = fetchStart;
                    if (url.includes('/negotiate')) window.startupTimings.negotiate_start = fetchStart;
                    try {
                        const res = await originalFetch.apply(this, arguments);
                        const fetchEnd = Date.now();
                        console.log(`[STARTUP-DIAGNOSTIC] Fetch completed for ${url} at ${fetchEnd} with status ${res.status} (${fetchEnd - fetchStart}ms)`);
                        // Track end time for timeline
                        if (url.includes('/prime-session')) window.startupTimings.prime_session_end = fetchEnd;
                        if (url.includes('/negotiate')) window.startupTimings.negotiate_end = fetchEnd;
                        return res;
                    } catch(err) {
                        console.log(`[STARTUP-DIAGNOSTIC] Fetch FAILED for ${url} at ${Date.now()}`, err);
                        throw err;
                    }
                }
                return originalFetch.apply(this, arguments);
            };

            // Patch XHR for Long Polling
            const originalXHROpen = window.XMLHttpRequest.prototype.open;
            window.XMLHttpRequest.prototype.open = function(method, url) {
                if (typeof url === 'string' && (url.includes('/negotiate') || url.includes('_blazor'))) {
                    console.log(`[STARTUP-DIAGNOSTIC] XHR Open called for ${url} at ${Date.now()}`);
                    this.addEventListener('load', function() {
                        console.log(`[STARTUP-DIAGNOSTIC] XHR Load completed for ${url} at ${Date.now()} with status ${this.status}`);
                    });
                    this.addEventListener('error', function() {
                        console.log(`[STARTUP-DIAGNOSTIC] XHR ERROR for ${url} at ${Date.now()}`);
                    });
                }
                return originalXHROpen.apply(this, arguments);
            };
        } catch(e) { console.warn('[STARTUP-DIAGNOSTIC] Patching failed', e); }

        // Patch WebSocket to track connection timing (TCP + TLS + upgrade handshake)
        try {
            const OriginalWebSocket = window.WebSocket;
            window.WebSocket = function(url, protocols) {
                const ws = protocols ? new OriginalWebSocket(url, protocols) : new OriginalWebSocket(url);
                if (url && typeof url === 'string' && url.includes('_blazor')) {
                    window.startupTimings.ws_open_start = Date.now();
                    console.log(`[STARTUP-DIAGNOSTIC] WebSocket opening to ${url.split('?')[0]} at ${Date.now()}`);
                    ws.addEventListener('open', () => {
                        window.startupTimings.ws_open_end = Date.now();
                        console.log(`[STARTUP-DIAGNOSTIC] WebSocket connected in ${Date.now() - window.startupTimings.ws_open_start}ms`);
                    });
                }
                return ws;
            };
            window.WebSocket.prototype = OriginalWebSocket.prototype;
            window.WebSocket.CONNECTING = OriginalWebSocket.CONNECTING;
            window.WebSocket.OPEN = OriginalWebSocket.OPEN;
            window.WebSocket.CLOSING = OriginalWebSocket.CLOSING;
            window.WebSocket.CLOSED = OriginalWebSocket.CLOSED;
        } catch(e) { console.warn('[STARTUP-DIAGNOSTIC] WebSocket patching failed', e); }

        window.checkCookieHealthAsync = async () => {
            if (window._cookieRefreshInProgress) return;
            window._cookieRefreshInProgress = true; // Synchronous guard against re-entrancy
            
            let navigatingAway = false;
            let validUntil = 0;
            let lastRefresh = 0;
            if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Preferences) {
                try {
                    const [v, l] = await Promise.all([
                        window.Capacitor.Plugins.Preferences.get({ key: ('spokes_session_valid_until_' + window.location.hostname) }),
                        window.Capacitor.Plugins.Preferences.get({ key: ('spokes_session_last_refresh_' + window.location.hostname) })
                    ]);
                    validUntil = parseInt(v?.value || '0', 10);
                    lastRefresh = parseInt(l?.value || '0', 10);
                } catch (e) {}
            }

            const isExpired = validUntil > 0 && Date.now() > validUntil;
            const isStale = lastRefresh > 0 && (Date.now() - lastRefresh) > 12 * 3600 * 1000;

            if (isExpired) {
                console.warn('[Mobile Resume] Session cookie is EXPIRED. Pausing UI to refresh.');
                const splash = document.getElementById('startup-splash');
                if (splash) splash.style.display = 'flex';
                
                try {
                    if (window.spokesAuth && window.spokesAuth.refreshSessionAsync) {
                        const refreshed = await window.spokesAuth.refreshSessionAsync();
                        if (!refreshed) {
                            const currentToken = await window.spokesAuth.getRefreshToken();
                            if (!currentToken) {
                                console.warn('[Mobile Resume] Refresh token missing/revoked. Redirecting to login.');
                                const rawLoc = window.location.pathname + window.location.search + window.location.hash;
                                const returnUrl = (window.spokesAuth && window.spokesAuth.getSafeRedirectUrl) ? window.spokesAuth.getSafeRedirectUrl(rawLoc) : (rawLoc.startsWith('/') ? rawLoc : '/');
                                navigatingAway = true;
                                window.location.replace('/mobile-login?returnUrl=' + encodeURIComponent(returnUrl));
                                return; // Don't hide splash, we are navigating away
                            } else {
                                console.log('[Mobile Resume] Refresh failed but token exists. Assuming offline, not redirecting.');
                            }
                        }
                    }
                } finally {
                    if (splash && !navigatingAway) splash.style.display = 'none';
                    window._cookieRefreshInProgress = false;
                }
            } else if (isStale) {
                const lastAttempt = window._spokes_session_last_refresh_attempt || 0;
                if (Date.now() - lastAttempt > 60000) {
                    window._spokes_session_last_refresh_attempt = Date.now();
                    console.log('[Mobile Resume] Session cookie is stale. Triggering proactive background refresh.');
                    if (window.spokesAuth && window.spokesAuth.refreshSessionAsync) {
                        window.spokesAuth.refreshSessionAsync().catch(() => {});
                    }
                }
                window._cookieRefreshInProgress = false;
            } else {
                window._cookieRefreshInProgress = false;
            }
        };

        window._nativeAppActive = true;
        if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.App) {
            window.Capacitor.Plugins.App.addListener('appStateChange', ({ isActive }) => {
                window._nativeAppActive = isActive;
                console.log(`[Mobile Resume] appStateChange - isActive: ${isActive}`);
                if (isActive) {
                    window.checkCookieHealthAsync().catch(() => {});
                    if (typeof window._blazorVisHandler === 'function') {
                        window._blazorVisHandler();
                    }
                }
            });
        }

        // Resilient fallback: visibilitychange is NOT destroyed by Capacitor's removeAllListeners().
        // The appStateChange listener above may be wiped by initCapacitorEnv(), so this ensures
        // checkCookieHealthAsync always fires on resume regardless of Capacitor plugin lifecycle.
        document.addEventListener('visibilitychange', () => {
            if (document.visibilityState === 'visible' && window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform()) {
                window.checkCookieHealthAsync().catch(() => {});
            }
        });

        window.startupDiagnostics = {
            reportInteractive: function(userId, avatarLength, serverTimings) {
                const now = Date.now();
                window.startupTimings.interactive = now;
                console.log('[App.razor] [STARTUP-DIAGNOSTIC] App interactive at:', now, 'User ID:', userId, 'Avatar Length:', avatarLength);
                
                const correlationId = window.__startupCorrelationId;
                const cTimesStr = window.__clientLocalTimings;
                
                const timeline = [];
                let localStart = null;
                
                if (cTimesStr) {
                    cTimesStr.split(',').forEach(part => {
                        const lastIdx = part.lastIndexOf('_');
                        if (lastIdx !== -1) {
                            const name = part.substring(0, lastIdx);
                            const timeStr = part.substring(lastIdx + 1);
                            const time = parseInt(timeStr);
                            if (name === 'head') localStart = time;
                            timeline.push({ name: 'Client: ' + name, absolute: time });
                        }
                    });
                }
                
                // Client-side milestones
                if (window.startupTimings.remote_html_received) timeline.push({ name: 'Client: HTML Received', absolute: window.startupTimings.remote_html_received });
                if (window.startupTimings.cookie_sync_start) timeline.push({ name: 'Client: Cookie Sync Start', absolute: window.startupTimings.cookie_sync_start });
                if (window.startupTimings.cookie_sync_end) timeline.push({ name: 'Client: Cookie Sync Done', absolute: window.startupTimings.cookie_sync_end });
                if (window.startupTimings.vault_sync_end) timeline.push({ name: 'Client: Vault Sync Done', absolute: window.startupTimings.vault_sync_end });
                if (window.startupTimings.prime_session_start) timeline.push({ name: 'Client: Prime Session Start', absolute: window.startupTimings.prime_session_start });
                if (window.startupTimings.prime_session_end) timeline.push({ name: 'Client: Prime Session Done', absolute: window.startupTimings.prime_session_end });
                if (window.startupTimings.blazor_start) timeline.push({ name: 'Client: Blazor.start()', absolute: window.startupTimings.blazor_start });
                if (window.startupTimings.negotiate_start) timeline.push({ name: 'Client: Negotiate Start', absolute: window.startupTimings.negotiate_start });
                if (window.startupTimings.negotiate_end) timeline.push({ name: 'Client: Negotiate Done', absolute: window.startupTimings.negotiate_end });
                if (window.startupTimings.ws_open_start) timeline.push({ name: 'Client: WebSocket Open Start', absolute: window.startupTimings.ws_open_start });
                if (window.startupTimings.ws_open_end) timeline.push({ name: 'Client: WebSocket Connected', absolute: window.startupTimings.ws_open_end });
                if (window.startupTimings.blazor_conn_up) timeline.push({ name: 'Client: Circuit Established', absolute: window.startupTimings.blazor_conn_up });
                
                let clockOffset = 0;
                if (serverTimings && serverTimings.length > 0) {
                    // The last server timing is right before this function is called
                    const lastServerTiming = serverTimings[serverTimings.length - 1].timestamp || serverTimings[serverTimings.length - 1].Timestamp;
                    clockOffset = now - lastServerTiming;
                    
                    serverTimings.forEach(st => {
                        const name = st.name || st.Name;
                        const ts = st.timestamp || st.Timestamp;
                        timeline.push({ name: name, absolute: ts + clockOffset });
                    });
                }

                timeline.push({ name: 'Client: App Interactive', absolute: now });
                
                timeline.sort((a, b) => a.absolute - b.absolute);
                
                if (!localStart && timeline.length > 0) {
                    localStart = timeline[0].absolute;
                }
                
                console.log('==================================================');
                console.log('[STARTUP TIMELINE REPORT] ID: ' + correlationId);
                console.log('User ID: ' + userId + ' | Avatar Size: ' + avatarLength + ' bytes');
                console.log('--------------------------------------------------');
                
                timeline.forEach((step, idx) => {
                    const elapsedSinceStart = step.absolute - localStart;
                    const delta = idx === 0 ? 0 : step.absolute - timeline[idx - 1].absolute;
                    console.log(`${step.name.padEnd(40)}: ${elapsedSinceStart.toString().padStart(6)}ms (delta: +${delta}ms)`);
                });
                console.log('==================================================');

                // Clear the startup cookies so subsequent reloads don't reuse stale timings
                document.cookie = "Spokes_Startup_Id=; Max-Age=0; path=/";
                document.cookie = "Spokes_Client_Times=; Max-Age=0; path=/";

                // Eager-lazy: load non-critical scripts now that the app is interactive
                if (!window._lazyScriptsLoaded) {
                    window._lazyScriptsLoaded = true;
                    loadDeferredScripts();
                }
            }
        };

        window.addEventListener('error', function(event) {
            console.error('[Global Error]', event.message, event.error);
        });
        window.addEventListener('unhandledrejection', function(event) {
            console.error('[Unhandled Rejection]', event.reason);
        });

        // Buffer console output to Capacitor Preferences for mobile debugging.
        (function() {
            // Capacitor drops `console.trace` and Logcat often hides `console.debug`. 
            // We map them to console.log so they always show up in the native logs when debugging.
            if (window.Capacitor) {
                const origTrace = console.trace;
                console.trace = function() {
                    console.log.apply(console, arguments);
                };
                const origDebug = console.debug;
                console.debug = function() {
                    console.log.apply(console, arguments);
                };
            }

            const pendingLogs = [];
            let flushTimeout = null;
            function flushLogs() {
                if (pendingLogs.length === 0) return Promise.resolve();
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Preferences) {
                    const logsToFlush = [...pendingLogs];
                    pendingLogs.length = 0;
                    return window.Capacitor.Plugins.Preferences.get({ key: 'debug_logs' }).then(res => {
                        let existing = [];
                        try { if (res.value) existing = JSON.parse(res.value); } catch(e) {}
                        existing = existing.concat(logsToFlush);
                        if (existing.length > 1000) existing = existing.slice(existing.length - 1000);
                        return window.Capacitor.Plugins.Preferences.set({ key: 'debug_logs', value: JSON.stringify(existing) });
                    }).catch(() => {});
                }
                return Promise.resolve();
            }

            ['log', 'warn', 'error', 'info', 'debug'].forEach(function(method) {
                const original = console[method];
                if (!original) return;
                console[method] = function() {
                    original.apply(console, arguments);
                    
                    try {
                        const msgArgs = Array.from(arguments).map(a => {
                            if (a instanceof Error) return a.stack || a.message;
                            if (typeof a === 'object') {
                                try { return JSON.stringify(a); } catch(e) { return String(a); }
                            }
                            return String(a);
                        }).join(' ');
                        if (/^\[.*?\] (Information|Warning|Error|Debug|Trace):/.test(msgArgs)) {
                            // Only suppress if the user hasn't explicitly enabled SignalR logging
                            if (!window.__signalRLogLevel || window.__signalRLogLevel.toLowerCase() === 'none') {
                                return; 
                            }
                        }
                        const logEntry = `[${new Date().toISOString()}] [${method.toUpperCase()}] ${msgArgs}`;
                        pendingLogs.push(logEntry);
                        if (!flushTimeout) {
                            flushTimeout = setTimeout(() => {
                                flushTimeout = null;
                                flushLogs();
                            }, 500);
                        }
                    } catch(e) {}
                };
            });
            window.flushAppLogs = flushLogs;
        })();

        // Fallback for severe boot failures to show UI to user instead of white screen
        function handleSevereError(msg) {
            console.error('[App.razor] SEVERE ERROR:', msg);
            const statusEl = document.getElementById('splash-status');
            if (statusEl) {
                statusEl.innerText = msg;
                statusEl.style.color = '#ef4444';
            }
        }

        window.spokesTriggerServerRestart = function(targetUrl) {
            window._isServerRestarting = true;
            const splash = document.getElementById('startup-splash');
            if (splash) splash.style.display = 'flex';
            const status = document.getElementById('splash-status');
            if (status) {
                status.innerText = "Restarting server, please wait...";
                status.style.color = "#999";
            }

            let destination = targetUrl || window.location.href;
            try {
                const urlObj = new URL(destination, window.location.href);
                if (window.location.search.includes('client=mobile')) {
                    urlObj.searchParams.set('client', 'mobile');
                }
                destination = urlObj.toString();
            } catch (e) {}

            console.log('[Server Restart] Initiated restart. Destination after restart:', destination);

            setTimeout(() => {
                const pollInterval = setInterval(async () => {
                    try {
                        const res = await fetch('/spokesapi/Manifest', { cache: 'no-store' });
                        if (res.ok) {
                            clearInterval(pollInterval);
                            if (status) status.innerText = "Server is back online! Loading...";
                            console.log('[Server Restart] Server is back online. Redirecting to:', destination);
                            window.location.href = destination;
                        }
                    } catch (err) {
                        // Server is still offline or starting up, continue polling
                    }
                }, 1500);
            }, 2500);
        };

        window.checkIsCapacitorNative = () => typeof window.isCapacitorNative === 'function' ? window.isCapacitorNative() : !!(window.Capacitor && window.Capacitor.isNativePlatform && window.Capacitor.isNativePlatform());

        window.checkIsAuthRecoverable = async () => {
            try {
                let r = await fetch('/spokesapi/auth/current-session', { cache: 'no-store' });
                if (r.ok) return true;
                if (typeof window.spokesAuth !== 'undefined' && window.spokesAuth.refreshSessionAsync) {
                    const refreshed = await window.spokesAuth.refreshSessionAsync();
                    if (refreshed) return true;
                }
                return false;
            } catch(e) {
                return false;
            }
        };

        const startBlazor = () => {
            console.log('[App.razor] [STARTUP-DIAGNOSTIC] Blazor.start() called at:', Date.now());
            window.startupTimings.blazor_start = Date.now();
            try {
                if (typeof Blazor === 'undefined') {
                    throw new Error("Blazor is not defined. The framework script failed to load.");
                }

                Blazor.start({
                circuit: {
                    configureSignalR: function (builder) {
                        if (window.__signalRLogLevel) {
                            const levelStr = window.__signalRLogLevel.toLowerCase();
                            let level = 0; // Default to Trace (0) if configured but invalid string
                            if (levelStr === 'trace') level = 0;
                            else if (levelStr === 'debug') level = 1;
                            else if (levelStr === 'information') level = 2;
                            else if (levelStr === 'warning') level = 3;
                            else if (levelStr === 'error') level = 4;
                            else if (levelStr === 'critical') level = 5;
