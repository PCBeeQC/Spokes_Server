        // after the app is interactive. Removing them from <script defer> unblocks
        // DOMContentLoaded, saving ~80-120ms of V8 parse/compile on Android.
        function loadDeferredScripts() {
            if (window._lazyScriptsLoaded) return;
            window._lazyScriptsLoaded = true;
            const loadScript = (src) => {
                return new Promise((resolve, reject) => {
                    const s = document.createElement('script');
                    s.src = src;
                    s.onload = resolve;
                    s.onerror = (e) => { console.warn('[Lazy-Load] Failed to load:', src, e); resolve(); };
                    document.body.appendChild(s);
                });
            };

            const loadCss = (href) => {
                const l = document.createElement('link');
                l.rel = 'stylesheet';
                l.href = href;
                document.head.appendChild(l);
            };

            // Group 1: independent scripts and non-critical stylesheets — load all in parallel
            loadCss('@Assets["lib/quill/quill.snow.css"]');
            loadCss('@Assets["lib/cropperjs/cropper.min.css"]');
            const quillReady = loadScript('@Assets["lib/quill/quill.js"]');
            const cropperReady = loadScript('@Assets["lib/cropperjs/cropper.min.js"]');
            loadScript('@Assets["lib/livekit/livekit-client.umd.min.js"]');
            loadScript('@Assets["js/upload.js"]');
            loadScript('@Assets["js/download.js"]');
            loadScript('@Assets["js/voice-recorder.js"]');
            loadScript('@Assets["js/google-cast-sender.js"]');

            // Group 2: depends on quill.js and cropperjs — load after they're ready
            Promise.all([quillReady, cropperReady]).then(() => {
                // Polyfill for third-party plugins that still expect Quill 1.x's Module class
                if (window.Quill && !window.Quill.Module) {
                    window.Quill.Module = window.Quill.import('core/module');
                }
                loadScript('@Assets["lib/quill-magic-url/quill-magic-url.min.js"]');
                loadScript('@Assets["js/spokes-quill.js"]');
                loadScript('@Assets["js/cropper-interop.js"]');
            }).catch(e => console.warn('[Lazy-Load] Dependency load failed:', e));
        }

        window.loadDeferredScripts = loadDeferredScripts;

        const runStartup = async () => {
            // Step 0: Ensure desktop/web clients do not retain an accidental client=mobile query param
            if (!isNative && window.location.search.includes('client=mobile')) {
                try {
                    const cleanUrl = new URL(window.location.href);
                    cleanUrl.searchParams.delete('client');
                    window.history.replaceState(null, '', cleanUrl.toString());
                } catch(e) {}
            }

            // Step 1: Never boot while hidden. A page loaded in the background (e.g. iOS calling
            // webView.reload() after the WebContent process was killed) would have its session refresh or
            // WebSocket handshake frozen by the OS mid-flight, leaving a half-finished boot on screen when
            // the user returns. Waiting costs nothing: nobody is looking at a hidden page, and native push
            // covers notifications. (Native only: a desktop background tab still needs its circuit for
            // in-app notifications.)
            if (isNative && document.visibilityState === 'hidden') {
                console.log('[App.razor] Page is hidden. Deferring boot until it becomes visible.');
                window.startupTimings.hidden_wait_start = Date.now();
                await new Promise(resolve => {
                    const onVisibilityChange = () => {
                        if (document.visibilityState !== 'visible') return;
                        document.removeEventListener('visibilitychange', onVisibilityChange);
                        resolve();
                    };
                    document.addEventListener('visibilitychange', onVisibilityChange);
                });
                window.startupTimings.hidden_wait_end = Date.now();
                console.log('[App.razor] Page visible after ' + (window.startupTimings.hidden_wait_end - window.startupTimings.hidden_wait_start) + 'ms. Resuming boot.');
            }

            // Step 2: Ensure cookies are synced (native only)
            try {
                if ((await ensureCookiesFlushed()) === false) {
                    return; // Boot sequence aborted due to redirect
                }
            } catch (e) {
                console.error("[App.razor] ensureCookiesFlushed failed", e);
                // Continue to startBlazor anyway, so the user isn't stuck on the splash screen indefinitely.
            }

            // Step 3: Start Blazor (initCapacitorEnv runs in Blazor.start().finally())
            startBlazor();
        };

        if (document.readyState === 'loading') {
            document.addEventListener('DOMContentLoaded', runStartup);
        } else {
            runStartup();
        }
    </script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]" defer></script>
    <script src="@Assets["js/push-notifications.js"]" defer></script>
    <script src="@Assets["js/share-router.js"]" defer></script>
    <script src="@Assets["js/share-target.js"]" defer></script>
    <!-- Non-critical scripts (upload, download, livekit, quill, cropperjs) are eager-lazy loaded
         by loadDeferredScripts() immediately after the app becomes interactive.
         Removing them from defer unblocks DOMContentLoaded and saves ~80-120ms on Android. -->
    <script src="@Assets["js/spokes-app.js"]" defer></script>
</body>

