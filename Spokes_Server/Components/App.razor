        // Buffer console output to Capacitor Preferences for mobile debugging.
        (function() {
            // Capacitor drops `console.trace` and Logcat often hides `console.debug`. 
            // We map them to console.log so they always show up in the native logs when debugging.
            if (window.Capacitor) {
                const origTrace = console.trace;
                console.trace = function() {
                    console.log.apply(console, arguments);
                };
                const origDebug = console.debug;
                console.debug = function() {
                    console.log.apply(console, arguments);
                };
            }

            const pendingLogs = [];
            let flushTimeout = null;
            function flushLogs() {
                if (pendingLogs.length === 0) return Promise.resolve();
                if (window.Capacitor && window.Capacitor.Plugins && window.Capacitor.Plugins.Preferences) {
                    const logsToFlush = [...pendingLogs];
                    pendingLogs.length = 0;
                    return window.Capacitor.Plugins.Preferences.get({ key: 'debug_logs' }).then(res => {
                        let existing = [];
                        try { if (res.value) existing = JSON.parse(res.value); } catch(e) {}
                        existing = existing.concat(logsToFlush);
                        if (existing.length > 1000) existing = existing.slice(existing.length - 1000);
                        return window.Capacitor.Plugins.Preferences.set({ key: 'debug_logs', value: JSON.stringify(existing) });
                    }).catch(() => {});
                }
                return Promise.resolve();
            }

            ['log', 'warn', 'error', 'info', 'debug'].forEach(function(method) {
                const original = console[method];
                if (!original) return;
                console[method] = function() {
                    original.apply(console, arguments);
                    
                    try {
                        const msgArgs = Array.from(arguments).map(a => {
                            if (a instanceof Error) return a.stack || a.message;
                            if (typeof a === 'object') {
                                try { return JSON.stringify(a); } catch(e) { return String(a); }
                            }
                            return String(a);
                        }).join(' ');
                        if (/^\[.*?\] (Information|Warning|Error|Debug|Trace):/.test(msgArgs)) {
                            // Only suppress if the user hasn't explicitly enabled SignalR logging
                            if (!window.__signalRLogLevel || window.__signalRLogLevel.toLowerCase() === 'none') {
                                return; 
                            }
                        }
                        const logEntry = `[${new Date().toISOString()}] [${method.toUpperCase()}] ${msgArgs}`;
                        pendingLogs.push(logEntry);
                        if (!flushTimeout) {
                            flushTimeout = setTimeout(() => {
                                flushTimeout = null;
                                flushLogs();
                            }, 500);
                        }
                    } catch(e) {}
                };
            });
            window.flushAppLogs = flushLogs;
        })();

        // Fallback for severe boot failures to show UI to user instead of white screen
        function handleSevereError(msg) {
            console.error('[App.razor] SEVERE ERROR:', msg);
