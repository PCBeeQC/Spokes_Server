@inject Database Db
@{
    // Note: InteractiveServerRenderMode(prerender: false) unlocks ScopedKeystore & GlobalKeystore once on the
    // circuit handshake inside MainLayout.OnInitializedAsync, avoiding 100k-iteration PBKDF2 blocking HTML <head> TTFB.
    var isMobile = string.Equals(HttpContext?.Request.Query["client"].ToString(), "mobile", StringComparison.OrdinalIgnoreCase) 
        || (HttpContext?.Request.Headers.UserAgent.ToString().Contains("Capacitor") == true);
    var brandingToken = Db.SystemConfigs.Get().PublicBrandingToken ?? "default";
    var favicon = $"/branding/{brandingToken}/icon.png";
    var startupId = HttpContext?.Items["StartupCorrelationId"] as string;
    var clientTimings = HttpContext?.Items["ClientLocalTimings"] as string;
    var signalRLogLevel = Environment.GetEnvironmentVariable("Spokes_SignalR_Log_Level");

    // Server-authoritative session state for the client boot/resume logic. The page request itself
    // proves whether the session cookie is valid, so the client needs no probe request or cached expiry.
    var isAuthenticated = HttpContext?.User?.Identity?.IsAuthenticated == true;
    var sessionExpiresUtc = HttpContext?.Features.Get<Microsoft.AspNetCore.Authentication.IAuthenticateResultFeature>()?.AuthenticateResult?.Properties?.ExpiresUtc;
    var sessionExpiresAtMs = isAuthenticated && sessionExpiresUtc.HasValue ? sessionExpiresUtc.Value.ToUnixTimeMilliseconds() : 0;
    var employeeIdClaim = isAuthenticated ? HttpContext?.User?.FindFirst("EmployeeId")?.Value : null;
    var userMediaScope = Spokes_Server.Core.Services.Security.FileTokenService.ComputeUserMediaScope(employeeIdClaim);
    var currentSessionIdClaim = isAuthenticated ? HttpContext?.User?.FindFirst("SessionId")?.Value : null;
    var hasVaultKey = isAuthenticated
        && !string.IsNullOrEmpty(currentSessionIdClaim)
        && Db.DeviceSessions.GetById(currentSessionIdClaim)?.HasVaultCookie == true;
    var isStaticLoginRoute = HttpContext != null &&
        Spokes_Server.Core.Extensions.SpokesRequestClassifier.IsStaticLoginRoute(HttpContext.Request.Path);
    var companyEdition = Db.CompanyProfile.Get()?.Edition;
    var isInitialChatRoute = HttpContext != null && (
        HttpContext.Request.Path.StartsWithSegments("/chat") ||
        (HttpContext.Request.Path == "/" && string.Equals(companyEdition, "Family", StringComparison.OrdinalIgnoreCase)));

    var bootConfigJson = System.Text.Json.JsonSerializer.Serialize(new
    {
        startupId = startupId ?? string.Empty,
        clientTimings = clientTimings ?? string.Empty,
        signalRLogLevel = signalRLogLevel ?? string.Empty,
        isStaticLoginRoute,
        bootId = Spokes_Server.Controllers.ManifestController.BootId,
        session = new
        {
            authenticated = isAuthenticated,
            expiresAt = sessionExpiresAtMs,
            userScope = string.IsNullOrEmpty(userMediaScope) ? null : userMediaScope,
            hasVaultKey
        },
        assets = new
        {
            chatProfiler = Assets["js/spokes-chat-profiler.js"],
            upload = Assets["js/upload.js"],
            download = Assets["js/download.js"],
            voiceRecorder = Assets["js/voice-recorder.js"],
            livekit = Assets["lib/livekit/livekit-client.umd.min.js"],
            quillCss = Assets["lib/quill/quill.snow.css"],
            quillJs = Assets["lib/quill/quill.js"],
            quillMagicUrl = Assets["lib/quill-magic-url/quill-magic-url.min.js"],
            spokesQuill = Assets["js/spokes-quill.js"],
            cropperCss = Assets["lib/cropperjs/cropper.min.css"],
            cropperJs = Assets["lib/cropperjs/cropper.min.js"],
            cropperInterop = Assets["js/cropper-interop.js"],
            googleCast = Assets["js/google-cast-sender.js"],
            shareTarget = Assets["js/share-target.js"]
        }
    });
}
<!DOCTYPE html>
<html lang="@System.Globalization.CultureInfo.CurrentUICulture.TwoLetterISOLanguageName">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0, maximum-scale=1.0, user-scalable=0, interactive-widget=resizes-content, viewport-fit=cover" />
    <base href="/" />
    @if (isAuthenticated && !isStaticLoginRoute)
    {
        <script>
            // Pre-warm the /_blazor WebSocket handshake immediately on <head> first-byte (~530ms) so the
            // Cloudflare -> NPM/Tunnel -> Spokes TLS + HTTP 101 Upgrade runs in parallel with CSS and blazor.web.js.
            (function prewarmBlazorSocket() {
                try {
                    if (!window.WebSocket || document.visibilityState === 'hidden') return;
                    if (sessionStorage.getItem('spokes_force_negotiate') === '1') return;
                    var wsUrl = (location.protocol === 'https:' ? 'wss://' : 'ws://') + location.host + '/_blazor';
                    window.startupTimings = window.startupTimings || {};
                    window.startupTimings.ws_open_start = Date.now();
                    var ws = new window.WebSocket(wsUrl);
                    ws.binaryType = 'arraybuffer';
                    var state = {
                        url: wsUrl,
                        ws: ws,
                        claimed: false,
                        opened: false,
                        openEvent: null,
                        errorEvent: null,
                        closeEvent: null,
                        messages: [],
                        expireTimer: setTimeout(function () {
                            if (!state.claimed) {
                                state.claimed = true;
                                window.__spokesPrewarmedWs = null;
                                try { ws.close(); } catch (e) {}
                            }
                        }, 15000)
                    };
                    ws.addEventListener('open', function (ev) {
                        window.startupTimings.ws_open_end = Date.now();
                        window.__spokesWsExtensions = ws.extensions || '';
                        state.opened = true;
                        state.openEvent = ev;
                    }, { once: true });
                    ws.addEventListener('message', function (ev) {
                        if (!state.claimed) state.messages.push(ev);
                    });
                    ws.addEventListener('error', function (ev) {
                        state.errorEvent = ev;
                    }, { once: true });
                    ws.addEventListener('close', function (ev) {
                        state.closeEvent = ev;
                    }, { once: true });
                    window.__spokesPrewarmedWs = state;
                } catch (e) {}
            })();
        </script>
    }
    @if (HttpContext != null)
    {
        var safePreconnectOrigin = Spokes_Server.Core.Security.ServerUrlResolver.GetSafeServerBaseUrl(HttpContext, Db.SystemConfigs.Get()?.ServerPublicUrl);
        if (!string.IsNullOrEmpty(safePreconnectOrigin))
        {
            <link rel="preconnect" href="@safePreconnectOrigin" />
        }
    }
    <link href="@Assets["css/roboto.css"]" rel="stylesheet" media="print" onload="this.media='all'" />
    <noscript><link href="@Assets["css/roboto.css"]" rel="stylesheet" /></noscript>
    <link href="@Assets["_content/MudBlazor/MudBlazor.min.css"]" rel="stylesheet" />
    @if (!isMobile)
    {
        <link rel="icon" href="@favicon" />
    }
    @if (isStaticLoginRoute)
    {
        <HeadOutlet />
    }
    else
    {
        <HeadOutlet @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    }
    <script type="importmap" id="spokes-importmap">@((MarkupString)AssetExtensions.BuildImportMapJson(Assets))</script>
    <script>
        window.spokesResolveAssetUrl = function (path) {
            try {
                if (!window.__spokesImportMap) {
                    var el = document.getElementById('spokes-importmap');
                    window.__spokesImportMap = el ? (JSON.parse(el.textContent || '{}').imports || {}) : {};
                }
                return window.__spokesImportMap[path] || path;
            } catch (e) {
                return path;
            }
        };
    </script>
    <link href="@Assets["css/app.css"]" rel="stylesheet" />
    @if (isInitialChatRoute)
    {
        <link href="@Assets["css/chat.css"]" rel="stylesheet" />
    }
    else
    {
        <link href="@Assets["css/chat.css"]" rel="stylesheet" media="print" onload="this.media='all'" />
        <noscript><link href="@Assets["css/chat.css"]" rel="stylesheet" /></noscript>
    }
    <script src="@Assets["js/spokesbridge.js"]" defer></script>
    <script src="@Assets["js/capacitor-init.js"]" defer></script>
    <script src="@Assets["js/soundManager.js"]" defer></script>
    <script src="@Assets["js/spokes-auth.js"]" defer></script>
    <script src="@Assets["js/spokes-vault.js"]" defer></script>
    <script src="@Assets["js/mediaLoader.js"]" defer></script>
    <script src="@Assets["js/voiceSpeakingDom.js"]" defer></script>
</head>

<body>
    <div id="startup-splash" style="position: fixed; inset: 0; background-color: #1e1e2d; z-index: 999999; display: @(isStaticLoginRoute ? "none" : "flex"); flex-direction: column; align-items: center; justify-content: center;">
        <div style="width: 40px; height: 40px; border: 3px solid rgba(255,255,255,0.1); border-top-color: #7e6fff; border-radius: 50%; animation: spokes-spin 1s linear infinite;"></div>
        <div id="splash-status" style="margin-top: 20px; color: #999; font-family: sans-serif; text-align: center; max-width: 80%; font-size: 14px;"></div>
        <div id="spokes-splash-watchdog-actions" style="display: none; margin-top: 24px; gap: 12px; flex-wrap: wrap; justify-content: center; padding: 0 20px;">
            <button id="spokes-splash-retry-btn" type="button" onclick="if (typeof window.spokesRetryConnection === 'function') { window.spokesRetryConnection(); } else { window.location.reload(); }" style="background: #7e6fff; color: #fff; border: none; border-radius: 8px; padding: 10px 18px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: sans-serif;">@Loc["Retry Connection"]</button>
            <button id="spokes-splash-switch-server-btn" type="button" onclick="if (window.SpokesNative && typeof window.SpokesNative.openServerSwitcher === 'function') { window.SpokesNative.openServerSwitcher(); } else if (typeof window.changeCapacitorServer === 'function') { window.changeCapacitorServer(); } else if (window.SpokesNative && typeof window.SpokesNative.openServer === 'function') { window.SpokesNative.openServer(''); } else { window.location.href = '/'; }" style="background: rgba(255,255,255,0.1); color: #e0e0e0; border: 1px solid rgba(255,255,255,0.2); border-radius: 8px; padding: 10px 18px; font-size: 14px; font-weight: 600; cursor: pointer; font-family: sans-serif;">@Loc["Switch Server"]</button>
        </div>
        <style>@@keyframes spokes-spin { to { transform: rotate(360deg); } }</style>
    </div>
    @if (isStaticLoginRoute)
    {
        <Routes />
    }
    else
    {
        <Routes @rendermode="new InteractiveServerRenderMode(prerender: false)" />
    }
    <script src="@Assets["_framework/blazor.web.js"]" autostart="false"></script>
    <script>
        window.startupTimings = window.startupTimings || {};
        window.startupTimings.remote_html_received = Date.now();
        window.__spokesSession = { authenticated: @(isAuthenticated ? "true" : "false"), expiresAt: @sessionExpiresAtMs, userScope: "@(userMediaScope ?? "")" || null, hasVaultKey: @(hasVaultKey ? "true" : "false") };
        window.__spokesBootConfig = @((MarkupString)bootConfigJson);
    </script>
    <script src="@Assets["js/spokes-boot.js"]"></script>
    <script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]" defer></script>
    <script src="@Assets["js/push-notifications.js"]" defer></script>
    <!-- Non-critical scripts (upload, download, livekit, quill, cropperjs) and Capacitor-only share scripts
         are loaded post-interactive or on demand so they never block DOMContentLoaded or Web Desktop cold start. -->
    <script src="@Assets["js/spokes-app.js"]" defer></script>
</body>

</html>

@code {
    [CascadingParameter] public HttpContext? HttpContext { get; set; }
}
