                        repeating.forEach(r => {
                            const rId = parseInt(r.getAttribute('data-pg-id'));
                            if (m.index !== rId) {
                                const rMeas = measurements.find(x => x.index === rId);
                                if (rMeas) {
                                    repeatingHeightToAdd += rMeas.height;
                                    repeatingBlocksToTrack.push(rId);
                                }
                            }
